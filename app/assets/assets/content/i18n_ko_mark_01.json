{
  "mark.1.p1.b1": {
    "text": "하나님의 아들 예수 그리스도 복음의 시작이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p1.b2": {
    "text": "…보라 내가 내 사자를 네 앞에 보내노니 저가 네 길을 예비하리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p1.b3": {
    "text": "광야에 외치는 자의 소리가 있어 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p1.b4": {
    "text": "너희는 주의 길을 예비하라 그의 첩경을 평탄케 하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p2.b1": {
    "text": "세례 요한이 이르러 광야에서 죄 사함을 받게 하는 회개의 세례를 전파하니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p2.b2": {
    "text": "온 유대 지방과 예루살렘 사람이 다 나아가",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p2.b3": {
    "text": "자기 죄를 자복하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p3.b1": {
    "text": "나보다 능력 많으신 이가 내 뒤에 오시나니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p3.b2": {
    "text": "나는 굽혀 그의 신들메를 풀기도 감당치 못하겠노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p3.b3": {
    "text": "나는 너희에게 물로 세례를 주었거니와",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p3.b4": {
    "text": "그는 성령으로 너희에게 세례를 주시리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p4.b1": {
    "text": "그 때에 예수께서 갈릴리 나사렛으로부터 와서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p4.b2": {
    "text": "요단강에서 요한에게 세례를 받으시고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p4.b3": {
    "text": "곧 물에서 올라 오실쌔 하늘이 갈라짐과",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p5.b1": {
    "text": "성령이 비둘기 같이 자기에게 내려오심을 보시더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p5.b2": {
    "text": "하늘로서 소리가 나기를",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p5.b3": {
    "text": "너는 내 사랑하는 아들이라 내가 너를 기뻐하노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p6.b1": {
    "text": "성령이 곧 예수를 광야로 몰아내신지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p6.b2": {
    "text": "광야에서 사십일을 계셔서 사단에게 시험을 받으시며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p6.b3": {
    "text": "들짐승과 함께 계시니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p6.b4": {
    "text": "천사들이 수종들더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p7.b1": {
    "text": "요한이 잡힌 후",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p7.b2": {
    "text": "예수께서 갈릴리에 오셔서 하나님의 복음을 전파하여 가라사대",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:14-15"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p7.b3": {
    "text": "때가 찼고 하나님 나라가 가까왔으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p7.b4": {
    "text": "회개하고 복음을 믿으라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p8.b1": {
    "text": "갈릴리 해변으로 지나가시다가 시몬과 그 형제 안드레가 바다에 그물 던지는 것을 보시니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p8.b2": {
    "text": "나를 따라 오너라 내가 너희로 사람을 낚는 어부가 되게 하리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p8.b3": {
    "text": "곧 그물을 버려 두고 좇으니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p9.b1": {
    "text": "조금 더 가시다가 세베대의 아들 야고보와 그 형제 요한을 보시니 저희도 배에 있어 그물을 깁는데",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p9.b2": {
    "text": "곧 부르시니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p9.b3": {
    "text": "그 아비 세베대를 삯군들과 함께 배에 버려 두고 예수를 따라가니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p10.b1": {
    "text": "저희가 가버나움에 들어가니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p10.b2": {
    "text": "예수께서 곧 안식일에 회당에 들어가 가르치시매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p10.b3": {
    "text": "뭇사람이 그의 교훈에 놀라니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p10.b4": {
    "text": "이는 그 가르치시는 것이 권세 있는 자와 같고 서기관들과 같지 아니함일러라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p11.b1": {
    "text": "마침 저희 회당에 더러운 귀신 들린 사람이 있어",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p11.b2": {
    "text": "소리질러 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p11.b3": {
    "text": "나사렛 예수여 우리가 당신과 무슨 상관이 있나이까 우리를 멸하러 왔나이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p11.b4": {
    "text": "나는 당신이 누구인줄 아노니 하나님의 거룩한 자니이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p11.b5": {
    "text": "예수께서 꾸짖어 가라사대",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p11.b6": {
    "text": "잠잠하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p11.b7": {
    "text": "그 사람에게서 나오라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p12.b1": {
    "text": "더러운 귀신이 그 사람으로 경련을 일으키게 하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p12.b2": {
    "text": "큰 소리를 지르며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p12.b3": {
    "text": "나오는지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p12.b4": {
    "text": "다 놀라 서로 물어 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p12.b5": {
    "text": "이는 어찜이뇨 권세 있는 새 교훈이로다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p12.b6": {
    "text": "더러운 귀신들을 명한즉 순종하는도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p12.b7": {
    "text": "예수의 소문이 곧 온 갈릴리 사방에 퍼지더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p13.b1": {
    "text": "회당에서 나와 곧…시몬과 안드레의 집에 들어가시니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p13.b2": {
    "text": "시몬의 장모가 열병으로 누웠는지라 사람들이 곧 그의 일로 예수께 여짜온대",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p13.b3": {
    "text": "나아가사 그 손을 잡아 일으키시니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p13.b4": {
    "text": "열병이 떠나고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p14.b1": {
    "text": "저물어 해 질 때에",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p14.b2": {
    "text": "온 동네가 문앞에 모였더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p14.b3": {
    "text": "예수께서 각색 병든 많은 사람을 고치시며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p14.b4": {
    "text": "많은 귀신을 내어 쫓으시되 귀신이 자기를 알므로 그 말하는 것을 허락지 아니하시니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p15.b1": {
    "text": "새벽 오히려 미명에",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p15.b2": {
    "text": "모든 사람이 주를 찾나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:37"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p15.b3": {
    "text": "우리가 다른 가까운 마을들로 가자 거기서도 전도하리니 내가 이를 위하여 왔노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p15.b4": {
    "text": "이에 온 갈릴리에 다니시며 저희 여러 회당에서 전도하시고 또 귀신들을 내어 쫓으시더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p16.b1": {
    "text": "한 문둥병자가 예수께 와서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p17.b1": {
    "text": "꿇어 엎드리어 간구하여 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p17.b2": {
    "text": "원하시면 저를 깨끗케 하실 수 있나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p17.b3": {
    "text": "예수께서 민망히 여기사",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p18.b1": {
    "text": "손을 내밀어 저에게 대시며 가라사대",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p18.b2": {
    "text": "내가 원하노니 깨끗함을 받으라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p19.b1": {
    "text": "곧 문둥병이 그 사람에게서 떠나가고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:42"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p19.b2": {
    "text": "깨끗하여진지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:42"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p20.b1": {
    "text": "엄히 경계하사 곧 보내시며 가라사대",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:43-44"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p20.b2": {
    "text": "삼가 아무에게 아무 말도 하지 말고 가서 네 몸을 제사장에게 보이고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:44"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p20.b3": {
    "text": "네 깨끗케 됨을 인하여 모세의 명한 것을 드려 저희에게 증거하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:44"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p20.b4": {
    "text": "그러나 그 사람이 나가서 이 일을 많이 전파하여 널리 퍼지게 하니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:45"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p20.b5": {
    "text": "그러므로 예수께서 다시는 드러나게 동네에 들어가지 못하시고 오직 바깥 한적한 곳에 계셨으나",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:45"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.1.p20.b6": {
    "text": "사방에서 그에게로 나아오더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 1:45"
    },
    "adapted": false,
    "status": "approved"
  }
}
