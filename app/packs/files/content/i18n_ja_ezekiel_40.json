{
  "ezekiel.40.p1.b1": {
    "text": "われわれが捕え移されてから二十五年、都が打ち破られて後十四年……主の手がわたしに臨み、わたしをかの所に携えて行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 40:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.40.p1.b2": {
    "text": "すなわち神は幻のうちに、わたしをイスラエルの地に携えて行って、非常に高い山の上におろされた。その山の上に、わたしと相対して、一つの町のような建物があった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 40:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.40.p1.b3": {
    "text": "……見よ、ひとりの人がいた。その姿は青銅の形のようで、手に麻のなわと、測りざおとを持って門に立っていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 40:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.40.p1.b4": {
    "text": "人の子よ、目で見、耳で聞き、わたしがあなたに示す、すべての事を心にとめよ。……あなたの見ることを、ことごとくイスラエルの家に告げよ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 40:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.40.p2.b1": {
    "text": "見よ、宮の外の周囲に、かきがあり……その人の手に六キュビトの測りざおがあった。……彼が、そのかきの厚さを測ると、一さおあり、高さも一さおあった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 40:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.40.p2.b2": {
    "text": "彼が東向きの門に行き、その階段を上って……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 40:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.40.p2.b3": {
    "text": "彼がまたわたしを外庭に携え入れると、見よ、庭の周囲に設けた室と、敷石とがあり、敷石の上に三十の室があった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 40:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.40.p2.b4": {
    "text": "……廊の内側の周囲にも、同様に窓があり、脇柱には、しゅろがあった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 40:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.40.p3.b1": {
    "text": "その廊は外庭に面して、脇柱の上にしゅろがあり、その階段は八段であった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 40:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.40.p3.b2": {
    "text": "……その人たちは、レビの子孫のうちのザドクの子孫であって、主に近く仕える者たちである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 40:46"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.40.p3.b3": {
    "text": "そして彼が庭を測ると、その長さは百キュビト、幅も百キュビトで四角である。宮の前には祭壇があった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 40:47"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.40.p3.b4": {
    "text": "彼がわたしを宮の廊に連れて行って、廊の脇柱を測ると……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 40:48"
    },
    "adapted": false,
    "status": "approved"
  }
}
