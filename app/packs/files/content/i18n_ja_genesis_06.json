{
  "genesis.6.p1.b1": {
    "text": "人が地のおもてにふえ始めて、娘たちが彼らに生れた時、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 6:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.6.p1.b2": {
    "text": "そのころ、またその後にも、地にネピリムがいた。… 彼らは昔の勇士であり、有名な人々であった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 6:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.6.p1.b3": {
    "text": "わたしが創造した人を地のおもてからぬぐい去ろう。人も獣も、這うものも、空の鳥までも。わたしは、これらを造ったことを悔いる",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 6:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.6.p1.b4": {
    "text": "主は地の上に人を造ったのを悔いて、心を痛め、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 6:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.6.p1.b5": {
    "text": "しかし、ノアは主の前に恵みを得た。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 6:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.6.p2.b6": {
    "text": "ノアはその時代の人々の中で正しく、かつ全き人であった。ノアは神とともに歩んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 6:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.6.p2.b7": {
    "text": "ノアはセム、ハム、ヤペテの三人の子を生んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 6:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.6.p2.b8": {
    "text": "時に世は神の前に乱れて、暴虐が地に満ちた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 6:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.6.p2.b9": {
    "text": "すべての人が地の上でその道を乱したからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 6:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.6.p3.b10": {
    "text": "わたしは、すべての人を絶やそうと決心した。彼らは地を暴虐で満たしたから、わたしは彼らを地とともに滅ぼそう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 6:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.6.p3.b11": {
    "text": "あなたは、いとすぎの木で箱舟を造り、… 箱舟の長さは三百キュビト、幅は五十キュビト、高さは三十キュビトとし",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 6:14-15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.6.p3.b12": {
    "text": "わたしは地の上に洪水を送って、命の息のある肉なるものを、みな天の下から滅ぼし去る。… 地にあるものは、みな死に絶えるであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 6:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.6.p4.b13": {
    "text": "あなたは、いとすぎの木で箱舟を造り、箱舟の中にへやを設け、アスファルトでそのうちそとを塗りなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 6:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.6.p5.b14": {
    "text": "箱舟の長さは三百キュビト、幅は五十キュビト、高さは三十キュビトとし",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 6:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.6.p5.b15": {
    "text": "箱舟の戸口をその横に設けて、一階と二階と三階のある箱舟を造りなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 6:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.6.p6.b16": {
    "text": "ただし、わたしはあなたと契約を結ぼう。あなたは子らと、妻と、子らの妻たちと共に箱舟にはいりなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 6:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.6.p6.b17": {
    "text": "また、すべての食物となるものをとって、あなたのところにたくわえ、あなたとこれらのものとの食物としなさい」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 6:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.6.p6.b18": {
    "text": "ノアはすべて神の命じられたようにした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 6:22"
    },
    "adapted": false,
    "status": "approved"
  }
}
