{
  "hebrews.5.p1.b1": {
    "text": "大祭司なるものはすべて、人間の中から選ばれて、罪のために供え物といけにえとをささげるように、人々のために神に仕える役に任じられた者である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 5:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.5.p1.b2": {
    "text": "彼は自分自身、弱さを身に負うているので、無知な迷っている人々を、思いやることができると共に、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 5:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.5.p1.b3": {
    "text": "その弱さのゆえに、民のためだけではなく自分自身のためにも、罪についてささげものをしなければならないのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 5:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.5.p1.b4": {
    "text": "かつ、だれもこの栄誉ある務を自分で得るのではなく、アロンの場合のように、神の召しによって受けるのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 5:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.5.p2.b5": {
    "text": "同様に、キリストもまた、大祭司の栄誉を自分で得たのではなく、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 5:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.5.p2.b6": {
    "text": "「あなたこそは、永遠に、メルキゼデクに等しい祭司である」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 5:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.5.p2.b7": {
    "text": "キリストは、その肉の生活の時には、激しい叫びと涙とをもって、ご自分を死から救う力のあるかたに、祈と願いとをささげ、そして、その深い信仰のゆえに聞きいれられたのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 5:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.5.p2.b8": {
    "text": "彼は御子であられたにもかかわらず、さまざまの苦しみによって従順を学び、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 5:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.5.p3.b9": {
    "text": "そして、全き者とされたので、彼に従順であるすべての人に対して、永遠の救の源となり、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 5:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.5.p3.b10": {
    "text": "このことについては、言いたいことがたくさんあるが、あなたがたの耳が鈍くなっているので、それを説き明かすことはむずかしい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 5:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.5.p4.b11": {
    "text": "あなたがたは、久しい以前からすでに教師となっているはずなのに、もう一度神の言の初歩を、人から手ほどきしてもらわねばならない始末である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 5:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.5.p4.b12": {
    "text": "あなたがたは堅い食物ではなく、乳を必要としている。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 5:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.5.p4.b13": {
    "text": "しかし、堅い食物は、善悪を見わける感覚を実際に働かせて訓練された成人のとるべきものである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 5:14"
    },
    "adapted": false,
    "status": "approved"
  }
}
