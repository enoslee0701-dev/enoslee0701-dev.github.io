{
  "ruth.3.p1.b1": {
    "text": "娘よ、わたしはあなたの落ち着き所を求めて、あなたをしあわせにすべきではないでしょうか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ruth 3:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p1.b2": {
    "text": "… ボアズはわたしたちの親戚ではありませんか。彼は今夜、打ち場で大麦をあおぎ分けます。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ruth 3:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p1.b3": {
    "text": "それであなたは身を洗って油をぬり、晴れ着をまとって打ち場に下って行きなさい。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ruth 3:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p1.b4": {
    "text": "あなたのおっしゃることを皆いたしましょう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ruth 3:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p2.b1": {
    "text": "こうして彼女は打ち場に下り、すべてしゅうとめが命じたとおりにした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ruth 3:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p2.b2": {
    "text": "ボアズは飲み食いして、心をたのしませたあとで、麦を積んである場所のかたわらへ行って寝た。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ruth 3:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p2.b3": {
    "text": "そこで彼女はひそかに行き、ボアズの足の所をまくって、そこに寝た。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ruth 3:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p3.b1": {
    "text": "夜中になって、その人は驚き、起きかえって見ると、ひとりの女が足のところに寝ていた",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ruth 3:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p3.b2": {
    "text": "あなたはだれですか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ruth 3:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p3.b3": {
    "text": "わたしはあなたのはしためルツです。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ruth 3:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p3.b4": {
    "text": "あなたのすそで、はしためをおおってください。あなたは最も近い親戚です。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ruth 3:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p4.b1": {
    "text": "娘よ、どうぞ、主があなたを祝福されるように。… あなたが最後に示したこの親切は、さきに示した親切にまさっています。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ruth 3:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p4.b2": {
    "text": "娘よ、あなたは恐れるにおよびません。… わたしの町の人々は皆、あなたがりっぱな女であることを知っているからです。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ruth 3:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p4.b3": {
    "text": "たしかにわたしは近い親戚ではありますが、わたしよりも、もっと近い親戚があります。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ruth 3:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p4.b4": {
    "text": "しかし主は生きておられます。その人が、あなたのために親戚の義務をつくすことを好まないならば、わたしはあなたのために親戚の義務をつくしましょう。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ruth 3:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p5.b1": {
    "text": "ルツは朝まで彼の足のところに寝たが、だれかれの見分け難いころに起きあがった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ruth 3:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p5.b2": {
    "text": "この女の打ち場にきたことが人に知られてはならない",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ruth 3:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p5.b3": {
    "text": "あなたの着る外套を持ってきて、それを広げなさい",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ruth 3:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p5.b4": {
    "text": "彼女がそれを広げると、ボアズは大麦六オメルをはかって彼女に負わせた。彼女は町に帰り",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ruth 3:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p6.b1": {
    "text": "娘よ、どうでしたか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ruth 3:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p6.b2": {
    "text": "そこでルツはその人が彼女にしたことをことごとく告げて",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ruth 3:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p6.b3": {
    "text": "あのかたはわたしに向かって、から手で、しゅうとめのところへ帰ってはならないと言って、この大麦六オメルをわたしにくださいました",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ruth 3:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p6.b4": {
    "text": "娘よ、この事がどうなるかわかるまでお待ちなさい。あの人は、きょう、その事を決定しなければ落ち着かないでしょう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ruth 3:18"
    },
    "adapted": false,
    "status": "approved"
  }
}
