{
  "mark.10.p1.b1": {
    "text": "예수께서 거기서 떠나 유대 지경과 요단강 건너편으로 가시니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p1.b2": {
    "text": "무리가 다시 모여 들거늘 예수께서 다시 전례대로 가르치시더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p1.b3": {
    "text": "사람이 아내를 내어버리는 것이 옳으니이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p1.b4": {
    "text": "그를 시험하여",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p2.b1": {
    "text": "모세가 어떻게 너희에게 명하였느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p2.b2": {
    "text": "모세는 이혼증서를 써주어 내어 버리기를 허락하였나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p2.b3": {
    "text": "너희 마음의 완악함을 인하여 이 명령을 기록하였거니와",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p3.b1": {
    "text": "창조시로부터 저희를 남자와 여자로 만드셨으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p3.b2": {
    "text": "이러므로 사람이 그 부모를 떠나서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p3.b3": {
    "text": "그 둘이 한 몸이 될지니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p3.b4": {
    "text": "그러므로 하나님이 짝지어 주신 것을 사람이 나누지 못할찌니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p4.b1": {
    "text": "집에서 제자들이 다시 이일을 묻자온대",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p4.b2": {
    "text": "누구든지 그 아내를 내어버리고 다른데 장가 드는 자는 본처에게 간음을 행함이요",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p4.b3": {
    "text": "또 아내가 남편을 버리고 다른데로 시집 가면 간음을 행함이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p5.b1": {
    "text": "사람들이 예수의 만져 주심을 바라고 어린 아이들을 데리고 오매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p5.b2": {
    "text": "제자들이 꾸짖거늘",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p5.b3": {
    "text": "어린 아이들의 내게 오는 것을 용납하고 금하지 말라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p5.b4": {
    "text": "하나님의 나라가 이런 자의 것이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p6.b1": {
    "text": "내가 진실로 너희에게 이르노니 누구든지 하나님의 나라를 어린 아이와 같이 받들지 않는 자는",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p6.b2": {
    "text": "결단코 들어가지 못하리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p6.b3": {
    "text": "그 어린 아이들을 안고 저희 위에 안수하시고 축복하시니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p7.b1": {
    "text": "예수께서 길에 나가실새 한 사람이 달려와서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p7.b2": {
    "text": "선한 선생님이여 내가 무엇을 하여야 영생을 얻으리이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p7.b3": {
    "text": "네가 어찌하여 나를 선하다 일컫느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p7.b4": {
    "text": "하나님 한분 외에는 선한 이가 없느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p8.b1": {
    "text": "네가 계명을 아나니 살인하지 말라 간음하지 말라 도적질 하지말라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p8.b2": {
    "text": "거짓증거하지 말라 속여 취하지 말라 네 부모를 공경하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p8.b3": {
    "text": "선생님이여 이것은 내가 어려서부터 다 지키었나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p9.b1": {
    "text": "예수께서 그를 보시고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p9.b2": {
    "text": "네게 오히려 한 가지 부족한 것이 있으니 가서 네 있는 것을 다 팔아 가난한 자들을 주라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p9.b3": {
    "text": "그리하면 하늘에서 보화가 네게 있으리라 그리고 와서 나를 좇으라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p9.b4": {
    "text": "그 사람은 재물이 많은고로 이 말씀을 인하여 슬픈 기색을 띠고 근심하며 가니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p10.b1": {
    "text": "재물이 있는 자는 하나님의 나라에 들어가기가 심히 어렵도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p10.b2": {
    "text": "제자들이 그 말씀에 놀라는지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p10.b3": {
    "text": "얘들아 재물을 의지하는 자는 하나님의 나라에 들어가기가 어떻게 어려운지",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p10.b4": {
    "text": "약대가 바늘귀로 나가는 것이 부자가 하나님의 나라에 들어가는 것보다 쉬우니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p11.b1": {
    "text": "제자들이 심히 놀라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p11.b2": {
    "text": "그런즉 누가 구원을 얻을 수 있는가",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p11.b3": {
    "text": "사람으로는 할 수 없으되 하나님으로는 그렇지 아니하니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p11.b4": {
    "text": "하나님으로서는 다 하실 수 있느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p12.b1": {
    "text": "보소서 우리가 모든 것을 버리고 주를 좇았나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p12.b2": {
    "text": "내가 진실로 너희에게 이르노니 나와 및 복음을 위하여 집이나 형제나 자매나 어미나 아비나 아내나 자식이나 전토를 버린 자는",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p12.b3": {
    "text": "금세에 있어 … 백배나 받되 핍박을 겸하여 받고 내세에 영생을 받지 못할 자가 없느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p12.b4": {
    "text": "그러나 먼저 된 자로서 나중 되고 나중 된 자로서 먼저 될 자가 많으니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p13.b1": {
    "text": "예루살렘으로 올라가는 길에",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p13.b2": {
    "text": "예수께서 제자들 앞에 서서 가시는데",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p13.b3": {
    "text": "저희가 놀라고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p13.b4": {
    "text": "좇는 자들은 두려워하더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p14.b1": {
    "text": "보라 우리가 예루살렘에 올라가노니 인자가 대제사장들과 서기관들에게 넘기우매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p14.b2": {
    "text": "저희가 죽이기로 결안하고 이방인들에게 넘겨주겠고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p14.b3": {
    "text": "그들은 능욕하며 침 뱉으며 채찍질하고 죽일 것이니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p14.b4": {
    "text": "저는 삼일만에 살아나리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p15.b1": {
    "text": "선생님이여 무엇이든지 우리의 구하는 바를 우리에게 하여주시기를 원하옵나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p15.b2": {
    "text": "너희에게 무엇을 하여주기를 원하느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:36"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p15.b3": {
    "text": "주의 영광 중에서 우리를",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:37"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p15.b4": {
    "text": "하나는 주의 우편에 하나는 좌편에 앉게 하여 주옵소서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:37"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p16.b1": {
    "text": "너희 구하는 것을 너희가 알지 못하는도다 너희가 나의 마시는 잔을 마시며 나의 받는 세례를 받을 수 있느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p16.b2": {
    "text": "할 수 있나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p16.b3": {
    "text": "너희가 나의 마시는 잔을 마시며 나의 받는 세례를 받으려니와",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p16.b4": {
    "text": "내 좌우편에 앉는 것은 나의 줄 것이 아니라 누구를 위하여 예비되었든지 그들이 얻을 것이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p17.b1": {
    "text": "열 제자가 듣고 야고보와 요한에 대하여 분히 여기거늘",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p17.b2": {
    "text": "이방인의 소위 집권자들이 저희를 임의로 주관하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:42"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p17.b3": {
    "text": "그 대인들이 저희에게 권세를 부리는 줄을 너희가 알거니와",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:42"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p18.b1": {
    "text": "너희 중에는 그렇지 아니하니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:43"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p18.b2": {
    "text": "너희 중에 누구든지 크고자 하는 자는 너희를 섬기는 자가 되고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:43"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p18.b3": {
    "text": "인자의 온 것은 섬김을 받으려 함이 아니라 도리어 섬기려 하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:45"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p18.b4": {
    "text": "자기 목숨을 많은 사람의 대속물로 주려 함이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:45"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p19.b1": {
    "text": "저희가 여리고에 이르렀더니 예수께서 제자들과 허다한 무리와 함께 여리고에서 나가실 때에",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:46"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p19.b2": {
    "text": "디매오의 아들인 소경 거지 바디매오가 길 가에 앉았다가",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:46"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p19.b3": {
    "text": "다윗의 자손 예수여 나를 불쌍히 여기소서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:47"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p20.b1": {
    "text": "많은 사람이 꾸짖어 잠잠하라 하되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:48"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p20.b2": {
    "text": "다윗의 자손이여 나를 불쌍히 여기소서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:48"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p20.b3": {
    "text": "저를 부르라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:49"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p20.b4": {
    "text": "안심하고 일어나라 너를 부르신다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:49"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p21.b1": {
    "text": "소경이 겉옷을 내어버리고 뛰어 일어나 예수께 나아오거늘",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:50"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p21.b2": {
    "text": "네게 무엇을 하여주기를 원하느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:51"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p21.b3": {
    "text": "선생님이여 보기를 원하나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:51"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p22.b1": {
    "text": "가라 네 믿음이 너를 구원하였느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:52"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p22.b2": {
    "text": "저가 곧 보게 되어",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:52"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.10.p22.b3": {
    "text": "예수를 길에서 좇으니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 10:52"
    },
    "adapted": false,
    "status": "approved"
  }
}
