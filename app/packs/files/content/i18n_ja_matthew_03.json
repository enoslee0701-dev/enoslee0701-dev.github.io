{
  "matthew.3.p1.b1": {
    "text": "そのころ、バプテスマのヨハネが現れ、ユダヤの荒野で教を宣べて言った、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 3:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p1.b2": {
    "text": "「悔い改めよ、天国は近づいた」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 3:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p1.b3": {
    "text": "預言者イザヤによって、「荒野で呼ばわる者の声がする、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 3:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p1.b4": {
    "text": "『主の道を備えよ、その道筋をまっすぐにせよ』」と言われたのは、この人のことである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 3:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p2.b1": {
    "text": "このヨハネは、らくだの毛ごろもを着物にし、腰に皮の帯をしめ、いなごと野蜜とを食物としていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 3:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p2.b2": {
    "text": "すると、エルサレムとユダヤ全土とヨルダン附近一帯の人々が、ぞくぞくとヨハネのところに出てきて、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 3:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p2.b3": {
    "text": "自分の罪を告白し、ヨルダン川でヨハネからバプテスマを受けた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 3:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p3.b1": {
    "text": "ヨハネは、パリサイ人やサドカイ人が大ぜいバプテスマを受けようとしてきたのを見て、彼らに言った、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 3:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p3.b2": {
    "text": "「まむしの子らよ、迫ってきている神の怒りから、おまえたちはのがれられると、だれが教えたのか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 3:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p3.b3": {
    "text": "自分たちの父にはアブラハムがあるなどと、心の中で思ってもみるな。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 3:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p3.b4": {
    "text": "おまえたちに言っておく、神はこれらの石ころからでも、アブラハムの子を起すことができるのだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 3:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p4.b1": {
    "text": "斧がすでに木の根もとに置かれている。だから、良い実を結ばない木はことごとく切られて、火の中に投げ込まれるのだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 3:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p4.b2": {
    "text": "しかし、わたしのあとから来る人はわたしよりも力のあるかたで、わたしはそのくつをぬがせてあげる値うちもない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 3:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p4.b3": {
    "text": "また、箕を手に持って、打ち場の麦をふるい分け、麦は倉に納め、からは消えない火で焼き捨てるであろう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 3:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p5.b1": {
    "text": "そのときイエスは、ガリラヤを出てヨルダン川に現れ、ヨハネのところにきて、バプテスマを受けようとされた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 3:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p5.b2": {
    "text": "ところがヨハネは、それを思いとどまらせようとして言った、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 3:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p5.b3": {
    "text": "「わたしこそあなたからバプテスマを受けるはずですのに、あなたがわたしのところにおいでになるのですか」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 3:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p6.b1": {
    "text": "「今は受けさせてもらいたい。このように、すべての正しいことを成就するのは、われわれにふさわしいことである」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 3:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p6.b2": {
    "text": "そこでヨハネはイエスの言われるとおりにした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 3:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p6.b3": {
    "text": "イエスはバプテスマを受けるとすぐ、水から上がられた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 3:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p7.b1": {
    "text": "すると、見よ、天が開け、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 3:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p7.b2": {
    "text": "神の御霊がはとのように自分の上に下ってくるのを、ごらんになった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 3:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p7.b3": {
    "text": "また天から声があって言った、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 3:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p7.b4": {
    "text": "「これはわたしの愛する子、わたしの心にかなう者である」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 3:17"
    },
    "adapted": false,
    "status": "approved"
  }
}
