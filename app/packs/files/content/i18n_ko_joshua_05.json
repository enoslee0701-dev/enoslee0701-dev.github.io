{
  "joshua.5.p1.b1": {
    "text": "요단 서편의 아모리 사람의 모든 왕과 해변의 가나안 사람의 모든 왕이 여호와께서 요단 물을 이스라엘 자손들 앞에서 말리시고 … 마음이 녹았고 이스라엘 자손들의 연고로 정신을 잃었더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Joshua 5:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.5.p1.b2": {
    "text": "너는 부싯돌로 칼을 만들어 이스라엘 자손들에게 다시 할례를 행하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Joshua 5:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.5.p1.b3": {
    "text": "여호수아가 부싯돌로 칼을 만들어 할례산에서 이스라엘 자손들에게 할례를 행하니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Joshua 5:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.5.p2.b1": {
    "text": "애굽에서 나온 모든 백성 중 남자 곧 모든 군사는 애굽에서 나온 후 광야 노중에서 죽었는데",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Joshua 5:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.5.p2.b2": {
    "text": "그들의 대를 잇게 하신 이 자손에게 여호수아가 할례를 행하였으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Joshua 5:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.5.p2.b3": {
    "text": "온 백성에게 할례 행하기를 필하매 백성이 진중 각 처소에 처하여 낫기를 기다릴 때에",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Joshua 5:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.5.p2.b4": {
    "text": "내가 오늘날 애굽의 수치를 너희에게서 굴러가게 하였다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Joshua 5:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.5.p3.b1": {
    "text": "이스라엘 자손들이 길갈에 진쳤고 그 달 십사일 저녁에는 여리고 평지에서 유월절을 지켰고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Joshua 5:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.5.p3.b2": {
    "text": "유월절 이튿날에 그 땅 소산을 먹되 그 날에 무교병과 볶은 곡식을 먹었더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Joshua 5:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.5.p3.b3": {
    "text": "그 땅 소산을 먹은 다음 날에 만나가 그쳤으니 이스라엘 사람들이 다시는 만나를 얻지 못하였고 그 해에 가나안 땅의 열매를 먹었더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Joshua 5:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.5.p4.b1": {
    "text": "여호수아가 여리고에 가까왔을 때에 눈을 들어 본즉 한 사람이 칼을 빼어 손에 들고 마주 섰는지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Joshua 5:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.5.p4.b2": {
    "text": "너는 우리를 위하느냐 우리의 대적을 위하느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Joshua 5:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.5.p4.b3": {
    "text": "아니라 나는 여호와의 군대장관으로 이제 왔느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Joshua 5:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.5.p4.b4": {
    "text": "나의 주여 종에게 무슨 말씀을 하려 하시나이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Joshua 5:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.5.p5.b1": {
    "text": "네 발에서 신을 벗으라 네가 선 곳은 거룩하니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Joshua 5:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.5.p5.b2": {
    "text": "여호수아가 그대로 행하니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Joshua 5:15"
    },
    "adapted": false,
    "status": "approved"
  }
}
