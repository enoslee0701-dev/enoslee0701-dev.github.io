{
  "micah.4.p1.b1": {
    "text": "末の日になって、主の家の山はもろもろの山のかしらとして堅く立てられ……もろもろの民はこれに流れくる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 4:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.4.p1.b2": {
    "text": "さあ、われわれは主の山に登り、ヤコブの神の家に行こう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 4:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.4.p1.b3": {
    "text": "彼らはつるぎを打ちかえて、すきとし、そのやりを打ちかえて、かまとし、国は国にむかってつるぎをあげず、再び戦いのことを学ばない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 4:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.4.p1.b4": {
    "text": "彼らは皆そのぶどうの木の下に座し、そのいちじくの木の下にいる。彼らを恐れさせる者はない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 4:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.4.p1.b5": {
    "text": "これは万軍の主がその口で語られたことである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 4:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.4.p1.b6": {
    "text": "すべての民はおのおのその神の名によって歩む。しかしわれわれはわれわれの神、主の名によって、とこしえに歩む。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 4:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.4.p2.b1": {
    "text": "主は言われる、その日には、わたしはかの足のなえた者を集め、またかの追いやられた者およびわたしが苦しめた者を集め、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 4:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.4.p2.b2": {
    "text": "羊の群れのやぐら、シオンの娘の山よ、以前の主権はあなたに帰ってくる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 4:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.4.p2.b3": {
    "text": "シオンの娘よ、産婦のように苦しんでうめけ。……バビロンに行かなければならない。その所であなたは救われる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 4:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.4.p2.b4": {
    "text": "どうかシオンが汚されるように、われわれの目がシオンを見てあざ笑うように",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 4:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.4.p2.b5": {
    "text": "シオンの娘よ、立って打ちこなせ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 4:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.4.p2.b6": {
    "text": "わたしはあなたの角を鉄となし、あなたのひずめを青銅としよう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 4:13"
    },
    "adapted": false,
    "status": "approved"
  }
}
