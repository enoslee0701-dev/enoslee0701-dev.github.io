{
  "matthew.4.p1.b1": {
    "text": "当时，耶稣被圣灵引到旷野，受魔鬼的试探。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "当⁠时，耶⁠稣被圣⁠灵引到旷⁠野，受魔⁠鬼的试⁠探。"
  },
  "matthew.4.p1.b2": {
    "text": "他禁食四十昼夜，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他禁⁠食四⁠十昼⁠夜，"
  },
  "matthew.4.p1.b3": {
    "text": "后来就饿了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "后⁠来就饿了。"
  },
  "matthew.4.p2.b1": {
    "text": "那试探人的进前来，对他说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:3"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "那试⁠探人⁠的进前来，对他说："
  },
  "matthew.4.p2.b2": {
    "text": "你若是　神的儿子，可以吩咐这些石头变成食物。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:3"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你若⁠是　神的儿⁠子，可⁠以吩⁠咐这⁠些石⁠头变⁠成食⁠物。"
  },
  "matthew.4.p2.b3": {
    "text": "耶稣却回答说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:4"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣却回⁠答⁠说："
  },
  "matthew.4.p2.b4": {
    "text": "经上记着说：人活着，不是单靠食物，乃是靠　神口里所出的一切话。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:4"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "经上记着说：人活⁠着，不⁠是单靠食⁠物，乃⁠是靠　神口⁠里所出的一⁠切话。"
  },
  "matthew.4.p3.b1": {
    "text": "魔鬼就带他进了圣城，叫他站在殿顶上，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:5"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "魔⁠鬼就带他进了圣⁠城，叫他站⁠在殿顶上，"
  },
  "matthew.4.p3.b2": {
    "text": "你若是　神的儿子，可以跳下去，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:6"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你若⁠是　神的儿⁠子，可⁠以跳⁠下⁠去，"
  },
  "matthew.4.p3.b3": {
    "text": "因为经上记着说：主要为你吩咐他的使者用手托着你，免得你的脚碰在石头上。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:6"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "因⁠为经上记着说：主⁠要为你吩⁠咐他⁠的使⁠者用手托着你，免⁠得你⁠的脚碰在石⁠头上。"
  },
  "matthew.4.p3.b4": {
    "text": "经上又记着说：『不可试探主—你的　神。』",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "经上又记着说：『不⁠可试⁠探主—你⁠的　神。』"
  },
  "matthew.4.p4.b1": {
    "text": "魔鬼又带他上了一座最高的山，将世上的万国与万国的荣华都指给他看，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "魔⁠鬼又带他上⁠了一⁠座最⁠高的山，将世⁠上的万⁠国与万⁠国的荣⁠华都指给他看，"
  },
  "matthew.4.p4.b2": {
    "text": "你若俯伏拜我，我就把这一切都赐给你。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:9"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你若俯⁠伏拜我，我就⁠把这一⁠切⁠都赐⁠给你。"
  },
  "matthew.4.p4.b3": {
    "text": "撒但，退去吧！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:10"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "撒⁠但，退⁠去吧！"
  },
  "matthew.4.p4.b4": {
    "text": "因为经上记着说：当拜主—你的　神，单要事奉他。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:10"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "因⁠为经上记着说：当拜主—你⁠的　神，单要事奉他。"
  },
  "matthew.4.p5.b1": {
    "text": "于是，魔鬼离了耶稣，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:11"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "于⁠是，魔⁠鬼离⁠了耶⁠稣，"
  },
  "matthew.4.p5.b2": {
    "text": "有天使来伺候他。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:11"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有天⁠使来伺⁠候他。"
  },
  "matthew.4.p5.b3": {
    "text": "耶稣听见约翰下了监，就退到加利利去；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:12"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣听⁠见约⁠翰下⁠了监，就退⁠到加⁠利⁠利去；"
  },
  "matthew.4.p6.b1": {
    "text": "后又离开拿撒勒，往迦百农去，就住在那里。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "后又离⁠开拿⁠撒⁠勒，往迦⁠百⁠农去，就住⁠在那⁠里。"
  },
  "matthew.4.p6.b2": {
    "text": "那坐在黑暗里的百姓",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:16"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "那坐⁠在黑⁠暗里的百⁠姓"
  },
  "matthew.4.p6.b3": {
    "text": "看见了大光；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:16"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "看⁠见了大⁠光；"
  },
  "matthew.4.p6.b4": {
    "text": "坐在死荫之地的人有光发现照着他们。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:16"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "坐⁠在死荫之⁠地的人有⁠光发⁠现照着他⁠们。"
  },
  "matthew.4.p7.b1": {
    "text": "从那时候，耶稣就传起道来，说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:17"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "从那时⁠候，耶⁠稣就传起道来，说："
  },
  "matthew.4.p7.b2": {
    "text": "天国近了，你们应当悔改！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:17"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "天⁠国近了，你⁠们应⁠当悔⁠改！"
  },
  "matthew.4.p8.b1": {
    "text": "耶稣在加利利海边行走，看见弟兄二人，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:18"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣在加⁠利⁠利海⁠边行⁠走，看⁠见弟⁠兄二⁠人，"
  },
  "matthew.4.p8.b2": {
    "text": "就是那称呼彼得的西门和他兄弟安得烈，在海里撒网；他们本是打鱼的。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:18"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "就⁠是那称⁠呼彼⁠得的西⁠门和他兄⁠弟安⁠得⁠烈，在海⁠里撒网；他⁠们本是打⁠鱼的。"
  },
  "matthew.4.p8.b3": {
    "text": "来跟从我，我要叫你们得人如得鱼一样。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:19"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "来跟从我，我⁠要叫你⁠们得人如得鱼一⁠样。"
  },
  "matthew.4.p8.b4": {
    "text": "他们就立刻舍了网，跟从了他。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:20"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠们就立⁠刻舍了网，跟从了他。"
  },
  "matthew.4.p9.b1": {
    "text": "从那里往前走，又看见弟兄二人，就是西庇太的儿子雅各和他兄弟约翰，同他们的父亲西庇太在船上补网，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:21"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "从那⁠里往⁠前⁠走，又看⁠见弟⁠兄二⁠人，就⁠是西⁠庇⁠太的儿⁠子雅⁠各和他兄⁠弟约⁠翰，同他⁠们的父⁠亲西⁠庇⁠太在船⁠上补网，"
  },
  "matthew.4.p9.b2": {
    "text": "耶稣就招呼他们，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:21"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣就招⁠呼他⁠们，"
  },
  "matthew.4.p9.b3": {
    "text": "他们立刻舍了船，别了父亲，跟从了耶稣。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:22"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠们立⁠刻舍了船，别⁠了父⁠亲，跟从了耶⁠稣。"
  },
  "matthew.4.p10.b1": {
    "text": "耶稣走遍加利利，在各会堂里教训人，传天国的福音，医治百姓各样的病症。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:23"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣走⁠遍加⁠利⁠利，在各会⁠堂里教⁠训人，传天⁠国的福⁠音，医⁠治百⁠姓各⁠样的病⁠症。"
  },
  "matthew.4.p10.b2": {
    "text": "他的名声就传遍了叙利亚。那里的人把一切害病的……都带了来，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:24"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠的名⁠声就传⁠遍了叙⁠利⁠亚。那⁠里的人把一⁠切害⁠病的……都带了来，"
  },
  "matthew.4.p10.b3": {
    "text": "耶稣就治好了他们。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:24"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣就治⁠好了他⁠们。"
  },
  "matthew.4.p10.b4": {
    "text": "当下，有许多人从加利利、低加坡里、耶路撒冷、犹太、约旦河外来跟着他。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 4:25"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "当⁠下，有许⁠多人从加⁠利⁠利、低加坡里、耶⁠路撒⁠冷、犹⁠太、约⁠旦⁠河外⁠来跟⁠着他。"
  }
}
