{
  "genesis.2.p1.b1": {
    "text": "こうして天と地と、その万象とが完成した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 2:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.2.p1.b2": {
    "text": "神は第七日にその作業を終えられた。すなわち、そのすべての作業を終って第七日に休まれた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 2:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.2.p1.b3": {
    "text": "神はその第七日を祝福して、これを聖別された…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 2:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.2.p2.b4": {
    "text": "地にはまだ野の木もなく…しかし地から泉がわきあがって土の全面を潤していた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 2:5-6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.2.p2.b5": {
    "text": "主なる神は土のちりで人を造り、命の息をその鼻に吹きいれられた。そこで人は生きた者となった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 2:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.2.p3.b6": {
    "text": "主なる神は東のかた、エデンに一つの園を設けて、その造った人をそこに置かれた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 2:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.2.p3.b7": {
    "text": "また一つの川がエデンから流れ出て園を潤し、そこから分れて四つの川となった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 2:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.2.p3.b8": {
    "text": "金のあるハビラの全地…その地の金は良く…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 2:11-12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.2.p4.b9": {
    "text": "主なる神は人を連れて行ってエデンの園に置き、これを耕させ、これを守らせられた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 2:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.2.p4.b10": {
    "text": "あなたは園のどの木からでも心のままに取って食べてよろしい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 2:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.2.p4.b11": {
    "text": "しかし善悪を知る木からは取って食べてはならない。それを取って食べると、きっと死ぬであろう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 2:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.2.p5.b12": {
    "text": "人がひとりでいるのは良くない。彼のために、ふさわしい助け手を造ろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 2:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.2.p5.b13": {
    "text": "人がすべて生き物に与える名は、その名となるのであった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 2:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.2.p5.b14": {
    "text": "人にはふさわしい助け手が見つからなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 2:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.2.p6.b15": {
    "text": "主なる神は人を深く眠らせ…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 2:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.2.p6.b16": {
    "text": "主なる神は人から取ったあばら骨でひとりの女を造り、人のところへ連れてこられた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 2:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.2.p7.b17": {
    "text": "これこそ、ついにわたしの骨の骨、わたしの肉の肉。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 2:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.2.p7.b18": {
    "text": "男から取ったものだから、これを女と名づけよう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 2:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.2.p7.b19": {
    "text": "人とその妻とは、ふたりとも裸であったが、恥ずかしいとは思わなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 2:25"
    },
    "adapted": false,
    "status": "approved"
  }
}
