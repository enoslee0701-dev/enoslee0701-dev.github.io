{
  "micah.6.p1.b1": {
    "text": "立ちあがって、もろもろの山の前に訴えをのべ、もろもろの丘にあなたの声を聞かせよ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 6:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.6.p1.b2": {
    "text": "もろもろの山よ、地の変ることなき基よ、主の言い争いを聞け。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 6:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.6.p1.b3": {
    "text": "わが民よ、わたしはあなたに何をなしたか、何によってあなたを疲れさせたか、わたしに答えよ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 6:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.6.p1.b4": {
    "text": "わたしはエジプトの国からあなたを導きのぼり……モーセ、アロンおよびミリアムをつかわして、あなたに先だたせた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 6:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.6.p1.b5": {
    "text": "わたしは何をもって主のみ前に行き、高き神を拝すべきか。燔祭および当歳の子牛をもってそのみ前に行くべきか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 6:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.6.p1.b6": {
    "text": "わがとがのためにわが長子をささぐべきか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 6:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.6.p1.b7": {
    "text": "人よ、彼はさきによい事のなんであるかをあなたに告げられた。主のあなたに求められることは、ただ公義をおこない、いつくしみを愛し、へりくだってあなたの神と共に歩むことではないか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 6:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.6.p2.b1": {
    "text": "主の声が町にむかって呼ばわる……全き知恵はあなたの名を恐れることである",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 6:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.6.p2.b2": {
    "text": "わたしは悪人の家にある不義の財宝、のろうべき不正な枡を忘れ得ようか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 6:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.6.p2.b3": {
    "text": "不正なはかりを用い、偽りのおもしを入れた袋を用いる人をわたしは罪なしとするだろうか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 6:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.6.p2.b4": {
    "text": "あなたのうちの富める人は暴虐で満ち、あなたの住民は偽りを言い、その舌は口で欺くことをなす。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 6:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.6.p2.b5": {
    "text": "あなたは種をまいても、刈ることがなく、オリブの実を踏んでも、その身に油を塗ることがなく、ぶどうを踏んでも、その酒を飲むことがない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 6:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.6.p2.b6": {
    "text": "あなたはオムリの定めを守り、アハブの家のすべてのわざをおこない、彼らの計りごとに従って歩んだ。……わたしがあなたを荒し",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 6:16"
    },
    "adapted": false,
    "status": "approved"
  }
}
