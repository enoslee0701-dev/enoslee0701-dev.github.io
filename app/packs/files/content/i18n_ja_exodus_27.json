{
  "exodus.27.p1.b1": {
    "text": "あなたはまたアカシヤ材で祭壇を造らなければならない。長さ五キュビト、幅五キュビトの四角で、高さは三キュビトである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 27:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.27.p1.b2": {
    "text": "その四すみの上にその一部としてそれの角を造り、青銅で祭壇をおおわなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 27:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.27.p1.b3": {
    "text": "そのさおを環に通し、さおを祭壇の両側にして、これをかつがなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 27:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.27.p1.b4": {
    "text": "祭壇は板で空洞に造り、山で示されたように、これを造らなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 27:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.27.p2.b5": {
    "text": "あなたはまた幕屋の庭を造り、両側では庭のために長さ百キュビトの亜麻の撚糸のあげばりを設け、その一方に当てなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 27:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.27.p2.b6": {
    "text": "庭の周囲の柱はみな銀の桁でつなぎ、その鉤は銀、その座は青銅にしなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 27:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.27.p2.b7": {
    "text": "庭の長さは百キュビト、その幅は五十キュビト、その高さは五キュビトで …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 27:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.27.p2.b8": {
    "text": "庭の門のために青糸、紫糸、緋糸、亜麻の撚糸で、色とりどりに織った長さ二十キュビトのとばりを設けなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 27:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.27.p3.b9": {
    "text": "あなたはまたイスラエルの人々に命じて、オリブをつぶして採った純粋の油を、ともし火のために持ってこさせ、絶えずともし火をともさなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 27:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.27.p3.b10": {
    "text": "アロンとその子たちとは、会見の幕屋の中のあかしの箱の前にある垂幕の外で、夕から朝まで主の前に、そのともし火を整えなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 27:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.27.p3.b11": {
    "text": "これはイスラエルの人々の守るべき世々変らざる定めでなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 27:21"
    },
    "adapted": false,
    "status": "approved"
  }
}
