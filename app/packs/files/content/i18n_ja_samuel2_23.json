{
  "samuel2.23.p1.b1": {
    "text": "これはダビデの最後の言葉である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 23:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p1.b2": {
    "text": "エッサイの子ダビデの託宣、すなわち高く挙げられた人、ヤコブの神に油を注がれた人、イスラエルの良き歌びとの託宣。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 23:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p1.b3": {
    "text": "「主の霊はわたしによって語る、その言葉はわたしの舌の上にある。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 23:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p2.b1": {
    "text": "イスラエルの神は語られた、イスラエルの岩はわたしに言われた、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 23:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p2.b2": {
    "text": "人を正しく治める者、神を恐れて、治める者は、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 23:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p2.b3": {
    "text": "朝の光のように、雲のない朝に、輝きでる太陽のように、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 23:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p2.b4": {
    "text": "地に若草を芽ばえさせる雨のように人に臨む",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 23:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p3.b1": {
    "text": "まことに、わが家はそのように、神と共にあるではないか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 23:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p3.b2": {
    "text": "それは、神が、よろず備わって確かなとこしえの契約をわたしと結ばれたからだ。どうして彼はわたしの救と願いを、皆なしとげられぬことがあろうか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 23:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p3.b3": {
    "text": "しかし、よこしまな人は、いばらのようで、… 彼らはことごとく火で焼かれるであろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 23:6-7"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p4.b1": {
    "text": "ダビデの勇士たちの名は次のとおりである。タクモンびとヨセブ・バッセベテ … 彼はいちじに八百人に向かって、やりをふるい、それを殺した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 23:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p4.b2": {
    "text": "立ってペリシテびとを撃ち、ついに手が疲れ、手がつるぎに着いて離れないほどになった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 23:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p4.b3": {
    "text": "そこに一面にレンズ豆を作った地所があった。民はペリシテびとの前から逃げたが、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 23:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p4.b4": {
    "text": "彼はその地所の中に立って、これを防ぎ、ペリシテびとを殺した。そして主は大いなる救を与えられた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 23:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p5.b1": {
    "text": "三十人の長たちのうちの三人は下って行って刈入れのころに、アドラムのほら穴にいるダビデのもとにきた。… ペリシテびとの先陣はベツレヘムにあったが、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 23:13-14"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p5.b2": {
    "text": "だれかベツレヘムの門のかたわらにある井戸の水をわたしに飲ませてくれるとよいのだが",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 23:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p5.b3": {
    "text": "しかしダビデはそれを飲もうとはせず、主の前にそれを注いで、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 23:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p5.b4": {
    "text": "主よ、わたしは断じて飲むことをいたしません。いのちをかけて行った人々の血を、どうしてわたしは飲むことができましょう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 23:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p6.b1": {
    "text": "ゼルヤの子ヨアブの兄弟アビシャイは三十人の長であった。彼は三百人に向かって、やりをふるい、それを殺した。そして、彼は三人と共に名を得た。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 23:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p6.b2": {
    "text": "エホヤダの子ベナヤはカブジエル出身の勇士であって、多くのてがらを立てた。彼はモアブのアリエルのふたりの子を撃ち殺した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 23:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p6.b3": {
    "text": "彼はまた雪の日に下っていって、穴の中でししを撃ち殺した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 23:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p6.b4": {
    "text": "… ベナヤはつえをとってその所に下っていき、エジプトびとの手からやりをもぎとって、そのやりをもって殺した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 23:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p7.b1": {
    "text": "三十人のうちにあったのは、ヨアブの兄弟アサヘル。ベツレヘム出身のドドの子エルハナン。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 23:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p7.b2": {
    "text": "ヘテびとウリヤ。合わせて三十七人である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 23:39"
    },
    "adapted": false,
    "status": "approved"
  }
}
