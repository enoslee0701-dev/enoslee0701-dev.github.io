{
  "matthew.28.p1.b1": {
    "text": "安息日将尽，七日的头一日，天快亮的时候，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "安⁠息⁠日将⁠尽，七⁠日的头一⁠日，天快亮的时⁠候，"
  },
  "matthew.28.p1.b2": {
    "text": "抹大拉的马利亚和那个马利亚来看坟墓。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "抹⁠大⁠拉的马⁠利⁠亚和那⁠个马⁠利⁠亚来⁠看坟⁠墓。"
  },
  "matthew.28.p1.b3": {
    "text": "忽然，地大震动；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "忽⁠然，地大震⁠动；"
  },
  "matthew.28.p1.b4": {
    "text": "因为有主的使者从天上下来，把石头滚开，坐在上面。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "因⁠为有主的使⁠者从天⁠上下⁠来，把石⁠头滚⁠开，坐⁠在上⁠面。"
  },
  "matthew.28.p2.b1": {
    "text": "他的相貌如同闪电，衣服洁白如雪。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:3"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠的相⁠貌如⁠同闪⁠电，衣⁠服洁⁠白如雪。"
  },
  "matthew.28.p2.b2": {
    "text": "看守的人就因他吓得浑身乱战，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:4"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "看⁠守的人就⁠因他吓得浑⁠身乱战，"
  },
  "matthew.28.p2.b3": {
    "text": "甚至和死人一样。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:4"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "甚⁠至和死⁠人一⁠样。"
  },
  "matthew.28.p3.b1": {
    "text": "不要害怕！我知道你们是寻找那钉十字架的耶稣。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:5"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "不⁠要害⁠怕！我⁠知⁠道你⁠们是寻⁠找那钉十⁠字⁠架的耶⁠稣。"
  },
  "matthew.28.p3.b2": {
    "text": "他不在这里，照他所说的，已经复活了。你们来看安放主的地方。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:6"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他不⁠在这⁠里，照他⁠所说⁠的，已⁠经复⁠活了。你⁠们来⁠看安⁠放主的地⁠方。"
  },
  "matthew.28.p3.b3": {
    "text": "快去告诉他的门徒，说他从死里复活了，并且在你们以先往加利利去，在那里你们要见他。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "快⁠去告⁠诉他⁠的门⁠徒，说他从死里复⁠活了，并⁠且在你⁠们以先⁠往加⁠利⁠利去，在那⁠里你⁠们要见他。"
  },
  "matthew.28.p3.b4": {
    "text": "看哪，我已经告诉你们了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "看哪，我已⁠经告⁠诉你⁠们了。"
  },
  "matthew.28.p4.b1": {
    "text": "妇女们就急忙离开坟墓，又害怕，又大大地欢喜，跑去要报给他的门徒。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "妇⁠女们就急⁠忙离⁠开坟⁠墓，又害⁠怕，又大大⁠地欢⁠喜，跑⁠去要报给他⁠的门⁠徒。"
  },
  "matthew.28.p4.b2": {
    "text": "忽然，耶稣遇见她们，说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:9"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "忽⁠然，耶⁠稣遇⁠见她⁠们，说："
  },
  "matthew.28.p4.b3": {
    "text": "愿你们平安！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:9"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "愿你⁠们平⁠安！"
  },
  "matthew.28.p4.b4": {
    "text": "她们就上前抱住他的脚拜他。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:9"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "她⁠们就上⁠前抱⁠住他⁠的脚拜他。"
  },
  "matthew.28.p5.b1": {
    "text": "不要害怕！你们去告诉我的弟兄，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:10"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "不⁠要害⁠怕！你⁠们去告⁠诉我⁠的弟⁠兄，"
  },
  "matthew.28.p5.b2": {
    "text": "叫他们往加利利去，在那里必见我。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:10"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "叫他⁠们往加⁠利⁠利去，在那⁠里必见我。"
  },
  "matthew.28.p5.b3": {
    "text": "她们去的时候，看守的兵有几个进城去，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:11"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "她⁠们去的时⁠候，看⁠守的兵有几⁠个进城去，"
  },
  "matthew.28.p5.b4": {
    "text": "将所经历的事都报给祭司长。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:11"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "将所经⁠历的事都报给祭⁠司⁠长。"
  },
  "matthew.28.p6.b1": {
    "text": "祭司长和长老聚集商议，就拿许多银钱给兵丁，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:12"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "祭⁠司⁠长和长⁠老聚⁠集商⁠议，就⁠拿许⁠多银⁠钱给兵⁠丁，"
  },
  "matthew.28.p6.b2": {
    "text": "你们要这样说：『夜间我们睡觉的时候，他的门徒来，把他偷去了。』",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们要这⁠样说：『夜⁠间我⁠们睡⁠觉的时⁠候，他⁠的门⁠徒来，把他偷⁠去了。』"
  },
  "matthew.28.p6.b3": {
    "text": "倘若这话被巡抚听见，有我们劝他，保你们无事。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:14"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "倘⁠若这话被巡⁠抚听⁠见，有我⁠们劝他，保你⁠们无⁠事。"
  },
  "matthew.28.p6.b4": {
    "text": "这话就传说在犹太人中间，直到今日。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:15"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "这话就传⁠说在犹⁠太⁠人中⁠间，直⁠到今⁠日。"
  },
  "matthew.28.p7.b1": {
    "text": "十一个门徒往加利利去，到了耶稣约定的山上。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:16"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "十一⁠个门⁠徒往加⁠利⁠利去，到⁠了耶⁠稣约⁠定的山⁠上。"
  },
  "matthew.28.p7.b2": {
    "text": "他们见了耶稣就拜他，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:17"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠们见⁠了耶⁠稣就拜他，"
  },
  "matthew.28.p7.b3": {
    "text": "然而还有人疑惑。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:17"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "然⁠而还⁠有人疑⁠惑。"
  },
  "matthew.28.p8.b1": {
    "text": "耶稣进前来，对他们说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:18"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣进前来，对他⁠们说："
  },
  "matthew.28.p8.b2": {
    "text": "天上地下所有的权柄都赐给我了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:18"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "天⁠上地⁠下所⁠有的权⁠柄都赐⁠给我了。"
  },
  "matthew.28.p8.b3": {
    "text": "所以，你们要去，使万民作我的门徒，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:19"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "所⁠以，你⁠们要去，使万⁠民作我⁠的门⁠徒，"
  },
  "matthew.28.p8.b4": {
    "text": "奉父、子、圣灵的名给他们施洗。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:19"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "奉父、子、圣⁠灵的名给他⁠们施⁠洗。"
  },
  "matthew.28.p9.b1": {
    "text": "凡我所吩咐你们的，都教训他们遵守，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:20"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "凡我所吩⁠咐你⁠们的，都教⁠训他⁠们遵⁠守，"
  },
  "matthew.28.p9.b2": {
    "text": "我就常与你们同在，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:20"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我就常与你⁠们同在，"
  },
  "matthew.28.p9.b3": {
    "text": "直到世界的末了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 28:20"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "直⁠到世⁠界的末了。"
  }
}
