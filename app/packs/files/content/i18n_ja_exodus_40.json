{
  "exodus.40.p1.b1": {
    "text": "主はモーセに言われた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 40:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.40.p1.b2": {
    "text": "「正月の元日にあなたは会見の天幕なる幕屋を建てなければならない。 そして、その中にあかしの箱を置き、垂幕で、箱を隔て隠し、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 40:2-3"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.40.p1.b3": {
    "text": "……彼らが油そそがれることは、代々ながく祭司職のためになすべきことである",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 40:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.40.p1.b4": {
    "text": "モーセはそのように行った。すなわち主が彼に命じられたように行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 40:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.40.p2.b5": {
    "text": "第二年の正月になって、その月の元日に幕屋は建った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 40:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.40.p2.b6": {
    "text": "すなわちモーセは幕屋を建て、その座をすえ、その枠を立て、その横木をさし込み、その柱を立て、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 40:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.40.p2.b7": {
    "text": "幕屋の上に天幕をひろげ、その上に天幕のおおいをかけた。主がモーセに命じられたとおりである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 40:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.40.p3.b8": {
    "text": "彼はまたあかしの板をとって箱に納め、さおを箱につけ、贖罪所を箱の上に置き、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 40:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.40.p3.b9": {
    "text": "箱を幕屋に携え入れ、隔ての垂幕をかけて、あかしの箱を隠した。主がモーセに命じられたとおりである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 40:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.40.p4.b10": {
    "text": "その上にパンを列に並べて、主の前に供えた。主がモーセに命じられたとおりである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 40:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.40.p4.b11": {
    "text": "彼はまた会見の天幕なる幕屋の内部の南側に、……燭台をすえ、主の前にともしびをともした。主がモーセに命じられたとおりである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 40:24-25"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.40.p4.b12": {
    "text": "モーセとアロンおよびその子たちは、それで手と足を洗った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 40:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.40.p4.b13": {
    "text": "……このようにしてモーセはその工事を終えた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 40:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.40.p5.b14": {
    "text": "そのとき、雲は会見の天幕をおおい、主の栄光が幕屋に満ちた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 40:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.40.p5.b15": {
    "text": "モーセは会見の幕屋に、はいることができなかった。雲がその上にとどまり、……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 40:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.40.p6.b16": {
    "text": "雲が幕屋の上からのぼる時、イスラエルの人々は道に進んだ。彼らはその旅路において常にそうした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 40:36"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.40.p6.b17": {
    "text": "しかし、雲がのぼらない時は、そののぼる日まで道に進まなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 40:37"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.40.p6.b18": {
    "text": "すなわちイスラエルの家のすべての者の前に、昼は幕屋の上に主の雲があり、夜は雲の中に火があった。彼らの旅路において常にそうであった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 40:38"
    },
    "adapted": false,
    "status": "approved"
  }
}
