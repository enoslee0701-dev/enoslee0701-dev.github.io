{
  "titus.2.p1.b1": {
    "text": "しかし、あなたは、健全な教にかなうことを語りなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Titus 2:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "titus.2.p1.b2": {
    "text": "老人たちには自らを制し、謹厳で、慎み深くし、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Titus 2:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "titus.2.p1.b3": {
    "text": "年老いた女たちにも、同じように、たち居ふるまいをうやうやしくし、…良いことを教える者となるように、勧めなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Titus 2:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "titus.2.p1.b4": {
    "text": "そうすれば、彼女たちは、若い女たちに、夫を愛し、子供を愛し、…神の言がそしりを受けないようになるであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Titus 2:4-5"
    },
    "adapted": false,
    "status": "approved"
  },
  "titus.2.p2.b1": {
    "text": "若い男にも、同じく、万事につけ慎み深くあるように、勧めなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Titus 2:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "titus.2.p2.b2": {
    "text": "あなた自身を良いわざの模範として示し、人を教える場合には、清廉と謹厳とをもってし、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Titus 2:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "titus.2.p2.b3": {
    "text": "非難のない健全な言葉を用いなさい。そうすれば、反対者も、わたしたちについてなんの悪口も言えなくなり、自ら恥じいるであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Titus 2:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "titus.2.p3.b1": {
    "text": "奴隷には、万事につけその主人に服従して、喜ばれるようになり、反抗をせず、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Titus 2:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "titus.2.p3.b2": {
    "text": "盗みをせず、どこまでも心をこめた真実を示すようにと、勧めなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Titus 2:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "titus.2.p3.b3": {
    "text": "そうすれば、彼らは万事につけ、わたしたちの救主なる神の教を飾ることになろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Titus 2:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "titus.2.p4.b1": {
    "text": "すべての人を救う神の恵みが現れた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Titus 2:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "titus.2.p4.b2": {
    "text": "そして、わたしたちを導き、…慎み深く、正しく、信心深くこの世で生活し、 祝福に満ちた望み…を待ち望むようにと、教えている。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Titus 2:12-13"
    },
    "adapted": false,
    "status": "approved"
  },
  "titus.2.p4.b3": {
    "text": "このキリストが、わたしたちのためにご自身をささげられたのは、…良いわざに熱心な選びの民を、ご自身のものとして聖別するためにほかならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Titus 2:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "titus.2.p4.b4": {
    "text": "あなたは、権威をもってこれらのことを語り、勧め、また責めなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Titus 2:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "titus.2.p4.b5": {
    "text": "だれにも軽んじられてはならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Titus 2:15"
    },
    "adapted": false,
    "status": "approved"
  }
}
