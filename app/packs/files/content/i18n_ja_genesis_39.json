{
  "genesis.39.p1.b1": {
    "text": "さてヨセフは連れられてエジプトに下ったが、パロの役人で侍衛長であったエジプトびとポテパルは、彼をそこに連れ下ったイシマエルびとらの手から買い取った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 39:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.39.p1.b2": {
    "text": "主がヨセフと共におられたので、彼は幸運な者となり、その主人エジプトびとの家におった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 39:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.39.p1.b3": {
    "text": "その主人は主が彼とともにおられることと、主が彼の手のすることをすべて栄えさせられるのを見た。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 39:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.39.p2.b1": {
    "text": "彼はヨセフに家をつかさどらせ、持ち物をみな彼の手にゆだねた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 39:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.39.p2.b2": {
    "text": "主はヨセフのゆえにそのエジプトびとの家を恵まれたので、主の恵みは彼の家と畑とにあるすべての持ち物に及んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 39:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.39.p2.b3": {
    "text": "…自分が食べる物のほかは、何をも顧みなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 39:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.39.p2.b4": {
    "text": "さてヨセフは姿がよく、顔が美しかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 39:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.39.p3.b1": {
    "text": "これらの事の後、主人の妻はヨセフに目をつけて…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 39:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.39.p3.b2": {
    "text": "わたしと寝なさい",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 39:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.39.p3.b3": {
    "text": "御主人はわたしがいるので家の中の何をも顧みず、その持ち物をみなわたしの手にゆだねられました。…あなたを除いては、何をもわたしに禁じられませんでした。あなたが御主人の妻であるからです。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 39:8-9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.39.p3.b4": {
    "text": "どうしてわたしはこの大きな悪をおこなって、神に罪を犯すことができましょう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 39:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.39.p3.b5": {
    "text": "彼女は毎日ヨセフに言い寄ったけれども、ヨセフは聞きいれず、彼女と寝なかった。また共にいなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 39:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.39.p4.b1": {
    "text": "ある日ヨセフが務をするために家にはいった時、家の者がひとりもそこにいなかったので、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 39:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.39.p4.b2": {
    "text": "わたしと寝なさい",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 39:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.39.p4.b3": {
    "text": "ヨセフは着物を彼女の手に残して外にのがれ出た。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 39:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.39.p5.b1": {
    "text": "彼女はヨセフが着物を自分の手に残して外にのがれたのを見て、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 39:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.39.p5.b2": {
    "text": "主人がわたしたちの所に連れてきたヘブルびとは、わたしたちに戯れます。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 39:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.39.p5.b3": {
    "text": "彼女はその着物をかたわらに置いて、主人の帰って来るのを待った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 39:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.39.p5.b4": {
    "text": "あなたがわたしたちに連れてこられたヘブルのしもべはわたしに戯れようとして、わたしの所にはいってきました。わたしが声をあげて叫んだので、彼は着物をわたしの所に残して外にのがれました",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 39:17-18"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.39.p6.b1": {
    "text": "主人はその妻が…告げる言葉を聞いて、激しく怒った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 39:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.39.p6.b2": {
    "text": "そしてヨセフの主人は彼を捕えて、王の囚人をつなぐ獄屋に投げ入れた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 39:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.39.p6.b3": {
    "text": "こうしてヨセフは獄屋の中におった",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 39:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.39.p7.b1": {
    "text": "主はヨセフと共におられて彼にいつくしみを垂れ、獄屋番の恵みをうけさせられた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 39:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.39.p7.b2": {
    "text": "獄屋番は獄屋におるすべての囚人をヨセフの手にゆだねた…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 39:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.39.p7.b3": {
    "text": "…主がヨセフと共におられたからである。主は彼のなす事を栄えさせられた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 39:23"
    },
    "adapted": false,
    "status": "approved"
  }
}
