{
  "mark.16.p1.b1": {
    "text": "过了安息日，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "过了安⁠息⁠日，"
  },
  "mark.16.p1.b2": {
    "text": "抹大拉的马利亚和雅各的母亲马利亚并撒罗米，买了香膏",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "抹⁠大⁠拉的马⁠利⁠亚和雅⁠各的母⁠亲马⁠利⁠亚并撒⁠罗⁠米，买了香⁠膏"
  },
  "mark.16.p1.b3": {
    "text": "要去膏耶稣的身体。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "要去膏耶⁠稣的身⁠体。"
  },
  "mark.16.p2.b1": {
    "text": "七日的第一日清早，出太阳的时候，她们来到坟墓那里，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "七⁠日的第⁠一日清⁠早，出太⁠阳的时⁠候，她⁠们来⁠到坟⁠墓那⁠里，"
  },
  "mark.16.p2.b2": {
    "text": "谁给我们把石头从墓门滚开呢？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:3"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "谁给我⁠们把石⁠头从墓门滚⁠开呢？"
  },
  "mark.16.p2.b3": {
    "text": "那石头原来很大，她们抬头一看，却见石头已经滚开了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:4"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "那石⁠头原⁠来很⁠大，她⁠们抬⁠头一⁠看，却见石⁠头已⁠经滚⁠开了。"
  },
  "mark.16.p3.b1": {
    "text": "她们进了坟墓，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:5"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "她⁠们进了坟⁠墓，"
  },
  "mark.16.p3.b2": {
    "text": "看见一个少年人坐在右边，穿着白袍，就甚惊恐。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:5"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "看⁠见一⁠个少⁠年人坐⁠在右⁠边，穿⁠着白袍，就甚惊⁠恐。"
  },
  "mark.16.p3.b3": {
    "text": "不要惊恐！你们寻找那钉十字架的拿撒勒人耶稣，他已经复活了，不在这里。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:6"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "不⁠要惊⁠恐！你⁠们寻⁠找那钉十⁠字⁠架的拿⁠撒⁠勒人耶⁠稣，他已⁠经复⁠活了，不⁠在这⁠里。"
  },
  "mark.16.p3.b4": {
    "text": "请看安放他的地方。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:6"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "请⁠看安⁠放他⁠的地⁠方。"
  },
  "mark.16.p4.b1": {
    "text": "你们可以去告诉他的门徒和彼得，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们可⁠以去告⁠诉他⁠的门⁠徒和彼⁠得，"
  },
  "mark.16.p4.b2": {
    "text": "他在你们以先往加利利去。在那里你们要见他，正如他从前所告诉你们的。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠在你⁠们以先⁠往加⁠利⁠利去。在那⁠里你⁠们要见他，正⁠如他从⁠前所告⁠诉你⁠们的。"
  },
  "mark.16.p4.b3": {
    "text": "她们就出来，从坟墓那里逃跑，又发抖又惊奇，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "她⁠们就出⁠来，从坟⁠墓那⁠里逃⁠跑，又发⁠抖又惊⁠奇，"
  },
  "mark.16.p4.b4": {
    "text": "什么也不告诉人，因为她们害怕。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "什⁠么也⁠不告⁠诉人，因⁠为她⁠们害⁠怕。"
  },
  "mark.16.p5.b1": {
    "text": "在七日的第一日清早，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:9"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "在七⁠日的第⁠一日清⁠早，"
  },
  "mark.16.p5.b2": {
    "text": "耶稣复活了，就先向抹大拉的马利亚显现",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:9"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣复⁠活了，就先⁠向抹⁠大⁠拉的马⁠利⁠亚显⁠现"
  },
  "mark.16.p5.b3": {
    "text": "她去告诉那向来跟随耶稣的人；那时他们正哀恸哭泣。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:10"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "她去告⁠诉那向⁠来跟⁠随耶⁠稣的人；那⁠时他⁠们正哀⁠恸哭⁠泣。"
  },
  "mark.16.p5.b4": {
    "text": "他们听见耶稣活了，被马利亚看见，却是不信。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:11"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠们听⁠见耶⁠稣活⁠了，被马⁠利⁠亚看⁠见，却是不⁠信。"
  },
  "mark.16.p6.b1": {
    "text": "这事以后，门徒中间有两个人往乡下去。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:12"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "这事以⁠后，门⁠徒中⁠间有两个⁠人往乡下⁠去。"
  },
  "mark.16.p6.b2": {
    "text": "走路的时候，耶稣变了形象，向他们显现。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:12"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "走⁠路的时⁠候，耶⁠稣变了形⁠象，向他⁠们显⁠现。"
  },
  "mark.16.p6.b3": {
    "text": "他们就去告诉其余的门徒；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠们就⁠去告⁠诉其⁠余的门⁠徒；"
  },
  "mark.16.p6.b4": {
    "text": "其余的门徒也是不信。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "其⁠余的门⁠徒也⁠是不⁠信。"
  },
  "mark.16.p7.b1": {
    "text": "后来，十一个门徒坐席的时候，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:14"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "后⁠来，十一⁠个门⁠徒坐⁠席的时⁠候，"
  },
  "mark.16.p7.b2": {
    "text": "耶稣向他们显现，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:14"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣向他⁠们显⁠现，"
  },
  "mark.16.p7.b3": {
    "text": "责备他们不信，心里刚硬，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:14"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "责⁠备他⁠们不⁠信，心⁠里刚⁠硬，"
  },
  "mark.16.p7.b4": {
    "text": "因为他们不信那些在他复活以后看见他的人。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:14"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "因⁠为他⁠们不⁠信那⁠些在他复⁠活以⁠后看⁠见他⁠的人。"
  },
  "mark.16.p8.b1": {
    "text": "你们往普天下去，传福音给万民听。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:15"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们往普⁠天下⁠去，传福⁠音给万⁠民听。"
  },
  "mark.16.p8.b2": {
    "text": "信而受洗的，必然得救；不信的，必被定罪。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:16"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "信而受⁠洗的，必⁠然得⁠救；不⁠信的，必被定⁠罪。"
  },
  "mark.16.p8.b3": {
    "text": "信的人必有神迹随着他们，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:17"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "信的人必⁠有神⁠迹随⁠着他⁠们，"
  },
  "mark.16.p8.b4": {
    "text": "手按病人，病人就必好了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:18"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "手按病⁠人，病⁠人就必好⁠了。"
  },
  "mark.16.p9.b1": {
    "text": "主耶稣和他们说完了话，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:19"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "主耶⁠稣和他⁠们说完⁠了话，"
  },
  "mark.16.p9.b2": {
    "text": "后来被接到天上，坐在神的右边。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:19"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "后⁠来被接⁠到天⁠上，坐⁠在神的右⁠边。"
  },
  "mark.16.p9.b3": {
    "text": "门徒出去，到处宣传福音。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:20"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "门⁠徒出⁠去，到⁠处宣⁠传福⁠音。"
  },
  "mark.16.p9.b4": {
    "text": "主和他们同工，用神迹随着，证实所传的道。阿们！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 16:20"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "主和他⁠们同⁠工，用神⁠迹随⁠着，证⁠实所传的道。阿们！"
  }
}
