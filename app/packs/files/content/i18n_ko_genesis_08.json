{
  "genesis.8.p1.b1": {
    "text": "하나님이 노아와 그와 함께 방주에 있는 모든 들짐승과 육축을 권념하사",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 8:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p1.b2": {
    "text": "바람으로 땅 위에 불게 하시매 물이 감하였고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 8:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p1.b3": {
    "text": "깊음의 샘과 하늘의 창이 막히고 하늘에서 비가 그치매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 8:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p2.b4": {
    "text": "칠월 곧 그 달 십칠일에 방주가 아라랏 산에 머물렀으며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 8:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p2.b5": {
    "text": "물이 점점 감하여 시월 곧 그달 일일에 산들의 봉우리가 보였더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 8:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p3.b6": {
    "text": "사십일을 지나서 노아가 그 방주에 지은 창을 열고 까마귀를 내어 놓으매 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 8:6-7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p3.b7": {
    "text": "온 지면에 물이 있으므로 비둘기가 접족할 곳을 찾지 못하고 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 8:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p3.b8": {
    "text": "방주로 돌아와 그에게로 오는지라 그가 손을 내밀어 방주 속 자기에게로 받아 들이고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 8:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p4.b9": {
    "text": "저녁때에 비둘기가 그에게로 돌아왔는데 그 입에 감람 새 잎사귀가 있는지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 8:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p4.b10": {
    "text": "이에 노아가 땅에 물이 감한 줄 알았으며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 8:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p4.b11": {
    "text": "또 칠일을 기다려 비둘기를 내어 놓으매 다시는 그에게로 돌아오지 아니하였더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 8:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p5.b12": {
    "text": "육백 일년 정월 곧 그 달 일일에 지면에 물이 걷힌지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 8:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p5.b13": {
    "text": "노아가 방주 뚜껑을 제치고 본즉 지면에 물이 걷혔더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 8:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p5.b14": {
    "text": "이월 이십 칠일에 땅이 말랐더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 8:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p6.b15": {
    "text": "너는 네 아내와 네 아들들과 네 자부들로 더불어 방주에서 나오고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 8:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p6.b16": {
    "text": "… 이것들이 땅에서 생육하고 땅에서 번성 하리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 8:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p6.b17": {
    "text": "노아가 그 아들들과 그 아내와 그 자부들과 함께 나왔고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 8:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p6.b18": {
    "text": "땅 위의 동물 곧 모든 짐승과 모든 기는 것과 모든 새도 그 종류대로 방주에서 나왔더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 8:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p7.b19": {
    "text": "노아가 여호와를 위하여 단을 쌓고 모든 정결한 짐승 중에서와 모든 정결한 새 중에서 취하여 번제로 단에 드렸더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 8:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p7.b20": {
    "text": "내가 다시는 사람으로 인하여 땅을 저주하지 아니하리니 … 내가 전에 행한 것같이 모든 생물을 멸하지 아니하리니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 8:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p7.b21": {
    "text": "땅이 있을 동안에는 심음과 거둠과 추위와 더위와 여름과 겨울과 낮과 밤이 쉬지 아니하리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 8:22"
    },
    "adapted": false,
    "status": "approved"
  }
}
