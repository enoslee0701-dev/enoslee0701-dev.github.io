{
  "matthew.14.p1.b1": {
    "text": "그 때에 분봉왕 헤롯이 예수의 소문을 듣고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p1.b2": {
    "text": "이는 세례 요한이라 저가 죽은 자 가운데서 살아났으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p1.b3": {
    "text": "그러므로 이런 권능이 그 속에서 운동하는도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p2.b1": {
    "text": "전에 헤롯이 그 동생 빌립의 아내 헤로디아의 일로",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p2.b2": {
    "text": "요한을 잡아 결박하여 옥에 가두었으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p2.b3": {
    "text": "당신이 그 여자를 취한 것이 옳지 않다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p2.b4": {
    "text": "헤롯이 요한을 죽이려 하되 민중이 저를 선지자로 여기므로 민중을 두려워하더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p3.b1": {
    "text": "마침 헤롯의 생일을 당하여 헤로디아의 딸이 연석 가운데서 춤을 추어 헤롯을 기쁘게 하니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p3.b2": {
    "text": "헤롯이 맹세로 그에게 무엇이든지 달라는대로 주겠다 허락하거늘",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p3.b3": {
    "text": "그가 제 어미의 시킴을 듣고 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p3.b4": {
    "text": "세례 요한의 머리를 소반에 담아 여기서 내게 주소서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p4.b1": {
    "text": "왕이 근심하나 자기의 맹세한 것과 그 함께 앉은 사람들을 인하여 주라 명하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p4.b2": {
    "text": "사람을 보내어 요한을 옥에서 목 베어",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p4.b3": {
    "text": "그 머리를 소반에 담아다가 그 여아에게 주니 그가 제 어미에게 가져가니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p5.b1": {
    "text": "요한의 제자들이 와서 시체를 가져다가 장사하고 가서 예수께 고하니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p5.b2": {
    "text": "예수께서 들으시고 배를 타고 떠나사 따로 빈들에 가시니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p5.b3": {
    "text": "무리가 듣고 여러 고을로부터 걸어서 좇아간지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p6.b1": {
    "text": "예수께서 나오사 큰 무리를 보시고 불쌍히 여기사 그 중에 있는 병인을 고쳐 주시니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p6.b2": {
    "text": "저녁이 되매 제자들이 나아와 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p6.b3": {
    "text": "이곳은 빈들이요 때도 이미 저물었으니 무리를 보내어 마을에 들어가 먹을 것을 사먹게 하소서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p6.b4": {
    "text": "갈것 없다 너희가 먹을 것을 주어라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p7.b1": {
    "text": "여기 우리에게 있는 것은 떡 다섯 개와 물고기 두 마리 뿐이니이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p7.b2": {
    "text": "그것을 내게 가져오라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p7.b3": {
    "text": "무리를 명하여 잔디 위에 앉히시고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p7.b4": {
    "text": "떡 다섯개와 물고기 두 마리를 가지사 하늘을 우러러 축사하시고 떡을 떼어 제자들에게 주시매 제자들이 무리에게 주니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p8.b1": {
    "text": "다 배불리 먹고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p8.b2": {
    "text": "남은 조각을 열 두 바구니에 차게 거두었으며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p8.b3": {
    "text": "먹은 사람은 여자와 아이 외에 오천명이나 되었더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p9.b1": {
    "text": "예수께서 즉시 제자들을 재촉하사 자기가 무리를 보내는 동안에 배를 타고 앞서 건너편으로 가게 하시고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p9.b2": {
    "text": "무리를 보내신 후에 기도하러 따로 산에 올라가시다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p9.b3": {
    "text": "저물매 거기 혼자 계시더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p10.b1": {
    "text": "배가 이미 육지에서 수리나 떠나서 바람이 거슬리므로 물결을 인하여 고난을 당하더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p10.b2": {
    "text": "밤 사경에 예수께서 바다 위로 걸어서 제자들에게 오시니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p10.b3": {
    "text": "유령이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p10.b4": {
    "text": "안심하라 내니 두려워 말라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p11.b1": {
    "text": "주여 만일 주시어든 나를 명하사 물 위로 오라 하소서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p11.b2": {
    "text": "오라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p11.b3": {
    "text": "베드로가 배에서 내려 물 위로 걸어서 예수께로 가되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p12.b1": {
    "text": "바람을 보고 무서워 빠져 가는지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p12.b2": {
    "text": "주여 나를 구원하소서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p12.b3": {
    "text": "예수께서 즉시 손을 내밀어 저를 붙잡으시며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p12.b4": {
    "text": "믿음이 적은 자여 왜 의심하였느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p13.b1": {
    "text": "배에 함께 오르매 바람이 그치는지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p13.b2": {
    "text": "배에 있는 사람들이 예수께 절하며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p13.b3": {
    "text": "진실로 하나님의 아들이로소이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p14.b1": {
    "text": "저희가 건너가 게네사렛 땅에 이르니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p14.b2": {
    "text": "그곳 사람들이 예수신 줄을 알고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p14.b3": {
    "text": "그 근방에 두루 통지하여 모든 병든 자를 예수께 데리고 와서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p15.b1": {
    "text": "다만 예수의 옷가에라도 손을 대게 하시기를 간구하니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:36"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p15.b2": {
    "text": "손을 대는자는 다 나음을 얻으니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 14:36"
    },
    "adapted": false,
    "status": "approved"
  }
}
