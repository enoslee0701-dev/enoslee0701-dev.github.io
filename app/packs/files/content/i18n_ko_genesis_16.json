{
  "genesis.16.p1.b1": {
    "text": "아브람의 아내 사래는 생산치 못하였고 그에게 한 여종이 있으니 애굽 사람이요 이름은 하갈이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 16:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.16.p1.b2": {
    "text": "여호와께서 나의 생산을 허락지 아니 하셨으니 원컨대 나의 여종과 동침하라 내가 혹 그로 말미암아 자녀를 얻을까 하노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 16:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.16.p1.b3": {
    "text": "아브람의 아내 사래가 그 여종 애굽 사람 하갈을 가져 그 남편 아브람에게 첩으로 준 때는 아브람이 가나안 땅에 거한지 십년 후이었더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 16:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.16.p2.b4": {
    "text": "… 하갈이 잉태하매 그가 자기의 잉태함을 깨닫고 그 여주인을 멸시한지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 16:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.16.p2.b5": {
    "text": "나의 받는 욕은 당신이 받아야 옳도다 … 그가 자기의 잉태함을 깨닫고 나를 멸시하니 당신과 나 사이에 여호와께서 판단하시기를 원하노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 16:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.16.p2.b6": {
    "text": "그대의 여종은 그대의 수중에 있으니 그대의 눈에 좋은대로 그에게 행하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 16:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.16.p2.b7": {
    "text": "… 사래가 하갈을 학대하였더니 하갈이 사래의 앞에서 도망하였더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 16:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.16.p3.b8": {
    "text": "여호와의 사자가 광야의 샘곁 곧 술 길 샘물 곁에서 그를 만나",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 16:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.16.p3.b9": {
    "text": "사래의 여종 하갈아 네가 어디서 왔으며 어디로 가느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 16:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.16.p3.b10": {
    "text": "나는 나의 여주인 사래를 피하여 도망하나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 16:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.16.p3.b11": {
    "text": "네 여주인에게로 돌아가서 그 수하에 복종하라 … 내가 네 자손으로 크게 번성하여 그 수가 많아 셀 수 없게 하리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 16:9-10"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.16.p4.b12": {
    "text": "네가 잉태하였은즉 아들을 낳으리니 그 이름을 이스마엘이라 하라 이는 여호와께서 네 고통을 들으셨음이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 16:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.16.p4.b13": {
    "text": "그가 사람 중에 들나귀 같이 되리니 … 그가 모든 형제의 동방에서 살리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 16:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.16.p4.b14": {
    "text": "하갈이 자기에게 이르신 여호와의 이름을 감찰하시는 하나님이라 하였으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 16:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.16.p4.b15": {
    "text": "… 내가 어떻게 여기서 나를 감찰하시는 하나님을 뵈었는고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 16:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.16.p5.b16": {
    "text": "하갈이 아브람의 아들을 낳으매 아브람이 하갈의 낳은 그 아들을 이름하여 이스마엘이라 하였더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 16:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.16.p5.b17": {
    "text": "하갈이 아브람에게 이스마엘을 낳을 때에 아브람이 팔십 육세이었더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 16:16"
    },
    "adapted": false,
    "status": "approved"
  }
}
