{
  "romans.16.p1.b1": {
    "text": "ケンクレヤにある教会の執事、わたしたちの姉妹フィベを、あなたがたに紹介する。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 16:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.16.p1.b2": {
    "text": "どうか、聖徒たるにふさわしく、主にあって彼女を迎え …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 16:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.16.p1.b3": {
    "text": "… 彼女は多くの人の援助者であり、またわたし自身の援助者でもあった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 16:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.16.p2.b1": {
    "text": "キリスト・イエスにあるわたしの同労者プリスカとアクラとに、よろしく言ってほしい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 16:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.16.p2.b2": {
    "text": "彼らは、わたしのいのちを救うために、自分の首をさえ差し出してくれたのである。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 16:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.16.p2.b3": {
    "text": "また、彼らの家の教会にも、よろしく。わたしの愛するエパネトに、よろしく言ってほしい。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 16:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.16.p3.b1": {
    "text": "あなたがたのために一方ならず労苦したマリヤに、よろしく言ってほしい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 16:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.16.p3.b2": {
    "text": "わたしの同族であって、わたしと一緒に投獄されたことのあるアンデロニコとユニアスとに、よろしく。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 16:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.16.p3.b3": {
    "text": "… 彼らは使徒たちの間で評判がよく、かつ、わたしよりも先にキリストを信じた人々である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 16:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.16.p4.b1": {
    "text": "主にあって愛するアムプリアトに、よろしく。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 16:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.16.p4.b2": {
    "text": "キリストにあって錬達なアペレに、よろしく。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 16:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.16.p4.b3": {
    "text": "ナルキソの家の、主にある人たちに、よろしく。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 16:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.16.p5.b1": {
    "text": "主にあって労苦しているツルパナとツルポサとに、よろしく。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 16:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.16.p5.b2": {
    "text": "主にあって選ばれたルポスと、彼の母とに、よろしく。彼の母は、わたしの母でもある。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 16:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.16.p5.b3": {
    "text": "きよい接吻をもって、互にあいさつをかわしなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 16:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.16.p5.b4": {
    "text": "キリストのすべての教会から、あなたがたによろしく。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 16:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.16.p6.b1": {
    "text": "さて兄弟たちよ。あなたがたに勧告する。あなたがたが学んだ教にそむいて分裂を引き起し、つまずきを与える人々を警戒し、かつ彼らから遠ざかるがよい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 16:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.16.p6.b2": {
    "text": "… しかし、わたしの願うところは、あなたがたが善にさとく、悪には、うとくあってほしいことである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 16:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.16.p6.b3": {
    "text": "平和の神は、サタンをすみやかにあなたがたの足の下に踏み砕くであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 16:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.16.p6.b4": {
    "text": "どうか、わたしたちの主イエスの恵みが、あなたがたと共にあるように。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 16:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.16.p7.b1": {
    "text": "わたしの同労者テモテおよび同族のルキオ、ヤソン、ソシパテロから、あなたがたによろしく。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 16:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.16.p7.b2": {
    "text": "（この手紙を筆記したわたしテルテオも、主にあってあなたがたにあいさつの言葉をおくる。）",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 16:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.16.p8.b1": {
    "text": "わたしと全教会との家主ガイオから、あなたがたによろしく。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 16:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.16.p8.b2": {
    "text": "市の会計係エラストと兄弟クワルトから、あなたがたによろしく。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 16:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.16.p9.b1": {
    "text": "願わくは、わたしの福音とイエス・キリストの宣教とにより … あなたがたを力づけることのできるかた …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 16:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.16.p9.b2": {
    "text": "… 今やあらわされ、預言の書をとおして … 信仰の従順に至らせるために、もろもろの国人に告げ知らされた奥義の啓示 …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 16:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.16.p9.b3": {
    "text": "すなわち、唯一の知恵深き神に、イエス・キリストにより、栄光が永遠より永遠にあるように、アァメン。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 16:27"
    },
    "adapted": false,
    "status": "approved"
  }
}
