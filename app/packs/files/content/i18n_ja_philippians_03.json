{
  "philippians.3.p1.b1": {
    "text": "最後に、わたしの兄弟たちよ。主にあって喜びなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 3:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.3.p1.b2": {
    "text": "あの犬どもを警戒しなさい。悪い働き人たちを警戒しなさい。肉に割礼の傷をつけている人たちを警戒しなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 3:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.3.p1.b3": {
    "text": "神の霊によって礼拝をし、キリスト・イエスを誇とし、肉を頼みとしないわたしたちこそ、割礼の者である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 3:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.3.p2.b1": {
    "text": "もとより、肉の頼みなら、わたしにも無くはない。もし、だれかほかの人が肉を頼みとしていると言うなら、わたしはそれをもっと頼みとしている。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 3:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.3.p2.b2": {
    "text": "わたしは八日目に割礼を受けた者、イスラエルの民族に属する者、ベニヤミン族の出身、ヘブル人の中のヘブル人、律法の上ではパリサイ人、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 3:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.3.p2.b3": {
    "text": "熱心の点では教会の迫害者、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 3:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.3.p2.b4": {
    "text": "… 律法の義については落ち度のない者である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 3:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.3.p3.b1": {
    "text": "しかし、わたしにとって益であったこれらのものを、キリストのゆえに損と思うようになった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 3:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.3.p3.b2": {
    "text": "わたしは、更に進んで、わたしの主キリスト・イエスを知る知識の絶大な価値のゆえに、いっさいのものを損と思っている。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 3:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.3.p3.b3": {
    "text": "すなわち、キリストとその復活の力とを知り、その苦難にあずかって、その死のさまとひとしくなり、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 3:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.3.p4.b1": {
    "text": "わたしがすでにそれを得たとか、すでに完全な者になっているとか言うのではなく、ただ捕えようとして追い求めているのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 3:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.3.p4.b2": {
    "text": "… ただこの一事を努めている。すなわち、後のものを忘れ、前のものに向かってからだを伸ばしつつ、目標を目ざして走り、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 3:13-14"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.3.p4.b3": {
    "text": "ただ、わたしたちは、達し得たところに従って進むべきである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 3:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.3.p5.b1": {
    "text": "兄弟たちよ。どうか、わたしにならう者となってほしい。また、あなたがたの模範にされているわたしたちにならって歩く人たちに、目をとめなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 3:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.3.p5.b2": {
    "text": "わたしがそう言うのは、キリストの十字架に敵対して歩いている者が多いからである。わたしは、彼らのことをしばしばあなたがたに話したが、今また涙を流して語る。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 3:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.3.p5.b3": {
    "text": "彼らの最後は滅びである。彼らの神はその腹、… 彼らの思いは地上のことである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 3:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.3.p6.b1": {
    "text": "しかし、わたしたちの国籍は天にある。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 3:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.3.p6.b2": {
    "text": "… そこから、救主、主イエス・キリストのこられるのを、わたしたちは待ち望んでいる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 3:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.3.p6.b3": {
    "text": "彼は、万物をご自身に従わせうる力の働きによって、わたしたちの卑しいからだを、ご自身の栄光のからだと同じかたちに変えて下さるであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 3:21"
    },
    "adapted": false,
    "status": "approved"
  }
}
