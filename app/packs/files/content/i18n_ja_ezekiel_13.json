{
  "ezekiel.13.p1.b1": {
    "text": "イスラエルよ、あなたの預言者たちは、荒れ跡にいるきつねのようだ。あなたがたは … 破れ口にのぼらず、またイスラエルの家のために石がきを築こうともしない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 13:4-5"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.13.p1.b2": {
    "text": "平和",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 13:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.13.p1.b3": {
    "text": "平和がないのに … また民が塀を築く時、これらの預言者たちは水しっくいをもってこれを塗る。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 13:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.13.p1.b4": {
    "text": "彼らは虚偽を言い、偽りを占った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 13:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.13.p1.b5": {
    "text": "これはかならずくずれる … これに大雨が注ぎ、ひょうが降り、あらしが吹く。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 13:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.13.p1.b6": {
    "text": "あなたがたが塗った水しっくいはどこにあるか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 13:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.13.p1.b7": {
    "text": "あなたがたは少しばかりの大麦のため、少しばかりのパンのために、わが民のうちに、わたしを汚し、かの偽りを聞きいれるわが民に偽りを述べて …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 13:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.13.p1.b8": {
    "text": "わたしはまたあなたがたの、かぶり物を裂き、わが民をあなたがたの手から救う。… そしてあなたがたはわたしが主であることを知るようになる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 13:21"
    },
    "adapted": false,
    "status": "approved"
  }
}
