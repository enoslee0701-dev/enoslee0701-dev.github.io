{
  "exodus.33.p1.b1": {
    "text": "あなたと、あなたがエジプトの国から導きのぼった民とは、ここを立って … 地にのぼりなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 33:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.33.p1.b2": {
    "text": "わたしはひとりの使をつかわしてあなたに先立たせ、… あなたがたは乳と蜜の流れる地にのぼりなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 33:2-3"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.33.p1.b3": {
    "text": "あなたがたは、かたくなな民であるから、… あなたがたのうちにあって一緒にはのぼらないであろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 33:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.33.p2.b4": {
    "text": "民はこの悪い知らせを聞いて憂い、ひとりもその飾りを身に着ける者はなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 33:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.33.p2.b5": {
    "text": "今、あなたがたの飾りを身から取り去りなさい。そうすればわたしはあなたがたになすべきことを知るであろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 33:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.33.p2.b6": {
    "text": "それで、イスラエルの人々はホレブ山以来その飾りを取り除いていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 33:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.33.p3.b7": {
    "text": "モーセは幕屋を取って、これを宿営の外に、宿営を離れて張り、これを会見の幕屋と名づけた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 33:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.33.p3.b8": {
    "text": "すべて主に伺い事のある者は出て、宿営の外にある会見の幕屋に行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 33:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.33.p3.b9": {
    "text": "モーセが出て、幕屋に行く時には、民はみな立ちあがり、… おのおのその天幕の入口に立って彼を見送った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 33:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.33.p3.b10": {
    "text": "… モーセが幕屋にはいるまで …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 33:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.33.p4.b11": {
    "text": "モーセが幕屋にはいると、雲の柱が下って幕屋の入口に立った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 33:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.33.p4.b12": {
    "text": "民はみな幕屋の入口に雲の柱が立つのを見ると、立っておのおの自分の天幕の入口で礼拝した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 33:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.33.p4.b13": {
    "text": "人がその友と語るように、主はモーセと顔を合わせて語られた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 33:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.33.p4.b14": {
    "text": "… その従者なる若者、ヌンの子ヨシュアは幕屋を離れなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 33:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.33.p5.b15": {
    "text": "あなたは『この民を導きのぼれ』とわたしに言いながら、わたしと一緒につかわされる者を知らせてくださいません。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 33:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.33.p5.b16": {
    "text": "わたし自身が一緒に行くであろう。そしてあなたに安息を与えるであろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 33:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.33.p5.b17": {
    "text": "もしあなた自身が一緒に行かれないならば、わたしたちをここからのぼらせないでください。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 33:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.33.p5.b18": {
    "text": "それはあなたがわたしたちと一緒に行かれて、わたしとあなたの民とが、地の面にある諸民と異なるものになるからではありませんか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 33:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.33.p6.b19": {
    "text": "あなたはわたしの前に恵みを得、またわたしは名をもってあなたを知るから、あなたの言ったこの事をもするであろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 33:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.33.p6.b20": {
    "text": "どうぞ、あなたの栄光をわたしにお示しください",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 33:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.33.p6.b21": {
    "text": "わたしはわたしのもろもろの善をあなたの前に通らせ、主の名をあなたの前にのべるであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 33:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.33.p6.b22": {
    "text": "あなたはわたしの顔を見ることはできない。わたしを見て、なお生きている人はないからである",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 33:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.33.p7.b23": {
    "text": "見よ、わたしのかたわらに一つの所がある。あなたは岩の上に立ちなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 33:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.33.p7.b24": {
    "text": "わたしの栄光がそこを通り過ぎるとき、わたしはあなたを岩の裂け目に入れて、わたしが通り過ぎるまで、手であなたをおおうであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 33:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.33.p7.b25": {
    "text": "… あなたはわたしのうしろを見るが、わたしの顔は見ないであろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 33:23"
    },
    "adapted": false,
    "status": "approved"
  }
}
