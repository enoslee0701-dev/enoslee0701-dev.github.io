{
  "genesis.16.p1.b1": {
    "text": "アブラムの妻サライは子を産まなかった。彼女にひとりのつかえめがあった。エジプトの女で名をハガルといった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 16:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.16.p1.b2": {
    "text": "「主はわたしに子をお授けになりません。どうぞ、わたしのつかえめの所におはいりください。彼女によってわたしは子をもつことになるでしょう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 16:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.16.p1.b3": {
    "text": "アブラムの妻サライはそのつかえめエジプトの女ハガルをとって、夫アブラムに妻として与えた。これはアブラムがカナンの地に十年住んだ後であった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 16:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.16.p2.b4": {
    "text": "… ハガルは子をはらんだ。彼女は自分のはらんだのを見て、女主人を見下げるようになった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 16:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.16.p2.b5": {
    "text": "「わたしが受けた害はあなたの責任です。… 彼女は自分のはらんだのを見て、わたしを見下さげます。どうか、主があなたとわたしの間をおさばきになるように」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 16:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.16.p2.b6": {
    "text": "「あなたのつかえめはあなたの手のうちにある。あなたの好きなように彼女にしなさい」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 16:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.16.p2.b7": {
    "text": "… サライが彼女を苦しめたので、彼女はサライの顔を避けて逃げた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 16:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.16.p3.b8": {
    "text": "主の使は荒野にある泉のほとり、すなわちシュルの道にある泉のほとりで、彼女に会い、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 16:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.16.p3.b9": {
    "text": "「サライのつかえめハガルよ、あなたはどこからきたのですか、またどこへ行くのですか」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 16:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.16.p3.b10": {
    "text": "「わたしは女主人サライの顔を避けて逃げているのです」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 16:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.16.p3.b11": {
    "text": "「あなたは女主人のもとに帰って、その手に身を任せなさい」。… 「わたしは大いにあなたの子孫を増して、数えきれないほどに多くしましょう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 16:9-10"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.16.p4.b12": {
    "text": "「あなたは、みごもっています。あなたは男の子を産むでしょう。名をイシマエルと名づけなさい。主があなたの苦しみを聞かれたのです。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 16:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.16.p4.b13": {
    "text": "彼は野ろばのような人となり、… 彼はすべての兄弟に敵して住むでしょう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 16:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.16.p4.b14": {
    "text": "そこで、ハガルは自分に語られた主の名を呼んで、「あなたはエル・ロイです」と言った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 16:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.16.p4.b15": {
    "text": "… 「ここでも、わたしを見ていられるかたのうしろを拝めたのか」 …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 16:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.16.p5.b16": {
    "text": "ハガルはアブラムに男の子を産んだ。アブラムはハガルが産んだ子の名をイシマエルと名づけた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 16:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.16.p5.b17": {
    "text": "ハガルがイシマエルをアブラムに産んだ時、アブラムは八十六歳であった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 16:16"
    },
    "adapted": false,
    "status": "approved"
  }
}
