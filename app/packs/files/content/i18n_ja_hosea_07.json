{
  "hosea.7.p1.b1": {
    "text": "彼らはみな姦淫を行う者で、パンを焼く者が熱くする炉のようだ。パンを焼く者は、ねり粉をこねてから、それがふくれるまで、しばらく、火をおこす事をしないだけだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hosea 7:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "hosea.7.p1.b2": {
    "text": "われわれの王の日に、つかさたちは酒の熱によって病みわずらい、王はあざける者と共に手を伸べた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hosea 7:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "hosea.7.p1.b3": {
    "text": "彼らは皆、炉のように熱くなって、そのさばきびとを焼き滅ぼす。そのもろもろの王は皆たおれる。彼らの中にはわたしを呼ぶ者がひとりもない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hosea 7:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "hosea.7.p1.b4": {
    "text": "エフライムはもろもろの民の中に入り混じる。エフライムは火にかけて、かえさない菓子である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hosea 7:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "hosea.7.p1.b5": {
    "text": "エフライムは知恵のない愚かな、はとのようだ。彼らはエジプトに向かって呼び求め、またアッスリヤへ行く。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hosea 7:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "hosea.7.p1.b6": {
    "text": "彼らが行くとき、わたしは彼らの上に網を張って、空の鳥のように引き落し……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hosea 7:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "hosea.7.p1.b7": {
    "text": "彼らはバアルに帰る。彼らはあざむく弓のようだ。……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hosea 7:16"
    },
    "adapted": false,
    "status": "approved"
  }
}
