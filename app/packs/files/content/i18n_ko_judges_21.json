{
  "judges.21.p1.b1": {
    "text": "이스라엘 사람들이 미스바에서 맹세하여 이르기를 우리 중에 누구든지 딸을 베냐민 사람에게 아내로 주지 아니하리라 하였더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 21:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.21.p1.b2": {
    "text": "백성이 벧엘에 이르러 거기서 저녁까지 하나님 앞에 앉아서 대성통곡하여",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 21:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.21.p1.b3": {
    "text": "이스라엘의 하나님 여호와여 오늘날 이스라엘 중에 어찌하여 한 지파가 이즈러졌나이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 21:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.21.p1.b4": {
    "text": "이튿날에 백성이 일찌기 일어나서 거기 한 단을 쌓고 번제와 화목제를 드렸더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 21:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.21.p2.b1": {
    "text": "이스라엘 온 지파 중에 총회와 함께 하여 여호와 앞에 올라오지 아니한 자가 누구뇨",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 21:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.21.p2.b2": {
    "text": "오늘날 이스라엘 중에 한 지파가 끊쳤도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 21:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.21.p2.b3": {
    "text": "그 남은 자들에게 우리가 어떻게 하면 아내를 얻게 하리요",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 21:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.21.p2.b4": {
    "text": "야베스 길르앗에서는 한 사람도 진에 이르러 총회에 참여치 아니하였으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 21:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.21.p3.b1": {
    "text": "회중이 큰 용사 일만 이천을 그리로 보내며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 21:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.21.p3.b2": {
    "text": "… 가서 야베스 길르앗 거민과 및 부녀와 어린 아이를 칼날로 치라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 21:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.21.p3.b3": {
    "text": "그들이 야베스 길르앗 거민 중에서 젊은 처녀 사백인을 얻었으니 … 그들이 실로 진으로 끌어 오니라 이는 가나안 땅이더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 21:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.21.p4.b1": {
    "text": "온 회중이 림몬 바위에 있는 베냐민 자손에게 보내어 평화를 공포 하게 하였더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 21:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.21.p4.b2": {
    "text": "그 때에 베냐민이 돌아온지라 이에 이스라엘 사람이 야베스 길르앗 여인 중에서 살려둔 여자를 그들에게 주었으나 오히려 부족하므로",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 21:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.21.p4.b3": {
    "text": "백성들이 베냐민을 위하여 뉘우쳤으니 이는 여호와께서 이스라엘 지파들 중에 한 지파가 궐이 나게 하셨음이더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 21:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.21.p5.b1": {
    "text": "베냐민의 여인이 다 멸절되었으니 이제 그 남은 자들에게 어떻게 하여야 아내를 얻게 할꼬",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 21:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.21.p5.b2": {
    "text": "그러나 우리가 우리의 딸을 그들의 아내로 주지 못하리니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 21:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.21.p5.b3": {
    "text": "보라 벧엘 북편, 르보나 남편 벧엘에서 세겜으로 올라가는 큰길 동편 실로에 매년 여호와의 절기가 있도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 21:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.21.p6.b1": {
    "text": "가서 포도원에 숨어 보다가 실로의 여자들이 무도하러 나오거든 너희는 포도원에서 나와서 … 베냐민 땅으로 돌아가라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 21:20-21"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.21.p6.b2": {
    "text": "청컨대 너희는 우리에게 은혜를 베풀어 그들을 우리에게 줄지니라 … 너희가 자의로 그들에게 준것이 아니니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 21:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.21.p6.b3": {
    "text": "베냐민 자손이 그같이 행하여 … 자기 기업에 돌아가서 성읍들을 중건하고 거기 거하니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 21:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.21.p7.b1": {
    "text": "그 때에 이스라엘 자손이 그곳을 떠나 각각 그 지파, 그 가족에게로 돌아가되 곧 각각 그곳에서 나와서 자기 기업으로 돌아갔더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 21:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.21.p7.b2": {
    "text": "그 때에 이스라엘에 왕이 없으므로 사람이 각각 그 소견에 옳은 대로 행하였더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 21:25"
    },
    "adapted": false,
    "status": "approved"
  }
}
