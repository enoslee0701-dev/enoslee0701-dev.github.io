{
  "exodus.15.p1.b1": {
    "text": "そこでモーセとイスラエルの人々は、この歌を主にむかって歌った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 15:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.15.p1.b2": {
    "text": "主にむかってわたしは歌おう、彼は輝かしくも勝ちを得られた、彼は馬と乗り手を海に投げ込まれた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 15:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.15.p1.b3": {
    "text": "主はわたしの力また歌、わたしの救となられた、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 15:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.15.p1.b4": {
    "text": "彼こそわたしの神、わたしは彼をたたえる、彼はわたしの父の神、わたしは彼をあがめる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 15:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.15.p1.b5": {
    "text": "主はいくさびと、その名は主。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 15:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.15.p2.b6": {
    "text": "彼はパロの戦車とその軍勢とを海に投げ込まれた、そのすぐれた指揮者たちは紅海に沈んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 15:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.15.p2.b7": {
    "text": "大水は彼らをおおい、彼らは石のように淵に下った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 15:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.15.p2.b8": {
    "text": "あなたの鼻の息によって水は積みかさなり、流れは堤となって立ち、大水は海のもなかに凝り固まった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 15:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.15.p2.b9": {
    "text": "わたしは追い行き、追い着いて、…つるぎを抜こう、わたしの手は彼らを滅ぼそう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 15:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.15.p2.b10": {
    "text": "あなたが息を吹かれると、海は彼らをおおい、彼らは鉛のように、大水の中に沈んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 15:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.15.p3.b11": {
    "text": "主よ、神々のうち、だれがあなたに比べられようか、だれがあなたのように、聖にして栄えあるもの、ほむべくして恐るべきもの、くすしきわざを行うものであろうか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 15:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.15.p3.b12": {
    "text": "あなたは、あがなわれた民を恵みをもって導き、み力をもって、あなたの聖なるすまいに伴われた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 15:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.15.p3.b13": {
    "text": "彼らは石のように黙した、主よ、あなたの民の通りすぎるまで、あなたが買いとられた民の通りすぎるまで。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 15:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.15.p3.b14": {
    "text": "あなたは彼らを導いて、あなたの嗣業の山に植えられる。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 15:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.15.p3.b15": {
    "text": "主は永遠に統べ治められる」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 15:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.15.p4.b16": {
    "text": "パロの馬が、その戦車および騎兵と共に海にはいると、主は海の水を彼らの上に流れ返らされたが、イスラエルの人々は海の中のかわいた地を行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 15:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.15.p4.b17": {
    "text": "そのとき、アロンの姉、女預言者ミリアムはタンバリンを手に取り、女たちも皆タンバリンを取って、踊りながら、そのあとに従って出てきた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 15:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.15.p4.b18": {
    "text": "主にむかって歌え、彼は輝かしくも勝ちを得られた、彼は馬と乗り手を海に投げ込まれた",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 15:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.15.p5.b19": {
    "text": "三日のあいだ荒野を歩いたが、水を得なかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 15:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.15.p5.b20": {
    "text": "彼らはメラに着いたが、メラの水は苦くて飲むことができなかった。それで、その所の名はメラと呼ばれた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 15:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.15.p5.b21": {
    "text": "わたしたちは何を飲むのですか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 15:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.15.p6.b22": {
    "text": "モーセは主に叫んだ。主は彼に一本の木を示されたので、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 15:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.15.p6.b23": {
    "text": "それを水に投げ入れると、水は甘くなった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 15:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.15.p6.b24": {
    "text": "あなたが、もしあなたの神、主の声に良く聞き従い、…わたしは、かつてエジプトびとに下した病を一つもあなたに下さないであろう。わたしは主であって、あなたをいやすものである",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 15:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.15.p7.b25": {
    "text": "こうして彼らはエリムに着いた。そこには水の泉十二と、なつめやしの木七十本があった。その所で彼らは水のほとりに宿営した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 15:27"
    },
    "adapted": false,
    "status": "approved"
  }
}
