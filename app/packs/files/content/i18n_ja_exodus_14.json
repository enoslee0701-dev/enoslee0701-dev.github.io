{
  "exodus.14.p1.b1": {
    "text": "主はモーセに言われた、「イスラエルの人々に告げ、引き返して…海のかたわらに宿営しなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 14:1-2"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.14.p1.b2": {
    "text": "わたしがパロの心をかたくなにするから、パロは彼らのあとを追うであろう。…エジプトびとにわたしが主であることを知らせるであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 14:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.14.p2.b3": {
    "text": "民の逃げ去ったこと…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 14:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.14.p2.b4": {
    "text": "われわれはなぜこのようにイスラエルを去らせて、われわれに仕えさせないようにしたのであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 14:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.14.p2.b5": {
    "text": "それでパロは戦車を整え、みずからその民を率い、また、えり抜きの戦車六百と、エジプトのすべての戦車…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 14:6-7"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.14.p2.b6": {
    "text": "エジプトびとは彼らのあとを追い…海のかたわらに宿営している彼らに追いついた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 14:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.14.p3.b7": {
    "text": "イスラエルの人々は目を上げてエジプトびとが彼らのあとに進んできているのを見て、非常に恐れた。そしてイスラエルの人々は主にむかって叫び…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 14:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.14.p3.b8": {
    "text": "エジプトに墓がないので、荒野で死なせるために、わたしたちを携え出したのですか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 14:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.14.p3.b9": {
    "text": "荒野で死ぬよりもエジプトびとに仕える方が、わたしたちにはよかったのです。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 14:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.14.p4.b10": {
    "text": "あなたがたは恐れてはならない。かたく立って、主がきょう、あなたがたのためになされる救を見なさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 14:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.14.p4.b11": {
    "text": "主があなたがたのために戦われるから、あなたがたは黙していなさい」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 14:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.14.p4.b12": {
    "text": "きょう、あなたがたはエジプトびとを見るが、もはや永久に、二度と彼らを見ないであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 14:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.14.p5.b13": {
    "text": "あなたは、なぜわたしにむかって叫ぶのか。イスラエルの人々に語って彼らを進み行かせなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 14:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.14.p5.b14": {
    "text": "あなたはつえを上げ、手を海の上にさし伸べてそれを分け、イスラエルの人々に海の中のかわいた地を行かせなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 14:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.14.p5.b15": {
    "text": "雲の柱も彼らの前から移って彼らのうしろに立ち…そこに雲とやみがあり夜もすがら、かれとこれと近づくことなく、夜がすぎた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 14:19-20"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.14.p6.b16": {
    "text": "モーセが手を海の上にさし伸べたので、主は夜もすがら強い東風をもって海を退かせ、海を陸地とされ、水は分かれた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 14:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.14.p7.b17": {
    "text": "イスラエルの人々は海の中のかわいた地を行ったが、水は彼らの右と左に、かきとなった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 14:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.14.p8.b18": {
    "text": "エジプトびとは追ってきて、パロのすべての馬と戦車と騎兵とは、彼らのあとについて海の中にはいった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 14:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.14.p8.b19": {
    "text": "暁の更に…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 14:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.14.p8.b20": {
    "text": "主は…エジプトびとの軍勢を乱し、その戦車の輪をきしらせて、進むのに重くされた…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 14:24-25"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.14.p8.b21": {
    "text": "われわれはイスラエルを離れて逃げよう。主が彼らのためにエジプトびとと戦う",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 14:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.14.p9.b22": {
    "text": "あなたの手を海の上にさし伸べて、水をエジプトびとと、その戦車と騎兵との上に流れ返らせなさい",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 14:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.14.p9.b23": {
    "text": "夜明けになって…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 14:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.14.p9.b24": {
    "text": "海はいつもの流れに返り…水は流れ返り…戦車と騎兵…をおおい…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 14:27-28"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.14.p9.b25": {
    "text": "イスラエルのあとを追って海にはいった…パロのすべての軍勢をおおい、ひとりも残らなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 14:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.14.p10.b26": {
    "text": "このように、主はこの日イスラエルをエジプトびとの手から救われた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 14:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.14.p10.b27": {
    "text": "イスラエルはまた、主がエジプトびとに行われた大いなるみわざを見た。それで民は主を恐れ、主とそのしもべモーセとを信じた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 14:31"
    },
    "adapted": false,
    "status": "approved"
  }
}
