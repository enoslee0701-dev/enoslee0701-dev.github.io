{
  "zechariah.3.p1.b1": {
    "text": "時に主は大祭司ヨシュアが、主の使の前に立ち、サタンがその右に立って、これを訴えているのをわたしに示された。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 3:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.3.p1.b2": {
    "text": "サタンよ、主はあなたを責めるのだ。すなわちエルサレムを選んだ主はあなたを責めるのだ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 3:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.3.p1.b3": {
    "text": "これは火の中から取り出した燃えさしではないか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 3:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.3.p1.b4": {
    "text": "ヨシュアは汚れた衣を着て、み使の前に立っていたが、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 3:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.3.p1.b5": {
    "text": "彼の汚れた衣を脱がせなさい……見よ、わたしはあなたの罪を取り除いた。あなたに祭服を着せよう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 3:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.3.p1.b6": {
    "text": "清い帽子を頭にかぶらせなさい",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 3:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.3.p1.b7": {
    "text": "そこで清い帽子を頭にかぶらせ、衣を彼に着せた。主の使はかたわらに立っていた",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 3:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.3.p2.b1": {
    "text": "万軍の主は、こう仰せられる、あなたがもし、わたしの道に歩み、わたしの務を守るならば、わたしの家をつかさどり、わたしの庭を守ることができる……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 3:6-7"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.3.p2.b2": {
    "text": "大祭司ヨシュアよ、あなたも、あなたの前にすわっている同僚たちも聞きなさい",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 3:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.3.p2.b3": {
    "text": "わたしはわたしのしもべなる枝を生じさせよう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 3:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.3.p2.b4": {
    "text": "見よ、ヨシュアの前にわたしが置いた石の上に、すなわち七つの目をもっているこの一つの石の上に……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 3:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.3.p2.b5": {
    "text": "わたしはみずから文字を彫刻する。そしてわたしはこの地の罪を、一日の内に取り除く",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 3:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.3.p2.b6": {
    "text": "その日には、あなたがたはめいめいその隣り人を招いて、ぶどうの木の下、いちじくの木の下に座すのである",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 3:10"
    },
    "adapted": false,
    "status": "approved"
  }
}
