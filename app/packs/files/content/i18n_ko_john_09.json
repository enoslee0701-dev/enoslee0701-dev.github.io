{
  "john.9.p1.b1": {
    "text": "예수께서 길 가실 때에 날 때부터 소경 된 사람을 보신지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p1.b2": {
    "text": "랍비여 이 사람이 소경으로 난 것이 뉘 죄로 인함이오니이까 자기오니이까 그 부모오니이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p2.b1": {
    "text": "이 사람이나 그 부모가 죄를 범한 것이 아니라 그에게서 하나님의 하시는 일을 나타내고자 하심이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p2.b2": {
    "text": "때가 아직 낮이매 나를 보내신 이의 일을 우리가 하여야 하리라 밤이 오리니 그때는 아무도 일할 수 없느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p2.b3": {
    "text": "내가 세상에 있는 동안에는 세상의 빛이로라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p3.b1": {
    "text": "이 말씀을 하시고 땅에 침을 뱉아 진흙을 이겨 그의 눈에 바르시고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p3.b2": {
    "text": "실로암 못에 가서 씻으라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p3.b3": {
    "text": "(실로암은 번역하면 보냄을 받았다는 뜻이라)",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p4.b1": {
    "text": "이에 가서 씻고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p4.b2": {
    "text": "밝은 눈으로 왔더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p5.b1": {
    "text": "이는 앉아서 구걸하던 자가 아니냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p5.b2": {
    "text": "그 사람이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p5.b3": {
    "text": "아니라 그와 비슷하다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p5.b4": {
    "text": "내가 그로라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p6.b1": {
    "text": "그러면 네 눈이 어떻게 떠졌느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p6.b2": {
    "text": "예수라 하는 그 사람이 진흙을 이겨 내 눈에 바르고 … 가서 씻었더니 보게 되었노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p6.b3": {
    "text": "그가 어디 있느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p6.b4": {
    "text": "알지 못하노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p7.b1": {
    "text": "예수께서 진흙을 이겨 눈을 뜨게 하신 날은 안식일이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p7.b2": {
    "text": "이 사람이 안식일을 지키지 아니하니 하나님께로서 온 자가 아니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p7.b3": {
    "text": "죄인으로서 어떻게 이러한 표적을 행하겠느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p7.b4": {
    "text": "선지자니이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p8.b1": {
    "text": "이는 너희 말에 소경으로 났다 하는 너희 아들이냐 그러면 지금은 어떻게 되어 보느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p8.b2": {
    "text": "이가 우리 아들인 것과 소경으로 난 것을 아나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p8.b3": {
    "text": "저에게 물어 보시오 저가 장성하였으니 자기 일을 말하리이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p8.b4": {
    "text": "그 부모가 이렇게 말한 것은 이미 유대인들이 누구든지 예수를 그리스도로 시인하는 자는 출교하기로 결의하였으므로 저희를 무서워함이러라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p9.b1": {
    "text": "이에 저희가 소경 되었던 사람을 두번째 불러",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p9.b2": {
    "text": "너는 영광을 하나님께 돌리라 우리는 저 사람이 죄인인줄 아노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p9.b3": {
    "text": "그가 죄인인지 내가 알지 못하나",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p9.b4": {
    "text": "한 가지 아는 것은 내가 소경으로 있다가 지금 보는 그것이니이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p10.b1": {
    "text": "그 사람이 네게 무엇을 하였느냐 어떻게 네 눈을 뜨게 하였느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p10.b2": {
    "text": "… 당신들도 그 제자가 되려 하나이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p10.b3": {
    "text": "너는 그의 제자나 우리는 모세의 제자라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p10.b4": {
    "text": "… 이 사람은 어디서 왔는지 알지 못하노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p11.b1": {
    "text": "이상하다 이 사람이 내 눈을 뜨게 하였으되 당신들이 그가 어디서 왔는지 알지 못하는도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p11.b2": {
    "text": "창세 이후로 소경으로 난 자의 눈을 뜨게 하였다 함을 듣지 못하였으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p11.b3": {
    "text": "이 사람이 하나님께로부터 오지 아니하였으면 아무 일도 할 수 없으리이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p12.b1": {
    "text": "네가 온전히 죄 가운데서 나서 우리를 가르치느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p12.b2": {
    "text": "이에 쫓아 내어 보내니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p13.b1": {
    "text": "예수께서 저희가 그 사람을 쫓아냈다 하는 말을 들으셨더니 그를 만나사",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p13.b2": {
    "text": "네가 인자를 믿느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p13.b3": {
    "text": "주여 그가 누구시오니이까 내가 믿고자 하나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:36"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p13.b4": {
    "text": "네가 그를 보았거니와 지금 너와 말하는 자가 그이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:37"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p14.b1": {
    "text": "주여 내가 믿나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p14.b2": {
    "text": "절하는지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p15.b1": {
    "text": "내가 심판하러 이 세상에 왔으니 보지 못하는 자들은 보게 하고 보는 자들은 소경되게 하려 함이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p15.b2": {
    "text": "우리도 소경인가",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p15.b3": {
    "text": "너희가 소경 되었더면 죄가 없으려니와",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p15.b4": {
    "text": "본다고 하니 너희 죄가 그저 있느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 9:41"
    },
    "adapted": false,
    "status": "approved"
  }
}
