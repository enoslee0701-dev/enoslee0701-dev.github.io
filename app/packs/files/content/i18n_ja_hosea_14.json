{
  "hosea.14.p1.b1": {
    "text": "イスラエルよ、あなたの神、主に帰れ。あなたは自分の不義によって、つまずいたからだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hosea 14:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "hosea.14.p1.b2": {
    "text": "不義はことごとくゆるして、よきものを受けいれてください。わたしたちは自分のくちびるの実をささげます。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hosea 14:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "hosea.14.p1.b3": {
    "text": "アッスリヤはわたしたちを助けず、わたしたちは馬に乗りません。わたしたちはもはや自分たちの手のわざに向かって『われわれの神』とは言いません。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hosea 14:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "hosea.14.p1.b4": {
    "text": "わたしは彼らのそむきをいやし、喜んでこれを愛する。わたしの怒りは彼らを離れ去ったからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hosea 14:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "hosea.14.p2.b1": {
    "text": "わたしはイスラエルに対しては露のようになる。彼はゆりのように花咲き、ポプラのように根を張り、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hosea 14:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "hosea.14.p2.b2": {
    "text": "その枝は茂りひろがり、その麗しさはオリブの木のように、そのかんばしさはレバノンのようになる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hosea 14:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "hosea.14.p2.b3": {
    "text": "エフライムよ、わたしは偶像となんの係わりがあろうか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hosea 14:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "hosea.14.p2.b4": {
    "text": "わたしは緑のいとすぎのようだ。あなたはわたしから実を得る。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hosea 14:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "hosea.14.p2.b5": {
    "text": "主の道は直く、正しき者はこれを歩む。しかし罪びとはこれにつまずく。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hosea 14:9"
    },
    "adapted": false,
    "status": "approved"
  }
}
