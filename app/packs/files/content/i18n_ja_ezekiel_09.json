{
  "ezekiel.9.p1.b1": {
    "text": "町を罰する者たちよ、おのおの滅ぼす武器をその手に持って近よれ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 9:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.9.p1.b2": {
    "text": "見よ、北に向かう上の門の道から出て来る六人の者があった。… 彼らの中のひとりは亜麻布を着、その腰に物を書く墨つぼをつけていた。彼らははいって来て、青銅の祭壇のかたわらに立った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 9:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.9.p1.b3": {
    "text": "ここにイスラエルの神の栄光がその座しているケルビムから立ちあがって、宮の敷居にまで至った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 9:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.9.p1.b4": {
    "text": "そして主は、亜麻布を着て、その腰に物を書く墨つぼをつけている者を呼び",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 9:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.9.p1.b5": {
    "text": "町の中、エルサレムの中をめぐり、その中で行われているすべての憎むべきことに対して嘆き悲しむ人々の額にしるしをつけよ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 9:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.9.p2.b1": {
    "text": "彼のあとに従い町をめぐって、撃て。あなたの目は惜しみ見るな。またあわれむな。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 9:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.9.p2.b2": {
    "text": "… しかし身にしるしのある者には触れるな。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 9:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.9.p2.b3": {
    "text": "そこで彼らは出て行って、町の中で撃った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 9:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.9.p2.b4": {
    "text": "さて彼らが人々を打ち殺していた時、わたしひとりだけが残されたので、ひれ伏して、叫んで言った、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 9:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.9.p2.b5": {
    "text": "ああ主なる神よ、あなたがエルサレムの上に怒りを注がれるとき、イスラエルの残りの者を、ことごとく滅ぼされるのですか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 9:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.9.p2.b6": {
    "text": "イスラエルとユダの家の罪は非常に大きい。… 彼らは言う、『主はこの地を捨てられた。主は顧みられない』。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 9:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.9.p2.b7": {
    "text": "わたしはあなたがお命じになったように行いました",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 9:11"
    },
    "adapted": false,
    "status": "approved"
  }
}
