{
  "mark.5.p1.b1": {
    "text": "เมื่อ​พวก​เขา​ข้าม​ฟาก​มา​ถึง​ดินแดน​เกราซา",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p1.b2": {
    "text": "พอ​พระเยซู​ขึ้น​จาก​เรือ",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p1.b3": {
    "text": "ชาย​คน​หนึ่ง​ซึ่ง​มี​วิญญาณ​โสโครก​เข้า​สิง ได้​ออก​จาก​อุโมงค์​วาง​ศพ​เพื่อ​มา​หา​พระองค์",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p2.b1": {
    "text": "เขา​อาศัย​อยู่​ตาม​อุโมงค์​วาง​ศพ",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p2.b2": {
    "text": "ไม่​มี​ใคร​จับ​เขา​มัด​ไว้​ได้​อีก​ต่อ​ไป แม้​จะ​ใช้​โซ่​ตรวน​ก็​ตาม",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p2.b3": {
    "text": "เพราะ​เขา​เคย​ถูก​ล่าม​โซ่​ตรวน​มือ​และ​เท้า​หลาย​ครั้ง​แล้ว",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p2.b4": {
    "text": "แต่​เขา​ก็​กระชาก​จน​โซ่​ตรวน​เท้า​ขาด",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p2.b5": {
    "text": "ไม่​มี​ใคร​แข็งแรง​พอ​จะ​ปราบ​เขา​ได้",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p2.b6": {
    "text": "ทั้ง​กลาง​วัน​กลาง​คืน​ตาม​อุโมงค์​วาง​ศพ​และ​บน​เนิน​เขา เขา​จะ​ร้อง​เสียง​ดัง",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p2.b7": {
    "text": "และ​เอา​หิน​กรีด​เนื้อ​ตัวเอง",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p3.b1": {
    "text": "เมื่อ​เขา​เห็น​พระเยซู​แต่​ไกล",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p3.b2": {
    "text": "ก็​วิ่ง​มา​คุกเข่า​ต่อหน้า​พระองค์",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p3.b3": {
    "text": "และ​ตะโกน​สุด​เสียง​ว่า",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p3.b4": {
    "text": "พระเยซู พระบุตร​ของ​พระเจ้า​สูง​สุด พระองค์​ต้องการ​อะไร​จาก​ข้า",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p3.b5": {
    "text": "ใน​นาม​ของ​พระเจ้า อย่า​ทรมาน​ข้า​เลย!",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p3.b6": {
    "text": "เพราะ​พระเยซู​พูด​กับ​มัน​ว่า",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p3.b7": {
    "text": "เจ้า​วิญญาณ​โสโครก จง​ออก​มา​จาก​ชาย​คน​นี้!",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p4.b1": {
    "text": "เจ้า​ชื่อ​อะไร",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p4.b2": {
    "text": "ข้า​ชื่อ​กอง เพราะ​เรา​มี​กัน​หลาย​ตน",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p4.b3": {
    "text": "และ​มัน​อ้อนวอน​พระเยซู​ไม่​ให้​ส่ง​พวก​มัน​ออก​ไป​จาก​ถิ่น​นั้น",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p5.b1": {
    "text": "ขอ​ส่ง​เรา​เข้า​ไป​ใน​ฝูง​หมู​นั้น​เถิด",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p5.b2": {
    "text": "เมื่อ​พระองค์​อนุญาต",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p5.b3": {
    "text": "แล้ว​ฝูง​หมู … ก็​วิ่ง​กระโจน​จาก​หน้าผา ลง​ทะเลสาบ​และ​จม​น้ำ​ตาย",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p5.b4": {
    "text": "ฝูง​หมู​ราว​สอง​พัน​ตัว",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p6.b1": {
    "text": "ผู้​คน​ก็​ออก​มา​ดู​เหตุการณ์​ที่​เกิดขึ้น",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p6.b2": {
    "text": "เมื่อ​คน​เหล่า​นี้​มา​หา​พระเยซู เห็น​ชาย​ที่​เคย​ถูก​ผี​ทั้ง​กอง​เข้า​สิง",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p6.b3": {
    "text": "นั่ง​อยู่​ที่​นั่น สวม​เสื้อ​ผ้า​และ​มี​สติ​ดี",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p6.b4": {
    "text": "พวก​เขา​ก็​กลัว",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p7.b1": {
    "text": "คน​ที่​เห็น​เหตุการณ์​จึง​เล่า​เรื่อง​ที่​เกิด​กับ​ชาย​ที่​ถูก​ผี​สิง",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p7.b2": {
    "text": "และ​ก็​เรื่อง​ฝูง​หมู​ให้​ฟัง",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p7.b3": {
    "text": "ผู้​คน​จึง​ขอร้อง​พระเยซู​ให้​ออก​ไป​จาก​ดินแดน​ของ​พวก​เขา",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p8.b1": {
    "text": "ชาย​คน​ที่​เคย​ถูก​ผี​สิง​อ้อนวอน​ขอ​ไป​กับ​พระองค์",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p8.b2": {
    "text": "จง​กลับ​บ้าน​ไป​หา​ครอบครัว​ของ​เจ้า",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p8.b3": {
    "text": "และ​บอก​พวก​เขา​ว่า องค์​พระผู้เป็นเจ้า​ทำ​เพื่อ​เจ้า​มาก​แค่​ไหน​และ​เมตตา​เจ้า​อย่างไร",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p8.b4": {
    "text": "ชาย​คน​นั้น​จึง​ลา​ไป​ป่าว​ประกาศ​ใน​แคว้น​เดคาโปลิส​ว่า พระเยซู​ทำ​เพื่อ​เขา​มาก​แค่​ไหน คน​ทั้งหมด​ก็​ประหลาด​ใจ",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p9.b1": {
    "text": "เมื่อ​พระเยซู​นั่ง​เรือ​ข้าม​ไป​อีก​ฟาก​หนึ่ง​ของ​ทะเลสาบ",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p9.b2": {
    "text": "มี​นาย​ธรรม​ศาลา​คน​หนึ่ง​ชื่อ​ไยรัส​มา​ที่​นั่น",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p9.b3": {
    "text": "ลูก​สาว​เล็ก​ๆ ของ​ข้าพเจ้า​กำลัง​จะ​ตาย โปรด​มา​วาง​มือ​ให้​ด้วย เธอ​จะ​ได้​หาย​และ​มี​ชีวิต​อยู่​ต่อไป",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p9.b4": {
    "text": "พระเยซู​จึง​ไป​กับ​เขา",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p10.b1": {
    "text": "ที่​นั่น​มี​หญิง​คน​หนึ่ง​ตก​เลือด​เรื้อรัง​มา​สิบสอง​ปี​แล้ว",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p10.b2": {
    "text": "เธอ​ทุกข์​ทรมาน​มาก​จาก​การ​รักษา​ของ​หมอ​หลาย​คน",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p10.b3": {
    "text": "เสีย​เงิน​จน​หมด​ตัว",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p10.b4": {
    "text": "แต่​แทน​ที่​จะ​ดี​ขึ้น​อาการ​กลับ​ทรุด​ลง",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p11.b1": {
    "text": "เมื่อ​เธอ​ได้ยิน​เรื่อง​พระเยซู​จึง​เดิน​ปะปน​กับ​ฝูงชน มา​ทาง​ด้าน​หลัง​พระองค์",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p11.b2": {
    "text": "ถ้า​ฉัน​ได้​แตะ​เสื้อ​พระองค์ ฉัน​ก็​จะ​หาย​โรค",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p11.b3": {
    "text": "ทัน​ใด​นั้น​เลือด​ก็​หยุด​ไหล",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p11.b4": {
    "text": "และ​เธอ​รู้สึก​ว่า​หาย​โรค​แล้ว",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p12.b1": {
    "text": "พระเยซู​รู้​ทันที​ว่า​ฤทธิ์เดช​ได้​แผ่​ซ่าน​ออก​จาก​พระองค์",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p12.b2": {
    "text": "ใคร​แตะ​เสื้อ​ของ​เรา",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p12.b3": {
    "text": "พระองค์​เห็น​อยู่​แล้ว​ว่า​ผู้​คน​เบียดเสียด​พระองค์ แล้ว​พระองค์​ยัง​ถาม​อีก​ว่า ‘ใคร​แตะ​ตัว​เรา’",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p12.b4": {
    "text": "แต่​พระเยซู​ยัง​มอง​ไป​รอบ​ๆ ดู​ว่า​ใคร​เป็น​คน​ทำ",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p13.b1": {
    "text": "หญิง​นั้น​ซึ่ง​รู้​ดี​ว่า​เกิด​อะไร​ขึ้น​กับ​เธอ … กลัว​จน​ตัว​สั่น",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p13.b2": {
    "text": "แล้ว​บอก​ความ​จริง​ทั้งหมด",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p13.b3": {
    "text": "ลูก​สาว ความ​เชื่อ​ของ​เจ้า​ได้​รักษา​เจ้า​แล้ว",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p13.b4": {
    "text": "จง​กลับ​ไป​ด้วย​สันติสุข​และ​พ้น​จาก​ความ​ทุกข์​ทรมาน​เถิด",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p14.b1": {
    "text": "ลูก​สาว​ของ​ท่าน​ตาย​แล้ว",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p14.b2": {
    "text": "เหตุใด​ต้อง​รบกวน​อาจารย์​อีก​เล่า",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p14.b3": {
    "text": "อย่า​กลัว​เลย จง​เชื่อ​เท่านั้น",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:36"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p14.b4": {
    "text": "พระองค์​ไม่​อนุญาต​ให้​ใคร​ตาม​ไป ยกเว้น​เปโตร ยากอบ และ​ยอห์น​น้อง​ชาย​ของ​ยากอบ",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:37"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p15.b1": {
    "text": "เมื่อ​มา​ถึง​บ้าน​ของ​นาย​ธรรม​ศาลา",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p15.b2": {
    "text": "ร้องไห้​วุ่นวาย​กัน​ไป​ทำไม",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p15.b3": {
    "text": "เด็ก​น้อย​ยัง​ไม่​ตาย​แค่​หลับ​อยู่",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p15.b4": {
    "text": "แต่​พวก​เขา​พา​กัน​หัวเราะ​เยาะ​พระองค์",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p16.b1": {
    "text": "หลัง​จาก​พระองค์​ให้​ผู้​คน​ออก​ไป​แล้ว",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p16.b2": {
    "text": "ทาลิธา คูม",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p16.b3": {
    "text": "(ซึ่ง​แปล​ว่า “เด็ก​น้อย เรา​บอก​เจ้า​ให้​ลุก​ขึ้น!”)",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p17.b1": {
    "text": "ทัน​ใด​นั้น เด็ก​หญิง​ก็​ลุก​ขึ้น​เดิน​ไป​รอบ​ๆ",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:42"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p17.b2": {
    "text": "พวก​เขา​ต่าง​ตก​ตะลึง",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:42"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p17.b3": {
    "text": "เธอ​อายุ​สิบ​สอง​ปี",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:42"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p18.b1": {
    "text": "พระองค์​สั่ง​ว่า​อย่า​ให้​ใคร​รู้​เรื่อง​นี้",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:43"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p18.b2": {
    "text": "และ​บอก​ให้​เอา​อาหาร​มา​ให้​เด็ก​กิน",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 5:43"
    },
    "adapted": false,
    "status": "approved"
  }
}
