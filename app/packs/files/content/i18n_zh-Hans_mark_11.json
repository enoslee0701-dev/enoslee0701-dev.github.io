{
  "mark.11.p1.b1": {
    "text": "耶稣和门徒将近耶路撒冷，到了伯法其和伯大尼，在橄榄山那里；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣和门⁠徒将⁠近耶⁠路撒⁠冷，到⁠了伯⁠法⁠其和伯⁠大⁠尼，在橄⁠榄⁠山那⁠里；"
  },
  "mark.11.p1.b2": {
    "text": "你们往对面村子里去，一进去的时候，必看见一匹驴驹拴在那里，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们往对⁠面村⁠子里去，一进⁠去的时⁠候，必看⁠见一⁠匹驴驹拴⁠在那⁠里，"
  },
  "mark.11.p1.b3": {
    "text": "是从来没有人骑过的，可以解开，牵来。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "是从⁠来没⁠有人骑⁠过的，可⁠以解⁠开，牵⁠来。"
  },
  "mark.11.p1.b4": {
    "text": "若有人对你们说：『为什么做这事？』你们就说：『主要用它。』",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:3"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "若⁠有人对你⁠们说：『为⁠什⁠么做这事？』你⁠们就说：『主⁠要用它。』"
  },
  "mark.11.p2.b1": {
    "text": "他们去了，便看见一匹驴驹拴在门外街道上，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:4"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠们去⁠了，便看⁠见一⁠匹驴驹拴⁠在门⁠外街⁠道上，"
  },
  "mark.11.p2.b2": {
    "text": "你们解驴驹做什么？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:5"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们解驴驹做什⁠么？"
  },
  "mark.11.p2.b3": {
    "text": "门徒照着耶稣所说的回答，那些人就任凭他们牵去了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:6"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "门⁠徒照着耶⁠稣所说⁠的回⁠答，那⁠些人就任⁠凭他⁠们牵去⁠了。"
  },
  "mark.11.p3.b1": {
    "text": "他们把驴驹牵到耶稣那里，把自己的衣服搭在上面，耶稣就骑上。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠们把驴驹牵⁠到耶⁠稣那⁠里，把自⁠己的衣⁠服搭⁠在上⁠面，耶⁠稣就骑⁠上。"
  },
  "mark.11.p3.b2": {
    "text": "有许多人把衣服铺在路上，也有人把田间的树枝砍下来，铺在路上。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有许⁠多人把衣⁠服铺⁠在路⁠上，也⁠有人把田⁠间的树枝砍⁠下⁠来，铺⁠在路⁠上。"
  },
  "mark.11.p4.b1": {
    "text": "和散那！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:9"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "和⁠散⁠那！"
  },
  "mark.11.p4.b2": {
    "text": "奉主名来的是应当称颂的！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:9"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "奉主名来的⁠是应⁠当称⁠颂的！"
  },
  "mark.11.p4.b3": {
    "text": "那将要来的我祖大卫之国是应当称颂的！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:10"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "那将⁠要来的我祖大⁠卫之国是应⁠当称⁠颂的！"
  },
  "mark.11.p4.b4": {
    "text": "高高在上和散那！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:10"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "高⁠高在⁠上和⁠散⁠那！"
  },
  "mark.11.p5.b1": {
    "text": "耶稣进了耶路撒冷，入了圣殿，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:11"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣进了耶⁠路撒⁠冷，入了圣⁠殿，"
  },
  "mark.11.p5.b2": {
    "text": "周围看了各样物件。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:11"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "周⁠围看⁠了各⁠样物⁠件。"
  },
  "mark.11.p5.b3": {
    "text": "天色已晚，就和十二个门徒出城，往伯大尼去了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:11"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "天⁠色已⁠晚，就和十⁠二⁠个门⁠徒出⁠城，往伯⁠大⁠尼去⁠了。"
  },
  "mark.11.p6.b1": {
    "text": "第二天，他们从伯大尼出来，耶稣饿了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:12"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "第⁠二天，他⁠们从伯⁠大⁠尼出⁠来，耶⁠稣饿了。"
  },
  "mark.11.p6.b2": {
    "text": "远远地看见一棵无花果树，树上有叶子，就往那里去，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "远⁠远地看⁠见一⁠棵无⁠花果⁠树，树上⁠有叶⁠子，就往那⁠里去，"
  },
  "mark.11.p6.b3": {
    "text": "到了树下，竟找不着什么，不过有叶子，因为不是收无花果的时候。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "到⁠了树下，竟找不⁠着什⁠么，不⁠过有叶⁠子，因⁠为不⁠是收无⁠花⁠果的时⁠候。"
  },
  "mark.11.p6.b4": {
    "text": "从今以后，永没有人吃你的果子。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:14"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "从今以⁠后，永没⁠有人吃你⁠的果⁠子。"
  },
  "mark.11.p7.b1": {
    "text": "他们来到耶路撒冷。耶稣进入圣殿，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:15"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠们来⁠到耶⁠路撒⁠冷。耶⁠稣进⁠入圣⁠殿，"
  },
  "mark.11.p7.b2": {
    "text": "赶出殿里做买卖的人，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:15"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "赶⁠出殿⁠里做买⁠卖的人，"
  },
  "mark.11.p7.b3": {
    "text": "推倒兑换银钱之人的桌子和卖鸽子之人的凳子；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:15"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "推⁠倒兑⁠换银⁠钱之人⁠的桌⁠子和卖鸽⁠子之人⁠的凳⁠子；"
  },
  "mark.11.p8.b1": {
    "text": "也不许人拿着器具从殿里经过；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:16"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "也不⁠许人拿着器⁠具从殿⁠里经⁠过；"
  },
  "mark.11.p8.b2": {
    "text": "经上不是记着说：我的殿必称为万国祷告的殿吗？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:17"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "经上不⁠是记着说：我⁠的殿必称⁠为万⁠国祷⁠告的殿吗？"
  },
  "mark.11.p8.b3": {
    "text": "你们倒使它成为贼窝了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:17"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们倒使它成⁠为贼⁠窝了。"
  },
  "mark.11.p9.b1": {
    "text": "祭司长和文士听见这话，就想法子要除灭耶稣，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:18"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "祭⁠司⁠长和文⁠士听⁠见这话，就想⁠法子要除灭耶⁠稣，"
  },
  "mark.11.p9.b2": {
    "text": "却又怕他，因为众人都希奇他的教训。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:18"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "却又怕他，因⁠为众⁠人都希⁠奇他⁠的教⁠训。"
  },
  "mark.11.p9.b3": {
    "text": "每天晚上，耶稣出城去。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:19"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "每⁠天晚⁠上，耶⁠稣出⁠城去。"
  },
  "mark.11.p10.b1": {
    "text": "早晨，他们从那里经过，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:20"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "早⁠晨，他⁠们从那⁠里经⁠过，"
  },
  "mark.11.p10.b2": {
    "text": "看见无花果树连根都枯干了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:20"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "看⁠见无⁠花果⁠树连根都枯⁠干了。"
  },
  "mark.11.p10.b3": {
    "text": "拉比，请看！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:21"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "拉⁠比，请⁠看！"
  },
  "mark.11.p10.b4": {
    "text": "你所咒诅的无花果树已经枯干了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:21"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你所咒诅的无⁠花果⁠树已⁠经枯⁠干了。"
  },
  "mark.11.p11.b1": {
    "text": "你们当信服神。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:22"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们当信⁠服神。"
  },
  "mark.11.p11.b2": {
    "text": "我实在告诉你们，无论何人对这座山说：『你挪开此地，投在海里！』",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:23"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我实⁠在告⁠诉你⁠们，无⁠论何⁠人对这座山说：『你挪⁠开此⁠地，投在海⁠里！』"
  },
  "mark.11.p11.b3": {
    "text": "他若心里不疑惑，只信他所说的必成，就必给他成了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:23"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他若心⁠里不疑⁠惑，只信他⁠所说⁠的必⁠成，就必给他成⁠了。"
  },
  "mark.11.p12.b1": {
    "text": "所以我告诉你们，凡你们祷告祈求的，无论是什么，只要信是得着的，就必得着。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:24"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "所⁠以我告⁠诉你⁠们，凡你⁠们祷⁠告祈⁠求的，无⁠论是什⁠么，只⁠要信是得着的，就必⁠得着。"
  },
  "mark.11.p12.b2": {
    "text": "你们站着祷告的时候，若想起有人得罪你们，就当饶恕他，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:25"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们站着祷⁠告的时⁠候，若想⁠起有⁠人得⁠罪你⁠们，就当饶⁠恕他，"
  },
  "mark.11.p12.b3": {
    "text": "好叫你们在天上的父也饶恕你们的过犯。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:25"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "好叫你⁠们在天⁠上的父也饶⁠恕你⁠们的过犯。"
  },
  "mark.11.p13.b1": {
    "text": "他们又来到耶路撒冷。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:27"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠们又来⁠到耶⁠路撒⁠冷。"
  },
  "mark.11.p13.b2": {
    "text": "耶稣在殿里行走的时候，祭司长和文士并长老进前来，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:27"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣在殿⁠里行⁠走的时⁠候，祭⁠司⁠长和文⁠士并长⁠老进前来，"
  },
  "mark.11.p13.b3": {
    "text": "你仗着什么权柄做这些事？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:28"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你仗着什⁠么权⁠柄做这⁠些事？"
  },
  "mark.11.p13.b4": {
    "text": "给你这权柄的是谁呢？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:28"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "给你这权⁠柄的⁠是谁呢？"
  },
  "mark.11.p14.b1": {
    "text": "我要问你们一句话，你们回答我，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:29"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我⁠要问你⁠们一⁠句话，你⁠们回⁠答我，"
  },
  "mark.11.p14.b2": {
    "text": "我就告诉你们我仗着什么权柄做这些事。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:29"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我就告⁠诉你⁠们我仗着什⁠么权⁠柄做这⁠些事。"
  },
  "mark.11.p14.b3": {
    "text": "约翰的洗礼是从天上来的？是从人间来的呢？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:30"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "约⁠翰的洗⁠礼是从天上⁠来的？是从人⁠间来的呢？"
  },
  "mark.11.p14.b4": {
    "text": "你们可以回答我。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:30"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们可⁠以回⁠答我。"
  },
  "mark.11.p15.b1": {
    "text": "我们若说『从天上来』，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:31"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我⁠们若说『从天上⁠来』，"
  },
  "mark.11.p15.b2": {
    "text": "他必说：『这样，你们为什么不信他呢？』",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:31"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他必说：『这⁠样，你⁠们为⁠什⁠么不⁠信他呢？』"
  },
  "mark.11.p15.b3": {
    "text": "若说『从人间来』，却又怕百姓，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:32"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "若说『从人⁠间来』，却又怕百⁠姓，"
  },
  "mark.11.p15.b4": {
    "text": "因为众人真以约翰为先知。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:32"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "因⁠为众⁠人真以约⁠翰为先⁠知。"
  },
  "mark.11.p16.b1": {
    "text": "我们不知道。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 11:33"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我⁠们不⁠知⁠道。"
  },
