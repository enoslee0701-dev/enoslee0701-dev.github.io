{
  "ezekiel.12.p1.b1": {
    "text": "人の子よ、あなたは反逆の家の中にいる。彼らは見る目があるが見ず、聞く耳があるが聞かず … それゆえ、人の子よ、捕囚の荷物を整え、彼らの目の前で昼のうちに移れ、彼らの目の前であなたの所から他の所に移れ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 12:2-3"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.12.p1.b2": {
    "text": "そこでわたしは命じられたようにし … 夕べにはわたしの手で壁に穴をあけ、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 12:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.12.p1.b3": {
    "text": "やみのうちに彼らの目の前で、これを肩に負って運び出した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 12:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.12.p1.b4": {
    "text": "わたしはあなたがたのしるしである。わたしがしたとおりに彼らもされる。彼らはとりこにされて移される",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 12:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.12.p1.b5": {
    "text": "彼らのうちの君は、やみのうちにその荷物を肩に載せて出て行く。… 彼は顔をおおって、自分の目でこの地を見ない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 12:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.12.p1.b6": {
    "text": "わたしは彼をカルデヤびとの地のバビロンに引いて行く。しかし彼はそれを見ないで、そこで死ぬであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 12:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.12.p2.b1": {
    "text": "人の子よ、震えてあなたのパンを食べ、おののきと恐れとをもって水を飲め。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 12:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.12.p2.b2": {
    "text": "彼らは恐れをもってそのパンを食べ、驚きをもってその水を飲むようになる。これはその地が、すべてその中に住む者の暴虐のために衰え、荒れ地となるからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 12:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.12.p2.b3": {
    "text": "人の住んでいた町々は荒れはて、地は荒塚となる。そしてあなたがたは、わたしが主であることを知るようになる",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 12:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.12.p2.b4": {
    "text": "日は延び、すべての幻はむなしくなった",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 12:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.12.p2.b5": {
    "text": "日とすべての幻の実現とは近づいた",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 12:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.12.p2.b6": {
    "text": "彼の見る幻は、なお多くの日の後の事である。彼が預言することは遠い後の時のことである",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 12:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.12.p2.b7": {
    "text": "わたしの言葉はもはや延びない。わたしの語る言葉は成就すると、主なる神は言われる",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 12:28"
    },
    "adapted": false,
    "status": "approved"
  }
}
