{
  "zechariah.7.p1.b1": {
    "text": "ダリヨス王の第四年の九月、すなわちキスリウという月の四日に、主の言葉がゼカリヤに臨んだ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 7:1-2"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.7.p1.b2": {
    "text": "わたしは今まで、多年おこなってきたように、五月に泣き悲しみ、かつ断食すべきでしょうか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 7:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.7.p1.b3": {
    "text": "あなたがたが七十年の間、五月と七月とに断食し、かつ泣き悲しんだ時、はたして、わたしのために断食したか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 7:4-7"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.7.p1.b4": {
    "text": "真実のさばきを行い、互に相いつくしみ、相あわれみ、やもめ、みなしご、寄留の他国人および貧しい人を、しえたげてはならない",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 7:8-10"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.7.p1.b5": {
    "text": "彼らは聞くことを拒み、肩をそびやかし、耳を鈍くして聞きいれず、その心を金剛石のようにして……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 7:11-13"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.7.p1.b6": {
    "text": "……この地は荒れて行き来する者もなく、この麗しい地は荒れ地となったのである",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 7:14"
    },
    "adapted": false,
    "status": "approved"
  }
}
