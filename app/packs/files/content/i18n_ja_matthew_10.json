{
  "matthew.10.p1.b1": {
    "text": "そこで、イエスは十二弟子を呼び寄せて、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p1.b2": {
    "text": "汚れた霊を追い出し、あらゆる病気、あらゆるわずらいをいやす権威をお授けになった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p2.b1": {
    "text": "十二使徒の名は、次のとおりである。まずペテロと呼ばれたシモンとその兄弟アンデレ、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p2.b2": {
    "text": "それからゼベダイの子ヤコブとその兄弟ヨハネ、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p2.b3": {
    "text": "ピリポとバルトロマイ、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p2.b4": {
    "text": "トマスと取税人マタイ、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p2.b5": {
    "text": "アルパヨの子ヤコブとタダイ、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p2.b6": {
    "text": "熱心党のシモンとイスカリオテのユダ。このユダはイエスを裏切った者である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p3.b1": {
    "text": "異邦人の道に行くな。またサマリヤ人の町にはいるな。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p3.b2": {
    "text": "むしろ、イスラエルの家の失われた羊のところに行け。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p3.b3": {
    "text": "行って、『天国が近づいた』と宣べ伝えよ。 病人をいやし、死人をよみがえらせ、らい病人をきよめ、悪霊を追い出せ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:7-8"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p3.b4": {
    "text": "ただで受けたのだから、ただで与えるがよい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p4.b1": {
    "text": "財布の中に金、銀または銭を入れて行くな。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p4.b2": {
    "text": "旅行のための袋も、二枚の下着も、くつも、つえも持って行くな。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p4.b3": {
    "text": "働き人がその食物を得るのは当然である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p5.b1": {
    "text": "その中でだれがふさわしい人か、たずね出して、立ち去るまではその人のところにとどまっておれ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p5.b2": {
    "text": "もし平安を受けるにふさわしい家であれば、あなたがたの祈る平安はその家に来るであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p5.b3": {
    "text": "もしあなたがたを迎えもせず、またあなたがたの言葉を聞きもしない人があれば、…足のちりを払い落しなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p5.b4": {
    "text": "さばきの日には、ソドム、ゴモラの地の方が、その町よりは耐えやすいであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p6.b1": {
    "text": "わたしがあなたがたをつかわすのは、羊をおおかみの中に送るようなものである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p6.b2": {
    "text": "だから、へびのように賢く、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p6.b3": {
    "text": "はとのように素直であれ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p7.b1": {
    "text": "人々に注意しなさい。彼らはあなたがたを衆議所に引き渡し、会堂でむち打つであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p7.b2": {
    "text": "言うべきことは、その時に授けられるからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p7.b3": {
    "text": "語る者は、あなたがたではなく、あなたがたの中にあって語る父の霊である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p8.b1": {
    "text": "兄弟は兄弟を、父は子を殺すために渡し、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p8.b2": {
    "text": "またあなたがたは、わたしの名のゆえにすべての人に憎まれるであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p8.b3": {
    "text": "しかし、最後まで耐え忍ぶ者は救われる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p8.b4": {
    "text": "一つの町で迫害されたなら、他の町へ逃げなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p9.b1": {
    "text": "弟子はその師以上のものではなく、僕はその主人以上の者ではない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p9.b2": {
    "text": "もし家の主人がベルゼブルと言われるならば、その家の者どもはなおさら、どんなにか悪く言われることであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p9.b3": {
    "text": "だから彼らを恐れるな。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p9.b4": {
    "text": "わたしが暗やみであなたがたに話すことを、明るみで言え。耳にささやかれたことを、屋根の上で言いひろめよ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p10.b1": {
    "text": "また、からだを殺しても、魂を殺すことのできない者どもを恐れるな。むしろ、からだも魂も地獄で滅ぼす力のあるかたを恐れなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p10.b2": {
    "text": "二羽のすずめは一アサリオンで売られているではないか。しかもあなたがたの父の許しがなければ、その一羽も地に落ちることはない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p10.b3": {
    "text": "またあなたがたの頭の毛までも、みな数えられている。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p10.b4": {
    "text": "それだから、恐れることはない。あなたがたは多くのすずめよりも、まさった者である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p11.b1": {
    "text": "だから人の前でわたしを受けいれる者を、わたしもまた、天にいますわたしの父の前で受けいれるであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p11.b2": {
    "text": "地上に平和をもたらすために、わたしがきたと思うな。平和ではなく、つるぎを投げ込むためにきたのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p11.b3": {
    "text": "わたしがきたのは、人をその父と、娘をその母と、嫁をそのしゅうとめと仲たがいさせるためである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p11.b4": {
    "text": "そして家の者が、その人の敵となるであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:36"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p12.b1": {
    "text": "わたしよりも父または母を愛する者は、わたしにふさわしくない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:37"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p12.b2": {
    "text": "また自分の十字架をとってわたしに従ってこない者はわたしにふさわしくない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p12.b3": {
    "text": "自分の命を得ている者はそれを失い、わたしのために自分の命を失っている者は、それを得るであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p13.b1": {
    "text": "あなたがたを受けいれる者は、わたしを受けいれるのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p13.b2": {
    "text": "わたしを受けいれる者は、わたしをおつかわしになったかたを受けいれるのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p13.b3": {
    "text": "預言者の名のゆえに預言者を受けいれる者は、預言者の報いを受け、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p13.b4": {
    "text": "義人の名のゆえに義人を受けいれる者は、義人の報いを受けるであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p14.b1": {
    "text": "わたしの弟子であるという名のゆえに、この小さい者のひとりに冷たい水一杯でも飲ませてくれる者は、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:42"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p14.b2": {
    "text": "よく言っておくが、決してその報いからもれることはない",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 10:42"
    },
    "adapted": false,
    "status": "approved"
  }
}
