{
  "exodus.6.p1.b1": {
    "text": "이제 내가 바로에게 하는 일을 네가 보리라 강한 손을 더하므로 바로가 그들을 보내리라 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 6:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.6.p1.b2": {
    "text": "나는 여호와로라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 6:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.6.p1.b3": {
    "text": "내가 아브라함과 이삭과 야곱에게 전능의 하나님으로 나타났으나 나의 이름을 여호와로는 그들에게 알리지 아니하였고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 6:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.6.p1.b4": {
    "text": "이제 애굽 사람이 종을 삼은 이스라엘 자손의 신음을 듣고 나의 언약을 기억하노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 6:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.6.p2.b5": {
    "text": "나는 여호와라 내가 애굽 사람의 무거운 짐 밑에서 너희를 빼어 내며 그 고역에서 너희를 건지며 편 팔과 큰 재앙으로 너희를 구속하여",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 6:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.6.p2.b6": {
    "text": "너희로 내 백성을 삼고 나는 너희 하나님이 되리니 … 내가 아브라함과 이삭과 야곱에게 주기로 맹세한 땅으로 너희를 인도하고 그 땅을 너희에게 주어 기업을 삼게 하리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 6:7-8"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.6.p2.b7": {
    "text": "모세가 이와 같이 이스라엘 자손에게 전하나 그들이 마음의 상함과 역사의 혹독함을 인하여 모세를 듣지 아니하였더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 6:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.6.p3.b8": {
    "text": "들어가서 애굽왕 바로에게 말하여 이스라엘 자손을 그 땅에서 내어 보내게 하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 6:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.6.p3.b9": {
    "text": "이스라엘 자손도 나를 듣지 아니하였거든 바로가 어찌 들으리이까 나는 입이 둔한 자니이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 6:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.6.p3.b10": {
    "text": "여호와께서 모세와 아론에게 말씀하사 그들로 이스라엘 자손과 애굽왕 바로에게 명을 전하고 이스라엘 자손을 애굽 땅에서 인도하여 내게 하시니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 6:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.6.p4.b11": {
    "text": "그 조상을 따라 집의 어른은 이러하니라 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 6:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.6.p4.b12": {
    "text": "아므람이 그 아비의 누이 요게벳을 아내로 취하였고 그가 아론과 모세를 낳았으며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 6:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.6.p4.b13": {
    "text": "애굽 왕 바로에게 이스라엘 자손을 애굽에서 내어 보내라 말한 자도 이 모세와 아론이었더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 6:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.6.p5.b14": {
    "text": "나는 여호와라 내가 네게 이르는 바를 너는 애굽왕 바로에게 다 고하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 6:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.6.p5.b15": {
    "text": "여호와께서 애굽 땅에서 모세에게 말씀하시던 날에 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 6:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.6.p5.b16": {
    "text": "나는 입이 둔한 자이오니 바로가 어찌 나를 들으리이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 6:30"
    },
    "adapted": false,
    "status": "approved"
  }
}
