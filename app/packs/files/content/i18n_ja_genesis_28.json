{
  "genesis.28.p1.b1": {
    "text": "イサクはヤコブを呼んで、これを祝福し、命じて言った、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 28:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.28.p1.b2": {
    "text": "あなたはカナンの娘を妻にめとってはならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 28:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.28.p1.b3": {
    "text": "立ってパダンアラムへ行き、あなたの母の父ベトエルの家に行って、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 28:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.28.p1.b4": {
    "text": "… そこであなたの母の兄ラバンの娘を妻にめとりなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 28:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.28.p2.b1": {
    "text": "全能の神が、あなたを祝福し、多くの子を得させ、かつふえさせて、多くの国民とし、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 28:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.28.p2.b2": {
    "text": "またアブラハムの祝福をあなたと子孫とに与えて、神がアブラハムに授けられたあなたの寄留の地を継がせてくださるように",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 28:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.28.p2.b3": {
    "text": "こうしてイサクはヤコブを送り出した。ヤコブはパダンアラムに向かい、アラムびとベトエルの子で、ヤコブとエサウとの母リベカの兄ラバンのもとへ行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 28:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.28.p3.b1": {
    "text": "さてエサウは、イサクがヤコブを祝福して、パダンアラムにつかわし、… そしてヤコブが父母の言葉に従って、パダンアラムへ行ったことを知ったとき、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 28:6-7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.28.p3.b2": {
    "text": "彼はカナンの娘が父イサクの心にかなわないのを見た。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 28:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.28.p3.b3": {
    "text": "そこでエサウはイシマエルの所に行き、すでにある妻たちのほかにアブラハムの子イシマエルの娘で、ネバヨテの妹マハラテを妻にめとった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 28:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.28.p4.b1": {
    "text": "さてヤコブはベエルシバを立って、ハランへ向かったが、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 28:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.28.p4.b2": {
    "text": "一つの所に着いた時、日が暮れたので、そこに一夜を過ごし、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 28:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.28.p4.b3": {
    "text": "その所の石を取ってまくらとし、そこに伏して寝た。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 28:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.28.p5.b1": {
    "text": "時に彼は夢をみた。一つのはしごが地の上に立っていて、その頂は天に達し、神の使たちがそれを上り下りしているのを見た。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 28:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.28.p6.b1": {
    "text": "わたしはあなたの父アブラハムの神、イサクの神、主である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 28:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.28.p6.b2": {
    "text": "あなたが伏している地を、あなたと子孫とに与えよう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 28:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.28.p6.b3": {
    "text": "あなたの子孫は地のちりのように多くなって、西、東、北、南にひろがり、地の諸族はあなたと子孫とによって祝福をうけるであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 28:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.28.p6.b4": {
    "text": "わたしはあなたと共にいて、あなたがどこへ行くにもあなたを守り、あなたをこの地に連れ帰るであろう。わたしは決してあなたを捨てず、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 28:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.28.p7.b1": {
    "text": "まことに主がこの所におられるのに、わたしは知らなかった",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 28:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.28.p7.b2": {
    "text": "これはなんという恐るべき所だろう。これは神の家である。これは天の門だ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 28:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.28.p7.b3": {
    "text": "ヤコブは朝はやく起きて、まくらとしていた石を取り、それを立てて柱とし、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 28:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.28.p7.b4": {
    "text": "その頂に油を注いで、 その所の名をベテルと名づけた。その町の名は初めはルズといった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 28:18-19"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.28.p8.b1": {
    "text": "神がわたしと共にいまし、わたしの行くこの道でわたしを守り、食べるパンと着る着物を賜い、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 28:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.28.p8.b2": {
    "text": "安らかに父の家に帰らせてくださるなら、主をわたしの神といたしましょう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 28:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.28.p8.b3": {
    "text": "またわたしが柱に立てたこの石を神の家といたしましょう。そしてあなたがくださるすべての物の十分の一を、わたしは必ずあなたにささげます」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 28:22"
    },
    "adapted": false,
    "status": "approved"
  }
}
