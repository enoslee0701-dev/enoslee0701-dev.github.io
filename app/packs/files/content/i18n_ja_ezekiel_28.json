{
  "ezekiel.28.p1.b1": {
    "text": "わたしは神である、神々の座にすわって、海の中にいる",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 28:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.28.p1.b2": {
    "text": "しかし、あなたは自分を神のように賢いと思っても、人であって、神ではない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 28:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.28.p1.b3": {
    "text": "あなたは大いなる貿易の知恵によってあなたの富を増し、その富によってあなたの心は高ぶった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 28:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.28.p1.b4": {
    "text": "見よ、わたしは、もろもろの国民の最も恐れている異邦人をあなたに攻めこさせる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 28:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.28.p1.b5": {
    "text": "それでもなおあなたは、『自分は神である』と、あなたを殺す人々の前で言うことができるか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 28:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.28.p2.b1": {
    "text": "人の子よ、ツロの王のために悲しみの歌をのべて",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 28:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.28.p2.b2": {
    "text": "あなたは知恵に満ち、美のきわみである完全な印である。……あなたは神の園エデンにあって、もろもろの宝石が、あなたをおおっていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 28:12-13"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.28.p2.b3": {
    "text": "火の石の間を歩いた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 28:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.28.p2.b4": {
    "text": "あなたは自分の美しさのために心高ぶり、その輝きのために自分の知恵を汚したゆえに、わたしはあなたを地に投げうち",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 28:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.28.p2.b5": {
    "text": "あなたを見るすべての者の前であなたを地の上の灰とした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 28:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.28.p2.b6": {
    "text": "彼らはそこに安らかに住み、家を建て、またぶどう畑を作る。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 28:26"
    },
    "adapted": false,
    "status": "approved"
  }
}
