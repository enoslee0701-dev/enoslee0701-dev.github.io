{
  "genesis.18.p1.b1": {
    "text": "主はマムレのテレビンの木のかたわらでアブラハムに現れられた。それは昼の暑いころで、彼は天幕の入口にすわっていたが、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p1.b2": {
    "text": "目を上げて見ると、三人の人が彼に向かって立っていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p1.b3": {
    "text": "彼はこれを見て、天幕の入口から走って行って彼らを迎え、地に身をかがめて、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p2.b4": {
    "text": "わが主よ、もしわたしがあなたの前に恵みを得ているなら、どうぞしもべを通り過ごさないでください。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p2.b5": {
    "text": "水をすこし取ってこさせますから、あなたがたは足を洗って、この木の下でお休みください。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p2.b6": {
    "text": "わたしは一口のパンを取ってきます。元気をつけて、それからお出かけください。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p2.b7": {
    "text": "お言葉どおりにしてください",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p3.b8": {
    "text": "急いで細かい麦粉三セヤをとり、こねてパンを造りなさい",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p3.b9": {
    "text": "アブラハムは牛の群れに走って行き、柔らかな良い子牛を取って若者に渡したので、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p3.b10": {
    "text": "そしてアブラハムは凝乳と牛乳および子牛の調理したものを取って、彼らの前に供え、木の下で彼らのかたわらに立って給仕し、彼らは食事した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p4.b11": {
    "text": "あなたの妻サラはどこにおられますか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p4.b12": {
    "text": "天幕の中です",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p4.b13": {
    "text": "来年の春、わたしはかならずあなたの所に帰ってきましょう。その時、あなたの妻サラには男の子が生れているでしょう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p4.b14": {
    "text": "さてアブラハムとサラとは年がすすみ、老人となり、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p4.b15": {
    "text": "わたしは衰え、主人もまた老人であるのに、わたしに楽しみなどありえようか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p5.b16": {
    "text": "なぜサラは、わたしは老人であるのに、どうして子を産むことができようかと言って笑ったのか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p5.b17": {
    "text": "主にとって不可能なことがありましょうか。来年の春、定めの時に、わたしはあなたの所に帰ってきます。そのときサラには男の子が生れているでしょう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p5.b18": {
    "text": "わたしは笑いません",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p5.b19": {
    "text": "いや、あなたは笑いました",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p6.b20": {
    "text": "その人々はそこを立ってソドムの方に向かったので、アブラハムは彼らを見送って共に行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p6.b21": {
    "text": "わたしのしようとする事をアブラハムに隠してよいであろうか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p6.b22": {
    "text": "ソドムとゴモラの叫びは大きく、またその罪は非常に重いので、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p6.b23": {
    "text": "わたしはいま下って、…彼らがおこなっているかどうかを見て、それを知ろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p7.b24": {
    "text": "その人々はそこから身を巡らしてソドムの方に行ったが、アブラハムはなお、主の前に立っていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p7.b25": {
    "text": "まことにあなたは正しい者を、悪い者と一緒に滅ぼされるのですか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p7.b26": {
    "text": "正しい者と悪い者とを一緒に殺すようなことを、あなたは決してなさらないでしょう。…全地をさばく者は公義を行うべきではありませんか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p7.b27": {
    "text": "もしソドムで町の中に五十人の正しい者があったら、その人々のためにその所をすべてゆるそう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p8.b28": {
    "text": "わたしはちり灰に過ぎませんが、あえてわが主に申します。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p8.b29": {
    "text": "もしそこに四十五人いたら、滅ぼさないであろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p8.b30": {
    "text": "もしそこに四十人いたら",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p8.b31": {
    "text": "わが主よ、どうかお怒りにならぬよう。わたしは申します。もしそこに三十人いたら",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p9.b32": {
    "text": "いまわたしはあえてわが主に申します。もしそこに二十人いたら",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p9.b33": {
    "text": "わが主よ、どうかお怒りにならぬよう。わたしはいま一度申します、もしそこに十人いたら",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p9.b34": {
    "text": "わたしはその十人のために滅ぼさないであろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.18.p9.b35": {
    "text": "主はアブラハムと語り終り、去って行かれた。アブラハムは自分の所に帰った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 18:33"
    },
    "adapted": false,
    "status": "approved"
  }
}
