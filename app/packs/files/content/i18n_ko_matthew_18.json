{
  "matthew.18.p1.b1": {
    "text": "그 때에 제자들이 예수께 나아와 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p1.b2": {
    "text": "천국에서는 누가 크니이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p1.b3": {
    "text": "예수께서 한 어린 아이를 불러 저희 가운데 세우시고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p2.b1": {
    "text": "진실로 너희에게 이르노니 너희가 돌이켜 어린 아이들과 같이 되지 아니하면 결단코 천국에 들어가지 못하리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p2.b2": {
    "text": "그러므로 누구든지 이 어린 아이와 같이 자기를 낮추는 그이가 천국에서 큰 자니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p2.b3": {
    "text": "또 누구든지 내 이름으로 이런 어린 아이 하나를 영접하면 곧 나를 영접함이니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p3.b1": {
    "text": "누구든지 나를 믿는 이 소자 중 하나를 실족케 하면",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p3.b2": {
    "text": "차라리 연자 맷돌을 그목에 달리우고 깊은 바다에 빠뜨리우는 것이 나으니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p3.b3": {
    "text": "실족케 하는 일이 없을 수는 없으나 실족케 하는 그 사람에게는 화가 있도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p4.b1": {
    "text": "만일 네 손이나 네 발이 너를 범죄케 하거든 찍어 내버리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p4.b2": {
    "text": "만일 네 눈이 너를 범죄케 하거든 빼어 내버리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p4.b3": {
    "text": "한 눈으로 영생에 들어가는 것이 두 눈을 가지고 지옥 불에 던지우는 것보다 나으니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p5.b1": {
    "text": "삼가 이 소자 중에 하나도 업신여기지 말라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p5.b2": {
    "text": "저희 천사들이 하늘에서 하늘에 계신 내 아버지의 얼굴을 항상 뵈옵느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p5.b3": {
    "text": "만일 어떤 사람이 양 일백 마리가 있는데 그 중에 하나가 길을 잃었으면",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p5.b4": {
    "text": "그 아흔 아홉 마리를 산에 두고 가서 길 잃은 양을 찾지 않겠느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p6.b1": {
    "text": "진실로 너희에게 이르노니 만일 찾으면",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p6.b2": {
    "text": "길을 잃지 아니한 아흔 아홉 마리보다 이것을 더 기뻐하리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p6.b3": {
    "text": "이와 같이 이 소자 중에 하나라도 잃어지는 것은 하늘에 계신 너희 아버지의 뜻이 아니니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p7.b1": {
    "text": "네 형제가 죄를 범하거든 가서 너와 그 사람과만 상대하여 권고하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p7.b2": {
    "text": "만일 들으면 네가 네 형제를 얻은 것이요",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p7.b3": {
    "text": "만일 듣지 않거든 한 두 사람을 데리고 가서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p7.b4": {
    "text": "만일 그들의 말도 듣지 않거든 교회에 말하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p8.b1": {
    "text": "무엇이든지 너희가 땅에서 매면 하늘에서도 매일 것이요 무엇이든지 땅에서 풀면 하늘에서도 풀리리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p8.b2": {
    "text": "너희 중에 두 사람이 땅에서 합심하여 무엇이든지 구하면 하늘에 계신 내 아버지께서 저희를 위하여 이루게 하시리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p8.b3": {
    "text": "두 세 사람이 내 이름으로 모인 곳에는 나도 그들 중에 있느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p9.b1": {
    "text": "그 때에 베드로가 나아와 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p9.b2": {
    "text": "주여 형제가 내게 죄를 범하면 몇번이나 용서하여 주리이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p9.b3": {
    "text": "일곱번까지 하오리이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p9.b4": {
    "text": "네게 이르노니 일곱번 뿐 아니라 일흔번씩 일곱번이라도 할지니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p10.b1": {
    "text": "이러므로 천국은 그 종들과 회계하려 하던 어떤 임금과 같으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p10.b2": {
    "text": "회계할 때에 일만 달란트 빚진 자 하나를 데려오매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p10.b3": {
    "text": "주인이 명하여 그 몸과 처와 자식들과 모든 소유를 다 팔아 갚게 하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p10.b4": {
    "text": "내게 참으소서 다 갚으리이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p11.b1": {
    "text": "그 종의 주인이 불쌍히 여겨 놓아 보내며 그 빚을 탕감하여 주었더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p11.b2": {
    "text": "그 종이 나가서 제게 백 데나리온 빚진 동관 하나를 만나",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p11.b3": {
    "text": "빚을 갚으라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p12.b1": {
    "text": "나를 참아 주소서 갚으리이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p12.b2": {
    "text": "허락하지 아니하고 이에 가서 저가 빚을 갚도록 옥에 가두거늘",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p12.b3": {
    "text": "그 동관들이 그것을 보고 심히 민망하여 주인에게 가서 그 일을 다 고하니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p13.b1": {
    "text": "악한 종아 네가 빌기에 내가 네 빚을 전부 탕감하여 주었거늘 내가 너를 불쌍히 여김과 같이 너도 네 동관을 불쌍히 여김이 마땅치 아니하냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:32-33"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p13.b2": {
    "text": "주인이 노하여 그 빚을 다 갚도록 저를 옥졸들에게 붙이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.18.p13.b3": {
    "text": "너희가 각각 중심으로 형제를 용서하지 아니하면 내 천부께서도 너희에게 이와 같이 하시리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 18:35"
    },
    "adapted": false,
    "status": "approved"
  }
}
