{
  "exodus.18.p1.b1": {
    "text": "さて、モーセのしゅうと、ミデアンの祭司エテロは、神がモーセと、み民イスラエルとにされたすべての事……を聞いた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 18:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.18.p1.b2": {
    "text": "それでモーセのしゅうと、エテロは、さきに送り返されていたモーセの妻チッポラと、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 18:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.18.p1.b3": {
    "text": "ほかのひとりの名はエリエゼルといった。「わたしの父の神はわたしの助けであって、パロのつるぎからわたしを救われた」と言ったからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 18:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.18.p1.b4": {
    "text": "あなたのしゅうと、エテロは、あなたの妻とそのふたりの子を連れて、あなたの所にこられます",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 18:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.18.p2.b5": {
    "text": "そこでモーセはしゅうとを出迎えて、身をかがめ、彼に口づけして、互に安否を問い、共に天幕にはいった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 18:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.18.p2.b6": {
    "text": "そしてモーセは、主がイスラエルのために、パロとエジプトびととにされたすべての事……しゅうとに物語った",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 18:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.18.p2.b7": {
    "text": "主はほむべきかな。……今こそわたしは知った。……主はあらゆる神々にまさって大いにいますことを",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 18:10-11"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.18.p2.b8": {
    "text": "アロンとイスラエルの長老たちもみなきて、モーセのしゅうとと共に神の前で食事をした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 18:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.18.p3.b9": {
    "text": "あくる日モーセは座して民をさばいたが、民は朝から晩まで、モーセのまわりに立っていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 18:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.18.p3.b10": {
    "text": "あなたが民にしているこのことはなんですか。あなたひとりが座し、民はみな朝から晩まで、あなたのまわりに立っているのはなぜですか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 18:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.18.p3.b11": {
    "text": "民が神に伺おうとして、わたしの所に来るからです。……わたしは相互の間をさばいて",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 18:15-16"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.18.p4.b12": {
    "text": "あなたのしていることは良くない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 18:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.18.p4.b13": {
    "text": "あなたも、あなたと一緒にいるこの民も、必ず疲れ果てるであろう。このことはあなたに重過ぎるから、ひとりですることができない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 18:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.18.p4.b14": {
    "text": "今わたしの言うことを聞きなさい。わたしはあなたに助言する。どうか神があなたと共にいますように。あなたは民のために神の前にいて、事件を神に述べなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 18:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.18.p4.b15": {
    "text": "あなたは彼らに定めと判決を教え、彼らの歩むべき道と、なすべき事を彼らに知らせなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 18:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.18.p5.b16": {
    "text": "また、すべての民のうちから、有能な人で、神を恐れ、誠実で不義の利を憎む人を選び、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 18:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.18.p5.b17": {
    "text": "それを民の上に立てて、千人の長、百人の長、五十人の長、十人の長としなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 18:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.18.p5.b18": {
    "text": "大事件はすべてあなたの所に持ってこさせ、小事件はすべて彼らにさばかせなさい。こうしてあなたを身軽にし、あなたと共に彼らに、荷を負わせなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 18:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.18.p5.b19": {
    "text": "あなたが、もしこの事を行い、神もまたあなたに命じられるならば、あなたは耐えることができ、この民もまた、みな安んじてその所に帰ることができよう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 18:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.18.p6.b20": {
    "text": "モーセはしゅうとの言葉に従い、すべて言われたようにした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 18:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.18.p6.b21": {
    "text": "すなわち、モーセはすべてのイスラエルのうちから有能な人を選んで、民の上に長として立て、千人の長、百人の長、五十人の長、十人の長とした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 18:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.18.p6.b22": {
    "text": "平素は彼らが民をさばき、むずかしい事件はモーセに持ってきたが、小さい事件はすべて彼らみずからさばいた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 18:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.18.p6.b23": {
    "text": "こうしてモーセはしゅうとを送り返したので、その国に帰って行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 18:27"
    },
    "adapted": false,
    "status": "approved"
  }
}
