{
  "genesis.46.p1.b1": {
    "text": "이스라엘이 모든 소유를 이끌고 발행하여 브엘세바에 이르러",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 46:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p1.b2": {
    "text": "그 아비 이삭의 하나님께 희생을 드리니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 46:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p1.b3": {
    "text": "야곱아 야곱아",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 46:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p1.b4": {
    "text": "내가 여기 있나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 46:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p1.b5": {
    "text": "애굽으로 내려가기를 두려워 말라 … 내가 너와 함께 애굽으로 내려가겠고 정녕 너를 인도하여 다시 올라올 것이며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 46:3-4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p2.b1": {
    "text": "야곱이 브엘세바에서 발행할새 이스라엘의 아들들이 바로의 태우려고 보낸 수레에 자기들의 아비 야곱과 자기들의 처자들을 태웠고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 46:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p2.b2": {
    "text": "그 생축과 가나안 땅에서 얻은 재물을 이끌었으며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 46:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p2.b3": {
    "text": "야곱과 그 자손들이 다 함께 애굽으로 갔더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 46:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p3.b1": {
    "text": "애굽으로 내려간 이스라엘 가족의 이름이 이러하니 … 야곱의 맏아들 르우벤과",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 46:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p3.b2": {
    "text": "유다의 아들 곧 엘과 오난과 셀라와 베레스와 세라니 엘과 오난은 가나안 땅에서 죽었고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 46:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p3.b3": {
    "text": "이들은 레아가 밧단아람에서 야곱에게 낳은 자손들이라 그 딸 디나를 합하여 남자와 여자가 삼십 삼명이며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 46:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p4.b1": {
    "text": "이들은 … 실바가 야곱에게 낳은 자손들이라 합 십육명이요",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 46:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p4.b2": {
    "text": "야곱의 아내 라헬의 아들 곧 요셉과 베냐민이요",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 46:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p4.b3": {
    "text": "애굽 땅에서 … 요셉에게 낳은 므낫세와 에브라임이요",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 46:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p4.b4": {
    "text": "야곱의 집 사람으로 애굽에 이른 자의 도합이 칠십명이었더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 46:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p5.b1": {
    "text": "야곱이 유다를 요셉에게 미리 보내어 자기를 고센으로 인도하게 하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 46:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p5.b2": {
    "text": "요셉이 수레를 갖추고 고센으로 올라가서 아비 이스라엘을 맞으며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 46:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p5.b3": {
    "text": "그에게 보이고 그 목을 어긋맞겨 안고 얼마동안 울매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 46:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p5.b4": {
    "text": "네가 지금까지 살아 있고 내가 네 얼굴을 보았으니 지금 죽어도 가하도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 46:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p6.b1": {
    "text": "내가 올라가서 바로에게 고하여 이르기를 가나안 땅에 있던 내 형들과 내 아비의 권속이 내게로 왔는데",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 46:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p6.b2": {
    "text": "바로가 당신들을 불러서 너희의 업이 무엇이냐 묻거든 당신들은 고하기를 주의 종들은 어렸을 때부터 지금까지 목축하는 자이온데 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 46:33-34"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p6.b3": {
    "text": "애굽 사람은 다 목축을 가증히 여기나니 당신들이 고센땅에 거하게 되리이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 46:34"
    },
    "adapted": false,
    "status": "approved"
  }
}
