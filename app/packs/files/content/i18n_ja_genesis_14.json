{
  "genesis.14.p1.b1": {
    "text": "シナルの王アムラペル、エラサルの王アリオク、エラムの王ケダラオメルおよびゴイムの王テダルの世に、 これらの王はソドムの王ベラ … と戦った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 14:1-2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p1.b2": {
    "text": "すなわち彼らは十二年の間ケダラオメルに仕えたが、十三年目にそむいたので、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 14:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p1.b3": {
    "text": "十四年目にケダラオメルは彼と連合した王たちと共にきて、アシタロテ・カルナイムでレパイムびとを … 撃って、荒野のほとりにあるエル・パランに及んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 14:5-6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p1.b4": {
    "text": "彼らは引き返してエン・ミシパテすなわちカデシへ行って、アマレクびとの国をことごとく撃ち、またハザゾン・タマルに住むアモリびとをも撃った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 14:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p2.b5": {
    "text": "そこでソドムの王 … は出てシデムの谷で彼らに向かい、戦いの陣をしいた。 … 四人の王に対する五人の王であった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 14:8-9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p2.b6": {
    "text": "シデムの谷にはアスファルトの穴が多かったので、ソドムの王とゴモラの王は逃げてそこに落ちたが、残りの者は山にのがれた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 14:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p2.b7": {
    "text": "またソドムに住んでいたアブラムの弟の子ロトとその財産を奪って去った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 14:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p3.b8": {
    "text": "時に、ひとりの人がのがれてきて、ヘブルびとアブラムに告げた。この時アブラムは … アモリびとマムレのテレビンの木のかたわらに住んでいた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 14:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p3.b9": {
    "text": "アブラムは身内の者が捕虜になったのを聞き、訓練した家の子三百十八人を引き連れてダンまで追って行き、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 14:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p4.b10": {
    "text": "そのしもべたちを分けて、夜かれらを攻め、これを撃って",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 14:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p4.b11": {
    "text": "ダマスコの北、ホバまで彼らを追った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 14:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p5.b12": {
    "text": "そして彼はすべての財産を取り返し、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 14:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p5.b13": {
    "text": "また身内の者ロトとその財産",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 14:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p5.b14": {
    "text": "および女たちと民とを取り返した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 14:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p6.b15": {
    "text": "アブラムがケダラオメルとその連合の王たちを撃ち破って帰った時、ソドムの王はシャベの谷、すなわち王の谷に出て彼を迎えた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 14:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p6.b16": {
    "text": "「願わくは天地の主なるいと高き神が、アブラムを祝福されるように。 願わくはあなたの敵をあなたの手に渡されたいと高き神があがめられるように」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 14:19-20"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p6.b17": {
    "text": "アブラムは彼にすべての物の十分の一を贈った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 14:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p7.b18": {
    "text": "「わたしには人をください。財産はあなたが取りなさい」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 14:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p7.b19": {
    "text": "「天地の主なるいと高き神、主に手をあげて、わたしは誓います。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 14:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p7.b20": {
    "text": "わたしは糸一本でも、くつひも一本でも、あなたのものは何にも受けません。アブラムを富ませたのはわたしだと、あなたが言わないように。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 14:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p7.b21": {
    "text": "ただし若者たちがすでに食べた物は別です。そしてわたしと共に行った人々アネルとエシコルとマムレとにはその分を取らせなさい」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 14:24"
    },
    "adapted": false,
    "status": "approved"
  }
}
