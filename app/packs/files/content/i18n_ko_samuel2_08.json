{
  "samuel2.8.p1.b1": {
    "text": "이 후에 다윗이 블레셋 사람을 쳐서 항복 받고 블레셋 사람의 손에서 메덱암마를 빼앗으니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 8:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.8.p1.b2": {
    "text": "다윗이 또 모압을 쳐서 저희로 땅에 엎드리게 하고 줄로 재어 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 8:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.8.p1.b3": {
    "text": "모압 사람이 다윗의 종이 되어 조공을 바치니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 8:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.8.p2.b1": {
    "text": "르흡의 아들 소바 왕 하닷에셀이 자기 권세를 회복하려고 유브라데강으로 갈 때에 다윗이 저를 쳐서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 8:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.8.p2.b2": {
    "text": "그 마병 일천 칠백과 보병 이만을 사로잡고 병거 일백승의 말만 남기고 그 외의 병거의 말은 다 발의 힘줄을 끊었더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 8:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.8.p2.b3": {
    "text": "다메섹 아람에 수비대를 두매 아람 사람이 다윗의 종이 되어 조공을 바치니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 8:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.8.p2.b4": {
    "text": "다윗이 어디를 가든지 여호와께서 이기게 하시니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 8:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.8.p3.b1": {
    "text": "다윗이 하닷에셀의 신복들의 가진 금방패를 빼앗아 예루살렘으로 가져오고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 8:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.8.p3.b2": {
    "text": "또 하닷에셀의 고을 베다와 베로대에서 매우 많은 놋을 빼앗으니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 8:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.8.p3.b3": {
    "text": "하맛 왕 도이가 다윗이 하닷에셀의 온 군대를 쳐서 파하였다 함을 듣고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 8:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.8.p3.b4": {
    "text": "그 아들 요람을 보내어 다윗 왕에게 문안하고 축복하게 하니 … 요람이 은 그릇과 금 그릇과 놋 그릇을 가지고 온지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 8:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.8.p4.b1": {
    "text": "다윗왕이 그것도 여호와께 드리되 저가 정복한 모든 나라에서 얻은 은금",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 8:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.8.p4.b2": {
    "text": "다윗이 염곡에서 에돔 사람 일만 팔천을 쳐죽이고 돌아와서 명예를 얻으니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 8:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.8.p4.b3": {
    "text": "다윗이 에돔에 수비대를 두되 온 에돔에 수비대를 두니 에돔 사람이 다 다윗의 종이 되니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 8:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.8.p4.b4": {
    "text": "다윗이 어디를 가든지 여호와께서 이기게 하셨더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 8:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.8.p5.b1": {
    "text": "다윗이 온 이스라엘을 다스려 모든 백성에게 공과 의를 행할새",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 8:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.8.p5.b2": {
    "text": "스루야의 아들 요압은 군대장관이 되고 아힐룻의 아들 여호사밧은 사관이 되고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 8:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.8.p5.b3": {
    "text": "아히둡의 아들 사독과 아비아달의 아들 아히멜렉은 제사장이 되고 스라야는 서기관이 되고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 8:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.8.p5.b4": {
    "text": "여호야다의 아들 브나야는 그렛 사람과 블렛 사람을 관할하고 다윗의 아들들은 대신이 되니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 8:18"
    },
    "adapted": false,
    "status": "approved"
  }
}
