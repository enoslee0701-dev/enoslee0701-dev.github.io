{
  "exodus.7.p1.b1": {
    "text": "볼지어다 내가 너로 바로에게 신이 되게 하였은즉 네 형 아론은 네 대언자가 되리니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 7:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.7.p1.b2": {
    "text": "내가 네게 명한 바를 너는 네 형 아론에게 말하고 그는 바로에게 말하여 그로 이스라엘 자손을 그 땅에서 보내게 할지니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 7:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.7.p1.b3": {
    "text": "바로가 너희를 듣지 아니할터인즉 내가 내 손을 애굽에 더하여 여러 큰 재앙을 내리고 내 군대 내 백성 이스라엘 자손을 그 땅 에서 인도하여 낼지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 7:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.7.p1.b4": {
    "text": "그들이 바로에게 말할 때에 모세는 팔십세이었고 아론은 팔십 삼세이었더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 7:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.7.p2.b5": {
    "text": "너희는 이적을 보이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 7:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.7.p2.b6": {
    "text": "너의 지팡이를 가져 바로 앞에 던지라 … 그것이 뱀이 되리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 7:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.7.p2.b7": {
    "text": "아론이 바로와 그 신하 앞에 지팡이를 던졌더니 뱀이 된지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 7:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.7.p3.b8": {
    "text": "바로도 박사와 박수를 부르매 그 애굽 술객들도 그 술법으로 그와 같이 행하되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 7:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.7.p3.b9": {
    "text": "각 사람이 지팡이를 던지매 뱀이 되었으나 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 7:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.7.p3.b10": {
    "text": "아론의 지팡이가 그들의 지팡이를 삼키니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 7:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.7.p3.b11": {
    "text": "그러나 바로의 마음이 강퍅하여 그들을 듣지 아니하니 여호와의 말씀과 같더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 7:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.7.p4.b12": {
    "text": "아침에 너는 바로에게로 가라 그가 물로 나오리니 너는 하숫가에 서서 그를 맞으며 그 뱀 되었던 지팡이를 손에 잡고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 7:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.7.p4.b13": {
    "text": "히브리 사람의 하나님 여호와께서 나를 왕에게 보내어 이르시되 내 백성을 보내라 그들이 광야에서 나를 섬길 것이니라 하였으나 이제까지 네가 듣지 아니하도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 7:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.7.p4.b14": {
    "text": "여호와가 이같이 이르노니 네가 이로 인하여 나를 여호와인줄 알리라 하셨느니라 볼지어다 내가 내 손의 지팡이로 하수를 치면 그것이 피로 변하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 7:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.7.p4.b15": {
    "text": "하수의 고기가 죽고 그 물에서는 악취가 나리니 애굽 사람들이 그 물 마시기를 싫어하리라 하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 7:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.7.p5.b16": {
    "text": "네 지팡이를 잡고 네 팔을 애굽의 물들과 … 위에 펴라 … 그것들이 피가 되리니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 7:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.7.p5.b17": {
    "text": "바로와 그 신하의 목전에서 지팡이를 들어 하수를 치니 그 물이 다 피로 변하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 7:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.7.p6.b18": {
    "text": "하수의 고기가 죽고 그 물에서는 악취가 나니 애굽 사람들이 하수물을 마시지 못하며 애굽 온 땅에는 피가 있으나",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 7:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.7.p6.b19": {
    "text": "애굽 술객들도 자기 술법으로 그와 같이 행하므로 바로의 마음이 강퍅하여 그들을 듣지 아니하니 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 7:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.7.p6.b20": {
    "text": "바로가 돌이켜 궁으로 들어가고 그 일에도 관념하지 아니하였고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 7:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.7.p7.b21": {
    "text": "애굽 사람들은 하수 물을 마실 수 없으므로 하숫가를 두루 파서 마실 물을 구하였더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 7:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.7.p7.b22": {
    "text": "여호와께서 하수를 치신 후 칠일이 지나니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 7:25"
    },
    "adapted": false,
    "status": "approved"
  }
}
