{
  "genesis.37.p1.b1": {
    "text": "ヤコブは父の寄留の地、すなわちカナンの地に住んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p1.b2": {
    "text": "ヨセフは十七歳の時、兄弟たちと共に羊の群れを飼っていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p1.b3": {
    "text": "…イスラエルは他のどの子よりも彼を愛して、彼のために長そでの着物をつくった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p1.b4": {
    "text": "兄弟たちは父がどの兄弟よりも彼を愛するのを見て、彼を憎み、穏やかに彼に語ることができなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p2.b1": {
    "text": "どうぞわたしが見た夢を聞いてください。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p2.b2": {
    "text": "わたしたちが畑の中で束を結わえていたとき、わたしの束が起きて立つと、あなたがたの束がまわりにきて、わたしの束を拝みました",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p2.b3": {
    "text": "あなたはほんとうにわたしたちの王になるのか。あなたは実際わたしたちを治めるのか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p2.b4": {
    "text": "彼の夢とその言葉のゆえにますます彼を憎んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p3.b1": {
    "text": "わたしはまた夢を見ました。日と月と十一の星とがわたしを拝みました",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p3.b2": {
    "text": "あなたが見たその夢はどういうのか。ほんとうにわたしとあなたの母と、兄弟たちとが行って地に伏し、あなたを拝むのか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p3.b3": {
    "text": "兄弟たちは彼をねたんだ。しかし父はこの言葉を心にとめた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p4.b1": {
    "text": "どうか、行って、あなたの兄弟たちは無事であるか、また群れは無事であるか見てきて、わたしに知らせてください",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p4.b2": {
    "text": "彼はシケムに行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p4.b3": {
    "text": "あなたは何を捜しているのですか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p4.b4": {
    "text": "兄弟たちを捜しているのです。彼らが、どこで羊を飼っているのか、どうぞわたしに知らせてください",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p4.b5": {
    "text": "彼らはここを去りました。彼らが『ドタンへ行こう』と言うのをわたしは聞きました",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p5.b1": {
    "text": "ヨセフが彼らに近づかないうちに、彼らははるかにヨセフを見て、これを殺そうと計り、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p5.b2": {
    "text": "あの夢見る者がやって来る。…そして彼の夢がどうなるか見よう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:19-20"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p5.b3": {
    "text": "血を流してはいけない。彼を荒野のこの穴に投げ入れよう。彼に手をくだしてはならない",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p5.b4": {
    "text": "これはヨセフを彼らの手から救いだして父に返すためであった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p6.b1": {
    "text": "さて、ヨセフが兄弟たちのもとへ行くと、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p6.b2": {
    "text": "彼らはヨセフの着物、彼が着ていた長そでの着物をはぎとり、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p6.b3": {
    "text": "彼を捕えて穴に投げ入れた。その穴はからで、その中に水はなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p7.b1": {
    "text": "こうして彼らはすわってパンを食べた。時に彼らが目をあげて見ると、…らくだに香料と、乳香と、もつやくとを負わせてエジプトへ下り行こうと…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p7.b2": {
    "text": "われわれが弟を殺し、その血を隠して何の益があろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p7.b3": {
    "text": "さあ、われわれは彼をイシマエルびとに売ろう。彼はわれわれの兄弟、われわれの肉身だから、彼に手を下してはならない",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p7.b4": {
    "text": "兄弟たちはこれを聞き入れた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p8.b1": {
    "text": "時にミデアンびとの商人たちが通りかかったので、彼らはヨセフを穴から引き上げ、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p8.b2": {
    "text": "銀二十シケルでヨセフをイシマエルびとに売った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p8.b3": {
    "text": "彼らはヨセフをエジプトへ連れて行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p9.b1": {
    "text": "さてルベンは穴に帰って見たが、ヨセフが穴の中にいなかったので、彼は衣服を裂き、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p9.b2": {
    "text": "あの子はいない。ああ、わたしはどこへ行くことができよう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p9.b3": {
    "text": "…雄やぎを殺して、着物をその血に浸し、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p9.b4": {
    "text": "わたしたちはこれを見つけましたが、これはあなたの子の着物か、どうか見さだめてください",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p10.b1": {
    "text": "わが子の着物だ。…確かにヨセフはかみ裂かれたのだ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p10.b2": {
    "text": "そこでヤコブは衣服を裂き、荒布を腰にまとって、長い間その子のために嘆いた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p10.b3": {
    "text": "わたしは嘆きながら陰府に下って、わが子のもとへ行こう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p10.b4": {
    "text": "さて、かのミデアンびとらはエジプトでパロの役人、侍衛長ポテパルにヨセフを売った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 37:36"
    },
    "adapted": false,
    "status": "approved"
  }
}
