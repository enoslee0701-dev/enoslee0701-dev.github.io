{
  "matthew.2.p1.b1": {
    "text": "헤롯왕 때에 예수께서 유대 베들러헴에서 나시매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p1.b2": {
    "text": "동방으로부터 박사들이 예루살렘에 이르러 말하되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p1.b3": {
    "text": "유대인의 왕으로 나신 이가 어디 계시뇨",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p1.b4": {
    "text": "우리가 동방에서 그릐 별을 보고 그에게 경배하러 왔노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p2.b1": {
    "text": "헤롯왕과 … 듣고 소동한지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p2.b2": {
    "text": "온 예루살렘이 듣고 소동한지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p2.b3": {
    "text": "왕이 모든 대제사장과 백성의 서기관들을 모아",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p2.b4": {
    "text": "그리스도가 어디서 나겠느뇨",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p3.b1": {
    "text": "유대 베들레헴이오니 이는 선지자로 이렇게 기록된바",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p3.b2": {
    "text": "또 유대 땅 베들레헴아 너는 유대 고을 중에 가장 작지 아니하도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p3.b3": {
    "text": "네게서 한 다스리는 자가 나와서 내 백성 이스라엘의 목자가 되리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p4.b1": {
    "text": "이에 헤롯이 가만히 박사들을 불러 별이 나타난 때를 자세히 묻고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p4.b2": {
    "text": "가서 아기에 대하여 자세히 알아보고 찾거든 내게 고하여",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p4.b3": {
    "text": "나도 가서 그에게 경배하게 하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p5.b1": {
    "text": "박사들이 왕의 말을 듣고 갈쌔",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p5.b2": {
    "text": "동방에서 보던 그 별이 문득 앞서 인도하여 가다가",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p5.b3": {
    "text": "아기 있는 곳 위에 머물러 섰는지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p5.b4": {
    "text": "저희가 별을 보고 가장 크게 기뻐하고 기뻐하더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p6.b1": {
    "text": "집에 들어가 아기와 그 모친 마리아의 함께 있는 것을 보고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p6.b2": {
    "text": "엎드려 아기께 경배하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p6.b3": {
    "text": "보배합을 열어 황금과 유향과 몰약을 예물로 드리니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p7.b1": {
    "text": "꿈에 헤롯에게로 돌아가지 말라 지시하심을 받아",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p7.b2": {
    "text": "다른 길로 고국에 돌아가니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p7.b3": {
    "text": "저희가 떠난 후에 주의 사자가 요셉에게 현몽하여 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p7.b4": {
    "text": "헤롯이 아기를 찾아 죽이려하니 일어나 아기와 그의 모친을 데리고 애굽으로 피하여",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p8.b1": {
    "text": "요셉이 일어나서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p8.b2": {
    "text": "밤에 아기와 그의 모친을 데리고 애굽으로 떠나가",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p8.b3": {
    "text": "헤롯이 죽기까지 거기 있었으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p8.b4": {
    "text": "이는 주께서 선지자로 말씀하신바 애굽에서 내 아들을 불렀다 함을 이루려 하심이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p9.b1": {
    "text": "이에 헤롯이 박사들에게 속은 줄을 알고 심히 노하여",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p9.b2": {
    "text": "사람을 보내어 베들레헴과 그 모든 지경 안에 있는 사내아이를 … 두 살부터 그 아래로 다 죽이니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p9.b3": {
    "text": "이에 선지자 예레미야로 말씀하신바 라마에서 슬퍼하며 크게 통곡하는 소리가 들리니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:17-18"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p9.b4": {
    "text": "라헬이 그 자식을 위하여 애곡하는 것이라 그가 자식이 없으므로 위로 받기를 거절하였도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p10.b1": {
    "text": "헤롯이 죽은 후에",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p10.b2": {
    "text": "일어나 아기와 그 모친을 데리고 이스라엘 땅으로 가라 아기의 목숨을 찾던 자들이 죽었느니라 하시니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p10.b3": {
    "text": "요셉이 일어나",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p10.b4": {
    "text": "아기와 그 모친을 데리고 이스라엘 땅으로 들어오니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p11.b1": {
    "text": "그러나 아켈라오가 그 부친 헤롯을 이어 유대의 임금 됨을 듣고 거기로 가기를 무서워하더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p11.b2": {
    "text": "꿈에 지시하심을 받아 갈릴리 지방으로 떠나가",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p11.b3": {
    "text": "나사렛이란 동네에 와서 사니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.2.p11.b4": {
    "text": "이는 선지자로 하신 말씀에 나사렛 사람이라 칭하리라 하심을 이루려 함이러라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 2:23"
    },
    "adapted": false,
    "status": "approved"
  }
}
