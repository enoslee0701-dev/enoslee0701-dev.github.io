{
  "zechariah.5.p1.b1": {
    "text": "我又举目观看，见有一飞行的书卷。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Zechariah 5:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我⁠又举目观⁠看，见有⁠一飞⁠行的书⁠卷。"
  },
  "zechariah.5.p1.b2": {
    "text": "我看见一飞行的书卷，长二十肘，宽十肘。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Zechariah 5:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我看⁠见一飞⁠行的书⁠卷，长二⁠十肘，宽十肘。"
  },
  "zechariah.5.p1.b3": {
    "text": "我必使这书卷出去……连房屋带木石都毁灭了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Zechariah 5:4"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我必使这书⁠卷出⁠去……连房⁠屋带木⁠石都毁⁠灭了。"
  },
  "zechariah.5.p1.b4": {
    "text": "这是罪恶。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Zechariah 5:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "这是罪⁠恶。"
  },
  "zechariah.5.p1.b5": {
    "text": "她们要将量器抬到哪里去呢？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Zechariah 5:10"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "她⁠们要将量器抬到哪⁠里去呢？"
  },
  "zechariah.5.p1.b6": {
    "text": "要往示拿地去，为它盖造房屋；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Zechariah 5:11"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "要往示拿地去，为它盖⁠造房⁠屋；"
  }
}
