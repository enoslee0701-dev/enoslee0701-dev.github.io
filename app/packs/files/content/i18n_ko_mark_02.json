{
  "mark.2.p1.b1": {
    "text": "수일 후에 예수께서 다시 가버나움에 들어가시니 집에 계신 소문이 들린지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p1.b2": {
    "text": "많은 사람이 모여서 문 앞에라도 용신할 수 없게 되었는데",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p1.b3": {
    "text": "예수께서 저희에게 도를 말씀하시더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p1.b4": {
    "text": "사람들이 한 중풍병자를 네 사람에게 메워 가지고 예수께로 올새",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p2.b1": {
    "text": "무리를 인하여 예수께 데려갈 수 없으므로",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p2.b2": {
    "text": "그 계신 곳의 지붕을 뜯어 구멍을 내고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p2.b3": {
    "text": "중풍병자의 누운 상을 달아내리니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p2.b4": {
    "text": "예수께서 저희의 믿음을 보시고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p2.b5": {
    "text": "중풍병자에게 이르시되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p2.b6": {
    "text": "소자야 네 죄 사함을 받았느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p3.b1": {
    "text": "어떤 서기관들이 거기 앉아서 마음에 의논하기를",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p3.b2": {
    "text": "이 사람이 어찌 이렇게 말하는가",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p3.b3": {
    "text": "참람하도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p3.b4": {
    "text": "오직 하나님 한 분 외에는 누가 능히 죄를 사하겠느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p3.b5": {
    "text": "저희가 속으로 이렇게 의논하는 줄을 예수께서 곧 중심에 아시고 이르시되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p3.b6": {
    "text": "어찌하여 이것을 마음에 의논하느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p3.b7": {
    "text": "중풍병자에게 네 죄 사함을 받았느니라 하는 말과",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p3.b8": {
    "text": "일어나 네 상을 가지고 걸어가라 하는 말이 어느 것이 쉽겠느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p4.b1": {
    "text": "그러나 인자가 땅에서 죄를 사하는 권세가 있는 줄을 너희로 알게 하려하노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p4.b2": {
    "text": "중풍병자에게 말씀하시되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p4.b3": {
    "text": "내가 네게 이르노니 일어나 네 상을 가지고 집으로 가라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p4.b4": {
    "text": "그가 일어나 곧 상을 가지고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p4.b5": {
    "text": "모든 사람 앞에서 나가거늘",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p4.b6": {
    "text": "저희가 다 놀라 영광을 하나님께 돌리며 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p4.b7": {
    "text": "우리가 이런 일을 도무지 보지 못하였다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p5.b1": {
    "text": "또 지나가시다가 알패오의 아들 레위가 세관에 앉아 있는 것을 보시고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p5.b2": {
    "text": "나를 좇으라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p5.b3": {
    "text": "일어나 좇으니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p6.b1": {
    "text": "그의 집에 앉아 잡수실 때에 많은 세리와 죄인들이 예수와 그 제자들과 함께 앉았으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p6.b2": {
    "text": "바리새인의 서기관들이 예수께서 죄인과 세리들과 함께 잡수시는 것을 보고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p7.b1": {
    "text": "어찌하여 세리와 죄인들과 함께 먹는가",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p7.b2": {
    "text": "건강한 자에게는 의원이 쓸데 없고 병든 자에게라야 쓸데 있느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p7.b3": {
    "text": "내가 의인을 부르러 온것이 아니요 죄인을 부르러 왔노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p8.b1": {
    "text": "요한의 제자들과 바리새인들이 금식하고 있는지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p8.b2": {
    "text": "요한의 제자들과 바리새인의 제자들은 금식하는데",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p8.b3": {
    "text": "어찌하여 당신의 제자들은 금식하지 아니하나이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p9.b1": {
    "text": "혼인집 손님들이 신랑과 함께 있을 때에 금식할 수 있느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p9.b2": {
    "text": "그러나 신랑을 빼앗길 날이 이르리니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p9.b3": {
    "text": "그 날에는 금식할 것이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p10.b1": {
    "text": "생베 조각을 낡은 옷에 붙이는 자가 없나니…해어짐이 더하게 되느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p10.b2": {
    "text": "새 포도주를 낡은 가죽 부대에 넣는 자가 없나니…포도주와 부대를 버리게 되리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p10.b3": {
    "text": "오직 새 포도주는 새 부대에 넣느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p11.b1": {
    "text": "안식일에 예수께서 밀밭 사이로 지나가실새",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p11.b2": {
    "text": "보시오 저희가 어찌하여 안식일에 하지 못할 일을 하나이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p12.b1": {
    "text": "다윗이 자기와 및 함께한 자들이 핍절되어 시장할 때에 한 일을 읽지 못하였느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p12.b2": {
    "text": "그가…하나님의 전에 들어가서…진설병을 먹고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p12.b3": {
    "text": "함께한 자들에게도 주지 아니하였느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p12.b4": {
    "text": "제사장 외에는 먹지 못하는",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p13.b1": {
    "text": "안식일은 사람을 위하여 있는 것이요 사람이 안식일을 위하여 있는 것이 아니니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.2.p13.b2": {
    "text": "이러므로 인자는 안식일에도 주인이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 2:28"
    },
    "adapted": false,
    "status": "approved"
  }
}
