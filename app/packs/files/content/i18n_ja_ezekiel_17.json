{
  "ezekiel.17.p1.b1": {
    "text": "人の子よ、イスラエルの家になぞをかけ、たとえを語って",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 17:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.17.p1.b2": {
    "text": "さまざまの色の羽毛を多く持ち、大きな翼と、長い羽根とを持つ大わしがレバノンに来て、香柏のこずえにとまり",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 17:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.17.p1.b3": {
    "text": "その若枝の頂を摘み切り、これを商業の地に運び、商人の町に置いた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 17:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.17.p1.b4": {
    "text": "これが成長して、たけ低く、はびこるぶどうの木となり、枝はわしに向かい",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 17:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.17.p1.b5": {
    "text": "このぶどうの木は、潤いを得るために、その根をわしに向かってまげ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 17:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.17.p1.b6": {
    "text": "東風がこれを打つ時、それは枯れてしまわないであろうか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 17:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.17.p2.b1": {
    "text": "また王の子孫のひとりを捕えて、これと契約を結び、誓いを立てさせ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 17:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.17.p2.b2": {
    "text": "使者をエジプトに送って、馬と多くの兵とをそこから獲ようとした。彼は成功するだろうか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 17:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.17.p2.b3": {
    "text": "わたしはわが網を彼の上に打ちかけ、彼をわがわなに捕えて",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 17:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.17.p2.b4": {
    "text": "わたしはまた香柏の高いこずえから小枝をとって、これを植え、…これを高いすぐれた山に植える。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 17:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.17.p2.b5": {
    "text": "これは枝を出し、実を結び、みごとな香柏となり、…その枝の陰に各種の鳥が巣をつくる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 17:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.17.p2.b6": {
    "text": "主なるわたしが高い木を低くし、低い木を高くし、緑の木を枯らし、枯れ木を緑にすることを知るようになる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 17:24"
    },
    "adapted": false,
    "status": "approved"
  }
}
