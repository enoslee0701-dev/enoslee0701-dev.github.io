{
  "kings1.19.p1.b1": {
    "text": "アハブはエリヤのしたすべての事、また彼がすべての預言者を刀で殺したことをイゼベルに告げたので、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 19:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.19.p1.b2": {
    "text": "「もしわたしが、あすの今ごろ、あなたの命をあの人々のひとりの命のようにしていないならば、神々がどんなにでも、わたしを罰してくださるように」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 19:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.19.p1.b3": {
    "text": "そこでエリヤは恐れて、自分の命を救うために立って逃げ、ユダに属するベエルシバへ行って、しもべをそこに残し、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 19:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.19.p2.b1": {
    "text": "自分は一日の道のりほど荒野にはいって行って、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 19:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.19.p2.b2": {
    "text": "れだまの木の下に座し、自分の死を求めて言った、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 19:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.19.p2.b3": {
    "text": "「主よ、もはや、じゅうぶんです。今わたしの命を取ってください。わたしは先祖にまさる者ではありません」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 19:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.19.p3.b1": {
    "text": "「起きて食べなさい」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 19:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.19.p3.b2": {
    "text": "「起きて食べなさい。道が遠くて耐えられないでしょうから」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 19:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.19.p3.b3": {
    "text": "彼は起きて食べ、かつ飲み、その食物で力づいて四十日四十夜行って、神の山ホレブに着いた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 19:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.19.p4.b1": {
    "text": "その所で彼はほら穴にはいって、そこに宿ったが、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 19:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.19.p4.b2": {
    "text": "「エリヤよ、あなたはここで何をしているのか」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 19:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.19.p4.b3": {
    "text": "「わたしは万軍の神、主のために非常に熱心でありました。イスラエルの人々はあなたの契約を捨て、あなたの祭壇をこわし、刀をもってあなたの預言者たちを殺したのです…」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 19:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.19.p4.b4": {
    "text": "「…ただわたしだけ残りましたが、彼らはわたしの命を取ろうとしています」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 19:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.19.p5.b1": {
    "text": "「出て、山の上で主の前に、立ちなさい」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 19:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.19.p5.b2": {
    "text": "主の前に大きな強い風が吹き、山を裂き、岩を砕いた。しかし主は風の中におられなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 19:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.19.p5.b3": {
    "text": "風の後に地震があったが、地震の中にも主はおられなかった。地震の後に火があったが、火の中にも主はおられなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 19:11-12"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.19.p5.b4": {
    "text": "火の後に静かな細い声が聞えた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 19:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.19.p6.b1": {
    "text": "エリヤはそれを聞いて顔を外套に包み、出てほら穴の口に立つと、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 19:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.19.p6.b2": {
    "text": "彼に語る声が聞えた、「エリヤよ、あなたはここで何をしているのか」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 19:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.19.p6.b3": {
    "text": "「わたしは万軍の神、主のために非常に熱心でありました。…ただわたしだけ残りましたが、彼らはわたしの命を取ろうとしています」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 19:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.19.p7.b1": {
    "text": "「あなたの道を帰って行って、ダマスコの荒野におもむき、ダマスコに着いて、ハザエルに油を注ぎ、スリヤの王としなさい。」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 19:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.19.p7.b2": {
    "text": "またニムシの子エヒウに油を注いでイスラエルの王としなさい。またアベルメホラのシャパテの子エリシャに油を注いで、あなたに代って預言者としなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 19:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.19.p7.b3": {
    "text": "また、わたしはイスラエルのうちに七千人を残すであろう。皆バアルにひざをかがめず、それに口づけしない者である」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 19:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.19.p8.b1": {
    "text": "さてエリヤはそこを去って行って、シャパテの子エリシャに会った。彼は十二くびきの牛を前に行かせ、自分は十二番目のくびきと共にいて耕していた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 19:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.19.p8.b2": {
    "text": "エリヤは彼のかたわらを通り過ぎて外套を彼の上にかけた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 19:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.19.p8.b3": {
    "text": "「わたしの父母に口づけさせてください。そして後あなたに従いましょう」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 19:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.19.p8.b4": {
    "text": "「行ってきなさい。わたしはあなたに何をしましたか」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 19:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.19.p8.b5": {
    "text": "エリシャは彼を離れて帰り、ひとくびきの牛を取って殺し、牛のくびきを燃やしてその肉を煮、それを民に与えて食べさせ、立って行ってエリヤに従い、彼に仕えた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 19:21"
    },
    "adapted": false,
    "status": "approved"
  }
}
