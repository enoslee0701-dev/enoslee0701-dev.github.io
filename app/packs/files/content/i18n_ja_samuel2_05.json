{
  "samuel2.5.p1.b1": {
    "text": "われわれは、あなたの骨肉です。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 5:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p1.b2": {
    "text": "そして主はあなたに、『あなたはわたしの民イスラエルを牧するであろう。またあなたはイスラエルの君となるであろう』と言われました。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 5:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p1.b3": {
    "text": "このようにイスラエルの長老たちが皆、ヘブロンにいる王のもとにきたので、…そして彼らはダビデに油を注いでイスラエルの王とした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 5:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p1.b4": {
    "text": "ダビデは王となったとき三十歳で、四十年の間、世を治めた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 5:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p2.b1": {
    "text": "王とその従者たちとはエルサレムへ行って、その地の住民エブスびとを攻めた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 5:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p2.b2": {
    "text": "あなたはけっして、ここに攻め入ることはできない。かえって、めしいや足なえでも、あなたを追い払うであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 5:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p2.b3": {
    "text": "だれでもエブスびとを撃とうとする人は、水をくみ上げる縦穴を上って行って、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 5:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p3.b1": {
    "text": "ところがダビデはシオンの要害を取った。これがダビデの町である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 5:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p3.b2": {
    "text": "こうしてダビデはますます大いなる者となり、かつ万軍の神、主が彼と共におられた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 5:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p4.b1": {
    "text": "ツロの王ヒラムはダビデに使者をつかわして、香柏および大工と石工を送った。彼らはダビデのために家を建てた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 5:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p4.b2": {
    "text": "そしてダビデは主が自分を堅く立ててイスラエルの王とされたこと、主がその民イスラエルのためにその王国を興されたことを悟った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 5:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p5.b1": {
    "text": "ダビデはヘブロンからきて後、さらにエルサレムで妻とそばめを入れたので、むすこと娘がまたダビデに生れた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 5:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p5.b2": {
    "text": "エルサレムで彼に生れた者の名は次のとおりである。シャンムア、ショバブ、ナタン、ソロモン、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 5:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p6.b1": {
    "text": "さてペリシテびとは、ダビデが油を注がれてイスラエルの王になったことを聞き、みな上ってきてダビデを捜したが、…ペリシテびとはきて、レパイムの谷に広がっていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 5:17-18"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p6.b2": {
    "text": "ペリシテびとに向かって上るべきでしょうか。あなたは彼らをわたしの手に渡されるでしょうか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 5:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p6.b3": {
    "text": "上るがよい。わたしはかならずペリシテびとをあなたの手に渡すであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 5:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p6.b4": {
    "text": "主は、破り出る水のように、敵をわたしの前に破られた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 5:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p7.b1": {
    "text": "ペリシテびとが、ふたたび上ってきて、レパイムの谷に広がったので、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 5:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p7.b2": {
    "text": "上ってはならない。彼らのうしろに回り、バルサムの木の前から彼らを襲いなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 5:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p7.b3": {
    "text": "バルサムの木の上に行進の音が聞えたならば、あなたは奮い立たなければならない。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 5:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p7.b4": {
    "text": "ダビデは、主が命じられたようにして、ペリシテびとを撃ち、ゲバからゲゼルに及んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 5:25"
    },
    "adapted": false,
    "status": "approved"
  }
}
