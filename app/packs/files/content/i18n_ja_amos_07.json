{
  "amos.7.p1.b1": {
    "text": "主なる神はこのようにわたしに示された。見よ、二番草のはえ出る初めに主は、いなごを造られた。見よ、その二番草は王の刈った後に、はえたものである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Amos 7:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.7.p1.b2": {
    "text": "「主なる神よ、どうぞ、ゆるしてください。ヤコブは小さい者です、どうして立つことができましょう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Amos 7:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.7.p1.b3": {
    "text": "「このことは起さない」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Amos 7:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.7.p1.b4": {
    "text": "「主なる神よ、どうぞ、やめてください。ヤコブは小さい者です、どうして立つことができましょう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Amos 7:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.7.p1.b5": {
    "text": "「このこともまた起さない」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Amos 7:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.7.p1.b6": {
    "text": "「アモスよ、あなたは何を見るか」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Amos 7:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.7.p1.b7": {
    "text": "「測りなわ」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Amos 7:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.7.p1.b8": {
    "text": "「見よ、わたしは測りなわをわが民イスラエルの中に置く。わたしはもはや彼らを見過しにしない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Amos 7:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.7.p1.b9": {
    "text": "イサクの高き所は荒され、イスラエルの聖所は荒れはてる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Amos 7:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.7.p2.b1": {
    "text": "「イスラエルの家のただ中で、アモスはあなたにそむきました。この地は彼のもろもろの言葉に耐えることができません。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Amos 7:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.7.p2.b2": {
    "text": "アモスはこのように言っています、『ヤラベアムはつるぎによって死ぬ、イスラエルは必ず捕えられて行って、その国を離れる』と」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Amos 7:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.7.p2.b3": {
    "text": "「先見者よ、行ってユダの地にのがれ、かの地でパンを食べ、かの地で預言せよ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Amos 7:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.7.p2.b4": {
    "text": "しかしベテルでは二度と預言してはならない。ここは王の聖所、国の宮だから」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Amos 7:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.7.p2.b5": {
    "text": "「わたしは預言者でもなく、また預言者の子でもない。わたしは牧者である。わたしはいちじく桑の木を作る者である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Amos 7:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.7.p2.b6": {
    "text": "ところが主は群れに従っている所からわたしを取り、『行って、わが民イスラエルに預言せよ』と、主はわたしに言われた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Amos 7:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.7.p2.b7": {
    "text": "それゆえ今、主の言葉を聞け。…それゆえ、主はこう言われる、『…あなたの地は測りなわで分かたれる。そしてあなたは汚れた地で死に、イスラエルは必ず捕えられて行って、その国を離れる』」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Amos 7:16-17"
    },
    "adapted": false,
    "status": "approved"
  }
}
