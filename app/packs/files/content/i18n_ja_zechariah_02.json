{
  "zechariah.2.p1.b1": {
    "text": "またわたしが目をあげて見ていると、見よ、ひとりの人が、測りなわを手に持っているので、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 2:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.2.p1.b2": {
    "text": "あなたはどこへ行くのですか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 2:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.2.p1.b3": {
    "text": "エルサレムを測って、その広さと、長さを見ようとするのです",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 2:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.2.p1.b4": {
    "text": "走って行って、あの若い人に言いなさい……エルサレムはその中に、人と家畜が多くなるので、城壁のない村里のように、人の住む所となるでしょう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 2:3-4"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.2.p1.b5": {
    "text": "主は仰せられます、わたしはその周囲で火の城壁となり、その中で栄光となる』と」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 2:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.2.p2.b1": {
    "text": "さあ、北の地から逃げて来なさい。わたしはあなたがたを、天の四方の風のように散らしたからである",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 2:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.2.p2.b2": {
    "text": "さあ、バビロンの娘と共にいる者よ、シオンにのがれなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 2:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.2.p2.b3": {
    "text": "あなたがたにさわる者は、彼の目の玉にさわる",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 2:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.2.p2.b4": {
    "text": "シオンの娘よ、喜び歌え。わたしが来て、あなたの中に住むからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 2:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.2.p2.b5": {
    "text": "その日には、多くの国民が主に連なって、わたしの民となる",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 2:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.2.p2.b6": {
    "text": "あなたは万軍の主が、わたしをあなたにつかわされたことを知る。主は聖地で、ユダを自分の分として取り、エルサレムを再び選ばれるであろう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 2:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.2.p2.b7": {
    "text": "すべて肉なる者よ、主の前に静まれ。主はその聖なるすみかから立ちあがられたからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 2:13"
    },
    "adapted": false,
    "status": "approved"
  }
}
