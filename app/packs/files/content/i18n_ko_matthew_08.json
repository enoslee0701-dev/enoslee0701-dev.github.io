{
  "matthew.8.p1.b1": {
    "text": "예수께서 산에서 내려 오시니 허다한 무리가 좇으니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p1.b2": {
    "text": "한 문둥병자가 나아와 절하고 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p1.b3": {
    "text": "주여 원하시면 저를 깨끗케 하실 수 있나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p2.b1": {
    "text": "예수께서 손을 내밀어 저에게 대시며 가라사대",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p2.b2": {
    "text": "내가 원하노니 깨끗함을 받으라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p2.b3": {
    "text": "즉시 그의 문둥병이 깨끗하여진지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p2.b4": {
    "text": "삼가 아무에게도 이르지 말고 다만 가서 제사장에게 네 몸을 보이고 모세의 명한 예물을 드려 저희에게 증거하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p3.b1": {
    "text": "예수께서 가버나움에 들어가시니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p3.b2": {
    "text": "한 백부장이 나아와 간구하여",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p3.b3": {
    "text": "가로되 주여 내 하인이 중풍병으로 집에 누워 몹시 괴로와하나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p3.b4": {
    "text": "내가 가서 고쳐 주리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p4.b1": {
    "text": "주여 내 집에 들어오심을 나는 감당치 못하겠사오니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p4.b2": {
    "text": "다만 말씀으로만 하옵소서 그러면 내 하인이 낫겠삽나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p4.b3": {
    "text": "나도 남의 수하에 있는 사람이요 내 아래도 군사가 있으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p4.b4": {
    "text": "이더러 가라 하면 가고 저더러 오라 하면 오고 내 종더러 이것을 하라 하면 하나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p5.b1": {
    "text": "예수께서 들으시고 기이히 여겨 좇는 자들에게 이르시되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p5.b2": {
    "text": "내가 진실로 너희에게 이르노니 이스라엘 중 아무에게서도 이만한 믿음을 만나보지 못하였노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p5.b3": {
    "text": "또 너희에게 이르노니 동서로부터 많은 사람이 이르러 아브라함과 이삭과 야곱과 함께 천국에 앉으려니와",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p5.b4": {
    "text": "나라의 본 자손들은 바깥 어두운 데 쫓겨나 거기서 울며 이를 갊이 있으리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p6.b1": {
    "text": "예수께서 백부장에게 이르시되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p6.b2": {
    "text": "가라 네 믿은대로 될지어다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p6.b3": {
    "text": "그 시로 하인이 나으니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p7.b1": {
    "text": "예수께서 베드로의 집에 들어가사 그의 장모가 열병으로 앓아 누운 것을 보시고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p7.b2": {
    "text": "그의 손을 만지시니 열병이 떠나가고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p7.b3": {
    "text": "여인이 일어나서 예수께 수종들더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p8.b1": {
    "text": "저물매 사람들이 귀신 들린 자를 많이 데리고 예수께 오거늘",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p8.b2": {
    "text": "예수께서 말씀으로 귀신들을 쫓아 내시고 병든 자를 다 고치시니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p8.b3": {
    "text": "이는 선지자 이사야로 하신 말씀에 우리 연약한 것을 친히 담당하시고 병을 짊어지셨도다 함을 이루려 하심이더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p9.b1": {
    "text": "선생님이여 어디로 가시든지 저는 좇으리이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p9.b2": {
    "text": "여우도 굴이 있고 공중의 새도 거처가 있으되 오직 인자는 머리 둘 곳이 없다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p9.b3": {
    "text": "주여 나로 먼저 가서 내 부친을 장사하게 허락하옵소서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p9.b4": {
    "text": "죽은 자들로 저희 죽은 자를 장사하게 하고 너는 나를 좇으라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p10.b1": {
    "text": "배에 오르시매 제자들이 좇았더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p10.b2": {
    "text": "바다에 큰 놀이 일어나 물결이 배에 덮이게 되었으되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p10.b3": {
    "text": "예수는 주무시는지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p10.b4": {
    "text": "주여 구원하소서 우리가 죽겠나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p11.b1": {
    "text": "어찌하여 무서워하느냐 믿음이 적은 자들아",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p11.b2": {
    "text": "곧 일어나사 바람과 바다를 꾸짖으신대",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p11.b3": {
    "text": "아주 잔잔하게 되거늘",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p11.b4": {
    "text": "이 어떠한 사람이기에 바람과 바다도 순종하는고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p12.b1": {
    "text": "또 예수께서 건너편 가다라 지방에 가시매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p12.b2": {
    "text": "귀신 들린 자 둘이 무덤 사이에서 나와 예수를 만나니 저희는 심히 사나와",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p12.b3": {
    "text": "아무도 그 길로 지나갈 수 없을 만하더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p12.b4": {
    "text": "하나님의 아들이여 우리와 당신과 무슨 상관이 있나이까 때가 이르기 전에 우리를 괴롭게 하려고 여기 오셨나이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p13.b1": {
    "text": "마침 멀리서 많은 돼지 떼가 먹고 있는지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p13.b2": {
    "text": "만일 우리를 쫓아 내실진대 돼지 떼에 들여 보내소서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p13.b3": {
    "text": "저희더러 가라 하시니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p13.b4": {
    "text": "귀신들이 나와서 돼지에게로 들어가는지라 온 떼가 비탈로 내리달아 바다에 들어가서 물에서 몰사하거늘",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p14.b1": {
    "text": "치던 자들이 달아나 시내에 들어가 이 모든 일과 귀신들린 자의 일을 고하니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p14.b2": {
    "text": "온 시내가 예수를 만나려고 나가서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p14.b3": {
    "text": "보고 그 지방에서 떠나시기를 간구하더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 8:34"
    },
    "adapted": false,
    "status": "approved"
  }
}
