{
  "matthew.15.p1.b1": {
    "text": "그 때에 바리새인과 서기관들이 예루살렘으로부터 예수께 나아와 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p1.b2": {
    "text": "당신의 제자들이 어찌하여 장로들의 유전을 범하나이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p1.b3": {
    "text": "떡 먹을 때에 손을 씻지 아니하나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p2.b1": {
    "text": "너희는 어찌하여 너희 유전으로 하나님의 계명을 범하느뇨",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p2.b2": {
    "text": "하나님이 이르셨으되 네 부모를 공경하라 하시고 또 아비나 어미를 훼방하는 자는 반드시 죽으리라 하셨거늘",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p2.b3": {
    "text": "너희는 가로되 누구든지 아비에게나 어미에게 말하기를 내가 드려 유익하게 할것이 하나님께 드림이 되었다고 하기만 하면 그 부모를 공경할 것이 없다 하여",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:5-6"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p2.b4": {
    "text": "너희 유전으로 하나님의 말씀을 폐하는도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p3.b1": {
    "text": "외식하는 자들아 이사야가 너희에게 대하여 잘 예언하였도다 일렀으되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p3.b2": {
    "text": "이 백성이 입술로는 나를 존경하되 마음은 내게서 멀도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p3.b3": {
    "text": "사람의 계명으로 교훈을 삼아 가르치니 나를 헛되이 경배하는도다 하였느니라 하시고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p4.b1": {
    "text": "무리를 불러 이르시되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p4.b2": {
    "text": "듣고 깨달으라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p4.b3": {
    "text": "입에 들어가는 것이 사람을 더럽게 하는 것이 아니라 입에서 나오는 그것이 사람을 더럽게 하는 것이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p4.b4": {
    "text": "바리새인들이 이 말씀을 듣고 걸림이 된줄 아시나이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p5.b1": {
    "text": "심은 것마다 내 천부께서 심으시지 않은 것은 뽑힐 것이니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p5.b2": {
    "text": "그냥 두어라 저희는 소경이되어 소경을 인도하는 자로다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p5.b3": {
    "text": "만일 소경이 소경을 인도하면 둘이 다 구덩이에 빠지리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p6.b1": {
    "text": "이 비유를 우리에게 설명하여 주옵소서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p6.b2": {
    "text": "너희도 아직까지 깨달음이 없느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p6.b3": {
    "text": "입에서 나오는 것들은 마음에서 나오나니 이것이야말로 사람을 더럽게 하느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p6.b4": {
    "text": "씻지 않은 손으로 먹는 것은 사람을 더럽게 하지 못하느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p7.b1": {
    "text": "예수께서 거기서 나가사 두로와 시돈 지방으로 들어가시니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p7.b2": {
    "text": "가나안 여자 하나가 그 지경에서 나와서 소리질러 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p7.b3": {
    "text": "주 다윗의 자손이여 나를 불쌍히 여기소서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p7.b4": {
    "text": "내 딸이 흉악히 귀신들렸나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p8.b1": {
    "text": "예수는 한 말씀도 대답지 아니하시니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p8.b2": {
    "text": "그 여자가 우리 뒤에서 소리를 지르오니 보내소서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p8.b3": {
    "text": "나는 이스라엘 집의 잃어버린 양 외에는 다른데로 보내심을 받지 아니하였노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p9.b1": {
    "text": "여자가 와서 예수께 절하며 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p9.b2": {
    "text": "주여 저를 도우소서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p9.b3": {
    "text": "자녀의 떡을 취하여 개들에게 던짐이 마땅치 아니하니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p10.b1": {
    "text": "주여 옳소이다마는 개들도 제 주인의 상에서 떨어지는 부스러기를 먹나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p10.b2": {
    "text": "여자야 네 믿음이 크도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p10.b3": {
    "text": "네 소원대로 되리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p10.b4": {
    "text": "그 시로부터 그의 딸이 나으니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p11.b1": {
    "text": "예수께서 거기서 떠나사 갈릴리 호숫가에 이르러 산에 올라가 거기 앉으시니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p11.b2": {
    "text": "큰 무리가 절뚝발이와 불구자와 소경과 벙어리와 기타 여럿을 데리고 와서 예수의 발앞에 두매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p11.b3": {
    "text": "벙어리가 말하고 불구자가 건전하고 절뚝발이가 걸으며 소경이 보는 것을 무리가 보고 기이히 여겨",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p11.b4": {
    "text": "이스라엘의 하나님께 영광을 돌리니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p12.b1": {
    "text": "예수께서 제자들을 불러 가라사대",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p12.b2": {
    "text": "내가 무리를 불쌍히 여기노라 저희가 나와 함께 있은지 이미 사흘이매 먹을 것이 없도다 길에서 기진할까 하여 굶겨 보내지 못하겠노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p12.b3": {
    "text": "광야에 있어 우리가 어디서 이런 무리의 배부를 만큼 떡을 얻으리이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p12.b4": {
    "text": "너희에게 떡이 몇 개나 있느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p12.b5": {
    "text": "일곱개와 작은 생선 두어 마리가 있나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p13.b1": {
    "text": "예수께서 무리를 명하사 땅에 앉게 하시고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p13.b2": {
    "text": "떡 일곱 개와 그 생선을 가지사 축사하시고 떼어 제자들에게 주시니 제자들이 무리에게 주매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:36"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p13.b3": {
    "text": "다 배불리 먹고 남은 조각을 일곱 광주리에 차게 거두었으며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:37"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p14.b1": {
    "text": "먹은 자는 여자와 아이 외에 사천명이었더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p14.b2": {
    "text": "예수께서 무리를 흩어 보내시고 배에 오르사 마가단 지경에 가시니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 15:39"
    },
    "adapted": false,
    "status": "approved"
  }
}
