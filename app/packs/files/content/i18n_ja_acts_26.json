{
  "acts.26.p1.b1": {
    "text": "「おまえ自身のことを話してもよい」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 26:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.26.p1.b2": {
    "text": "そこでパウロは、手をさし伸べて、弁明をし始めた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 26:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.26.p1.b3": {
    "text": "「アグリッパ王よ、ユダヤ人たちから訴えられているすべての事に関して、きょう、あなたの前で弁明することになったのは、わたしのしあわせに思うところであります。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 26:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.26.p1.b4": {
    "text": "……わたしの申すことを、寛大なお心で聞いていただきたいのです。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 26:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.26.p2.b5": {
    "text": "……わたしは、わたしたちの宗教の最も厳格な派にしたがって、パリサイ人としての生活をしていたのです。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 26:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.26.p2.b6": {
    "text": "今わたしは、神がわたしたちの先祖に約束なさった希望をいだいているために、裁判を受けているのであります。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 26:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.26.p2.b7": {
    "text": "神が死人をよみがえらせるということが、あなたがたには、どうして信じられないことと思えるのでしょうか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 26:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.26.p3.b8": {
    "text": "わたし自身も、以前には、ナザレ人イエスの名に逆らって反対の行動をすべきだと、思っていました。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 26:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.26.p3.b9": {
    "text": "……多くの聖徒たちを獄に閉じ込め、彼らが殺される時には、それに賛成の意を表しました。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 26:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.26.p3.b10": {
    "text": "……彼らに対してひどく荒れ狂い、ついに外国の町々にまで、迫害の手をのばすに至りました。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 26:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.26.p4.b11": {
    "text": "こうして、わたしは、祭司長たちから権限と委任とを受けて、ダマスコに行ったのですが、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 26:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.26.p4.b12": {
    "text": "王よ、その途中、真昼に、光が天からさして来るのを見ました。それは、太陽よりも、もっと光り輝いて……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 26:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.26.p4.b13": {
    "text": "……『サウロ、サウロ、なぜわたしを迫害するのか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 26:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.26.p4.b14": {
    "text": "とげのあるむちをければ、傷を負うだけである』。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 26:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.26.p5.b15": {
    "text": "そこで、わたしが『主よ、あなたはどなたですか』と尋ねると、主は言われた、『わたしは、あなたが迫害しているイエスである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 26:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.26.p5.b16": {
    "text": "さあ、起きあがって、自分の足で立ちなさい。わたしがあなたに現れたのは、……これを伝える務に、あなたを任じるためである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 26:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.26.p5.b17": {
    "text": "それは、彼らの目を開き、彼らをやみから光へ、悪魔の支配から神のみもとへ帰らせ……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 26:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.26.p6.b18": {
    "text": "それですから、アグリッパ王よ、わたしは天よりの啓示にそむかず、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 26:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.26.p6.b19": {
    "text": "まず初めにダマスコにいる人々に、それからエルサレムにいる人々、さらにユダヤ全土、ならびに異邦人たちに、悔い改めて神に立ち帰り……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 26:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.26.p6.b20": {
    "text": "そのために、ユダヤ人は、わたしを宮で引き捕えて殺そうとしたのです。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 26:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.26.p7.b21": {
    "text": "しかし、わたしは今日に至るまで神の加護を受け、このように立って、小さい者にも大きい者にもあかしをなし、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 26:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.26.p7.b22": {
    "text": "預言者たちやモーセが、今後起るべきだと語ったことを、そのまま述べてきました。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 26:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.26.p7.b23": {
    "text": "すなわち、キリストが苦難を受けること、また、死人の中から最初によみがえって、この国民と異邦人とに、光を宣べ伝えるに至ることを、あかししたのです」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 26:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.26.p8.b24": {
    "text": "パウロがこのように弁明をしていると、フェストは大声で言った、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 26:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.26.p8.b25": {
    "text": "「パウロよ、おまえは気が狂っている。博学が、おまえを狂わせている」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 26:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.26.p8.b26": {
    "text": "「フェスト閣下よ、わたしは気が狂ってはいません。わたしは、まじめな真実の言葉を語っているだけです。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 26:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.26.p9.b27": {
    "text": "王はこれらのことをよく知っておられるので、王に対しても、率直に申し上げているのです。……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 26:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.26.p9.b28": {
    "text": "アグリッパ王よ、あなたは預言者を信じますか。信じておられると思います」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 26:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.26.p9.b29": {
    "text": "「おまえは少し説いただけで、わたしをクリスチャンにしようとしている」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 26:28"
    },
    "adapted": false,
    "status": "approved"
  }
}
