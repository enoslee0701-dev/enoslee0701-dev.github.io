{
  "joshua.5.p1.b1": {
    "text": "ヨルダンの向こう側、すなわち西の方におるアモリびとの王たちと、海べにおるカナンびとの王たちとは皆、主がイスラエルの人々の前で、ヨルダンの水を干しからして、…心は消え、彼らのうちに、もはや元気もなくなった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 5:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.5.p1.b2": {
    "text": "「火打石の小刀を造り、重ねてまたイスラエルの人々に割礼を行いなさい」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 5:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.5.p1.b3": {
    "text": "そこでヨシュアは火打石の小刀を造り、陽皮の丘で、イスラエルの人々に割礼を行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 5:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.5.p2.b1": {
    "text": "エジプトから出てきた民のうちの、すべての男子、すなわち、いくさびとたちは皆、エジプトを出た後、途中、荒野で死んだ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 5:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.5.p2.b2": {
    "text": "ヨシュアが割礼を行ったのは、この人々についで起されたその子どもたちであった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 5:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.5.p2.b3": {
    "text": "すべての民に割礼を行うことが終ったので、民は宿営のうちの自分の所にとどまって傷の直るのを待った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 5:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.5.p2.b4": {
    "text": "「きょう、わたしはエジプトのはずかしめを、あなたがたからころがし去った」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 5:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.5.p3.b1": {
    "text": "イスラエルの人々はギルガルに宿営していたが、その月の十四日の夕暮、エリコの平野で過越の祭を行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 5:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.5.p3.b2": {
    "text": "そして過越の祭の翌日、その地の穀物、すなわち種入れぬパンおよびいり麦を、その日に食べた",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 5:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.5.p3.b3": {
    "text": "その地の穀物を食べた翌日から、マナの降ることはやみ、イスラエルの人々は、もはやマナを獲なかった。その年はカナンの地の産物を食べた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 5:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.5.p4.b1": {
    "text": "ヨシュアがエリコの近くにいたとき、目を上げて見ると、ひとりの人が抜き身のつるぎを手に持ち、こちらに向かって立っていた",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 5:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.5.p4.b2": {
    "text": "「あなたはわれわれを助けるのですか。それともわれわれの敵を助けるのですか」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 5:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.5.p4.b3": {
    "text": "「いや、わたしは主の軍勢の将として今きたのだ」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 5:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.5.p4.b4": {
    "text": "「わが主は何をしもべに告げようとされるのですか」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 5:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.5.p5.b1": {
    "text": "「あなたの足のくつを脱ぎなさい。あなたが立っている所は聖なる所である」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 5:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.5.p5.b2": {
    "text": "ヨシュアはそのようにした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 5:15"
    },
    "adapted": false,
    "status": "approved"
  }
}
