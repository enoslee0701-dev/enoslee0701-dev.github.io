{
  "judges.17.p1.b1": {
    "text": "ここにエフライムの山地の人で、名をミカと呼ぶものがあった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 17:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.17.p1.b2": {
    "text": "あなたはかつて銀千百枚を取られたので、…その銀はわたしが持っています。わたしがそれを取ったのです",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 17:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.17.p1.b3": {
    "text": "どうぞ主がわが子を祝福されますように",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 17:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.17.p1.b4": {
    "text": "わたしはわたしの子のために一つの刻んだ像と、一つの鋳た像を造るためにその銀をわたしの手から主に献納します。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 17:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.17.p2.b1": {
    "text": "母はその銀二百枚をとって、それを銀細工人に与え、一つの刻んだ像と、一つの鋳た像を造らせた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 17:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.17.p2.b2": {
    "text": "このミカという人は神の宮をもち、エポデとテラピムを造り、その子のひとりを立てて、自分の祭司とした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 17:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.17.p2.b3": {
    "text": "そのころイスラエルには王がなかったので、人々はおのおの自分たちの目に正しいと思うことを行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 17:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.17.p3.b1": {
    "text": "さてここにユダの氏族のもので、ユダのベツレヘムからきたひとりの若者があった。彼はレビびとであって、…この人は自分の住むべきところを尋ねて",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 17:7-8"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.17.p3.b2": {
    "text": "あなたはどこからおいでになりましたか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 17:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.17.p3.b3": {
    "text": "わたしはユダのベツレヘムのレビびとですが、住むべきところを尋ねて旅をしているのです",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 17:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.17.p3.b4": {
    "text": "わたしと一緒にいて、わたしのために父とも祭司ともなってください。そうすれば年に銀十枚と衣服ひとそろいと食物とをさしあげましょう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 17:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.17.p4.b1": {
    "text": "レビびとはついにその人と一緒に住むことを承諾した。そしてその若者は彼の子のひとりのようになった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 17:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.17.p4.b2": {
    "text": "ミカはレビびとであるこの若者を立てて自分の祭司としたので、彼はミカの家にいた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 17:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.17.p4.b3": {
    "text": "今わたしはレビびとを祭司に持つようになったので、主がわたしをお恵みくださることがわかりました",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 17:13"
    },
    "adapted": false,
    "status": "approved"
  }
}
