{
  "samuel1.3.p1.b1": {
    "text": "童子撒母耳在以利面前事奉耶和华。当那些日子，耶和华的言语稀少，不常有默示。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "1 Samuel 3:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "童⁠子撒母耳在以利面⁠前事奉耶⁠和⁠华。当那⁠些日⁠子，耶⁠和⁠华的言⁠语稀⁠少，不常⁠有默示。"
  },
  "samuel1.3.p1.b2": {
    "text": "一日，以利睡卧在自己的地方；他眼目昏花，看不分明。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "1 Samuel 3:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "一⁠日，以利睡卧⁠在自⁠己的地⁠方；他眼⁠目昏⁠花，看⁠不分⁠明。"
  },
  "samuel1.3.p1.b3": {
    "text": "神的灯在　神耶和华殿内约柜那里，还没有熄灭，撒母耳已经睡了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "1 Samuel 3:3"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "神的灯在　神耶⁠和⁠华殿⁠内约柜那⁠里，还没⁠有熄⁠灭，撒母耳已⁠经睡⁠了。"
  },
  "samuel1.3.p2.b1": {
    "text": "耶和华呼唤撒母耳。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "1 Samuel 3:4"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠和⁠华呼⁠唤撒母耳。"
  },
  "samuel1.3.p2.b2": {
    "text": "我在这里！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "1 Samuel 3:4"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我⁠在这⁠里！"
  },
  "samuel1.3.p2.b3": {
    "text": "你呼唤我？我在这里。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "1 Samuel 3:5"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你呼⁠唤我？我⁠在这⁠里。"
  },
  "samuel1.3.p2.b4": {
    "text": "我没有呼唤你，你去睡吧。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "1 Samuel 3:5"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我没⁠有呼⁠唤你，你去睡吧。"
  },
  "samuel1.3.p3.b1": {
    "text": "耶和华又呼唤撒母耳。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "1 Samuel 3:6"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠和⁠华又呼⁠唤撒母耳。"
  },
  "samuel1.3.p3.b2": {
    "text": "我的儿，我没有呼唤你，你去睡吧。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "1 Samuel 3:6"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我⁠的儿，我没⁠有呼⁠唤你，你去睡吧。"
  },
  "samuel1.3.p3.b3": {
    "text": "那时撒母耳还未认识耶和华，也未得耶和华的默示。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "1 Samuel 3:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "那⁠时撒母耳还未认⁠识耶⁠和⁠华，也未⁠得耶⁠和⁠华的默示。"
  },
  "samuel1.3.p4.b1": {
    "text": "耶和华第三次呼唤撒母耳。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "1 Samuel 3:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠和⁠华第⁠三⁠次呼⁠唤撒母耳。"
  },
  "samuel1.3.p4.b2": {
    "text": "你又呼唤我？我在这里。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "1 Samuel 3:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你又呼⁠唤我？我⁠在这⁠里。"
  },
  "samuel1.3.p4.b3": {
    "text": "以利才明白是耶和华呼唤童子。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "1 Samuel 3:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "以利才明⁠白是耶⁠和⁠华呼⁠唤童⁠子。"
  },
  "samuel1.3.p4.b4": {
    "text": "你仍去睡吧；若再呼唤你，你就说：『耶和华啊，请说，仆人敬听！』",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "1 Samuel 3:9"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你仍去睡吧；若再呼⁠唤你，你就说：『耶⁠和⁠华啊，请说，仆⁠人敬听！』"
  },
  "samuel1.3.p5.b1": {
    "text": "耶和华又来站着，像前三次呼唤说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "1 Samuel 3:10"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠和⁠华又来站着，像前三⁠次呼⁠唤说："
  },
  "samuel1.3.p5.b2": {
    "text": "撒母耳啊！撒母耳啊！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "1 Samuel 3:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.3.p5.b3": {
    "text": "请说，仆人敬听！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "1 Samuel 3:10"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "请说，仆⁠人敬听！"
  },
  "samuel1.3.p6.b1": {
    "text": "我在以色列中必行一件事，叫听见的人都必耳鸣。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "1 Samuel 3:11"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我⁠在以⁠色⁠列中必行一⁠件⁠事，叫听⁠见的人都必耳⁠鸣。"
  },
  "samuel1.3.p6.b2": {
    "text": "我指着以利家所说的话，到了时候，我必始终应验在以利身上。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "1 Samuel 3:12"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我指着以利⁠家所说的⁠话，到⁠了时⁠候，我必始⁠终应验在以利身⁠上。"
  },
  "samuel1.3.p6.b3": {
    "text": "……因他知道儿子作孽，自招咒诅，却不禁止他们。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "1 Samuel 3:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "……因他知⁠道儿⁠子作⁠孽，自招咒诅，却不禁⁠止他⁠们。"
  },
  "samuel1.3.p6.b4": {
    "text": "撒母耳睡到天亮，就开了耶和华的殿门，不敢将默示告诉以利。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "1 Samuel 3:15"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "撒母耳睡⁠到天⁠亮，就开了耶⁠和⁠华的殿门，不⁠敢将默示告⁠诉以利。"
  },
  "samuel1.3.p7.b1": {
    "text": "我儿撒母耳啊！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "1 Samuel 3:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.3.p7.b2": {
    "text": "耶和华对你说什么，你不要向我隐瞒……",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "1 Samuel 3:17"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠和⁠华对你说什⁠么，你不⁠要向我隐⁠瞒……"
  },
  "samuel1.3.p7.b3": {
    "text": "这是出于耶和华，愿他凭自己的意旨而行。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "1 Samuel 3:18"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "这是出⁠于耶⁠和⁠华，愿他凭自⁠己的意⁠旨而行。"
  },
  "samuel1.3.p7.b4": {
    "text": "从但到别是巴所有的以色列人都知道耶和华立撒母耳为先知。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "1 Samuel 3:20"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "从但到别是巴所⁠有的以⁠色列⁠人都知⁠道耶⁠和⁠华立撒母耳为先⁠知。"
  }
}
