{
  "ezekiel.18.p1.b1": {
    "text": "父たちが、酢いぶどうを食べたので子供たちの歯がうく",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 18:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.18.p1.b2": {
    "text": "見よ、すべての魂はわたしのものである。…罪を犯した魂は必ず死ぬ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 18:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.18.p1.b3": {
    "text": "食物を飢えた者に与え、裸の者に衣服を着せ、…彼は正しい人である。彼は必ず生きることができる",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 18:7-9"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.18.p1.b4": {
    "text": "その子は生きるであろうか。彼は生きることはできない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 18:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.18.p1.b5": {
    "text": "彼はその父の悪のために死なず、必ず生きる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 18:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.18.p2.b1": {
    "text": "主のおこないは正しくない",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 18:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.18.p2.b2": {
    "text": "イスラエルの家よ、聞け。わたしのおこないは正しくないのか。正しくないのは、あなたがたのおこないではないか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 18:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.18.p2.b3": {
    "text": "悪人がもしその行ったもろもろの罪を離れ、…彼は必ず生きる。死ぬことはない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 18:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.18.p2.b4": {
    "text": "あなたがたがわたしに対しておこなったすべてのとがを捨て去り、新しい心と、新しい霊とを得よ。イスラエルの家よ、あなたがたはどうして死んでよかろうか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 18:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.18.p2.b5": {
    "text": "わたしは何人との死をも喜ばないのである … それゆえ、あなたがたは翻って生きよ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 18:32"
    },
    "adapted": false,
    "status": "approved"
  }
}
