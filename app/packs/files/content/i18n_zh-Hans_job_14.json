{
  "job.14.p1.b1": {
    "text": "人为妇人所生，日子短少，多有患难；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Job 14:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "人⁠为妇⁠人所⁠生，日⁠子短⁠少，多有患⁠难；"
  },
  "job.14.p1.b2": {
    "text": "出来如花，又被割下，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Job 14:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "出⁠来如⁠花，又被割⁠下，"
  },
  "job.14.p1.b3": {
    "text": "飞去如影，不能存留。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Job 14:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "飞⁠去如影，不⁠能存⁠留。"
  },
  "job.14.p1.b4": {
    "text": "谁能使洁净之物出于污秽之中呢？无论谁也不能！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Job 14:4"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "谁⁠能使洁⁠净之物出⁠于污⁠秽之⁠中呢？无⁠论谁也⁠不⁠能！"
  },
  "job.14.p1.b5": {
    "text": "便求你转眼不看他，使他得歇息，直等他像雇工人完毕他的日子。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Job 14:6"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "便求你转⁠眼不⁠看他，使他得歇⁠息，直等他像雇⁠工人完⁠毕他⁠的日⁠子。"
  },
  "job.14.p2.b1": {
    "text": "树若被砍下，还可指望发芽，嫩枝生长不息；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Job 14:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "树若被砍⁠下，还可指⁠望发⁠芽，嫩枝生⁠长不⁠息；"
  },
  "job.14.p2.b2": {
    "text": "及至得了水气，还要发芽，又长枝条，像新栽的树一样。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Job 14:9"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "及⁠至得⁠了水⁠气，还要发⁠芽，又长枝条，像新栽的树一⁠样。"
  },
  "job.14.p2.b3": {
    "text": "人若死了岂能再活呢？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Job 14:14"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "人若死⁠了岂能再活呢？"
  },
  "job.14.p2.b4": {
    "text": "水流消磨石头……你也照样灭绝人的指望。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Job 14:19"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "水⁠流消⁠磨石⁠头……你也照⁠样灭⁠绝人⁠的指⁠望。"
  },
  "job.14.p2.b5": {
    "text": "但知身上疼痛，心中悲哀。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Job 14:22"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "但知身⁠上疼⁠痛，心⁠中悲⁠哀。"
  }
}
