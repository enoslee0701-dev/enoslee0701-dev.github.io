{
  "acts.22.p1.b1": {
    "text": "「兄弟たち、父たちよ、いま申し上げるわたしの弁明を聞いていただきたい」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p1.b2": {
    "text": "パウロが、ヘブル語でこう語りかけるのを聞いて、人々はますます静粛になった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p1.b3": {
    "text": "「わたしはキリキヤのタルソで生れたユダヤ人であるが、この都で育てられ、ガマリエルのひざもとで先祖伝来の律法について、きびしい薫陶を受け、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p1.b4": {
    "text": "今日の皆さんと同じく神に対して熱心な者であった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p2.b5": {
    "text": "そして、この道を迫害し、男であれ女であれ、縛りあげて獄に投じ、彼らを死に至らせた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p2.b6": {
    "text": "このことは、大祭司も長老たち一同も、証明するところである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p2.b7": {
    "text": "さらにわたしは、この人たちからダマスコの同志たちへあてた手紙をもらって、その地にいる者たちを縛りあげ、エルサレムにひっぱってきて、処罰するため、出かけて行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p3.b8": {
    "text": "旅をつづけてダマスコの近くにきた時に、真昼ごろ、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p3.b9": {
    "text": "突然、つよい光が天からわたしをめぐり照した。 わたしは地に倒れた。そして、『サウロ、サウロ、なぜわたしを迫害するのか』と、呼びかける声を聞いた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:6-7"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p3.b10": {
    "text": "これに対してわたしは、『主よ、あなたはどなたですか』と言った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p3.b11": {
    "text": "すると、その声が、『わたしは、あなたが迫害しているナザレ人イエスである』と答えた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p4.b12": {
    "text": "わたしと一緒にいた者たちは、その光は見たが、わたしに語りかけたかたの声は聞かなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p4.b13": {
    "text": "わたしが『主よ、わたしは何をしたらよいでしょうか』と尋ねたところ、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p4.b14": {
    "text": "主は言われた、『起きあがってダマスコに行きなさい。そうすれば、あなたがするように決めてある事が、すべてそこで告げられるであろう』。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p4.b15": {
    "text": "わたしは、光の輝きで目がくらみ、何も見えなくなっていたので、連れの者たちに手を引かれながら、ダマスコに行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p5.b16": {
    "text": "すると、律法に忠実で、ダマスコ在住のユダヤ人全体に評判のよいアナニヤという人が、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p5.b17": {
    "text": "わたしのところにきて、そばに立ち、『兄弟サウロよ、見えるようになりなさい』と言った。するとその瞬間に、わたしの目が開いて、彼の姿が見えた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p5.b18": {
    "text": "彼は言った、『わたしたちの先祖の神が、あなたを選んでみ旨を知らせ、… それはあなたが、その見聞きした事につき、すべての人に対して、彼の証人になるためである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:14-15"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p5.b19": {
    "text": "そこで今、なんのためらうことがあろうか。すぐ立って、み名をとなえてバプテスマを受け、あなたの罪を洗い落しなさい』。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p6.b20": {
    "text": "それからわたしは、エルサレムに帰って宮で祈っているうちに、夢うつつになり、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p6.b21": {
    "text": "主にまみえたが、主は言われた、『急いで、すぐにエルサレムを出て行きなさい。わたしについてのあなたのあかしを、人々が受けいれないから』。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p6.b22": {
    "text": "そこで、わたしが言った、『主よ、彼らは、わたしがいたるところの会堂で、あなたを信じる人々を獄に投じたり、むち打ったりしていたことを、知っています。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p6.b23": {
    "text": "また、あなたの証人ステパノの血が流された時も、わたしは立ち合っていてそれに賛成し、また彼を殺した人たちの上着の番をしていたのです』。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p7.b24": {
    "text": "すると、主がわたしに言われた、『行きなさい。わたしが、あなたを遠く異邦の民へつかわすのだ』」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p7.b25": {
    "text": "「こんな男は地上から取り除いてしまえ。生かしおくべきではない」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p7.b26": {
    "text": "人々がこうわめき立てて、空中に上着を投げ、ちりをまき散らす始末であったので、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p8.b27": {
    "text": "千卒長はパウロを兵営に引き入れるように命じ、… 彼をむちの拷問にかけて、取り調べるように言いわたした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p8.b28": {
    "text": "彼らがむちを当てるため、彼を縛りつけていた時、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p8.b29": {
    "text": "「ローマの市民たる者を、裁判にかけもしないで、むち打ってよいのか」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p9.b30": {
    "text": "「どうなさいますか。あの人はローマの市民なのです」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p9.b31": {
    "text": "「わたしに言ってくれ。あなたはローマの市民なのか」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p9.b32": {
    "text": "「そうです」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p9.b33": {
    "text": "「わたしはこの市民権を、多額の金で買い取ったのだ」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p9.b34": {
    "text": "「わたしは生れながらの市民です」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p10.b35": {
    "text": "翌日、彼は、ユダヤ人がなぜパウロを訴え出たのか、その真相を知ろうと思って彼を解いてやり、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p10.b36": {
    "text": "同時に祭司長たちと全議会とを召集させ、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.22.p10.b37": {
    "text": "そこに彼を引き出して、彼らの前に立たせた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 22:30"
    },
    "adapted": false,
    "status": "approved"
  }
}
