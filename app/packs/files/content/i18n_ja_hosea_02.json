{
  "hosea.2.p1.b1": {
    "text": "あなたがたの兄弟に向かっては「アンミ（わが民）」と言い、あなたがたの姉妹に向かっては「ルハマ（あわれまれる者）」と言え。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hosea 2:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "hosea.2.p1.b2": {
    "text": "あなたがたの母とあげつらえ……彼女はわたしの妻ではない、わたしは彼女の夫ではない",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hosea 2:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "hosea.2.p1.b3": {
    "text": "わたしはわが恋人たちについて行こう。彼らはパンと水と羊の毛と麻と油と飲み物とを、わたしに与える者である",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hosea 2:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "hosea.2.p1.b4": {
    "text": "それゆえ、わたしはいばらで彼女の道をふさぎ、かきをたてて、彼女にはその道がわからないようにする。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hosea 2:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "hosea.2.p1.b5": {
    "text": "わたしは行って、さきの夫に帰ろう。あの時は今よりもわたしによかったから",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hosea 2:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "hosea.2.p2.b1": {
    "text": "彼女に穀物と酒と油とを与えた者、またバアルのために用いた銀と金とを多く彼女に与えた者は、わたしであったことを彼女は知らなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hosea 2:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "hosea.2.p2.b2": {
    "text": "それゆえ、わたしは穀物をその時になって奪い、ぶどう酒をその季節になって奪い……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hosea 2:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "hosea.2.p2.b3": {
    "text": "わたしは彼女のすべての楽しみ、すなわち祝、新月、安息日、すべての祭をやめさせる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hosea 2:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "hosea.2.p2.b4": {
    "text": "また彼女が耳輪と宝石で身を飾り、その恋人たちを慕って行って、わたしを忘れ……わたしは彼女を罰すると主は言われる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hosea 2:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "hosea.2.p3.b1": {
    "text": "それゆえ、見よ、わたしは彼女をいざなって、荒野に導いて行き、ねんごろに彼女に語ろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hosea 2:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "hosea.2.p3.b2": {
    "text": "……アコルの谷を望みの門として与える。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hosea 2:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "hosea.2.p3.b3": {
    "text": "……また弓と、つるぎと、戦争とを地から断って、あなたを安らかに伏させる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hosea 2:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "hosea.2.p3.b4": {
    "text": "またわたしは永遠にあなたとちぎりを結ぶ。すなわち正義と、公平と、いつくしみと、あわれみとをもってちぎりを結ぶ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hosea 2:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "hosea.2.p3.b5": {
    "text": "あわれまれぬ者をあわれみ、わたしの民でない者に向かって、『あなたはわたしの民である』と言い",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hosea 2:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "hosea.2.p3.b6": {
    "text": "彼は『あなたはわたしの神である』と言う",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hosea 2:23"
    },
    "adapted": false,
    "status": "approved"
  }
}
