{
  "mark.15.p1.b1": {
    "text": "一到早晨，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "一到早⁠晨，"
  },
  "mark.15.p1.b2": {
    "text": "祭司长和长老、文士、全公会的人大家商议，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "祭⁠司⁠长和长⁠老、文⁠士、全公⁠会的人大⁠家商⁠议，"
  },
  "mark.15.p1.b3": {
    "text": "就把耶稣捆绑，解去交给彼拉多。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "就⁠把耶⁠稣捆⁠绑，解去交⁠给彼⁠拉⁠多。"
  },
  "mark.15.p2.b1": {
    "text": "你是犹太人的王吗？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠是犹⁠太⁠人的王吗？"
  },
  "mark.15.p2.b2": {
    "text": "你说的是。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你说的⁠是。"
  },
  "mark.15.p2.b3": {
    "text": "你看，他们告你这么多的事，你什么都不回答吗？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:4"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你看，他⁠们告你这⁠么多的事，你什⁠么都⁠不回⁠答吗？"
  },
  "mark.15.p2.b4": {
    "text": "耶稣仍不回答，以致彼拉多觉得希奇。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:5"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣仍不回⁠答，以⁠致彼⁠拉⁠多觉⁠得希⁠奇。"
  },
  "mark.15.p3.b1": {
    "text": "每逢这节期，巡抚照众人所求的，释放一个囚犯给他们。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:6"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "每⁠逢这节期，巡⁠抚照众⁠人所求的，释⁠放一⁠个囚⁠犯给他⁠们。"
  },
  "mark.15.p3.b2": {
    "text": "有一个人名叫巴拉巴，和作乱的人一同捆绑。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有⁠一个⁠人名⁠叫巴⁠拉⁠巴，和作乱的人一⁠同捆⁠绑。"
  },
  "mark.15.p3.b3": {
    "text": "你们要我释放犹太人的王给你们吗？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:9"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们要我释⁠放犹⁠太⁠人的王给你⁠们吗？"
  },
  "mark.15.p4.b1": {
    "text": "那么样，你们所称为犹太人的王，我怎么办他呢？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:12"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "那⁠么样，你⁠们所称⁠为犹⁠太⁠人的王，我怎⁠么办他呢？"
  },
  "mark.15.p4.b2": {
    "text": "把他钉十字架！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "把他钉十⁠字⁠架！"
  },
  "mark.15.p4.b3": {
    "text": "为什么呢？他做了什么恶事呢？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:14"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "为⁠什⁠么呢？他做⁠了什⁠么恶事呢？"
  },
  "mark.15.p4.b4": {
    "text": "把他钉十字架！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:14"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "把他钉十⁠字⁠架！"
  },
  "mark.15.p5.b1": {
    "text": "彼拉多要叫众人喜悦，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:15"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "彼⁠拉⁠多要叫众⁠人喜⁠悦，"
  },
  "mark.15.p5.b2": {
    "text": "就释放巴拉巴给他们，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:15"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "就释⁠放巴⁠拉⁠巴给他⁠们，"
  },
  "mark.15.p5.b3": {
    "text": "将耶稣鞭打了，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:15"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "将耶⁠稣鞭⁠打了，"
  },
  "mark.15.p5.b4": {
    "text": "交给人钉十字架。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:15"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "交⁠给人钉十⁠字⁠架。"
  },
  "mark.15.p6.b1": {
    "text": "兵丁把耶稣带进衙门院里，叫齐了全营的兵。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:16"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "兵⁠丁把耶⁠稣带进衙⁠门院里，叫齐了全营的兵。"
  },
  "mark.15.p6.b2": {
    "text": "又用荆棘编做冠冕给他戴上，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:17"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "又用荆⁠棘编做冠⁠冕给他戴⁠上，"
  },
  "mark.15.p6.b3": {
    "text": "恭喜，犹太人的王啊！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:18"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "恭⁠喜，犹⁠太⁠人的王啊！"
  },
  "mark.15.p6.b4": {
    "text": "又拿一根苇子打他的头，吐唾沫在他脸上，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:19"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "又拿一⁠根苇子打他⁠的头，吐⁠唾⁠沫在他脸上，"
  },
  "mark.15.p7.b1": {
    "text": "戏弄完了，就给他脱了紫袍，仍穿上他自己的衣服，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:20"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "戏⁠弄完⁠了，就给他脱⁠了紫袍，仍穿⁠上他自⁠己的衣⁠服，"
  },
  "mark.15.p7.b2": {
    "text": "带他出去，要钉十字架。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:20"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "带他出⁠去，要钉十⁠字⁠架。"
  },
  "mark.15.p7.b3": {
    "text": "有一个古利奈人西门……从乡下来，经过那地方，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:21"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有一⁠个古⁠利⁠奈人西⁠门……从乡⁠下来，经⁠过那地⁠方，"
  },
  "mark.15.p7.b4": {
    "text": "他们就勉强他同去，好背着耶稣的十字架。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:21"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠们就勉⁠强他同⁠去，好背着耶⁠稣的十⁠字⁠架。"
  },
  "mark.15.p8.b1": {
    "text": "他们带耶稣到了各各他地方（各各他翻出来就是髑髅地），",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:22"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠们带耶⁠稣到⁠了各⁠各⁠他地⁠方（各⁠各⁠他翻出⁠来就⁠是髑⁠髅⁠地），"
  },
  "mark.15.p8.b2": {
    "text": "拿没药调和的酒给耶稣，他却不受。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:23"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "拿没⁠药调⁠和的酒给耶⁠稣，他却不⁠受。"
  },
  "mark.15.p8.b3": {
    "text": "于是将他钉在十字架上，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:24"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "于⁠是将他钉⁠在十⁠字⁠架上，"
  },
  "mark.15.p8.b4": {
    "text": "拈阄分他的衣服，看是谁得什么。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:24"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "拈阄分他⁠的衣⁠服，看是谁得什⁠么。"
  },
  "mark.15.p9.b1": {
    "text": "钉他在十字架上是巳初的时候。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:25"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "钉他⁠在十⁠字⁠架上是巳初的时⁠候。"
  },
  "mark.15.p9.b2": {
    "text": "在上面有他的罪状，写的是：「犹太人的王。」",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:26"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "在上⁠面有他⁠的罪⁠状，写⁠的是：「犹⁠太⁠人的王。」"
  },
  "mark.15.p9.b3": {
    "text": "他们又把两个强盗和他同钉十字架，一个在右边，一个在左边。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:27"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠们又把两个强⁠盗和他同钉十⁠字⁠架，一⁠个在右⁠边，一⁠个在左⁠边。"
  },
  "mark.15.p10.b1": {
    "text": "咳！你这拆毁圣殿、三日又建造起来的，可以救自己，从十字架上下来吧！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:29-30"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "咳！你这拆毁圣⁠殿、三⁠日又建⁠造起⁠来的，可⁠以救自⁠己，从十⁠字⁠架上下⁠来吧！"
  },
  "mark.15.p10.b2": {
    "text": "他救了别人，不能救自己。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:31"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他救了别⁠人，不⁠能救自⁠己。"
  },
  "mark.15.p10.b3": {
    "text": "以色列的王基督，现在可以从十字架上下来，叫我们看见，就信了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:32"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "以⁠色⁠列的王基⁠督，现⁠在可⁠以从十⁠字⁠架上下⁠来，叫我⁠们看⁠见，就信了。"
  },
  "mark.15.p10.b4": {
    "text": "那和他同钉的人也是讥诮他。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:32"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "那和他同钉的人也⁠是讥⁠诮他。"
  },
  "mark.15.p11.b1": {
    "text": "从午正到申初，遍地都黑暗了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:33"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "从午正到申初，遍⁠地都黑⁠暗了。"
  },
  "mark.15.p11.b2": {
    "text": "申初的时候，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:34"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "申初的时⁠候，"
  },
  "mark.15.p11.b3": {
    "text": "以罗伊！以罗伊！拉马撒巴各大尼？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:34"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "以⁠罗⁠伊！以⁠罗⁠伊！拉马撒巴各⁠大尼？"
  },
  "mark.15.p11.b4": {
    "text": "翻出来就是：我的神！我的神！为什么离弃我？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:34"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "翻出⁠来就⁠是：我⁠的神！我⁠的神！为⁠什⁠么离⁠弃我？"
  },
  "mark.15.p12.b1": {
    "text": "看哪，他叫以利亚呢！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:35"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "看哪，他叫以⁠利⁠亚呢！"
  },
  "mark.15.p12.b2": {
    "text": "且等着，看以利亚来不来把他取下。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:36"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "且等⁠着，看以⁠利⁠亚来不来把他取下。"
  },
  "mark.15.p12.b3": {
    "text": "耶稣大声喊叫，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:37"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣大⁠声喊⁠叫，"
  },
  "mark.15.p12.b4": {
    "text": "气就断了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:37"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.15.p13.b1": {
    "text": "殿里的幔子从上到下裂为两半。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:38"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "殿⁠里的幔子从上到下裂为两半。"
  },
  "mark.15.p13.b2": {
    "text": "对面站着的百夫长看见耶稣这样喊叫断气，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:39"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "对⁠面站着的百⁠夫⁠长看⁠见耶⁠稣这⁠样喊⁠叫断气，"
  },
  "mark.15.p13.b3": {
    "text": "这人真是神的儿子！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:39"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "这人真⁠是神的儿⁠子！"
  },
  "mark.15.p14.b1": {
    "text": "还有些妇女远远地观看；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:40"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "还有⁠些妇⁠女远⁠远地观⁠看；"
  },
  "mark.15.p14.b2": {
    "text": "内中有抹大拉的马利亚，又有小雅各和约西的母亲马利亚，并有撒罗米，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:40"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "内中⁠有抹⁠大⁠拉的马⁠利⁠亚，又⁠有小雅⁠各和约⁠西的母⁠亲马⁠利⁠亚，并有撒⁠罗⁠米，"
  },
  "mark.15.p14.b3": {
    "text": "就是耶稣在加利利的时候，跟随他、服事他的那些人，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:41"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "就⁠是耶⁠稣在加⁠利⁠利的时⁠候，跟⁠随他、服事他⁠的那⁠些人，"
  },
  "mark.15.p14.b4": {
    "text": "还有同耶稣上耶路撒冷的好些妇女在那里观看。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:41"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "还⁠有同耶⁠稣上耶⁠路撒⁠冷的好⁠些妇⁠女在那⁠里观⁠看。"
  },
  "mark.15.p15.b1": {
    "text": "到了晚上，因为这是预备日，就是安息日的前一日，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:42"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "到⁠了晚⁠上，因⁠为这是预⁠备⁠日，就⁠是安⁠息⁠日的前一⁠日，"
  },
  "mark.15.p15.b2": {
    "text": "有亚利马太的约瑟前来，他是尊贵的议士，也是等候神国的。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:43"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有亚⁠利马⁠太的约⁠瑟前来，他⁠是尊⁠贵的议士，也⁠是等⁠候神⁠国的。"
  },
  "mark.15.p15.b3": {
    "text": "他放胆进去见彼拉多，求耶稣的身体；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:43"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他放⁠胆进⁠去见彼⁠拉⁠多，求耶⁠稣的身⁠体；"
  },
  "mark.15.p15.b4": {
    "text": "彼拉多诧异耶稣已经死了，便叫百夫长来，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:44"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "彼⁠拉⁠多诧⁠异耶⁠稣已⁠经死⁠了，便叫百⁠夫⁠长来，"
  },
  "mark.15.p16.b1": {
    "text": "约瑟买了细麻布，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:46"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "约⁠瑟买了细⁠麻⁠布，"
  },
  "mark.15.p16.b2": {
    "text": "把耶稣取下来，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:46"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "把耶⁠稣取下⁠来，"
  },
  "mark.15.p16.b3": {
    "text": "用细麻布裹好，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:46"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "用细⁠麻⁠布裹⁠好，"
  },
  "mark.15.p16.b4": {
    "text": "又滚过一块石头来挡住墓门。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:46"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "又滚过一⁠块石⁠头来挡⁠住墓门。"
  },
  "mark.15.p17.b1": {
    "text": "抹大拉的马利亚和约西的母亲马利亚",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:47"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "抹⁠大⁠拉的马⁠利⁠亚和约⁠西的母⁠亲马⁠利⁠亚"
  },
  "mark.15.p17.b2": {
    "text": "都看见安放他的地方。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 15:47"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "都看⁠见安⁠放他⁠的地⁠方。"
  }
}
