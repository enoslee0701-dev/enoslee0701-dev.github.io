{
  "genesis.12.p1.b1": {
    "text": "「あなたは国を出て、親族に別れ、父の家を離れ、わたしが示す地に行きなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 12:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.12.p1.b2": {
    "text": "わたしはあなたを大いなる国民とし、あなたを祝福し、あなたの名を大きくしよう。あなたは祝福の基となるであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 12:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.12.p1.b3": {
    "text": "… 地のすべてのやからは、あなたによって祝福される」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 12:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.12.p2.b4": {
    "text": "アブラムは主が言われたようにいで立った。ロトも彼と共に行った。アブラムはハランを出たとき七十五歳であった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 12:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.12.p2.b5": {
    "text": "… 集めたすべての財産と、ハランで獲た人々とを携えてカナンに行こうとしていで立ち、カナンの地にきた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 12:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.12.p2.b6": {
    "text": "アブラムはその地を通ってシケムの所、モレのテレビンの木のもとに着いた。そのころカナンびとがその地にいた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 12:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.12.p3.b7": {
    "text": "「わたしはあなたの子孫にこの地を与えます」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 12:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.12.p3.b8": {
    "text": "アブラムは彼に現れた主のために、そこに祭壇を築いた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 12:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.12.p3.b9": {
    "text": "… そこに彼は主のために祭壇を築いて、主の名を呼んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 12:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.12.p4.b10": {
    "text": "さて、その地にききんがあったのでアブラムはエジプトに寄留しようと、そこに下った。ききんがその地に激しかったからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 12:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.12.p4.b11": {
    "text": "「わたしはあなたが美しい女であるのを知っています。 それでエジプトびとがあなたを見る時、これは彼の妻であると言ってわたしを殺し、あなたを生かしておくでしょう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 12:11-12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.12.p4.b12": {
    "text": "どうかあなたは、わたしの妹だと言ってください。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 12:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.12.p5.b13": {
    "text": "アブラムがエジプトにはいった時エジプトびとはこの女を見て、たいそう美しい人であるとし、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 12:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.12.p5.b14": {
    "text": "またパロの高官たちも彼女を見てパロの前でほめたので、女はパロの家に召し入れられた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 12:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.12.p5.b15": {
    "text": "パロは彼女のゆえにアブラムを厚くもてなしたので、アブラムは多くの羊、牛、雌雄のろば、男女の奴隷および、らくだを得た。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 12:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.12.p6.b16": {
    "text": "ところで主はアブラムの妻サライのゆえに、激しい疫病をパロとその家に下された。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 12:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.12.p6.b17": {
    "text": "「あなたはわたしになんという事をしたのですか。なぜ彼女が妻であるのをわたしに告げなかったのですか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 12:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.12.p6.b18": {
    "text": "… さあ、あなたの妻はここにいます。連れて行ってください」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 12:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.12.p6.b19": {
    "text": "パロは彼の事について人々に命じ、彼とその妻およびそのすべての持ち物を送り去らせた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 12:20"
    },
    "adapted": false,
    "status": "approved"
  }
}
