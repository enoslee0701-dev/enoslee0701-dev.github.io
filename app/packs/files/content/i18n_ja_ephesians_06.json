{
  "ephesians.6.p1.b1": {
    "text": "子たる者よ。主にあって両親に従いなさい。これは正しいことである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 6:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.6.p1.b2": {
    "text": "「あなたの父と母とを敬え」。これが第一の戒めであって、次の約束がそれについている、 「そうすれば、あなたは幸福になり、地上でながく生きながらえるであろう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 6:2-3"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.6.p1.b3": {
    "text": "父たる者よ。子供をおこらせないで、主の薫陶と訓戒とによって、彼らを育てなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 6:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.6.p2.b1": {
    "text": "僕たる者よ。キリストに従うように、恐れおののきつつ、真心をこめて、肉による主人に従いなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 6:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.6.p2.b2": {
    "text": "… 僕であれ、自由人であれ、それに相当する報いを、それぞれ主から受けるであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 6:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.6.p2.b3": {
    "text": "主人たる者よ。… あなたがたが知っているとおり、彼らとあなたがたとの主は天にいますのであり、かつ人をかたより見ることをなさらないのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 6:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.6.p3.b1": {
    "text": "最後に言う。主にあって、その偉大な力によって、強くなりなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 6:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.6.p3.b2": {
    "text": "悪魔の策略に対抗して立ちうるために、神の武具で身を固めなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 6:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.6.p3.b3": {
    "text": "わたしたちの戦いは、血肉に対するものではなく、… やみの世の主権者、また天上にいる悪の霊に対する戦いである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 6:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.6.p4.b1": {
    "text": "それだから、悪しき日にあたって、よく抵抗し、完全に勝ち抜いて、堅く立ちうるために、神の武具を身につけなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 6:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.6.p4.b2": {
    "text": "すなわち、立って真理の帯を腰にしめ、正義の胸当を胸につけ、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 6:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.6.p4.b3": {
    "text": "また、救のかぶとをかぶり、御霊の剣、すなわち、神の言を取りなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 6:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.6.p5.b1": {
    "text": "絶えず祈と願いをし、どんな時でも御霊によって祈り、そのために目をさましてうむことがなく、すべての聖徒のために祈りつづけなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 6:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.6.p5.b2": {
    "text": "また、わたしが口を開くときに語るべき言葉を賜わり、大胆に福音の奥義を明らかに示しうるように、わたしのためにも祈ってほしい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 6:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.6.p5.b3": {
    "text": "わたしはこの福音のための使節であり、そして鎖につながれているのであるが、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 6:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.6.p5.b4": {
    "text": "… つながれていても、語るべき時には大胆に語れるように祈ってほしい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 6:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.6.p6.b1": {
    "text": "わたしがどういう様子か、何をしているかを、あなたがたに知ってもらうために、主にあって忠実に仕えている愛する兄弟テキコが、いっさいの事を報告するであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 6:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.6.p6.b2": {
    "text": "彼をあなたがたのもとに送るのは、あなたがたがわたしたちの様子を知り、また彼によって心に励ましを受けるようになるためなのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 6:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.6.p7.b1": {
    "text": "父なる神とわたしたちの主イエス・キリストから平安ならびに信仰に伴う愛が、兄弟たちにあるように。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 6:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.6.p7.b2": {
    "text": "変らない真実をもって、わたしたちの主イエス・キリストを愛するすべての人々に、恵みがあるように。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 6:24"
    },
    "adapted": false,
    "status": "approved"
  }
}
