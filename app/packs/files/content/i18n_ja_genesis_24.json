{
  "genesis.24.p1.b1": {
    "text": "アブラハムは年が進んで老人となった。主はすべての事にアブラハムを恵まれた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p1.b2": {
    "text": "わたしはあなたに天地の神、主をさして誓わせる。あなたはわたしが今一緒に住んでいるカナンびとのうちから、娘をわたしの子の妻にめとってはならない。 あなたはわたしの国へ行き、親族の所へ行って、わたしの子イサクのために妻をめとらなければならない」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:3-4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p1.b3": {
    "text": "もしその女がわたしについてこの地に来ることを好まない時は、わたしはあなたの子をあなたの出身地に連れ帰るべきでしょうか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p1.b4": {
    "text": "わたしの子は決して向こうへ連れ帰ってはならない。……主は、み使をあなたの前につかわされるであろう。あなたはあそこからわたしの子に妻をめとらねばならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:6-7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p1.b5": {
    "text": "そこでしもべは手を主人アブラハムのももの下に入れ、この事について彼に誓った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p2.b6": {
    "text": "しもべは主人のらくだのうちから十頭のらくだを取って出かけた。……立ってアラム・ナハライムにむかい、ナホルの町へ行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p2.b7": {
    "text": "時は夕暮で、女たちが水をくみに出る時刻であった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p2.b8": {
    "text": "主人アブラハムの神、主よ、どうか、きょう、わたしにしあわせを授け、主人アブラハムに恵みを施してください。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p2.b9": {
    "text": "……『お飲みください。あなたのらくだにも飲ませましょう』と言ったなら、その者こそ、あなたがしもべイサクのために定められた者ということにしてください。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p3.b10": {
    "text": "彼がまだ言い終らないうちに、……リベカが、水がめを肩に載せて出てきた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p3.b11": {
    "text": "その娘は非常に美しく、……彼女が泉に降りて、水がめを満たし、上がってきた",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p3.b12": {
    "text": "お願いです。あなたの水がめの水を少し飲ませてください",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p3.b13": {
    "text": "わが主よ、お飲みください",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p4.b14": {
    "text": "あなたのらくだもみな飲み終るまで、わたしは水をくみましょう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p4.b15": {
    "text": "彼女は急いでかめの水を水ぶねにあけ、……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p4.b16": {
    "text": "その間その人は主が彼の旅の祝福されるか、どうかを知ろうと、黙って彼女を見つめていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p4.b17": {
    "text": "……再び水をくみに井戸に走って行って、すべてのらくだのために水をくんだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p5.b18": {
    "text": "らくだが飲み終ったとき、その人は重さ半シケルの金の鼻輪一つと、重さ十シケルの金の腕輪二つを取って、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p5.b19": {
    "text": "あなたはだれの娘か、わたしに話してください。あなたの父の家にわたしどもの泊まる場所がありましょうか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p5.b20": {
    "text": "わたしはナホルの妻ミルカの子ベトエルの娘です……わたしどもには、わらも、飼葉もたくさんあります。また泊まる場所もあります",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:24-25"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p5.b21": {
    "text": "主人アブラハムの神、主はほむべきかな。主はわたしの主人にいつくしみと、まこととを惜しまれなかった。そして主は旅にあるわたしを主人の兄弟の家に導かれた",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p6.b22": {
    "text": "娘は走って行って、母の家のものにこれらの事を告げた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p6.b23": {
    "text": "リベカにひとりの兄があって、名をラバンといった。ラバンは泉のそばにいるその人の所へ走って行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p6.b24": {
    "text": "主に祝福された人よ、おはいりください。なぜ外に立っておられますか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p6.b25": {
    "text": "わたしは用向きを話すまでは食べません",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p6.b26": {
    "text": "お話しください",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p7.b27": {
    "text": "わたしはアブラハムのしもべです。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p7.b28": {
    "text": "主はわたしの主人を大いに祝福して、大いなる者とされました。……主人はその所有を皆これに与えました。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:35-36"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p7.b29": {
    "text": "おまえはわたしの父の家、親族の所へ行って、わたしの子に妻をめとらなければならない』。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p7.b30": {
    "text": "わたしは主人に言いました、『もしその女がわたしについてこない時はどういたしましょうか』。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p8.b31": {
    "text": "わたしはきょう、泉のところにきて言いました、『主人アブラハムの神、主よ、どうか今わたしのゆく道にさいわいを与えてください。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:42"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p8.b32": {
    "text": "お飲みください。わたしはあなたのらくだにも飲ませましょう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:46"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p8.b33": {
    "text": "それでわたしは飲みましたが、彼女はらくだにも飲ませました。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:46"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p8.b34": {
    "text": "あなたがたが、もしわたしの主人にいつくしみと、まことを尽そうと思われるなら、そうとわたしにお話しください。そうでなければ、そうでないとお話しください。それによってわたしは右か左に決めましょう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:49"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p9.b35": {
    "text": "この事は主から出たことですから、わたしどもはあなたによしあしを言うことができません。……リベカがここにおりますから連れて行って、……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:50-51"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p9.b36": {
    "text": "アブラハムのしもべは彼らの言葉を聞いて、地に伏し、主を拝した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:52"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p9.b37": {
    "text": "そしてしもべは銀の飾りと、金の飾り、および衣服を取り出してリベカに与え、その兄と母とにも価の高い品々を与えた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:53"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p9.b38": {
    "text": "……宿ったが、あくる朝彼らが起きた時、……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:54"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p9.b39": {
    "text": "わたしを主人のもとに帰らせてください",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:54"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p10.b40": {
    "text": "娘は数日、少なくとも十日、わたしどもと共にいて、それから行かせましょう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:55"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p10.b41": {
    "text": "……わたしを引きとめずに、主人のもとに帰らせてください",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:56"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p10.b42": {
    "text": "あなたはこの人と一緒に行きますか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:58"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p10.b43": {
    "text": "行きます",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:58"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p11.b44": {
    "text": "妹よ、あなたは、ちよろずの人の母となれ。あなたの子孫はその敵の門を打ち取れ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:60"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p11.b45": {
    "text": "そこで彼らは妹リベカと、そのうばと、アブラハムのしもべと、その従者とを送り去らせた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:59"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p11.b46": {
    "text": "リベカは立って侍女たちと共にらくだに乗り、その人に従って行った。しもべはリベカを連れて立ち去った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:61"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p12.b47": {
    "text": "さてイサクはベエル・ラハイ・ロイからきて、ネゲブの地に住んでいた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:62"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p12.b48": {
    "text": "イサクは夕暮、野に出て歩いていたが、……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:63"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p12.b49": {
    "text": "……目をあげて、らくだの来るのを見た。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:63"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p13.b50": {
    "text": "リベカは目をあげてイサクを見、らくだからおりて、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:64"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p13.b51": {
    "text": "わたしたちに向かって、野を歩いて来るあの人はだれでしょう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:65"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p13.b52": {
    "text": "あれはわたしの主人です",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:65"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p13.b53": {
    "text": "するとリベカは、被衣で身をおおった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:65"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p14.b54": {
    "text": "しもべは自分がしたことのすべてをイサクに話した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:66"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p14.b55": {
    "text": "イサクはリベカを天幕に連れて行き、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:67"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.24.p14.b56": {
    "text": "リベカをめとって妻とし、彼女を愛した。こうしてイサクは母の死後、慰めを得た。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 24:67"
    },
    "adapted": false,
    "status": "approved"
  }
}
