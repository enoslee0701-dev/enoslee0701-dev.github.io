{
  "matthew.12.p1.b1": {
    "text": "그 때에 예수께서 안식일에 밀밭 사이로 가실새",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p1.b2": {
    "text": "제자들이 시장하여 이삭을 잘라 먹으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p1.b3": {
    "text": "보시오 당신의 제자들이 안식일에 하지 못할 일을 하나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p2.b1": {
    "text": "다윗이 자기와 그 함께한 자들이 시장할 때에 한 일을 읽지 못하였느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p2.b2": {
    "text": "그가 하나님의 전에 들어가서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p2.b3": {
    "text": "제사장 외에는 자기나 그 함께한 자들이 먹지 못하는 진설병을 먹지 아니하였느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p2.b4": {
    "text": "또 안식일에 제사장들이 성전 안에서 안식을 범하여도 죄가 없음을 너희가 율법에서 읽지 못하였느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p3.b1": {
    "text": "내가 너희에게 이르노니 성전보다 더 큰 이가 여기 있느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p3.b2": {
    "text": "나는 자비를 원하고 제사를 원치 아니하노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p3.b3": {
    "text": "하신 뜻을 너희가 알았더면 무죄한 자를 죄로 정치 아니하였으리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p3.b4": {
    "text": "인자는 안식일의 주인이니라 하시니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p4.b1": {
    "text": "거기를 떠나 저희 회당에 들어가시니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p4.b2": {
    "text": "한편 손 마른 사람이 있는지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p4.b3": {
    "text": "안식일에 병 고치는 것이 옳으니이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p4.b4": {
    "text": "사람들이 예수를 송사하려 하여",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p5.b1": {
    "text": "너희 중에 어느 사람이 양 한 마리가 있어 안식일에 구덩이에 빠졌으면",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p5.b2": {
    "text": "붙잡아 내지 않겠느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p5.b3": {
    "text": "사람이 양보다 얼마나 더 귀하냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p5.b4": {
    "text": "그러므로 안식일에 선을 행하는것이 옳으니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p6.b1": {
    "text": "손을 내밀라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p6.b2": {
    "text": "저가 내밀매 다른 손과 같이 회복되어 성하더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p6.b3": {
    "text": "바리새인들이 나가서 어떻게 하여 예수를 죽일꼬 의논하거늘",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p7.b1": {
    "text": "예수께서 아시고 거기를 떠나가시니 사람이 많이 좇는지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p7.b2": {
    "text": "예수께서 저희 병을 다 고치시고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p7.b3": {
    "text": "자기를 나타내지 말라 경계하셨으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p7.b4": {
    "text": "이는 선지자 이사야로 말씀하신 바",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p8.b1": {
    "text": "보라 나의 택한 종 곧 내 마음에 기뻐하는 바 나의 사랑하는 자로다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p8.b2": {
    "text": "내가 내 성령을 줄터이니 그가 심판을 이방에 알게 하리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p8.b3": {
    "text": "그가 다투지도 아니하며 들레지도 아니하리니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p8.b4": {
    "text": "아무도 길에서 그 소리를 듣지 못하리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p9.b1": {
    "text": "상한 갈대를 꺾지 아니하며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p9.b2": {
    "text": "꺼져가는 심지를 끄지 아니하기를",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p9.b3": {
    "text": "심판하여 이길 때까지 하리니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p9.b4": {
    "text": "또한 이방들이 그 이름을 바라리라 함을 이루려 하심이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p10.b1": {
    "text": "그 때에 귀신들려 눈 멀고 벙어리 된 자를 데리고 왔거늘",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p10.b2": {
    "text": "예수께서 고쳐 주시매 그 벙어리가 말하며 보게 된지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p10.b3": {
    "text": "이는 다윗의 자손이 아니냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p10.b4": {
    "text": "이가 귀신의 왕 바알세불을 힘입지 않고는 귀신을 쫓아내지 못하느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p11.b1": {
    "text": "예수께서 저희 생각을 아시고 가라사대",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p11.b2": {
    "text": "스스로 분쟁하는 나라마다 황폐하여 질 것이요 스스로 분쟁하는 동네나 집마다 서지 못하리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p11.b3": {
    "text": "또 내가 바알세불을 힘입어 귀신을 쫓아 내면 너희 아들들은 누구를 힘입어 쫓아 내느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p11.b4": {
    "text": "그러나 내가 하나님의 성령을 힘입어 귀신을 쫓아내는 것이면 하나님의 나라가 이미 너희에게 임하였느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p12.b1": {
    "text": "사람이 먼저 강한 자를 결박하지 않고야 어떻게 그 강한 자의 집에 들어가 그 세간을 늑탈하겠느냐 결박한 후에야 그 집을 늑탈하리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p12.b2": {
    "text": "나와 함께 아니하는 자는 나를 반대하는 자요 나와 함께 모으지 아니하는 자는 헤치는 자니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p12.b3": {
    "text": "사람의 모든 죄와 훼방은 사하심을 얻되 성령을 훼방하는 것은 사하심을 얻지 못하겠고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p12.b4": {
    "text": "…누구든지 말로 성령을 거역하면 이 세상과 오는 세상에도 사하심을 얻지 못하리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p13.b1": {
    "text": "나무도 좋고 실과도 좋다 하든지 나무도 좋지 않고 실과도 좋지 않다 하든지 하라 그 실과로 나무를 아느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p13.b2": {
    "text": "독사의 자식들아 … 이는 마음에 가득한 것을 입으로 말함이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p13.b3": {
    "text": "선한 사람은 그 쌓은 선에서 선한 것을 내고 악한 사람은 그 쌓은 악에서 악한 것을 내느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p13.b4": {
    "text": "네 말로 의롭다 함을 받고 네 말로 정죄함을 받으리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:37"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p14.b1": {
    "text": "그 때에 서기관과 바리새인 중 몇 사람이 말하되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p14.b2": {
    "text": "선생님이여 우리에게 표적 보여 주시기를 원하나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p14.b3": {
    "text": "악하고 음란한 세대가 표적을 구하나 선지자 요나의 표적 밖에는 보일 표적이 없느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p14.b4": {
    "text": "요나가 밤낮 사흘을 큰 물고기 뱃속에 있었던 것같이 인자도 밤낮 사흘을 땅 속에 있으리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p15.b1": {
    "text": "심판 때에 니느웨 사람들이 일어나 이 세대 사람을 정죄하리니 이는 그들이 요나의 전도를 듣고 회개하였음이어니와",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p15.b2": {
    "text": "요나보다 더 큰 이가 여기 있으며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p15.b3": {
    "text": "심판 때에 남방 여왕이 일어나 이 세대 사람을 정죄하리니 이는 그가 솔로몬의 지혜로운 말을 들으려고 땅 끝에서 왔음이어니와",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:42"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p15.b4": {
    "text": "솔로몬보다 더 큰이가 여기 있느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:42"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p16.b1": {
    "text": "더러운 귀신이 사람에게서 나갔을 때에 물 없는 곳으로 다니며 쉬기를 구하되 얻지 못하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:43"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p16.b2": {
    "text": "내가 나온 내 집으로 돌아가리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:44"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p16.b3": {
    "text": "이에 가서 저보다 더 악한 귀신 일곱을 데리고 들어가서 거하니 그 사람의 나중 형편이 전보다 더욱 심하게 되느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:45"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p16.b4": {
    "text": "이 악한 세대가 또한 이렇게 되리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:45"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p17.b1": {
    "text": "예수께서 무리에게 말씀하실 때에 그 모친과 동생들이 예수께 말하려고 밖에 섰더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:46"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p17.b2": {
    "text": "보소서 당신의 모친과 동생들이 당신께 말하려고 밖에 섰나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:47"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p18.b1": {
    "text": "누가 내 모친이며 내 동생들이냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:48"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p18.b2": {
    "text": "손을 내밀어 제자들을 가리켜 가라사대",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:49"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p18.b3": {
    "text": "나의 모친과 나의 동생들을 보라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:49"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.12.p18.b4": {
    "text": "누구든지 하늘에 계신 내 아버지의 뜻대로 하는 자가 내 형제요 자매요 모친이니라 하시더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 12:50"
    },
    "adapted": false,
    "status": "approved"
  }
}
