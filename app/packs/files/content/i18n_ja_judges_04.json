{
  "judges.4.p1.b1": {
    "text": "エホデが死んだ後、イスラエルの人々がまた主の前に悪をおこなったので、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 4:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p1.b2": {
    "text": "主は、ハゾルで世を治めていたカナンの王ヤビンの手に彼らを売りわたされた。ヤビンの軍勢の長はハロセテ・ゴイムに住んでいたシセラであった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 4:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p1.b3": {
    "text": "彼は鉄の戦車九百両をもち、二十年の間イスラエルの人々を激しくしえたげたので、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 4:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p1.b4": {
    "text": "イスラエルの人々は主に向かって呼ばわった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 4:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p2.b5": {
    "text": "そのころラピドテの妻、女預言者デボラがイスラエルをさばいていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 4:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p2.b6": {
    "text": "彼女はエフライムの山地のラマとベテルの間にあるデボラのしゅろの木の下に座し、イスラエルの人々は彼女のもとに上ってきて、さばきをうけた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 4:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p2.b7": {
    "text": "デボラは人をつかわして、ナフタリのケデシからアビノアムの子バラクを招いて",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 4:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p2.b8": {
    "text": "イスラエルの神、主はあなたに、こう命じられるではありませんか、『ナフタリの部族とゼブルンの部族から一万人を率い、行って、タボル山に陣をしけ。……彼をあなたの手にわたすであろう』",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 4:6-7"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p3.b9": {
    "text": "あなたがもし一緒に行ってくだされば、わたしは行きます。しかし、一緒に行ってくださらないならば、行きません",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 4:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p3.b10": {
    "text": "必ずあなたと一緒に行きます。しかしあなたは今行く道では誉を得ないでしょう。主はシセラを女の手にわたされるからです",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 4:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p3.b11": {
    "text": "デボラは立ってバラクと一緒にケデシに行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 4:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p3.b12": {
    "text": "バラクはゼブルンとナフタリをケデシに呼び集め、一万人を従えて上った。デボラも彼と共に上った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 4:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p4.b13": {
    "text": "時にケニびとヘベルはモーセのしゅうとホバブの子孫であるケニびとから分れて、ケデシに近いザアナイムのかしの木までも遠く行って天幕を張っていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 4:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p4.b14": {
    "text": "アビノアムの子バラクがタボル山に上った",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 4:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p4.b15": {
    "text": "シセラは自分の戦車の全部すなわち鉄の戦車九百両と、自分と共におるすべての民をハロセテ・ゴイムからキション川に呼び集めた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 4:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p5.b16": {
    "text": "さあ、立ちあがりなさい。きょうは主がシセラをあなたの手にわたされる日です。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 4:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p5.b17": {
    "text": "主はあなたに先立って出られるではありませんか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 4:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p5.b18": {
    "text": "そこでバラクは一万人を従えてタボル山から下った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 4:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p6.b19": {
    "text": "主はつるぎをもってシセラとすべての戦車および軍勢をことごとくバラクの前に撃ち敗られたので、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 4:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p6.b20": {
    "text": "シセラは戦車から飛びおり、徒歩で逃げ去った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 4:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p6.b21": {
    "text": "バラクは戦車と軍勢とを追撃してハロセテ・ゴイムまで行った。シセラの軍勢はことごとくつるぎにたおれて、残ったものはひとりもなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 4:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p7.b22": {
    "text": "しかしシセラは徒歩で逃げ去って、ケニびとヘベルの妻ヤエルの天幕に行った。ハゾルの王ヤビンとケニびとヘベルの家とは互にむつまじかったからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 4:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p7.b23": {
    "text": "おはいりください。主よ、どうぞうちへおはいりください。恐れるにはおよびません",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 4:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p7.b24": {
    "text": "どうぞ、わたしに水を少し飲ませてください。のどがかわきましたから",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 4:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p7.b25": {
    "text": "ヤエルは乳の皮袋を開いて彼に飲ませ、また彼をおおった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 4:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p8.b26": {
    "text": "天幕の入口に立っていてください。もし人がきて、あなたに『だれか、ここにおりますか』と問うならば『おりません』と答えてください",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 4:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p8.b27": {
    "text": "しかし彼が疲れて熟睡したとき、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 4:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p8.b28": {
    "text": "ヘベルの妻ヤエルは天幕のくぎを取り、手に槌を携えて彼に忍び寄り、……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 4:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p8.b29": {
    "text": "彼は息絶えて死んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 4:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p9.b30": {
    "text": "おいでなさい。あなたが求めている人をお見せしましょう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 4:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p9.b31": {
    "text": "彼がヤエルの天幕にはいって見ると、シセラは……倒れて死んでいた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 4:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p9.b32": {
    "text": "こうしてその日、神はカナンの王ヤビンをイスラエルの人々の前に撃ち敗られた。 そしてイスラエルの人々の手はますますカナンびとの王ヤビンの上に重くなって、ついにカナンの王ヤビンを滅ぼすに至った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 4:23-24"
    },
    "adapted": false,
    "status": "approved"
  }
}
