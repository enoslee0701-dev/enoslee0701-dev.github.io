{
  "genesis.7.p1.b1": {
    "text": "あなたと家族とはみな箱舟にはいりなさい。あなたがこの時代の人々の中で、わたしの前に正しい人であるとわたしは認めたからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 7:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p1.b2": {
    "text": "あなたはすべての清い獣の中から雄と雌とを七つずつ取り、清くない獣の中から雄と雌とを二つずつ取り、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 7:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p1.b3": {
    "text": "七日の後、わたしは四十日四十夜、地に雨を降らせて…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 7:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p1.b4": {
    "text": "ノアはすべて主が命じられたようにした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 7:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p2.b5": {
    "text": "さて洪水が地に起った時、ノアは六百歳であった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 7:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p2.b6": {
    "text": "雄と雌とが、二つずつノアのもとにきて、…箱舟にはいった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 7:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p2.b7": {
    "text": "鳥と、地に這うすべてのもの",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 7:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p3.b8": {
    "text": "こうして七日の後、洪水が地に起った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 7:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p3.b9": {
    "text": "それはノアの六百歳の二月十七日であって、その日に大いなる淵の源は、ことごとく破れ、天の窓が開けて、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 7:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p3.b10": {
    "text": "雨は四十日四十夜、地に降り注いだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 7:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p4.b11": {
    "text": "その同じ日に、ノアと、ノアの子セム、ハム、ヤペテと、ノアの妻と、その子らの三人の妻とは共に箱舟にはいった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 7:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p4.b12": {
    "text": "すなわち命の息のあるすべての肉なるものが、二つずつノアのもとにきて、箱舟にはいった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 7:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p5.b13": {
    "text": "そのはいったものは、すべて肉なるものの雄と雌とであって、神が彼に命じられたようにはいった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 7:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p5.b14": {
    "text": "そこで主は彼のうしろの戸を閉ざされた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 7:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p6.b15": {
    "text": "洪水は四十日のあいだ地上にあった。水が増して箱舟を浮べたので、箱舟は地から高く上がった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 7:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p6.b16": {
    "text": "また水がみなぎり、地に増したので、箱舟は水のおもてに漂った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 7:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p6.b17": {
    "text": "天の下の高い山々は皆おおわれた。水はその上、さらに十五キュビトみなぎって、山々は全くおおわれた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 7:19-20"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p7.b18": {
    "text": "地の上に動くすべて肉なるものは、鳥も家畜も獣も、地に群がるすべての這うものも、すべての人もみな滅びた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 7:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p7.b19": {
    "text": "すなわち鼻に命の息のあるすべてのもの、陸にいたすべてのものは死んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 7:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p8.b20": {
    "text": "地のおもてにいたすべての生き物は、…みな地からぬぐい去られて、ただノアと、彼と共に箱舟にいたものだけが残った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 7:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p8.b21": {
    "text": "水は百五十日のあいだ地上にみなぎった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 7:24"
    },
    "adapted": false,
    "status": "approved"
  }
}
