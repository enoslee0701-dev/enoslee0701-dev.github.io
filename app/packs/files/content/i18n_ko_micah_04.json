{
  "micah.4.p1.b1": {
    "text": "말일에 이르러는 여호와의 전의 산이 산들의 꼭대기에 굳게 서며 작은 산들 위에 뛰어나고 … 민족들이 그리로 몰려갈 것이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Micah 4:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.4.p1.b2": {
    "text": "오라 우리가 여호와의 산에 올라가서 야곱의 하나님의 전에 이르자",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Micah 4:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.4.p1.b3": {
    "text": "무리가 그 칼을 쳐서 보습을 만들고 창을 쳐서 낫을 만들 것이며 이 나라와 저 나라가 다시는 칼을 들고 서로 치지 아니하며 다시는 전쟁을 연습하지 아니하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Micah 4:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.4.p1.b4": {
    "text": "각 사람이 자기 포도나무 아래와 자기 무화과나무 아래 앉을 것이라 그들을 두렵게 할 자가 없으리니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Micah 4:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.4.p1.b5": {
    "text": "만군의 여호와의 입이 이같이 말씀하셨음이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Micah 4:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.4.p1.b6": {
    "text": "만민이 각각 자기의 신의 이름을 빙자하여 행하되 오직 우리는 우리 하나님 여호와의 이름을 빙자하여 영원히 행하리로다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Micah 4:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.4.p2.b1": {
    "text": "여호와께서 말씀하시되 그 날에는 내가 저는 자를 모으며 쫓겨난자와 내가 환난 받게한 자를 모아",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Micah 4:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.4.p2.b2": {
    "text": "너 양떼의 망대요 딸 시온의 산이여 이전 권능 곧 딸 예루살렘의 나라가 네게로 돌아오리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Micah 4:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.4.p2.b3": {
    "text": "딸 시온이여 해산하는 여인처럼 애써 구로하여 낳을지어다 … 바벨론까지 이르러 거기 구원을 얻으리니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Micah 4:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.4.p2.b4": {
    "text": "시온이 더럽게 되며 그것을 우리 눈으로 바라보기를 원하노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Micah 4:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.4.p2.b5": {
    "text": "딸 시온이여 일어나서 칠지어다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Micah 4:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.4.p2.b6": {
    "text": "내가 네 뿔을 철 같게 하며 네 굽을 놋 같게 하리니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Micah 4:13"
    },
    "adapted": false,
    "status": "approved"
  }
}
