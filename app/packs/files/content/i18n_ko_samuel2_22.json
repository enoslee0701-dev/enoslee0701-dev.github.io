{
  "samuel2.22.p1.b1": {
    "text": "여호와께서 다윗을 모든 대적의 손과 사울의 손에서 구원하신 그 날에",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 22:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p1.b2": {
    "text": "다윗이 이 노래의 말씀으로 여호와께 아뢰어 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 22:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p2.b1": {
    "text": "여호와는 나의 반석이시요 나의 요새시요 나를 건지시는 자시요",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 22:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p2.b2": {
    "text": "나의 하나님이시요 나의 피할 바위시요",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 22:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p2.b3": {
    "text": "나의 방패시요 나의 구원의 뿔이시요 나의 높은 망대시요 나의 피난처시요",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 22:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p2.b4": {
    "text": "내가 찬송 받으실 여호와께 아뢰리니 내 원수들에게서 구원을 얻으리로다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 22:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p3.b1": {
    "text": "사망의 물결이 나를 에우고 불의의 창수가 나를 두렵게 하였으며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 22:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p3.b2": {
    "text": "음부의 줄이 나를 두르고 사망의 올무가 내게 이르렀도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 22:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p3.b3": {
    "text": "내가 환난 중에서 여호와께 아뢰며 나의 하나님께 아뢰었더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 22:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p3.b4": {
    "text": "저가 그 전에서 내 소리를 들으심이여 나의 부르짖음이 그 귀에 들렸도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 22:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p4.b1": {
    "text": "이에 땅이 진동하고 떨며 하늘 기초가 요동하고 흔들렸으니 그의 진노를 인함이로다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 22:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p4.b2": {
    "text": "그 코에서 연기가 오르고 입에서 불이 나와 사름이여 그 불에 숯이 피었도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 22:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p4.b3": {
    "text": "저가 또 하늘을 드리우고 강림하시니 그 발 아래는 어둑캄캄하도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 22:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p4.b4": {
    "text": "그룹을 타고 날으심이여 바람 날개 위에 나타나셨도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 22:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p5.b1": {
    "text": "살을 날려 저희를 흩으시며 번개로 파하셨도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 22:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p5.b2": {
    "text": "이럴 때에 여호와의 꾸지람과 콧김을 인하여 물 밑이 드러나고 땅의 기초가 나타났도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 22:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p5.b3": {
    "text": "저가 위에서 보내사 나를 취하심이여 많은 물에서 나를 건져 내셨도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 22:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p5.b4": {
    "text": "나를 또 넓은 곳으로 인도하시고 나를 기뻐하시므로 구원하셨도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 22:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p6.b1": {
    "text": "여호와께서 내 의를 따라 상 주시며 내 손의 깨끗함을 좇아 갚으셨으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 22:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p6.b2": {
    "text": "자비한 자에게는 주의 자비하심을 나타내시며 완전한 자에게는 주의 완전하심을 보이시며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 22:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p6.b3": {
    "text": "주께서 곤고한 백성은 구원하시고 교만한 자를 살피사 낮추시리이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 22:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p7.b1": {
    "text": "여호와여 주는 나의 등불이시니 여호와께서 나의 흑암을 밝히시리이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 22:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p7.b2": {
    "text": "내가 주를 의뢰하고 적군에 달리며 내 하나님을 의지하고 성벽을 뛰어 넘나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 22:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p7.b3": {
    "text": "나의 발로 암사슴 발 같게 하시며 나를 나의 높은 곳에 세우시며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 22:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p7.b4": {
    "text": "내 손을 가르쳐 싸우게 하시니 내 팔이 놋활을 당기도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 22:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p8.b1": {
    "text": "내가 내 원수를 따라 멸하였사오며 저희를 무찌르기 전에는 돌이키지 아니하였나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 22:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p8.b2": {
    "text": "주께서 또 내 원수들로 등을 내게로 향하게 하시고 나로 나를 미워하는 자를 끊어 버리게 하셨음이니이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 22:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p8.b3": {
    "text": "이방인들이 내게 굴복함이여 저희가 내 풍성을 듣고 곧 순복하리로다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 22:45"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p8.b4": {
    "text": "이방인들이 쇠미하여 그 견고한 곳에서 떨며 나오리로다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 22:46"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p9.b1": {
    "text": "여호와는 생존하시니 나의 바위를 찬송하며 내 구원의 바위이신 하나님을 높일지로다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 22:47"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p9.b2": {
    "text": "이러므로 여호와여 내가 열방 중에서 주께 감사하며 주의 이름을 찬양하리이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 22:50"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p9.b3": {
    "text": "여호와께서 그 왕에게 큰 구원을 주시며 기름 부음 받은 자에게 인자를 베푸심이여 영원토록 다윗과 그 후손에게로다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 22:51"
    },
    "adapted": false,
    "status": "approved"
  }
}
