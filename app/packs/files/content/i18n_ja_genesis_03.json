{
  "genesis.3.p1.b1": {
    "text": "さて主なる神が造られた野の生き物のうちで、へびが最も狡猾であった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 3:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.3.p1.b2": {
    "text": "園にあるどの木からも取って食べるなと、ほんとうに神が言われたのですか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 3:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.3.p1.b3": {
    "text": "わたしたちは園の木の実を食べることは許されていますが、ただ園の中央にある木の実については、……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 3:2-3"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.3.p1.b4": {
    "text": "これを取って食べるな、これに触れるな、死んではいけないからと、神は言われました",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 3:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.3.p2.b5": {
    "text": "あなたがたは決して死ぬことはないでしょう。それを食べると、あなたがたの目が開け、神のように善悪を知る者となることを、神は知っておられるのです",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 3:4-5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.3.p2.b6": {
    "text": "女がその木を見ると、それは食べるに良く、目には美しく、賢くなるには好ましいと思われたから、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 3:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.3.p2.b7": {
    "text": "その実を取って食べ、また共にいた夫にも与えたので、彼も食べた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 3:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.3.p3.b8": {
    "text": "すると、ふたりの目が開け、自分たちの裸であることがわかったので、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 3:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.3.p3.b9": {
    "text": "いちじくの葉をつづり合わせて、腰に巻いた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 3:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.3.p3.b10": {
    "text": "日の涼しい風の吹くころ、園の中に主なる神の歩まれる音",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 3:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.3.p3.b11": {
    "text": "人とその妻とは主なる神の顔を避けて、園の木の間に身を隠した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 3:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.3.p4.b12": {
    "text": "あなたはどこにいるのか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 3:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.3.p4.b13": {
    "text": "園の中であなたの歩まれる音を聞き、わたしは裸だったので、恐れて身を隠したのです",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 3:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.3.p5.b14": {
    "text": "あなたが裸であるのを、だれが知らせたのか。食べるなと、命じておいた木から、あなたは取って食べたのか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 3:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.3.p5.b15": {
    "text": "わたしと一緒にしてくださったあの女が、木から取ってくれたので、わたしは食べたのです",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 3:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.3.p5.b16": {
    "text": "あなたは、なんということをしたのです",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 3:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.3.p5.b17": {
    "text": "へびがわたしをだましたのです。それでわたしは食べました",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 3:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.3.p6.b18": {
    "text": "おまえは、この事を、したので、すべての家畜、野のすべての獣のうち、最ものろわれる。おまえは腹で、這いあるき、一生、ちりを食べるであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 3:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.3.p6.b19": {
    "text": "わたしは恨みをおく、おまえと女とのあいだに、おまえのすえと女のすえとの間に。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 3:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.3.p6.b20": {
    "text": "彼はおまえのかしらを砕き、おまえは彼のかかとを砕くであろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 3:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.3.p7.b21": {
    "text": "わたしはあなたの産みの苦しみを大いに増す。あなたは苦しんで子を産む。それでもなお、あなたは夫を慕い、彼はあなたを治めるであろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 3:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.3.p7.b22": {
    "text": "地はあなたのためにのろわれ、あなたは一生、苦しんで地から食物を取る。地はあなたのために、いばらとあざみとを生じ、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 3:17-18"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.3.p7.b23": {
    "text": "あなたは顔に汗してパンを食べ、ついに土に帰る、あなたは土から取られたのだから。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 3:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.3.p7.b24": {
    "text": "あなたは、ちりだから、ちりに帰る",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 3:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.3.p8.b25": {
    "text": "さて、人はその妻の名をエバと名づけた。彼女がすべて生きた者の母だからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 3:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.3.p8.b26": {
    "text": "主なる神は人とその妻とのために皮の着物を造って、彼らに着せられた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 3:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.3.p9.b27": {
    "text": "見よ、人はわれわれのひとりのようになり、善悪を知るものとなった。彼は手を伸べ、命の木からも取って食べ、永久に生きるかも知れない",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 3:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.3.p9.b28": {
    "text": "そこで主なる神は彼をエデンの園から追い出して、人が造られたその土を耕させられた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 3:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.3.p9.b29": {
    "text": "神は人を追い出し、エデンの園の東に、ケルビムと、回る炎のつるぎとを置いて、命の木の道を守らせられた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 3:24"
    },
    "adapted": false,
    "status": "approved"
  }
}
