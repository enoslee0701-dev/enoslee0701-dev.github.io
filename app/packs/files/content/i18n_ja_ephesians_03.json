{
  "ephesians.3.p1.b1": {
    "text": "こういうわけで、あなたがた異邦人のためにキリスト・イエスの囚人となっているこのパウロ …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 3:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.3.p1.b2": {
    "text": "わたしがあなたがたのために神から賜わった恵みの務について、あなたがたはたしかに聞いたであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 3:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.3.p2.b1": {
    "text": "すなわち、すでに簡単に書きおくったように、わたしは啓示によって奥義を知らされたのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 3:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.3.p2.b2": {
    "text": "それは、異邦人が、福音によりキリスト・イエスにあって、わたしたちと共に神の国をつぐ者となり、共に一つのからだとなり、共に約束にあずかる者となることである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 3:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.3.p2.b3": {
    "text": "わたしは、… 自分に与えられた神の恵みの賜物により、福音の僕とされたのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 3:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.3.p3.b1": {
    "text": "すなわち、聖徒たちのうちで最も小さい者であるわたしにこの恵みが与えられたが、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 3:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.3.p3.b2": {
    "text": "この主キリストにあって、わたしたちは、彼に対する信仰によって、確信をもって大胆に神に近づくことができるのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 3:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.3.p3.b3": {
    "text": "だから、あなたがたのためにわたしが受けている患難を見て、落胆しないでいてもらいたい。わたしの患難は、あなたがたの光栄なのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 3:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.3.p4.b1": {
    "text": "こういうわけで、わたしはひざをかがめて、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 3:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.3.p4.b2": {
    "text": "どうか父が、その栄光の富にしたがい、御霊により、力をもってあなたがたの内なる人を強くして下さるように、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 3:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.3.p5.b1": {
    "text": "また、信仰によって、キリストがあなたがたの心のうちに住み、あなたがたが愛に根ざし愛を基として生活することにより、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 3:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.3.p5.b2": {
    "text": "すべての聖徒と共に、その広さ、長さ、高さ、深さを理解することができ、また人知をはるかに越えたキリストの愛を知って、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 3:18-19"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.3.p6.b1": {
    "text": "どうか、わたしたちのうちに働く力によって、わたしたちが求めまた思うところのいっさいを、はるかに越えてかなえて下さることができるかたに、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 3:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.3.p6.b2": {
    "text": "教会により、また、キリスト・イエスによって、栄光が世々限りなくあるように、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 3:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "ephesians.3.p6.b3": {
    "text": "アァメン。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ephesians 3:21"
    },
    "adapted": false,
    "status": "approved"
  }
}
