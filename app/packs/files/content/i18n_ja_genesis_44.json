{
  "genesis.44.p1.b1": {
    "text": "この人々の袋に、運べるだけ多くの食糧を満たし、めいめいの銀を袋の口に入れておきなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 44:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.44.p1.b2": {
    "text": "またわたしの杯、銀の杯をあの年下の者の袋の口に、穀物の代金と共に入れておきなさい",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 44:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.44.p1.b3": {
    "text": "家づかさはヨセフの言葉のとおりにした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 44:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.44.p1.b4": {
    "text": "夜が明けると、その人々と、ろばとは送り出されたが、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 44:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.44.p2.b1": {
    "text": "立って、あの人々のあとを追いなさい。追いついて、彼らに言いなさい、…あなたがたはなぜ悪をもって善に報いるのですか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 44:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.44.p2.b2": {
    "text": "これはわたしの主人が飲む時に使い、またいつも占いに用いるものではありませんか。あなたがたのした事は悪いことです』」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 44:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.44.p2.b3": {
    "text": "袋の口で見つけた銀でさえ、カナンの地からあなたの所に持ち帰ったほどです。どうして、われわれは御主人の家から銀や金を盗みましょう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 44:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.44.p2.b4": {
    "text": "杯の見つかった者はわたしの奴隷とならなければならない。ほかの者は無罪です",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 44:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.44.p3.b1": {
    "text": "家づかさは年上から捜し始めて年下に終ったが、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 44:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.44.p3.b2": {
    "text": "杯はベニヤミンの袋の中にあった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 44:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.44.p3.b3": {
    "text": "そこで彼らは衣服を裂き、おのおの、ろばに荷を負わせて町に引き返した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 44:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.44.p4.b1": {
    "text": "ユダと兄弟たちとは、ヨセフの家にはいったが、ヨセフがなおそこにいたので、彼らはその前で地にひれ伏した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 44:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.44.p4.b2": {
    "text": "あなたがたのこのしわざは何事ですか。わたしのような人は、必ず占い当てることを知らないのですか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 44:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.44.p4.b3": {
    "text": "神がしもべらの罪をあばかれました。われわれと、杯を持っていた者とは共にわが主の奴隷となりましょう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 44:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.44.p4.b4": {
    "text": "杯を持っている者だけがわたしの奴隷とならなければならない。ほかの者は安全に父のもとへ上って行きなさい",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 44:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.44.p5.b1": {
    "text": "ああ、わが主よ、どうぞわが主の耳にひとこと言わせてください。しもべをおこらないでください。あなたはパロのようなかたです。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 44:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.44.p5.b2": {
    "text": "わが主はしもべらに尋ねて、『父があるか、また弟があるか』と言われたので、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 44:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.44.p5.b3": {
    "text": "その兄は死んで、同じ母の子で残っているのは、ただこれだけですから父はこれを愛しています",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 44:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.44.p5.b4": {
    "text": "しかし、あなたはしもべらに言われました、『末の弟が一緒に下ってこなければ、おまえたちは再びわたしの顔を見ることはできない』。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 44:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.44.p6.b1": {
    "text": "ところで、父が『おまえたちは再び行って、われわれのために少しの食糧を買ってくるように』と言ったので、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 44:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.44.p6.b2": {
    "text": "末の弟が一緒でなければ、あの人の顔を見ることができません",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 44:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.44.p6.b3": {
    "text": "ひとりは外へ出たが、きっと裂き殺されたのだと思う。わたしは今になっても彼を見ない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 44:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.44.p6.b4": {
    "text": "おまえたちは、しらがのわたしを悲しんで陰府に下らせるであろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 44:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.44.p7.b1": {
    "text": "父の魂は子供の魂に結ばれているのです。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 44:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.44.p7.b2": {
    "text": "この子供がわれわれと一緒にいないのを見たら、父は死ぬでしょう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 44:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.44.p7.b3": {
    "text": "『もしわたしがこの子をあなたのもとに連れ帰らなかったら、わたしは父に対して永久に罪を負いましょう』",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 44:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.44.p8.b1": {
    "text": "どうか、しもべをこの子供の代りに、わが主の奴隷としてとどまらせ、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 44:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.44.p8.b2": {
    "text": "この子供を兄弟たちと一緒に上り行かせてください、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 44:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.44.p9.b1": {
    "text": "この子供を連れずに、どうしてわたしは父のもとに上り行くことができましょう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 44:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.44.p9.b2": {
    "text": "父が災に会うのを見るに忍びません",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 44:34"
    },
    "adapted": false,
    "status": "approved"
  }
}
