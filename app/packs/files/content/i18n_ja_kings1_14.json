{
  "kings1.14.p1.b1": {
    "text": "そのころヤラベアムの子アビヤが病気になった……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 14:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.14.p1.b2": {
    "text": "「立って姿を変え、ヤラベアムの妻であることの知られないようにしてシロへ行きなさい。……預言者アヒヤがそこにいます」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 14:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.14.p1.b3": {
    "text": "「パン十個と菓子数個および、みつ一びんを携えて彼のところへ行きなさい。彼はこの子がどうなるかをあなたに告げるでしょう」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 14:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.14.p2.b1": {
    "text": "ヤラベアムの妻はそのようにして、立ってシロへ行き、アヒヤの家に着いたが、アヒヤは年老いたため、目がかすんで見ることができなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 14:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.14.p2.b2": {
    "text": "「ヤラベアムの妻が子供の事をあなたに尋ねるために来る……」彼女は来るとき、他人を装っていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 14:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.14.p2.b3": {
    "text": "「ヤラベアムの妻よ、はいりなさい。なぜ、他人を装うのですか」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 14:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.14.p3.b1": {
    "text": "「イスラエルの神、主はこう仰せられる、『わたしはあなたを民のうちからあげ、わたしの民イスラエルの上に立てて君とし……』」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 14:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.14.p3.b2": {
    "text": "「あなたよりも先にいたすべての者にまさって悪をなし、行って自分のために他の神々と鋳た像を造り、わたしを怒らせ、わたしをうしろに捨て去った」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 14:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.14.p3.b3": {
    "text": "「……人があくたを残りなく焼きつくすように、ヤラベアムの家を全く断ち滅ぼすであろう」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 14:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.14.p3.b4": {
    "text": "「ヤラベアムに属する者は、町で死ぬ者を犬が食べ、野で死ぬ者を空の鳥が食べるであろう」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 14:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.14.p4.b1": {
    "text": "「あなたは立って、家へ帰りなさい。あなたの足が町にはいる時に、子どもは死にます」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 14:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.14.p4.b2": {
    "text": "「……ヤラベアムに属する者は、ただ彼だけ墓に葬られるでしょう」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 14:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.14.p4.b3": {
    "text": "「その後主はイスラエルを撃って、水に揺らぐ葦のようにし……」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 14:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.14.p4.b4": {
    "text": "「主はヤラベアムの罪のゆえに……イスラエルを捨てられるでしょう」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 14:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.14.p5.b1": {
    "text": "ヤラベアムの妻は立って去り、テルザへ行って、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 14:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.14.p5.b2": {
    "text": "家の敷居をまたいだ時、子どもは死んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 14:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.14.p5.b3": {
    "text": "イスラエルは皆彼を葬り、彼のために悲しんだ。主がそのしもべ預言者アヒヤによって言われた言葉のとおりである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 14:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.14.p5.b4": {
    "text": "ヤラベアムが世を治めた日は二十二年であった。彼はその先祖と共に眠って、その子ナダブが代って王となった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 14:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.14.p6.b1": {
    "text": "ソロモンの子レハベアムはユダで世を治めた。レハベアムは王となったとき四十一歳であったが……十七年世を治めた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 14:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.14.p6.b2": {
    "text": "彼らもすべての高い丘の上と、すべての青木の下に、高き所と石の柱とアシラ像とを建てたからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 14:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.14.p6.b3": {
    "text": "レハベアムの王の第五年にエジプトの王シシャクがエルサレムに攻め上ってきて、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 14:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.14.p7.b1": {
    "text": "……またソロモンの造った金の盾をみな奪い去った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 14:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.14.p7.b2": {
    "text": "レハベアムはその代りに青銅の盾を造って……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 14:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.14.p7.b3": {
    "text": "王が主の宮にはいるごとに、侍衛はそれを携え、また、それを侍衛のへやへ持ち帰った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 14:28"
    },
    "adapted": false,
    "status": "approved"
  }
}
