{
  "acts.12.p1.b1": {
    "text": "那时，希律王下手苦害教会中几个人，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "那⁠时，希⁠律王下⁠手苦害教⁠会中几⁠个人，"
  },
  "acts.12.p1.b2": {
    "text": "用刀杀了约翰的哥哥雅各。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "用刀杀了约⁠翰的哥⁠哥雅⁠各。"
  },
  "acts.12.p1.b3": {
    "text": "他见犹太人喜欢这事，又去捉拿彼得。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:3"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他见犹⁠太⁠人喜⁠欢这事，又⁠去捉⁠拿彼⁠得。"
  },
  "acts.12.p1.b4": {
    "text": "那时正是除酵的日子。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:3"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "那⁠时正⁠是除酵的日⁠子。"
  },
  "acts.12.p2.b5": {
    "text": "希律拿了彼得，收在监里，交付四班兵丁看守，每班四个人，……",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:4"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "希⁠律拿了彼⁠得，收在监里，交⁠付四⁠班兵⁠丁看⁠守，每⁠班四个⁠人，……"
  },
  "acts.12.p2.b6": {
    "text": "于是彼得被囚在监里；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:5"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "于⁠是彼⁠得被囚在监里；"
  },
  "acts.12.p2.b7": {
    "text": "教会却为他切切地祷告　神。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:5"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "教⁠会却为他切⁠切地祷⁠告　神。"
  },
  "acts.12.p2.b8": {
    "text": "希律将要提他出来的前一夜，彼得被两条铁链锁着，睡在两个兵丁当中；看守的人也在门外看守。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:6"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "希⁠律将⁠要提他出⁠来的前一⁠夜，彼⁠得被两条铁⁠链锁着，睡⁠在两个兵⁠丁当⁠中；看⁠守的人也⁠在门⁠外看⁠守。"
  },
  "acts.12.p3.b9": {
    "text": "忽然，有主的一个使者站在旁边，屋里有光照耀，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "忽⁠然，有主的一⁠个使⁠者站⁠在旁⁠边，屋里有⁠光照⁠耀，"
  },
  "acts.12.p3.b10": {
    "text": "天使拍彼得的肋旁，拍醒了他，说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "天⁠使拍彼⁠得的肋旁，拍醒了他，说："
  },
  "acts.12.p3.b11": {
    "text": "「快快起来！」",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "「快⁠快起⁠来！」"
  },
  "acts.12.p3.b12": {
    "text": "那铁链就从他手上脱落下来。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "那铁⁠链就从他手⁠上脱⁠落下⁠来。"
  },
  "acts.12.p4.b13": {
    "text": "「束上带子，穿上鞋。」",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "「束上带⁠子，穿⁠上鞋。」"
  },
  "acts.12.p4.b14": {
    "text": "「披上外衣，跟着我来。」",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "「披⁠上外⁠衣，跟⁠着我⁠来。」"
  },
  "acts.12.p4.b15": {
    "text": "彼得就出来跟着他，不知道天使所做是真的，只当见了异象。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:9"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "彼⁠得就出⁠来跟⁠着他，不⁠知⁠道天⁠使所做是真⁠的，只当见⁠了异象。"
  },
  "acts.12.p4.b16": {
    "text": "过了第一层第二层监牢，就来到临街的铁门，那门自己开了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:10"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "过了第一⁠层第⁠二层监⁠牢，就来⁠到临⁠街的铁门，那门自⁠己开了。"
  },
  "acts.12.p5.b17": {
    "text": "他们出来，走过一条街，天使便离开他去了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:10"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠们出⁠来，走⁠过一⁠条街，天⁠使便离⁠开他去⁠了。"
  },
  "acts.12.p5.b18": {
    "text": "彼得醒悟过来，说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:11"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "彼⁠得醒⁠悟过⁠来，说："
  },
  "acts.12.p5.b19": {
    "text": "「我现在真知道主差遣他的使者，救我脱离希律的手和犹太百姓一切所盼望的。」",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:11"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "「我现⁠在真知⁠道主差⁠遣他⁠的使⁠者，救我脱⁠离希⁠律的手和犹⁠太百⁠姓一⁠切所盼⁠望的。」"
  },
  "acts.12.p5.b20": {
    "text": "想了一想，就往那称呼马可的约翰、他母亲马利亚家去，在那里有好些人聚集祷告。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:12"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "想⁠了一⁠想，就往那称⁠呼马可的约⁠翰、他母⁠亲马⁠利⁠亚家去，在那⁠里有好⁠些人聚⁠集祷⁠告。"
  },
  "acts.12.p6.b21": {
    "text": "彼得敲外门，有一个使女，名叫罗大，出来探听，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "彼⁠得敲外门，有一⁠个使女，名⁠叫罗大，出⁠来探听，"
  },
  "acts.12.p6.b22": {
    "text": "听得是彼得的声音，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:14"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "听得是彼⁠得的声⁠音，"
  },
  "acts.12.p6.b23": {
    "text": "就欢喜的顾不得开门，跑进去告诉众人说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:14"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "就欢⁠喜的顾⁠不⁠得开⁠门，跑进⁠去告⁠诉众⁠人说："
  },
  "acts.12.p6.b24": {
    "text": "「彼得站在门外。」",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:14"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "「彼⁠得站⁠在门⁠外。」"
  },
  "acts.12.p7.b25": {
    "text": "「你是疯了！」",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:15"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "「你⁠是疯⁠了！」"
  },
  "acts.12.p7.b26": {
    "text": "「真是他！」",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:15"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "「真⁠是他！」"
  },
  "acts.12.p7.b27": {
    "text": "「必是他的天使！」",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:15"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "「必⁠是他⁠的天⁠使！」"
  },
  "acts.12.p7.b28": {
    "text": "彼得不住地敲门。他们开了门，看见他，就甚惊奇。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:16"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "彼⁠得不⁠住地敲⁠门。他⁠们开了门，看⁠见他，就甚惊⁠奇。"
  },
  "acts.12.p8.b29": {
    "text": "彼得摆手，不要他们作声，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:17"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "彼⁠得摆⁠手，不⁠要他⁠们作声，"
  },
  "acts.12.p8.b30": {
    "text": "就告诉他们主怎样领他出监；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:17"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "就告⁠诉他⁠们主怎⁠样领他出监；"
  },
  "acts.12.p8.b31": {
    "text": "「你们把这事告诉雅各和众弟兄。」",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:17"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "「你⁠们把这事告⁠诉雅⁠各和众弟⁠兄。」"
  },
  "acts.12.p8.b32": {
    "text": "于是出去，往别处去了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:17"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "于⁠是出⁠去，往别⁠处去⁠了。"
  },
  "acts.12.p9.b33": {
    "text": "到了天亮，兵丁扰乱得很，不知道彼得往哪里去了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:18"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "到⁠了天⁠亮，兵⁠丁扰⁠乱得⁠很，不⁠知⁠道彼⁠得往哪⁠里去⁠了。"
  },
  "acts.12.p9.b34": {
    "text": "希律找他，找不着，就审问看守的人，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:19"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "希⁠律找他，找不⁠着，就审⁠问看⁠守的人，"
  },
  "acts.12.p9.b35": {
    "text": "吩咐把他们拉去杀了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:19"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "吩⁠咐把他⁠们拉⁠去杀了。"
  },
  "acts.12.p9.b36": {
    "text": "后来希律离开犹太，下凯撒利亚去，住在那里。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:19"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "后⁠来希⁠律离⁠开犹⁠太，下凯撒利⁠亚去，住⁠在那⁠里。"
  },
  "acts.12.p10.b37": {
    "text": "希律恼怒泰尔、西顿的人。他们……就托了王的内侍臣伯拉斯都的情，一心来求和。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:20"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "希⁠律恼⁠怒泰尔、西⁠顿的人。他⁠们……就托了王的内侍⁠臣伯拉斯都的情，一⁠心来求和。"
  },
  "acts.12.p10.b38": {
    "text": "他们那一带地方是从王的地土得粮，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:20"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠们那一⁠带地⁠方是从王的地土得粮，"
  },
  "acts.12.p10.b39": {
    "text": "希律在所定的日子，穿上朝服，坐在位上，对他们讲论一番。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:21"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "希⁠律在所⁠定的日⁠子，穿⁠上朝⁠服，坐⁠在位上，对他⁠们讲论一⁠番。"
  },
  "acts.12.p10.b40": {
    "text": "「这是神的声音，」",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:22"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "「这是神的声⁠音，」"
  },
  "acts.12.p10.b41": {
    "text": "「不是人的声音。」",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:22"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "「不⁠是人⁠的声⁠音。」"
  },
  "acts.12.p11.b42": {
    "text": "希律不归荣耀给　神，所以主的使者立刻罚他，……气就绝了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:23"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "希⁠律不归荣⁠耀给　神，所⁠以主的使⁠者立⁠刻罚他，……气就绝了。"
  },
  "acts.12.p11.b43": {
    "text": "神的道日见兴旺，越发广传。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:24"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "神的道日见兴⁠旺，越发广传。"
  },
  "acts.12.p11.b44": {
    "text": "巴拿巴和扫罗办完了他们供给的事，就从耶路撒冷回来，带着称呼马可的约翰同去。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 12:25"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "巴拿巴和扫罗办完⁠了他⁠们供⁠给的事，就从耶⁠路撒⁠冷回⁠来，带着称⁠呼马可的约⁠翰同⁠去。"
  }
}
