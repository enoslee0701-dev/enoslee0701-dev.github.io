{
  "samuel2.9.p1.b1": {
    "text": "사울의 집에 오히려 남은 사람이 있느냐 내가 요나단을 인하여 그 사람에게 은총을 베풀리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 9:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p1.b2": {
    "text": "종이 그로소이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 9:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p1.b3": {
    "text": "요나단의 아들 하나가 있는데 절뚝발이니이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 9:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p1.b4": {
    "text": "그가 어디 있느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 9:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p2.b1": {
    "text": "로드발 암미엘의 아들 마길의 집에 있나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 9:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p2.b2": {
    "text": "다윗 왕이 사람을 보내어 로드발 암미엘의 아들 마길의 집에서 저를 데려오니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 9:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p2.b3": {
    "text": "므비보셋이여",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 9:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p2.b4": {
    "text": "주의 종이 여기 있나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 9:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p3.b1": {
    "text": "무서워 말라 내가 반드시 네 아비 요나단을 인하여 네게 은총을 베풀리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 9:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p3.b2": {
    "text": "내가 네 조부 사울의 밭을 다 네게 도로 주겠고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 9:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p3.b3": {
    "text": "또 너는 항상 내 상에서 먹을지니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 9:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p3.b4": {
    "text": "이 종이 무엇이관대 왕께서 죽은 개 같은 나를 돌아보시나이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 9:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p4.b1": {
    "text": "사울과 그 온 집에 속한 것은 내가 다 네 주인의 아들에게 주었노니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 9:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p4.b2": {
    "text": "시바는 아들이 열 다섯이요 종이 스물이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 9:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p4.b3": {
    "text": "내 주 왕께서 온갖 일을 종에게 명하신대로 종이 준행하겠나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 9:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p4.b4": {
    "text": "므비보셋은 왕자 중 하나처럼 왕의 상에서 먹으니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 9:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p5.b1": {
    "text": "므비보셋이 … 예루살렘에 거하니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 9:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p5.b2": {
    "text": "항상 왕의 상에서 먹으므로",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 9:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p5.b3": {
    "text": "그는 두 발이 다 절뚝이더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 9:13"
    },
    "adapted": false,
    "status": "approved"
  }
}
