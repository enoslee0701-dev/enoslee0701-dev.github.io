{
  "samuel2.9.p1.b1": {
    "text": "“Is there anyone left from the house of Saul to whom I can show kindness for the sake of Jonathan?”",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Samuel 9:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p1.b2": {
    "text": "“I am your servant,” he replied.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Samuel 9:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p1.b3": {
    "text": "“There is still Jonathan’s son, who is lame in both feet.”",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Samuel 9:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p1.b4": {
    "text": "“Where is he?” replied the king.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Samuel 9:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p2.b1": {
    "text": "“Indeed, he is in Lo-debar at the house of Machir son of Ammiel.”",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Samuel 9:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p2.b2": {
    "text": "So King David had him brought from the house of Machir son of Ammiel in Lo-debar.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Samuel 9:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p2.b3": {
    "text": "Then David said, “Mephibosheth!”",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Samuel 9:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p2.b4": {
    "text": "“I am your servant,” he replied.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Samuel 9:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p3.b1": {
    "text": "“Do not be afraid,” said David, “for surely I will show you kindness for the sake of your father Jonathan.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Samuel 9:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p3.b2": {
    "text": "I will restore to you all the land of your grandfather Saul,",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Samuel 9:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p3.b3": {
    "text": "and you will always eat at my table.”",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Samuel 9:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p3.b4": {
    "text": "“What is your servant, that you should show regard for a dead dog like me?”",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Samuel 9:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p4.b1": {
    "text": "“I have given to your master’s grandson all that belonged to Saul and to all his house.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Samuel 9:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p4.b2": {
    "text": "Now Ziba had fifteen sons and twenty servants.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Samuel 9:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p4.b3": {
    "text": "“Your servant will do all that my lord the king has commanded.”",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Samuel 9:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p4.b4": {
    "text": "So Mephibosheth ate at David’s table like one of the king’s own sons.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Samuel 9:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p5.b1": {
    "text": "So Mephibosheth lived in Jerusalem,",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Samuel 9:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p5.b2": {
    "text": "because he always ate at the king’s table,",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Samuel 9:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p5.b3": {
    "text": "and he was lame in both feet.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Samuel 9:13"
    },
    "adapted": false,
    "status": "approved"
  }
}
