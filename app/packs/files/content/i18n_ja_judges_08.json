{
  "judges.8.p1.b1": {
    "text": "あなたが、ミデアンびとと戦うために行かれたとき、われわれを呼ばれなかったが、どうしてそういうことをされたのですか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 8:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.8.p1.b2": {
    "text": "今わたしのした事は、あなたがたのした事と比べものになりましょうか。エフライムの拾い集めた取り残りのぶどうはアビエゼルの収穫したぶどうにもまさるではありませんか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 8:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.8.p1.b3": {
    "text": "神はミデアンの君オレブとゼエブをあなたがたの手にわたされました。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 8:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.8.p1.b4": {
    "text": "ギデオンがこの言葉を述べると、彼らの憤りは解けた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 8:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.8.p2.b5": {
    "text": "ギデオンは自分に従っていた三百人と共にヨルダンに行ってこれを渡り、疲れながらもなお追撃した",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 8:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.8.p2.b6": {
    "text": "どうぞわたしに従っている民にパンを与えてください。彼らが疲れているのに、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 8:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.8.p2.b7": {
    "text": "ゼバとザルムンナは、すでにあなたの手のうちにあるのですか。われわれはどうしてあなたの軍勢にパンを与えねばならないのですか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 8:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.8.p2.b8": {
    "text": "わたしが安らかに帰ってきたとき、このやぐらを打ちこわすであろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 8:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.8.p3.b9": {
    "text": "さてゼバとザルムンナは軍勢おおよそ一万五千人を率いて、カルコルにいた。これは皆、東方の民の全軍のうち生き残ったもので、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 8:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.8.p3.b10": {
    "text": "ギデオンはノバとヨグベハの東の隊商の道を上って、敵軍の油断しているところを撃った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 8:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.8.p3.b11": {
    "text": "ゼバとザルムンナは逃げたが、ギデオンは追撃して、ミデアンのふたりの王ゼバとザルムンナを捕え、その軍勢をことごとく撃ち敗った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 8:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.8.p4.b12": {
    "text": "スコテのつかさたち及び長老たち七十七人の名をギデオンのために書きしるした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 8:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.8.p4.b13": {
    "text": "あなたがたがかつて … わたしをののしったそのゼバとザルムンナを見なさい",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 8:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.8.p4.b14": {
    "text": "そして彼は、その町の長老たちを捕え、野のいばらと、おどろとを取り、それをもってスコテの人々を懲らし、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 8:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.8.p4.b15": {
    "text": "またペヌエルのやぐらを打ちこわして町の人々を殺した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 8:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.8.p5.b16": {
    "text": "あなたがたがタボルで殺したのは、どんな人々であったか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 8:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.8.p5.b17": {
    "text": "彼らはあなたに似てみな王子のように見えました",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 8:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.8.p5.b18": {
    "text": "彼らはわたしの兄弟、わたしの母の子たちだ。… もしあなたがたが彼らを生かしておいたならば、わたしはあなたがたを殺さないのだが",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 8:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.8.p5.b19": {
    "text": "そして長子エテルに言った、「立って、彼らを殺しなさい」。しかしその若者はなお年が若かったので、恐れてつるぎを抜かなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 8:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.8.p5.b20": {
    "text": "あなた自身が立って、わたしたちを撃ってください。人によってそれぞれ力も違いますから",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 8:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.8.p6.b21": {
    "text": "あなたはミデアンの手からわれわれを救われたのですから、あなたも、あなたの子も孫もわれわれを治めてください",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 8:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.8.p6.b22": {
    "text": "わたしはあなたがたを治めることはいたしません。またわたしの子もあなたがたを治めてはなりません。主があなたがたを治められます",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 8:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.8.p6.b23": {
    "text": "わたしはあなたがたに一つの願いがあります。あなたがたのぶんどった耳輪をめいめいわたしにください",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 8:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.8.p6.b24": {
    "text": "こうしてギデオンが求めて得た金の耳輪の重さは一千七百金シケルであった。ほかに月形の飾りと耳飾りと、ミデアンの王たちの着た紫の衣およびらくだの首に掛けた首飾りなどもあった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 8:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.8.p7.b25": {
    "text": "ギデオンはそれをもって一つのエポデを作り、それを自分の町オフラに置いた。イスラエルは皆それを慕って姦淫をおこなった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 8:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.8.p7.b26": {
    "text": "それはギデオンとその家にとって、わなとなった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 8:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.8.p7.b27": {
    "text": "このようにしてミデアンはイスラエルの人々に征服されて、再びその頭をあげることができなかった。そして国はギデオンの世にあるうち、四十年のあいだ太平であった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 8:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.8.p8.b28": {
    "text": "ギデオンは多くの妻をもっていたので、自分の子供だけで七十人あった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 8:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.8.p8.b29": {
    "text": "シケムにいた彼のめかけがまたひとりの子を産んだので、アビメレクと名づけた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 8:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.8.p8.b30": {
    "text": "ヨアシの子ギデオンは高齢に達して死に、アビエゼルびとのオフラにある父ヨアシの墓に葬られた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 8:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.8.p8.b31": {
    "text": "ギデオンが死ぬと、イスラエルの人々はまたバアルを慕って、これと姦淫を行い、バアル・ベリテを自分たちの神とした。すなわちイスラエルの人々は … 彼らの神、主を覚えず、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 8:33-34"
    },
    "adapted": false,
    "status": "approved"
  }
}
