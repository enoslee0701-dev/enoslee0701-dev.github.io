{
  "matthew.17.p1.b1": {
    "text": "엿새 후에 예수께서 베드로와 야고보와 그 형제 요한을 데리시고 따로 높은 산에 올라가셨더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p1.b2": {
    "text": "저희 앞에서 변형되사 그 얼굴이 해 같이 빛나며 옷이 빛과 같이 희어졌더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p2.b1": {
    "text": "때에 모세와 엘리야가 예수로 더불어 말씀하는 것이 저희에게 보이거늘",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p2.b2": {
    "text": "주여 우리가 여기 있는 것이 좋사오니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p2.b3": {
    "text": "주께서 만일 원하시면 내가 여기서 초막 셋을 짓되 하나는 주를 위하여, 하나는 모세를 위하여, 하나는 엘리야를 위하여 하리이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p3.b1": {
    "text": "말할 때에 홀연히 빛난 구름이 저희를 덮으며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p3.b2": {
    "text": "이는 내 사랑하는 아들이요 내 기뻐하는 자니 너희는 저의 말을 들으라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p3.b3": {
    "text": "제자들이 듣고 엎드리어 심히 두려워하니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p4.b1": {
    "text": "일어나라 두려워 말라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p4.b2": {
    "text": "제자들이 눈을 들고 보매 오직 예수 외에는 아무도 보이지 아니하더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p5.b1": {
    "text": "저희가 산에서 내려올 때에 예수께서 명하여 가라사대",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p5.b2": {
    "text": "인자가 죽은 자 가운데서 살아나기 전에는 본것을 아무에게도 이르지 말라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p5.b3": {
    "text": "그러면 어찌하여 서기관들이 엘리야가 먼저 와야 하리라 하나이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p6.b1": {
    "text": "엘리야가 과연 먼저 와서 모든 일을 회복하리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p6.b2": {
    "text": "내가 너희에게 말하노니 엘리야가 이미 왔으되 사람들이 알지 못하고 임의로 대우하였도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p6.b3": {
    "text": "인자도 이와 같이 그들에게 고난을 받으리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p6.b4": {
    "text": "그제야 제자들이 예수의 말씀하신 것이 세례 요한인 줄을 깨달으니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p7.b1": {
    "text": "저희가 무리에게 이르매 한 사람이 예수께 와서 꿇어 엎드리어 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p7.b2": {
    "text": "주여 내 아들을 불쌍히 여기소서 저가 간질로 심히 고생하여 자주 불에도 넘어지며 물에도 넘어지는지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p7.b3": {
    "text": "내가 주의 제자들에게 데리고 왔으나 능히 고치지 못하더이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p8.b1": {
    "text": "믿음이 없고 패역한 세대여 내가 얼마나 너희와 함께 있으며 얼마나 너희를 참으리요",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p8.b2": {
    "text": "그를 이리로 데려오라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p8.b3": {
    "text": "이에 예수께서 꾸짖으시니 귀신이 나가고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p8.b4": {
    "text": "아이가 그때부터 나으니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p9.b1": {
    "text": "이 때에 제자들이 종용히 예수께 나아와 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p9.b2": {
    "text": "우리는 어찌하여 쫓아내지 못하였나이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p9.b3": {
    "text": "너희 믿음이 적은 연고니라 … 너희가 만일 믿음이 한 겨자씨만큼만 있으면 이 산을 명하여 여기서 저기로 옮기라 하여도 옮길 것이요",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p9.b4": {
    "text": "또 너희가 못할 것이 없으리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p10.b1": {
    "text": "갈릴리에 모일 때에 예수께서 제자들에게 이르시되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p10.b2": {
    "text": "인자가 장차 사람들의 손에 넘기워 죽임을 당하고 제 삼일에 살아나리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:22-23"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p10.b3": {
    "text": "제자들이 심히 근심하더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p11.b1": {
    "text": "가버나움에 이르니 반 세겔 받는 자들이 베드로에게 나아와 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p11.b2": {
    "text": "너의 선생이 반 세겔을 내지 아니하느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p11.b3": {
    "text": "내신다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p11.b4": {
    "text": "시몬아 네 생각은 어떠하뇨 세상 임금들이 뉘게 관세와 정세를 받느냐 자기 아들에게냐 타인에게냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p12.b1": {
    "text": "타인에게니이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p12.b2": {
    "text": "그러하면 아들들은 세를 면하리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p12.b3": {
    "text": "그러나 우리가 저희로 오해케 하지 않기 위하여 네가 바다에 가서 낚시를 던져 먼저 오르는 고기를 가져 입을 열면 돈 한 세겔을 얻을 것이니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.17.p12.b4": {
    "text": "가져다가 나와 너를 위하여 주라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 17:27"
    },
    "adapted": false,
    "status": "approved"
  }
}
