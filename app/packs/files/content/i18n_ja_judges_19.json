{
  "judges.19.p1.b1": {
    "text": "そのころ、イスラエルに王がなかった時、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 19:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.19.p1.b2": {
    "text": "エフライムの山地の奥にひとりのレビびとが寄留していた。彼はユダのベツレヘムからひとりの女を迎えて、めかけとしていた",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 19:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.19.p1.b3": {
    "text": "そのめかけは怒って、彼のところを去り、ユダのベツレヘムの父の家に帰って、そこに四か月ばかり過ごした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 19:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.19.p1.b4": {
    "text": "そこで夫は彼女をなだめて連れ帰ろうと、しもべと二頭のろばを従え、立って彼女のあとを追って行った。……娘の父は彼を見て、喜んで迎えた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 19:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.19.p2.b1": {
    "text": "娘の父であるしゅうとが引き留めたので、彼は三日共におり、みな飲み食いしてそこに宿った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 19:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.19.p2.b2": {
    "text": "少し食事をして元気をつけ、それから出かけなさい",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 19:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.19.p2.b3": {
    "text": "どうぞもう一晩泊まって楽しく過ごしなさい",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 19:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.19.p2.b4": {
    "text": "日も暮れようとしている。どうぞもう一晩泊まりなさい。……あしたの朝はやく起きて出立し、家に帰りなさい",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 19:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.19.p3.b1": {
    "text": "しかし、その人は泊まることを好まないので、立って去り、エブスすなわちエルサレムの向かいに着いた。くらをおいた二頭のろばと彼のめかけも一緒であった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 19:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.19.p3.b2": {
    "text": "さあ、われわれは道を転じてエブスびとのこの町にはいって、そこに宿りましょう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 19:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.19.p3.b3": {
    "text": "われわれは道を転じて、イスラエルの人々の町でない外国人の町に、はいってはならない。ギベアまで行こう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 19:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.19.p3.b4": {
    "text": "ギベアへ行って宿ろうと、そこに道を転じ、町にはいって、その広場に座した。だれも彼らを家に迎えて泊めてくれる者がなかったからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 19:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.19.p4.b1": {
    "text": "時にひとりの老人が夕暮に畑の仕事から帰ってきた。この人はエフライムの山地の者で、ギベアに寄留していたのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 19:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.19.p4.b2": {
    "text": "あなたはどこへ行かれるのですか。どこからおいでになりましたか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 19:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.19.p4.b3": {
    "text": "……だれもわたしを家に泊めてくれる者がありません。われわれには、ろばのわらも飼葉もあり、……食物も酒もあって、何も欠けているものはありません",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 19:18-19"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.19.p4.b4": {
    "text": "安心しなさい。あなたの必要なものはなんでも備えましょう。ただ広場で夜を過ごしてはなりません",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 19:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.19.p5.b1": {
    "text": "彼らが楽しく過ごしていた時、町の人々の悪い者どもがその家を取り囲み、戸を打ちたたいて、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 19:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.19.p5.b2": {
    "text": "あなたの家にきた人を出しなさい。……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 19:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.19.p5.b3": {
    "text": "いいえ、兄弟たちよ、どうぞ、そんな悪いことをしないでください。……そんなつまらない事をしないでください。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 19:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.19.p5.b4": {
    "text": "しかし人々が聞きいれなかったので、その人は自分のめかけをとって彼らのところに出した。……日ののぼるころになって放し帰らせた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 19:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.19.p6.b1": {
    "text": "朝になって女は自分の主人を宿してくれた人の家の戸口にきて倒れ伏し、夜のあけるまでに及んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 19:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.19.p6.b2": {
    "text": "彼女の主人は朝起きて家の戸を開き、出て旅立とうとすると、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 19:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.19.p6.b3": {
    "text": "そのめかけである女が家の戸口に、手を敷居にかけて倒れていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 19:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.19.p7.b1": {
    "text": "起きよ、行こう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 19:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.19.p7.b2": {
    "text": "なんの答もなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 19:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.19.p7.b3": {
    "text": "そこでその人は女をろばに乗せ、立って自分の家におもむいた",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 19:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.19.p7.b4": {
    "text": "その家に着いたとき、……それをイスラエルの全領域にあまねく送った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 19:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.19.p8.b1": {
    "text": "それを見たものはみな言った、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 19:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.19.p8.b2": {
    "text": "イスラエルの人々がエジプトの地から上ってきた日から今日まで、このような事は起ったこともなく、また見たこともない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 19:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.19.p8.b3": {
    "text": "この事をよく考え、協議して言うことを決めよ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 19:30"
    },
    "adapted": false,
    "status": "approved"
  }
}
