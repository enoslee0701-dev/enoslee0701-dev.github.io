{
  "hebrews.13.p1.b1": {
    "text": "兄弟愛を続けなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 13:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.13.p1.b2": {
    "text": "旅人をもてなすことを忘れてはならない。このようにして、ある人々は、気づかないで御使たちをもてなした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 13:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.13.p1.b3": {
    "text": "獄につながれている人たちを、自分も一緒につながれている心持で思いやりなさい。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 13:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.13.p2.b4": {
    "text": "すべての人は、結婚を重んずべきである。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 13:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.13.p2.b5": {
    "text": "金銭を愛することをしないで、自分の持っているもので満足しなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 13:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.13.p2.b6": {
    "text": "「わたしは、決してあなたを離れず、あなたを捨てない」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 13:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.13.p2.b7": {
    "text": "「主はわたしの助け主である。わたしには恐れはない。人は、わたしに何ができようか」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 13:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.13.p3.b8": {
    "text": "神の言をあなたがたに語った指導者たちのことを、いつも思い起しなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 13:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.13.p3.b9": {
    "text": "彼らの生活の最後を見て、その信仰にならいなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 13:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.13.p3.b10": {
    "text": "イエス・キリストは、きのうも、きょうも、いつまでも変ることがない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 13:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.13.p4.b11": {
    "text": "… 食物によらず、恵みによって、心を強くするがよい。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 13:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.13.p4.b12": {
    "text": "なぜなら、大祭司によって罪のためにささげられるけものの血は、聖所のなかに携えて行かれるが、そのからだは、営所の外で焼かれてしまうからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 13:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.13.p4.b13": {
    "text": "だから、イエスもまた、ご自分の血で民をきよめるために、門の外で苦難を受けられたのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 13:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.13.p5.b14": {
    "text": "したがって、わたしたちも、彼のはずかしめを身に負い、営所の外に出て、みもとに行こうではないか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 13:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.13.p5.b15": {
    "text": "この地上には、永遠の都はない。きたらんとする都こそ、わたしたちの求めているものである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 13:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.13.p5.b16": {
    "text": "だから、わたしたちはイエスによって、さんびのいけにえ、すなわち、彼の御名をたたえるくちびるの実を、たえず神にささげようではないか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 13:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.13.p5.b17": {
    "text": "そして、善を行うことと施しをすることとを、忘れてはいけない。神は、このようないけにえを喜ばれる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 13:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.13.p6.b18": {
    "text": "あなたがたの指導者たちの言うことを聞きいれて、従いなさい。彼らは、神に言いひらきをすべき者として、あなたがたのたましいのために、目をさましている。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 13:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.13.p6.b19": {
    "text": "わたしがあなたがたの所に早く帰れるため、祈ってくれるように、特にお願いする。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 13:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.13.p6.b20": {
    "text": "永遠の契約の血による羊の大牧者、わたしたちの主イエスを、死人の中から引き上げられた平和の神が、… あなたがたが御旨を行うために、すべての良きものを備えて下さるように …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 13:20-21"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.13.p6.b21": {
    "text": "栄光が、世々限りなく神にあるように、アァメン。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 13:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.13.p7.b22": {
    "text": "兄弟たちよ。どうかわたしの勧めの言葉を受けいれてほしい。わたしは、ただ手みじかに書いたのだから。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 13:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.13.p7.b23": {
    "text": "わたしたちの兄弟テモテがゆるされたことを、お知らせする。もし彼が早く来れば、彼と一緒にわたしはあなたがたに会えるだろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 13:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.13.p7.b24": {
    "text": "… イタリヤからきた人々から、あなたがたによろしく。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 13:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.13.p7.b25": {
    "text": "恵みが、あなたがた一同にあるように。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 13:25"
    },
    "adapted": false,
    "status": "approved"
  }
}
