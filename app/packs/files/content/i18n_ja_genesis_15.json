{
  "genesis.15.p1.b1": {
    "text": "「アブラムよ恐れてはならない、わたしはあなたの盾である。あなたの受ける報いは、はなはだ大きいであろう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 15:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p1.b2": {
    "text": "「主なる神よ、わたしには子がなく、… あなたはわたしに何をくださろうとするのですか」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 15:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p1.b3": {
    "text": "「あなたはわたしに子を賜わらないので、わたしの家に生れたしもべが、あとつぎとなるでしょう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 15:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p2.b4": {
    "text": "「この者はあなたのあとつぎとなるべきではありません。あなたの身から出る者があとつぎとなるべきです」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 15:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p2.b5": {
    "text": "「天を仰いで、星を数えることができるなら、数えてみなさい」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 15:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p2.b6": {
    "text": "「あなたの子孫はあのようになるでしょう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 15:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p2.b7": {
    "text": "アブラムは主を信じた。主はこれを彼の義と認められた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 15:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p3.b8": {
    "text": "「わたしはこの地をあなたに与えて、これを継がせようと、あなたをカルデヤのウルから導き出した主です」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 15:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p3.b9": {
    "text": "「主なる神よ、わたしがこれを継ぐのをどうして知ることができますか」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 15:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p3.b10": {
    "text": "「三歳の雌牛と、三歳の雌やぎと、三歳の雄羊と、山ばとと、家ばとのひなとをわたしの所に連れてきなさい」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 15:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p3.b11": {
    "text": "荒い鳥が死体の上に降りるとき、アブラムはこれを追い払った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 15:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p4.b12": {
    "text": "日の入るころ、アブラムが深い眠りにおそわれた時、大きな恐ろしい暗やみが彼に臨んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 15:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p4.b13": {
    "text": "「あなたはよく心にとめておきなさい。あなたの子孫は他の国に旅びととなって、その人々に仕え、その人々は彼らを四百年の間、悩ますでしょう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 15:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p4.b14": {
    "text": "… その後かれらは多くの財産を携えて出て来るでしょう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 15:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p4.b15": {
    "text": "あなたは安らかに先祖のもとに行きます。… 四代目になって彼らはここに帰って来るでしょう。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 15:15-16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p5.b16": {
    "text": "やがて日は入り、暗やみになった時、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 15:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p5.b17": {
    "text": "煙の立つかまど、炎の出るたいまつが、裂いたものの間を通り過ぎた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 15:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p6.b18": {
    "text": "その日、主はアブラムと契約を結んで言われた、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 15:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p6.b19": {
    "text": "「わたしはこの地をあなたの子孫に与える。エジプトの川から、かの大川ユフラテまで。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 15:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p6.b20": {
    "text": "すなわちケニびと、ケニジびと、カドモニびと、 ヘテびと、ペリジびと、レパイムびと、 アモリびと、カナンびと、ギルガシびと、エブスびとの地を与える」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 15:19-21"
    },
    "adapted": false,
    "status": "approved"
  }
}
