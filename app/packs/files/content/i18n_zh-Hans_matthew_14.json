{
  "matthew.14.p1.b1": {
    "text": "那时，分封的王希律听见耶稣的名声，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "那⁠时，分⁠封的王希⁠律听⁠见耶⁠稣的名⁠声，"
  },
  "matthew.14.p1.b2": {
    "text": "这是施洗的约翰从死里复活，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "这是施⁠洗的约⁠翰从死里复⁠活，"
  },
  "matthew.14.p1.b3": {
    "text": "所以这些异能从他里面发出来。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "所⁠以这⁠些异⁠能从他里⁠面发出⁠来。"
  },
  "matthew.14.p2.b1": {
    "text": "起先，希律为他兄弟腓力的妻子希罗底的缘故，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:3"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "起⁠先，希⁠律为他兄⁠弟腓⁠力的妻⁠子希⁠罗⁠底的缘⁠故，"
  },
  "matthew.14.p2.b2": {
    "text": "把约翰拿住，锁在监里。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:3"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "把约⁠翰拿⁠住，锁在监里。"
  },
  "matthew.14.p2.b3": {
    "text": "你娶这妇人是不合理的。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:4"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你娶这妇⁠人是不⁠合⁠理的。"
  },
  "matthew.14.p2.b4": {
    "text": "希律就想要杀他，只是怕百姓，因为他们以约翰为先知。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:5"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "希⁠律就想⁠要杀他，只⁠是怕百⁠姓，因⁠为他⁠们以约⁠翰为先⁠知。"
  },
  "matthew.14.p3.b1": {
    "text": "到了希律的生日，希罗底的女儿在众人面前跳舞，使希律欢喜。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:6"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "到⁠了希⁠律的生⁠日，希⁠罗⁠底的女⁠儿在众⁠人面⁠前跳⁠舞，使希⁠律欢⁠喜。"
  },
  "matthew.14.p3.b2": {
    "text": "希律就起誓，应许随她所求的给她。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "希⁠律就起⁠誓，应⁠许随她所求的给她。"
  },
  "matthew.14.p3.b3": {
    "text": "女儿被母亲所使，就说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "女⁠儿被母⁠亲所使，就说："
  },
  "matthew.14.p3.b4": {
    "text": "请把施洗约翰的头放在盘子里，拿来给我。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "请把施⁠洗约⁠翰的头放⁠在盘⁠子里，拿⁠来给我。"
  },
  "matthew.14.p4.b1": {
    "text": "王便忧愁，但因他所起的誓，又因同席的人，就吩咐给她；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:9"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "王便忧⁠愁，但因他⁠所起的誓，又因同⁠席的人，就吩⁠咐给她；"
  },
  "matthew.14.p4.b2": {
    "text": "于是打发人去，在监里斩了约翰，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:10"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "于⁠是打⁠发人⁠去，在监里斩了约⁠翰，"
  },
  "matthew.14.p4.b3": {
    "text": "把头放在盘子里，拿来给了女子；女子拿去给她母亲。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:11"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "把⁠头放⁠在盘⁠子里，拿⁠来给了女⁠子；女⁠子拿⁠去给她母⁠亲。"
  },
  "matthew.14.p5.b1": {
    "text": "约翰的门徒来，把尸首领去埋葬了，就去告诉耶稣。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:12"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "约⁠翰的门⁠徒来，把尸⁠首领⁠去埋⁠葬了，就⁠去告⁠诉耶⁠稣。"
  },
  "matthew.14.p5.b2": {
    "text": "耶稣听见了，就上船从那里独自退到野地里去。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣听⁠见⁠了，就上⁠船从那⁠里独⁠自退⁠到野⁠地里去。"
  },
  "matthew.14.p5.b3": {
    "text": "众人听见，就从各城里步行跟随他。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "众⁠人听⁠见，就从各城里步⁠行跟⁠随他。"
  },
  "matthew.14.p6.b1": {
    "text": "耶稣出来，见有许多的人，就怜悯他们，治好了他们的病人。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:14"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣出⁠来，见有许⁠多的人，就怜⁠悯他⁠们，治⁠好了他⁠们的病⁠人。"
  },
  "matthew.14.p6.b2": {
    "text": "天将晚的时候，门徒进前来，说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:15"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "天将晚的时⁠候，门⁠徒进前来，说："
  },
  "matthew.14.p6.b3": {
    "text": "这是野地，时候已经过了，请叫众人散开，他们好往村子里去，自己买吃的。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:15"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "这是野⁠地，时⁠候已⁠经过了，请叫众⁠人散⁠开，他⁠们好往村⁠子里去，自⁠己买吃的。"
  },
  "matthew.14.p6.b4": {
    "text": "不用他们去，你们给他们吃吧！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:16"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "不⁠用他⁠们去，你⁠们给他⁠们吃吧！"
  },
  "matthew.14.p7.b1": {
    "text": "我们这里只有五个饼，两条鱼。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:17"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我⁠们这⁠里只⁠有五个饼，两条鱼。"
  },
  "matthew.14.p7.b2": {
    "text": "拿过来给我。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:18"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "拿过⁠来给我。"
  },
  "matthew.14.p7.b3": {
    "text": "于是吩咐众人坐在草地上，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:19"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "于⁠是吩⁠咐众⁠人坐⁠在草⁠地上，"
  },
  "matthew.14.p7.b4": {
    "text": "就拿着这五个饼，两条鱼，望着天祝福，擘开饼，递给门徒，门徒又递给众人。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:19"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "就⁠拿着这五个饼，两条鱼，望着天祝⁠福，擘开饼，递给门⁠徒，门⁠徒又递给众⁠人。"
  },
  "matthew.14.p8.b1": {
    "text": "他们都吃，并且吃饱了，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:20"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠们都吃，并⁠且吃饱了，"
  },
  "matthew.14.p8.b2": {
    "text": "把剩下的零碎收拾起来，装满了十二个篮子。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:20"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "把剩⁠下的零⁠碎收⁠拾起⁠来，装⁠满了十⁠二⁠个篮⁠子。"
  },
  "matthew.14.p8.b3": {
    "text": "吃的人，除了妇女孩子，约有五千。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:21"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "吃的人，除⁠了妇⁠女孩⁠子，约有五⁠千。"
  },
  "matthew.14.p9.b1": {
    "text": "耶稣随即催门徒上船，先渡到那边去，等他叫众人散开。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:22"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣随⁠即催门⁠徒上⁠船，先渡到那⁠边去，等他叫众⁠人散⁠开。"
  },
  "matthew.14.p9.b2": {
    "text": "散了众人以后，他就独自上山去祷告。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:23"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "散了众⁠人以⁠后，他就独⁠自上⁠山去祷⁠告。"
  },
  "matthew.14.p9.b3": {
    "text": "到了晚上，只有他一人在那里。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:23"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "到⁠了晚⁠上，只⁠有他一⁠人在那⁠里。"
  },
  "matthew.14.p10.b1": {
    "text": "那时船在海中，因风不顺，被浪摇撼。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:24"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "那⁠时船在海⁠中，因风不顺，被浪摇⁠撼。"
  },
  "matthew.14.p10.b2": {
    "text": "夜里四更天，耶稣在海面上走，往门徒那里去。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:25"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "夜⁠里四更天，耶⁠稣在海⁠面上走，往门⁠徒那⁠里去。"
  },
  "matthew.14.p10.b3": {
    "text": "是个鬼怪！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:26"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "是个鬼⁠怪！"
  },
  "matthew.14.p10.b4": {
    "text": "你们放心，是我，不要怕！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:27"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们放⁠心，是我，不⁠要怕！"
  },
  "matthew.14.p11.b1": {
    "text": "主，如果是你，请叫我从水面上走到你那里去。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:28"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "主，如⁠果是你，请叫我从水⁠面⁠上走⁠到你那⁠里去。"
  },
  "matthew.14.p11.b2": {
    "text": "你来吧。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:29"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠来吧。"
  },
  "matthew.14.p11.b3": {
    "text": "彼得就从船上下去，在水面上走，要到耶稣那里去；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:29"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "彼⁠得就从船⁠上下⁠去，在水⁠面⁠上走，要⁠到耶⁠稣那⁠里去；"
  },
  "matthew.14.p12.b1": {
    "text": "只因见风甚大，就害怕，将要沉下去，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:30"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "只⁠因见风甚⁠大，就害⁠怕，将⁠要沉⁠下⁠去，"
  },
  "matthew.14.p12.b2": {
    "text": "主啊，救我！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.14.p12.b3": {
    "text": "耶稣赶紧伸手拉住他，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:31"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣赶⁠紧伸⁠手拉⁠住他，"
  },
  "matthew.14.p12.b4": {
    "text": "你这小信的人哪，为什么疑惑呢？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:31"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你这小信的人哪，为⁠什⁠么疑⁠惑呢？"
  },
  "matthew.14.p13.b1": {
    "text": "他们上了船，风就住了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:32"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠们上⁠了船，风就住了。"
  },
  "matthew.14.p13.b2": {
    "text": "在船上的人都拜他，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:33"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "在船⁠上的人都拜他，"
  },
  "matthew.14.p13.b3": {
    "text": "你真是　神的儿子了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:33"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你真⁠是　神的儿⁠子了。"
  },
  "matthew.14.p14.b1": {
    "text": "他们过了海，来到革尼撒勒地方。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:34"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠们过了海，来⁠到革⁠尼撒⁠勒地⁠方。"
  },
  "matthew.14.p14.b2": {
    "text": "那里的人一认出是耶稣，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:35"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "那⁠里的人一认⁠出是耶⁠稣，"
  },
  "matthew.14.p14.b3": {
    "text": "就打发人到周围地方去，把所有的病人带到他那里，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:35"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "就打⁠发人到周⁠围地⁠方去，把所⁠有的病⁠人带⁠到他那⁠里，"
  },
  "matthew.14.p15.b1": {
    "text": "只求耶稣准他们摸他的衣裳繸子；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:36"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "只⁠求耶⁠稣准他⁠们摸他⁠的衣⁠裳繸子；"
  },
  "matthew.14.p15.b2": {
    "text": "摸着的人就都好了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 14:36"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "摸着的人就都好⁠了。"
  }
}
