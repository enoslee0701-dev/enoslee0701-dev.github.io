{
  "genesis.13.p1.b1": {
    "text": "アブラムは妻とすべての持ち物を携え、エジプトを出て、ネゲブに上った。ロトも彼と共に上った。 アブラムは家畜と金銀に非常に富んでいた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 13:1-2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.13.p1.b2": {
    "text": "彼はネゲブから旅路を進めてベテルに向かい、ベテルとアイの間の、さきに天幕を張った所に行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 13:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.13.p1.b3": {
    "text": "すなわち彼が初めに築いた祭壇の所に行き、その所でアブラムは主の名を呼んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 13:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.13.p2.b4": {
    "text": "その地は彼らをささえて共に住ませることができなかった。彼らの財産が多かったため、共に住めなかったのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 13:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.13.p2.b5": {
    "text": "アブラムの家畜の牧者たちとロトの家畜の牧者たちの間に争いがあった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 13:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.13.p2.b6": {
    "text": "そのころカナンびととペリジびとがその地に住んでいた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 13:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.13.p3.b7": {
    "text": "「わたしたちは身内の者です。わたしとあなたの間にも、わたしの牧者たちとあなたの牧者たちの間にも争いがないようにしましょう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 13:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.13.p3.b8": {
    "text": "全地はあなたの前にあるではありませんか。どうかわたしと別れてください。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 13:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.13.p3.b9": {
    "text": "あなたが左に行けばわたしは右に行きます。あなたが右に行けばわたしは左に行きましょう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 13:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.13.p4.b10": {
    "text": "ロトが目を上げてヨルダンの低地をあまねく見わたすと、… ゾアルまで主の園のように、またエジプトの地のように、すみずみまでよく潤っていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 13:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.13.p4.b11": {
    "text": "そこでロトはヨルダンの低地をことごとく選びとって東に移った。こうして彼らは互に別れた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 13:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.13.p4.b12": {
    "text": "アブラムはカナンの地に住んだが、ロトは低地の町々に住み、天幕をソドムに移した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 13:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.13.p4.b13": {
    "text": "ソドムの人々はわるく、主に対して、はなはだしい罪びとであった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 13:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.13.p5.b14": {
    "text": "「目をあげてあなたのいる所から北、南、東、西を見わたしなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 13:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.13.p5.b15": {
    "text": "すべてあなたが見わたす地は、永久にあなたとあなたの子孫に与えます。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 13:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.13.p5.b16": {
    "text": "わたしはあなたの子孫を地のちりのように多くします。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 13:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.13.p5.b17": {
    "text": "アブラムは天幕を移してヘブロンにあるマムレのテレビンの木のかたわらに住み、その所で主に祭壇を築いた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 13:18"
    },
    "adapted": false,
    "status": "approved"
  }
}
