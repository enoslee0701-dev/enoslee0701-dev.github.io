{
  "genesis.38.p1.b1": {
    "text": "그 후에 유다가 자기 형제에게서 내려가서 아둘람 사람 히라에게로 나아가니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p1.b2": {
    "text": "유다가 거기서 가나안 사람 수아라 하는 자의 딸을 보고 그를 취하여 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p1.b3": {
    "text": "그가 잉태하여 아들을 낳으매 유다가 그 이름을 엘이라 하니라 그가 다시 잉태하여 아들을 낳고 그 이름을 오난이라 하고 그가 또 다시 아들을 낳고 그 이름을 셀라라 하니라 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:3-5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p2.b1": {
    "text": "유다가 장자 엘을 위하여 아내를 취하니 그 이름은 다말이더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p2.b2": {
    "text": "유다의 장자 엘이 여호와 목전에 악하므로 여호와께서 그를 죽이신지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p2.b3": {
    "text": "그 일이 여호와 목전에 악하므로 여호와께서 그도 죽이시니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p2.b4": {
    "text": "셀라도 그 형들 같이 죽을까 염려함이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p2.b5": {
    "text": "수절하고 네 아비 집에 있어서 내 아들 셀라가 장성하기를 기다리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p3.b1": {
    "text": "얼마 후에 유다의 아내 수아의 딸이 죽은지라 유다가 위로를 받은 후에 그 친구 아둘람 사람 히라와 함께 딤나로 올라가서 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p3.b2": {
    "text": "네 시부가 자기 양털을 깎으려고 딤나에 올라왔다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p3.b3": {
    "text": "… 면박으로 얼굴을 가리고 몸을 휩싸고 딤나 길 곁 에나임 문에 앉으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p3.b4": {
    "text": "그가 얼굴을 가리웠으므로 유다가 그를 보고 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p4.b1": {
    "text": "길곁으로 그에게 나아가 … 그 자부인줄 알지 못하였음이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p4.b2": {
    "text": "당신이 무엇을 주고 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p4.b3": {
    "text": "내가 내 떼에서 염소 새끼를 주리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p4.b4": {
    "text": "당신이 그것을 줄 때까지 약조물을 주겠느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p4.b5": {
    "text": "당신의 도장과 그 끈과 당신의 손에 있는 지팡이로 하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p4.b6": {
    "text": "그가 일어나 떠나가서 그 면박을 벗고 과부의 의복을 도로 입으니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p5.b1": {
    "text": "유다가 그 친구 아둘람 사람의 손에 부탁하여 염소 새끼를 보내고 그 여인의 손에서 약조물을 찾으려 하였으나 그가 그 여인을 찾지 못한지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p5.b2": {
    "text": "길 곁 에나임에 있던 창녀가 어디 있느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p5.b3": {
    "text": "여기는 창녀가 없느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p5.b4": {
    "text": "내가 그를 찾지 못하고 그곳 사람도 이르기를 여기는 창녀가 없다 하더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p5.b5": {
    "text": "그로 그것을 가지게 두라 우리가 부끄러움을 당할까 하노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p6.b1": {
    "text": "석달쯤 후에 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p6.b2": {
    "text": "네 며느리 다말이 행음하였고 그 행음함을 인하여 잉태하였느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p6.b3": {
    "text": "그를 끌어 내어 불사르라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p6.b4": {
    "text": "이 물건 임자로 말미암아 잉태하였나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p6.b5": {
    "text": "청컨대 보소서 이 도장과 그 끈과 지팡이가 뉘 것이니이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p6.b6": {
    "text": "그는 나보다 옳도다 내가 그를 내 아들 셀라에게 주지 아니하였음이로다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p6.b7": {
    "text": "다시는 그를 가까이 하지 아니하였더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p7.b1": {
    "text": "임산하여 보니 쌍태라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p7.b2": {
    "text": "이는 먼저 나온자라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p7.b3": {
    "text": "네가 어찌하여 터치고 나오느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p7.b4": {
    "text": "그 이름을 베레스라 불렀고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.38.p7.b5": {
    "text": "그 형제 곧 손에 홍사 있는 자가 뒤에 나오니 그 이름을 세라라 불렀더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 38:30"
    },
    "adapted": false,
    "status": "approved"
  }
}
