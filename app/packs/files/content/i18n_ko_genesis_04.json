{
  "genesis.4.p1.b1": {
    "text": "아담이 그 아내 하와와 동침하매 하와가 잉태하여 가인을 낳고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 4:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.4.p1.b2": {
    "text": "내가 여호와로 말미암아 득남하였다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 4:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.4.p1.b3": {
    "text": "그가 또 가인의 아우 아벨을 낳았는데",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 4:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.4.p1.b4": {
    "text": "아벨은 양 치는 자이었고 가인은 농사하는 자이었더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 4:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.4.p2.b5": {
    "text": "세월이 지난 후에 가인은 땅의 소산으로 제물을 삼아 여호와께 드렸고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 4:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.4.p2.b6": {
    "text": "아벨은 자기도 양의 첫 새끼와 그 기름으로 드렸더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 4:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.4.p2.b7": {
    "text": "여호와께서 아벨과 그 제물은 열납하셨으나 가인과 그 제물은 열납하지 아니하신지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 4:4-5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.4.p2.b8": {
    "text": "가인이 심히 분하여 안색이 변하니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 4:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.4.p3.b9": {
    "text": "네가 분하여 함은 어찜이며 안색이 변함은 어찜이뇨",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 4:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.4.p3.b10": {
    "text": "네가 선을 행하면 어찌 낯을 들지 못하겠느냐 선을 행치 아니하면 죄가 문에 엎드리느니라 죄의 소원은 네게 있으나 너는 죄를 다스릴지니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 4:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.4.p3.b11": {
    "text": "가인이 그 아우 아벨에게 고하니라 그 후 그들이 들에 있을 때에",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 4:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.4.p3.b12": {
    "text": "가인이 그 아우 아벨을 쳐 죽이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 4:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.4.p4.b13": {
    "text": "네 아우 아벨이 어디 있느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 4:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.4.p4.b14": {
    "text": "내가 알지 못하나이다 내가 내 아우를 지키는 자이니까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 4:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.4.p4.b15": {
    "text": "네가 무엇을 하였느냐 네 아우의 핏소리가 땅에서부터 내게 호소하느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 4:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.4.p4.b16": {
    "text": "… 네가 땅에서 저주를 받으리니 네가 밭 갈아도 땅이 다시는 그 효력을 네게 주지 아니할 것이요 너는 땅에서 피하며 유리하는 자가 되리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 4:11-12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.4.p5.b17": {
    "text": "내 죄벌이 너무 중하여 견딜 수 없나이다 … 무릇 나를 만나는 자가 나를 죽이겠나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 4:13-14"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.4.p5.b18": {
    "text": "가인을 죽이는 자는 벌을 칠배나 받으리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 4:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.4.p5.b19": {
    "text": "가인이 여호와의 앞을 떠나 나가 에덴 동편 놋 땅에 거하였더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 4:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.4.p6.b20": {
    "text": "가인이 성을 쌓고 그 아들의 이름으로 성을 이름하여 에녹이라 하였더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 4:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.4.p6.b21": {
    "text": "그는 장막에 거하여 육축 치는 자의 조상이 되었고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 4:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.4.p6.b22": {
    "text": "그 아우의 이름은 유발이니 그는 수금과 퉁소를 잡는 모든 자의 조상이 되었으며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 4:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.4.p6.b23": {
    "text": "씰라는 두발가인을 낳았으니 그는 동철로 각양 날카로운 기계를 만드는 자요",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 4:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.4.p6.b24": {
    "text": "아다와 씰라여 내 소리를 들으라 라멕의 아내들이여 내 말을 들으라 나의 창상을 인하여 내가 사람을 죽였고 나의 상함을 인하여 소년을 죽였도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 4:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.4.p6.b25": {
    "text": "가인을 위하여는 벌이 칠배일진대 라멕을 위하여는 벌이 칠십칠배이리로다 하였더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 4:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.4.p7.b26": {
    "text": "하나님이 내게 가인의 죽인 아벨 대신에 다른 씨를 주셨다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 4:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.4.p7.b27": {
    "text": "셋도 아들을 낳고 그 이름을 에노스라 하였으며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 4:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.4.p7.b28": {
    "text": "그 때에 사람들이 비로소 여호와의 이름을 불렀더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 4:26"
    },
    "adapted": false,
    "status": "approved"
  }
}
