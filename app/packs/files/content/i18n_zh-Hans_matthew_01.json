{
  "matthew.1.p1.b1": {
    "text": "亚伯拉罕的后裔，大卫的子孙，耶稣基督的家谱：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 1:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "亚⁠伯拉⁠罕的后⁠裔，大⁠卫的子⁠孙，耶⁠稣基⁠督的家⁠谱："
  },
  "matthew.1.p1.b2": {
    "text": "亚伯拉罕生以撒；以撒生雅各；雅各生犹大和他的弟兄；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 1:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "亚⁠伯拉⁠罕生以⁠撒；以⁠撒生雅⁠各；雅⁠各生犹⁠大和他⁠的弟⁠兄；"
  },
  "matthew.1.p1.b3": {
    "text": "撒门从喇合氏生波阿斯；波阿斯从路得氏生俄备得；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 1:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p1.b4": {
    "text": "耶西生大卫王。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 1:6"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶西生大⁠卫王。"
  },
  "matthew.1.p2.b1": {
    "text": "大卫从乌利亚的妻子生所罗门；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 1:6"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "大⁠卫从乌利⁠亚的妻⁠子生所⁠罗⁠门；"
  },
  "matthew.1.p2.b2": {
    "text": "所罗门生罗波安；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 1:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "所⁠罗⁠门生罗波安；"
  },
  "matthew.1.p2.b3": {
    "text": "百姓被迁到巴比伦的时候，约西亚生耶哥尼雅和他的弟兄。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 1:11"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "百⁠姓被迁到巴⁠比⁠伦的时⁠候，约⁠西亚生耶哥尼雅和他⁠的弟⁠兄。"
  },
  "matthew.1.p3.b1": {
    "text": "迁到巴比伦之后，耶哥尼雅生撒拉铁；撒拉铁生所罗巴伯；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 1:12"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "迁到巴⁠比⁠伦之⁠后，耶哥尼雅⁠生撒拉铁；撒拉铁生所罗巴伯；"
  },
  "matthew.1.p3.b2": {
    "text": "雅各生约瑟，就是马利亚的丈夫。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 1:16"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "雅⁠各生约⁠瑟，就⁠是马⁠利⁠亚的丈⁠夫。"
  },
  "matthew.1.p3.b3": {
    "text": "那称为基督的耶稣是从马利亚生的。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 1:16"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "那称⁠为基⁠督的耶⁠稣是从马⁠利⁠亚生的。"
  },
  "matthew.1.p3.b4": {
    "text": "这样，从亚伯拉罕到大卫共有十四代；……从迁至巴比伦的时候到基督又有十四代。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 1:17"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "这⁠样，从亚⁠伯拉⁠罕到大⁠卫共⁠有十⁠四代；……从迁至巴⁠比⁠伦的时⁠候到基⁠督又⁠有十⁠四代。"
  },
  "matthew.1.p4.b1": {
    "text": "耶稣基督降生的事记在下面：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 1:18"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣基⁠督降⁠生的事记在下⁠面："
  },
  "matthew.1.p4.b2": {
    "text": "他母亲马利亚已经许配了约瑟，还没有迎娶，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 1:18"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他母⁠亲马⁠利⁠亚已⁠经许⁠配了约⁠瑟，还没⁠有迎⁠娶，"
  },
  "matthew.1.p4.b3": {
    "text": "马利亚就从圣灵怀了孕。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 1:18"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "马⁠利⁠亚就从圣⁠灵怀⁠了孕。"
  },
  "matthew.1.p5.b1": {
    "text": "她丈夫约瑟是个义人，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 1:19"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "她丈⁠夫约⁠瑟是个义人，"
  },
  "matthew.1.p5.b2": {
    "text": "不愿意明明地羞辱她，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 1:19"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "不愿⁠意明⁠明地羞⁠辱她，"
  },
  "matthew.1.p5.b3": {
    "text": "想要暗暗地把她休了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 1:19"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "想⁠要暗⁠暗地把她休了。"
  },
  "matthew.1.p6.b1": {
    "text": "正思念这事的时候，有主的使者向他梦中显现，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 1:20"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "正思⁠念这事的时⁠候，有主的使⁠者向他梦⁠中显⁠现，"
  },
  "matthew.1.p6.b2": {
    "text": "大卫的子孙约瑟，不要怕！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 1:20"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "大⁠卫的子⁠孙约⁠瑟，不⁠要怕！"
  },
  "matthew.1.p6.b3": {
    "text": "只管娶过你的妻子马利亚来，因她所怀的孕是从圣灵来的。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 1:20"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "只⁠管娶过你⁠的妻⁠子马⁠利⁠亚来，因她所怀的孕是从圣⁠灵来的。"
  },
  "matthew.1.p6.b4": {
    "text": "她将要生一个儿子，你要给他起名叫耶稣，因他要将自己的百姓从罪恶里救出来。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 1:21"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "她将⁠要生一⁠个儿⁠子，你⁠要给他起名⁠叫耶⁠稣，因他⁠要将自⁠己的百⁠姓从罪⁠恶里救出⁠来。"
  },
  "matthew.1.p7.b1": {
    "text": "这一切的事成就是要应验主借先知所说的话，说：必有童女怀孕生子；人要称他的名为以马内利。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 1:22-23"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "这一⁠切的事成就⁠是要应验主借先⁠知所说的⁠话，说：必⁠有童⁠女怀⁠孕生⁠子；人要称他⁠的名⁠为以马内利。"
  },
  "matthew.1.p7.b2": {
    "text": "（以马内利翻出来就是「　神与我们同在」。）",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 1:23"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "（以马内利翻出⁠来就⁠是「　神与我⁠们同在」。）"
  },
  "matthew.1.p7.b3": {
    "text": "约瑟醒了，起来，就遵着主使者的吩咐把妻子娶过来；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 1:24"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "约⁠瑟醒了，起⁠来，就遵着主使⁠者的吩⁠咐把妻⁠子娶过⁠来；"
  },
  "matthew.1.p8.b1": {
    "text": "只是没有和她同房，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 1:25"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "只⁠是没⁠有和她同⁠房，"
  },
  "matthew.1.p8.b2": {
    "text": "等她生了儿子，就给他起名叫耶稣。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 1:25"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "等她生了儿⁠子，就给他起名⁠叫耶⁠稣。"
  }
}
