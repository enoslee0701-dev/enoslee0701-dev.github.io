{
  "samuel1.24.p1.b1": {
    "text": "사울이 온 이스라엘에서 택한 사람 삼천을 거느리고 다윗과 그의 사람들을 찾으러 들염소 바위로 갈새",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 24:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p1.b2": {
    "text": "다윗이 엔게디 황무지에 있더이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 24:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p2.b1": {
    "text": "길가 양의 우리에 이른즉 굴이 있는지라……다윗과 그의 사람들이 그 굴 깊은 곳에 있더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 24:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p2.b2": {
    "text": "여호와께서 당신에게 이르시기를 내가 원수를 네 손에 붙이리니 네 소견에 선한 대로 그에게 행하라 하시더니 이것이 그 날이니이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 24:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p2.b3": {
    "text": "다윗이 일어나서 사울의 겉옷자락을 가만히 베니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 24:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p3.b1": {
    "text": "그리한 후에 사울의 옷자락 벰을 인하여 다윗의 마음이 찔려",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 24:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p3.b2": {
    "text": "내가 손을 들어 여호와의 기름 부음을 받은 내 주를 치는 것은 여호와의 금하시는 것이니……",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 24:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p3.b3": {
    "text": "사울이 일어나 굴에서 나가 자기 길을 가니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 24:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p4.b1": {
    "text": "내 주 왕이여",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 24:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p4.b2": {
    "text": "다윗이 왕을 해하려 한다고 하는 사람들의 말을 왕은 어찌하여 들으시나이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 24:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p4.b3": {
    "text": "오늘 여호와께서 굴에서 왕을 내 손에 붙이신 것을 왕이 아셨을 것이니이다……내가 왕을 아껴……",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 24:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p5.b1": {
    "text": "나의 아버지여 보소서 내 손에 있는 왕의 옷자락을 보소서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 24:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p5.b2": {
    "text": "여호와께서는 나와 왕 사이를 판단하사 나를 위하여 왕에게 보복하시려니와 내 손으로는 왕을 해하지 않겠나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 24:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p5.b3": {
    "text": "이스라엘 왕이 누구를 따라 나왔으며 누구를 쫓나이까 죽은 개나 벼룩을 쫓음이니이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 24:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p6.b1": {
    "text": "내 아들 다윗아 이것이 네 목소리냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 24:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p6.b2": {
    "text": "소리를 높여 울며……",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 24:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p6.b3": {
    "text": "나는 너를 학대하되 너는 나를 선대하니 너는 나보다 의롭도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 24:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p6.b4": {
    "text": "네가 오늘날 내게 행한 일을 인하여 여호와께서 네게 선으로 갚으시기를 원하노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 24:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p7.b1": {
    "text": "보라 나는 네가 반드시 왕이 될 것을 알고 이스라엘 나라가 네 손에 견고히 설 것을 아노니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 24:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p7.b2": {
    "text": "그런즉 너는 내 후손을 끊지 아니하며……이제 여호와로 내게 맹세하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 24:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p7.b3": {
    "text": "다윗이 사울에게 맹세하매……",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 24:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p7.b4": {
    "text": "사울은 집으로 돌아가고 다윗과 그의 사람들은 요새로 올라가니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 24:22"
    },
    "adapted": false,
    "status": "approved"
  }
}
