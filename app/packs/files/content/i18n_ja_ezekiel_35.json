{
  "ezekiel.35.p1.b1": {
    "text": "「人の子よ、あなたの顔をセイル山に向け、これに対して預言し、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 35:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.35.p1.b2": {
    "text": "これら二つの国民、二つの国はわたしのもの、われわれはこれを獲よう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 35:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.35.p1.b3": {
    "text": "これは荒れはてて、われわれの食となる",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 35:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.35.p1.b4": {
    "text": "セイル山よ、見よ、わたしはあなたを敵とし、わたしの手をあなたに向かって伸べ、あなたを全く荒し……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 35:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.35.p1.b5": {
    "text": "全地の喜びのために、わたしはあなたを荒れ地とする。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 35:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.35.p1.b6": {
    "text": "あなたが、イスラエルの家の嗣業の荒れるのを喜んだように、わたしはあなたに、そのようにする。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 35:15"
    },
    "adapted": false,
    "status": "approved"
  }
}
