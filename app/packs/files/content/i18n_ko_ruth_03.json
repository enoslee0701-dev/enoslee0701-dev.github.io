{
  "ruth.3.p1.b1": {
    "text": "내 딸아 내가 너를 위하여 안식할 곳을 구하여 너로 복되게 하여야 하지 않겠느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ruth 3:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p1.b2": {
    "text": "… 보아스는 우리의 친족이 아니냐 그가 오늘 밤에 타작 마당에서 보리를 까불리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ruth 3:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p1.b3": {
    "text": "너는 목욕하고 기름을 바르고 의복을 입고 타작 마당에 내려가서 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ruth 3:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p1.b4": {
    "text": "어머니의 말씀대로 내가 다 행하리이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ruth 3:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p2.b1": {
    "text": "그가 타작 마당으로 내려가서 시모의 명대로 다 하니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ruth 3:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p2.b2": {
    "text": "보아스가 먹고 마시고 마음이 즐거워서 가서 노적가리 곁에 눕는지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ruth 3:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p2.b3": {
    "text": "룻이 가만히 가서 그 발치 이불을 들고 거기 누웠더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ruth 3:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p3.b1": {
    "text": "밤중에 그 사람이 놀라 몸을 돌이켜 본즉 한 여인이 자기 발치에 누웠는지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ruth 3:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p3.b2": {
    "text": "네가 누구뇨",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ruth 3:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p3.b3": {
    "text": "나는 당신의 시녀 룻이오니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ruth 3:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p3.b4": {
    "text": "당신의 옷자락으로 시녀를 덮으소서 당신은 우리 기업을 무를 자가 됨이니이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ruth 3:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p4.b1": {
    "text": "내 딸아 여호와께서 네게 복주시기를 원하노라 … 너의 베푼 인애가 처음보다 나중이 더하도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ruth 3:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p4.b2": {
    "text": "내 딸아 두려워말라 … 네가 현숙한 여자인 줄 나의 성읍 백성이 다 아느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ruth 3:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p4.b3": {
    "text": "참으로 나는 네 기업을 무를 자나 무를 자가 나보다 더 가까운 친족이 있으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ruth 3:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p4.b4": {
    "text": "만일 그가 기업 무를 자의 책임을 네게 이행코자 아니 하면 여호와의 사심으로 맹세하노니 내가 기업 무를 자의 책임을 네게 행하리라 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ruth 3:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p5.b1": {
    "text": "룻이 새벽까지 그 발치에 누웠다가 사람이 피차 알아보기 어려울 때에 일어났으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ruth 3:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p5.b2": {
    "text": "여인이 타작 마당에 들어온 것을 사람이 알지 못하여야 할 것이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ruth 3:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p5.b3": {
    "text": "네 겉옷을 가져다가 펴서 잡으라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ruth 3:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p5.b4": {
    "text": "펴서 잡으니 보리를 여섯번 되어 룻에게 이워주고 성으로 들어가니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ruth 3:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p6.b1": {
    "text": "내 딸아 어떻게 되었느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ruth 3:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p6.b2": {
    "text": "룻이 그 사람의 자기에게 행한 것을 다 고하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ruth 3:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p6.b3": {
    "text": "그가 내게 이 보리를 여섯번 되어 주며 이르기를 빈손으로 네 시모에게 가지 말라 하더이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ruth 3:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.3.p6.b4": {
    "text": "내 딸아 이 사건이 어떻게 되는 것을 알기까지 가만히 앉아 있으라 그 사람이 오늘날 이 일을 성취하기 전에는 쉬지 아니하리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ruth 3:18"
    },
    "adapted": false,
    "status": "approved"
  }
}
