{
  "nehemiah.12.p1.b1": {
    "text": "シャルテルの子ゼルバベルおよびエシュアと一緒に上ってきた祭司とレビびとは次のとおりである。……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 12:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.12.p1.b2": {
    "text": "エシュアの子はヨアキム、ヨアキムの子はエリアシブ、エリアシブの子はヨイアダ……ヨナタンの子はヤドアである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 12:10-11"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.12.p1.b3": {
    "text": "……その兄弟たち相向かい合い、組と組と対応して神の人ダビデの命令に従い、さんびと感謝をささげた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 12:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.12.p1.b4": {
    "text": "これらはヨザダクの子エシュアの子ヨアキムの時代、また総督ネヘミヤおよび学者である祭司エズラの時代にいた人々である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 12:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.12.p2.b1": {
    "text": "さてエルサレムの城壁の落成式に当って、レビびとを、そのすべての所から招いてエルサレムにこさせ、感謝と、歌と、シンバルと、立琴と、琴とをもって喜んで落成式を行おうとした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 12:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.12.p2.b2": {
    "text": "……この歌うたう者たちはエルサレムの周囲に自分の村々を建てていたからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 12:28-29"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.12.p2.b3": {
    "text": "そして祭司とレビびとたちは身を清め、また民およびもろもろの門と城壁とを清めた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 12:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.12.p3.b1": {
    "text": "そこでわたしはユダのつかさたちを城壁の上にのぼらせ、また感謝する者の二つの大きな組を作って、行進させた。……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 12:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.12.p3.b2": {
    "text": "その一つは城壁の上を右に糞の門をさして進んだ。……そして学者エズラは彼らの先に進んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 12:31-36"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.12.p3.b3": {
    "text": "また数人の祭司がラッパをもって従った。……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 12:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.12.p3.b4": {
    "text": "彼らは泉の門を経て、まっすぐに進み、城壁の上り口で、ダビデの町の階段から上り……東の方、水の門に至った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 12:37"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.12.p4.b1": {
    "text": "他の一組の感謝する者は左に進んだ。……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 12:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.12.p4.b2": {
    "text": "……わたしは民の半ばと共に彼らのあとに従った。そして城壁の上を行き、炉の望楼の上を過ぎて……羊の門に至り、近衛の門に立ち止まった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 12:38-39"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.12.p4.b3": {
    "text": "こうして二組の感謝する者は神の宮にはいって立った。わたしもそこに立ち、つかさたちの半ばもわたしと共に立った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 12:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.12.p4.b4": {
    "text": "……そして歌うたう者たちは声高く歌った。エズラヒヤはその監督であった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 12:41-42"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.12.p4.b5": {
    "text": "こうして彼らはその日、大いなる犠牲をささげて喜んだ。神が彼らを大いに喜び楽しませられたからである。女子供までも喜んだ。……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 12:43"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.12.p4.b6": {
    "text": "……それでエルサレムの喜びの声は遠くまで聞えた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 12:43"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.12.p5.b1": {
    "text": "その日、倉のもろもろのへやをつかさどる人々を選び、ささげ物、初物、十分の一など……へやに入れることをつかさどらせた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 12:44"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.12.p5.b2": {
    "text": "……これは祭司およびレビびとの仕えるのを、ユダびとが喜んだからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 12:44"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.12.p5.b3": {
    "text": "……歌うたう者および門を守る者もそのように行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 12:45-46"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.12.p5.b4": {
    "text": "またゼルバベルの日およびネヘミヤの日には、イスラエルびとはみな歌うたう者と門を守る者に日々の分を与え……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 12:47"
    },
    "adapted": false,
    "status": "approved"
  }
}
