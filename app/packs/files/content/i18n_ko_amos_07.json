{
  "amos.7.p1.b1": {
    "text": "주 여호와께서 내게 보이신 것이 이러하니라 왕이 풀을 벤 후 풀이 다시 움돋기 시작할 때에 주께서 황충을 지으시매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Amos 7:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.7.p1.b2": {
    "text": "주 여호와여 청컨대 사하소서 야곱이 미약하오니 어떻게 서리이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Amos 7:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.7.p1.b3": {
    "text": "이것이 이루지 아니하리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Amos 7:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.7.p1.b4": {
    "text": "주 여호와여 청컨대 그치소서 야곱이 미약하오니 어떻게 서리이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Amos 7:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.7.p1.b5": {
    "text": "이것도 이루지 아니하리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Amos 7:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.7.p1.b6": {
    "text": "아모스야 네가 무엇을 보느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Amos 7:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.7.p1.b7": {
    "text": "다림줄이니이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Amos 7:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.7.p1.b8": {
    "text": "내가 다림줄을 내 백성 이스라엘 가운데 베풀고 다시는 용서치 아니하리니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Amos 7:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.7.p1.b9": {
    "text": "이삭의 산당들이 황폐되며 이스라엘의 성소들이 훼파될 것이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Amos 7:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.7.p2.b1": {
    "text": "이스라엘 족속 중에 아모스가 왕을 모반하나니 그 모든 말을 이 땅이 견딜 수 없나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Amos 7:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.7.p2.b2": {
    "text": "아모스가 말하기를 여로보암은 칼에 죽겠고 이스라엘은 정녕 사로잡혀 그 땅에서 떠나겠다 하나이다 하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Amos 7:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.7.p2.b3": {
    "text": "선견자야 너는 유다 땅으로 도망하여 가서 거기서나 떡을 먹으며 거기서나 예언하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Amos 7:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.7.p2.b4": {
    "text": "다시는 벧엘에서 예언하지 말라 이는 왕의 성소요 왕의 궁임이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Amos 7:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.7.p2.b5": {
    "text": "나는 선지자가 아니며 선지자의 아들도 아니요 나는 목자요 뽕나무를 배양하는 자로서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Amos 7:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.7.p2.b6": {
    "text": "양떼를 따를 때에 여호와께서 나를 데려다가 내게 이르시기를 가서 내 백성 이스라엘에게 예언하라 하셨나니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Amos 7:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.7.p2.b7": {
    "text": "이제 너는 여호와의 말씀을 들을지니라 … 여호와께서 말씀하시기를 … 네 땅은 줄 띄워 나누일 것이며 너는 더러운 땅에서 죽을 것이요 이스라엘은 정녕 사로잡혀 그 본토에서 떠나리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Amos 7:16-17"
    },
    "adapted": false,
    "status": "approved"
  }
}
