{
  "mark.4.p1.b1": {
    "text": "예수께서 다시 바닷가에서 가르치시니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p1.b2": {
    "text": "큰 무리가 모여 들거늘",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p1.b3": {
    "text": "예수께서 배에 올라 바다에 떠 앉으시고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p1.b4": {
    "text": "온 무리는 바다 곁 육지에 있더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p1.b5": {
    "text": "이에 예수께서 여러가지를 비유로 가르치시니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p1.b6": {
    "text": "그 가르치시는 중에 저희에게 이르시되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p2.b1": {
    "text": "들으라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p2.b2": {
    "text": "씨를 뿌리는 자가 뿌리러 나가서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p2.b3": {
    "text": "뿌릴새 더러는 길 가에 떨어지매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p2.b4": {
    "text": "새들이 와서 먹어 버렸고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p3.b1": {
    "text": "더러는 흙이 얇은 돌밭에 떨어지매 흙이 깊지 아니하므로",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p3.b2": {
    "text": "곧 싹이 나오나",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p3.b3": {
    "text": "해가 돋은 후에 터져서 뿌리가 없으므로 말랐고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p3.b4": {
    "text": "더러는 가시떨기에 떨어지매 가시가 자라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p3.b5": {
    "text": "기운을 막으므로 결실치 못하였고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p4.b1": {
    "text": "더러는 좋은 땅에 떨어지매 자라 무성하여 결실하였으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p4.b2": {
    "text": "삼십배와",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p4.b3": {
    "text": "육십배와",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p4.b4": {
    "text": "백배가 되었느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p4.b5": {
    "text": "또 이르시되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p4.b6": {
    "text": "들을 귀 있는 자는 들으라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p5.b1": {
    "text": "예수께서 홀로 계실 때에",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p5.b2": {
    "text": "함께한 사람들이 열 두 제자로 더불어 그 비유들을 묻자오니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p5.b3": {
    "text": "이르시되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p5.b4": {
    "text": "하나님 나라의 비밀을 너희에게는 주었으나",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p5.b5": {
    "text": "외인에게는 모든 것을 비유로 하나니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p5.b6": {
    "text": "이는 저희로 보기는 보아도 알지 못하며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p5.b7": {
    "text": "듣기는 들어도 깨닫지 못하게 하여",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p5.b8": {
    "text": "돌이켜 죄 사함을 얻지 못하게 하려 함이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p6.b1": {
    "text": "또 가라사대",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p6.b2": {
    "text": "너희가 이 비유를 알지 못할진대",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p6.b3": {
    "text": "어떻게 모든 비유를 알겠느뇨",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p6.b4": {
    "text": "뿌리는 자는 말씀을 뿌리는 것이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p6.b5": {
    "text": "말씀이 길가에 뿌리웠다는 것은 이들이니 곧 말씀을 들었을 때에",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p6.b6": {
    "text": "사단이 즉시 와서 저희에게 뿌리운 말씀을 빼앗는 것이요",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p7.b1": {
    "text": "또 이와 같이 돌밭에 뿌리웠다는 것은 이들이니 곧 말씀을 들을 때에",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p7.b2": {
    "text": "즉시 기쁨으로 받으나",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p7.b3": {
    "text": "그 속에 뿌리가 없어 잠간 견디다가",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p7.b4": {
    "text": "말씀을 인하여 환난이나 핍박이 일어나는 때에는",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p7.b5": {
    "text": "곧 넘어지는 자요",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p8.b1": {
    "text": "또 어떤이는 가시떨기에 뿌리우는 자니 이들은 말씀을 듣되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p8.b2": {
    "text": "세상의 염려와 재리의 유혹과 기타 욕심이 들어와",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p8.b3": {
    "text": "말씀을 막아 결실치 못하게 되는 자요",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p8.b4": {
    "text": "좋은 땅에 뿌리웠다는 것은 곧 말씀을 듣고 받아",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p8.b5": {
    "text": "삼십배와 육십배와 백배의 결실을 하는 자니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p9.b1": {
    "text": "또 저희에게 이르시되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p9.b2": {
    "text": "사람이 등불을 가져오는 것은",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p9.b3": {
    "text": "말 아래나",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p9.b4": {
    "text": "평상 아래나 두려 함이냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p9.b5": {
    "text": "등경 위에 두려 함이 아니냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p9.b6": {
    "text": "드러내려 하지 않고는 숨긴 것이 없고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p9.b7": {
    "text": "나타내려 하지 않고는 감추인 것이 없느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p9.b8": {
    "text": "들을 귀 있는 자는 들으라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p10.b1": {
    "text": "또 가라사대",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p10.b2": {
    "text": "너희가 무엇을 듣는가 스스로 삼가라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p10.b3": {
    "text": "너희의 헤아리는 그 헤아림으로",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p10.b4": {
    "text": "너희가 헤아림을 받을것이요",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p10.b5": {
    "text": "또 더 받으리니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p10.b6": {
    "text": "있는 자는 받을 것이요",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p10.b7": {
    "text": "없는 자는 그 있는 것까지 빼앗기리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p11.b1": {
    "text": "또 가라사대",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p11.b2": {
    "text": "하나님의 나라는 사람이 씨를 땅에 뿌림과 같으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p11.b3": {
    "text": "저가 밤낮 자고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p11.b4": {
    "text": "깨고 하는 중에",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p11.b5": {
    "text": "씨가 나서 자라되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p11.b6": {
    "text": "그 어떻게 된 것을 알지 못하느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p11.b7": {
    "text": "땅이 스스로 열매를 맺되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p11.b8": {
    "text": "처음에는 싹이요 다음에는 이삭이요 그 다음에는 이삭에 충실한 곡식이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p11.b9": {
    "text": "열매가 익으면 곧 낫을 대나니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p11.b10": {
    "text": "이는 추수 때가 이르렀음이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p12.b1": {
    "text": "또 가라사대",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p12.b2": {
    "text": "우리가 하나님의 나라를 어떻게 비하며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p12.b3": {
    "text": "또 무슨 비유로 나타낼꼬",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p12.b4": {
    "text": "겨자씨 한 알과 같으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p12.b5": {
    "text": "땅에 심길 때에는 땅위의 모든 씨보다 작은 것이로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p12.b6": {
    "text": "심긴 후에는 자라서 모든 나물보다 커지며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p12.b7": {
    "text": "큰 가지를 내니 공중의 새들이 그 그늘에 깃들일 만큼 되느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p13.b1": {
    "text": "예수께서 이러한 많은 비유로 저희가 알아 들을 수 있는대로 말씀을 가르치시되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p13.b2": {
    "text": "비유가 아니면 말씀하지 아니하시고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p13.b3": {
    "text": "다만 혼자 계실 때에 그 제자들에게 모든 것을 해석 하시더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p13.b4": {
    "text": "그날 저물 때에 제자들에게 이르시되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p13.b5": {
    "text": "우리가 저편으로 건너가자",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p14.b1": {
    "text": "저희가 무리를 떠나",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:36"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p14.b2": {
    "text": "예수를 배에 계신 그대로 모시고 가매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:36"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p14.b3": {
    "text": "다른 배들도 함께 하더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:36"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p14.b4": {
    "text": "큰 광풍이 일어나며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:37"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p14.b5": {
    "text": "물결이 부딪혀 배에 들어와 배에 가득하게 되었더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:37"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p15.b1": {
    "text": "예수께서는 고물에서 베개를 베시고 주무시더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p15.b2": {
    "text": "제자들이 깨우며 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p15.b3": {
    "text": "선생님이여",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p15.b4": {
    "text": "우리의 죽게 된것을 돌아보지 아니하시나이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p16.b1": {
    "text": "예수께서 깨어",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p16.b2": {
    "text": "바람을 꾸짖으시며 바다더러 이르시되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p16.b3": {
    "text": "잠잠하라 고요하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p16.b4": {
    "text": "바람이 그치고 아주 잔잔하여지더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p17.b1": {
    "text": "이에 제자들에게 이르시되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p17.b2": {
    "text": "어찌하여 이렇게 무서워하느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p17.b3": {
    "text": "너희가 어찌 아직도 믿음이 없느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p17.b4": {
    "text": "저희가 심히 두려워하여 서로 말하되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p17.b5": {
    "text": "저가 뉘기에",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p17.b6": {
    "text": "바람과 바다라도 순종하는고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 4:41"
    },
    "adapted": false,
    "status": "approved"
  }
}
