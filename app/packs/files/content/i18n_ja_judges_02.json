{
  "judges.2.p1.b1": {
    "text": "主の使がギルガルからボキムに上って言った、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 2:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.2.p1.b2": {
    "text": "わたしはあなたがたをエジプトから上らせて、……言った、『わたしはあなたと結んだ契約を決して破ることはない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 2:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.2.p1.b3": {
    "text": "しかし、あなたがたはわたしの命令に従わなかった。あなたがたは、なんということをしたのか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 2:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.2.p1.b4": {
    "text": "……彼らはかえってあなたがたの敵となり、彼らの神々はあなたがたのわなとなるであろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 2:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.2.p2.b5": {
    "text": "主の使がこれらの言葉をイスラエルのすべての人々に告げたので、民は声をあげて泣いた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 2:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.2.p2.b6": {
    "text": "それでその所の名をボキムと呼んだ。そして彼らはその所で主に犠牲をささげた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 2:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.2.p2.b7": {
    "text": "ヨシュアが民を去らせたので、イスラエルの人々はおのおのその領地へ行って土地を獲た。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 2:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.2.p2.b8": {
    "text": "民は……ヨシュアのあとに生き残った長老たち、すなわち主がかつてイスラエルのために行われたすべての大いなるわざを見た人々の在世中も主に仕えた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 2:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.2.p3.b9": {
    "text": "こうして主のしもべヌンの子ヨシュアは百十歳で死んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 2:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.2.p3.b10": {
    "text": "そしてその時代の者もまたことごとくその先祖たちのもとにあつめられた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 2:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.2.p3.b11": {
    "text": "その後ほかの時代が起ったが、これは主を知らず、また主がイスラエルのために行われたわざをも知らなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 2:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.2.p4.b12": {
    "text": "イスラエルの人々は主の前に悪を行い、もろもろのバアルに仕え、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 2:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.2.p4.b13": {
    "text": "かつてエジプトの地から彼らを導き出された先祖たちの神、主を捨てて、ほかの神々すなわち周囲にある国民の神々に従い、それにひざまずいて、……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 2:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.2.p4.b14": {
    "text": "すなわち彼らは主を捨てて、バアルとアシタロテに仕えたので、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 2:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.2.p5.b15": {
    "text": "主の怒りがイスラエルに対して燃え、かすめ奪う者の手にわたして、かすめ奪わせ、……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 2:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.2.p5.b16": {
    "text": "……彼らはひどく悩んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 2:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.2.p5.b17": {
    "text": "その時、主はさばきづかさを起して、彼らをかすめ奪う者の手から救い出された。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 2:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.2.p5.b18": {
    "text": "しかしさばきづかさが死ぬと、彼らはそむいて、先祖たちにまさって悪を行い、……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 2:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.2.p6.b19": {
    "text": "この民はわたしがかつて先祖たちに命じた契約を犯し、わたしの命令に従わないゆえ、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 2:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.2.p6.b20": {
    "text": "わたしもまたヨシュアが死んだときに残しておいた国民を、この後、彼らの前から追い払わないであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 2:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.2.p6.b21": {
    "text": "これはイスラエルが、先祖たちの守ったように主の道を守ってそれに歩むかどうかをわたしが試みるためである」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 2:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.2.p6.b22": {
    "text": "それゆえ主はこれらの国民を急いで追い払わずに残しておいて、ヨシュアの手にわたされなかったのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Judges 2:23"
    },
    "adapted": false,
    "status": "approved"
  }
}
