{
  "micah.1.p1.b1": {
    "text": "ユダの王ヨタム、アハズおよびヒゼキヤの世に",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 1:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.1.p1.b2": {
    "text": "モレシテびとミカが、サマリヤとエルサレムについて示された主の言葉。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 1:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.1.p1.b3": {
    "text": "あなたがたすべての民よ、聞け。地とその中に満てる者よ、耳を傾けよ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 1:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.1.p1.b4": {
    "text": "見よ、主はそのご座所から出てこられ、下ってきて地の高い所を踏まれる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 1:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.1.p1.b5": {
    "text": "山は彼の下に溶け、谷は裂け、火の前のろうのごとく、坂に流れる水のようだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 1:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.1.p1.b6": {
    "text": "ヤコブのとがとは何か、サマリヤではないか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 1:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.1.p1.b7": {
    "text": "このゆえにわたしはサマリヤを野の石塚となし……またその石を谷に投げ落し、その基をあらわにする。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 1:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.1.p1.b8": {
    "text": "その彫像はみな砕かれ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 1:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.1.p2.b1": {
    "text": "わたしはこれがために嘆き悲しみ、はだしと裸で歩きまわり",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 1:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.1.p2.b2": {
    "text": "山犬のように嘆き、だちょうのように悲しみ鳴く。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 1:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.1.p2.b3": {
    "text": "サマリヤの傷はいやすことのできないもので、ユダまでひろがり、わが民の門、エルサレムまで及んでいる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 1:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.1.p2.b4": {
    "text": "ガテに告げるな、泣き叫ぶな。ベテレアフラで、ちりの中にころがれ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 1:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.1.p2.b5": {
    "text": "マロテに住む者は気づかわしそうに幸を待つ。災が主から出て、エルサレムの門に臨んだからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 1:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.1.p2.b6": {
    "text": "ラキシに住む者よ、戦車に早馬をつなげ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 1:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.1.p2.b7": {
    "text": "あなたの喜ぶ子らのために、あなたの髪をそり落せ。……はげたかのように大きくせよ。彼らは捕えられてあなたを離れるからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 1:16"
    },
    "adapted": false,
    "status": "approved"
  }
}
