{
  "jonah.2.p1.b1": {
    "text": "ヨナは魚の腹の中からその神、主に祈って、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Jonah 2:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.2.p1.b2": {
    "text": "わたしは悩みのうちから主に呼ばわると、主はわたしに答えられた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Jonah 2:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.2.p1.b3": {
    "text": "わたしが陰府の腹の中から叫ぶと、あなたはわたしの声を聞かれた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Jonah 2:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.2.p1.b4": {
    "text": "あなたはわたしを淵の中、海のまん中に投げ入れられた。……あなたの波と大波は皆、わたしの上を越えて行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Jonah 2:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.2.p2.b1": {
    "text": "わたしは言った、『わたしはあなたの前から追われてしまった、どうして再びあなたの聖なる宮を望みえようか』。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Jonah 2:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.2.p2.b2": {
    "text": "水がわたしをめぐって魂にまでおよび……海草は山の根元でわたしの頭にまといついた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Jonah 2:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.2.p2.b3": {
    "text": "わたしは地に下り、地の貫の木はいつもわたしの上にあった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Jonah 2:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.2.p3.b1": {
    "text": "しかしわが神、主よ、あなたはわが命を穴から救いあげられた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Jonah 2:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.2.p3.b2": {
    "text": "わが魂がわたしのうちに弱っているとき、わたしは主をおぼえ、わたしの祈はあなたに至り、あなたの聖なる宮に達した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Jonah 2:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.2.p3.b3": {
    "text": "むなしい偶像に心を寄せる者は、そのまことの忠節を捨てる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Jonah 2:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.2.p3.b4": {
    "text": "しかしわたしは感謝の声をもって、あなたに犠牲をささげ、わたしの誓いをはたす。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Jonah 2:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.2.p4.b1": {
    "text": "救は主にある",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Jonah 2:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.2.p4.b2": {
    "text": "主は魚にお命じになったので",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Jonah 2:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.2.p4.b3": {
    "text": "魚はヨナを陸に吐き出した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Jonah 2:10"
    },
    "adapted": false,
    "status": "approved"
  }
}
