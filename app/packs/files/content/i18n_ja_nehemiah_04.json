{
  "nehemiah.4.p1.b1": {
    "text": "サンバラテはわれわれが城壁を築くのを聞いて怒り、大いに憤ってユダヤ人をあざけった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 4:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.4.p1.b2": {
    "text": "「この弱々しいユダヤ人は何をしているのか。……塵塚の中の石はすでに焼けているのに、これを取りだして生かそうとするのか」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 4:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.4.p1.b3": {
    "text": "「そうだ、彼らの築いている城壁は、きつね一匹が上ってもくずれるであろう」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 4:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.4.p2.b1": {
    "text": "われわれの神よ、聞いてください。われわれは侮られています。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 4:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.4.p2.b2": {
    "text": "こうしてわれわれは城壁を築いたが、石がきはみな相連なって、その高さの半ばにまで達した……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 4:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.4.p2.b3": {
    "text": "……民が心をこめて働いたからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 4:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.4.p3.b1": {
    "text": "ところがサンバラテ、トビヤ、アラビヤびと、アンモンびと、アシドドびとらは、エルサレムの城壁の修理が進展し……と聞いて大いに怒り",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 4:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.4.p3.b2": {
    "text": "皆共に相はかり、エルサレムを攻めて、その中に混乱を起そうとした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 4:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.4.p3.b3": {
    "text": "そこでわれわれは神に祈り、また日夜見張りを置いて彼らに備えた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 4:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.4.p4.b1": {
    "text": "「荷を負う者の力は衰え、そのうえ、灰土がおびただしいので、われわれは城壁を築くことができない」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 4:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.4.p4.b2": {
    "text": "「彼らの知らないうちに、また見ないうちに、彼らの中にはいりこんで彼らを殺し、その工事をやめさせよう」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 4:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.4.p4.b3": {
    "text": "また彼らの近くに住んでいるユダヤ人たちはきて、十度もわれわれに言った",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 4:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.4.p4.b4": {
    "text": "「彼らはその住んでいるすべての所からわれわれに攻め上るでしょう」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 4:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.4.p5.b1": {
    "text": "そこでわたしは民につるぎ、やりおよび弓を持たせ、城壁の後の低い所、すなわち空地にその家族にしたがって立たせた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 4:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.4.p5.b2": {
    "text": "わたしは見めぐり、立って尊い人々、つかさたち、およびその他の民らに言った",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 4:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.4.p5.b3": {
    "text": "「あなたがたは彼らを恐れてはならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 4:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.4.p5.b4": {
    "text": "大いなる恐るべき主を覚え、あなたがたの兄弟、むすこ、娘、妻および家のために戦いなさい」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 4:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.4.p6.b1": {
    "text": "われわれの敵は自分たちの事が、われわれに悟られたことを聞き、また神が彼らの計りごとを破られたことを聞いたので、われわれはみな城壁に帰り、おのおのその工事を続けた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 4:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.4.p6.b2": {
    "text": "荷を負い運ぶ者はおのおの片手で工事をなし、片手に武器を執った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 4:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.4.p6.b3": {
    "text": "築き建てる者はおのおのその腰につるぎを帯びて築き建て……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 4:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.4.p6.b4": {
    "text": "……ラッパを吹く者はわたしのかたわらにいた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 4:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.4.p7.b1": {
    "text": "「工事は大きくかつ広がっているので、われわれは城壁の上で互に遠く離れている。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 4:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.4.p7.b2": {
    "text": "どこででもラッパの音を聞いたなら、そこにいるわれわれの所に集まってほしい。われわれの神はわれわれのために戦われます」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 4:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.4.p7.b3": {
    "text": "このようにして、われわれは工事を進めたが、半数の者は夜明けから星の出る時まで、やりを執っていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 4:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.4.p7.b4": {
    "text": "そして、わたしも、わたしの兄弟たちも、わたしのしもべたちも、わたしを護衛する人々も、われわれのうちひとりも、その衣を脱がず、おのおの手に武器を執っていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 4:23"
    },
    "adapted": false,
    "status": "approved"
  }
}
