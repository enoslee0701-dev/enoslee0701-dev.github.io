{
  "john.9.p1.b1": {
    "text": "イエスが道をとおっておられるとき、生れつきの盲人を見られた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p1.b2": {
    "text": "「先生、この人が生れつき盲人なのは、だれが罪を犯したためですか。本人ですか、それともその両親ですか」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p2.b1": {
    "text": "「本人が罪を犯したのでもなく、また、その両親が犯したのでもない。ただ神のみわざが、彼の上に現れるためである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p2.b2": {
    "text": "わたしたちは、わたしをつかわされたかたのわざを、昼の間にしなければならない。夜が来る。すると、だれも働けなくなる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p2.b3": {
    "text": "わたしは、この世にいる間は、世の光である」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p3.b1": {
    "text": "イエスはそう言って、地につばきをし、そのつばきで、どろをつくり、そのどろを盲人の目に塗って言われた、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p3.b2": {
    "text": "「シロアム…の池に行って洗いなさい」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p3.b3": {
    "text": "（つかわされた者、の意）",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p4.b1": {
    "text": "そこで彼は行って洗った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p4.b2": {
    "text": "そして見えるようになって、帰って行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p5.b1": {
    "text": "「この人は、すわってこじきをしていた者ではないか」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p5.b2": {
    "text": "「その人だ」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p5.b3": {
    "text": "「いや、ただあの人に似ているだけだ」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p5.b4": {
    "text": "「わたしがそれだ」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p6.b1": {
    "text": "「では、おまえの目はどうしてあいたのか」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p6.b2": {
    "text": "「イエスというかたが、どろをつくって、わたしの目に塗り、…それで、行って洗うと、見えるようになりました」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p6.b3": {
    "text": "「その人はどこにいるのか」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p6.b4": {
    "text": "「知りません」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p7.b1": {
    "text": "イエスがどろをつくって彼の目をあけたのは、安息日であった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p7.b2": {
    "text": "「その人は神からきた人ではない。安息日を守っていないのだから」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p7.b3": {
    "text": "「罪のある人が、どうしてそのようなしるしを行うことができようか」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p7.b4": {
    "text": "「預言者だと思います」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p8.b1": {
    "text": "「これが、生れつき盲人であったと、おまえたちの言っているむすこか。それではどうして、いま目が見えるのか」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p8.b2": {
    "text": "「これがわたしどものむすこであること、また生れつき盲人であったことは存じています。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p8.b3": {
    "text": "あれに聞いて下さい。あれはもうおとなですから、自分のことは自分で話せるでしょう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p8.b4": {
    "text": "両親はユダヤ人たちを恐れていたので、こう答えたのである。それは、もしイエスをキリストと告白する者があれば、会堂から追い出すことに、ユダヤ人たちが既に決めていたからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p9.b1": {
    "text": "そこで彼らは、盲人であった人をもう一度呼んで",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p9.b2": {
    "text": "「神に栄光を帰するがよい。あの人が罪人であることは、わたしたちにはわかっている」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p9.b3": {
    "text": "「あのかたが罪人であるかどうか、わたしは知りません。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p9.b4": {
    "text": "ただ一つのことだけ知っています。わたしは盲であったが、今は見えるということです」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p10.b1": {
    "text": "「その人はおまえに何をしたのか。どんなにしておまえの目をあけたのか」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p10.b2": {
    "text": "…あなたがたも、あの人の弟子になりたいのですか」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p10.b3": {
    "text": "「おまえはあれの弟子だが、わたしたちはモーセの弟子だ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p10.b4": {
    "text": "…だが、あの人がどこからきた者か、わたしたちは知らぬ」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p11.b1": {
    "text": "「わたしの目をあけて下さったのに、そのかたがどこからきたか、ご存じないとは、不思議千万です。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p11.b2": {
    "text": "生れつき盲であった者の目をあけた人があるということは、世界が始まって以来、聞いたことがありません。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p11.b3": {
    "text": "もしあのかたが神からきた人でなかったら、何一つできなかったはずです」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p12.b1": {
    "text": "「おまえは全く罪の中に生れていながら、わたしたちを教えようとするのか」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p12.b2": {
    "text": "そして彼を外へ追い出した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p13.b1": {
    "text": "イエスは、その人が外へ追い出されたことを聞かれた。そして彼に会って",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p13.b2": {
    "text": "「あなたは人の子を信じるか」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p13.b3": {
    "text": "「主よ、それはどなたですか。そのかたを信じたいのですが」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:36"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p13.b4": {
    "text": "「あなたは、もうその人に会っている。今あなたと話しているのが、その人である」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:37"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p14.b1": {
    "text": "「主よ、信じます」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p14.b2": {
    "text": "イエスを拝した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p15.b1": {
    "text": "「わたしがこの世にきたのは、さばくためである。すなわち、見えない人たちが見えるようになり、見える人たちが見えないようになるためである」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p15.b2": {
    "text": "「それでは、わたしたちも盲なのでしょうか」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p15.b3": {
    "text": "「もしあなたがたが盲人であったなら、罪はなかったであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.9.p15.b4": {
    "text": "しかし、今あなたがたが『見える』と言い張るところに、あなたがたの罪がある。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 9:41"
    },
    "adapted": false,
    "status": "approved"
  }
}
