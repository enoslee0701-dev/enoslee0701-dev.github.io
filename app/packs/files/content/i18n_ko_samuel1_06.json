{
  "samuel1.6.p1.b1": {
    "text": "여호와의 궤가 블레셋 사람의 지방에 있은지 일곱 달이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 6:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.6.p1.b2": {
    "text": "우리가 여호와의 궤를 어떻게 할꼬 그것을 어떻게 본처로 보낼 것을 우리에게 가르치라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 6:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.6.p1.b3": {
    "text": "이스라엘 신의 궤를 보내려거든 거저 보내지 말고 그에게 속건제를 드려야 할지니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 6:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.6.p1.b4": {
    "text": "그리하면 병도 낫고 그 손을 너희에게서 옮기지 아니하는 연고도 알리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 6:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.6.p2.b1": {
    "text": "무엇으로 그에게 드릴 속건제를 삼을꼬",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 6:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.6.p2.b2": {
    "text": "블레셋 사람의 방백의 수효대로 금독종 다섯과 금쥐 다섯이라야 하리니…",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 6:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.6.p2.b3": {
    "text": "이스라엘 신께 영화를 돌리라…",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 6:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.6.p2.b4": {
    "text": "애굽인과 바로가 그 마음을 강퍅케 한 것같이 어찌하여 너희가 너희 마음을 강퍅케 하겠느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 6:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.6.p3.b1": {
    "text": "새 수레를 만들고 멍에 메어 보지 아니한 젖 나는 소 둘을 끌어다가 수레를 소에 메우고…",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 6:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.6.p3.b2": {
    "text": "그 송아지들은 떼어 집으로 돌려 보내고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 6:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.6.p3.b3": {
    "text": "궤가 그 본 지경 길로 올라가서 벧세메스로 가면 이 큰 재앙은 그가 우리에게 내린 것이요…",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 6:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.6.p4.b1": {
    "text": "그 사람들이 그같이 하여 젖 나는 소 둘을 끌어다가 수레를 메우고 송아지들은 집에 가두고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 6:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.6.p4.b2": {
    "text": "암소가 벧세메스 길로 바로 행하여 대로로 가며 갈 때에 울고 좌우로 치우치지 아니하였고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 6:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.6.p4.b3": {
    "text": "블레셋 방백들은 벧세메스 경계까지 따라 가니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 6:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.6.p5.b1": {
    "text": "벧세메스 사람들이 골짜기에서 밀을 베다가 눈을 들어 궤를 보고…",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 6:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.6.p5.b2": {
    "text": "그것의 보임을 기뻐하더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 6:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.6.p6.b1": {
    "text": "수레가 벧세메스 사람 여호수아의 밭 큰 돌 있는 곳에 이르러 선지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 6:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.6.p6.b2": {
    "text": "무리가 수레의 나무를 패고 그 소를 번제로 여호와께 드리고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 6:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.6.p6.b3": {
    "text": "레위인은 여호와의 궤와 그 궤와 함께 있는 금 보물 담긴 상자를 내려다가 큰 돌 위에 두매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 6:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.6.p6.b4": {
    "text": "블레셋 다섯 방백이 이것을 보고 그날에 에그론으로 돌아갔더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 6:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.6.p6.b5": {
    "text": "그 돌은 벧세메스 사람 여호수아의 밭에 오늘까지 있더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 6:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.6.p7.b1": {
    "text": "벧세메스 사람들이 여호와의 궤를 들여다 본 고로 그들을 치사 오만 칠십인을 죽이신지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 6:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.6.p7.b2": {
    "text": "여호와께서 백성을 쳐서 크게 살륙하셨으므로 백성이 애곡하였더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 6:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.6.p7.b3": {
    "text": "이 거룩하신 하나님 여호와 앞에 누가 능히 서리요 그를 우리에게서 뉘게로 가시게 할꼬",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 6:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.6.p7.b4": {
    "text": "블레셋 사람이 여호와의 궤를 도로 가져왔으니 너희는 내려와서 그것을 너희에게로 옮겨 가라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "1 Samuel 6:21"
    },
    "adapted": false,
    "status": "approved"
  }
}
