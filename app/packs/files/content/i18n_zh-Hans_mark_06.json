{
  "mark.6.p1.b1": {
    "text": "耶稣离开那里，来到自己的家乡；门徒也跟从他。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣离⁠开那⁠里，来⁠到自⁠己的家⁠乡；门⁠徒也跟从他。"
  },
  "mark.6.p1.b2": {
    "text": "这人从哪里有这些事呢？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "这人从哪⁠里有这⁠些事呢？"
  },
  "mark.6.p1.b3": {
    "text": "所赐给他的是什么智慧？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "所赐⁠给他⁠的是什⁠么智⁠慧？"
  },
  "mark.6.p1.b4": {
    "text": "他手所做的是何等的异能呢？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他手所做⁠的是何⁠等的异⁠能呢？"
  },
  "mark.6.p2.b1": {
    "text": "这不是那木匠吗？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:3"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "这不⁠是那木⁠匠吗？"
  },
  "mark.6.p2.b2": {
    "text": "不是马利亚的儿子雅各、约西、犹大、西门的长兄吗？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:3"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "不⁠是马⁠利⁠亚的儿⁠子雅⁠各、约⁠西、犹⁠大、西⁠门的长⁠兄吗？"
  },
  "mark.6.p2.b3": {
    "text": "他妹妹们不也是在我们这里吗？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:3"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他妹⁠妹们不也⁠是在我⁠们这⁠里吗？"
  },
  "mark.6.p2.b4": {
    "text": "他们就厌弃他。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:3"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠们就厌⁠弃他。"
  },
  "mark.6.p3.b1": {
    "text": "大凡先知，除了本地、亲属、本家之外，没有不被人尊敬的。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:4"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "大⁠凡先⁠知，除⁠了本⁠地、亲⁠属、本⁠家之⁠外，没⁠有不⁠被人尊⁠敬的。"
  },
  "mark.6.p3.b2": {
    "text": "耶稣就在那里不得行什么异能，不过按手在几个病人身上，治好他们。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:5"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣就⁠在那⁠里不⁠得行什⁠么异⁠能，不⁠过按手在几⁠个病⁠人身⁠上，治⁠好他⁠们。"
  },
  "mark.6.p3.b3": {
    "text": "他也诧异他们不信，就往周围乡村教训人去了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:6"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他也诧⁠异他⁠们不⁠信，就往周⁠围乡⁠村教⁠训人去⁠了。"
  },
  "mark.6.p4.b1": {
    "text": "差遣他们两个两个地出去，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "差⁠遣他⁠们两个两个地出⁠去，"
  },
  "mark.6.p4.b2": {
    "text": "也赐给他们权柄，制伏污鬼；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "也赐⁠给他⁠们权⁠柄，制⁠伏污⁠鬼；"
  },
  "mark.6.p4.b3": {
    "text": "行路的时候不要带食物和口袋，腰袋里也不要带钱，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "行⁠路的时⁠候不⁠要带食⁠物和口⁠袋，腰袋里也⁠不要⁠带钱，"
  },
  "mark.6.p4.b4": {
    "text": "除了拐杖以外，什么都不要带；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "除⁠了拐⁠杖以⁠外，什⁠么都⁠不要⁠带；"
  },
  "mark.6.p5.b1": {
    "text": "你们无论到何处，进了人的家，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:10"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们无⁠论到何⁠处，进了人⁠的家，"
  },
  "mark.6.p5.b2": {
    "text": "就住在那里，直到离开那地方。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:10"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "就住⁠在那⁠里，直⁠到离⁠开那地⁠方。"
  },
  "mark.6.p5.b3": {
    "text": "何处的人不接待你们，不听你们，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:11"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "何⁠处的人不接⁠待你⁠们，不听你⁠们，"
  },
  "mark.6.p5.b4": {
    "text": "……就把脚上的尘土跺下去，对他们作见证。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:11"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "……就⁠把脚⁠上的尘⁠土跺下⁠去，对他⁠们作见⁠证。"
  },
  "mark.6.p6.b1": {
    "text": "门徒就出去传道，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:12"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "门⁠徒就出⁠去传⁠道，"
  },
  "mark.6.p6.b2": {
    "text": "叫人悔改，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:12"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "叫人悔⁠改，"
  },
  "mark.6.p6.b3": {
    "text": "又赶出许多的鬼，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "又赶⁠出许⁠多的鬼，"
  },
  "mark.6.p6.b4": {
    "text": "用油抹了许多病人，治好他们。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "用油抹⁠了许⁠多病⁠人，治⁠好他⁠们。"
  },
  "mark.6.p7.b1": {
    "text": "施洗的约翰从死里复活了，……",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:14"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "施⁠洗的约⁠翰从死里复⁠活了，……"
  },
  "mark.6.p7.b2": {
    "text": "是以利亚。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:15"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "是以⁠利⁠亚。"
  },
  "mark.6.p7.b3": {
    "text": "是先知，正像先知中的一位。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:15"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "是先⁠知，正⁠像先⁠知中⁠的一⁠位。"
  },
  "mark.6.p7.b4": {
    "text": "是我所斩的约翰，他复活了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:16"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "是我所斩的约⁠翰，他复⁠活了。"
  },
  "mark.6.p8.b1": {
    "text": "先是希律为他兄弟腓力的妻子希罗底的缘故，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:17"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "先⁠是希⁠律为他兄⁠弟腓⁠力的妻⁠子希⁠罗⁠底的缘⁠故，"
  },
  "mark.6.p8.b2": {
    "text": "你娶你兄弟的妻子是不合理的。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:18"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你娶你兄⁠弟的妻⁠子是不⁠合⁠理的。"
  },
  "mark.6.p8.b3": {
    "text": "于是希罗底怀恨他，想要杀他，只是不能；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:19"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "于⁠是希⁠罗⁠底怀⁠恨他，想⁠要杀他，只⁠是不⁠能；"
  },
  "mark.6.p8.b4": {
    "text": "因为希律知道约翰是义人，是圣人，所以敬畏他，保护他，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:20"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "因⁠为希⁠律知⁠道约⁠翰是义人，是圣⁠人，所⁠以敬⁠畏他，保⁠护他，"
  },
  "mark.6.p9.b1": {
    "text": "有一天，恰巧是希律的生日，希律摆设筵席，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:21"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有一⁠天，恰⁠巧是希⁠律的生⁠日，希⁠律摆⁠设筵⁠席，"
  },
  "mark.6.p9.b2": {
    "text": "希罗底的女儿进来跳舞，使希律和同席的人都欢喜。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:22"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "希⁠罗⁠底的女⁠儿进⁠来跳⁠舞，使希⁠律和同⁠席的人都欢⁠喜。"
  },
  "mark.6.p9.b3": {
    "text": "你随意向我求什么，我必给你。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:22"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你随⁠意向我求什⁠么，我必给你。"
  },
  "mark.6.p9.b4": {
    "text": "……就是我国的一半，我也必给你。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:23"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "……就⁠是我⁠国的一⁠半，我⁠也必给你。"
  },
  "mark.6.p10.b1": {
    "text": "我可以求什么呢？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:24"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我可⁠以求什⁠么呢？"
  },
  "mark.6.p10.b2": {
    "text": "施洗约翰的头。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:24"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "施⁠洗约⁠翰的头。"
  },
  "mark.6.p10.b3": {
    "text": "我愿王立时把施洗约翰的头放在盘子里给我。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:25"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我愿王⁠立时把施⁠洗约⁠翰的头放⁠在盘⁠子里给我。"
  },
  "mark.6.p11.b1": {
    "text": "王就甚忧愁；但因他所起的誓，又因同席的人，就不肯推辞，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:26"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "王就甚忧⁠愁；但因他⁠所起的誓，又因同⁠席的人，就不⁠肯推⁠辞，"
  },
  "mark.6.p11.b2": {
    "text": "随即差一个护卫兵，吩咐拿约翰的头来。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:27"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "随⁠即差一⁠个护⁠卫兵，吩⁠咐拿约⁠翰的头来。"
  },
  "mark.6.p11.b3": {
    "text": "护卫兵就去，在监里斩了约翰，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:27"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "护⁠卫兵就⁠去，在监里斩了约⁠翰，"
  },
  "mark.6.p11.b4": {
    "text": "……女子就给她母亲。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:28"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "……女⁠子就给她母⁠亲。"
  },
  "mark.6.p12.b1": {
    "text": "约翰的门徒听见了，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:29"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "约⁠翰的门⁠徒听⁠见⁠了，"
  },
  "mark.6.p12.b2": {
    "text": "就来把他的尸首领去，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:29"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "就来把他⁠的尸⁠首领⁠去，"
  },
  "mark.6.p12.b3": {
    "text": "葬在坟墓里。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:29"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "葬⁠在坟⁠墓里。"
  },
  "mark.6.p13.b1": {
    "text": "使徒聚集到耶稣那里，将一切所做的事、所传的道全告诉他。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:30"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "使⁠徒聚⁠集到耶⁠稣那⁠里，将一⁠切所做⁠的事、所传的道全告⁠诉他。"
  },
  "mark.6.p13.b2": {
    "text": "你们来，同我暗暗地到旷野地方去歇一歇。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:31"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们来，同我暗⁠暗地到旷⁠野地⁠方去歇一歇。"
  },
  "mark.6.p13.b3": {
    "text": "这是因为来往的人多，他们连吃饭也没有工夫。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:31"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "这是因⁠为来⁠往的人多，他⁠们连吃⁠饭也⁠没⁠有工⁠夫。"
  },
  "mark.6.p13.b4": {
    "text": "他们就坐船，暗暗地往旷野地方去。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:32"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠们就坐⁠船，暗⁠暗地往旷⁠野地⁠方去。"
  },
  "mark.6.p14.b1": {
    "text": "……一同跑到那里，比他们先赶到了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:33"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "……一⁠同跑⁠到那⁠里，比他⁠们先赶到⁠了。"
  },
  "mark.6.p14.b2": {
    "text": "耶稣出来，见有许多的人，就怜悯他们，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:34"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣出⁠来，见有许⁠多的人，就怜⁠悯他⁠们，"
  },
  "mark.6.p14.b3": {
    "text": "因为他们如同羊没有牧人一般，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:34"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "因⁠为他⁠们如⁠同羊没⁠有牧⁠人一⁠般，"
  },
  "mark.6.p14.b4": {
    "text": "于是开口教训他们许多道理。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:34"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "于⁠是开⁠口教⁠训他⁠们许⁠多道⁠理。"
  },
  "mark.6.p15.b1": {
    "text": "这是野地，天已经晚了，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:35"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "这是野⁠地，天已⁠经晚了，"
  },
  "mark.6.p15.b2": {
    "text": "请叫众人散开，他们好往四面乡村里去，自己买什么吃。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:36"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "请叫众⁠人散⁠开，他⁠们好往四⁠面乡⁠村里去，自⁠己买什⁠么吃。"
  },
  "mark.6.p15.b3": {
    "text": "你们给他们吃吧。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:37"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们给他⁠们吃吧。"
  },
  "mark.6.p15.b4": {
    "text": "我们可以去买二十两银子的饼给他们吃吗？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:37"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我⁠们可⁠以去买二⁠十两银⁠子的饼给他⁠们吃吗？"
  },
  "mark.6.p16.b1": {
    "text": "你们有多少饼，可以去看看。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:38"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们有多⁠少饼，可⁠以去看⁠看。"
  },
  "mark.6.p16.b2": {
    "text": "五个饼，两条鱼。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p16.b3": {
    "text": "耶稣吩咐他们，叫众人一帮一帮地坐在青草地上。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:39"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣吩⁠咐他⁠们，叫众⁠人一帮一帮地坐⁠在青⁠草⁠地上。"
  },
  "mark.6.p16.b4": {
    "text": "众人就一排一排地坐下，有一百一排的，有五十一排的。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:40"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "众⁠人就一⁠排一⁠排地坐⁠下，有一⁠百一⁠排的，有五⁠十一⁠排的。"
  },
  "mark.6.p17.b1": {
    "text": "耶稣拿着这五个饼，两条鱼，望着天祝福，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:41"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣拿着这五个饼，两条鱼，望着天祝⁠福，"
  },
  "mark.6.p17.b2": {
    "text": "擘开饼，递给门徒，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:41"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "擘开饼，递给门⁠徒，"
  },
  "mark.6.p17.b3": {
    "text": "摆在众人面前，也把那两条鱼分给众人。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:41"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "摆在众⁠人面⁠前，也⁠把那两条鱼分给众⁠人。"
  },
  "mark.6.p18.b1": {
    "text": "他们都吃，并且吃饱了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:42"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠们都吃，并⁠且吃饱了。"
  },
  "mark.6.p18.b2": {
    "text": "门徒就把碎饼碎鱼收拾起来，装满了十二个篮子。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:43"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "门⁠徒就⁠把碎饼碎鱼收⁠拾起⁠来，装⁠满了十⁠二⁠个篮⁠子。"
  },
  "mark.6.p18.b3": {
    "text": "吃饼的男人共有五千。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:44"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "吃饼的男⁠人共⁠有五⁠千。"
  },
  "mark.6.p19.b1": {
    "text": "耶稣随即催门徒上船，先渡到那边伯赛大去，等他叫众人散开。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:45"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣随⁠即催门⁠徒上⁠船，先渡到那⁠边伯⁠赛⁠大去，等他叫众⁠人散⁠开。"
  },
  "mark.6.p19.b2": {
    "text": "他既辞别了他们，就往山上去祷告。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:46"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他既辞别⁠了他⁠们，就往山上⁠去祷⁠告。"
  },
  "mark.6.p19.b3": {
    "text": "到了晚上，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:47"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "到⁠了晚⁠上，"
  },
  "mark.6.p19.b4": {
    "text": "船在海中，耶稣独自在岸上；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:47"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "船在海⁠中，耶⁠稣独⁠自在岸⁠上；"
  },
  "mark.6.p20.b1": {
    "text": "看见门徒因风不顺，摇橹甚苦。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:48"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "看⁠见门⁠徒因风不顺，摇橹甚苦。"
  },
  "mark.6.p20.b2": {
    "text": "夜里约有四更天，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:48"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "夜⁠里约有四更天，"
  },
  "mark.6.p20.b3": {
    "text": "就在海面上走，往他们那里去，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:48"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "就⁠在海⁠面上走，往他⁠们那⁠里去，"
  },
  "mark.6.p20.b4": {
    "text": "意思要走过他们去。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:48"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "意⁠思要走⁠过他⁠们去。"
  },
  "mark.6.p21.b1": {
    "text": "但门徒看见他在海面上走，以为是鬼怪，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:49"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "但门⁠徒看⁠见他⁠在海⁠面上走，以⁠为⁠是鬼⁠怪，"
  },
  "mark.6.p21.b2": {
    "text": "就喊叫起来；因为他们都看见了他，且甚惊慌。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:49-50"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "就喊⁠叫起⁠来；因⁠为他⁠们都看⁠见了他，且甚惊⁠慌。"
  },
  "mark.6.p21.b3": {
    "text": "你们放心！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:50"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们放⁠心！"
  },
  "mark.6.p21.b4": {
    "text": "是我，不要怕！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:50"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "是我，不⁠要怕！"
  },
  "mark.6.p22.b1": {
    "text": "……风就住了；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:51"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p22.b2": {
    "text": "他们心里十分惊奇。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:51"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠们心⁠里十⁠分惊⁠奇。"
  },
  "mark.6.p22.b3": {
    "text": "这是因为他们不明白那分饼的事，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:52"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "这是因⁠为他⁠们不明⁠白那分饼的事，"
  },
  "mark.6.p22.b4": {
    "text": "心里还是愚顽。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:52"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "心⁠里还⁠是愚顽。"
  },
  "mark.6.p23.b1": {
    "text": "既渡过去，来到革尼撒勒地方，就靠了岸，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:53"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "既渡过⁠去，来⁠到革⁠尼撒⁠勒地⁠方，就靠⁠了岸，"
  },
  "mark.6.p23.b2": {
    "text": "一下船，众人认得是耶稣，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:54"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "一⁠下船，众⁠人认⁠得是耶⁠稣，"
  },
  "mark.6.p23.b3": {
    "text": "就跑遍那一带地方，听见他在何处，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:55"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "就跑⁠遍那一⁠带地⁠方，听⁠见他⁠在何⁠处，"
  },
  "mark.6.p23.b4": {
    "text": "便将有病的人用褥子抬到那里。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:55"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "便将有⁠病的人用褥⁠子抬到⁠那⁠里。"
  },
  "mark.6.p24.b1": {
    "text": "凡耶稣所到的地方，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:56"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "凡耶⁠稣所到的地⁠方，"
  },
  "mark.6.p24.b2": {
    "text": "……他们都将病人放在街市上，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:56"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "……他⁠们都将病⁠人放⁠在街⁠市上，"
  },
  "mark.6.p24.b3": {
    "text": "求耶稣只容他们摸他的衣裳繸子；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:56"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "求耶⁠稣只容他⁠们摸他⁠的衣⁠裳繸子；"
  },
  "mark.6.p24.b4": {
    "text": "凡摸着的人就都好了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 6:56"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "凡摸着的人就都好⁠了。"
  }
}
