{
  "esther.5.p1.b1": {
    "text": "三日目に",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Esther 5:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "esther.5.p1.b2": {
    "text": "エステルは王妃の服を着、王宮の内庭に入り、王の広間にむかって立った。王は王宮の玉座に座して王宮の入口にむかっていたが",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Esther 5:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "esther.5.p1.b3": {
    "text": "王妃エステルが庭に立っているのを見て彼女に恵みを示し、その手にある金の笏をエステルの方に伸ばしたので",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Esther 5:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "esther.5.p1.b4": {
    "text": "エステルは進みよってその笏の頭にさわった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Esther 5:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "esther.5.p2.b1": {
    "text": "「王妃エステルよ、何を求めるのか。あなたの願いは何か。国の半ばでもあなたに与えよう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Esther 5:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "esther.5.p2.b2": {
    "text": "「もし王がよしとされるならば、きょうわたしが王のために設けた酒宴に、ハマンとご一緒にお臨みください」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Esther 5:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "esther.5.p2.b3": {
    "text": "「ハマンを速く連れてきて、エステルの言うようにせよ」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Esther 5:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "esther.5.p2.b4": {
    "text": "やがて王とハマンはエステルの設けた酒宴に臨んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Esther 5:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "esther.5.p3.b1": {
    "text": "酒宴の時、王はエステルに言った、「あなたの求めることは何か。必ず聞かれる。あなたの願いは何か。国の半ばでも聞きとどけられる」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Esther 5:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "esther.5.p3.b2": {
    "text": "エステルは答えて言った、「わたしの求め、わたしの願いはこれです。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Esther 5:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "esther.5.p3.b3": {
    "text": "もしわたしが王の目の前に恵みを得、また王がもしわたしの求めを許し、わたしの願いを聞きとどけるのをよしとされるならば、ハマンとご一緒に、あすまた、わたしが設けようとする酒宴に、お臨みください。わたしはあす王のお言葉どおりにいたしましょう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Esther 5:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "esther.5.p4.b1": {
    "text": "こうしてハマンはその日、心に喜び楽しんで出てきたが",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Esther 5:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "esther.5.p4.b2": {
    "text": "ハマンはモルデカイが王の門にいて、自分にむかって立ちあがりもせず、また身動きもしないのを見たので",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Esther 5:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "esther.5.p4.b3": {
    "text": "モルデカイに対し怒りに満たされた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Esther 5:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "esther.5.p5.b1": {
    "text": "しかしハマンは耐え忍んで家に帰り",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Esther 5:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "esther.5.p5.b2": {
    "text": "人をやってその友だちおよび妻ゼレシを呼んでこさせ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Esther 5:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "esther.5.p5.b3": {
    "text": "そしてハマンはその富の栄華と、そのむすこたちの多いことと、すべて王が自分を重んじられたこと、また王の大臣および侍臣たちにまさって自分を昇進させられたことを彼らに語った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Esther 5:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "esther.5.p5.b4": {
    "text": "「王妃エステルは酒宴を設けたが、わたしのほかはだれも王と共にこれに臨ませなかった。あすもまたわたしは王と共に王妃に招かれている。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Esther 5:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "esther.5.p5.b5": {
    "text": "しかしユダヤ人モルデカイが王の門に座しているのを見る間は、これらの事もわたしには楽しくない」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Esther 5:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "esther.5.p6.b1": {
    "text": "その時、妻ゼレシとすべての友は彼に言った、「高さ五十キュビトの木を立てさせ、あすの朝、モルデカイをその上に掛けるように王に申し上げなさい。そして王と一緒に楽しんでその酒宴においでなさい」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Esther 5:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "esther.5.p6.b2": {
    "text": "ハマンはこの事をよしとして",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Esther 5:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "esther.5.p6.b3": {
    "text": "その木を立てさせた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Esther 5:14"
    },
    "adapted": false,
    "status": "approved"
  }
}
