{
  "philemon.1.p1.b1": {
    "text": "キリスト・イエスの囚人パウロと兄弟テモテから、わたしたちの愛する同労者ピレモン、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philemon 1:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "philemon.1.p1.b2": {
    "text": "姉妹アピヤ、わたしたちの戦友アルキポ、ならびに、あなたの家にある教会へ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philemon 1:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "philemon.1.p1.b3": {
    "text": "わたしたちの父なる神と主イエス・キリストから、恵みと平安とが、あなたがたにあるように。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philemon 1:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "philemon.1.p2.b4": {
    "text": "わたしは、祈の時にあなたをおぼえて、いつもわたしの神に感謝している。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philemon 1:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "philemon.1.p2.b5": {
    "text": "それは、主イエスに対し、また、すべての聖徒に対するあなたの愛と信仰とについて、聞いているからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philemon 1:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "philemon.1.p2.b6": {
    "text": "兄弟よ。わたしは、あなたの愛によって多くの喜びと慰めとを与えられた。聖徒たちの心が、あなたによって力づけられたからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philemon 1:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "philemon.1.p3.b7": {
    "text": "こういうわけで、わたしは、キリストにあってあなたのなすべき事を、きわめて率直に指示してもよいと思うが、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philemon 1:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "philemon.1.p3.b8": {
    "text": "むしろ、愛のゆえにお願いする。すでに老年になり、今またキリスト・イエスの囚人となっているこのパウロが、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philemon 1:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "philemon.1.p3.b9": {
    "text": "捕われの身で産んだわたしの子供オネシモについて、あなたにお願いする。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philemon 1:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "philemon.1.p4.b10": {
    "text": "彼は以前は、あなたにとって無益な者であったが、今は、あなたにも、わたしにも、有益な者になった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philemon 1:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "philemon.1.p4.b11": {
    "text": "彼をあなたのもとに送りかえす。彼はわたしの心である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philemon 1:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "philemon.1.p4.b12": {
    "text": "わたしは彼を身近に引きとめておいて、わたしが福音のために捕われている間、あなたに代って仕えてもらいたかったのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philemon 1:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "philemon.1.p4.b13": {
    "text": "…あなたが強制されて良い行いをするのではなく、自発的にすることを願っている。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philemon 1:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "philemon.1.p5.b14": {
    "text": "彼がしばらくの間あなたから離れていたのは、あなたが彼をいつまでも留めておくためであったかも知れない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philemon 1:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "philemon.1.p5.b15": {
    "text": "もはや奴隷としてではなく、奴隷以上のもの、愛する兄弟としてである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philemon 1:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "philemon.1.p5.b16": {
    "text": "とりわけ、わたしにとってそうであるが、ましてあなたにとっては、肉においても、主にあっても、それ以上であろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philemon 1:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "philemon.1.p6.b17": {
    "text": "そこで、もしわたしをあなたの信仰の友と思ってくれるなら、わたし同様に彼を受けいれてほしい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philemon 1:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "philemon.1.p6.b18": {
    "text": "もし、彼があなたに何か不都合なことをしたか、あるいは、何か負債があれば、それをわたしの借りにしておいてほしい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philemon 1:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "philemon.1.p6.b19": {
    "text": "このパウロが手ずからしるす、わたしがそれを返済する。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philemon 1:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "philemon.1.p6.b20": {
    "text": "この際、あなたが、あなた自身をわたしに負うていることについては、何も言うまい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philemon 1:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "philemon.1.p7.b21": {
    "text": "兄弟よ。…わたしの心を、主にあって力づけてもらいたい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philemon 1:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "philemon.1.p7.b22": {
    "text": "わたしはあなたの従順を堅く信じて、この手紙を書く。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philemon 1:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "philemon.1.p7.b23": {
    "text": "あなたは、確かにわたしが言う以上のことをしてくれるだろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philemon 1:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "philemon.1.p8.b24": {
    "text": "ついでにお願いするが、わたしのために宿を用意しておいてほしい。あなたがたの祈によって、あなたがたの所に行かせてもらえるように望んでいるのだから。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philemon 1:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "philemon.1.p8.b25": {
    "text": "キリスト・イエスにあって、わたしと共に捕われの身になっているエパフラスから、あなたによろしく。 わたしの同労者たち、マルコ、アリスタルコ、デマス、ルカからも、よろしく。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philemon 1:23-24"
    },
    "adapted": false,
    "status": "approved"
  },
  "philemon.1.p8.b26": {
    "text": "主イエス・キリストの恵みが、あなたがたの霊と共にあるように。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philemon 1:25"
    },
    "adapted": false,
    "status": "approved"
  }
}
