{
  "timothy2.4.p1.b1": {
    "text": "神のみまえと、生きている者と死んだ者とをさばくべきキリスト・イエスのみまえで、キリストの出現とその御国とを思い、おごそかに命じる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Timothy 4:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "timothy2.4.p1.b2": {
    "text": "御言を宣べ伝えなさい。時が良くても悪くても、それを励み、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Timothy 4:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "timothy2.4.p1.b3": {
    "text": "あくまでも寛容な心でよく教えて、責め、戒め、勧めなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Timothy 4:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "timothy2.4.p2.b1": {
    "text": "人々が健全な教に耐えられなくなり、耳ざわりのよい話をしてもらおうとして、自分勝手な好みにまかせて教師たちを寄せ集め、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Timothy 4:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "timothy2.4.p2.b2": {
    "text": "そして、真理からは耳をそむけて、作り話の方にそれていく時が来るであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Timothy 4:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "timothy2.4.p2.b3": {
    "text": "しかし、あなたは、何事にも慎み、苦難を忍び、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Timothy 4:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "timothy2.4.p2.b4": {
    "text": "…伝道者のわざをなし、自分の務を全うしなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Timothy 4:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "timothy2.4.p3.b1": {
    "text": "わたしは、すでに自身を犠牲としてささげている。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Timothy 4:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "timothy2.4.p3.b2": {
    "text": "わたしが世を去るべき時はきた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Timothy 4:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "timothy2.4.p4.b1": {
    "text": "わたしは戦いをりっぱに戦いぬき、走るべき行程を走りつくし、信仰を守りとおした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Timothy 4:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "timothy2.4.p4.b2": {
    "text": "今や、義の冠がわたしを待っているばかりである。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Timothy 4:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "timothy2.4.p4.b3": {
    "text": "わたしばかりではなく、主の出現を心から待ち望んでいたすべての人にも授けて下さるであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Timothy 4:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "timothy2.4.p5.b1": {
    "text": "わたしの所に、急いで早くきてほしい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Timothy 4:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "timothy2.4.p5.b2": {
    "text": "デマスはこの世を愛し、わたしを捨ててテサロニケに行ってしまい、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Timothy 4:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "timothy2.4.p5.b3": {
    "text": "クレスケンスはガラテヤに、テトスはダルマテヤに行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Timothy 4:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "timothy2.4.p5.b4": {
    "text": "ただルカだけが、わたしのもとにいる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Timothy 4:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "timothy2.4.p6.b1": {
    "text": "あなたが来るときに、トロアスのカルポの所に残しておいた上着を持ってきてほしい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Timothy 4:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "timothy2.4.p6.b2": {
    "text": "また書物も、特に、羊皮紙のを持ってきてもらいたい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Timothy 4:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "timothy2.4.p6.b3": {
    "text": "銅細工人のアレキサンデルが、わたしを大いに苦しめた。主はそのしわざに対して、彼に報いなさるだろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Timothy 4:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "timothy2.4.p6.b4": {
    "text": "あなたも、彼を警戒しなさい。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Timothy 4:15"
    },
    "adapted": false,
    "status": "approved"
  }
}
