{
  "genesis.32.p1.b1": {
    "text": "さて、ヤコブが旅路に進んだとき、神の使たちが彼に会った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p1.b2": {
    "text": "「これは神の陣営です」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p1.b3": {
    "text": "「あなたがたはわたしの主人エサウにこう言いなさい、『あなたのしもべヤコブはこう言いました。わたしはラバンのもとに寄留して今までとどまりました。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p1.b4": {
    "text": "わたしは牛、ろば、羊、男女の奴隷を持っています。それでわが主に申し上げて、あなたの前に恵みを得ようと人をつかわしたのです』」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p2.b1": {
    "text": "「わたしたちはあなたの兄エサウのもとへ行きました。彼もまたあなたを迎えようと四百人を率いてきます」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p2.b2": {
    "text": "そこでヤコブは大いに恐れ、苦しみ、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p2.b3": {
    "text": "「たとい、エサウがきて、一つの組を撃っても、残りの組はのがれるであろう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p3.b1": {
    "text": "「父アブラハムの神、父イサクの神よ、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p3.b2": {
    "text": "あなたがしもべに施されたすべての恵みとまことをわたしは受けるに足りない者です。わたしは、つえのほか何も持たないでこのヨルダンを渡りましたが、今は二つの組にもなりました。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p3.b3": {
    "text": "どうぞ、兄エサウの手からわたしをお救いください。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p3.b4": {
    "text": "あなたは、かつて、『わたしは必ずおまえを恵み、おまえの子孫を海の砂の数えがたいほど多くしよう』と言われました」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p4.b1": {
    "text": "彼はその夜そこに宿り、持ち物のうちから兄エサウへの贈り物を選んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p4.b2": {
    "text": "すなわち雌やぎ二百、雄やぎ二十、雌羊二百、雄羊二十、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p4.b3": {
    "text": "乳らくだ三十とその子、雌牛四十、雄牛十、雌ろば二十、雄ろば十。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p4.b4": {
    "text": "「あなたがたはわたしの先に進みなさい、そして群れと群れとの間には隔たりをおきなさい」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p5.b1": {
    "text": "「もし、兄エサウがあなたに会って『だれのしもべで、どこへ行くのか。あなたの前にあるこれらのものはだれの物か』と尋ねたら、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p5.b2": {
    "text": "『あなたのしもべヤコブの物で、わが主エサウにおくる贈り物です。彼もわたしたちのうしろにおります』と言いなさい」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p5.b3": {
    "text": "「わたしがさきに送る贈り物をもってまず彼をなだめ、それから、彼の顔を見よう。そうすれば、彼はわたしを迎えてくれるであろう」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p5.b4": {
    "text": "こうして贈り物は彼に先立って渡り、彼はその夜、宿営にやどった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p6.b1": {
    "text": "彼はその夜起きて、ふたりの妻とふたりのつかえめと十一人の子どもとを連れてヤボクの渡しをわたった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p6.b2": {
    "text": "すなわち彼らを導いて川を渡らせ、また彼の持ち物を渡らせた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p6.b3": {
    "text": "ヤコブはひとりあとに残ったが、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p6.b4": {
    "text": "ひとりの人が、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p7.b1": {
    "text": "ひとりの人が、夜明けまで彼と組打ちした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p7.b2": {
    "text": "ところでその人はヤコブに勝てないのを見て、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p7.b3": {
    "text": "ヤコブのもものつがいにさわったので、ヤコブのもものつがいが、その人と組打ちするあいだにはずれた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p8.b1": {
    "text": "「夜が明けるからわたしを去らせてください」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p8.b2": {
    "text": "「わたしを祝福してくださらないなら、あなたを去らせません」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p8.b3": {
    "text": "その人は彼に言った、「あなたの名はなんと言いますか」。彼は答えた、「ヤコブです」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p8.b4": {
    "text": "「あなたはもはや名をヤコブと言わず、イスラエルと言いなさい。あなたが神と人とに、力を争って勝ったからです」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p9.b1": {
    "text": "ヤコブは尋ねて言った、「どうかわたしにあなたの名を知らせてください」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p9.b2": {
    "text": "するとその人は、「なぜあなたはわたしの名をきくのですか」と言ったが、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p9.b3": {
    "text": "その所で彼を祝福した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p9.b4": {
    "text": "「わたしは顔と顔をあわせて神を見たが、なお生きている」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p10.b1": {
    "text": "こうして彼がペニエルを過ぎる時、日は彼の上にのぼったが、彼はそのもものゆえにびっこを引いていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.32.p10.b2": {
    "text": "そのため、イスラエルの子らは今日まで、もものつがいの上にある腰の筋を食べない。かの人がヤコブのもものつがい、すなわち腰の筋にさわったからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 32:32"
    },
    "adapted": false,
    "status": "approved"
  }
}
