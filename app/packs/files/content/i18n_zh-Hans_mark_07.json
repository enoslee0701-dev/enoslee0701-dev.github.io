{
  "mark.7.p1.b1": {
    "text": "有法利赛人和几个文士从耶路撒冷来，到耶稣那里聚集。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有法⁠利⁠赛人和几⁠个文⁠士从耶⁠路撒⁠冷来，到耶⁠稣那⁠里聚⁠集。"
  },
  "mark.7.p1.b2": {
    "text": "他们曾看见他的门徒中有人用俗手，就是没有洗的手，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠们曾看⁠见他⁠的门⁠徒中有⁠人用俗手，就⁠是没⁠有洗的手，"
  },
  "mark.7.p1.b3": {
    "text": "吃饭。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "吃⁠饭。"
  },
  "mark.7.p2.b1": {
    "text": "原来法利赛人和犹太人都拘守古人的遗传，若不仔细洗手就不吃饭；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:3"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "原⁠来法⁠利⁠赛人和犹⁠太⁠人都拘守古⁠人的遗⁠传，若不仔⁠细洗⁠手就⁠不吃⁠饭；"
  },
  "mark.7.p2.b2": {
    "text": "从市上来，若不洗浴也不吃饭；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:4"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "从市上⁠来，若不洗⁠浴也⁠不吃⁠饭；"
  },
  "mark.7.p2.b3": {
    "text": "还有好些别的规矩，他们历代拘守，就是洗杯、罐、铜器等物。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:4"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "还⁠有好⁠些别⁠的规⁠矩，他⁠们历⁠代拘守，就⁠是洗杯、罐、铜⁠器等物。"
  },
  "mark.7.p3.b1": {
    "text": "你的门徒为什么不照古人的遗传，用俗手吃饭呢？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:5"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠的门⁠徒为⁠什⁠么不照古⁠人的遗⁠传，用俗手吃⁠饭呢？"
  },
  "mark.7.p3.b2": {
    "text": "以赛亚指着你们假冒为善之人所说的预言是不错的。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:6"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "以⁠赛⁠亚指着你⁠们假⁠冒为善⁠之人所说⁠的预⁠言是不⁠错的。"
  },
  "mark.7.p3.b3": {
    "text": "如经上说：这百姓用嘴唇尊敬我，心却远离我。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:6"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "如经上说：这百⁠姓用嘴⁠唇尊⁠敬我，心却远⁠离我。"
  },
  "mark.7.p3.b4": {
    "text": "他们将人的吩咐当作道理教导人，所以拜我也是枉然。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠们将人⁠的吩⁠咐当⁠作道⁠理教⁠导人，所⁠以拜我也⁠是枉⁠然。"
  },
  "mark.7.p4.b1": {
    "text": "你们是离弃神的诫命，拘守人的遗传；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们是离⁠弃神的诫命，拘守人⁠的遗⁠传；"
  },
  "mark.7.p4.b2": {
    "text": "你们诚然是废弃神的诫命，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:9"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们诚然是废⁠弃神的诫命，"
  },
  "mark.7.p4.b3": {
    "text": "要守自己的遗传。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:9"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "要守自⁠己的遗⁠传。"
  },
  "mark.7.p5.b1": {
    "text": "摩西说：『当孝敬父母』；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:10"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "摩⁠西说：『当孝⁠敬父⁠母』；"
  },
  "mark.7.p5.b2": {
    "text": "又说：『咒骂父母的，必治死他。』",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:10"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "又说：『咒⁠骂父⁠母的，必治死他。』"
  },
  "mark.7.p5.b3": {
    "text": "你们倒说：『人若对父母说：我所当奉给你的，已经作了各耳板』",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:11"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们倒说：『人若对父⁠母说：我所当奉给你⁠的，已⁠经作⁠了各⁠耳⁠板』"
  },
  "mark.7.p5.b4": {
    "text": "各耳板就是供献的意思",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:11"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "各⁠耳⁠板就⁠是供献的意⁠思"
  },
  "mark.7.p6.b1": {
    "text": "以后你们就不容他再奉养父母。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:12"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "以⁠后你⁠们就不⁠容他再奉⁠养父⁠母。"
  },
  "mark.7.p6.b2": {
    "text": "这就是你们承接遗传，废了神的道。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "这就⁠是你⁠们承⁠接遗⁠传，废⁠了神的道。"
  },
  "mark.7.p6.b3": {
    "text": "你们还做许多这样的事。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们还做许⁠多这⁠样的事。"
  },
  "mark.7.p7.b1": {
    "text": "你们都要听我的话，也要明白。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:14"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们都⁠要听⁠我的⁠话，也⁠要明⁠白。"
  },
  "mark.7.p7.b2": {
    "text": "从外面进去的不能污秽人，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:15"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "从外⁠面进⁠去的不⁠能污⁠秽人，"
  },
  "mark.7.p7.b3": {
    "text": "惟有从里面出来的乃能污秽人。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:15"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "惟⁠有从里⁠面出⁠来的乃⁠能污⁠秽人。"
  },
  "mark.7.p8.b1": {
    "text": "你们也是这样不明白吗？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:18"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们也⁠是这⁠样不明⁠白吗？"
  },
  "mark.7.p8.b2": {
    "text": "岂不晓得凡从外面进入的，不能污秽人，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:18"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "岂不⁠晓⁠得凡从外⁠面进⁠入的，不⁠能污⁠秽人，"
  },
  "mark.7.p8.b3": {
    "text": "因为不是入他的心，乃是入他的肚腹，又落到茅厕里",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:19"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "因⁠为不⁠是入他⁠的心，乃⁠是入他⁠的肚腹，又落⁠到茅厕里"
  },
  "mark.7.p8.b4": {
    "text": "这是说，各样的食物都是洁净的",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:19"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "这是说，各⁠样的食⁠物都⁠是洁⁠净的"
  },
  "mark.7.p9.b1": {
    "text": "从人里面出来的，那才能污秽人；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:20"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "从人里⁠面出⁠来的，那才⁠能污⁠秽人；"
  },
  "mark.7.p9.b2": {
    "text": "因为从里面，就是从人心里，发出恶念、苟合、",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:21"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "因⁠为从里⁠面，就⁠是从人心⁠里，发⁠出恶⁠念、苟⁠合、"
  },
  "mark.7.p9.b3": {
    "text": "偷盗、凶杀、奸淫、贪婪、邪恶、诡诈、淫荡、嫉妒、谤讟、骄傲、狂妄。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:22"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "偷⁠盗、凶⁠杀、奸⁠淫、贪⁠婪、邪⁠恶、诡⁠诈、淫⁠荡、嫉⁠妒、谤讟、骄⁠傲、狂⁠妄。"
  },
  "mark.7.p9.b4": {
    "text": "这一切的恶都是从里面出来，且能污秽人。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:23"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "这一⁠切的恶都⁠是从里⁠面出⁠来，且能污⁠秽人。"
  },
  "mark.7.p10.b1": {
    "text": "耶稣从那里起身，往泰尔、西顿的境内去，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:24"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣从那⁠里起⁠身，往泰尔、西⁠顿的境⁠内去，"
  },
  "mark.7.p10.b2": {
    "text": "进了一家，不愿意人知道，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:24"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "进了一⁠家，不愿⁠意人知⁠道，"
  },
  "mark.7.p10.b3": {
    "text": "却隐藏不住。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:24"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "却隐⁠藏不⁠住。"
  },
  "mark.7.p11.b1": {
    "text": "当下，有一个妇人，她的小女儿被污鬼附着，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:25"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "当⁠下，有一⁠个妇⁠人，她⁠的小女⁠儿被污⁠鬼附⁠着，"
  },
  "mark.7.p11.b2": {
    "text": "听见耶稣的事，就来俯伏在他脚前。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:25"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "听⁠见耶⁠稣的事，就来俯⁠伏在他脚前。"
  },
  "mark.7.p11.b3": {
    "text": "这妇人是希腊人，属叙利腓尼基族。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:26"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "这妇⁠人是希⁠腊人，属叙利腓⁠尼⁠基族。"
  },
  "mark.7.p11.b4": {
    "text": "她求耶稣赶出那鬼离开她的女儿。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:26"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "她求耶⁠稣赶⁠出那鬼离⁠开她⁠的女⁠儿。"
  },
  "mark.7.p12.b1": {
    "text": "让儿女们先吃饱，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:27"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "让儿⁠女们先⁠吃饱，"
  },
  "mark.7.p12.b2": {
    "text": "不好拿儿女的饼丢给狗吃。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:27"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "不⁠好拿儿⁠女的饼丢⁠给狗吃。"
  },
  "mark.7.p13.b1": {
    "text": "主啊，不错；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:28"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "主啊，不⁠错；"
  },
  "mark.7.p13.b2": {
    "text": "但是狗在桌子底下也吃孩子们的碎渣儿。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:28"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "但⁠是狗在桌⁠子底⁠下也吃孩⁠子们的碎渣儿。"
  },
  "mark.7.p14.b1": {
    "text": "因这句话，你回去吧；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:29"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "因这句话，你回⁠去吧；"
  },
  "mark.7.p14.b2": {
    "text": "鬼已经离开你的女儿了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:29"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "鬼已⁠经离⁠开你⁠的女⁠儿了。"
  },
  "mark.7.p14.b3": {
    "text": "她就回家去，见小孩子躺在床上，鬼已经出去了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:30"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "她就回⁠家去，见小⁠孩⁠子躺⁠在床⁠上，鬼已⁠经出⁠去了。"
  },
  "mark.7.p15.b1": {
    "text": "耶稣又离了泰尔的境界，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:31"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣又离⁠了泰尔的境⁠界，"
  },
  "mark.7.p15.b2": {
    "text": "经过西顿，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:31"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "经⁠过西⁠顿，"
  },
  "mark.7.p15.b3": {
    "text": "就从低加坡里境内来到加利利海。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:31"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "就从低加坡里境⁠内来⁠到加⁠利⁠利海。"
  },
  "mark.7.p16.b1": {
    "text": "有人带着一个耳聋舌结的人来见耶稣，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:32"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有⁠人带着一⁠个耳聋舌结的人来⁠见耶⁠稣，"
  },
  "mark.7.p16.b2": {
    "text": "求他按手在他身上。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:32"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "求他按手在他身⁠上。"
  },
  "mark.7.p16.b3": {
    "text": "耶稣领他离开众人，到一边去，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:33"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣领他离⁠开众⁠人，到一⁠边去，"
  },
  "mark.7.p16.b4": {
    "text": "就用指头探他的耳朵，吐唾沫抹他的舌头，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:33"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "就⁠用指⁠头探他⁠的耳⁠朵，吐⁠唾⁠沫抹他⁠的舌⁠头，"
  },
  "mark.7.p17.b1": {
    "text": "以法大！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:34"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "以⁠法⁠大！"
  },
  "mark.7.p17.b2": {
    "text": "就是说：「开了吧！」",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:34"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "就⁠是说：「开了吧！」"
  },
  "mark.7.p17.b3": {
    "text": "他的耳朵就开了，舌结也解了，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:35"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠的耳⁠朵就开了，舌结也解了，"
  },
  "mark.7.p17.b4": {
    "text": "说话也清楚了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:35"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "说⁠话也清⁠楚了。"
  },
  "mark.7.p18.b1": {
    "text": "耶稣嘱咐他们不要告诉人；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:36"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣嘱⁠咐他⁠们不⁠要告⁠诉人；"
  },
  "mark.7.p18.b2": {
    "text": "但他越发嘱咐，他们越发传扬开了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:36"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "但他越发嘱⁠咐，他⁠们越发传⁠扬开了。"
  },
  "mark.7.p18.b3": {
    "text": "他所做的事都好，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:37"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠所做⁠的事都⁠好，"
  },
  "mark.7.p18.b4": {
    "text": "他连聋子也叫他们听见，哑巴也叫他们说话。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 7:37"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他连聋子也叫他⁠们听⁠见，哑⁠巴也叫他⁠们说⁠话。"
  }
}
