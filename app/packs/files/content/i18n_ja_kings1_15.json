{
  "kings1.15.p1.b1": {
    "text": "ネバテの子ヤラベアム王の第十八年にアビヤムがユダの王となり、エルサレムで三年世を治めた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 15:1-2"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.15.p1.b2": {
    "text": "…その心は父ダビデの心のようにその神、主に対して全く真実ではなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 15:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.15.p1.b3": {
    "text": "それにもかかわらず、その神、主はダビデのために、エルサレムにおいて彼に一つのともしびを与え…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 15:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.15.p1.b4": {
    "text": "アビヤムはその先祖と共に眠って、ダビデの町に葬られ、その子アサが代って王となった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 15:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.15.p2.b1": {
    "text": "イスラエルの王ヤラベアムの第二十年にアサはユダの王となり、エルサレムで四十一年世を治めた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 15:9-10"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.15.p2.b2": {
    "text": "アサはその父ダビデがしたように主の目にかなう事をし、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 15:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.15.p2.b3": {
    "text": "…先祖たちの造ったもろもろの偶像を除いた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 15:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.15.p3.b1": {
    "text": "彼はまたその母マアカが、アシラのために憎むべき像を造らせたので、彼女を太后の位から退けた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 15:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.15.p3.b2": {
    "text": "そしてアサはその憎むべき像を切り倒してキデロンの谷で焼き捨てた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 15:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.15.p3.b3": {
    "text": "ただし高き所は除かなかった。けれどもアサの心は一生の間、主に対して全く真実であった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 15:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.15.p4.b1": {
    "text": "イスラエルの王バアシャはユダに攻め上り、ユダの王アサの所に、だれをも出入りさせないためにラマを築いた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 15:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.15.p4.b2": {
    "text": "「…わたしはあなたに金銀の贈り物をさしあげます。行って、あなたとイスラエルの王バアシャとの同盟を破棄し、彼をわたしの所から撤退させてください」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 15:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.15.p4.b3": {
    "text": "ベネハダデはアサ王の言うことを聞き、自分の軍勢の長たちをつかわしてイスラエルの町々を攻め…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 15:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.15.p4.b4": {
    "text": "そこでアサ王はユダ全国に布告を発した。ひとりも免れる者はなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 15:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.15.p5.b1": {
    "text": "…彼は老年になって足を病んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 15:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.15.p5.b2": {
    "text": "アサはその先祖と共に眠って、父ダビデの町に先祖と共に葬られ、その子ヨシャパテが代って王となった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 15:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.15.p5.b3": {
    "text": "ユダの王アサの第二年にヤラベアムの子ナダブがイスラエルの王となって、二年イスラエルを治めた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 15:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.15.p5.b4": {
    "text": "彼は主の目の前に悪を行い、その父の道に歩み…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 15:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.15.p6.b1": {
    "text": "イッサカルの家のアヒヤの子バアシャは彼に対してむほんを企て、ペリシテびとに属するギベトンで彼を撃った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 15:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.15.p6.b2": {
    "text": "こうしてユダの王アサの第三年にバアシャは彼を殺し、彼に代って王となった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 15:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.15.p6.b3": {
    "text": "彼は王となるとすぐヤラベアムの全家を撃ち、…主がそのしもべシロびとアヒヤによって言われた言葉のとおりであって…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 15:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings1.15.p6.b4": {
    "text": "ユダの王アサの第三年にアヒヤの子バアシャはテルザでイスラエルの全地の王となって、二十四年世を治めた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Kings 15:33"
    },
    "adapted": false,
    "status": "approved"
  }
}
