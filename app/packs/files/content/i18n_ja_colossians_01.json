{
  "colossians.1.p1.b1": {
    "text": "神の御旨によるキリスト・イエスの使徒パウロと兄弟テモテから、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Colossians 1:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "colossians.1.p2.b1": {
    "text": "コロサイにいる、キリストにある聖徒たち、忠実な兄弟たちへ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Colossians 1:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "colossians.1.p2.b2": {
    "text": "わたしたちの父なる神から、恵みと平安とが、あなたがたにあるように。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Colossians 1:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "colossians.1.p3.b1": {
    "text": "… わたしたちの主イエス・キリストの父なる神に感謝している。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Colossians 1:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "colossians.1.p3.b2": {
    "text": "わたしたちは、いつもあなたがたのために祈り、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Colossians 1:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "colossians.1.p3.b3": {
    "text": "これは、キリスト・イエスに対するあなたがたの信仰と、すべての聖徒に対していだいているあなたがたの愛とを、耳にしたからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Colossians 1:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "colossians.1.p3.b4": {
    "text": "… この福音は、世界中いたる所でそうであるように、あなたがたのところでも、… 実を結んで成長しているのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Colossians 1:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "colossians.1.p4.b1": {
    "text": "あなたがたはこの福音を、わたしたちと同じ僕である、愛するエペフラスから学んだのであった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Colossians 1:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "colossians.1.p4.b2": {
    "text": "彼はあなたがたのためのキリストの忠実な奉仕者であって、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Colossians 1:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "colossians.1.p4.b3": {
    "text": "あなたがたが御霊によっていだいている愛を、わたしたちに知らせてくれたのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Colossians 1:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "colossians.1.p5.b1": {
    "text": "そういうわけで、これらの事を耳にして以来、わたしたちも絶えずあなたがたのために祈り求めている …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Colossians 1:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "colossians.1.p5.b2": {
    "text": "主のみこころにかなった生活をして真に主を喜ばせ、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Colossians 1:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "colossians.1.p5.b3": {
    "text": "神は、わたしたちをやみの力から救い出して、その愛する御子の支配下に移して下さった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Colossians 1:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "colossians.1.p5.b4": {
    "text": "わたしたちは、この御子によってあがない、すなわち、罪のゆるしを受けているのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Colossians 1:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "colossians.1.p6.b1": {
    "text": "御子は、見えない神のかたちであって、すべての造られたものに先だって生れたかたである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Colossians 1:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "colossians.1.p6.b2": {
    "text": "万物は、… みな御子にあって造られたからである。これらいっさいのものは、御子によって造られ、御子のために造られたのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Colossians 1:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "colossians.1.p6.b3": {
    "text": "彼は万物よりも先にあり、万物は彼にあって成り立っている。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Colossians 1:17"
    },
    "adapted": false,
    "status": "approved"
  }
}
