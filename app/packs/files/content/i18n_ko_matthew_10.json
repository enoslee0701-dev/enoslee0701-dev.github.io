{
  "matthew.10.p1.b1": {
    "text": "예수께서 그 열 두 제자를 부르사",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p1.b2": {
    "text": "더러운 귀신을 쫓아내며 모든 병과 모든 약한 것을 고치는 권능을 주시니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p2.b1": {
    "text": "열 두 사도의 이름은 이러하니 베드로라 하는 시몬을 비롯하여 그의 형제 안드레와",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p2.b2": {
    "text": "세베대의 아들 야고보와 그의 형제 요한",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p2.b3": {
    "text": "빌립과 바돌로매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p2.b4": {
    "text": "도마와 세리 마태",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p2.b5": {
    "text": "알패오의 아들 야고보와 다대오",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p2.b6": {
    "text": "가나안인 시몬과 및 가룟 유다 곧 예수를 판 자라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p3.b1": {
    "text": "이방인의 길로도 가지 말고 사마리아인의 고을에도 들어가지 말고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p3.b2": {
    "text": "차라리 이스라엘 집의 잃어버린 양에게로 가라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p3.b3": {
    "text": "가면서 전파하여 말하되 천국이 가까왔다 하고 병든 자를 고치며 죽은 자를 살리며 문둥이를 깨끗하게 하며 귀신을 쫓아내되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:7-8"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p3.b4": {
    "text": "너희가 거저 받았으니 거저 주어라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p4.b1": {
    "text": "너희 전대에 금이나 은이나 동이나 가지지 말고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p4.b2": {
    "text": "여행을 위하여 주머니나 두 벌 옷이나 신이나 지팡이를 가지지 말라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p4.b3": {
    "text": "이는 일군이 저 먹을 것 받는 것이 마땅함이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p5.b1": {
    "text": "그 중에 합당한 자를 찾아내어 너희 떠나기까지 거기서 머물라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p5.b2": {
    "text": "그 집이 이에 합당하면 너희 빈 평안이 거기 임할 것이요",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p5.b3": {
    "text": "누구든지 너희를 영접도 아니하고 너희 말을 듣지도 아니하거든 … 너희 발의 먼지를 떨어 버리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p5.b4": {
    "text": "심판 날에 소돔과 고모라 땅이 그 성보다 견디기 쉬우리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p6.b1": {
    "text": "보라 내가 너희를 보냄이 양을 이리 가운데 보냄과 같도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p6.b2": {
    "text": "그러므로 너희는 뱀같이 지혜롭고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p6.b3": {
    "text": "비둘기같이 순결하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p7.b1": {
    "text": "사람들을 삼가라 저희가 너희를 공회에 넘겨 주겠고 저희 회당에서 채찍질 하리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p7.b2": {
    "text": "그 때에 무슨 말할 것을 주시리니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p7.b3": {
    "text": "말하는 이는 너희가 아니라 너희 속에서 말씀하시는 자 곧 너희 아버지의 성령이시니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p8.b1": {
    "text": "장차 형제가 형제를, 아비가 자식을 죽는 데 내어 주며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p8.b2": {
    "text": "또 너희가 내 이름을 인하여 모든 사람에게 미움을 받을 것이나",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p8.b3": {
    "text": "나중까지 견디는 자는 구원을 얻으리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p8.b4": {
    "text": "이 동네에서 너희를 핍박하거든 저 동네로 피하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p9.b1": {
    "text": "제자가 그 선생보다, 또는 종이 그 상전보다 높지 못하나니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p9.b2": {
    "text": "집 주인을 바알세불이라 하였거든 하물며 그 집 사람들이랴",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p9.b3": {
    "text": "그런즉 저희를 두려워하지 말라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p9.b4": {
    "text": "내가 너희에게 어두운데서 이르는 것을 광명한데서 말하며 너희가 귓속으로 듣는 것을 집 위에서 전파하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p10.b1": {
    "text": "몸은 죽여도 영혼은 능히 죽이지 못하는 자들을 두려워하지 말고 오직 몸과 영혼을 능히 지옥에 멸하시는 자를 두려워하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p10.b2": {
    "text": "참새 두 마리가 한 앗사리온에 팔리는 것이 아니냐 그러나 너희 아버지께서 허락지 아니하시면 그 하나라도 땅에 떨어지지 아니하리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p10.b3": {
    "text": "너희에게는 머리털까지 다 세신바 되었나니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p10.b4": {
    "text": "두려워하지 말라 너희는 많은 참새보다 귀하니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p11.b1": {
    "text": "누구든지 사람 앞에서 나를 시인하면 나도 하늘에 계신 내 아버지 앞에서 저를 시인할 것이요",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p11.b2": {
    "text": "화평이 아니요 검을 주러 왔노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p11.b3": {
    "text": "내가 온 것은 사람이 그 아비와, 딸이 어미와, 며느리가 시어미와 불화하게 하려 함이니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p11.b4": {
    "text": "사람의 원수가 자기 집안 식구리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:36"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p12.b1": {
    "text": "아비나 어미를 나보다 더 사랑하는 자는 내게 합당치 아니하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:37"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p12.b2": {
    "text": "또 자기 십자가를 지고 나를 좇지 않는 자도 내게 합당치 아니하니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p12.b3": {
    "text": "자기 목숨을 얻는 자는 잃을 것이요 나를 위하여 자기 목숨을 잃는 자는 얻으리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p13.b1": {
    "text": "너희를 영접하는 자는 나를 영접하는 것이요",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p13.b2": {
    "text": "나를 영접하는 자는 나 보내신 이를 영접하는 것이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p13.b3": {
    "text": "선지자의 이름으로 선지자를 영접하는 자는 선지자의 상을 받을 것이요",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p13.b4": {
    "text": "의인의 이름으로 의인을 영접하는 자는 의인의 상을 받을 것이요",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p14.b1": {
    "text": "또 누구든지 제자의 이름으로 이 소자 중 하나에게 냉수 한 그릇이라도 주는 자는",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:42"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.10.p14.b2": {
    "text": "내가 진실로 너희에게 이르노니 그 사람이 결단코 상을 잃지 아니하리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 10:42"
    },
    "adapted": false,
    "status": "approved"
  }
}
