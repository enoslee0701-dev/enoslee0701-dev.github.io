{
  "acts.8.p1.b1": {
    "text": "从这日起，耶路撒冷的教会大遭逼迫，除了使徒以外，门徒都分散在犹太和撒马利亚各处。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "从这日起，耶⁠路撒⁠冷的教⁠会大遭逼⁠迫，除⁠了使⁠徒以⁠外，门⁠徒都分⁠散在犹⁠太和撒马⁠利⁠亚各⁠处。"
  },
  "acts.8.p1.b2": {
    "text": "有虔诚的人把司提反埋葬了，为他捶胸大哭。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有虔⁠诚的人把司提反埋⁠葬了，为他捶⁠胸大⁠哭。"
  },
  "acts.8.p1.b3": {
    "text": "扫罗却残害教会，进各人的家，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:3"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "扫罗却残⁠害教⁠会，进各⁠人的家，"
  },
  "acts.8.p1.b4": {
    "text": "……拉着男女下在监里。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:3"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "……拉着男⁠女下在监里。"
  },
  "acts.8.p2.b1": {
    "text": "那些分散的人往各处去传道。腓利下撒马利亚城去，宣讲基督。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:4-5"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "那⁠些分⁠散的人往各⁠处去传⁠道。腓利下撒马⁠利⁠亚城去，宣⁠讲基⁠督。"
  },
  "acts.8.p2.b2": {
    "text": "众人听见了，又看见腓利所行的神迹，就同心合意地听从他的话。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:6"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "众⁠人听⁠见⁠了，又看⁠见腓利所行的神⁠迹，就同⁠心合⁠意地听⁠从他的⁠话。"
  },
  "acts.8.p2.b3": {
    "text": "……还有许多瘫痪的、瘸腿的，都得了医治。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "……还⁠有许⁠多瘫⁠痪的、瘸⁠腿的，都得⁠了医⁠治。"
  },
  "acts.8.p2.b4": {
    "text": "在那城里，就大有欢喜。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "在那城里，就大有欢⁠喜。"
  },
  "acts.8.p3.b1": {
    "text": "有一个人，名叫西门，向来在那城里行邪术，妄自尊大，使撒马利亚的百姓惊奇；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:9"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有⁠一个⁠人，名⁠叫西⁠门，向⁠来在那城里行邪⁠术，妄⁠自尊⁠大，使撒马⁠利⁠亚的百⁠姓惊⁠奇；"
  },
  "acts.8.p3.b2": {
    "text": "这人就是那称为　神的大能者。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:10"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "这人就⁠是那称⁠为　神的大能者。"
  },
  "acts.8.p3.b3": {
    "text": "及至他们信了腓利所传　神国的福音和耶稣基督的名，连男带女就受了洗。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:12"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "及⁠至他⁠们信了腓利所传　神⁠国的福⁠音和耶⁠稣基⁠督的名，连男带女就受了洗。"
  },
  "acts.8.p3.b4": {
    "text": "西门自己也信了；既受了洗，就常与腓利在一处，看见他所行的神迹和大异能，就甚惊奇。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "西⁠门自⁠己也信了；既受了洗，就常与腓利在一处，看⁠见他⁠所行的神⁠迹和大异⁠能，就甚惊⁠奇。"
  },
  "acts.8.p4.b1": {
    "text": "使徒在耶路撒冷听见撒马利亚人领受了　神的道，就打发彼得、约翰往他们那里去。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:14"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "使⁠徒在耶⁠路撒⁠冷听⁠见撒马⁠利⁠亚人领⁠受了　神的道，就打⁠发彼⁠得、约⁠翰往他⁠们那⁠里去。"
  },
  "acts.8.p4.b2": {
    "text": "两个人到了，就为他们祷告，要叫他们受圣灵。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:15"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "两个⁠人到⁠了，就为他⁠们祷⁠告，要叫他⁠们受圣⁠灵。"
  },
  "acts.8.p4.b3": {
    "text": "于是使徒按手在他们头上，他们就受了圣灵。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:17"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "于⁠是使⁠徒按手在他⁠们头上，他⁠们就受了圣⁠灵。"
  },
  "acts.8.p5.b1": {
    "text": "西门看见使徒按手，便有圣灵赐下，就拿钱给使徒，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:18"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "西⁠门看⁠见使⁠徒按手，便⁠有圣⁠灵赐下，就⁠拿钱给使⁠徒，"
  },
  "acts.8.p5.b2": {
    "text": "把这权柄也给我，叫我手按着谁，谁就可以受圣灵。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:19"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "把这权⁠柄也给我，叫我手按着谁，谁就可⁠以受圣⁠灵。"
  },
  "acts.8.p5.b3": {
    "text": "你的银子和你一同灭亡吧！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:20"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠的银⁠子和你一⁠同灭⁠亡吧！"
  },
  "acts.8.p5.b4": {
    "text": "因你想　神的恩赐是可以用钱买的。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:20"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "因你⁠想　神的恩⁠赐是可⁠以用钱买的。"
  },
  "acts.8.p6.b1": {
    "text": "你当懊悔你这罪恶，祈求主，或者你心里的意念可得赦免。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:22"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你当懊⁠悔你这罪⁠恶，祈⁠求主，或⁠者你心⁠里的意⁠念可⁠得赦⁠免。"
  },
  "acts.8.p6.b2": {
    "text": "愿你们为我求主，叫你们所说的，没有一样临到我身上。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:24"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "愿你⁠们为⁠我求主，叫你⁠们所说⁠的，没⁠有一⁠样临⁠到我身⁠上。"
  },
  "acts.8.p6.b3": {
    "text": "使徒既证明主道，而且传讲，就回耶路撒冷去，一路在撒马利亚好些村庄传扬福音。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:25"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "使⁠徒既证⁠明主道，而⁠且传讲，就回耶⁠路撒⁠冷去，一⁠路在撒马⁠利⁠亚好⁠些村⁠庄传⁠扬福⁠音。"
  },
  "acts.8.p7.b1": {
    "text": "起来！向南走，往那从耶路撒冷下迦萨的路上去。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:26"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "起⁠来！向⁠南⁠走，往那从耶⁠路撒⁠冷下迦萨的路⁠上去。"
  },
  "acts.8.p7.b2": {
    "text": "那路是旷野。腓利就起身去了，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:26-27"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "那路是旷⁠野。腓利就起⁠身去⁠了，"
  },
  "acts.8.p7.b3": {
    "text": "不料，有一个衣索匹亚人，是个有大权的太监，……他上耶路撒冷礼拜去了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:27"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "不料，有一⁠个衣索匹亚人，是个有大⁠权的太⁠监，……他上耶⁠路撒⁠冷礼⁠拜去⁠了。"
  },
  "acts.8.p7.b4": {
    "text": "现在回来，在车上坐着，念先知以赛亚的书。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:28"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "现⁠在回⁠来，在车上坐着，念先⁠知以⁠赛⁠亚的书。"
  },
  "acts.8.p8.b1": {
    "text": "你去！贴近那车走。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:29"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你去！贴⁠近那车走。"
  },
  "acts.8.p8.b2": {
    "text": "你所念的，你明白吗？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:30"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你所念的，你明⁠白吗？"
  },
  "acts.8.p8.b3": {
    "text": "没有人指教我，怎能明白呢？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:31"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "没⁠有人指⁠教我，怎⁠能明⁠白呢？"
  },
  "acts.8.p8.b4": {
    "text": "于是请腓利上车，与他同坐。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:31"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "于⁠是请腓利上⁠车，与他同⁠坐。"
  },
  "acts.8.p9.b1": {
    "text": "他所念的那段经，说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:32"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠所念的那段经，说："
  },
  "acts.8.p9.b2": {
    "text": "他像羊被牵到宰杀之地，又像羊羔在剪毛的人手下无声；他也是这样不开口。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:32"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他像羊被牵⁠到宰⁠杀之⁠地，又像羊⁠羔在剪⁠毛的人手⁠下无⁠声；他也⁠是这⁠样不开⁠口。"
  },
  "acts.8.p9.b3": {
    "text": "他卑微的时候，人不按公义审判他；……因为他的生命从地上夺去。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:33"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他卑⁠微的时⁠候，人不按公⁠义审⁠判他；……因⁠为他⁠的生⁠命从地⁠上夺去。"
  },
  "acts.8.p10.b1": {
    "text": "请问，先知说这话是指着谁？是指着自己呢？是指着别人呢？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:34"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "请⁠问，先⁠知说这话是指着谁？是指着自⁠己呢？是指着别⁠人呢？"
  },
  "acts.8.p10.b2": {
    "text": "腓利就开口从这经上起，对他传讲耶稣。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:35"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "腓利就开⁠口从这经上起，对他传讲耶⁠稣。"
  },
  "acts.8.p11.b1": {
    "text": "看哪，这里有水，我受洗有什么妨碍呢？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:36"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "看哪，这⁠里有水，我受⁠洗有什⁠么妨⁠碍呢？"
  },
  "acts.8.p11.b2": {
    "text": "于是吩咐车站住，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:38"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "于⁠是吩⁠咐车⁠站住，"
  },
  "acts.8.p11.b3": {
    "text": "腓利和太监二人同下水里去，腓利就给他施洗。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:38"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "腓利⁠和太⁠监二⁠人同下水⁠里去，腓利就给他施⁠洗。"
  },
  "acts.8.p12.b1": {
    "text": "从水里上来，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:39"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "从水⁠里上⁠来，"
  },
  "acts.8.p12.b2": {
    "text": "主的灵把腓利提了去，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:39"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "主的灵把腓利提⁠了去，"
  },
  "acts.8.p12.b3": {
    "text": "太监也不再见他了，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:39"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "太⁠监也⁠不再⁠见他了，"
  },
  "acts.8.p12.b4": {
    "text": "就欢欢喜喜地走路。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:39"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "就欢欢⁠喜喜地走⁠路。"
  },
  "acts.8.p13.b1": {
    "text": "后来有人在亚锁都遇见腓利；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:40"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "后⁠来有⁠人在亚锁都遇⁠见腓利；"
  },
  "acts.8.p13.b2": {
    "text": "他走遍那地方，在各城宣传福音，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:40"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他走⁠遍那地⁠方，在各城宣⁠传福⁠音，"
  },
  "acts.8.p13.b3": {
    "text": "直到凯撒利亚。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Acts 8:40"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "直⁠到凯撒利⁠亚。"
  }
}
