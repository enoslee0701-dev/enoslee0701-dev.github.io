{
  "john.10.p1.b1": {
    "text": "내가 진실로 진실로 너희에게 이르노니 양의 우리에 문으로 들어가지 아니하고 다른데로 넘어가는 자는 절도며 강도요",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p1.b2": {
    "text": "문으로 들어가는 이가 양의 목자라 문지기는 그를 위하여 문을 열고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:2-3"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p1.b3": {
    "text": "양은 그의 음성을 듣나니 그가 자기 양의 이름을 각각 불러 인도하여 내느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p2.b1": {
    "text": "자기 양을 다 내어 놓은 후에 앞서 가면 양들이 그의 음성을 아는고로 따라 오되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p2.b2": {
    "text": "타인의 음성은 알지 못하는고로 타인을 따르지 아니하고 도리어 도망하느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p2.b3": {
    "text": "예수께서 이 비유로 저희에게 말씀하셨으나 저희는 그 하신 말씀이 무엇인지 알지 못하니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p3.b1": {
    "text": "내가 진실로 진실로 너희에게 말하노니 나는 양의 문이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p3.b2": {
    "text": "내가 문이니 누구든지 나로 말미암아 들어가면 구원을 얻고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p3.b3": {
    "text": "또는 들어가며 나오며 꼴을 얻으리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p4.b1": {
    "text": "도적이 오는 것은 도적질하고 죽이고 멸망시키려는 것뿐이요",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p4.b2": {
    "text": "내가 온 것은 양으로 생명을 얻게 하고 더 풍성히 얻게 하려는 것이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p4.b3": {
    "text": "나는 선한 목자라 선한 목자는 양들을 위하여 목숨을 버리거니와",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p5.b1": {
    "text": "삯군은 목자도 아니요 양도 제 양이 아니라 이리가 오는 것을 보면 양을 버리고 달아나나니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p5.b2": {
    "text": "이리가 양을 늑탈하고 또 헤치느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p5.b3": {
    "text": "달아나는 것은 저가 삯군인 까닭에 양을 돌아보지 아니함이나",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p6.b1": {
    "text": "나는 선한 목자라 내가 내 양을 알고 양도 나를 아는 것이",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p6.b2": {
    "text": "아버지께서 나를 아시고 내가 아버지를 아는 것 같으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p6.b3": {
    "text": "나는 양을 위하여 목숨을 버리노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p7.b1": {
    "text": "또 이 우리에 들지 아니한 다른 양들이 내게 있어 내가 인도하여야 할터이니 저희도 내 음성을 듣고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p7.b2": {
    "text": "한 무리가 되어 한 목자에게 있으리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p7.b3": {
    "text": "아버지께서 나를 사랑하시는 것은 내가 다시 목숨을 얻기 위하여 목숨을 버림이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p7.b4": {
    "text": "이를 내게서 빼앗는 자가 있는 것이 아니라 내가 스스로 버리노라 나는 버릴 권세도 있고 다시 얻을 권세도 있으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p8.b1": {
    "text": "이 말씀을 인하여 유대인 중에 다시 분쟁이 일어나니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p8.b2": {
    "text": "저가 귀신 들려 미쳤거늘 어찌하여 그 말을 듣느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p8.b3": {
    "text": "이 말은 귀신 들린 자의 말이 아니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p8.b4": {
    "text": "귀신이 소경의 눈을 뜨게 할 수 있느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p9.b1": {
    "text": "예루살렘에 수전절이 이르니 때는 겨울이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p9.b2": {
    "text": "예수께서 성전 안 솔로몬 행각에서 다니시니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p9.b3": {
    "text": "당신이 언제까지나 우리 마음을 의혹케 하려나이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p9.b4": {
    "text": "그리스도여든 밝히 말하시오",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p10.b1": {
    "text": "내가 너희에게 말하였으되 믿지 아니하는도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p10.b2": {
    "text": "내 양은 내 음성을 들으며 나는 저희를 알며 저희는 나를 따르느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p10.b3": {
    "text": "…저희를 내 손에서 빼앗을 자가 없느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p10.b4": {
    "text": "나와 아버지는 하나이니라 하신대",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p11.b1": {
    "text": "유대인들이 다시 돌을 들어 치려 하거늘",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p11.b2": {
    "text": "내가 아버지께로 말미암아 여러가지 선한 일을 너희에게 보였거늘 그 중에 어떤 일로 나를 돌로 치려하느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p11.b3": {
    "text": "선한 일을 인하여 우리가 너를 돌로 치려는 것이 아니라 참람함을 인함이니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p11.b4": {
    "text": "네가 사람이 되어 자칭 하나님이라 함이로라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p12.b1": {
    "text": "너희 율법에 기록한바 내가 너희를 신이라 하였노라 하지 아니하였느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p12.b2": {
    "text": "성경은 폐하지 못하나니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p12.b3": {
    "text": "…너희가 아버지께서 내 안에 계시고 내가 아버지 안에 있음을 깨달아 알리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p12.b4": {
    "text": "저희가 다시 예수를 잡고자 하였으나 그 손에서 벗어나 나가시니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p13.b1": {
    "text": "다시 요단강 저편 요한이 처음으로 세례 주던 곳에 가사 거기 거하시니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p13.b2": {
    "text": "요한은 아무 표적도 행치 아니하였으나",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p13.b3": {
    "text": "요한이 이 사람을 가리켜 말한 것은 다 참이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.10.p13.b4": {
    "text": "그리하여 거기서 많은 사람이 예수를 믿으니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "John 10:42"
    },
    "adapted": false,
    "status": "approved"
  }
}
