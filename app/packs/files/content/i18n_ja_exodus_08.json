{
  "exodus.8.p1.b1": {
    "text": "あなたはパロのところに行って言いなさい、『主はこう仰せられます、わたしの民を去らせて、わたしに仕えさせなさい』",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 8:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.8.p1.b2": {
    "text": "しかし、去らせることを拒むならば、見よ、わたしは、かえるをもって、あなたの領土を、ことごとく撃つであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 8:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.8.p1.b3": {
    "text": "かえるが … のぼって、あなたの家、あなたの寝室にはいり、寝台にのぼり … あなたのかまどや、こね鉢にはいり …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 8:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.8.p2.b4": {
    "text": "あなたはアロンに言いなさい、『つえを持って、手を川の上、流れの上 … 池の上にさし伸べ、かえるをエジプトの地にのぼらせなさい』",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 8:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.8.p2.b5": {
    "text": "アロンが手をエジプトの水の上にさし伸べたので、かえるはのぼってエジプトの地をおおった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 8:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.8.p2.b6": {
    "text": "魔術師らも秘術をもって同じように行い、かえるをエジプトの地にのぼらせた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 8:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.8.p3.b7": {
    "text": "かえるをわたしと、わたしの民から取り去るように主に願ってください。そのときわたしはこの民を去らせて、主に犠牲をささげさせるでしょう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 8:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.8.p3.b8": {
    "text": "明日",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 8:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.8.p3.b9": {
    "text": "仰せのとおりになって、わたしたちの神、主に並ぶもののないことを、あなたが知られますように。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 8:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.8.p3.b10": {
    "text": "これをひと山ひと山に積んだので、地は臭くなった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 8:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.8.p3.b11": {
    "text": "ところがパロは息つくひまのできたのを見て、主が言われたように、その心をかたくなにして彼らの言うことを聞かなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 8:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.8.p4.b12": {
    "text": "あなたのつえをさし伸べて地のちりを打ち、それをエジプトの全国にわたって、ぶよとならせなさい",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 8:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.8.p4.b13": {
    "text": "地のちりはみなエジプトの全国にわたって、ぶよとなった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 8:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.8.p4.b14": {
    "text": "これは神の指です",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 8:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.8.p4.b15": {
    "text": "しかし主の言われたように、パロの心はかたくなになって、彼らのいうことを聞かなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 8:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.8.p5.b16": {
    "text": "あなたは朝早く起きてパロの前に立ちなさい。ちょうど彼は水のところに出ているから …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 8:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.8.p5.b17": {
    "text": "主はこう仰せられる、わたしの民を去らせて、わたしに仕えさせなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 8:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.8.p5.b18": {
    "text": "わたしはわたしの民とあなたの民の間に区別をおく。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 8:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.8.p5.b19": {
    "text": "おびただしいあぶが、パロの家と … エジプトの全国にはいってきて、地はあぶの群れのために害をうけた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 8:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.8.p6.b20": {
    "text": "あなたがたは行ってこの国の内で、あなたがたの神に犠牲をささげなさい",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 8:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.8.p6.b21": {
    "text": "そうすることはできません。… もし、エジプトびとの目の前で、彼らの忌むものを犠牲にささげるならば、彼らはわたしたちを石で打たないでしょうか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 8:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.8.p6.b22": {
    "text": "わたしたちは三日の道のりほど、荒野にはいって …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 8:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.8.p6.b23": {
    "text": "わたしはあなたがたを去らせ … ただあまり遠くへ行ってはならない。わたしのために祈願しなさい",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 8:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.8.p7.b24": {
    "text": "わたしはあなたのもとから出て行って主に祈願しましょう。… ただパロはまた欺いて、民が主に犠牲をささげに行くのをとめないようにしてください",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 8:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.8.p7.b25": {
    "text": "主はモーセの言葉のようにされた。すなわち、あぶの群れをパロと、その家来と、その民から取り去られたので、一つも残らなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 8:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.8.p7.b26": {
    "text": "しかしパロはこんどもまた、その心をかたくなにして民を去らせなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 8:32"
    },
    "adapted": false,
    "status": "approved"
  }
}
