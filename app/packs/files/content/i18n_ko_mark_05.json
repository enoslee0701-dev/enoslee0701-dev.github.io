{
  "mark.5.p1.b1": {
    "text": "예수께서 바다 건너편 거라사인의 지방에 이르러",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p1.b2": {
    "text": "배에서 나오시매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p1.b3": {
    "text": "곧 더러운 귀신 들린 사람이 무덤 사이에서 나와 예수를 만나다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p2.b1": {
    "text": "그 사람은 무덤 사이에 거처하는데",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p2.b2": {
    "text": "이제는 아무나 쇠사슬로도 맬 수 없게 되었으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p2.b3": {
    "text": "이는 여러번 고랑과 쇠사슬에 매였어도",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p2.b4": {
    "text": "쇠사슬을 끊고 고랑을 깨뜨렸음이러라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p2.b5": {
    "text": "그리하여 아무도 저를 제어할 힘이 없는지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p2.b6": {
    "text": "밤낮 무덤 사이에서나 산에서나 늘 소리지르며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p2.b7": {
    "text": "돌로 제 몸을 상하고 있었더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p3.b1": {
    "text": "그가 멀리서 예수를 보고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p3.b2": {
    "text": "달려와 절하며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p3.b3": {
    "text": "큰 소리로 부르짖어 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p3.b4": {
    "text": "지극히 높으신 하나님의 아들 예수여 나와 당신과 무슨 상관이 있나이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p3.b5": {
    "text": "원컨대 하나님 앞에 맹세하고 나를 괴롭게 마옵소서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p3.b6": {
    "text": "이는 예수께서 이미 저에게 이르시기를",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p3.b7": {
    "text": "더러운 귀신아 그 사람에게서 나오라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p4.b1": {
    "text": "네 이름이 무엇이냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p4.b2": {
    "text": "내 이름은 군대니 우리가 많음이니이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p4.b3": {
    "text": "자기를 이 지방에서 내어 보내지 마시기를 간절히 구하더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p5.b1": {
    "text": "우리를 돼지에게로 보내어 들어가게 하소서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p5.b2": {
    "text": "허락하신대",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p5.b3": {
    "text": "바다를 향하여 비탈로 내리달아 바다에서 몰사하거늘",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p5.b4": {
    "text": "거의 이천 마리 되는 떼가",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p6.b1": {
    "text": "사람들이 그 어떻게 된것을 보러 와서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p6.b2": {
    "text": "예수께 이르러 그 귀신 들렸던 자 곧 군대 지폈던 자가",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p6.b3": {
    "text": "옷을 입고 정신이 온전하여 앉은 것을 보고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p6.b4": {
    "text": "두려워하더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p7.b1": {
    "text": "이에 귀신 들렸던 자의 당한 것과",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p7.b2": {
    "text": "돼지의 일을 본 자들이 저희에게 고하매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p7.b3": {
    "text": "저희가 예수께 그 지경에서 떠나시기를 간구하더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p8.b1": {
    "text": "귀신 들렸던 사람이 함께 있기를 간구하였으나",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p8.b2": {
    "text": "집으로 돌아가",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p8.b3": {
    "text": "주께서 네게 어떻게 큰 일을 행하사 너를 불쌍히 여기신 것을 네 친속에게 고하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p8.b4": {
    "text": "그가 가서 예수께서 자기에게 어떻게 큰 일 행하신 것을 데가볼리에 전파하니 모든 사람이 기이히 여기더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p9.b1": {
    "text": "예수께서 배를 타시고 다시 저편으로 건너 가시매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p9.b2": {
    "text": "회당장 중 하나인 야이로라 하는 이가 와서 예수를 보고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p9.b3": {
    "text": "내 어린 딸이 죽게 되었사오니 오셔서 그 위에 손을 얹으사 그로 구원을 얻어 살게 하소서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p9.b4": {
    "text": "이에 그와 함께 가실새",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p10.b1": {
    "text": "열 두 해를 혈루증으로 앓는 한 여자가 있어",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p10.b2": {
    "text": "많은 의원에게 많은 괴로움을 받았고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p10.b3": {
    "text": "있던 것도 다 허비하였으되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p10.b4": {
    "text": "아무 효험이 없고 도리어 더 중하여졌던 차에",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p11.b1": {
    "text": "예수의 소문을 듣고 무리 가운데 섞여 뒤로 와서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p11.b2": {
    "text": "내가 그의 옷에만 손을 대어도 구원을 얻으리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p11.b3": {
    "text": "이에 그의 혈루 근원이 곧 마르매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p11.b4": {
    "text": "병이 나은 줄을 몸에 깨달으니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p12.b1": {
    "text": "예수께서 그 능력이 자기에게서 나간 줄을 곧 스스로 아시고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p12.b2": {
    "text": "누가 내 옷에 손을 대었느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p12.b3": {
    "text": "무리가 에워싸 미는 것을 보시며 누가 내게 손을 대었느냐 물으시나이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p12.b4": {
    "text": "예수께서 이 일 행한 여자를 보려고 둘러 보시니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p13.b1": {
    "text": "여자가 제게 이루어진 일을 알고 두려워하여 떨며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p13.b2": {
    "text": "모든 사실을 여짜온대",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p13.b3": {
    "text": "딸아 네 믿음이 너를 구원하였으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p13.b4": {
    "text": "평안히 가라 네 병에서 놓여 건강할지어다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p14.b1": {
    "text": "당신의 딸이 죽었나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p14.b2": {
    "text": "어찌하여 선생을 더 괴롭게 하나이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p14.b3": {
    "text": "두려워 말고 믿기만 하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:36"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p14.b4": {
    "text": "베드로와 야고보와 야고보의 형제 요한 외에 아무도 따라옴을 허치 아니하시고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:37"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p15.b1": {
    "text": "회당장의 집에 함께 가사",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p15.b2": {
    "text": "너희가 어찌하여 훤화하며 우느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p15.b3": {
    "text": "이 아이가 죽은 것이 아니라 잔다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p15.b4": {
    "text": "저희가 비웃더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p16.b1": {
    "text": "예수께서 저희를 다 내어 보내신 후에",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p16.b2": {
    "text": "달리다굼",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p16.b3": {
    "text": "번역하면 곧 소녀야 내가 네게 말하노니 일어나라 하심이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p17.b1": {
    "text": "소녀가 곧 일어나서 걸으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:42"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p17.b2": {
    "text": "사람들이 곧 크게 놀라고 놀라거늘",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:42"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p17.b3": {
    "text": "나이 열 두살이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:42"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p18.b1": {
    "text": "예수께서 이 일을 아무도 알지 못하게 하라고 저희를 많이 경계하시고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:43"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.5.p18.b2": {
    "text": "이에 소녀에게 먹을 것을 주라 하시니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 5:43"
    },
    "adapted": false,
    "status": "approved"
  }
}
