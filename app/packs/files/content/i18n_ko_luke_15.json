{
  "luke.15.p1.b1": {
    "text": "모든 세리와 죄인들이 말씀을 들으러 가까이 나아오니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p1.b2": {
    "text": "이 사람이 죄인을 영접하고 음식을 같이 먹는다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p1.b3": {
    "text": "예수께서 저희에게 이 비유로 이르시되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p2.b1": {
    "text": "너희 중에 어느 사람이 양 일백 마리가 있는데 그 중에 하나를 잃으면",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p2.b2": {
    "text": "아흔 아홉 마리를 들에 두고 그 잃은 것을 찾도록 찾아 다니지 아니하느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p2.b3": {
    "text": "또 찾은즉 즐거워 어깨에 메고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p3.b1": {
    "text": "나와 함께 즐기자 나의 잃은 양을 찾았노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p3.b2": {
    "text": "내가 너희에게 이르노니 이와 같이 죄인 하나가 회개하면 하늘에서는",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p3.b3": {
    "text": "회개할 것 없는 의인 아흔 아홉을 인하여 기뻐하는 것보다 더하리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p4.b1": {
    "text": "어느 여자가 열 드라크마가 있는데 하나를 잃으면",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p4.b2": {
    "text": "등불을 켜고 집을 쓸며 찾도록 부지런히 찾지 아니하겠느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p4.b3": {
    "text": "나와 함께 즐기자 잃은 드라크마를 찾았노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p4.b4": {
    "text": "내가 너희에게 이르노니 이와 같이 죄인 하나가 회개하면 하나님의 사자들 앞에 기쁨이 되느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p5.b1": {
    "text": "어떤 사람이 두 아들이 있는데",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p5.b2": {
    "text": "아버지여 재산 중에서 내게 돌아올 분깃을 내게 주소서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p5.b3": {
    "text": "그 후 며칠이 못되어 둘째 아들이 재산을 다 모아가지고 먼 나라에 가",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p5.b4": {
    "text": "거기서 허랑방탕하여 그 재산을 허비하더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p6.b1": {
    "text": "다 없이한 후",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p6.b2": {
    "text": "그 나라에 크게 흉년이 들어 저가 비로소 궁핍한지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p6.b3": {
    "text": "가서 그 나라 백성 중 하나에게 붙여 사니 그가 저를 들로 보내어 돼지를 치게 하였는데",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p6.b4": {
    "text": "저가 돼지 먹는 쥐엄 열매로 배를 채우고자 하되 주는 자가 없는지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p7.b1": {
    "text": "이에 스스로 돌이켜 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p7.b2": {
    "text": "내 아버지에게는 양식이 풍족한 품군이 얼마나 많은고 나는 여기서 주려 죽는구나",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p7.b3": {
    "text": "내가 일어나 아버지께 가서 이르기를 아버지여 내가 하늘과 아버지께 죄를 얻었사오니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p7.b4": {
    "text": "지금부터는 아버지의 아들이라 일컬음을 감당치 못하겠나이다 나를 품군의 하나로 보소서 하리라 하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p8.b1": {
    "text": "이에 일어나서 아버지께 돌아가니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p8.b2": {
    "text": "아직도 상거가 먼데 아버지가 저를 보고 측은히 여겨",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p8.b3": {
    "text": "달려가 목을 안고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p8.b4": {
    "text": "입을 맞추니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p9.b1": {
    "text": "아버지여 내가 하늘과 아버지께 죄를 얻었사오니 지금부터는 아버지의 아들이라 일컬음을 감당치 못하겠나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p9.b2": {
    "text": "아버지는 종들에게 이르되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p9.b3": {
    "text": "제일 좋은 옷을 내어다가 입히고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p9.b4": {
    "text": "손에 가락지를 끼우고 발에 신을 신기라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p10.b1": {
    "text": "그리고 살진 송아지를 끌어다가 잡으라 우리가 먹고 즐기자",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p10.b2": {
    "text": "이 내 아들은 죽었다가 다시 살아났으며 내가 잃었다가 다시 얻었노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p10.b3": {
    "text": "저희가 즐거워하더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p11.b1": {
    "text": "맏아들은 밭에 있다가 돌아와 집에 가까왔을 때에 풍류와 춤추는 소리를 듣고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p11.b2": {
    "text": "한 종을 불러 이 무슨 일인가 물은대",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p11.b3": {
    "text": "당신의 동생이 돌아왔으매 당신의 아버지가 그의 건강한 몸을 다시 맞아 들이게 됨을 인하여 살진 송아지를 잡았나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p12.b1": {
    "text": "저가 노하여 들어가기를 즐겨 아니하거늘 아버지가 나와서 권한대",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p12.b2": {
    "text": "내가 여러 해 아버지를 섬겨 명을 어김이 없거늘",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p12.b3": {
    "text": "내게는 염소 새끼라도 주어 나와 내 벗으로 즐기게 하신 일이 없더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p12.b4": {
    "text": "아버지의 살림을 창기와 함께 먹어버린 이 아들이 돌아오매 이를 위하여 살진 송아지를 잡으셨나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p13.b1": {
    "text": "얘 너는 항상 나와 함께 있으니 내 것이 다 네 것이로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.15.p13.b2": {
    "text": "이 네 동생은 죽었다가 살았으며 내가 잃었다가 얻었기로 우리가 즐거워하고 기뻐하는 것이 마땅하다 하니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Luke 15:32"
    },
    "adapted": false,
    "status": "approved"
  }
}
