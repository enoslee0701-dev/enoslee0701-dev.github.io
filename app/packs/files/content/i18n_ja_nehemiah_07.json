{
  "nehemiah.7.p1.b1": {
    "text": "城壁が築かれて、とびらを設け、さらに門衛、歌うたう者およびレビびとを任命したので",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 7:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.7.p1.b2": {
    "text": "わたしは、わたしの兄弟ハナニと、城のつかさハナニヤに命じて、エルサレムを治めさせた。彼は多くの者にまさって忠信な、神を恐れる者であったからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 7:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.7.p1.b3": {
    "text": "「日の暑くなるまではエルサレムのもろもろの門を開いてはならない。人々が立って守っている間に門を閉じさせ、貫の木を差せ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 7:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.7.p1.b4": {
    "text": "またエルサレムの住民の中から番兵を立てて、おのおのにその所を守らせ、またおのおのの家と向かい合う所を守らせよ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 7:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.7.p2.b1": {
    "text": "町は広くて大きかったが、その内の民は少なく、家々はまだ建てられていなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 7:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.7.p2.b2": {
    "text": "時に神はわたしの心に、尊い人々、つかさおよび民を集めて、家系によってその名簿をしらべようとの思いを起された。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 7:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.7.p2.b3": {
    "text": "わたしは最初に上って来た人々の系図を発見し、その中にこのようにしるしてあるのを見いだした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 7:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.7.p3.b1": {
    "text": "バビロンの王ネブカデネザルが捕え移した捕囚のうち、ゆるされてエルサレムおよびユダに上り、おのおの自分の町に帰ったこの州の人々は次のとおりである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 7:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.7.p3.b2": {
    "text": "彼らはゼルバベル、エシュア……と一緒に帰ってきた者たちである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 7:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.7.p3.b3": {
    "text": "パロシの子孫は二千百七十二人。……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 7:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.7.p3.b4": {
    "text": "ベツレヘムおよびネトパの人々は百八十八人。……エリコの人々は三百四十五人。……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 7:26-36"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.7.p4.b1": {
    "text": "祭司では、エシュアの家のエダヤの子孫が九百七十三人。……歌うたう者では、アサフの子孫が百四十八人。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 7:39-44"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.7.p4.b2": {
    "text": "宮に仕えるしもべたちとソロモンのしもべであった者たちの子孫とは合わせて三百九十二人。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 7:60"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.7.p4.b3": {
    "text": "これらの者はこの系図に載った者のうちに、自分の籍をたずねたが、なかったので、汚れた者として祭司の職から除かれた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 7:64"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.7.p4.b4": {
    "text": "総督は彼らに告げて、ウリムとトンミムを帯びる祭司の起るまでは、いと聖なる物を食べてはならぬと言った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 7:65"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.7.p5.b1": {
    "text": "会衆は合わせて四万二千三百六十人であった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 7:66"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.7.p5.b2": {
    "text": "その馬は七百三十六頭、その騾馬は二百四十五頭、そのらくだは四百三十五頭、そのろばは六千七百二十頭であった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 7:68-69"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.7.p5.b3": {
    "text": "氏族の長のうち工事のためにささげ物をした人々があった。総督は金一千ダリク、鉢五十、祭司の衣服五百三十かさねを倉に納めた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 7:70"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.7.p5.b4": {
    "text": "こうして祭司、レビびと、門衛、歌うたう者、民のうちのある人々、宮に仕えるしもべたち、およびイスラエルびとは皆その町々に住んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 7:73"
    },
    "adapted": false,
    "status": "approved"
  }
}
