{
  "revelation.5.p1.b1": {
    "text": "내가 보매 보좌에 앉으신 이의 오른손에 책이 있으니 안팎으로 썼고 일곱 인으로 봉하였더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Revelation 5:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p1.b2": {
    "text": "누가 책을 펴며 그 인을 떼기에 합당하냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Revelation 5:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p1.b3": {
    "text": "하늘 위에나 땅 위에나 땅 아래에 능히 책을 펴거나 보거나 할 이가 없더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Revelation 5:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p2.b4": {
    "text": "이 책을 펴거나 보거나 하기에 합당한 자가 보이지 않기로 내가 크게 울었더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Revelation 5:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p2.b5": {
    "text": "울지 말라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Revelation 5:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p2.b6": {
    "text": "유대 지파의 사자 다윗의 뿌리가 이기었으니 이 책과 그 일곱인을 떼시리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Revelation 5:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p3.b1": {
    "text": "내가 또 보니 보좌와 네 생물과 장로들 사이에 어린 양이 섰는데 일찍 죽임을 당한것 같더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Revelation 5:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p3.b2": {
    "text": "일곱 뿔과 일곱 눈이 있으니 이 눈은 온 땅에 보내심을 입은 하나님의 일곱 영이더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Revelation 5:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p3.b3": {
    "text": "어린 양이 나아와서 보좌에 앉으신 이의 오른손에서 책을 취하시니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Revelation 5:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p4.b7": {
    "text": "책을 취하시매 네 생물과 이십 사 장로들이 어린 양 앞에 엎드려 각각 거문고와 향이 가득한 금대접을 가졌으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Revelation 5:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p4.b8": {
    "text": "이 향은 성도의 기도들이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Revelation 5:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p4.b9": {
    "text": "새 노래를 노래하여 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Revelation 5:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p4.b10": {
    "text": "책을 가지시고 그 인봉을 떼기에 합당하시도다 일찍 죽임을 당하사 각 족속과 방언과 백성과 나라 가운데서 사람들을 피로 사서 하나님께 드리시고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Revelation 5:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p4.b11": {
    "text": "저희로 우리 하나님 앞에서 나라와 제사장을 삼으셨으니 저희가 땅에서 왕노릇 하리로다 하더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Revelation 5:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p5.b12": {
    "text": "내가 또 보고 들으매 보좌와 생물들과 장로들을 둘러 선 많은 천사의 음성이 있으니 그 수가 만만이요 천천이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Revelation 5:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p5.b13": {
    "text": "큰 음성으로 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Revelation 5:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p5.b14": {
    "text": "죽임을 당하신 어린양이 능력과 부와 지혜와 힘과 존귀와 영광과 찬송을 받으시기에 합당하도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Revelation 5:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p6.b15": {
    "text": "내가 또 들으니 하늘 위에와 땅 위에와 땅 아래와 바다 위에와 또 그 가운데 모든 만물이 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Revelation 5:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p6.b16": {
    "text": "보좌에 앉으신 이와 어린양에게 찬송과 존귀와 영광과 능력을 세세토록 돌릴찌어다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Revelation 5:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p7.b17": {
    "text": "네 생물이 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Revelation 5:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p7.b18": {
    "text": "아멘",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Revelation 5:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p7.b19": {
    "text": "장로들은 엎드려 경배하더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Revelation 5:14"
    },
    "adapted": false,
    "status": "approved"
  }
}
