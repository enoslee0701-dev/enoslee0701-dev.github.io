{
  "genesis.30.p1.b1": {
    "text": "ラケルは自分がヤコブに子を産まないのを知った時、姉をねたんで",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.30.p1.b2": {
    "text": "「わたしに子どもをください。さもないと、わたしは死にます」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.30.p1.b3": {
    "text": "「あなたの胎に子どもをやどらせないのは神です。わたしが神に代ることができようか」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.30.p1.b4": {
    "text": "「わたしのつかえめビルハがいます。彼女の所におはいりなさい。彼女が子を産んで、わたしのひざに置きます。そうすれば、わたしもまた彼女によって子を持つでしょう」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.30.p2.b1": {
    "text": "ビルハは、みごもってヤコブに子を産んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.30.p2.b2": {
    "text": "「神はわたしの訴えに答え、またわたしの声を聞いて、わたしに子を賜わった」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.30.p2.b3": {
    "text": "「わたしは激しい争いで、姉と争って勝った」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.30.p3.b1": {
    "text": "さてレアは自分が子を産むことのやんだのを見たとき、つかえめジルパを取り、妻としてヤコブに与えた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.30.p3.b2": {
    "text": "「幸運がきた」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.30.p3.b3": {
    "text": "レアのつかえめジルパは第二の子をヤコブに産んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.30.p3.b4": {
    "text": "「わたしは、しあわせです。娘たちはわたしをしあわせな者と言うでしょう」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.30.p4.b1": {
    "text": "さてルベンは麦刈りの日に野に出て、野で恋なすびを見つけ、それを母レアのもとに持ってきた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.30.p4.b2": {
    "text": "「あなたの子の恋なすびをどうぞわたしにください」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.30.p4.b3": {
    "text": "「あなたがわたしの夫を取ったのは小さな事でしょうか。その上、あなたはまたわたしの子の恋なすびをも取ろうとするのですか」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.30.p4.b4": {
    "text": "夕方になって、ヤコブが野から帰ってきたので、レアは彼を出迎えて",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.30.p5.b1": {
    "text": "神はレアの願いを聞かれたので、彼女はみごもって五番目の子をヤコブに産んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.30.p5.b2": {
    "text": "「神はわたしに良い賜物をたまわった。わたしは六人の子を夫に産んだから、今こそ彼はわたしと一緒に住むでしょう」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.30.p5.b3": {
    "text": "その後、彼女はひとりの娘を産んで、名をデナと名づけた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.30.p6.b1": {
    "text": "次に神はラケルを心にとめられ、彼女の願いを聞き、その胎を開かれたので、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.30.p6.b2": {
    "text": "「神はわたしの恥をすすいでくださった」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.30.p6.b3": {
    "text": "「主がわたしに、なおひとりの子を加えられるように」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.30.p7.b1": {
    "text": "「わたしを去らせて、わたしの故郷、わたしの国へ行かせてください。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.30.p7.b2": {
    "text": "「もし、あなたの心にかなうなら、とどまってください。わたしは主があなたのゆえに、わたしを恵まれるしるしを見ました」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.30.p7.b3": {
    "text": "「あなたの報酬を申し出てください。わたしはそれを払います」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.30.p7.b4": {
    "text": "主はわたしの行く所どこでも、あなたを恵まれました。しかし、いつになったらわたしも自分の家を成すようになるでしょうか」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.30.p8.b1": {
    "text": "「何をあなたにあげようか」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.30.p8.b2": {
    "text": "「なにもわたしにくださるに及びません。……あとで、あなたがきて、あなたの前でわたしの報酬をしらべる時、わたしの正しい事が証明されるでしょう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:31-33"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.30.p8.b3": {
    "text": "「よろしい。あなたの言われるとおりにしましょう」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.30.p8.b4": {
    "text": "そこでラバンはその日、雄やぎのしまのあるもの、まだらのもの、……子らの手にわたし、ヤコブとの間に三日路の隔たりを設けた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:35-36"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.30.p9.b1": {
    "text": "ヤコブは、はこやなぎと、あめんどうと、すずかけの木のなまの枝を取り、皮をはいでそれに白い筋をつくり、枝の白い所を表わし、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:37"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.30.p9.b2": {
    "text": "……しまのあるもの、ぶちのもの、まだらのものを産んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.30.p9.b3": {
    "text": "こうして弱いものはラバンのものとなり、強いものはヤコブのものとなった",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:42"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.30.p9.b4": {
    "text": "この人は大いに富み、多くの群れと、男女の奴隷、およびらくだ、ろばを持つようになった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 30:43"
    },
    "adapted": false,
    "status": "approved"
  }
}
