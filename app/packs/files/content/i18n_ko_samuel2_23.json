{
  "samuel2.23.p1.b1": {
    "text": "이는 다윗의 마지막 말이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 23:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p1.b2": {
    "text": "이새의 아들 다윗이 말함이여 높이 올리운자, 야곱의 하나님에게 기름 부음 받은자 이스라엘의 노래 잘하는 자가 말하도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 23:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p1.b3": {
    "text": "여호와의 신이 나를 빙자하여 말씀하심이여 그 말씀이 내 혀에 있도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 23:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p2.b1": {
    "text": "이스라엘의 하나님이 말씀하시며 이스라엘의 바위가 내게 이르시기를",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 23:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p2.b2": {
    "text": "사람을 공의로 다스리는 자, 하나님을 경외함으로 다스리는 자여",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 23:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p2.b3": {
    "text": "저는 돋는 해 아침 빛 같고 구름 없는 아침 같고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 23:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p2.b4": {
    "text": "비 후의 광선으로 땅에서 움이 돋는 새 풀 같으니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 23:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p3.b1": {
    "text": "내 집이 하나님 앞에 이같지 아니하냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 23:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p3.b2": {
    "text": "하나님이 나로 더불어 영원한 언약을 세우사 만사에 구비하고 견고케 하셨으니 … 어찌 이루지 아니하시랴",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 23:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p3.b3": {
    "text": "그러나 사악한 자는 다 내어 버리울 가시나무 같으니 … 그것들이 당장에 불사르이리로다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 23:6-7"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p4.b1": {
    "text": "다윗의 용사들의 이름이 이러하니라 다그몬 사람 요셉밧세벳 … 저가 한때에 팔백인을 쳐죽였더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 23:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p4.b2": {
    "text": "저가 나가서 손이 피곤하여 칼에 붙기까지 블레셋 사람을 치니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 23:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p4.b3": {
    "text": "녹두나무가 가득한 밭에 모이매 백성들은 블레셋 사람 앞에서 도망하되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 23:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p4.b4": {
    "text": "저는 그 밭 가운데 서서 막아 블레셋 사람을 친지라 여호와께서 큰 구원을 이루시니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 23:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p5.b1": {
    "text": "또 삼십 두목 중 세 사람이 곡식 벨 때에 아둘람 굴에 이르러 다윗에게 나아갔는데 … 블레셋 사람의 영채는 베들레헴에 있는지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 23:13-14"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p5.b2": {
    "text": "베들레헴 성문 곁 우물 물을 누가 나로 마시게 할꼬",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 23:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p5.b3": {
    "text": "다윗이 마시기를 기뻐 아니하고 그 물을 여호와께 부어 드리며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 23:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p5.b4": {
    "text": "여호와여 내가 결단코 이런 일을 하지 아니하리이다 이는 생명을 돌아보지 아니하고 갔던 사람들의 피니이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 23:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p6.b1": {
    "text": "또 스루야의 아들 요압의 아우 아비새니 저는 그 삼인의 두목이라 저가 창을 들어 삼백인을 죽이고 그 삼인 중에 이름을 얻었으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 23:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p6.b2": {
    "text": "또 갑스엘 용사의 손자 여호야다의 아들 브나야니 저는 효용한 일을 행한 자라 일찌기 모압 아리엘의 아들 둘을 죽였고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 23:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p6.b3": {
    "text": "또 눈 올 때에 함정에 내려가서 한 사자를 죽였으며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 23:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p6.b4": {
    "text": "… 저가 막대를 가지고 내려가서 그 애굽 사람의 손에서 창을 빼앗아 그 창으로 죽였더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 23:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p7.b1": {
    "text": "요압의 아우 아사헬은 삼십인 중에 하나요 또 베들레헴 도도의 아들 엘하난과",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 23:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.23.p7.b2": {
    "text": "헷 사람 우리아라 이상 도합이 삼십 칠인이었더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 23:39"
    },
    "adapted": false,
    "status": "approved"
  }
}
