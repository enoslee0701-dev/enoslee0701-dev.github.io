{
  "nehemiah.3.p1.b1": {
    "text": "かくて大祭司エリアシブは、その兄弟である祭司たちと共に立って羊の門を建て、これを聖別してそのとびらを設け……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 3:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.3.p1.b2": {
    "text": "魚の門はハッセナアの子らが建て、その梁を置き、そのとびらと横木と貫の木とを設けた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 3:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.3.p1.b3": {
    "text": "その次にテコアびとらが修理したが、その貴人たちはその主の工事に服さなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 3:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.3.p2.b1": {
    "text": "その次にギベオンびとメラテヤ……および川向こうの州の知事の行政下にあるギベオンとミヅパの人々が修理した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 3:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.3.p2.b2": {
    "text": "その次にハルハヤの子ウジエルなどの金細工人が修理し、その次に製香者のひとりハナニヤが修理した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 3:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.3.p2.b3": {
    "text": "その次にハルマフの子エダヤが自分の家と向かい合っている所を修理し",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 3:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.3.p2.b4": {
    "text": "その次にエルサレムの他の半区域の知事ハロヘシの子シャルムがその娘たちと共に修理した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 3:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.3.p3.b1": {
    "text": "谷の門はハヌンがザノアの民と共にこれを修理し……また糞の門まで城壁一千キュビトを修理した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 3:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.3.p3.b2": {
    "text": "糞の門はベテ・ハケレムの区域の知事レカブの子マルキヤがこれを修理し……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 3:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.3.p3.b3": {
    "text": "……彼はまた王の園のほとりのシラの池に沿った石がきを修理して、ダビデの町から下る階段にまで及んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 3:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.3.p3.b4": {
    "text": "その後にバニの子レホムなどのレビびとが修理し",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 3:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.3.p4.b1": {
    "text": "その後にザバイの子バルクが、力をつくして城壁の曲りかどから大祭司エリアシブの家の門までの他の部分を修理し、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 3:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.3.p4.b2": {
    "text": "その後にハッコヅの子ウリヤの子メレモテが、エリアシブの家の門からエリアシブの家の端までの他の部分を修理し",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 3:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.3.p4.b3": {
    "text": "その後にベニヤミンおよびハシュブが、自分たちの家と向かい合っている所を修理し",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 3:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.3.p4.b4": {
    "text": "その後にテコアびとが、突き出ている大望楼と向かい合っている他の部分を修理し、オペルの城壁にまで及んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 3:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.3.p5.b1": {
    "text": "馬の門から上の方は祭司たちが、おのおの自分の家と向かい合っている所を修理した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 3:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.3.p5.b2": {
    "text": "またすみの二階のへやと羊の門の間は金細工人と商人たちがこれを修理した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 3:32"
    },
    "adapted": false,
    "status": "approved"
  }
}
