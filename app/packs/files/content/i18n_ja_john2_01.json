{
  "john2.1.p1.b1": {
    "text": "長老のわたしから、真実に愛している選ばれた婦人とその子たちへ。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 John 1:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "john2.1.p1.b2": {
    "text": "父なる神および父の御子イエス・キリストから、恵みとあわれみと平安とが、真理と愛のうちにあって、わたしたちと共にあるように。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 John 1:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "john2.1.p2.b1": {
    "text": "あなたの子供たちのうちで、わたしたちが父から受けた戒めどおりに、真理のうちを歩いている者があるのを見て、わたしは非常に喜んでいる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 John 1:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "john2.1.p2.b2": {
    "text": "婦人よ。ここにお願いしたいことがある。…わたしたちは、みんな互に愛し合おうではないか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 John 1:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "john2.1.p2.b3": {
    "text": "それは、新しい戒めを書くわけではなく、初めから持っていた戒めなのであるが、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 John 1:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "john2.1.p2.b4": {
    "text": "父の戒めどおりに歩くことが、すなわち、愛であり、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 John 1:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "john2.1.p3.b1": {
    "text": "なぜなら、イエス・キリストが肉体をとってこられたことを告白しないで人を惑わす者が、多く世にはいってきたからである。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 John 1:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "john2.1.p3.b2": {
    "text": "よく注意して、わたしたちの働いて得た成果を失うことがなく、豊かな報いを受けられるようにしなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 John 1:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "john2.1.p3.b3": {
    "text": "この教を持たずにあなたがたのところに来る者があれば、その人を家に入れることも、あいさつすることもしてはいけない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 John 1:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "john2.1.p4.b1": {
    "text": "あなたがたに書きおくることはたくさんあるが、紙と墨とで書くことはすまい。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 John 1:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "john2.1.p4.b2": {
    "text": "選ばれたあなたの姉妹の子供たちが、あなたによろしく。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 John 1:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "john2.1.p4.b3": {
    "text": "…むしろ、あなたがたのところに行き、直接はなし合って、共に喜びに満ちあふれたいものである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 John 1:12"
    },
    "adapted": false,
    "status": "approved"
  }
}
