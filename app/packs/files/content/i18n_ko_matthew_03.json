{
  "matthew.3.p1.b1": {
    "text": "그 때에 세례 요한이 이르러 유대 광야에서 전파하여 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 3:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p1.b2": {
    "text": "회개하라 천국이 가까왔느니라 하였으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 3:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p1.b3": {
    "text": "저는 선지자 이사야로 말씀하신 자라 일렀으되 광야에 외치는 자의 소리가 있어 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 3:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p1.b4": {
    "text": "너희는 주의 길을 예비하라 그의 첩경을 평탄케 하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 3:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p2.b1": {
    "text": "이 요한은 약대 털옷을 입고 허리에 가죽띠를 띠고 음식은 메뚜기와 석청이었더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 3:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p2.b2": {
    "text": "이 때에 예루살렘과 온 유대와 요단강 사방에서 다 그에게 나아와",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 3:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p2.b3": {
    "text": "자기들의 죄를 자복하고 요단강에서 그에게 세례를 받더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 3:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p3.b1": {
    "text": "요한이 많은 바리새인과 사두개인이 세례 베푸는 데 오는 것을 보고 이르되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 3:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p3.b2": {
    "text": "독사의 자식들아 누가 너희를 가르쳐 임박한 진노를 피하라 하더냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 3:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p3.b3": {
    "text": "속으로 아브라함이 우리 조상이라고 생각지 말라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 3:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p3.b4": {
    "text": "내가 너희에게 이르노니 하나님이 능히 이 돌들로도 아브라함의 자손이 되게 하시리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 3:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p4.b1": {
    "text": "이미 도끼가 나무 뿌리에 놓였으니 좋은 열매 맺지 아니하는 나무마다 찍어 불에 던지우리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 3:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p4.b2": {
    "text": "내 뒤에 오시는 이는 나보다 능력이 많으시니 나는 그의 신을 들기도 감당치 못하겠노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 3:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p4.b3": {
    "text": "손에 키를 들고 자기의 타작 마당을 정하게 하사 알곡은 모아 곡간에 들이고 쭉정이는 꺼지지 않는 불에 태우시리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 3:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p5.b1": {
    "text": "이 때에 예수께서 갈릴리로서 요단강에 이르러 요한에게 세례를 받으려 하신대",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 3:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p5.b2": {
    "text": "요한이 말려 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 3:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p5.b3": {
    "text": "내가 당신에게 세례를 받아야 할 터인데 당신이 내게로 오시나이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 3:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p6.b1": {
    "text": "이제 허락하라 우리가 이와 같이 하여 모든 의를 이루는 것이 합당하니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 3:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p6.b2": {
    "text": "이에 요한이 허락하는지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 3:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p6.b3": {
    "text": "예수께서 세례를 받으시고 곧 물에서 올라오실새",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 3:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p7.b1": {
    "text": "하늘이 열리고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 3:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p7.b2": {
    "text": "하나님의 성령이 비둘기 같이 내려 자기 위에 임하심을 보시더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 3:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p7.b3": {
    "text": "하늘로서 소리가 있어 말씀하시되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 3:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.3.p7.b4": {
    "text": "이는 내 사랑하는 아들이요 내 기뻐하는 자라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 3:17"
    },
    "adapted": false,
    "status": "approved"
  }
}
