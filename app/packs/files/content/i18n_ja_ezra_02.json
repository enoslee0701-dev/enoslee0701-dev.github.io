{
  "ezra.2.p1.b1": {
    "text": "バビロンの王ネブカデネザルに捕えられて、バビロンに移された者のうち、捕囚をゆるされてエルサレムおよびユダに上って、おのおの自分の町に帰ったこの州の人々は次のとおりである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezra 2:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezra.2.p1.b2": {
    "text": "彼らはゼルバベル、エシュア、ネヘミヤ……と共に帰ってきた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezra 2:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezra.2.p1.b3": {
    "text": "そのイスラエルの民の人数は次のとおりである。パロシの子孫は二千百七十二人、……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezra 2:2-3"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezra.2.p1.b4": {
    "text": "ベツレヘムの子孫は百二十三人、……エリコの子孫は三百四十五人、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezra 2:21-34"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezra.2.p2.b1": {
    "text": "祭司は、エシュアの家のエダヤの子孫九百七十三人、……歌うたう者は、アサフの子孫百二十八人。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezra 2:36-41"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezra.2.p2.b2": {
    "text": "これらの者は系譜に載った者たちのうちに自分の名を尋ねたが見いだされなかったので、汚れた者として、祭司の職から除かれた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezra 2:62"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezra.2.p2.b3": {
    "text": "総督は彼らに告げて、ウリムとトンミムを身につける祭司の興るまでは、いと聖なる物を食べてはならないと言った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezra 2:63"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezra.2.p3.b1": {
    "text": "会衆は合わせて四万二千三百六十人であった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezra 2:64"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezra.2.p3.b2": {
    "text": "その馬は七百三十六頭、その騾馬は二百四十五頭、 そのらくだは四百三十五頭、そのろばは六千七百二十頭あった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezra 2:66-67"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezra.2.p3.b3": {
    "text": "氏族の長数人はエルサレムにある主の宮の所にきた時、神の宮をもとの所に建てるために真心よりの供え物をささげた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezra 2:68"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezra.2.p3.b4": {
    "text": "祭司、レビびと、および民のある者はエルサレムおよびその近郊に住み、歌うたう者、門衛および宮に仕えるしもべたちはその町々に住み、一般のイスラエルびとは自分たちの町々に住んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezra 2:70"
    },
    "adapted": false,
    "status": "approved"
  }
}
