{
  "ezekiel.27.p1.b1": {
    "text": "人の子よ、ツロのために悲しみの歌をのべ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 27:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.27.p1.b2": {
    "text": "ツロよ、あなたは言った、『わたしの美は完全である』と。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 27:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.27.p1.b3": {
    "text": "レバノンから香柏をとって、あなたのために帆柱を造り…あなたの帆はエジプトから来るあや布であって",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 27:5-7"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.27.p1.b4": {
    "text": "タルシシの船はあなたの商品を運んでまわった。あなたは海の中にいて満ち足り、いたく栄えた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 27:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.27.p2.b1": {
    "text": "あなたのこぎ手らはあなたを大海の中に進め、海の中で東風があなたの船を破った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 27:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.27.p2.b2": {
    "text": "今あなたは海で破船し、深い水に沈み、あなたの商品と、あなたのすべての船員とは、あなたと共に沈んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 27:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.27.p2.b3": {
    "text": "あなたのために声をあげて泣き、はげしく叫び、ちりをこうべにかぶり、灰の中にまろび",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 27:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.27.p2.b4": {
    "text": "だれかツロのように海の中で滅びたものがあるか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 27:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.27.p2.b5": {
    "text": "あなたは恐るべき終りを遂げ、永遠にうせはてる",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 27:36"
    },
    "adapted": false,
    "status": "approved"
  }
}
