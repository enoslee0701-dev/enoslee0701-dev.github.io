{
  "revelation.5.p1.b1": {
    "text": "わたしはまた、御座にいますかたの右の手に、巻物があるのを見た。その内側にも外側にも字が書いてあって、七つの封印で封じてあった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Revelation 5:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p1.b2": {
    "text": "「その巻物を開き、封印をとくのにふさわしい者は、だれか」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Revelation 5:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p1.b3": {
    "text": "しかし、天にも地にも地の下にも、この巻物を開いて、それを見ることのできる者は、ひとりもいなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Revelation 5:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p2.b4": {
    "text": "巻物を開いてそれを見るのにふさわしい者が見当らないので、わたしは激しく泣いていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Revelation 5:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p2.b5": {
    "text": "「泣くな。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Revelation 5:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p2.b6": {
    "text": "見よ、ユダ族のしし、ダビデの若枝であるかたが、勝利を得たので、その巻物を開き七つの封印を解くことができる」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Revelation 5:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p3.b1": {
    "text": "わたしはまた、御座と四つの生き物との間、長老たちの間に、ほふられたとみえる小羊が立っているのを見た。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Revelation 5:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p3.b2": {
    "text": "それに七つの角と七つの目とがあった。これらの目は、全世界につかわされた、神の七つの霊である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Revelation 5:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p3.b3": {
    "text": "小羊は進み出て、御座にいますかたの右の手から、巻物を受けとった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Revelation 5:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p4.b7": {
    "text": "巻物を受けとった時、四つの生き物と二十四人の長老とは、おのおの、立琴と、香の満ちている金の鉢とを手に持って、小羊の前にひれ伏した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Revelation 5:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p4.b8": {
    "text": "この香は聖徒の祈である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Revelation 5:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p4.b9": {
    "text": "彼らは新しい歌を歌って言った、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Revelation 5:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p4.b10": {
    "text": "「あなたこそは、その巻物を受けとり、封印を解くにふさわしいかたであります。あなたはほふられ、その血によって、神のために、あらゆる部族、国語、民族、国民の中から人々をあがない、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Revelation 5:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p4.b11": {
    "text": "わたしたちの神のために、彼らを御国の民とし、祭司となさいました。彼らは地上を支配するに至るでしょう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Revelation 5:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p5.b12": {
    "text": "さらに見ていると、御座と生き物と長老たちとのまわりに、多くの御使たちの声が上がるのを聞いた。その数は万の幾万倍、千の幾千倍もあって、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Revelation 5:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p5.b13": {
    "text": "大声で叫んでいた、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Revelation 5:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p5.b14": {
    "text": "「ほふられた小羊こそは、力と、富と、知恵と、勢いと、ほまれと、栄光と、さんびとを受けるにふさわしい」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Revelation 5:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p6.b15": {
    "text": "またわたしは、天と地、地の下と海の中にあるすべての造られたもの、そして、それらの中にあるすべてのものの言う声を聞いた、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Revelation 5:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p6.b16": {
    "text": "「御座にいますかたと小羊とに、さんびと、ほまれと、栄光と、権力とが、世々限りなくあるように」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Revelation 5:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p7.b17": {
    "text": "四つの生き物は",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Revelation 5:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p7.b18": {
    "text": "アァメン",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Revelation 5:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "revelation.5.p7.b19": {
    "text": "長老たちはひれ伏して礼拝した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Revelation 5:14"
    },
    "adapted": false,
    "status": "approved"
  }
}
