{
  "exodus.34.p1.b1": {
    "text": "あなたは前のような石の板二枚を、切って造りなさい。わたしはあなたが砕いた初めの板にあった言葉を、その板に書くであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 34:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.34.p1.b2": {
    "text": "あなたは朝までに備えをし、朝のうちにシナイ山に登って、山の頂でわたしの前に立ちなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 34:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.34.p1.b3": {
    "text": "だれもあなたと共に登ってはならない。また、だれも山の中にいてはならない。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 34:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.34.p2.b4": {
    "text": "そこでモーセは前のような石の板二枚を、切って造り、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 34:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.34.p2.b5": {
    "text": "朝早く起きて、主が彼に命じられたようにシナイ山に登った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 34:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.34.p2.b6": {
    "text": "彼はその手に石の板二枚をとった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 34:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.34.p3.b7": {
    "text": "ときに主は雲の中にあって下り、彼と共にそこに立って主の名を宣べられた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 34:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.34.p3.b8": {
    "text": "主、主、あわれみあり、恵みあり、怒ることおそく、いつくしみと、まこととの豊かなる神、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 34:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.34.p3.b9": {
    "text": "モーセは急ぎ地に伏して拝し、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 34:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.34.p3.b10": {
    "text": "ああ主よ、わたしがもし、あなたの前に恵みを得ますならば、… どうか主がわたしたちのうちにあって一緒に行ってください。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 34:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.34.p4.b11": {
    "text": "見よ、わたしは契約を結ぶ。わたしは地のいずこにも、いかなる民のうちにも、いまだ行われたことのない不思議を、あなたのすべての民の前に行うであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 34:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.34.p4.b12": {
    "text": "あなたが共に住む民はみな、主のわざを見るであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 34:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.34.p4.b13": {
    "text": "むしろあなたがたは、彼らの祭壇を倒し、石の柱を砕き、アシラ像を切り倒さなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 34:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.34.p4.b14": {
    "text": "あなたは他の神を拝んではならない。主はその名を『ねたみ』と言って、ねたむ神だからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 34:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.34.p5.b15": {
    "text": "おそらくあなたはその国に住む者と契約を結び、彼らの神々を慕って姦淫を行い、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 34:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.34.p5.b16": {
    "text": "あなたは自分のために鋳物の神々を造ってはならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 34:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.34.p5.b17": {
    "text": "あなたは種入れぬパンの祭を守らなければならない。… 七日のあいだ、種入れぬパンを食べなければならない。あなたがアビブの月にエジプトを出たからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 34:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.34.p5.b18": {
    "text": "すべて初めに生れる者は、わたしのものである。… むなし手でわたしの前に出てはならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 34:19-20"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.34.p6.b19": {
    "text": "あなたは六日のあいだ働き、七日目には休まなければならない。耕し時にも、刈入れ時にも休まなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 34:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.34.p6.b20": {
    "text": "年に三度、男子はみな主なる神、イスラエルの神の前に出なければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 34:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.34.p6.b21": {
    "text": "モーセは主と共に、四十日四十夜、そこにいたが、パンも食べず、水も飲まなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 34:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.34.p6.b22": {
    "text": "そして彼は契約の言葉、十誡を板の上に書いた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 34:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.34.p7.b23": {
    "text": "モーセはそのあかしの板二枚を手にして、シナイ山から下ったが、その山を下ったとき、モーセは、さきに主と語ったゆえに、顔の皮が光を放っているのを知らなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 34:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.34.p7.b24": {
    "text": "アロンとイスラエルの人々とがみな、モーセを見ると、彼の顔の皮が光を放っていたので、彼らは恐れてこれに近づかなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 34:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.34.p7.b25": {
    "text": "モーセは彼らを呼んだ。アロンと会衆のかしらたちとがみな、モーセのもとに帰ってきたので、モーセは彼らと語った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 34:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.34.p7.b26": {
    "text": "その後、イスラエルの人々がみな近よったので、モーセは主がシナイ山で彼に語られたことを、ことごとく彼らにさとした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 34:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.34.p8.b27": {
    "text": "モーセは彼らと語り終えた時、顔おおいを顔に当てた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 34:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.34.p8.b28": {
    "text": "しかしモーセは主の前に行って主と語る時は、出るまで顔おおいを取り除いていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 34:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.34.p8.b29": {
    "text": "そして出て来ると、その命じられた事をイスラエルの人人に告げた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 34:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.34.p8.b30": {
    "text": "イスラエルの人々はモーセの顔を見ると、モーセの顔の皮が光を放っていた。モーセは行って主と語るまで、また顔おおいを顔に当てた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 34:35"
    },
    "adapted": false,
    "status": "approved"
  }
}
