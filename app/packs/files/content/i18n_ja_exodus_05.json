{
  "exodus.5.p1.b1": {
    "text": "その後、モーセとアロンは行ってパロに言った、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 5:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.5.p1.b2": {
    "text": "イスラエルの神、主はこう言われる、『わたしの民を去らせ、荒野で、わたしのために祭をさせなさい』",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 5:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.5.p1.b3": {
    "text": "主とはいったい何者か。わたしがその声に聞き従ってイスラエルを去らせなければならないのか。わたしは主を知らない。またイスラエルを去らせはしない",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 5:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.5.p2.b4": {
    "text": "…どうか、わたしたちを三日の道のりほど荒野に行かせ、わたしたちの神、主に犠牲をささげさせてください。そうしなければ主は疫病か、つるぎをもって、わたしたちを悩まされるからです",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 5:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.5.p2.b5": {
    "text": "モーセとアロンよ、あなたがたは、なぜ民に働きをやめさせようとするのか。自分の労役につくがよい",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 5:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.5.p2.b6": {
    "text": "あなたがたは、れんがを作るためのわらを、もはや、今までのように、この民に与えてはならない。彼らに自分で行って、わらを集めさせなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 5:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.5.p2.b7": {
    "text": "また前に作っていた、れんがの数どおりに彼らに作らせ、それを減らしてはならない。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 5:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.5.p3.b8": {
    "text": "パロはこう仰せられる、『あなたがたに、わらは与えない。自分で行って、見つかる所から、わらを取って来るがよい。しかし働きは少しも減らしてはならない』",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 5:10-11"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.5.p3.b9": {
    "text": "そこで民はエジプトの全地に散って、わらのかわりに、刈り株を集めた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 5:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.5.p3.b10": {
    "text": "わらがあった時と同じように、あなたがたの働きの、日ごとの分を仕上げなければならない",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 5:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.5.p3.b11": {
    "text": "なぜ、あなたがたは、れんが作りの仕事を、きょうも、前のように仕上げないのか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 5:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.5.p4.b12": {
    "text": "そこで、イスラエルの人々のかしらたちはパロのところに行き、叫んで言った…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 5:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.5.p4.b13": {
    "text": "あなたはなぜ、しもべどもにこんなことをなさるのですか。…しもべどもは打たれています。罪はあなたの民にあるのです",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 5:15-16"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.5.p4.b14": {
    "text": "あなたがたは、なまけ者だ、なまけ者だ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 5:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.5.p4.b15": {
    "text": "さあ、行って働きなさい。わらは与えないが、なおあなたがたは定めた数のれんがを納めなければならない",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 5:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.5.p5.b16": {
    "text": "イスラエルの人々のかしらたちは、…悪い事態になったことを知った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 5:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.5.p5.b17": {
    "text": "彼らがパロを離れて出てきた時、彼らに会おうとして立っていたモーセとアロンに会った…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 5:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.5.p5.b18": {
    "text": "主があなたがたをごらんになって、さばかれますように。あなたがたは、わたしたちをパロとその家来たちにきらわせ、つるぎを彼らの手に渡して、殺させようとしておられるのです",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 5:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.5.p6.b19": {
    "text": "モーセは主のもとに帰って言った、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 5:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.5.p6.b20": {
    "text": "主よ、あなたは、なぜこの民をひどい目にあわされるのですか。なんのためにわたしをつかわされたのですか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 5:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.5.p6.b21": {
    "text": "わたしがパロのもとに行って、あなたの名によって語ってからこのかた、彼はこの民をひどい目にあわせるばかりです。また、あなたは、すこしもあなたの民を救おうとなさいません",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 5:23"
    },
    "adapted": false,
    "status": "approved"
  }
}
