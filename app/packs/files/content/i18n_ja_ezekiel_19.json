{
  "ezekiel.19.p1.b1": {
    "text": "あなたはイスラエルの君たちのために悲しみの歌をのべて",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 19:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.19.p1.b2": {
    "text": "あなたの母はししのうちにあって、どんな雌じしであったろう。彼女は若いししのうちに伏して",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 19:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.19.p1.b3": {
    "text": "国々の人は彼に対して叫び声をあげ、落し穴でこれを捕え、かぎでこれをエジプトの地に引いて行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 19:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.19.p1.b4": {
    "text": "これをかごに入れ、これをバビロンの王のもとに連れて行き、…再びその声をイスラエルの山々に聞えさせないようにした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 19:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.19.p1.b5": {
    "text": "あなたの母は水のほとりに移し植えられたぶどう畑のぶどうの木のようで、水が多いために実りがよく、枝がはびこった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 19:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.19.p1.b6": {
    "text": "しかしこのぶどうの木は憤りによって抜かれ、地に投げうたれ、…強い幹で、君たる者のつえとなるべきものはそこにない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 19:12-14"
    },
    "adapted": false,
    "status": "approved"
  }
}
