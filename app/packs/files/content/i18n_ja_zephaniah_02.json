{
  "zephaniah.2.p1.b1": {
    "text": "あなたがた、恥を知らぬ民よ、共につどい、集まれ……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 2:1-2"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.2.p1.b2": {
    "text": "すべて主の命令を行うこの地のへりくだる者よ、主を求めよ……そうすればあなたがたは主の怒りの日に、あるいは隠されることがあろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 2:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.2.p1.b3": {
    "text": "ガザは捨てられ、アシケロンは荒れはて……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 2:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.2.p1.b4": {
    "text": "海べよ、あなたは牧場となり、羊飼の牧草地となり、また羊のおりとなる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 2:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.2.p1.b5": {
    "text": "モアブは必ずソドムのようになる。アンモンの人々はゴモラのようになる。いらくさと塩穴とがここを占領して、永遠に荒れ地となる",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 2:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.2.p1.b6": {
    "text": "……もろもろの国の民は、おのおの自分の所から出て主を拝む。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 2:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.2.p1.b7": {
    "text": "エチオピヤびとよ、あなたがたもまたわがつるぎによって殺される。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 2:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.2.p1.b8": {
    "text": "主はまた北に向かって手を伸べ、アッスリヤを滅ぼし、ニネベを荒して、荒野のような、かわいた地とされる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 2:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.2.p1.b9": {
    "text": "はげたかや、やまあらしはその柱の頂に住み、ふくろうは、その窓のうちになき、からすは、その敷居の上に鳴く。その香柏の細工が裸にされるからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 2:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.2.p1.b10": {
    "text": "この町は勝ち誇って、安らかに落ち着き、その心の中で、「ただわたしだけだ、わたしの外にはだれもない」と言った町であるが、このように荒れはてて、獣の伏す所になってしまった",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 2:15"
    },
    "adapted": false,
    "status": "approved"
  }
}
