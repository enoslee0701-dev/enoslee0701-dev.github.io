{
  "samuel1.3.p1.b1": {
    "text": "わらべサムエルは、エリの前で、主に仕えていた。そのころ、主の言葉はまれで、黙示も常ではなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 3:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.3.p1.b2": {
    "text": "さてエリは、しだいに目がかすんで、見ることができなくなり、そのとき自分のへやで寝ていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 3:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.3.p1.b3": {
    "text": "神のともしびはまだ消えず、サムエルが神の箱のある主の神殿に寝ていた時、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 3:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.3.p2.b1": {
    "text": "主は「サムエルよ、サムエルよ」と呼ばれた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 3:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.3.p2.b2": {
    "text": "「はい、ここにおります」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 3:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.3.p2.b3": {
    "text": "「あなたがお呼びになりました。わたしは、ここにおります」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 3:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.3.p2.b4": {
    "text": "「わたしは呼ばない。帰って寝なさい」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 3:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.3.p3.b1": {
    "text": "主はまたかさねて「サムエルよ、サムエルよ」と呼ばれた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 3:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.3.p3.b2": {
    "text": "「子よ、わたしは呼ばない。もう一度寝なさい」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 3:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.3.p3.b3": {
    "text": "サムエルはまだ主を知らず、主の言葉がまだ彼に現されなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 3:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.3.p4.b1": {
    "text": "主はまた三度目にサムエルを呼ばれたので、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 3:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.3.p4.b2": {
    "text": "「あなたがお呼びになりました。わたしは、ここにおります」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 3:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.3.p4.b3": {
    "text": "その時、エリは主がわらべを呼ばれたのであることを悟った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 3:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.3.p4.b4": {
    "text": "「行って寝なさい。もしあなたを呼ばれたら、『しもべは聞きます。主よ、お話しください』と言いなさい」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 3:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.3.p5.b1": {
    "text": "主はきて立ち、前のように、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 3:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.3.p5.b2": {
    "text": "「サムエルよ、サムエルよ」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 3:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.3.p5.b3": {
    "text": "「しもべは聞きます。お話しください」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 3:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.3.p6.b1": {
    "text": "「見よ、わたしはイスラエルのうちに一つの事をする。それを聞く者はみな、耳が二つとも鳴るであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 3:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.3.p6.b2": {
    "text": "その日には、わたしが、かつてエリの家について話したことを、はじめから終りまでことごとく、エリに行うであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 3:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.3.p6.b3": {
    "text": "… その子らが神をけがしているのに、彼がそれをとめなかったからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 3:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.3.p6.b4": {
    "text": "サムエルは朝まで寝て、主の宮の戸をあけたが、サムエルはその幻のことをエリに語るのを恐れた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 3:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.3.p7.b1": {
    "text": "「わが子サムエルよ」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 3:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.3.p7.b2": {
    "text": "「何事をお告げになったのか。隠さず話してください。…」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 3:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.3.p7.b3": {
    "text": "「それは主である。どうぞ主が、良いと思うことを行われるように」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 3:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.3.p7.b4": {
    "text": "ダンからベエルシバまで、イスラエルのすべての人は、サムエルが主の預言者と定められたことを知った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 3:20"
    },
    "adapted": false,
    "status": "approved"
  }
}
