{
  "genesis.14.p1.b1": {
    "text": "당시에 시날왕 아므라벨과 엘라살왕 아리옥과 엘람왕 그돌라오멜과 고임왕 디달이 소돔왕 베라와 … 싸우니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 14:1-2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p1.b2": {
    "text": "이들이 십이년 동안 그돌라오멜을 섬기다가 제 십삼년에 배반한지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 14:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p1.b3": {
    "text": "제 십사년에 그돌라오멜과 그와 동맹한 왕들이 나와서 아스드롯 가르나임에서 르바 족속을 … 쳐서 광야 근방 엘바란까지 이르렀으며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 14:5-6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p1.b4": {
    "text": "그들이 돌이켜 엔미스밧 곧 가데스에 이르러 아말렉 족속의 온 땅과 하사손다말에 사는 아모리 족속을 친지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 14:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p2.b5": {
    "text": "소돔왕과 고모라왕과 … 나와서 싯딤 골짜기에서 그들과 접전하였으니 … 네 왕과 교전하였더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 14:8-9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p2.b6": {
    "text": "싯딤 골짜기에는 역청 구덩이가 많은지라 소돔왕과 고모라 왕이 달아날 때에 군사가 거기 빠지고 그 나머지는 산으로 도망하매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 14:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p2.b7": {
    "text": "소돔에 거하는 아브람의 조카 롯도 사로잡고 그 재물까지 노략하여 갔더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 14:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p3.b8": {
    "text": "도망한 자가 와서 히브리 사람 아브람에게 고하니 때에 아브람이 아모리 족속 마므레의 상수리 수풀 근처에 거하였더라 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 14:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p3.b9": {
    "text": "아브람이 그 조카의 사로 잡혔음을 듣고 집에서 길리고 연습한 자 삼백 십팔인을 거느리고 단까지 쫓아가서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 14:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p4.b10": {
    "text": "그 가신을 나누어 밤을 타서 그들을 쳐서 파하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 14:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p4.b11": {
    "text": "다메섹 좌편 호바까지 쫓아가서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 14:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p5.b12": {
    "text": "모든 빼앗겼던 재물과",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 14:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p5.b13": {
    "text": "자기 조카 롯과 그 재물과",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 14:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p5.b14": {
    "text": "또 부녀와 인민을 다 찾아 왔더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 14:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p6.b15": {
    "text": "아브람이 그돌라오멜과 그와 함께 한 왕들을 파하고 돌아올 때에 소돔왕이 사웨 골짜기 곧 왕곡에 나와 그를 영접하였고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 14:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p6.b16": {
    "text": "천지의 주재시요 지극히 높으신 하나님이여 아브람에게 복을 주옵소서 너희 대적을 네 손에 붙이신 지극히 높으신 하나님을 찬송할지로다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 14:19-20"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p6.b17": {
    "text": "아브람이 그 얻은 것에서 십분 일을 멜기세덱에게 주었더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 14:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p7.b18": {
    "text": "사람은 내게 보내고 물품은 네가 취하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 14:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p7.b19": {
    "text": "천지의 주재시요 지극히 높으신 하나님 여호와께 내가 손을 들어 맹세하노니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 14:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p7.b20": {
    "text": "네 말이 내가 아브람으로 치부케 하였다 할까 하여 네게 속한 것은 무론 한 실이나 신들 메라도 내가 취하지 아니하리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 14:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.14.p7.b21": {
    "text": "오직 소년들의 먹은 것과 나와 동행한 아넬과 에스골과 마므레의 분깃을 제할지니 그들이 그 분깃을 취할 것이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 14:24"
    },
    "adapted": false,
    "status": "approved"
  }
}
