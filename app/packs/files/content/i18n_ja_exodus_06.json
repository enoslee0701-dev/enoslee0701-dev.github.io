{
  "exodus.6.p1.b1": {
    "text": "今、あなたは、わたしがパロに何をしようとしているかを見るであろう。すなわちパロは強い手にしいられて、彼らを去らせるであろう。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 6:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.6.p1.b2": {
    "text": "わたしは主である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 6:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.6.p1.b3": {
    "text": "わたしはアブラハム、イサク、ヤコブには全能の神として現れたが、主という名では、自分を彼らに知らせなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 6:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.6.p1.b4": {
    "text": "わたしはまた、エジプトびとが奴隷としているイスラエルの人々のうめきを聞いて、わたしの契約を思い出した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 6:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.6.p2.b5": {
    "text": "わたしは主である。わたしはあなたがたをエジプトびとの労役の下から導き出し、奴隷の務から救い、また伸べた腕と大いなるさばきをもって、あなたがたをあがなうであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 6:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.6.p2.b6": {
    "text": "わたしはあなたがたを取ってわたしの民とし、わたしはあなたがたの神となる。…わたしはアブラハム、イサク、ヤコブに与えると手を挙げて誓ったその地にあなたがたをはいらせ、それを所有として、与えるであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 6:7-8"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.6.p2.b7": {
    "text": "モーセはこのようにイスラエルの人々に語ったが、彼らは心の痛みと、きびしい奴隷の務のゆえに、モーセに聞き従わなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 6:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.6.p3.b8": {
    "text": "エジプトの王パロのところに行って、彼がイスラエルの人々をその国から去らせるように話しなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 6:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.6.p3.b9": {
    "text": "イスラエルの人々でさえ、わたしの言うことを聞かなかったのに、どうして、くちびるに割礼のないわたしの言うことを、パロが聞き入れましょうか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 6:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.6.p3.b10": {
    "text": "しかし、主はモーセとアロンに語って、イスラエルの人々と、エジプトの王パロのもとに行かせ、イスラエルの人々をエジプトの地から導き出せと命じられた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 6:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.6.p4.b11": {
    "text": "彼らの先祖の家の首長たちは次のとおりである。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 6:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.6.p4.b12": {
    "text": "アムラムは父の妹ヨケベデを妻としたが、彼女はアロンとモーセを彼に産んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 6:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.6.p4.b13": {
    "text": "彼らはイスラエルの人々をエジプトから導き出すことについて、エジプトの王パロに語ったもので、すなわちこのモーセとアロンである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 6:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.6.p5.b14": {
    "text": "わたしは主である。わたしがあなたに語ることは、みなエジプトの王パロに語りなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 6:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.6.p5.b15": {
    "text": "主がエジプトの地でモーセに語られた日に、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 6:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.6.p5.b16": {
    "text": "ごらんのとおり、わたしは、くちびるに割礼のない者です。パロがどうしてわたしの言うことを聞きいれましょうか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 6:30"
    },
    "adapted": false,
    "status": "approved"
  }
}
