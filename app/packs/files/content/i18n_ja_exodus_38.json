{
  "exodus.38.p1.b1": {
    "text": "またアカシヤ材で燔祭の祭壇を造った。長さ五キュビト、幅五キュビトの四角で、高さは三キュビトである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 38:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.38.p1.b2": {
    "text": "そのさおを祭壇の両側にある環に通して、それをかつぐようにした。祭壇は板をもって、空洞に造った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 38:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.38.p1.b3": {
    "text": "また洗盤と、その台を青銅で造った。すなわち会見の幕屋の入口で務をなす女たちの鏡をもって造った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 38:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.38.p2.b4": {
    "text": "また庭を造った。その南側のために百キュビトの亜麻の撚糸の庭のあげばりを設けた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 38:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.38.p2.b5": {
    "text": "柱の座は青銅、柱の鉤と桁とは銀、柱の頭のおおいも銀である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 38:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.38.p2.b6": {
    "text": "庭の門のとばりは青糸、紫糸、緋糸、亜麻の撚糸で、色とりどりに織ったものであった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 38:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.38.p2.b7": {
    "text": "ただし、幕屋および、その周囲の庭の釘はみな青銅であった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 38:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.38.p3.b8": {
    "text": "幕屋、すなわちあかしの幕屋に用いた物の総計は次のとおりである。すなわちモーセの命に従い、祭司アロンの子イタマルがレビびとを用いて量ったものである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 38:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.38.p3.b9": {
    "text": "ユダの部族に属するホルの子なるウリの子ベザレルは、主がモーセに命じられた事をことごとくした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 38:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.38.p3.b10": {
    "text": "……ひとり当り一ベカ、すなわち聖所のシケルの半シケル",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 38:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.38.p3.b11": {
    "text": "聖所の座と垂幕の座とを鋳るために用いた銀は百タラントであった。すなわち百座につき百タラント、一座につき一タラントである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 38:27"
    },
    "adapted": false,
    "status": "approved"
  }
}
