{
  "matthew.1.p1.b1": {
    "text": "아브라함과 다윗의 자손 예수 그리스도의 세계라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 1:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p1.b2": {
    "text": "아브라함이 이삭을 낳고 이삭은 야곱을 낳고 야곱은 유다와 그의 형제를 낳고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 1:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p1.b3": {
    "text": "살몬은 라합에게서 보아스를 낳고 보아스는 룻에게서 오벳을 낳고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 1:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p1.b4": {
    "text": "이새는 다윗왕을 낳으니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 1:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p2.b1": {
    "text": "다윗은 우리야의 아내에게서 솔로몬을 낳고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 1:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p2.b2": {
    "text": "솔로몬은 르호보암을 낳고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 1:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p2.b3": {
    "text": "바벨론으로 이거할 때에 요시야는 여고냐와 그의 형제를 낳으니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 1:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p3.b1": {
    "text": "바벨론으로 이거한 후에 여고냐는 스알디엘을 낳고 스알디엘은 스룹바벨을 낳고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 1:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p3.b2": {
    "text": "야곱은 마리아의 남편 요셉을 낳았으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 1:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p3.b3": {
    "text": "마리아에게서 그리스도라 칭하는 예수가 나시니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 1:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p3.b4": {
    "text": "그런즉 모든 대 수가 아브라함부터 다윗까지 열 네 대요 … 바벨론으로 이거한 후부터 그리스도까지 열 네 대러라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 1:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p4.b1": {
    "text": "예수 그리스도의 나심은 이러하니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 1:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p4.b2": {
    "text": "그 모친 마리아가 요셉과 정혼하고 동거하기 전에",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 1:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p4.b3": {
    "text": "성령으로 잉태된 것이 나타났더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 1:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p5.b1": {
    "text": "그 남편 요셉은 의로운 사람이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 1:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p5.b2": {
    "text": "저를 드러내지 아니하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 1:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p5.b3": {
    "text": "가만히 끊고자 하여",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 1:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p6.b1": {
    "text": "이 일을 생각할 때에 주의 사자가 현몽하여",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 1:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p6.b2": {
    "text": "다윗의 자손 요셉아 … 무서워 말라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 1:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p6.b3": {
    "text": "네 아내 마리아 데려오기를 무서워 말라 저에게 잉태된 자는 성령으로 된 것이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 1:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p6.b4": {
    "text": "아들을 낳으리니 이름을 예수라 하라 이는 그가 자기 백성을 저희 죄에서 구원할 자이심이라 하니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 1:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p7.b1": {
    "text": "이 모든 일의 된 것은 주께서 선지자로 하신 말씀을 이루려 하심이니 가라사대 보라 처녀가 잉태하여 아들을 낳을 것이요 그 이름은 임마누엘이라 하리라 하셨으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 1:22-23"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p7.b2": {
    "text": "이를 번역한즉 하나님이 우리와 함께 계시다 함이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 1:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p7.b3": {
    "text": "요셉이 잠을 깨어 일어나서 주의 사자의 분부대로 행하여 그의 아내를 데려 왔으나",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 1:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p8.b1": {
    "text": "아들을 낳기까지 동침치 아니하더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 1:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p8.b2": {
    "text": "낳으매 이름을 예수라 하니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 1:25"
    },
    "adapted": false,
    "status": "approved"
  }
}
