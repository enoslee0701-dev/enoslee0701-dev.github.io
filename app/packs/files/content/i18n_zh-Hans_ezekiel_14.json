{
  "ezekiel.14.p1.b1": {
    "text": "有几个以色列长老到我这里来，坐在我面前。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ezekiel 14:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有几⁠个以⁠色⁠列长⁠老到我这⁠里来，坐⁠在我面⁠前。"
  },
  "ezekiel.14.p1.b2": {
    "text": "人子啊，这些人已将他们的假神接到心里，把陷于罪的绊脚石放在面前……",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ezekiel 14:3"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "人⁠子啊，这⁠些人已将他⁠们的假神接⁠到心⁠里，把陷⁠于罪的绊⁠脚石放⁠在面⁠前……"
  },
  "ezekiel.14.p1.b3": {
    "text": "我必向那人变脸，使他作了警戒，笑谈，令人惊骇……",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ezekiel 14:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我必向那人变⁠脸，使他作⁠了警⁠戒，笑谈，令⁠人惊⁠骇……"
  },
  "ezekiel.14.p1.b4": {
    "text": "回头吧！离开你们的偶像，转脸莫从你们一切可憎的事。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ezekiel 14:6"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "回⁠头吧！离⁠开你⁠们的偶⁠像，转脸莫从你⁠们一⁠切可⁠憎的事。"
  },
  "ezekiel.14.p1.b5": {
    "text": "饥荒",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ezekiel 14:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "饥⁠荒"
  },
  "ezekiel.14.p1.b6": {
    "text": "恶兽",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ezekiel 14:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.14.p1.b7": {
    "text": "刀剑",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ezekiel 14:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.14.p1.b8": {
    "text": "瘟疫",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ezekiel 14:19"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "瘟⁠疫"
  },
  "ezekiel.14.p1.b9": {
    "text": "其中虽有挪亚、但以理、约伯这三人，他们只能因他们的义救自己的性命。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ezekiel 14:14"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "其⁠中虽有挪亚、但以理、约伯这三⁠人，他⁠们只⁠能因他⁠们的义救自⁠己的性⁠命。"
  },
  "ezekiel.14.p1.b10": {
    "text": "然而其中必有剩下的人，他们连儿带女必带到你们这里来……",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ezekiel 14:22"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "然⁠而其⁠中必⁠有剩⁠下的人，他⁠们连儿带女必带⁠到你⁠们这⁠里来……"
  }
}
