{
  "ezekiel.20.p1.b1": {
    "text": "あなたがたがわたしのもとに来たのは、わたしに何か尋ねるためであるか。…わたしはあなたがたの尋ねに答えない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 20:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.20.p1.b2": {
    "text": "あなたがたは、おのおのその目を楽しませる憎むべきものを捨てよ。エジプトの偶像をもって、その身を汚すな。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 20:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.20.p1.b3": {
    "text": "わたしはエジプトの地から彼らを導き出して、荒野に連れて行き",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 20:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.20.p1.b4": {
    "text": "わたしはまた彼らに安息日を与えて、わたしと彼らとの間のしるしとした。…しかしイスラエルの家は荒野でわたしにそむき",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 20:12-13"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.20.p1.b5": {
    "text": "けれどもわたしは彼らを惜しみ見て、彼らを滅ぼさず、荒野で彼らを絶やさなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 20:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.20.p2.b1": {
    "text": "あなたがたの先祖の定めに歩んではならない。…その偶像をもって、あなたがたの身を汚してはならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 20:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.20.p2.b2": {
    "text": "彼らはすべての高い丘と、すべての茂った木とを見て、その所で犠牲をささげ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 20:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.20.p2.b3": {
    "text": "あなたがたは、その先祖のおこないに従って、その身を汚し、その憎むべきものを慕うのか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 20:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.20.p2.b4": {
    "text": "われわれは異邦人のようになり、国々のもろもろのやからのようになって、木や石を拝もう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 20:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.20.p2.b5": {
    "text": "わたしは必ず強い手と伸べた腕と注がれた憤りとをもって、あなたがたを治める。…わたしはあなたがたに、むちの下を通らせ、数えてはいらせ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 20:33-37"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.20.p3.b1": {
    "text": "わたしの聖なる山、イスラエルの高い山の上で、イスラエルの全家はその地で、ことごとくわたしに仕える。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 20:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.20.p3.b2": {
    "text": "またその所であなたがたは、その身を汚したあなたがたのおこないと、すべてのわざとを思い出し、みずから行ったすべての悪事のために、自分を忌みきらうようになる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 20:43"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.20.p3.b3": {
    "text": "わたしがあなたがたの悪しきおこないによらず、またその腐れたわざによらず、わたしの名のために、あなたがたを扱う時",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 20:44"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.20.p3.b4": {
    "text": "わたしはあなたのうちに火を燃やす。その火はあなたのうちのすべての青木と、すべての枯れ木を焼き滅ぼし",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 20:47"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.20.p3.b5": {
    "text": "ああ主なる神よ、彼らはわたしについてこう語っています、『彼はたとえをもって語る者ではないか』と",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 20:49"
    },
    "adapted": false,
    "status": "approved"
  }
}
