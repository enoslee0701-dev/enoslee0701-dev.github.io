{
  "zechariah.1.p1.b1": {
    "text": "ダリヨスの第二年の八月に",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 1:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p1.b2": {
    "text": "主の言葉がイドの子ベレキヤの子である預言者ゼカリヤに臨んだ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 1:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p1.b3": {
    "text": "「主はあなたがたの先祖たちに対して、いたくお怒りになった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 1:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p1.b4": {
    "text": "わたしに帰れ、そうすれば、わたしもあなたがたに帰ろうと、万軍の主は仰せられる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 1:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p1.b5": {
    "text": "先の預言者たちは、彼らにむかって叫んで言った……悪い道を離れ、悪いおこないを捨てて帰れ……しかし彼らは聞きいれず、耳をわたしに傾けなかった",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 1:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p1.b6": {
    "text": "あなたがたの先祖たち、彼らはどこにいるか。預言者たち、彼らは永遠に生きているのか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 1:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p1.b7": {
    "text": "しかしわたしのしもべである預言者たちに命じたわが言葉と、わが定めとは、あなたがたの先祖たちに及んだではないか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 1:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p1.b8": {
    "text": "万軍の主がわれわれの道にしたがい、おこないに従って、われわれに、なそうと思い定められたように、そのとおりされたのだ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 1:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p2.b1": {
    "text": "ダリヨスの第二年の十一月、すなわちセバテという月の二十四日に",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 1:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p2.b2": {
    "text": "「わたしは夜、見ていると、ひとりの人が赤馬に乗って、谷間にあるミルトスの木の中に立ち、その後に赤馬、栗毛の馬、白馬がいた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 1:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p2.b3": {
    "text": "わが主よ、これらはなんですか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 1:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p2.b4": {
    "text": "われわれは地を見回ったが、全地はすべて平穏です",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 1:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p2.b5": {
    "text": "万軍の主よ、あなたは、いつまでエルサレムとユダの町々とを、あわれんで下さらないのですか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 1:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p2.b6": {
    "text": "わたしはあわれみをもってエルサレムに帰る。わたしの家はその中に建てられ、測りなわはエルサレムに張られる",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 1:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p2.b7": {
    "text": "わが町々は再び良い物で満ちあふれ、主は再びシオンを慰め、再びエルサレムを選ぶ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 1:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p3.b1": {
    "text": "わたしが目をあげて見ていると、見よ、四つの角があった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 1:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p3.b2": {
    "text": "これらはなんですか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 1:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p3.b3": {
    "text": "これらはユダ、イスラエルおよびエルサレムを散らした角です",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 1:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p3.b4": {
    "text": "その時、主は四人の鍛冶をわたしに示された。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 1:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p3.b5": {
    "text": "これらは何をするために来たのですか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 1:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p3.b6": {
    "text": "これらの角はユダを散らして、人にその頭をあげさせなかったものですが、この四人の者が来たのは彼らをおどし",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 1:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p3.b7": {
    "text": "かのユダの地にむかって角をあげ、これを散らした国々の民の角を投げうつためです",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 1:21"
    },
    "adapted": false,
    "status": "approved"
  }
}
