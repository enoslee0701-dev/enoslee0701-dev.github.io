{
  "ezekiel.22.p1.b1": {
    "text": "人の子よ、あなたはさばくのか。血を流すこの町をさばくのか。それならこの町にそのもろもろの憎むべき事を示して",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 22:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.22.p1.b2": {
    "text": "父母はあなたのうちで卑しめられ、寄留者はあなたのうちで虐待をうけ、みなしごと、やもめとはあなたのうちで悩まされている。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 22:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.22.p1.b3": {
    "text": "あなたは利息と高利とを取り、しえたげによって、あなたの隣り人のものをかすめ、そしてわたしを忘れてしまった",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 22:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.22.p1.b4": {
    "text": "それゆえ見よ、あなたが得た不正の利の事、およびあなたのうちにある流血の事に対して、わたしは手を打ちならす。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 22:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.22.p1.b5": {
    "text": "わたしはあなたを、もろもろの国民のうちに散らし、国々の間にまき",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 22:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.22.p2.b1": {
    "text": "人の子よ、イスラエルの家はわたしに対して、かなかすとなった。彼らはすべて炉の中の銀、青銅、すず、鉄、鉛のかなかすとなった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 22:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.22.p2.b2": {
    "text": "すなわち、わたしはあなたがたを集め、わたしの怒りの火を、あなたがたに吹きかける。あなたがたはその中で溶ける。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 22:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.22.p2.b3": {
    "text": "その中の君たちは、獲物を裂くほえるししのような者で",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 22:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.22.p2.b4": {
    "text": "その祭司たちはわが律法を犯し … わが安息日を無視し",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 22:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.22.p2.b5": {
    "text": "その中にいる君たちは、獲物を裂くおおかみのようで",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 22:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.22.p2.b6": {
    "text": "わたしは、国のために石がきを築き、わたしの前にあって、破れ口に立ち、わたしにこれを滅ぼさせないようにする者を、彼らのうちに尋ねたが得られなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 22:30"
    },
    "adapted": false,
    "status": "approved"
  }
}
