{
  "judges.4.p1.b1": {
    "text": "에훗의 죽은 후에 이스라엘 자손이 또 여호와의 목전에 악을 행하매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 4:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p1.b2": {
    "text": "여호와께서 하솔에 도읍한 가나안 왕 야빈의 손에 그들을 파셨는데 그 군대장관은 이방 하로셋에 거하는 시스라요",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 4:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p1.b3": {
    "text": "야빈 왕은 철병거 구백승이 있어서 이십년 동안 이스라엘 자손을 심히 학대한 고로",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 4:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p1.b4": {
    "text": "이스라엘 자손이 여호와께 부르짖었더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 4:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p2.b5": {
    "text": "그 때에 랍비돗의 아내 여선지 드보라가 이스라엘의 사사가 되었는데",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 4:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p2.b6": {
    "text": "그는 에브라임 산지 라마와 벧엘 사이 드보라의 종려나무 아래 거하였고 이스라엘 자손은 그에게 나아가 재판을 받더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 4:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p2.b7": {
    "text": "드보라가 보내어 아비노암의 아들 바락을 납달리 게데스에서 불러다가",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 4:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p2.b8": {
    "text": "이스라엘 하나님 여호와께서 이같이 명하지 아니하셨느냐 이르시기를 너는 납달리 자손과 스불론 자손 일만명을 거느리고 다볼산으로 가라 … 그를 네 손에 붙이리라 하셨느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 4:6-7"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p3.b9": {
    "text": "당신이 나와 함께 가면 내가 가려니와 당신이 나와 함께 가지 아니하면 나는 가지 않겠노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 4:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p3.b10": {
    "text": "내가 반드시 너와 함께 가리라 그러나 네가 이제 가는 일로는 영광을 얻지 못하리니 이는 여호와께서 시스라를 여인의 손에 파실 것임이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 4:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p3.b11": {
    "text": "드보라가 일어나 바락과 함께 게데스로 가니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 4:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p3.b12": {
    "text": "바락이 스불론과 납달리를 게데스로 부르니 일만 인이 그를 따라 올라가고 드보라도 그와 함께 올라가니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 4:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p4.b13": {
    "text": "모세의 장인 호밥의 자손 중 겐 사람 헤벨이 자기 족속을 떠나 게데스에 가까운 사아난님 상수리나무 곁에 이르러 장막을 쳤더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 4:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p4.b14": {
    "text": "아비노암의 아들 바락이 다볼산에 오른 것을",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 4:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p4.b15": {
    "text": "시스라가 모든 병거 곧 철병거 구백승과 자기와 함께 있는 온 군사를 이방 하로셋에서부터 기손강으로 모은지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 4:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p5.b16": {
    "text": "일어나라 이는 여호와께서 시스라를 네 손에 붙이신 날이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 4:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p5.b17": {
    "text": "여호와께서 너의 앞서 행하지 아니하시느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 4:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p5.b18": {
    "text": "이에 바락이 일만명을 거느리고 다볼산에서 내려가니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 4:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p6.b19": {
    "text": "여호와께서 바락의 앞에서 시스라와 그 모든 병거와 그 온 군대를 칼날로 쳐서 패하게 하시매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 4:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p6.b20": {
    "text": "시스라가 병거에서 내려 도보로 도망한지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 4:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p6.b21": {
    "text": "바락이 그 병거들과 군대를 추격하여 이방 하로셋에 이르니 시스라의 온 군대가 다 칼에 엎드러졌고 남은 자가 없었더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 4:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p7.b22": {
    "text": "시스라가 도보로 도망하여 겐사람 헤벨의 아내 야엘의 장막에 이르렀으니 하솔 왕 야빈은 겐 사람 헤벨의 집과 화평이 있음이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 4:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p7.b23": {
    "text": "나의 주여 들어오소서 내게로 들어오시고 두려워하지 마소서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 4:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p7.b24": {
    "text": "청하노니 내게 물을 조금 마시우라 내가 목이 마르도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 4:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p7.b25": {
    "text": "젖 부대를 열어 그에게 마시우고 그를 덮으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 4:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p8.b26": {
    "text": "장막문에 섰다가 만일 사람이 와서 네게 묻기를 여기 어떤 사람이 있느냐 하거든 너는 없다 하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 4:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p8.b27": {
    "text": "그가 곤비하여 깊이 잠든지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 4:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p8.b28": {
    "text": "헤벨의 아내 야엘이 장막 말뚝을 취하고 손에 방망이를 들고 그에게로 가만히 가서 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 4:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p8.b29": {
    "text": "시스라가 기절하여 죽으니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 4:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p9.b30": {
    "text": "오라 내가 너의 찾는 사람을 네게 보이리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 4:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p9.b31": {
    "text": "바락이 그에게 들어가 보니 시스라가 죽어 누웠고 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 4:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "judges.4.p9.b32": {
    "text": "이와 같이 이 날에 하나님이 가나안 왕 야빈을 이스라엘 자손 앞에 패하게 하신지라 이스라엘 자손의 손이 가나안 왕 야빈을 점점 더 이기어서 마침내 가나안 왕 야빈을 진멸하였더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Judges 4:23-24"
    },
    "adapted": false,
    "status": "approved"
  }
}
