{
  "joshua.12.p1.b1": {
    "text": "さてヨルダンの向こう側、日の出の方で、アルノンの谷からヘルモン山まで、および東アラバの全土のうちで、イスラエルの人々が撃ち滅ぼして地を取った国の王たちは、次のとおりである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 12:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.12.p1.b2": {
    "text": "まず、アモリびとの王シホン。彼はヘシボンに住み、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 12:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.12.p1.b3": {
    "text": "次にレパイムの生き残りのひとりであったバシャンの王オグ。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 12:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.12.p1.b4": {
    "text": "…主のしもべモーセは、これらの地を、ルベンびと、ガドびと、およびマナセの半部族に与えて所有とさせた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 12:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.12.p2.b1": {
    "text": "…ヨシュアと、イスラエルの人々とが、撃ち滅ぼした国の王たちは、次のとおりである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 12:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.12.p2.b2": {
    "text": "エリコの王ひとり。ベテルのほとりのアイの王ひとり。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 12:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.12.p2.b3": {
    "text": "エルサレムの王ひとり。ヘブロンの王ひとり。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 12:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.12.p2.b4": {
    "text": "マッケダの王ひとり。ベテルの王ひとり。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 12:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.12.p3.b1": {
    "text": "マドンの王ひとり。ハゾルの王ひとり。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 12:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.12.p3.b2": {
    "text": "タアナクの王ひとり。メギドの王ひとり。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 12:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.12.p3.b3": {
    "text": "…合わせて三十一王である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 12:24"
    },
    "adapted": false,
    "status": "approved"
  }
}
