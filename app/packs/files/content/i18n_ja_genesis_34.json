{
  "genesis.34.p1.b1": {
    "text": "レアがヤコブに産んだ娘デナはその地の女たちに会おうと出かけて行ったが、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 34:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.34.p1.b2": {
    "text": "その地のつかさ、ヒビびとハモルの子シケムが彼女を見て、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 34:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.34.p1.b3": {
    "text": "…引き入れ、これと寝てはずかしめた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 34:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.34.p1.b4": {
    "text": "彼は深くヤコブの娘デナを慕い、この娘を愛して、ねんごろに娘に語った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 34:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.34.p2.b1": {
    "text": "この娘をわたしの妻にめとってください。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 34:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.34.p2.b2": {
    "text": "さてヤコブはシケムが、娘デナを汚したことを聞いたけれども、…彼らの帰るまで黙っていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 34:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.34.p2.b3": {
    "text": "シケムの父ハモルはヤコブと話し合おうと、ヤコブの所に出てきた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 34:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.34.p2.b4": {
    "text": "ヤコブの子らは野から帰り、この事を聞いて、悲しみ、かつ非常に怒った。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 34:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.34.p3.b1": {
    "text": "わたしの子シケムはあなたがたの娘を心に慕っています。どうか彼女を彼の妻にください。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 34:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.34.p3.b2": {
    "text": "こうしてあなたがたとわたしたちとは一緒に住みましょう。地はあなたがたの前にあります。ここに住んで取引し、ここで財産を獲なさい」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 34:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.34.p3.b3": {
    "text": "たくさんの結納金と贈り物とをお求めになっても、あなたがたの言われるとおりさしあげます。ただこの娘はわたしの妻にください」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 34:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.34.p4.b1": {
    "text": "しかし、ヤコブの子らはシケムが彼らの妹デナを汚したので、シケムとその父ハモルに偽って答え、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 34:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.34.p4.b2": {
    "text": "われわれは割礼を受けない者に妹をやる事はできません。それはわれわれの恥とするところですから。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 34:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.34.p4.b3": {
    "text": "もしあなたがたのうち男子がみな割礼を受けて、われわれのようになるなら、われわれの娘をあなたがたに与え、…一つの民となりましょう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 34:15-16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.34.p4.b4": {
    "text": "けれども、もしあなたがたがわれわれに聞かず、割礼を受けないなら、われわれは娘を連れて行きます」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 34:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.34.p5.b1": {
    "text": "若者は、ためらわずにこの事をした。彼がヤコブの娘を愛したからである。また彼は父の家のうちで一番重んじられた者であった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 34:18-19"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.34.p5.b2": {
    "text": "この人々はわれわれと親しいから、この地に住まわせて、ここで取引をさせよう。地は広く、彼らをいれるにじゅうぶんである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 34:20-22"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.34.p5.b3": {
    "text": "そうすれば彼らの家畜と財産とすべての獣とは、われわれのものとなるではないか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 34:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.34.p5.b4": {
    "text": "そこで町の門に出入りする者はみなハモルとその子シケムとに聞き従って、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 34:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.34.p6.b1": {
    "text": "三日目になって彼らが痛みを覚えている時、ヤコブのふたりの子、すなわちデナの兄弟シメオンとレビとは、おのおのつるぎを取って、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 34:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.34.p6.b2": {
    "text": "…シケムの家からデナを連れ出した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 34:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.34.p6.b3": {
    "text": "そしてヤコブの子らは…町をかすめた。彼らが妹を汚したからである。すなわち羊、牛、ろば…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 34:27-28"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.34.p6.b4": {
    "text": "並びにすべての貨財を奪い、その子女と妻たちを皆とりこにし、家の中にある物をことごとくかすめた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 34:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.34.p7.b1": {
    "text": "あなたがたはわたしをこの地の住民、カナンびととペリジびとに忌みきらわせ、わたしに迷惑をかけた。わたしは、人数が少ないから、彼らが集まってわたしを攻め撃つならば、わたしも家族も滅ぼされるであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 34:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.34.p7.b2": {
    "text": "わたしたちの妹を遊女のように彼が扱ってよいのですか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 34:31"
    },
    "adapted": false,
    "status": "approved"
  }
}
