{
  "matthew.4.p1.b1": {
    "text": "さて、イエスは御霊によって荒野に導かれた。悪魔に試みられるためである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p1.b2": {
    "text": "そして、四十日四十夜、断食をし、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p1.b3": {
    "text": "そののち空腹になられた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p2.b1": {
    "text": "すると試みる者がきて言った、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p2.b2": {
    "text": "「もしあなたが神の子であるなら、これらの石がパンになるように命じてごらんなさい」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p2.b3": {
    "text": "イエスは答えて言われた、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p2.b4": {
    "text": "「『人はパンだけで生きるものではなく、神の口から出る一つ一つの言で生きるものである』と書いてある」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p3.b1": {
    "text": "それから悪魔は、イエスを聖なる都に連れて行き、宮の頂上に立たせて",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p3.b2": {
    "text": "「もしあなたが神の子であるなら、下へ飛びおりてごらんなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p3.b3": {
    "text": "『神はあなたのために御使たちにお命じになると、あなたの足が石に打ちつけられないように、彼らはあなたを手でささえるであろう』と書いてありますから」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p3.b4": {
    "text": "「『主なるあなたの神を試みてはならない』とまた書いてある」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p4.b1": {
    "text": "次に悪魔は、イエスを非常に高い山に連れて行き、この世のすべての国々とその栄華とを見せて",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p4.b2": {
    "text": "「もしあなたが、ひれ伏してわたしを拝むなら、これらのものを皆あなたにあげましょう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p4.b3": {
    "text": "「サタンよ、退け。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p4.b4": {
    "text": "『主なるあなたの神を拝し、ただ神にのみ仕えよ』と書いてある」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p5.b1": {
    "text": "そこで、悪魔はイエスを離れ去り、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p5.b2": {
    "text": "そして、御使たちがみもとにきて仕えた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p5.b3": {
    "text": "さて、イエスはヨハネが捕えられたと聞いて、ガリラヤへ退かれた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p6.b1": {
    "text": "そしてナザレを去り、ゼブルンとナフタリとの地方にある海べの町カペナウムに行って住まわれた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p6.b2": {
    "text": "暗黒の中に住んでいる民は",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p6.b3": {
    "text": "大いなる光を見、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p6.b4": {
    "text": "死の地、死の陰に住んでいる人々に、光がのぼった」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p7.b1": {
    "text": "この時からイエスは教を宣べはじめて言われた、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p7.b2": {
    "text": "「悔い改めよ、天国は近づいた」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p8.b1": {
    "text": "さて、イエスがガリラヤの海べを歩いておられると、ふたりの兄弟、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p8.b2": {
    "text": "すなわち、ペテロと呼ばれたシモンとその兄弟アンデレとが、海に網を打っているのをごらんになった。彼らは漁師であった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p8.b3": {
    "text": "「わたしについてきなさい。あなたがたを、人間をとる漁師にしてあげよう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p8.b4": {
    "text": "すると、彼らはすぐに網を捨てて、イエスに従った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p9.b1": {
    "text": "そこから進んで行かれると、ほかのふたりの兄弟、すなわち、ゼベダイの子ヤコブとその兄弟ヨハネとが、父ゼベダイと一緒に、舟の中で網を繕っているのをごらんになった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p9.b2": {
    "text": "そこで彼らをお招きになると、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p9.b3": {
    "text": "すぐ舟と父とをおいて、イエスに従って行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p10.b1": {
    "text": "イエスはガリラヤの全地を巡り歩いて、諸会堂で教え、御国の福音を宣べ伝え、民の中のあらゆる病気、あらゆるわずらいをおいやしになった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p10.b2": {
    "text": "そこで、その評判はシリヤ全地にひろまり、人々があらゆる病にかかっている者、…をイエスのところに連れてきたので、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p10.b3": {
    "text": "これらの人々をおいやしになった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.4.p10.b4": {
    "text": "こうして、ガリラヤ、デカポリス、エルサレム、ユダヤ及びヨルダンの向こうから、おびただしい群衆がきてイエスに従った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 4:25"
    },
    "adapted": false,
    "status": "approved"
  }
}
