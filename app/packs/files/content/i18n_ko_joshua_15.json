{
  "joshua.15.p1.b1": {
    "text": "유다 자손의 지파가 그 가족대로 제비 뽑은 땅의 극남단은 에돔 지경에 이르고 또 남으로 신 광야까지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Joshua 15:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.15.p1.b2": {
    "text": "그 남편 경계는 염해의 극단 곧 남향한 해만에서부터 아그랍빔 비탈 남편으로 지나 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Joshua 15:2-3"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.15.p1.b3": {
    "text": "또 힌놈의 아들의 골짜기로 올라가서 여부스 곧 예루살렘 남편 어깨에 이르며 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Joshua 15:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.15.p1.b4": {
    "text": "서편 경계는 대해와 그 해변이니 유다 자손이 그 가족대로 얻은 사면 경계가 이러하니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Joshua 15:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.15.p2.b1": {
    "text": "갈렙이 거기서 아낙의 소생 곧 그 세 아들 세새와 아히만과 달매를 쫓아내었고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Joshua 15:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.15.p2.b2": {
    "text": "기럇 세벨을 쳐서 그것을 취하는 자에게는 내가 내 딸 악사를 아내로 주리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Joshua 15:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.15.p2.b3": {
    "text": "갈렙의 아우요 그나스의 아들인 옷니엘이 그것을 취함으로 갈렙이 그 딸 악사를 그에게 아내로 주었더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Joshua 15:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.15.p3.b1": {
    "text": "악사가 출가할 때에 그에게 청하여 자기 아비에게 밭을 구하자 하고 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Joshua 15:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.15.p3.b2": {
    "text": "네가 무엇을 원하느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Joshua 15:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.15.p3.b3": {
    "text": "내게 복을 주소서 아버지께서 나를 남방 땅으로 보내시오니 샘물도 내게 주소서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Joshua 15:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.15.p3.b4": {
    "text": "갈렙이 윗샘과 아랫샘을 그에게 주었더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Joshua 15:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.15.p4.b1": {
    "text": "유다 자손의 지파가 그 가족대로 얻은 기업은 이러하니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Joshua 15:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.15.p4.b2": {
    "text": "광야에는 벧 아라바와 밋딘과 스가가와 닙산과 염성과 엔 게디니 모두 여섯 성읍이요 또 그 촌락이었더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Joshua 15:61-62"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.15.p4.b3": {
    "text": "… 기럇 아르바 곧 헤브론과 시올이니 모두 아홉 성읍이요 또 그 촌락이었으며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Joshua 15:54"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.15.p4.b4": {
    "text": "예루살렘 거민 여부스 사람을 유다 자손이 쫓아내지 못하였으므로 여부스 사람이 오늘날까지 유다 자손과 함께 예루살렘에 거하니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Joshua 15:63"
    },
    "adapted": false,
    "status": "approved"
  }
}
