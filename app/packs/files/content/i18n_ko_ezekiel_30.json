{
  "ezekiel.30.p1.b1": {
    "text": "그 날이 가까왔도다 여호와의 날이 가까왔도다 구름의 날일 것이요 열국의 때이리로다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ezekiel 30:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.30.p1.b2": {
    "text": "내가 그 모든 강을 말리우고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ezekiel 30:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.30.p1.b3": {
    "text": "내가 그 우상들을 멸하며 신상들을 놉 가운데서 끊으며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ezekiel 30:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.30.p1.b4": {
    "text": "드합느헤스에서는 날이 어둡겠고 그 성읍에는 구름이 덮일 것이며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ezekiel 30:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.30.p1.b5": {
    "text": "인자야 내가 애굽 왕 바로의 팔을 꺾었더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ezekiel 30:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.30.p1.b6": {
    "text": "내가 바벨론 왕의 팔을 견고하게 하고 내 칼을 그 손에 붙이려니와",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ezekiel 30:24"
    },
    "adapted": false,
    "status": "approved"
  }
}
