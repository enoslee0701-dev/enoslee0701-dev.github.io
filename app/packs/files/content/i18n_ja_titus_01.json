{
  "titus.1.p1.b1": {
    "text": "神の僕、イエス・キリストの使徒パウロから …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Titus 1:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "titus.1.p1.b2": {
    "text": "信仰を同じうするわたしの真実の子テトスへ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Titus 1:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "titus.1.p1.b3": {
    "text": "父なる神とわたしたちの救主キリスト・イエスから、恵みと平安とが、あなたにあるように。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Titus 1:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "titus.1.p2.b1": {
    "text": "あなたをクレテにおいてきたのは、… そこにし残してあることを整理してもらい、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Titus 1:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "titus.1.p2.b2": {
    "text": "… わたしがあなたに命じておいたように、… 町々に長老を立ててもらうためにほかならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Titus 1:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "titus.1.p2.b3": {
    "text": "長老は、責められる点がなく、ひとりの妻の夫であって、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Titus 1:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "titus.1.p3.b1": {
    "text": "監督たる者は、神に仕える者として、責められる点がなく、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Titus 1:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "titus.1.p3.b2": {
    "text": "かえって、旅人をもてなし、善を愛し、慎み深く、正しく、信仰深く、自制する者であり、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Titus 1:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "titus.1.p3.b3": {
    "text": "教にかなった信頼すべき言葉を守る人でなければならない。それは、彼が健全な教によって人をさとし、また、反対者の誤りを指摘することができるためである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Titus 1:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "titus.1.p4.b1": {
    "text": "実は、法に服さない者、空論に走る者、人の心を惑わす者が多くおり、とくに、割礼のある者の中に多い。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Titus 1:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "titus.1.p4.b2": {
    "text": "彼らの口を封ずべきである。彼らは恥ずべき利のために、… 数々の家庭を破壊してしまっている。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Titus 1:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "titus.1.p4.b3": {
    "text": "クレテ人のうちのある預言者が「クレテ人は、いつもうそつき、たちの悪いけもの、なまけ者の食いしんぼう」と言っているが、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Titus 1:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "titus.1.p5.b1": {
    "text": "この非難はあたっている。だから、彼らをきびしく責めて、その信仰を健全なものにし、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Titus 1:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "titus.1.p5.b2": {
    "text": "きよい人には、すべてのものがきよい。しかし、汚れている不信仰な人には、きよいものは一つもなく、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Titus 1:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "titus.1.p5.b3": {
    "text": "彼らは神を知っていると、口では言うが、行いではそれを否定している。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Titus 1:16"
    },
    "adapted": false,
    "status": "approved"
  }
}
