{
  "samuel2.9.p1.b1": {
    "text": "「サウルの家の人で、なお残っている者があるか。わたしはヨナタンのために、その人に恵みを施そう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 9:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p1.b2": {
    "text": "「しもべがそうです」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 9:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p1.b3": {
    "text": "「ヨナタンの子がまだおります。あしなえです」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 9:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p1.b4": {
    "text": "「その人はどこにいるのか」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 9:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p2.b1": {
    "text": "「彼はロ・デバルのアンミエルの子マキルの家におります」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 9:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p2.b2": {
    "text": "ダビデ王は人をつかわして、ロ・デバルのアンミエルの子マキルの家から、彼を連れてこさせた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 9:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p2.b3": {
    "text": "ダビデが、「メピボセテよ」と言ったので、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 9:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p2.b4": {
    "text": "彼は、「しもべは、ここにおります」と答えた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 9:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p3.b1": {
    "text": "「恐れることはない。わたしはかならずあなたの父ヨナタンのためにあなたに恵みを施しましょう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 9:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p3.b2": {
    "text": "あなたの父サウルの地をみなあなたに返します。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 9:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p3.b3": {
    "text": "またあなたは常にわたしの食卓で食事をしなさい」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 9:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p3.b4": {
    "text": "「あなたは、しもべを何とおぼしめして、死んだ犬のようなわたしを顧みられるのですか」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 9:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p4.b1": {
    "text": "「すべてサウルとその家に属する物を皆、わたしはあなたの主人の子に与えた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 9:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p4.b2": {
    "text": "ヂバには十五人の男の子と二十人のしもべがあった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 9:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p4.b3": {
    "text": "「すべて王わが主君がしもべに命じられるとおりに、しもべはいたしましょう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 9:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p4.b4": {
    "text": "こうしてメピボセテは王の子のひとりのようにダビデの食卓で食事をした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 9:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p5.b1": {
    "text": "メピボセテはエルサレムに住んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 9:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p5.b2": {
    "text": "彼がいつも王の食卓で食事をしたからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 9:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p5.b3": {
    "text": "彼は両足ともに、なえていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 9:13"
    },
    "adapted": false,
    "status": "approved"
  }
}
