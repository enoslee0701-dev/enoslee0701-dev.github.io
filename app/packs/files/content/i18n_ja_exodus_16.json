{
  "exodus.16.p1.b1": {
    "text": "イスラエルの人々の全会衆はエリムを出発し、エジプトの地を出て二か月目の十五日に、エリムとシナイとの間にあるシンの荒野にきたが、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 16:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.16.p1.b2": {
    "text": "われわれはエジプトの地で…主の手にかかって死んでいたら良かった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 16:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.16.p1.b3": {
    "text": "肉のなべのかたわらに座し、飽きるほどパンを食べていた時に、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 16:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.16.p1.b4": {
    "text": "あなたがたは、われわれをこの荒野に導き出して、全会衆を餓死させようとしている",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 16:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.16.p2.b5": {
    "text": "見よ、わたしはあなたがたのために、天からパンを降らせよう。民は出て日々の分を日ごとに集めなければならない。こうして彼らがわたしの律法に従うかどうかを試みよう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 16:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.16.p2.b6": {
    "text": "夕暮には、あなたがたは、エジプトの地からあなたがたを導き出されたのが、主であることを知るであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 16:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.16.p2.b7": {
    "text": "いったいわれわれは何者なのか。あなたがたのつぶやくのは、われわれにむかってでなく、主にむかってである",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 16:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.16.p3.b8": {
    "text": "イスラエルの人々の全会衆に言いなさい、『あなたがたは主の前に近づきなさい。主があなたがたのつぶやきを聞かれたからである』",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 16:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.16.p3.b9": {
    "text": "それでアロンがイスラエルの人々の全会衆に語ったとき、彼らが荒野の方を望むと、見よ、主の栄光が雲のうちに現れていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 16:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.16.p3.b10": {
    "text": "彼らに言いなさい、『あなたがたは夕には肉を食べ、朝にはパンに飽き足りるであろう。そうしてわたしがあなたがたの神、主であることを知るであろう』",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 16:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.16.p4.b11": {
    "text": "夕べになると、うずらが飛んできて宿営をおおった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 16:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.16.p4.b12": {
    "text": "その降りた露がかわくと、荒野の面には、薄いうろこのようなものがあり、ちょうど地に結ぶ薄い霜のようであった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 16:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.16.p4.b13": {
    "text": "これはなんであろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 16:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.16.p4.b14": {
    "text": "これは主があなたがたの食物として賜わるパンである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 16:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.16.p5.b15": {
    "text": "イスラエルの人々はそのようにして、ある者は多く、ある者は少なく集めた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 16:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.16.p5.b16": {
    "text": "オメルでそれを計ってみると、多く集めた者にも余らず、少なく集めた者にも不足しなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 16:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.16.p5.b17": {
    "text": "だれも朝までそれを残しておいてはならない",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 16:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.16.p5.b18": {
    "text": "ある者は朝までそれを残しておいたが、虫がついて臭くなった。モーセは彼らにむかって怒った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 16:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.16.p6.b19": {
    "text": "六日目には、彼らは二倍のパン、すなわちひとりに二オメルを集めた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 16:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.16.p6.b20": {
    "text": "主の語られたのはこうである、『あすは主の聖安息日で休みである。きょう、焼こうとするものを焼き、煮ようとするものを煮なさい。残ったものはみな朝までたくわえて保存しなさい』",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 16:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.16.p6.b21": {
    "text": "彼らはモーセの命じたように、それを朝まで保存したが、臭くならず、また虫もつかなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 16:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.16.p6.b22": {
    "text": "六日の間はそれを集めなければならない。七日目は安息日であるから、その日には無いであろう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 16:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.16.p7.b23": {
    "text": "ところが民のうちには、七日目に出て集めようとした者があったが、獲られなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 16:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.16.p7.b24": {
    "text": "あなたがたは、いつまでわたしの戒めと、律法とを守ることを拒むのか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 16:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.16.p7.b25": {
    "text": "こうして民は七日目に休んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 16:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.16.p8.b26": {
    "text": "イスラエルの家はその物の名をマナと呼んだ。それはコエンドロの実のようで白く、その味は蜜を入れたせんべいのようであった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 16:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.16.p8.b27": {
    "text": "一つのつぼを取り、マナ一オメルをその中に入れ、それを主の前に置いて、子孫のためにたくわえなさい",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 16:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.16.p8.b28": {
    "text": "主がモーセに命じられたように、アロンは…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 16:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.16.p8.b29": {
    "text": "イスラエルの人々は人の住む地に着くまで四十年の間マナを食べた。すなわち、彼らはカナンの地の境に至るまでマナを食べた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 16:35"
    },
    "adapted": false,
    "status": "approved"
  }
}
