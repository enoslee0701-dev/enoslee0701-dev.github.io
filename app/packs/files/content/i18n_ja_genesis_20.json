{
  "genesis.20.p1.b1": {
    "text": "アブラハムはそこからネゲブの地に移って、カデシとシュルの間に住んだ。彼がゲラルにとどまっていた時、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 20:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p1.b2": {
    "text": "アブラハムは妻サラのことを、「これはわたしの妹です」と言ったので、ゲラルの王アビメレクは、人をつかわしてサラを召し入れた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 20:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p1.b3": {
    "text": "あなたは召し入れたあの女のゆえに死なねばならない。彼女は夫のある身である",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 20:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p2.b4": {
    "text": "主よ、あなたは正しい民でも殺されるのですか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 20:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p2.b5": {
    "text": "わたしは心も清く、手もいさぎよく、このことをしました",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 20:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p2.b6": {
    "text": "そうです、あなたが清い心をもってこのことをしたのを知っていたから、わたしもあなたを守って、わたしに対して罪を犯させず、彼女にふれることを許さなかったのです。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 20:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p2.b7": {
    "text": "いま彼の妻を返しなさい。彼は預言者ですから、あなたのために祈って、命を保たせるでしょう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 20:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p3.b8": {
    "text": "そこでアビメレクは朝早く起き、しもべたちをことごとく召し集めて、これらの事をみな語り聞かせたので、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 20:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p3.b9": {
    "text": "人々は非常に恐れた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 20:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p3.b10": {
    "text": "あなたはわれわれに何をするのですか。… あなたはしてはならぬことをわたしにしたのです",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 20:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p3.b11": {
    "text": "あなたはなんと思って、この事をしたのですか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 20:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p4.b12": {
    "text": "この所には神を恐れるということが、まったくないので、わたしの妻のゆえに人々がわたしを殺すと思ったからです。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 20:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p4.b13": {
    "text": "また彼女はほんとうにわたしの妹なのです。わたしの父の娘ですが、母の娘ではありません。そして、わたしの妻になったのです。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 20:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p4.b14": {
    "text": "神がわたしに父の家を離れて、行き巡らせた時、わたしは彼女に、あなたはわたしたちの行くさきざきでわたしを兄であると言ってください。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 20:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p5.b15": {
    "text": "そこでアビメレクは羊、牛および男女の奴隷を取ってアブラハムに与え、その妻サラを彼に返した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 20:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p5.b16": {
    "text": "わたしの地はあなたの前にあります。あなたの好きな所に住みなさい …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 20:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p5.b17": {
    "text": "わたしはあなたの兄に銀千シケルを与えました。これはあなたの身に起ったすべての事について、あなたに償いをするものです。こうしてすべての人にあなたは正しいと認められます",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 20:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p5.b18": {
    "text": "そこでアブラハムは神に祈った。神はアビメレクとその妻および、はしためたちをいやされたので、彼らは子を産むようになった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 20:17"
    },
    "adapted": false,
    "status": "approved"
  }
}
