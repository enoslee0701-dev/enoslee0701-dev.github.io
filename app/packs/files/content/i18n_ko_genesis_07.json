{
  "genesis.7.p1.b1": {
    "text": "너와 네 온 집은 방주로 들어가라 네가 이 세대에 내 앞에서 의로움을 내가 보았음이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 7:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p1.b2": {
    "text": "너는 모든 정결한 짐승은 암수 일곱씩 부정한 것은 암수 둘씩을 네게로 취하며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 7:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p1.b3": {
    "text": "지금부터 칠일이면 내가 사십 주야를 땅에 비를 내려 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 7:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p1.b4": {
    "text": "노아가 여호와께서 자기에게 명하신대로 다 준행하였더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 7:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p2.b5": {
    "text": "홍수가 땅에 있을 때에 노아가 육백세라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 7:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p2.b6": {
    "text": "암수 둘씩 노아에게 나아와 방주로 들어갔더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 7:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p2.b7": {
    "text": "새와 땅에 기는 모든 것이",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 7:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p3.b8": {
    "text": "칠일 후에 홍수가 땅에 덮이니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 7:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p3.b9": {
    "text": "노아 육백 세되던 해 이월 곧 그 달 십칠일이라 그날에 큰 깊음의 샘들이 터지며 하늘의 창들이 열려",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 7:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p3.b10": {
    "text": "사십 주야를 비가 땅에 쏟아졌더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 7:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p4.b11": {
    "text": "곧 그 날에 노아와 그의 아들 셈, 함, 야벳과 노아의 처와 세 자부가 다 방주로 들어갔고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 7:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p4.b12": {
    "text": "무릇 기식이 있는 육체가 둘씩 노아에게 나아와 방주로 들어갔으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 7:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p5.b13": {
    "text": "들어간 것들은 모든 것의 암수라 하나님이 그에게 명하신대로 들어가매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 7:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p5.b14": {
    "text": "여호와께서 그를 닫아 넣으시니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 7:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p6.b15": {
    "text": "홍수가 땅에 사십일을 있었는지라 물이 많아져 방주가 땅에서 떠올랐고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 7:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p6.b16": {
    "text": "물이 더 많아져 땅에 창일하매 방주가 물 위에 떠 다녔으며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 7:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p6.b17": {
    "text": "천하에 높은 산이 다 덮였더니 물이 불어서 십오 규빗이 오르매 산들이 덮인지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 7:19-20"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p7.b18": {
    "text": "땅 위에 움직이는 생물이 다 죽었으니 곧 새와 육축과 들짐승과 땅에 기는 모든 것과 모든 사람이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 7:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p7.b19": {
    "text": "육지에 있어 코로 생물의 기식을 호흡하는 것은 다 죽었더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 7:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p8.b20": {
    "text": "지면의 모든 생물을 쓸어 버리시니 … 홀로 노아와 그와 함께 방주에 있던 자만 남았더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 7:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.7.p8.b21": {
    "text": "물이 일백 오십일을 땅에 창일하였더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 7:24"
    },
    "adapted": false,
    "status": "approved"
  }
}
