{
  "zechariah.1.p1.b1": {
    "text": "다리오 왕 이년 팔월에",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Zechariah 1:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p1.b2": {
    "text": "여호와의 말씀이 잇도의 손자 베레갸의 아들 선지자 스가랴에게 임하니라 가라사대",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Zechariah 1:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p1.b3": {
    "text": "나 여호와가 무리의 열조에게 심히 진노하였느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Zechariah 1:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p1.b4": {
    "text": "너희는 내게로 돌아오라 … 그리하면 내가 너희에게로 돌아가리라 나 만군의 여호와의 말이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Zechariah 1:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p1.b5": {
    "text": "옛적 선지자들이 그들에게 외쳐 가로되 … 너희가 악한 길, 악한 행실을 떠나서 돌아오라 하셨다 하나 그들이 듣지 않고 내게 귀를 기울이지 아니하였느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Zechariah 1:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p1.b6": {
    "text": "너희 열조가 어디 있느냐 선지자들이 영원히 살겠느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Zechariah 1:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p1.b7": {
    "text": "내가 종 선지자들에게 명한 내 말과 내 전례들이 어찌 네 열조에게 임하지 아니하였느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Zechariah 1:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p1.b8": {
    "text": "만군의 여호와께서 우리 길대로 우리 행위대로 우리에게 행하시려고 뜻 하신 것을 우리에게 행하셨도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Zechariah 1:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p2.b1": {
    "text": "다리오왕 이년 십일월 곧 스밧월 이십 사일에",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Zechariah 1:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p2.b2": {
    "text": "내가 밤에 보니 사람이 홍마를 타고 골짜기 속 화석류나무 사이에 섰고 그 뒤에는 홍마와 자마와 백마가 있기로",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Zechariah 1:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p2.b3": {
    "text": "내 주여 이들이 무엇이니이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Zechariah 1:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p2.b4": {
    "text": "우리가 땅에 두루 다녀보니 온 땅이 평안하여 정온하더이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Zechariah 1:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p2.b5": {
    "text": "만군의 여호와여 여호와께서 언제까지 예루살렘과 유다 성읍들을 긍휼히 여기지 아니하시려나이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Zechariah 1:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p2.b6": {
    "text": "내가 긍휼히 여기므로 예루 살렘에 돌아왔은즉 내 집이 그 가운데 건축되리니 예루살렘 위에먹줄이 치어지리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Zechariah 1:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p2.b7": {
    "text": "나의 성읍들이 넘치도록 다시 풍부할 것이라 여호와가 다시 시온을 안위하여 다시 예루살렘을 택하리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Zechariah 1:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p3.b1": {
    "text": "내가 눈을 들어 본즉 네 뿔이 보이기로",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Zechariah 1:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p3.b2": {
    "text": "이들이 무엇이니이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Zechariah 1:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p3.b3": {
    "text": "이들은 유다와 이스라엘과 예루살렘을 헤친 뿔이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Zechariah 1:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p3.b4": {
    "text": "때에 여호와께서 공장 네 명을 내게 보이시기로",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Zechariah 1:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p3.b5": {
    "text": "그들이 무엇하러 왔나이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Zechariah 1:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p3.b6": {
    "text": "그 뿔들이 유다를 헤쳐서 사람으로 능히 머리를 들지 못하게 하매 이 공장들이 와서 그것들을 두렵게 하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Zechariah 1:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.1.p3.b7": {
    "text": "이전에 뿔들을 들어 유다 땅을 헤친 열국의 뿔을 떨어치려 하느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Zechariah 1:21"
    },
    "adapted": false,
    "status": "approved"
  }
}
