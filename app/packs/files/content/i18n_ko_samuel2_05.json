{
  "samuel2.5.p1.b1": {
    "text": "보소서 우리는 왕의 골육이니이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 5:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p1.b2": {
    "text": "여호와께서도 왕에게 말씀하시기를 네가 내 백성 이스라엘의 목자가 되며 이스라엘의 주권자가 되리라 하셨나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 5:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p1.b3": {
    "text": "이에 이스라엘 모든 장로가 헤브론에 이르러 왕에게 나아오매 … 저희가 다윗에게 기름을 부어 이스라엘 왕을 삼으니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 5:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p1.b4": {
    "text": "다윗이 삼십세에 위에 나아가서 사십년을 다스렸으되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 5:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p2.b1": {
    "text": "왕과 그 종자들이 예루살렘으로 가서 그 땅 거민 여부스 사람을 치려 하매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 5:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p2.b2": {
    "text": "네가 이리로 들어오지 못하리라 소경과 절뚝발이라도 너를 물리치리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 5:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p2.b3": {
    "text": "누구든지 여부스 사람을 치거든 수구로 올라가서 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 5:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p3.b1": {
    "text": "다윗이 시온 산성을 빼앗았으니 이는 다윗 성이더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 5:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p3.b2": {
    "text": "만군의 하나님 여호와께서 함께 계시니 다윗이 점점 강성하여 가니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 5:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p4.b1": {
    "text": "두로 왕 히람이 다윗에게 사자들과 백향목과 목수와 석수를 보내매 저희가 다윗을 위하여 집을 지으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 5:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p4.b2": {
    "text": "다윗이 여호와께서 자기를 세우사 이스라엘 왕을 삼으신 것과 그 백성 이스라엘을 위하여 그 나라를 높이신 것을 아니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 5:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p5.b1": {
    "text": "다윗이 헤브론에서 올라온 후에 예루살렘에서 처첩들을 더 취하였으므로 아들과 딸들이 또 다윗에게서 나니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 5:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p5.b2": {
    "text": "예루살렘에서 그에게서 난 자의 이름은 삼무아와 소밥과 나단과 솔로몬과",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 5:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p6.b1": {
    "text": "이스라엘이 다윗에게 기름을 부어 이스라엘 왕을 삼았다 함을 블레셋 사람이 듣고 다윗을 찾으러 다 올라오매 … 르바임 골짜기에 편만한지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 5:17-18"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p6.b2": {
    "text": "내가 블레셋 사람에게로 올라가리이까 여호와께서 저희를 내 손에 붙이시겠나이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 5:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p6.b3": {
    "text": "올라가라 내가 단정코 블레셋 사람을 네 손에 붙이리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 5:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p6.b4": {
    "text": "여호와께서 물을 흩음같이 내 앞에서 내 대적을 흩으셨다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 5:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p7.b1": {
    "text": "블레셋 사람이 다시 올라와서 르바임 골짜기에 편만한지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 5:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p7.b2": {
    "text": "올라가지 말고 저희 뒤로 돌아서 뽕나무 수풀 맞은편에서 저희를 엄습하되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 5:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p7.b3": {
    "text": "뽕나무 꼭대기에서 걸음 걷는 소리가 들리거든 곧 동작하라 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 5:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.5.p7.b4": {
    "text": "이에 다윗이 여호와의 명대로 행하여 블레셋 사람을 쳐서 게바에서 게셀까지 이르니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "2 Samuel 5:25"
    },
    "adapted": false,
    "status": "approved"
  }
}
