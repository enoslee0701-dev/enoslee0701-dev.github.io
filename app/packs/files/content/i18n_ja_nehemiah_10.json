{
  "nehemiah.10.p1.b1": {
    "text": "印を押した者はハカリヤの子である総督ネヘミヤ、およびゼデキヤ、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 10:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.10.p1.b2": {
    "text": "セラヤ、アザリヤ、エレミヤ、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 10:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.10.p1.b3": {
    "text": "レビびとではアザニヤの子エシュア、ヘナダデの子らのうちのビンヌイ、カデミエル、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 10:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.10.p1.b4": {
    "text": "民のかしらではパロシ、パハテ・モアブ、エラム、ザット、バニ、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 10:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.10.p2.b1": {
    "text": "その他の民、祭司、レビびと、門を守る者、歌うたう者、宮に仕えるしもべ、…およびその妻、むすこ、娘などすべて知識と悟りのある者は、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 10:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.10.p2.b2": {
    "text": "…神のしもべモーセによって授けられた神の律法に歩み、われわれの主、主のすべての戒めと、おきてと、定めとを守り行うために、のろいと誓いとに加わった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 10:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.10.p3.b1": {
    "text": "われわれはこの地の民らにわれわれの娘を与えず、われわれのむすこに彼らの娘をめとらない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 10:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.10.p3.b2": {
    "text": "また七年ごとに耕作をやめ、すべての負債をゆるす。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 10:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.10.p3.b3": {
    "text": "またこの地の民らがたとい品物または穀物を安息日に携えて来て売ろうとしても、われわれは安息日または聖日にはそれを買わない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 10:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.10.p3.b4": {
    "text": "われわれはまたみずから規定を設けて、われわれの神の宮の用のために年々シケルの三分の一を出し、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 10:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.10.p4.b1": {
    "text": "またわれわれ祭司、レビびとおよび民はくじを引いて、…年々定められた時に氏族にしたがって、われわれの神の宮に納める者を定めた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 10:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.10.p4.b2": {
    "text": "またわれわれの土地の初なり、および各種の木の実の初なりを、年々主の宮に携えてくることを誓い、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 10:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.10.p4.b3": {
    "text": "レビびとが十分の一を受ける時には、アロンの子孫である祭司が、そのレビびとと共にいなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 10:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.10.p4.b4": {
    "text": "…聖所の器物および勤めをする祭司、門衛、歌うたう者たちのいるへやにこれを納めなければならない。こうしてわれわれは、われわれの神の宮をなおざりにしない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 10:39"
    },
    "adapted": false,
    "status": "approved"
  }
}
