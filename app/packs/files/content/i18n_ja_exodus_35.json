{
  "exodus.35.p1.b1": {
    "text": "… これは主が行えと命じられた言葉である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 35:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.35.p1.b2": {
    "text": "六日の間は仕事をしなさい。七日目はあなたがたの聖日で、主の全き休みの安息日であるから、 …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 35:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.35.p1.b3": {
    "text": "安息日にはあなたがたのすまいのどこでも火をたいてはならない",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 35:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.35.p2.b4": {
    "text": "… すべて、心から喜んでする者は、主にささげる物を持ってきなさい。すなわち金、銀、青銅。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 35:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.35.p2.b5": {
    "text": "すべてあなたがたのうち、心に知恵ある者はきて、主の命じられたものをみな造りなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 35:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.35.p3.b6": {
    "text": "イスラエルの人々の全会衆はモーセの前を去り、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 35:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.35.p3.b7": {
    "text": "すべて心に感じた者、すべて心から喜んでする者は、会見の幕屋の作業と、そのもろもろの奉仕と、聖なる服とのために、主にささげる物を携えてきた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 35:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.35.p3.b8": {
    "text": "すなわち、すべて心から喜んでする男女は、鼻輪、耳輪、指輪、首飾り、およびすべての金の飾りを携えてきた。 …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 35:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.35.p3.b9": {
    "text": "すべて銀、青銅のささげ物をささげることのできる者は、それを主にささげる物として携えてきた。 …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 35:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.35.p4.b10": {
    "text": "また、すべて心に知恵ある女たちは、その手をもって紡ぎ、その紡いだ青糸、紫糸、緋糸、亜麻糸を携えてきた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 35:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.35.p4.b11": {
    "text": "すべて知恵があって、心に感じた女たちは、やぎの毛を紡いだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 35:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.35.p4.b12": {
    "text": "このようにイスラエルの人々は自発のささげ物を主に携えてきた。すなわち主がモーセによって、なせと命じられたすべての工作のために、物を携えてこようと、心から喜んでする男女はみな、そのようにした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 35:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.35.p5.b13": {
    "text": "… 見よ、主はユダの部族に属するホルの子なるウリの子ベザレルを名ざして召し、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 35:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.35.p5.b14": {
    "text": "彼に神の霊を満たして、知恵と悟りと知識と諸種の工作に長ぜしめ、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 35:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.35.p5.b15": {
    "text": "また人を教えうる力を、彼の心に授けられた。彼とダンの部族に属するアヒサマクの子アホリアブとが、それである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 35:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.35.p5.b16": {
    "text": "… 工夫を凝らして巧みなわざをさせられた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 35:35"
    },
    "adapted": false,
    "status": "approved"
  }
}
