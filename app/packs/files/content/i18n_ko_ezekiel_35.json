{
  "ezekiel.35.p1.b1": {
    "text": "인자야 네 얼굴을 세일산으로 향하고 그를 쳐서 예언하여",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ezekiel 35:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.35.p1.b2": {
    "text": "이 두 민족과 이 두 땅은 다 내게로 돌아와서 내 기업이 되리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ezekiel 35:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.35.p1.b3": {
    "text": "저 산들이 황무하였으니 우리에게 붙이워서 삼키게 되었다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ezekiel 35:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.35.p1.b4": {
    "text": "세일산아 내가 너를 대적하여 내 손을 네 위에 펴서 너로 황무지와 놀라움이 되게 할지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ezekiel 35:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.35.p1.b5": {
    "text": "온 땅이 즐거워할 때에 내가 너를 황무케 하되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ezekiel 35:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.35.p1.b6": {
    "text": "이스라엘 족속의 기업이 황무함을 인하여 네가 즐거워한 것 같이 내가 너로 황무케 하리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ezekiel 35:15"
    },
    "adapted": false,
    "status": "approved"
  }
}
