{
  "amos.6.p1.b1": {
    "text": "「わざわいなるかな、安らかにシオンにいる者、また安心してサマリヤの山にいる者、諸国民のかしらのうちの著名な人々で、イスラエルの家がきて従う者よ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Amos 6:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.6.p1.b2": {
    "text": "みずから象牙の寝台に伏し、長いすの上に身を伸ばし、…鉢をもって酒を飲み、いとも尊い油を身にぬり、ヨセフの破滅を悲しまない者たちよ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Amos 6:4-6"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.6.p1.b3": {
    "text": "それゆえ今、彼らは捕われて、捕われ人のまっ先に立って行く。そしてかの身を伸ばした者どもの騒ぎはやむであろう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Amos 6:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.6.p1.b4": {
    "text": "「声を出すな、主の名をとなえるな」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Amos 6:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.6.p1.b5": {
    "text": "馬は岩の上を走るだろうか。人は牛で海を耕すだろうか。ところがあなたがたは公道を毒に変じ、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Amos 6:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.6.p1.b6": {
    "text": "「われわれは自分の力でカルナイムを得たではないか」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Amos 6:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "amos.6.p1.b7": {
    "text": "「イスラエルの家よ、見よ、わたしは一つの国民を起して、あなたがたに敵対させる。彼らはハマテの入口からアラバの川まであなたがたを悩ます」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Amos 6:14"
    },
    "adapted": false,
    "status": "approved"
  }
}
