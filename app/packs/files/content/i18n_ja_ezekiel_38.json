{
  "ezekiel.38.p1.b1": {
    "text": "人の子よ、メセクとトバルの大君であるマゴグの地のゴグに、あなたの顔を向け、これに対して預言して",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 38:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.38.p1.b2": {
    "text": "……ゴグよ、見よ、わたしはあなたの敵となる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 38:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.38.p1.b3": {
    "text": "あなたはそのすべての軍隊および多くの民を率いて上り、暴風のように進み、雲のように地をおおう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 38:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.38.p1.b4": {
    "text": "……その人々は国々から導き出されて、みな安らかに住んでいる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 38:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.38.p1.b5": {
    "text": "わたしは無防備の村々の地に上り、穏やかにして安らかに住む民、すべて石がきもなく、貫の木も門もない地に住む者どもを攻めよう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 38:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.38.p2.b1": {
    "text": "あなたはわが民イスラエルに攻めのぼり、雲のように地をおおう。ゴグよ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 38:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.38.p2.b2": {
    "text": "その日には必ずイスラエルの地に、大いなる震動があり",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 38:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.38.p2.b3": {
    "text": "また山々はくずれ、がけは落ち、すべての石がきは地に倒れる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 38:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.38.p2.b4": {
    "text": "わたしはみなぎる雨と、ひょうと、火と、硫黄とを、彼とその軍隊……の上に降らせる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 38:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.38.p2.b5": {
    "text": "そしてわたしはわたしの大いなることと、わたしの聖なることとを、多くの国民の目に示す。そして彼らはわたしが主であることを悟る。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 38:23"
    },
    "adapted": false,
    "status": "approved"
  }
}
