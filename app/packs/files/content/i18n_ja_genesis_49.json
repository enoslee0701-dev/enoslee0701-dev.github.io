{
  "genesis.49.p1.b1": {
    "text": "ヤコブはその子らを呼んで言った、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 49:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.49.p1.b2": {
    "text": "集まりなさい。後の日に、あなたがたの上に起ることを、告げましょう、……父イスラエルのことばを聞け。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 49:1-2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.49.p1.b3": {
    "text": "ルベンよ、あなたはわが長子、……威光のすぐれた者、権力のすぐれた者。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 49:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.49.p1.b4": {
    "text": "しかし、沸き立つ水のようだから、もはや、すぐれた者ではあり得ない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 49:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.49.p2.b1": {
    "text": "シメオンとレビとは兄弟。彼らのつるぎは暴虐の武器。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 49:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.49.p2.b2": {
    "text": "わが魂よ、彼らの会議に臨むな。わが栄えよ、彼らのつどいに連なるな。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 49:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.49.p2.b3": {
    "text": "彼らの怒りは、激しいゆえにのろわれ、彼らの憤りは、はなはだしいゆえにのろわれる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 49:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.49.p3.b1": {
    "text": "ユダよ、兄弟たちはあなたをほめる。……父の子らはあなたの前に身をかがめるであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 49:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.49.p3.b2": {
    "text": "ユダは、ししの子。……彼は雄じしのようにうずくまり、雌じしのように身を伏せる。だれがこれを起すことができよう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 49:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.49.p3.b3": {
    "text": "つえはユダを離れず、立法者のつえはその足の間を離れることなく、シロの来る時までに及ぶであろう。もろもろの民は彼に従う。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 49:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.49.p4.b1": {
    "text": "ゼブルンは海べに住み、舟の泊まる港となって、その境はシドンに及ぶであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 49:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.49.p4.b2": {
    "text": "イッサカルはたくましいろば、彼は羊のおりの間に伏している。……彼はその肩を下げてにない、奴隷となって追い使われる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 49:14-15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.49.p4.b3": {
    "text": "ダンは道のかたわらのへび、道のほとりのまむし。馬のかかとをかんで、乗る者をうしろに落すであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 49:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.49.p4.b4": {
    "text": "主よ、わたしはあなたの救を待ち望む。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 49:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.49.p5.b1": {
    "text": "ガドには略奪者が迫る。しかし彼はかえって敵のかかとに迫るであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 49:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.49.p5.b2": {
    "text": "アセルはその食物がゆたかで、王の美味をいだすであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 49:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.49.p5.b3": {
    "text": "ナフタリは放たれた雌じか、彼は美しい子じかを生むであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 49:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.49.p6.b1": {
    "text": "ヨセフは実を結ぶ若木、泉のほとりの実を結ぶ若木。その枝は、かきねを越えるであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 49:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.49.p6.b2": {
    "text": "射る者は彼を激しく攻め、彼を射、彼をいたく悩ました。しかし彼の弓はなお強く、彼の腕は素早い。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 49:23-24"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.49.p6.b3": {
    "text": "これらの祝福はヨセフのかしらに帰し、その兄弟たちの君たる者の頭の頂に帰する。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 49:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.49.p6.b4": {
    "text": "ベニヤミンはかき裂くおおかみ、朝にその獲物を食らい、夕にその分捕物を分けるであろう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 49:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.49.p7.b1": {
    "text": "わたしはわが民に加えられようとしている。あなたがたはヘテびとエフロンの畑にあるほら穴に、わたしの先祖たちと共にわたしを葬ってください。……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 49:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.49.p7.b2": {
    "text": "そこにアブラハムと妻サラとが葬られ、イサクと妻リベカもそこに葬られたが、わたしはまたそこにレアを葬った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 49:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.49.p7.b3": {
    "text": "こうしてヤコブは子らに命じ終って、足を床におさめ、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 49:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.49.p7.b4": {
    "text": "息絶えて、その民に加えられた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 49:33"
    },
    "adapted": false,
    "status": "approved"
  }
}
