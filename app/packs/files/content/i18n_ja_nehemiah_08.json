{
  "nehemiah.8.p1.b1": {
    "text": "イスラエルの人々はその町々に住んで七月になった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 7:73"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.8.p1.b2": {
    "text": "その時民は皆ひとりのようになって水の門の前の広場に集まり、主がイスラエルに与えられたモーセの律法の書を持って来るように、学者エズラに求めた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 8:1-2"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.8.p1.b3": {
    "text": "水の門の前にある広場で、あけぼのから……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 8:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.8.p1.b4": {
    "text": "……正午まで、男女および悟ることのできる人々の前でこれを読んだ。民はみな律法の書に耳を傾けた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 8:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.8.p2.b1": {
    "text": "学者エズラはこの事のために、かねて設けた木の台の上に立ったが……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 8:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.8.p2.b2": {
    "text": "エズラはすべての民の前にその書を開いた。彼はすべての民よりも高い所にいたからである。彼が書を開くと、すべての民は起立した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 8:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.8.p2.b3": {
    "text": "「アァメン、アァメン」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 8:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.8.p2.b4": {
    "text": "こうべをたれ、地にひれ伏して主を拝した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 8:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.8.p3.b1": {
    "text": "エシュア、バニ、セレビヤ……およびレビびとたちは民に律法を悟らせた。民はその所に立っていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 8:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.8.p3.b2": {
    "text": "彼らはその書、すなわち神の律法をめいりょうに読み、その意味を解き明かして",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 8:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.8.p3.b3": {
    "text": "その読むところを悟らせた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 8:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.8.p4.b1": {
    "text": "……すべての民が律法の言葉を聞いて泣いたからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 8:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.8.p4.b2": {
    "text": "「この日はあなたがたの神、主の聖なる日です。嘆いたり、泣いたりしてはならない」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 8:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.8.p4.b3": {
    "text": "「あなたがたは去って、肥えたものを食べ、甘いものを飲みなさい。その備えのないものには分けてやりなさい。……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 8:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.8.p4.b4": {
    "text": "憂えてはならない。主を喜ぶことはあなたがたの力です」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 8:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.8.p5.b1": {
    "text": "「泣くことをやめなさい。この日は聖なる日です。憂えてはならない」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 8:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.8.p5.b2": {
    "text": "すべての民は去って食い飲みし、また分け与えて",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 8:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.8.p5.b3": {
    "text": "大いに喜んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 8:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.8.p5.b4": {
    "text": "これは彼らが読み聞かされた言葉を悟ったからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 8:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.8.p6.b1": {
    "text": "次の日、すべての民の氏族の長たち、祭司、レビびとらは律法の言葉を学ぶために学者エズラのもとに集まってきて",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 8:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.8.p6.b2": {
    "text": "律法のうちに主がモーセに命じられたこと、すなわちイスラエルの人々は七月の祭の間、仮庵の中に住むべきことがしるされているのを見いだした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 8:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.8.p6.b3": {
    "text": "「あなたがたは山に出て行って、オリブと野生のオリブ、ミルトス、なつめやし、および茂った木の枝を取ってきて、しるされてあるとおり、仮庵を造れ」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 8:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.8.p7.b1": {
    "text": "それで民は出て行って、それを持って帰り、おのおのその家の屋根の上、その庭、神の宮の庭……などに仮庵を造った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 8:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.8.p7.b2": {
    "text": "ヌンの子ヨシュアの日からこの日まで、イスラエルの人々はこのように行ったことがなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 8:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.8.p7.b3": {
    "text": "それでその喜びは非常に大きかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 8:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.8.p7.b4": {
    "text": "エズラは初めの日から終りの日まで、毎日神の律法の書を読んだ。人々は七日の間、祭を行い、八日目になって、おきてにしたがって聖会を開いた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 8:18"
    },
    "adapted": false,
    "status": "approved"
  }
}
