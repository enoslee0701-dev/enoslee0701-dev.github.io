{
  "matthew.26.p1.b1": {
    "text": "예수께서 이 말씀을 다 마치시고 제자들에게 이르시되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p1.b2": {
    "text": "너희의 아는 바와 같이 이틀을 지나면 유월절이라 인자가 십자가에 못박히기 위하여 팔리우리라 하시더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p1.b3": {
    "text": "그 때에 대제사장들과 백성의 장로들이 가야바라 하는 대제사장의 아문에 모여",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p1.b4": {
    "text": "민요가 날까 하노니 명절에는 말자",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p2.b1": {
    "text": "예수께서 베다니 문둥이 시몬의 집에 계실 때에",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p2.b2": {
    "text": "한 여자가 매우 귀한 향유 한 옥합을 가지고 나아와서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p2.b3": {
    "text": "식사하시는 예수의 머리에 부으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p3.b1": {
    "text": "제자들이 보고 분하여 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p3.b2": {
    "text": "무슨 의사로 이것을 허비하느뇨",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p3.b3": {
    "text": "이것을 많은 값에 팔아 가난한 자들에게 줄 수 있었겠도다 하거늘",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p4.b1": {
    "text": "너희가 어찌하여 이 여자를 괴롭게 하느냐 저가 내게 좋은 일을 하였느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p4.b2": {
    "text": "가난한 자들은 항상 너희와 함께 있거니와 나는 항상 함께 있지 아니하리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p4.b3": {
    "text": "이 여자가 내 몸에 이 향유를 부은 것은 내 장사를 위하여 함이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p4.b4": {
    "text": "내가 진실로 너희에게 이르노니 온 천하에 어디서든지 이 복음이 전파되는 곳에는 이 여자의 행한 일도 말하여 저를 기념하리라 하시니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p5.b1": {
    "text": "그 때에 열 둘 중에 하나인 가룟 유다라 하는 자가 대제사장들에게 가서 말하되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p5.b2": {
    "text": "내가 예수를 너희에게 넘겨주리니 얼마나 주려느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p5.b3": {
    "text": "그들이 은 삼십을 달아 주거늘",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p5.b4": {
    "text": "저가 그 때부터 예수를 넘겨줄 기회를 찾더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p6.b1": {
    "text": "무교절의 첫날에",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p6.b2": {
    "text": "유월절 잡수실 것을 우리가 어디서 예비하기를 원하시나이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p6.b3": {
    "text": "선생님 말씀이 내 때가 가까왔으니 내 제자들과 함께 유월절을 네 집에서 지키겠다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p6.b4": {
    "text": "제자들이 예수의 시키신대로 하여 유월절을 예비하였더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p7.b1": {
    "text": "저물 때에 예수께서 열 두 제자와 함께 앉으셨더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p7.b2": {
    "text": "내가 진실로 너희에게 이르노니 너희중에 한 사람이 나를 팔리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p7.b3": {
    "text": "주여 내니이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p8.b1": {
    "text": "나와 함께 그릇에 손을 넣는 그가 나를 팔리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p8.b2": {
    "text": "인자는 자기에게 대하여 기록된대로 가거니와 인자를 파는 그 사람에게는 화가 있으리로다 그 사람은 차라리 나지 아니 하였더면 제게 좋을뻔 하였느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p8.b3": {
    "text": "랍비여 내니이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p8.b4": {
    "text": "네가 말하였도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p9.b1": {
    "text": "저희가 먹을 때에 예수께서 떡을 가지사 축복하시고 떼어 제자들을 주시며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p9.b2": {
    "text": "받아 먹으라 이것이 내 몸이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p9.b3": {
    "text": "너희가 다 이것을 마시라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p9.b4": {
    "text": "이것은 죄 사함을 얻게 하려고 많은 사람을 위하여 흘리는 바 나의 피 곧 언약의 피니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p10.b1": {
    "text": "그러나 너희에게 이르노니 내가 포도나무에서 난 것을 이제부터 내 아버지의 나라에서 새것으로 너희와 함께 마시는 날까지 마시지 아니하리라 하시니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p10.b2": {
    "text": "이에 저희가 찬미하고 감람산으로 나아가니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p11.b1": {
    "text": "오늘 밤에 너희가 다 나를 버리리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p11.b2": {
    "text": "기록된바 내가 목자를 치리니 양의 떼가 흩어지리라 하였느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p11.b3": {
    "text": "그러나 내가 살아난 후에 너희보다 먼저 갈릴리로 가리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p12.b1": {
    "text": "다 주를 버릴지라도 나는 언제든지 버리지 않겠나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p12.b2": {
    "text": "내가 진실로 네게 이르노니 오늘 밤 닭 울기 전에 네가 세번 나를 부인하리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p12.b3": {
    "text": "내가 주와 함께 죽을지언정 주를 부인하지 않겠나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p12.b4": {
    "text": "모든 제자도 이와 같이 말하니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p13.b1": {
    "text": "이에 예수께서 제자들과 함께 겟세마네라 하는 곳에 이르러",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:36"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p13.b2": {
    "text": "내가 저기 가서 기도할 동안에 너희는 여기 앉아 있으라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:36"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p13.b3": {
    "text": "내 마음이 심히 고민하여 죽게 되었으니 너희는 여기 머물러 나와 함께 깨어 있으라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p14.b1": {
    "text": "조금 나아가사 얼굴을 땅에 대시고 엎드려 기도하여 가라사대",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p14.b2": {
    "text": "내 아버지여 만일 할만하시거든 이 잔을 내게서 지나가게 하옵소서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p14.b3": {
    "text": "그러나 나의 원대로 마옵시고 아버지의 원대로 하옵소서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p15.b1": {
    "text": "제자들에게 오사 그 자는 것을 보시고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p15.b2": {
    "text": "너희가 나와 함께 한 시 동안도 이렇게 깨어 있을 수 없더냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p15.b3": {
    "text": "시험에 들지 않게 깨어 있어 기도하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p15.b4": {
    "text": "마음에는 원이로되 육신이 약하도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p16.b1": {
    "text": "다시 두번째 나아가 기도하여 가라사대",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:42"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p16.b2": {
    "text": "내 아버지여 만일 내가 마시지 않고는 이 잔이 내게서 지나갈 수 없거든 아버지의 원대로 되기를 원하나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:42"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p16.b3": {
    "text": "다시 오사 보신즉 저희가 자니 이는 저희 눈이 피곤함일러라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:43"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p16.b4": {
    "text": "또 저희를 두시고 나아가 세번째 동일한 말씀으로 기도하신 후",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:44"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p17.b1": {
    "text": "이제는 자고 쉬라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:45"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p17.b2": {
    "text": "보라 때가 가까왔으니 인자가 죄인의 손에 팔리우느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:45"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p17.b3": {
    "text": "일어나라 함께 가자 보라 나를 파는 자가 가까이 왔느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:46"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p18.b1": {
    "text": "말씀하실 때에 열 둘 중에 하나인 유다가 왔는데 … 큰 무리가 검과 몽치를 가지고 그와 함께 하였더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:47"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p18.b2": {
    "text": "내가 입맞추는 자가 그이니 그를 잡으라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:48"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p18.b3": {
    "text": "랍비여 안녕하시옵니까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:49"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p18.b4": {
    "text": "친구여 네가 무엇을 하려고 왔는지 행하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:50"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p19.b1": {
    "text": "예수와 함께 있던 자 중에 하나가 손을 펴 검을 빼어 대제사장의 종을 쳐 그 귀를 떨어뜨리니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:51"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p19.b2": {
    "text": "네 검을 도로 집에 꽂으라 검을 가지는 자는 다 검으로 망하느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:52"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p19.b3": {
    "text": "너는 내가 내 아버지께 구하여 지금 열 두 영 더되는 천사를 보내시게 할 수 없는 줄로 아느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:53"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p19.b4": {
    "text": "내가 만일 그렇게 하면 이런 일이 있으리라 한 성경이 어떻게 이루어지리요 하시더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:54"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p20.b1": {
    "text": "너희가 강도를 잡는 것 같이 검과 몽치를 가지고 나를 잡으러 나왔느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:55"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p20.b2": {
    "text": "내가 날마다 성전에 앉아 가르쳤으되 너희가 나를 잡지 아니하였도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:55"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p20.b3": {
    "text": "그러나 이렇게 된 것은 다 선지자들의 글을 이루려 함이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:56"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p20.b4": {
    "text": "이에 제자들이 다 예수를 버리고 도망하니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:56"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p21.b1": {
    "text": "예수를 잡은 자들이 끌고 대제사장 가야바에게로 가니 거기 서기관과 장로들이 모여 있더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:57"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p21.b2": {
    "text": "베드로가 멀찍이 예수를 좇아 대제사장의 집 뜰에까지 가서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:58"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p21.b3": {
    "text": "그 결국을 보려고 안에 들어가 하속들과 함께 앉았더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:58"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p22.b1": {
    "text": "대제사장들과 온 공회가 예수를 죽이려고 그를 칠 거짓증거를 찾으매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:59"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p22.b2": {
    "text": "가로되 이 사람의 말이 내가 하나님의 성전을 헐고 사흘에 지을 수 있다 하더라 하니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:61"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p22.b3": {
    "text": "아무 대답도 없느냐 이 사람들의 너를 치는 증거가 어떠하뇨",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:62"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p22.b4": {
    "text": "예수께서 잠잠하시거늘",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:63"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p23.b1": {
    "text": "내가 너로 살아 계신 하나님께 맹세하게 하노니 네가 하나님의 아들 그리스도인지 우리에게 말하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:63"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p23.b2": {
    "text": "네가 말하였느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:64"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p23.b3": {
    "text": "그러나 내가 너희에게 이르노니 이 후에 인자가 권능의 우편에 앉은 것과 하늘 구름을 타고 오는 것을 너희가 보리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:64"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p24.b1": {
    "text": "저가 참람한 말을 하였으니 어찌 더 증인을 요구하리요",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:65"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p24.b2": {
    "text": "저는 사형에 해당하니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:66"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p24.b3": {
    "text": "가로되 그리스도야 우리에게 선지자 노릇을 하라 너를 친 자가 누구냐 하더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:68"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p25.b1": {
    "text": "너도 갈릴리 사람 예수와 함께 있었도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:69"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p25.b2": {
    "text": "나는 네 말하는 것이 무엇인지 알지 못하겠노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:70"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p25.b3": {
    "text": "이 사람은 나사렛 예수와 함께 있었도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:71"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p25.b4": {
    "text": "내가 그 사람을 알지 못 하노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:72"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p26.b1": {
    "text": "너도 진실로 그 당이라 네 말소리가 너를 표명한다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:73"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p26.b2": {
    "text": "내가 그 사람을 알지 못하노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:74"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p26.b3": {
    "text": "닭이 곧 울더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:74"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.26.p26.b4": {
    "text": "이에 베드로가 예수의 말씀에 닭 울기 전에 네가 세번 나를 부인하리라 하심이 생각나서 밖에 나가서 심히 통곡하니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 26:75"
    },
    "adapted": false,
    "status": "approved"
  }
}
