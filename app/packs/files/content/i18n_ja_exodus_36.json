{
  "exodus.36.p1.b1": {
    "text": "… 民はなおも朝ごとに、自発のささげ物を彼のもとに携えてきた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 36:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.36.p1.b2": {
    "text": "… 「民があまりに多く携えて来るので、主がせよと命じられた組立ての工事には余ります」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 36:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.36.p1.b3": {
    "text": "… 「男も女も、もはや聖所のために、ささげ物をするに及ばない」。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 36:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.36.p1.b4": {
    "text": "材料はすべての工事をするのにじゅうぶんで、かつ余るからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 36:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.36.p2.b5": {
    "text": "すべて工作をする者のうちの心に知恵ある者は、十枚の幕で幕屋を造った。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 36:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.36.p2.b6": {
    "text": "そして金の輪五十を作り、その輪で、幕を互に連ね合わせたので、一つの幕屋になった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 36:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.36.p2.b7": {
    "text": "また、あかね染めの雄羊の皮で、天幕のおおいと、じゅごんの皮で、その上にかけるおおいとを作った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 36:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.36.p3.b8": {
    "text": "また幕屋のためにアカシヤ材をもって、立枠を造った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 36:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.36.p3.b9": {
    "text": "そして、その枠を金でおおい、また横木を通すその環を金で造り、またその横木を金でおおった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 36:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.36.p3.b10": {
    "text": "その二十の枠の下に銀の座四十を造って、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 36:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.36.p4.b11": {
    "text": "また青糸、紫糸、緋糸、亜麻の撚糸で、垂幕を作り、巧みなわざをもって、それにケルビムを織り出した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 36:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.36.p4.b12": {
    "text": "また、これがためにアカシヤ材の柱四本を作り、金でこれをおおい、その鉤を金にし、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 36:36"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.36.p4.b13": {
    "text": "また幕屋の入口のために青糸、紫糸、緋糸、亜麻の撚糸で、色とりどりに織ったとばりを作った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 36:37"
    },
    "adapted": false,
    "status": "approved"
  }
}
