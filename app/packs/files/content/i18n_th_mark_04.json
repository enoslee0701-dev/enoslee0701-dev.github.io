{
  "mark.4.p1.b1": {
    "text": "พระเยซู​สอน​ที่​ริม​ทะเลสาบ​อีก​ครั้ง",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p1.b2": {
    "text": "ฝูง​ชน​รุม​ล้อม​พระองค์​แน่น",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p1.b3": {
    "text": "จน​พระองค์​ต้อง​ลง​ไป​นั่ง​ใน​เรือ",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p1.b4": {
    "text": "ขณะ​ที่​ฝูง​ชน​อยู่​ริม​ฝั่ง",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p1.b5": {
    "text": "พระองค์​สอน​พวก​เขา​หลาย​สิ่ง​ด้วย​อุปมา",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p1.b6": {
    "text": "พระองค์​สอน​พวก​เขา…ว่า",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p2.b1": {
    "text": "จง​ฟัง!",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p2.b2": {
    "text": "มี​ชาว​นา​คน​หนึ่ง​ออก​ไป​หว่าน​เมล็ด​พืช",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p2.b3": {
    "text": "ขณะ​ที่​หว่าน บาง​เมล็ด​ก็​ตก​ตาม​ทาง",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p2.b4": {
    "text": "และ​นก​ก็​มา​จิก​กิน​หมด",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p3.b1": {
    "text": "บาง​เมล็ด​ตก​บน​พื้น​ดิน​ปน​หิน ซึ่ง​มี​เนื้อ​ดิน​น้อย",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p3.b2": {
    "text": "จึง​งอก​ขึ้น​เร็ว​เพราะ​ดิน​ตื้น",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p3.b3": {
    "text": "แต่​เมื่อ​แดด​เผา​ก็​เหี่ยว​ไป​เพราะ​ไม่​หยั่ง​ราก​ลึก",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p3.b4": {
    "text": "บาง​เมล็ด​ตก​กลาง​พง​หนาม พง​หนาม​ก็​เติบโต",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p3.b5": {
    "text": "รัด​พืช​นั้น จึง​ไม่​เกิด​ผล",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p4.b1": {
    "text": "แต่​ยัง​มี​เมล็ด​บาง​ส่วน​ตก​บน​ดิน​ดี งอก​ขึ้น​มา เติบโต",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p4.b2": {
    "text": "และ​เกิด​ผล​สาม​สิบ​เท่า",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p4.b3": {
    "text": "หก​สิบ​เท่า",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p4.b4": {
    "text": "หรือ​ร้อย​เท่า",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p4.b5": {
    "text": "แล้ว​พระเยซู​พูด​ว่า",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p4.b6": {
    "text": "ใคร​มี​หู จง​ฟัง​เถิด",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p5.b1": {
    "text": "เมื่อ​อยู่​ตาม​ลำพัง",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p5.b2": {
    "text": "สาวก​ทั้ง​สิบสอง​คน กับ​คน​ที่​แวดล้อม​พระองค์​อยู่ ก็​ถาม​เรื่อง​อุปมา​นั้น",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p5.b3": {
    "text": "พระองค์​บอก​พวก​เขา​ว่า",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p5.b4": {
    "text": "ความ​ลับ​ของ​อาณาจักร​พระเจ้า​ก็​ให้​พวก​เจ้า​รู้",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p5.b5": {
    "text": "แต่​กับ​คน​นอก​นั้น​ทุก​อย่าง​กล่าว​เป็น​อุปมา",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p5.b6": {
    "text": "เพื่อ​ว่า พวก​เขา​อาจ​ดู​แล้ว​ดู​เล่า​แต่​ไม่​มี​วัน​เห็น",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p5.b7": {
    "text": "และ​ได้ยิน​ครั้ง​แล้ว​ครั้ง​เล่า​แต่​ไม่​มี​วัน​เข้าใจ",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p5.b8": {
    "text": "มิฉะนั้น​แล้ว​เขา​คง​หัน​กลับ​มา​และ​ได้​รับ​การ​อภัย!",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p6.b1": {
    "text": "แล้ว​พระเยซู​พูด​กับ​พวก​เขา​ว่า",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p6.b2": {
    "text": "พวก​เจ้า​ไม่​เข้าใจ​อุปมา​นี้​หรือ",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p6.b3": {
    "text": "แล้ว​อย่าง​นั้น​จะ​เข้าใจ​อุปมา​อื่น​ๆ ได้​อย่างไร",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p6.b4": {
    "text": "ชาว​นา​ได้​หว่าน​พระวจนะ",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p6.b5": {
    "text": "บาง​คน​ก็​เป็น​เหมือน​เมล็ด​ที่​ตก​ตาม​ทาง ทันที​ที่​เขา​ได้ยิน",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p6.b6": {
    "text": "ซาตาน​ก็​มา​ฉวย​เอา​พระวจนะ​ที่​หว่าน​ลง​ใน​เขา​ไป",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p7.b1": {
    "text": "บาง​คน​ก็​เหมือน​เมล็ด​ที่​หว่าน​ลง​บน​พื้น​หิน เมื่อ​ได้ยิน​พระวจนะ",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p7.b2": {
    "text": "แล้ว​รับ​ไว้​ทันที​ด้วย​ความ​ยินดี",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p7.b3": {
    "text": "แต่​เพราะ​ไม่​หยั่ง​ราก​ลึก จึง​อยู่​แค่​ชั่ว​คราว",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p7.b4": {
    "text": "เมื่อ​เกิด​ปัญหา​หรือ​การ​ข่มเหง​เพราะ​พระวจนะ",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p7.b5": {
    "text": "พวก​เขา​ก็​ละทิ้ง​ไป​อย่าง​รวดเร็ว",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p8.b1": {
    "text": "บาง​คน​เหมือน​เมล็ด​ที่​หว่าน​กลาง​พง​หนาม คือ​ได้ยิน​พระวจนะ",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p8.b2": {
    "text": "แต่​ถูก​ความ​กังวล​ใน​ชีวิต ความ​เย้ายวน​ของ​ทรัพย์​สมบัติ และ​ความ​อยาก​ได้​ใคร่​มี​ใน​สิ่ง​ต่าง​ๆ เข้า​มา",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p8.b3": {
    "text": "บีบ​รัด​พระวจนะ​ทำ​ให้​ไม่​เกิด​ผล",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p8.b4": {
    "text": "ส่วน​บาง​คน​เป็น​เหมือน​เมล็ด​ที่​หว่าน​ลง​บน​ดิน​ดี คือ​คน​ที่​ได้ยิน​พระวจนะ​แล้ว​รับ​ไว้ ก็​เกิด​ผล",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p8.b5": {
    "text": "สาม​สิบ​เท่า หก​สิบ​เท่า หรือ​ร้อย​เท่า​ของ​ที่​หว่าน​ลง​ไป",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p9.b1": {
    "text": "พระองค์​พูด​กับ​พวก​เขา​ว่า",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p9.b2": {
    "text": "เจ้า​จะ​เอา​ตะเกียง​มา",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p9.b3": {
    "text": "แล้ว​เอา​ฝา​ครอบ",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p9.b4": {
    "text": "หรือ​วาง​ไว้​ใต้​เตียง​ไหม",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p9.b5": {
    "text": "แต่​เจ้า​ย่อม​ตั้ง​ไว้​บน​เชิง​ตะเกียง​ไม่​ใช่​หรือ",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p9.b6": {
    "text": "เพราะ​สิ่ง​ใด​ที่​ซ่อน​เร้น​จะ​ต้อง​ถูก​เปิดเผย",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p9.b7": {
    "text": "และ​สิ่ง​ใด​ที่​ปิด​บัง​ไว้​จะ​ต้อง​ถูก​เปิดโปง",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p9.b8": {
    "text": "ใคร​มี​หู จง​ฟัง​เถิด",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p10.b1": {
    "text": "พระองค์​พูด​อีก​ว่า",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p10.b2": {
    "text": "จง​คิด​สิ่ง​ที่​เจ้า​ได้ยิน​อย่าง​ถี่ถ้วน",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p10.b3": {
    "text": "ท่าน​ใช้​ถ้วย​อัน​ใด",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p10.b4": {
    "text": "ก็​จะ​ใช้​ถ้วย​ตวง​อัน​เดียว​กัน​นั้น​ตวง​แก่​ท่าน",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p10.b5": {
    "text": "และ​ได้​รับ​มาก​ยิ่ง​กว่า​นั้น​อีก",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p10.b6": {
    "text": "ใคร​มี​อยู่​แล้ว​ก็​จะ​ได้​รับ​เพิ่ม",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p10.b7": {
    "text": "ส่วน​ใคร​ไม่​มี แม้​ที่​มี​อยู่​ก็​จะ​ถูก​ริบ​ไป​จาก​เขา",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p11.b1": {
    "text": "พระองค์​พูด​ด้วย​ว่า",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p11.b2": {
    "text": "อาณาจักร​ของ​พระเจ้า​เป็น​เหมือน​คน​หนึ่ง​หว่าน​เมล็ด​พืช​ลง​ใน​ดิน",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p11.b3": {
    "text": "ทั้ง​วัน​ทั้ง​คืน​ไม่​ว่า​จะ​หลับ",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p11.b4": {
    "text": "หรือ​ตื่น",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p11.b5": {
    "text": "เมล็ด​พืช​ก็​งอก​และ​เติบโต​ขึ้น",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p11.b6": {
    "text": "แม้​เขา​ไม่​รู้​ว่า​มัน​งอก​ขึ้น​ได้​อย่างไร",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p11.b7": {
    "text": "ดิน​ทำ​ให้​มัน​งอก",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p11.b8": {
    "text": "…เป็น​ต้น​อ่อน​แล้ว​ออก​รวง จาก​นั้น​มี​เมล็ด​ข้าว​เต็ม​รวง",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p11.b9": {
    "text": "เมื่อ​รวง​ข้าว​สุก​แล้ว เขา​ก็​ใช้​เคียว​เกี่ยว",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p11.b10": {
    "text": "เพราะ​ถึง​ฤดู​เก็บ​เกี่ยว",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p12.b1": {
    "text": "พระองค์​พูด​อีก​ว่า",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p12.b2": {
    "text": "พวก​เรา​จะ​เปรียบ​อาณาจักร​ของ​พระเจ้า​กับ​อะไร​ดี",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p12.b3": {
    "text": "หรือ​จะ​ยก​อุปมา​ใด​มา​อธิบาย",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p12.b4": {
    "text": "อาณาจักร​ของ​พระเจ้า​นั้น​ก็​เหมือน​เมล็ด​มัสตาร์ด",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p12.b5": {
    "text": "ซึ่ง​เป็น​เมล็ด​ที่​เล็ก​ที่​สุด​ใน​โลก",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p12.b6": {
    "text": "แต่​เมื่อ​เพาะ​ลง​ใน​ดิน ก็​เติบโต​ขึ้น​เป็น​ต้น​ใหญ่​ที่​สุด​ใน​สวน",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:31-32"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p12.b7": {
    "text": "แผ่​กิ่ง​ก้าน​สาขา​จน​นก​มา​เกาะ​กิ่ง​อาศัย​ร่ม​เงา​ได้",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p13.b1": {
    "text": "พระเยซู​กล่าว​อุปมา​เช่น​นี้​หลาย​เรื่อง เพื่อ​อธิบาย​พระวจนะ​แก่​ผู้​คน ใน​ลักษณะ​ที่​พวก​เขา​เข้าใจ​ได้",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p13.b2": {
    "text": "พระองค์​ไม่​ได้​กล่าว​สิ่ง​ใด​กับ​พวก​เขา​โดย​ไม่​ใช้​อุปมา​เลย",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p13.b3": {
    "text": "แต่​เมื่อ​อยู่​กับ​พวก​สาวก​ตาม​ลำพัง พระองค์​ก็​อธิบาย​ทุก​สิ่ง",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p13.b4": {
    "text": "เย็น​วัน​นั้น​พระองค์​พูด​กับ​พวก​สาวก​ของ​พระองค์​ว่า",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p13.b5": {
    "text": "ให้​เรา​ข้าม​ไป​อีก​ฟาก​หนึ่ง​กัน​เถอะ",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p14.b1": {
    "text": "พวก​เขา​ละ​ฝูงชน",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:36"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p14.b2": {
    "text": "แล้ว​ลง​เรือ​ที่​พระองค์​นั่ง​อยู่​นั้น​ไป",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:36"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p14.b3": {
    "text": "มี​เรือ​อื่น​หลาย​ลำ​ตาม​ไป​ด้วย",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:36"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p14.b4": {
    "text": "เกิด​พายุ​รุนแรง",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:37"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p14.b5": {
    "text": "คลื่น​ซัด​ท่วม​จน​เรือ​จวน​จะ​จม​แล้ว",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:37"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p15.b1": {
    "text": "พระเยซู​นอน​หนุน​หมอน​หลับ​อยู่​ท้าย​เรือ",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p15.b2": {
    "text": "พวก​สาวก​มา​ปลุก​พระองค์ และ​พูด​ว่า",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p15.b3": {
    "text": "อาจารย์",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p15.b4": {
    "text": "พระองค์​ไม่​ห่วง​หรือ​ว่า​เรา​จะ​จม​น้ำ​ตาย",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p16.b1": {
    "text": "พระองค์​ก็​ลุก​ขึ้น",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p16.b2": {
    "text": "ห้าม​ลม​และ​คลื่น​ว่า",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p16.b3": {
    "text": "จง​เงียบ​สงบ!",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p16.b4": {
    "text": "แล้ว​ลม​ก็​หยุด​พัด ทุก​อย่าง​ก็​นิ่ง​สนิท",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p17.b1": {
    "text": "พระองค์​ถาม​พวก​สาวก​ว่า",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p17.b2": {
    "text": "ทำไม​จึง​กลัว​นัก",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p17.b3": {
    "text": "พวก​เจ้า​ยัง​ไม่​มี​ความ​เชื่อ​อีก​หรือ",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p17.b4": {
    "text": "พวก​สาวก​แตกตื่น​ตกใจ​และ​ถาม​กัน​ว่า",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p17.b5": {
    "text": "ผู้​นี้​เป็น​ใคร​กัน",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p17.b6": {
    "text": "แม้​แต่​ลม​และ​คลื่น​ก็​ยัง​เชื่อฟัง​ท่าน",
    "kind": "scripture",
    "source": {
      "version": "thatcv",
      "ref": "Mark 4:41"
    },
    "adapted": false,
    "status": "approved"
  }
}
