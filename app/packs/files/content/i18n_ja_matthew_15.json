{
  "matthew.15.p1.b1": {
    "text": "ときに、パリサイ人と律法学者たちとが、エルサレムからイエスのもとにきて言った、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p1.b2": {
    "text": "あなたの弟子たちは、なぜ昔の人々の言伝えを破るのですか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p1.b3": {
    "text": "彼らは食事の時に手を洗っていません",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p2.b1": {
    "text": "なぜ、あなたがたも自分たちの言伝えによって、神のいましめを破っているのか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p2.b2": {
    "text": "神は言われた、『父と母とを敬え』、また『父または母をののしる者は、必ず死に定められる』と。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p2.b3": {
    "text": "それだのに、あなたがたは『だれでも父または母にむかって、あなたにさしあげるはずのこのものは供え物です、と言えば、父または母を敬わなくてもよろしい』と言っている。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:5-6"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p2.b4": {
    "text": "こうしてあなたがたは自分たちの言伝えによって、神の言を無にしている。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p3.b1": {
    "text": "偽善者たちよ、イザヤがあなたがたについて、こういう適切な預言をしている、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p3.b2": {
    "text": "『この民は、口さきではわたしを敬うが、その心はわたしから遠く離れている。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p3.b3": {
    "text": "人間のいましめを教として教え、無意味にわたしを拝んでいる』」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p4.b1": {
    "text": "それからイエスは群衆を呼び寄せて言われた、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p4.b2": {
    "text": "聞いて悟るがよい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p4.b3": {
    "text": "口にはいるものは人を汚すことはない。かえって、口から出るものが人を汚すのである」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p4.b4": {
    "text": "パリサイ人たちが御言を聞いてつまずいたことを、ご存じですか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p5.b1": {
    "text": "わたしの天の父がお植えにならなかったものは、みな抜き取られるであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p5.b2": {
    "text": "彼らをそのままにしておけ。彼らは盲人を手引きする盲人である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p5.b3": {
    "text": "もし盲人が盲人を手引きするなら、ふたりとも穴に落ち込むであろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p6.b1": {
    "text": "その譬を説明してください",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p6.b2": {
    "text": "あなたがたも、まだわからないのか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p6.b3": {
    "text": "しかし、口から出て行くものは、心の中から出てくるのであって、それが人を汚すのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p6.b4": {
    "text": "しかし、洗わない手で食事することは、人を汚すのではない",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p7.b1": {
    "text": "さて、イエスはそこを出て、ツロとシドンとの地方へ行かれた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p7.b2": {
    "text": "すると、そこへ、その地方出のカナンの女が出てきて、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p7.b3": {
    "text": "主よ、ダビデの子よ、わたしをあわれんでください。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p7.b4": {
    "text": "娘が悪霊にとりつかれて苦しんでいます",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p8.b1": {
    "text": "しかし、イエスはひと言もお答えにならなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p8.b2": {
    "text": "この女を追い払ってください。叫びながらついてきていますから",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p8.b3": {
    "text": "わたしは、イスラエルの家の失われた羊以外の者には、つかわされていない",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p9.b1": {
    "text": "しかし、女は近寄りイエスを拝して言った、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p9.b2": {
    "text": "主よ、わたしをお助けください",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p9.b3": {
    "text": "子供たちのパンを取って小犬に投げてやるのは、よろしくない",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p10.b1": {
    "text": "主よ、お言葉どおりです。でも、小犬もその主人の食卓から落ちるパンくずは、いただきます",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p10.b2": {
    "text": "女よ、あなたの信仰は見あげたものである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p10.b3": {
    "text": "あなたの願いどおりになるように",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p10.b4": {
    "text": "その時に、娘はいやされた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p11.b1": {
    "text": "イエスはそこを去って、ガリラヤの海べに行き、それから山に登ってそこにすわられた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p11.b2": {
    "text": "すると大ぜいの群衆が、足なえ、不具者、盲人、おし、そのほか多くの人々を連れてきて、イエスの足もとに置いたので、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p11.b3": {
    "text": "群衆は、おしが物を言い、不具者が直り、足なえが歩き、盲人が見えるようになったのを見て驚き、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p11.b4": {
    "text": "そしてイスラエルの神をほめたたえた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p12.b1": {
    "text": "イエスは弟子たちを呼び寄せて言われた、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p12.b2": {
    "text": "この群衆がかわいそうである。もう三日間もわたしと一緒にいるのに、何も食べるものがない。しかし、彼らを空腹のままで帰らせたくはない。恐らく途中で弱り切ってしまうであろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p12.b3": {
    "text": "荒野の中で、こんなに大ぜいの群衆にじゅうぶん食べさせるほどたくさんのパンを、どこで手に入れましょうか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p12.b4": {
    "text": "パンはいくつあるか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p12.b5": {
    "text": "七つあります。また小さい魚が少しあります",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p13.b1": {
    "text": "そこでイエスは群衆に、地にすわるようにと命じ、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p13.b2": {
    "text": "七つのパンと魚とを取り、感謝してこれをさき、弟子たちにわたされ、弟子たちはこれを群衆にわけた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:36"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p13.b3": {
    "text": "一同の者は食べて満腹した。そして残ったパンくずを集めると、七つのかごにいっぱいになった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:37"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p14.b1": {
    "text": "食べた者は、女と子供とを除いて四千人であった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.15.p14.b2": {
    "text": "そこでイエスは群衆を解散させ、舟に乗ってマガダンの地方へ行かれた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 15:39"
    },
    "adapted": false,
    "status": "approved"
  }
}
