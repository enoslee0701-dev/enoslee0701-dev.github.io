{
  "mark.16.p1.b1": {
    "text": "안식일이 지나매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p1.b2": {
    "text": "막달라 마리아와 야고보의 어머니 마리아와 또 살로메가 … 향품을 사다 두었다가",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p1.b3": {
    "text": "가서 예수께 바르기 위하여",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p2.b1": {
    "text": "안식 후 첫날 매우 일찌기 해 돋은 때에 그 무덤으로 가며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p2.b2": {
    "text": "누가 우리를 위하여 무덤 문에서 돌을 굴려 주리요",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p2.b3": {
    "text": "눈을 들어 본즉 돌이 벌써 굴려졌으니 그 돌이 심히 크더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p3.b1": {
    "text": "무덤에 들어가서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p3.b2": {
    "text": "흰 옷을 입은 한 청년이 우편에 앉은 것을 보고 놀라매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p3.b3": {
    "text": "놀라지 말라 너희가 십자가에 못 박히신 나사렛 예수를 찾는구나 그가 살아나셨고 여기 계시지 아니하니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p3.b4": {
    "text": "보라 그를 두었던 곳이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p4.b1": {
    "text": "가서 그의 제자들과 베드로에게 이르기를",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p4.b2": {
    "text": "예수께서 너희보다 먼저 갈릴리로 가시나니 전에 너희에게 말씀하신대로 너희가 거기서 뵈오리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p4.b3": {
    "text": "여자들이 심히 놀라 떨며 나와 무덤에서 도망하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p4.b4": {
    "text": "무서워하여 아무에게 아무 말도 하지 못하더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p5.b1": {
    "text": "안식 후 첫날 이른 아침에",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p5.b2": {
    "text": "예수께서 … 살아나신 후 … 막달라 마리아에게 먼저 보이시니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p5.b3": {
    "text": "마리아가 가서 예수와 함께하던 사람들의 슬퍼하며 울고 있는 중에 이 일을 고하매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p5.b4": {
    "text": "그들은 예수의 살으셨다는 것과 마리아에게 보이셨다는 것을 듣고도 믿지 아니하니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p6.b1": {
    "text": "그 후에 저희 중 두 사람이 걸어서 시골로 갈 때에",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p6.b2": {
    "text": "예수께서 다른 모양으로 저희에게 나타나시니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p6.b3": {
    "text": "두 사람이 가서 남은 제자들에게 고하였으되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p6.b4": {
    "text": "역시 믿지 아니하나라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p7.b1": {
    "text": "그 후에 열 한 제자가 음식 먹을 때에",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p7.b2": {
    "text": "예수께서 저희에게 나타나사",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p7.b3": {
    "text": "저희의 믿음 없는 것과 마음이 완악한 것을 꾸짖으시니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p7.b4": {
    "text": "이는 자기의 살아난 것을 본 자들의 말을 믿지 아니함일러라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p8.b1": {
    "text": "너희는 온 천하에 다니며 만민에게 복음을 전파하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p8.b2": {
    "text": "믿고 세례를 받는 사람은 구원을 얻을 것이요 믿지 않는 사람은 정죄를 받으리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p8.b3": {
    "text": "믿는 자들에게는 이런 표적이 따르리니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p8.b4": {
    "text": "병든 사람에게 손을 얹은즉 나으리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p9.b1": {
    "text": "주 예수께서 말씀을 마치신 후에",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p9.b2": {
    "text": "하늘로 올리우사 하나님 우편에 앉으시니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p9.b3": {
    "text": "제자들이 나가 두루 전파할새",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.16.p9.b4": {
    "text": "주께서 함께 역사하사 그 따르는 표적으로 말씀을 확실히 증거하시니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 16:20"
    },
    "adapted": false,
    "status": "approved"
  }
}
