{
  "kings2.2.p1.b1": {
    "text": "主がつむじ風をもってエリヤを天に上らせようとされた時、エリヤはエリシャと共にギルガルを出て行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.2.p1.b2": {
    "text": "「どうぞ、ここにとどまってください。主はわたしをベテルにつかわされるのですから」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.2.p1.b3": {
    "text": "「主は生きておられます。またあなたも生きておられます。わたしはあなたを離れません」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.2.p1.b4": {
    "text": "「主がきょう、あなたの師事する主人をあなたから取られるのを知っていますか」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.2.p1.b5": {
    "text": "「はい、知っています。あなたがたは黙っていてください」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.2.p2.b1": {
    "text": "「… わたしはあなたを離れません」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.2.p2.b2": {
    "text": "「はい、知っています。あなたがたは黙っていてください」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.2.p2.b3": {
    "text": "預言者のともがら五十人も行って、彼らにむかって、はるかに離れて立っていた。彼らふたりは、ヨルダンのほとりに立ったが、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.2.p2.b4": {
    "text": "エリヤは外套を取り、それを巻いて水を打つと、水が左右に分れたので、ふたりはかわいた土の上を渡ることができた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.2.p3.b1": {
    "text": "「わたしが取られて、あなたを離れる前に、あなたのしてほしい事を求めなさい」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.2.p3.b2": {
    "text": "「どうぞ、あなたの霊の二つの分をわたしに継がせてください」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.2.p3.b3": {
    "text": "「あなたはむずかしい事を求める。あなたがもし、わたしが取られて、あなたを離れるのを見るならば、そのようになるであろう。しかし見ないならば、そのようにはならない」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.2.p4.b1": {
    "text": "彼らが進みながら語っていた時、火の車と火の馬があらわれて、ふたりを隔てた。そしてエリヤはつむじ風に乗って天にのぼった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.2.p4.b2": {
    "text": "「わが父よ、わが父よ、イスラエルの戦車よ、その騎兵よ」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.2.p4.b3": {
    "text": "再び彼を見なかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.2.p5.b1": {
    "text": "そこでエリシャは自分の着物をつかんで、それを二つに裂き、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.2.p5.b2": {
    "text": "またエリヤの身から落ちた外套を取り上げ、帰ってきてヨルダンの岸に立った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.2.p5.b3": {
    "text": "「エリヤの神、主はどこにおられますか」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.2.p5.b4": {
    "text": "彼が水を打つと、水は左右に分れたので、エリシャは渡った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.2.p6.b1": {
    "text": "「エリヤの霊がエリシャの上にとどまっている」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.2.p6.b2": {
    "text": "「… 主の霊が彼を引きあげて、彼を山か谷に投げたのかも知れません」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.2.p6.b3": {
    "text": "「つかわしてはならない」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.2.p6.b4": {
    "text": "… 三日の間尋ねたが、彼を見いださなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.2.p6.b5": {
    "text": "「わたしは、あなたがたに、行ってはならないと告げたではないか」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.2.p7.b1": {
    "text": "「見られるとおり、この町の場所は良いが水が悪いので、この地は流産を起すのです」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.2.p7.b2": {
    "text": "「新しい皿に塩を盛って、わたしに持ってきなさい」 …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.2.p7.b3": {
    "text": "「主はこう仰せられる、『わたしはこの水を良い水にした。もはやここには死も流産も起らないであろう』」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.2.p7.b4": {
    "text": "こうしてその水はエリシャの言ったとおりに良い水になって今日に至っている。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.2.p8.b1": {
    "text": "彼はそこからベテルへ上ったが、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.2.p8.b2": {
    "text": "「はげ頭よ、のぼれ。はげ頭よ、のぼれ」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.2.p9.b1": {
    "text": "彼はふり返って彼らを見、主の名をもって彼らをのろった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.2.p9.b2": {
    "text": "すると林の中から二頭の雌ぐまが出てきて、その子供らのうち四十二人を裂いた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.2.p9.b3": {
    "text": "彼はそこからカルメル山へ行き、そこからサマリヤに帰った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 2:25"
    },
    "adapted": false,
    "status": "approved"
  }
}
