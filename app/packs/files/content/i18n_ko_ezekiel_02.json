{
  "ezekiel.2.p1.b1": {
    "text": "인자야 일어서라 내가 네게 말하리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ezekiel 2:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.2.p1.b2": {
    "text": "말씀하실 때에 그 신이 내게 임하사 나를 일으켜 세우시기로",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ezekiel 2:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.2.p1.b3": {
    "text": "인자야 내가 너를 이스라엘 자손 곧 패역한 백성 나를 배반하는 자에게 보내노라 … 듣든지 아니 듣든지 그들 가운데 선지자 있은 줄은 알지니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ezekiel 2:3-5"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.2.p1.b4": {
    "text": "인자야 너는 비록 가시와 찔레와 함께 처하며 전갈 가운데 거할지라도 그들을 두려워 말고 … 그 얼굴을 무서워 말지어다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ezekiel 2:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.2.p1.b5": {
    "text": "인자야 내가 네게 이르는 말을 듣고 … 네 입을 벌리고 내가 네게 주는 것을 먹으라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ezekiel 2:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.2.p1.b6": {
    "text": "그가 그것을 내 앞에 펴시니 그 안팎에 글이 있는데 애가와 애곡과 재앙의 말이 기록되었더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Ezekiel 2:10"
    },
    "adapted": false,
    "status": "approved"
  }
}
