{
  "nahum.1.p1.b1": {
    "text": "ニネベについての託宣。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nahum 1:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "nahum.1.p1.b2": {
    "text": "エルコシびとナホムの幻の書。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nahum 1:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "nahum.1.p1.b3": {
    "text": "主はねたみ、かつあだを報いる神、主はあだを報いる者、また憤る者、主はおのがあだに報復し、おのが敵に対して憤りをいだく。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nahum 1:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "nahum.1.p1.b4": {
    "text": "主は怒ることおそく、力強き者、主は罰すべき者を決してゆるされない者",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nahum 1:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "nahum.1.p1.b5": {
    "text": "主の道はつむじ風と大風の中にあり、雲はその足のちりである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nahum 1:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "nahum.1.p1.b6": {
    "text": "彼は海を戒めて、これをかわかし、すべての川をかれさせる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nahum 1:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "nahum.1.p1.b7": {
    "text": "だれが彼の憤りの前に立つことができよう。……岩も彼によって裂かれる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nahum 1:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "nahum.1.p1.b8": {
    "text": "主は恵み深く、なやみの日の要害である。彼はご自分を避け所とする者を知っておられる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nahum 1:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "nahum.1.p1.b9": {
    "text": "しかし、彼はみなぎる洪水であだを全く滅ぼし、おのが敵を暗やみに追いやられる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nahum 1:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "nahum.1.p2.b1": {
    "text": "あなたがたは主に対して何を計るか。彼はその敵に二度としかえしをする必要がないように敵を全く滅ぼされる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nahum 1:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "nahum.1.p2.b2": {
    "text": "彼らは結びからまったいばらのように、かわいた刈り株のように、焼き尽される。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nahum 1:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "nahum.1.p2.b3": {
    "text": "主に対して悪事を計り、よこしまな事を勧める者があなたのうちから出たではないか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nahum 1:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "nahum.1.p2.b4": {
    "text": "たとい彼らは強く、かつ多くあっても、切り倒されて絶えはてる。わたしはあなたを苦しめたが、重ねてあなたを苦しめない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nahum 1:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "nahum.1.p2.b5": {
    "text": "今わたしは彼のくびきを砕いて、あなたからとり除き、あなたのなわめを切りはなす」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nahum 1:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "nahum.1.p2.b6": {
    "text": "わたしはあなたの神々の家から、彫像および鋳造を除き去る。あなたは罪深い者だから、わたしはあなたの墓を設ける",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nahum 1:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "nahum.1.p2.b7": {
    "text": "見よ、良きおとずれを伝える者の足は山の上にある。彼は平安を宣べている。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nahum 1:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "nahum.1.p2.b8": {
    "text": "ユダよ、あなたの祭を行い、あなたの誓願をはたせ。よこしまな者は重ねて、あなたに向かって攻めてこないからである。彼は全く断たれる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nahum 1:15"
    },
    "adapted": false,
    "status": "approved"
  }
}
