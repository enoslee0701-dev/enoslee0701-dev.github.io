{
  "exodus.39.p1.b1": {
    "text": "また金を打ち延べて板とし、これを切って糸とし、青糸、紫糸、緋糸、亜麻の撚糸に交えて、巧みな細工とした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 39:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.39.p1.b2": {
    "text": "彼らは青糸、紫糸、緋糸で、聖所の務のための編物の服を作った。またアロンのために聖なる服を作った。主がモーセに命じられたとおりである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 39:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.39.p1.b3": {
    "text": "これをエポデの肩ひもにつけて、イスラエルの子たちの記念の石とした。主がモーセに命じられたとおりである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 39:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.39.p2.b4": {
    "text": "その宝石はイスラエルの子たちの名にしたがい、その名と等しく十二とし、おのおの印の彫刻のように、十二部族のためにその名を刻んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 39:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.39.p2.b5": {
    "text": "……エポデの帯の上の方にくるようにした。こうして、胸当がエポデから離れないようにした。主がモーセに命じられたとおりである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 39:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.39.p2.b6": {
    "text": "また胸当を巧みなわざをもって、エポデの作りのように作った。……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 39:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.39.p3.b7": {
    "text": "またエポデに属する上服は、すべて青地の織物で作った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 39:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.39.p3.b8": {
    "text": "すなわち鈴にざくろ、鈴にざくろと、務の上服のすその周囲につけた。主がモーセに命じられたとおりである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 39:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.39.p3.b9": {
    "text": "また純金をもって、聖なる冠の前板を作り、印の彫刻のように、その上に「主に聖なる者」という文字を書き、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 39:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.39.p4.b10": {
    "text": "こうして会見の天幕なる幕屋の、もろもろの工事が終った。イスラエルの人々はすべて主がモーセに命じられたようにおこなった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 39:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.39.p4.b11": {
    "text": "彼らは幕屋と天幕およびそのもろもろの器をモーセのもとに携えてきた。……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 39:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.39.p4.b12": {
    "text": "イスラエルの人々は、すべて主がモーセに命じられたように、そのすべての工事をした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 39:42"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.39.p4.b13": {
    "text": "モーセがそのすべての工事を見ると、彼らは主が命じられたとおりに、それをなしとげていたので、モーセは彼らを祝福した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 39:43"
    },
    "adapted": false,
    "status": "approved"
  }
}
