{
  "matthew.28.p1.b1": {
    "text": "さて、安息日が終って、週の初めの日の明け方に、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p1.b2": {
    "text": "マグダラのマリヤとほかのマリヤとが、墓を見にきた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p1.b3": {
    "text": "すると、大きな地震が起った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p1.b4": {
    "text": "それは主の使が天から下って、そこにきて石をわきへころがし、その上にすわったからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p2.b1": {
    "text": "その姿はいなずまのように輝き、その衣は雪のように真白であった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p2.b2": {
    "text": "見張りをしていた人たちは、恐ろしさの余り震えあがって、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p2.b3": {
    "text": "死人のようになった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p3.b1": {
    "text": "恐れることはない。あなたがたが十字架におかかりになったイエスを捜していることは、わたしにわかっている",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p3.b2": {
    "text": "もうここにはおられない。かねて言われたとおりに、よみがえられたのである。さあ、イエスが納められていた場所をごらんなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p3.b3": {
    "text": "そして、急いで行って、弟子たちにこう伝えなさい、『イエスは死人の中からよみがえられた。見よ、あなたがたより先にガリラヤへ行かれる。そこでお会いできるであろう』。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p3.b4": {
    "text": "あなたがたに、これだけ言っておく",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p4.b1": {
    "text": "そこで女たちは恐れながらも大喜びで、急いで墓を立ち去り、弟子たちに知らせるために走って行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p4.b2": {
    "text": "すると、イエスは彼らに出会って",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p4.b3": {
    "text": "平安あれ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p4.b4": {
    "text": "彼らは近寄りイエスのみ足をいだいて拝した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p5.b1": {
    "text": "恐れることはない。行って兄弟たちに、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p5.b2": {
    "text": "ガリラヤに行け、そこでわたしに会えるであろう、と告げなさい",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p5.b3": {
    "text": "女たちが行っている間に、番人のうちのある人々が都に帰って、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p5.b4": {
    "text": "いっさいの出来事を祭司長たちに話した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p6.b1": {
    "text": "祭司長たちは長老たちと集まって協議をこらし、兵卒たちにたくさんの金を与えて言った",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p6.b2": {
    "text": "「『弟子たちが夜中にきて、われわれの寝ている間に彼を盗んだ』と言え。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p6.b3": {
    "text": "万一このことが総督の耳にはいっても、われわれが総督に説いて、あなたがたに迷惑が掛からないようにしよう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p6.b4": {
    "text": "そしてこの話は、今日に至るまでユダヤ人の間にひろまっている。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p7.b1": {
    "text": "さて、十一人の弟子たちはガリラヤに行って、イエスが彼らに行くように命じられた山に登った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p7.b2": {
    "text": "そして、イエスに会って拝した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p7.b3": {
    "text": "しかし、疑う者もいた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p8.b1": {
    "text": "イエスは彼らに近づいてきて言われた",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p8.b2": {
    "text": "わたしは、天においても地においても、いっさいの権威を授けられた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p8.b3": {
    "text": "それゆえに、あなたがたは行って、すべての国民を弟子として、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p8.b4": {
    "text": "父と子と聖霊との名によって、彼らにバプテスマを施し、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p9.b1": {
    "text": "あなたがたに命じておいたいっさいのことを守るように教えよ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p9.b2": {
    "text": "見よ、わたしは … いつもあなたがたと共にいるのである",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p9.b3": {
    "text": "世の終りまで",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 28:20"
    },
    "adapted": false,
    "status": "approved"
  }
}
