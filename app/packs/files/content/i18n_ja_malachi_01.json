{
  "malachi.1.p1.b1": {
    "text": "マラキによってイスラエルに臨んだ主の言葉の託宣。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Malachi 1:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "malachi.1.p1.b2": {
    "text": "わたしはあなたがたを愛した",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Malachi 1:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "malachi.1.p1.b3": {
    "text": "あなたはどんなふうに、われわれを愛されたか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Malachi 1:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "malachi.1.p1.b4": {
    "text": "エサウはヤコブの兄ではないか。しかしわたしはヤコブを愛し、エサウを憎んだ。かつ、わたしは彼の山地を荒し、その嗣業を荒野の山犬に与えた……彼らは建てるかもしれない。しかしわたしはそれを倒す……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Malachi 1:2-4"
    },
    "adapted": false,
    "status": "approved"
  },
  "malachi.1.p1.b5": {
    "text": "あなたがたの目はこれを見て、「主はイスラエルの境を越えて大いなる神である」と言うであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Malachi 1:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "malachi.1.p2.b1": {
    "text": "子はその父を敬い、しもべはその主人を敬う。それでわたしがもし父であるならば、あなたがたのわたしを敬う事実が、どこにあるか。わたしがもし主人であるならば、わたしを恐れる事実が、どこにあるか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Malachi 1:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "malachi.1.p2.b2": {
    "text": "われわれはどんなふうにあなたの名を侮ったか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Malachi 1:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "malachi.1.p2.b3": {
    "text": "汚れた食物をわたしの祭壇の上にささげる……主の台は卑しむべき物である",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Malachi 1:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "malachi.1.p2.b4": {
    "text": "あなたがたが盲目の獣を、犠牲にささげるのは悪い事ではないか。また足のなえたもの、病めるものをささげるのは悪い事ではないか。今これをあなたのつかさにささげてみよ。彼はあなたを喜び、あなたを受けいれるであろうか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Malachi 1:8-9"
    },
    "adapted": false,
    "status": "approved"
  },
  "malachi.1.p2.b5": {
    "text": "あなたがたがわが祭壇の上にいたずらに、火をたくことのないように戸を閉じる者があなたがたのうちに、ひとりあったらいいのだが",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Malachi 1:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "malachi.1.p2.b6": {
    "text": "日の出る所から没する所まで、国々のうちにわが名はあがめられている",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Malachi 1:11-12"
    },
    "adapted": false,
    "status": "approved"
  },
  "malachi.1.p2.b7": {
    "text": "これはなんと煩わしい事か",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Malachi 1:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "malachi.1.p2.b8": {
    "text": "群れのうちに雄の獣があり、それをささげると誓いを立てているのに、傷のあるものを、主にささげる偽り者はのろわれる……わたしは大いなる王で、わが名は国々のうちに恐れられるべきである",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Malachi 1:13-14"
    },
    "adapted": false,
    "status": "approved"
  }
}
