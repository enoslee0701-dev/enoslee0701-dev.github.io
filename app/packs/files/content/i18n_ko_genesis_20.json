{
  "genesis.20.p1.b1": {
    "text": "아브라함이 거기서 남방으로 이사하여 가데스와 술 사이 그랄에 우거하며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 20:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p1.b2": {
    "text": "그 아내 사라를 자기 누이라 하였으므로 그랄 왕 아비멜렉이 보내어 사라를 취하였더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 20:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p1.b3": {
    "text": "네가 취한 이 여인을 인하여 네가 죽으리니 그가 남의 아내임이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 20:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p2.b4": {
    "text": "주여 주께서 의로운 백성도 멸하시나이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 20:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p2.b5": {
    "text": "나는 온전한 마음과 깨끗한 손으로 이렇게 하였나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 20:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p2.b6": {
    "text": "네가 온전한 마음으로 이렇게 한 줄을 나도 알았으므로 너를 막아 내게 범죄하지 않게 하였나니 여인에게 가까이 못하게 함이 이 까닭이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 20:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p2.b7": {
    "text": "이제 그 사람의 아내를 돌려 보내라 그는 선지자라 그가 너를 위하여 기도하리니 네가 살려니와",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 20:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p3.b8": {
    "text": "아비멜렉이 그 아침에 일찌기 일어나 모든 신복을 불러 그 일을 다 말하여 들리매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 20:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p3.b9": {
    "text": "그 사람들이 심히 두려워하였더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 20:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p3.b10": {
    "text": "네가 어찌하여 우리에게 이리 하느냐 … 네가 합당치 않은 일을 내게 행하였도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 20:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p3.b11": {
    "text": "네가 무슨 의견으로 이렇게 하였느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 20:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p4.b12": {
    "text": "이곳에서는 하나님을 두려워함이 없으니 내 아내를 인하여 사람이 나를 죽일까 생각하였음이요",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 20:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p4.b13": {
    "text": "또 그는 실로 나의 이복 누이로서 내 처가 되었음이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 20:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p4.b14": {
    "text": "하나님이 나로 내 아비 집을 떠나 두루 다니게 하실 때에 내가 아내에게 말하기를 이후로 우리의 가는 곳마다 그대는 나를 그대의 오라비라 하라 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 20:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p5.b15": {
    "text": "아비멜렉이 양과 소와 노비를 취하여 아브라함에게 주고 그 아내 사라도 그에게 돌려보내고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 20:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p5.b16": {
    "text": "내 땅이 네 앞에 있으니 너 보기에 좋은 대로 거하라 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 20:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p5.b17": {
    "text": "내가 은 천개를 네 오라비에게 주어서 그것으로 너와 함께 한 여러사람 앞에서 네 수치를 풀게 하였노니 네 일이 다 선히 해결 되었느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 20:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.20.p5.b18": {
    "text": "아브라함이 하나님께 기도하매 하나님이 아비멜렉과 그 아내와 여종을 치료하사 생산케 하셨으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 20:17"
    },
    "adapted": false,
    "status": "approved"
  }
}
