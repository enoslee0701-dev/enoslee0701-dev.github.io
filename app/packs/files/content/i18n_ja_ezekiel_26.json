{
  "ezekiel.26.p1.b1": {
    "text": "ああ、それはよい気味である。もろもろの民の門は破れて、わたしに開かれた。わたしは豊かになり、彼は破れはてた",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 26:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.26.p1.b2": {
    "text": "ツロよ、わたしはあなたを攻め、海がその波を起すように、わたしは多くの国民を、あなたに攻めこさせる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 26:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.26.p1.b3": {
    "text": "見よ、わたしは王の王なるバビロンの王ネブカデレザルに、馬、戦車、騎兵、および多くの軍勢をひきいて、北からツロに攻めこさせる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 26:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.26.p1.b4": {
    "text": "城壁をくずし、楽しい家をこわし、石と木と土とを水の中に投げ込む。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 26:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.26.p1.b5": {
    "text": "わたしはあなたを裸の岩にする。あなたは網を張る場所となり、再び建てられることはない",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 26:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.26.p2.b1": {
    "text": "その時、海の君たちは皆その位からおり、朝服を脱ぎ、縫い取りの衣服を取り去り、恐れを身にまとい、地に座して、いたく恐れ、あなたの事を驚き",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 26:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.26.p2.b2": {
    "text": "あなたは海にあって、強い誉ある町、本土に恐れを与えていたあなたも、その住民も、海から消え去った",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 26:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.26.p2.b3": {
    "text": "島々はあなたの倒れる日に身震いする",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 26:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.26.p2.b4": {
    "text": "わたしはあなたを、荒れた町となし、住む者のない町のようにし、淵をあなたに向かってわきあがらせ、大水にあなたをおおわせる時",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 26:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.26.p2.b5": {
    "text": "あなたを尋ねる人があっても、永久に見いださない",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 26:21"
    },
    "adapted": false,
    "status": "approved"
  }
}
