{
  "corinthians2.4.p1.b1": {
    "text": "我们既然蒙怜悯，受了这职分，就不丧胆，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Corinthians 4:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我⁠们既⁠然蒙怜⁠悯，受了这职分，就⁠不丧胆，"
  },
  "corinthians2.4.p1.b2": {
    "text": "我们原不是传自己，乃是传基督耶稣为主，并且自己因耶稣作你们的仆人。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Corinthians 4:5"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我⁠们原不⁠是传自⁠己，乃⁠是传基⁠督耶⁠稣为主，并⁠且自⁠己因耶⁠稣作你⁠们的仆⁠人。"
  },
  "corinthians2.4.p1.b3": {
    "text": "那吩咐光从黑暗里照出来的　神，已经照在我们心里，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Corinthians 4:6"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "那吩⁠咐光从黑⁠暗里照出⁠来的　神，已⁠经照⁠在我⁠们心⁠里，"
  },
  "corinthians2.4.p2.b1": {
    "text": "我们有这宝贝放在瓦器里，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Corinthians 4:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我⁠们有这宝⁠贝放⁠在瓦⁠器里，"
  },
  "corinthians2.4.p2.b2": {
    "text": "要显明这莫大的能力是出于　神，不是出于我们。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Corinthians 4:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "要显⁠明这莫⁠大的能⁠力是出⁠于　神，不⁠是出⁠于我⁠们。"
  },
  "corinthians2.4.p3.b1": {
    "text": "我们四面受敌，却不被困住；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Corinthians 4:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我⁠们四⁠面受⁠敌，却不⁠被困⁠住；"
  },
  "corinthians2.4.p3.b2": {
    "text": "心里作难，却不至失望；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Corinthians 4:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "心⁠里作难，却不至失⁠望；"
  },
  "corinthians2.4.p3.b3": {
    "text": "遭逼迫，却不被丢弃；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Corinthians 4:9"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "遭逼⁠迫，却不⁠被丢⁠弃；"
  },
  "corinthians2.4.p3.b4": {
    "text": "打倒了，却不至死亡。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Corinthians 4:9"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "打⁠倒了，却不至死⁠亡。"
  },
  "corinthians2.4.p4.b1": {
    "text": "……我们也信，所以也说话。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Corinthians 4:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "……我⁠们也信，所⁠以也说⁠话。"
  },
  "corinthians2.4.p4.b2": {
    "text": "……并且叫我们与你们一同站在他面前。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Corinthians 4:14"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "……并⁠且叫我⁠们与你⁠们一⁠同站⁠在他面⁠前。"
  },
  "corinthians2.4.p4.b3": {
    "text": "好叫恩惠因人多越发加增，感谢格外显多，以致荣耀归与　神。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Corinthians 4:15"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "好叫恩⁠惠因人多越发加⁠增，感⁠谢格⁠外显多，以⁠致荣⁠耀归与　神。"
  },
  "corinthians2.4.p5.b1": {
    "text": "所以，我们不丧胆。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Corinthians 4:16"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "所⁠以，我⁠们不丧胆。"
  },
  "corinthians2.4.p5.b2": {
    "text": "外体虽然毁坏，内心却一天新似一天。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Corinthians 4:16"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "外体虽⁠然毁⁠坏，内⁠心却一⁠天新似一⁠天。"
  },
  "corinthians2.4.p5.b3": {
    "text": "因为所见的是暂时的，所不见的是永远的。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Corinthians 4:18"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "因⁠为所见的⁠是暂⁠时的，所不⁠见的⁠是永⁠远的。"
  }
}
