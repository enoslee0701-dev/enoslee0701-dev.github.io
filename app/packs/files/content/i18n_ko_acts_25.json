{
  "acts.25.p1.b1": {
    "text": "베스도가 도임한지 삼일 후에 가이사랴에서 예루살렘으로 올라가니 대제사장들과 유대인 중 높은 사람들이 바울을 고소할새",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:1-2"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.25.p1.b2": {
    "text": "…길에 매복하였다가 그를 죽이고자 함이러라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.25.p1.b3": {
    "text": "바울이 가이사랴에 구류된 것과 자기도 미구에 떠나갈 것을 말하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.25.p1.b4": {
    "text": "그가 나오매 예루살렘에서 내려온 유대인들이 둘러 서서 여러가지 중대한 사건으로 송사하되 능히 증명하지 못한지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.25.p2.b5": {
    "text": "“유대인의 율법이나 성전이나 가이사에게나 내가 도무지 죄를 범하지 아니하였노라”",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.25.p2.b6": {
    "text": "베스도가 유대인의 마음을 얻고자하여 바울더러 묻되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.25.p2.b7": {
    "text": "“네가 예루살렘에 올라가서 이 사건에 대하여 내 앞에서 심문을 받으려느냐”",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.25.p3.b8": {
    "text": "“내가 가이사의 재판 자리 앞에 섰으니 마땅히 거기서 심문을 받을 것이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.25.p3.b9": {
    "text": "당신도 잘 아시는 바에 내가 유대인들에게 불의를 행한 일이 없나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.25.p3.b10": {
    "text": "만일 내가 불의를 행하여 무슨 사죄를 범하였으면 죽기를 사양치아니할 것이나",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.25.p3.b11": {
    "text": "만일 이 사람들의 나를 송사하는 것이 다 사실이 아니면 누구든지 나를 그들에게 내어 줄수 없삽나이다 내가 가이사께 호소하노라”",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.25.p4.b12": {
    "text": "베스도가 배석자들과 상의하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.25.p4.b13": {
    "text": "“네가 가이사에게 호소하였으니 가이사에게 갈 것이라”",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.25.p4.b14": {
    "text": "수일 후에",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.25.p4.b15": {
    "text": "아그립바왕과 버니게가 베스도에게 문안하러 가이샤랴에 와서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.25.p5.b16": {
    "text": "“벨릭스가 한 사람을 구류하여 두었는데”",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.25.p5.b17": {
    "text": "내가 예루살렘에 있을 때에 유대인의 대제사장들과 장로들이 그를 고소하여 정죄하기를 청하기에",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.25.p5.b18": {
    "text": "“무릇 피고가 원고들 앞에서 고소 사건에 대하여 변명할 기회가 있기 전에 내어주는 것이 로마 사람의 법이 아니라”",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.25.p6.b19": {
    "text": "“…내가 지체하지 아니하고 이튿날 재판 자리에 앉아 명하여 그 사람을 데려 왔으나”",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.25.p6.b20": {
    "text": "원고들이 서서 나의 짐작하던 것 같은 악행의 사건은 하나도 제출치 아니하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.25.p6.b21": {
    "text": "“…예수라 하는 이의 죽은 것을",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.25.p6.b22": {
    "text": "살았다고 바울이 주장하는…”",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.25.p7.b23": {
    "text": "“내가 이 일을 어떻게 사실할는지 의심이 있어서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.25.p7.b24": {
    "text": "바울은 황제의 판결을 받도록 자기를 지켜 주기를 호소하므로",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.25.p7.b25": {
    "text": "“나도 이 사람의 말을 듣고자 하노라”",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.25.p7.b26": {
    "text": "“내일 들으시리이다”",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.25.p8.b27": {
    "text": "이튿날",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.25.p8.b28": {
    "text": "아그립바와 버니게가 크게 위의를 베풀고 와서 천부장들과 성중의 높은 사람들과 함께 신문소에 들어오고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.25.p8.b29": {
    "text": "베스도의 명으로 바울을 데려오니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.25.p9.b30": {
    "text": "“아그립바왕과 여기 같이 있는 여러분이여 당신들이 보는 이 사람은 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.25.p9.b31": {
    "text": "…살려 두지 못할 사람…”",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.25.p9.b32": {
    "text": "“그에게 대하여 황제께 확실한 사실을 아뢸 것이 없으므로…”",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.25.p9.b33": {
    "text": "그 죄목을 베풀지 아니하고 죄수를 보내는 것이 무리한 일인줄 아나이다 하였더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 25:27"
    },
    "adapted": false,
    "status": "approved"
  }
}
