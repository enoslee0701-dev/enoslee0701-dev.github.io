{
  "acts.13.p1.b1": {
    "text": "さて、アンテオケにある教会には、バルナバ、ニゲルと呼ばれるシメオン、クレネ人ルキオ、領主ヘロデの乳兄弟マナエン、およびサウロなどの預言者や教師がいた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p1.b2": {
    "text": "一同が主に礼拝をささげ、断食をしていると、聖霊が",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p1.b3": {
    "text": "「さあ、バルナバとサウロとを、わたしのために聖別して、彼らに授けておいた仕事に当らせなさい」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p1.b4": {
    "text": "そこで一同は、断食と祈とをして、手をふたりの上においた後、出発させた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p2.b5": {
    "text": "ふたりは聖霊に送り出されて、セルキヤにくだり、そこから舟でクプロに渡った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p2.b6": {
    "text": "そしてサラミスに着くと、ユダヤ人の諸会堂で神の言を宣べはじめた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p2.b7": {
    "text": "彼らはヨハネを助け手として連れていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p3.b8": {
    "text": "島全体を巡回して、パポスまで行ったところ、そこでユダヤ人の魔術師、バルイエスというにせ預言者に出会った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p3.b9": {
    "text": "彼は地方総督セルギオ・パウロのところに出入りをしていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p3.b10": {
    "text": "この総督は賢明な人であって、バルナバとサウロとを招いて、神の言を聞こうとした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p3.b11": {
    "text": "ところが魔術師エルマ（彼の名は「魔術師」との意）は、総督を信仰からそらそうとして、しきりにふたりの邪魔をした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p4.b12": {
    "text": "サウロ、またの名はパウロ、は聖霊に満たされ、彼をにらみつけて",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p4.b13": {
    "text": "「ああ、あらゆる偽りと邪悪とでかたまっている悪魔の子よ、すべて正しいものの敵よ。主のまっすぐな道を曲げることを止めないのか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p5.b14": {
    "text": "見よ、主のみ手がおまえの上に及んでいる。おまえは盲になって、当分、日の光が見えなくなるのだ」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p5.b15": {
    "text": "たちまち、かすみとやみとが彼にかかったため、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p5.b16": {
    "text": "彼は手さぐりしながら、手を引いてくれる人を捜しまわった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p5.b17": {
    "text": "総督はこの出来事を見て、主の教にすっかり驚き、そして信じた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p6.b18": {
    "text": "パウロとその一行は、パポスから船出して、パンフリヤのペルガに渡った。ここでヨハネは一行から身を引いて、エルサレムに帰ってしまった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p6.b19": {
    "text": "しかしふたりは、ペルガからさらに進んで、ピシデヤのアンテオケに行き、安息日に会堂にはいって席に着いた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p6.b20": {
    "text": "律法と預言書の朗読があったのち、会堂司たちが彼らのところに人をつかわして、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p6.b21": {
    "text": "「兄弟たちよ、もしあなたがたのうち、どなたか、この人々に何か奨励の言葉がありましたら、どうぞお話し下さい」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p7.b22": {
    "text": "「イスラエルの人たち、ならびに神を敬うかたがたよ、お聞き下さい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p7.b23": {
    "text": "この民イスラエルの神は、わたしたちの先祖を選び、エジプトの地に滞在中、この民を大いなるものとし、み腕を高くさし上げて、彼らをその地から導き出された。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p7.b24": {
    "text": "そして約四十年にわたって、荒野で彼らをはぐくみ、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p7.b25": {
    "text": "カナンの地では七つの異民族を打ち滅ぼし、その地を彼らに譲り与えられた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p8.b26": {
    "text": "それらのことが約四百五十年の年月にわたった。その後、神はさばき人たちをおつかわしになり、預言者サムエルの時に及んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p8.b27": {
    "text": "その時、人々が王を要求したので、神はベニヤミン族の人、キスの子サウロを四十年間、彼らにおつかわしになった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p8.b28": {
    "text": "それから神はサウロを退け、ダビデを立てて王とされたが、彼についてあかしをして、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p8.b29": {
    "text": "『わたしはエッサイの子ダビデを見つけた。彼はわたしの心にかなった人で、わたしの思うところを、ことごとく実行してくれるであろう』",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p9.b30": {
    "text": "神は約束にしたがって、このダビデの子孫の中から救主イエスをイスラエルに送られたが、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p9.b31": {
    "text": "そのこられる前に、ヨハネがイスラエルのすべての民に悔改めのバプテスマを、あらかじめ宣べ伝えていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p9.b32": {
    "text": "… わたしは、あなたがたが考えているような者ではない。しかし、わたしのあとから来るかたがいる。わたしはそのくつを脱がせてあげる値うちもない",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p10.b33": {
    "text": "兄弟たち、アブラハムの子孫のかたがた、ならびに皆さんの中の神を敬う人たちよ。この救の言葉はわたしたちに送られたのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p10.b34": {
    "text": "エルサレムに住む人々やその指導者たちは、イエスを認めずに … なんら死に当る理由が見いだせなかったのに、ピラトに強要してイエスを殺してしまった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:27-28"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p10.b35": {
    "text": "そして、イエスについて書いてあることを、皆なし遂げてから、人々はイエスを木から取りおろして墓に葬った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p10.b36": {
    "text": "しかし、神はイエスを死人の中から、よみがえらせたのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p11.b37": {
    "text": "わたしたちは、神が先祖たちに対してなされた約束を、ここに宣べ伝えているのである。 神は、イエスをよみがえらせて、わたしたち子孫にこの約束を、お果しになった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:32-33"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p11.b38": {
    "text": "それは詩篇の第二篇にも、『あなたこそは、わたしの子。きょう、わたしはあなたを生んだ』と書いてあるとおりである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p11.b39": {
    "text": "事実、ダビデは、その時代の人々に神のみ旨にしたがって仕えたが、やがて眠りにつき、先祖たちの中に加えられて、ついに朽ち果ててしまった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:36"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p11.b40": {
    "text": "しかし、神がよみがえらせたかたは、朽ち果てることがなかったのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:37"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p12.b41": {
    "text": "だから、兄弟たちよ、この事を承知しておくがよい。すなわち、このイエスによる罪のゆるしの福音が、今やあなたがたに宣べ伝えられている。そして、モーセの律法では義とされることができなかったすべての事についても、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p12.b42": {
    "text": "信じる者はもれなく、イエスによって義とされるのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p12.b43": {
    "text": "だから預言者たちの書にかいてある次のようなことが、あなたがたの身に起らないように気をつけなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p12.b44": {
    "text": "『見よ、侮る者たちよ。驚け、そして滅び去れ。… 人がどんなに説明して聞かせても、あなたがたのとうてい信じないような事なのである』",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p13.b45": {
    "text": "ふたりが会堂を出る時、人々は次の安息日にも、これと同じ話をしてくれるようにと、しきりに願った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:42"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p13.b46": {
    "text": "大ぜいのユダヤ人や信心深い改宗者たちが、パウロとバルナバとについてきたので、ふたりは、彼らが引きつづき神のめぐみにとどまっているようにと、説きすすめた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:43"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p13.b47": {
    "text": "次の安息日には、ほとんど全市をあげて、神の言を聞きに集まってきた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:44"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p13.b48": {
    "text": "するとユダヤ人たちは、その群衆を見てねたましく思い、パウロの語ることに口ぎたなく反対した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:45"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p14.b49": {
    "text": "「神の言は、まず、あなたがたに語り伝えられなければならなかった。しかし、あなたがたはそれを退け、自分自身を永遠の命にふさわしからぬ者にしてしまったから、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:46"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p14.b50": {
    "text": "さあ、わたしたちはこれから方向をかえて、異邦人たちの方に行くのだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:46"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p14.b51": {
    "text": "主はわたしたちに、こう命じておられる、『わたしは、あなたを立てて異邦人の光とした。あなたが地の果までも救をもたらすためである』」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:47"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p15.b52": {
    "text": "異邦人たちはこれを聞いてよろこび、主の御言をほめたたえてやまなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:48"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p15.b53": {
    "text": "そして、永遠の命にあずかるように定められていた者は、みな信じた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:48"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p15.b54": {
    "text": "こうして、主の御言はこの地方全体にひろまって行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:49"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p16.b55": {
    "text": "ところが、ユダヤ人たちは、信心深い貴婦人たちや町の有力者たちを煽動して、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:50"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p16.b56": {
    "text": "パウロとバルナバを迫害させ、ふたりをその地方から追い出させた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:50"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p16.b57": {
    "text": "ふたりは、彼らに向けて足のちりを払い落して、イコニオムへ行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:51"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.13.p16.b58": {
    "text": "弟子たちは、ますます喜びと聖霊とに満たされていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 13:52"
    },
    "adapted": false,
    "status": "approved"
  }
}
