{
  "genesis.9.p1.b1": {
    "text": "生めよ、ふえよ、地に満ちよ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 9:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.9.p1.b2": {
    "text": "地のすべての獣、空のすべての鳥、地に這うすべてのもの、海のすべての魚は恐れおののいて …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 9:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.9.p1.b3": {
    "text": "すべて生きて動くものはあなたがたの食物となるであろう。さきに青草をあなたがたに与えたように、わたしはこれらのものを皆あなたがたに与える。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 9:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.9.p1.b4": {
    "text": "… 神が自分のかたちに人を造られたゆえに。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 9:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.9.p2.b5": {
    "text": "「わたしはあなたがた及びあなたがたの後の子孫と契約を立てる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 9:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.9.p2.b6": {
    "text": "またあなたがたと共にいるすべての生き物、あなたがたと共にいる鳥、家畜、地のすべての獣、すなわち、すべて箱舟から出たものは、地のすべての獣にいたるまで、わたしはそれと契約を立てよう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 9:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.9.p2.b7": {
    "text": "すべて肉なる者は、もはや洪水によって滅ぼされることはなく、また地を滅ぼす洪水は、再び起らないであろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 9:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.9.p3.b8": {
    "text": "すなわち、わたしは雲の中に、にじを置く。これがわたしと地との間の契約のしるしとなる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 9:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.9.p3.b9": {
    "text": "… 水はふたたび、すべて肉なる者を滅ぼす洪水とはならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 9:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.9.p3.b10": {
    "text": "これがわたしと地にあるすべて肉なるものとの間に、わたしが立てた契約のしるしである",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 9:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.9.p4.b11": {
    "text": "箱舟から出たノアの子らはセム、ハム、ヤペテであった。ハムはカナンの父である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 9:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.9.p4.b12": {
    "text": "この三人はノアの子らで、全地の民は彼らから出て、広がったのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 9:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.9.p5.b13": {
    "text": "さてノアは農夫となり、ぶどう畑をつくり始めたが、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 9:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.9.p5.b14": {
    "text": "彼はぶどう酒を飲んで酔い …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 9:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.9.p5.b15": {
    "text": "… 天幕の中で裸になっていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 9:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.9.p6.b16": {
    "text": "カナンの父ハムは父の裸を見て、外にいるふたりの兄弟に告げた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 9:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.9.p6.b17": {
    "text": "セムとヤペテとは着物を取って、肩にかけ、うしろ向きに歩み寄って、父の裸をおおい …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 9:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.9.p6.b18": {
    "text": "… 顔をそむけて父の裸を見なかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 9:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.9.p7.b19": {
    "text": "カナンはのろわれよ。彼はしもべのしもべとなって、その兄弟たちに仕える",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 9:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.9.p7.b20": {
    "text": "セムの神、主はほむべきかな … 神はヤペテを大いならしめ、セムの天幕に彼を住まわせられるように。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 9:26-27"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.9.p7.b21": {
    "text": "ノアは洪水の後、なお三百五十年生きた。 ノアの年は合わせて九百五十歳であった。そして彼は死んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 9:28-29"
    },
    "adapted": false,
    "status": "approved"
  }
}
