{
  "samuel2.22.p1.b1": {
    "text": "ダビデは主がもろもろの敵の手とサウルの手から、自分を救い出された日に",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 22:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p1.b2": {
    "text": "この歌の言葉を主に向かって述べ …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 22:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p2.b1": {
    "text": "主はわが岩、わが城、わたしを救う者",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 22:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p2.b2": {
    "text": "わが神、わが岩。わたしは彼に寄り頼む。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 22:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p2.b3": {
    "text": "わが盾、わが救の角、わが高きやぐら、わが避け所",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 22:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p2.b4": {
    "text": "わたしは、ほめまつるべき主に呼ばわって、わたしの敵から救われる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 22:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p3.b1": {
    "text": "死の波はわたしをとりまき、滅びの大水はわたしを襲った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 22:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p3.b2": {
    "text": "陰府の綱はわたしをとりかこみ、死のわなはわたしに、たち向かった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 22:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p3.b3": {
    "text": "苦難のうちにわたしは主を呼び、またわが神に呼ばわった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 22:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p3.b4": {
    "text": "主がその宮からわたしの声を聞かれて、わたしの叫びはその耳にとどいた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 22:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p4.b1": {
    "text": "その時地は震いうごき、天の基はゆるぎふるえた。彼が怒られたからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 22:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p4.b2": {
    "text": "煙はその鼻からたち上り、火はその口から出て焼きつくし、白熱の炭は彼から燃え出た。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 22:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p4.b3": {
    "text": "彼は天を低くして下られ、暗やみが彼の足の下にあった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 22:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p4.b4": {
    "text": "彼はケルブに乗って飛び、風の翼に乗ってあらわれた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 22:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p5.b1": {
    "text": "彼はまた矢を放って彼らを散らし、いなずまを放って彼らを撃ち破られた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 22:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p5.b2": {
    "text": "主のとがめと、その鼻のいぶきとによって、海の底はあらわれ、世界の基が、あらわになった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 22:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p5.b3": {
    "text": "彼は高き所から手を伸べてわたしを捕え、大水の中からわたしを引き上げ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 22:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p5.b4": {
    "text": "彼はまたわたしを広い所へ引きだされ、わたしを喜ばれて、救ってくださった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 22:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p6.b1": {
    "text": "主はわたしの義にしたがってわたしに報い、わたしの手の清きにしたがってわたしに報いかえされた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 22:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p6.b2": {
    "text": "忠実な者には、あなたは忠実な者となり、欠けた所のない人には、あなたは欠けた所のない者となり",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 22:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p6.b3": {
    "text": "あなたはへりくだる民を救われる、しかしあなたの目は高ぶる者を見てこれをひくくせられる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 22:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p7.b1": {
    "text": "まことに、主よ、あなたはわたしのともし火、わが神はわたしのやみを照される。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 22:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p7.b2": {
    "text": "まことに、あなたによってわたしは敵軍をふみ滅ぼし、わが神によって石がきをとび越えることができる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 22:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p7.b3": {
    "text": "わたしの足をめじかの足のようにして、わたしを高い所に安全に立たせ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 22:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p7.b4": {
    "text": "わたしの手を戦いに慣らされたので、わたしの腕は青銅の弓を引くことができる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 22:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p8.b1": {
    "text": "わたしは敵を追って、これを滅ぼし、これを絶やすまでは帰らなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 22:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p8.b2": {
    "text": "あなたによって、敵はそのうしろをわたしに向けたので、わたしを憎む者をわたしは滅ぼした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 22:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p8.b3": {
    "text": "異国の人たちはきてわたしにこび、わたしの事を聞くとすぐわたしに従った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 22:45"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p8.b4": {
    "text": "異国の人たちは、うちしおれてその城からふるえながら出てきた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 22:46"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p9.b1": {
    "text": "主は生きておられる。わが岩はほむべきかな。わが神、わが救の岩はあがむべきかな。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 22:47"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p9.b2": {
    "text": "それゆえ、主よ、わたしはもろもろの国民の中で、あなたをたたえ、あなたの、み名をほめ歌うであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 22:50"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.22.p9.b3": {
    "text": "主はその王に大いなる勝利を与え、油を注がれた者に、ダビデとその子孫とに、とこしえに、いつくしみを施される",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 22:51"
    },
    "adapted": false,
    "status": "approved"
  }
}
