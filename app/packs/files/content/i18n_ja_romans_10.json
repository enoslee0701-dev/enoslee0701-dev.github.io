{
  "romans.10.p1.b1": {
    "text": "兄弟たちよ。わたしの心の願い、彼らのために神にささげる祈は、彼らが救われることである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 10:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.10.p1.b2": {
    "text": "わたしは、彼らが神に対して熱心であることはあかしするが、その熱心は深い知識によるものではない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 10:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.10.p1.b3": {
    "text": "キリストは、すべて信じる者に義を得させるために、律法の終りとなられたのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 10:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.10.p2.b1": {
    "text": "言葉はあなたの近くにある。あなたの口にあり、心にある …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 10:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.10.p2.b2": {
    "text": "すなわち、自分の口で、イエスは主であると告白し、自分の心で、神が死人の中からイエスをよみがえらせたと信じるなら、あなたは救われる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 10:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.10.p3.b1": {
    "text": "聖書は、「すべて彼を信じる者は、失望に終ることがない」と言っている。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 10:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.10.p3.b2": {
    "text": "ユダヤ人とギリシヤ人との差別はない。同一の主が万民の主であって …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 10:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.10.p3.b3": {
    "text": "なぜなら、「主の御名を呼び求める者は、すべて救われる」とあるからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 10:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.10.p4.b1": {
    "text": "… 聞いたことのない者を、どうして信じることがあろうか。宣べ伝える者がいなくては、どうして聞くことがあろうか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 10:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.10.p4.b2": {
    "text": "つかわされなくては、どうして宣べ伝えることがあろうか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 10:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.10.p4.b3": {
    "text": "「ああ、麗しいかな、良きおとずれを告げる者の足は」と書いてあるとおりである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 10:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.10.p5.b1": {
    "text": "… その声は全地にひびきわたり、その言葉は世界のはてにまで及んだ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 10:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.10.p5.b2": {
    "text": "わたしは、わたしを求めない者たちに見いだされ、わたしを尋ねない者に、自分を現した",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 10:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.10.p5.b3": {
    "text": "そして、イスラエルについては、「わたしは服従せずに反抗する民に、終日わたしの手をさし伸べていた」と言っている。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 10:21"
    },
    "adapted": false,
    "status": "approved"
  }
}
