{
  "genesis.17.p1.b1": {
    "text": "アブラムの九十九歳の時、主はアブラムに現れて言われた、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 17:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.17.p1.b2": {
    "text": "「わたしは全能の神である。あなたはわたしの前に歩み、全き者であれ。わたしはあなたと契約を結び、大いにあなたの子孫を増すであろう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 17:1-2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.17.p1.b3": {
    "text": "アブラムは、ひれ伏した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 17:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.17.p2.b4": {
    "text": "「わたしはあなたと契約を結ぶ。あなたは多くの国民の父となるであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 17:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.17.p2.b5": {
    "text": "あなたの名は、もはやアブラムとは言われず、あなたの名はアブラハムと呼ばれるであろう。わたしはあなたを多くの国民の父とするからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 17:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.17.p2.b6": {
    "text": "わたしはあなたに多くの子孫を得させ、国々の民をあなたから起そう。また、王たちもあなたから出るであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 17:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.17.p2.b7": {
    "text": "わたしはあなたと後の子孫とにあなたの宿っているこの地、すなわちカナンの全地を永久の所有として与える。そしてわたしは彼らの神となるであろう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 17:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.17.p3.b8": {
    "text": "「あなたと後の子孫とは共に代々わたしの契約を守らなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 17:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.17.p3.b9": {
    "text": "… 男子はみな割礼をうけなければならない。… それがわたしとあなたがたとの間の契約のしるしとなるであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 17:10-11"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.17.p3.b10": {
    "text": "あなたがたのうちの男子はみな代々、… 生れて八日目に割礼を受けなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 17:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.17.p3.b11": {
    "text": "… こうしてわたしの契約はあなたがたの身にあって永遠の契約となるであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 17:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.17.p4.b12": {
    "text": "「あなたの妻サライは、もはや名をサライといわず、名をサラと言いなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 17:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.17.p4.b13": {
    "text": "わたしは彼女を祝福し、また彼女によって、あなたにひとりの男の子を授けよう。… 彼女を国々の民の母としよう。…」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 17:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.17.p4.b14": {
    "text": "アブラハムはひれ伏して笑い、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 17:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.17.p4.b15": {
    "text": "「百歳の者にどうして子が生れよう。サラはまた九十歳にもなって、どうして産むことができようか」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 17:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.17.p5.b16": {
    "text": "「どうかイシマエルがあなたの前に生きながらえますように」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 17:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.17.p5.b17": {
    "text": "「いや、あなたの妻サラはあなたに男の子を産むでしょう。名をイサクと名づけなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 17:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.17.p5.b18": {
    "text": "またイシマエルについてはあなたの願いを聞いた。… 彼は十二人の君たちを生むであろう。わたしは彼を大いなる国民としよう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 17:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.17.p5.b19": {
    "text": "神はアブラハムと語り終え、彼を離れて、のぼられた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 17:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.17.p6.b20": {
    "text": "アブラハムは神が自分に言われたように、この日 …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 17:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.17.p6.b21": {
    "text": "… その子イシマエルと、すべて家に生れた者およびすべて銀で買い取った者、すなわちアブラハムの家の人々のうち、すべての男子を連れてきて、前の皮に割礼を施した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 17:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.17.p6.b22": {
    "text": "アブラハムが前の皮に割礼を受けた時は九十九歳、 その子イシマエルが前の皮に割礼を受けた時は十三歳であった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 17:24-25"
    },
    "adapted": false,
    "status": "approved"
  }
}
