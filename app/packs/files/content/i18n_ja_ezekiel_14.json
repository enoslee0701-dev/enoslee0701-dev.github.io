{
  "ezekiel.14.p1.b1": {
    "text": "ここにイスラエルの長老のうちのある人々が、わたしの所に来て、わたしの前に座した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 14:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.14.p1.b2": {
    "text": "人の子よ、これらの人々は、その偶像を心の中に持ち、罪に落しいれるところのつまずきを、その顔の前に置いている。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 14:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.14.p1.b3": {
    "text": "わたしはわたしの顔を、その人に向け、彼を、しるし、およびことわざとなし …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 14:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.14.p1.b4": {
    "text": "あなたがたは悔いて、あなたがたの偶像を捨てよ。あなたがたの顔を、そのすべての憎むべきものからそむけよ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 14:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.14.p1.b5": {
    "text": "ききん",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 14:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.14.p1.b6": {
    "text": "野の獣",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 14:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.14.p1.b7": {
    "text": "つるぎ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 14:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.14.p1.b8": {
    "text": "疫病",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 14:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.14.p1.b9": {
    "text": "たといそこにノア、ダニエル、ヨブの三人がいても、彼らはその義によって、ただ自分の命を救いうるのみである",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 14:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.14.p1.b10": {
    "text": "むすこ娘たちを助け出す者が、その中に残っていて …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 14:22"
    },
    "adapted": false,
    "status": "approved"
  }
}
