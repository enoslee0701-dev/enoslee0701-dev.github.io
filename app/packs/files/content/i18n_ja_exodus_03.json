{
  "exodus.3.p1.b1": {
    "text": "モーセは妻の父、ミデヤンの祭司エテロの羊の群れを飼っていたが、その群れを荒野の奥に導いて、神の山ホレブにきた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 3:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.3.p1.b2": {
    "text": "ときに主の使は、しばの中の炎のうちに彼に現れた。彼が見ると、しばは火に燃えているのに、そのしばはなくならなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 3:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.3.p1.b3": {
    "text": "行ってこの大きな見ものを見、なぜしばが燃えてしまわないかを知ろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 3:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.3.p2.b1": {
    "text": "モーセよ、モーセよ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 3:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.3.p2.b2": {
    "text": "ここにいます",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 3:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.3.p2.b3": {
    "text": "ここに近づいてはいけない。足からくつを脱ぎなさい。あなたが立っているその場所は聖なる地だからである",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 3:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.3.p2.b4": {
    "text": "わたしは、あなたの先祖の神、アブラハムの神、イサクの神、ヤコブの神である",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 3:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.3.p2.b5": {
    "text": "モーセは神を見ることを恐れたので顔を隠した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 3:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.3.p3.b1": {
    "text": "わたしは、エジプトにいるわたしの民の悩みを、つぶさに見、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 3:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.3.p3.b2": {
    "text": "また追い使う者のゆえに彼らの叫ぶのを聞いた。わたしは彼らの苦しみを知っている。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 3:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.3.p3.b3": {
    "text": "わたしは下って、彼らをエジプトびとの手から救い出し、これをかの地から導き上って、良い広い地、乳と蜜の流れる地 …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 3:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.3.p4.b1": {
    "text": "さあ、わたしは、あなたをパロにつかわして、わたしの民、イスラエルの人々をエジプトから導き出させよう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 3:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.3.p4.b2": {
    "text": "わたしは、いったい何者でしょう。わたしがパロのところへ行って、イスラエルの人々をエジプトから導き出すのでしょうか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 3:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.3.p4.b3": {
    "text": "わたしは必ずあなたと共にいる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 3:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.3.p4.b4": {
    "text": "これが、わたしのあなたをつかわしたしるしである。あなたが民をエジプトから導き出したとき、あなたがたはこの山で神に仕えるであろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 3:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.3.p5.b1": {
    "text": "… 彼らが『その名はなんというのですか』とわたしに聞くならば、なんと答えましょうか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 3:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.3.p5.b2": {
    "text": "わたしは、有って有る者",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 3:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.3.p5.b3": {
    "text": "イスラエルの人々にこう言いなさい、『「わたしは有る」というかたが、わたしをあなたがたのところへつかわされました』と",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 3:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.3.p5.b4": {
    "text": "これは永遠にわたしの名、これは世々のわたしの呼び名である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 3:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.3.p6.b1": {
    "text": "あなたは行って、イスラエルの長老たちを集めて言いなさい、 … わたしはあなたがたを顧み、あなたがたがエジプトでされている事を確かに見た。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 3:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.3.p6.b2": {
    "text": "彼らはあなたの声に聞き従うであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 3:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.3.p6.b3": {
    "text": "あなたはイスラエルの長老たちと一緒にエジプトの王のところへ行って言いなさい、 … わたしたちを、三日の道のりほど荒野に行かせて、わたしたちの神、主に犠牲をささげることを許してください",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 3:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.3.p7.b1": {
    "text": "しかし、エジプトの王は強い手をもって迫らなければ、あなたがたを行かせないのをわたしは知っている。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 3:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.3.p7.b2": {
    "text": "それで、わたしは手を伸べて、エジプトのうちに行おうとする、さまざまの不思議をもってエジプトを打とう。その後に彼はあなたがたを去らせるであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 3:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.3.p7.b3": {
    "text": "わたしはこの民にエジプトびとの好意を得させる。あなたがたは去るときに、むなし手で去ってはならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 3:21"
    },
    "adapted": false,
    "status": "approved"
  }
}
