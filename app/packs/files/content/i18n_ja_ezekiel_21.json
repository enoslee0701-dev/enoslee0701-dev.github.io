{
  "ezekiel.21.p1.b1": {
    "text": "見よ、わたしはあなたを攻め、わたしのつるぎをさやから抜き、あなたのうちから、正しい者も悪しき者をも断ってしまう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 21:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.21.p1.b2": {
    "text": "なぜ嘆くのか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 21:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.21.p1.b3": {
    "text": "この知らせのためである。それが来れば人の心はみな溶け、手はみななえ、… ひざはみな水のようになる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 21:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.21.p1.b4": {
    "text": "つるぎがある、とぎ、かつ、みがいたつるぎがある。殺すためにといであり、いなずまのようにきらめくためにみがいてある。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 21:9-10"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.21.p1.b5": {
    "text": "人の子よ、叫び嘆け、… それゆえ、あなたのももを打て。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 21:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.21.p1.b6": {
    "text": "多くの者がすべての門に倒れる。わたしはひらめくつるぎを彼らに送る。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 21:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.21.p2.b1": {
    "text": "人の子よ、バビロンの王のつるぎが来るために、二つの道を備えよ。… あなたは道しるべを作り、これを町に向かう道のはじめに置け。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 21:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.21.p2.b2": {
    "text": "バビロンの王は道の分れ目、二つの道のはじめに立って占いをし、矢をふり、テラピムに問い、肝を見る。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 21:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.21.p2.b3": {
    "text": "彼の右にエルサレムのために占いが出る。… 門に向かって城くずしを設け",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 21:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.21.p2.b4": {
    "text": "かぶり物を脱ぎ、冠を取り離せ。… わたしが与える権威をもつ者が来る時まで、その跡形さえも残らない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 21:26-27"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.21.p2.b5": {
    "text": "これをさやに納めよ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 21:30"
    },
    "adapted": false,
    "status": "approved"
  }
}
