{
  "exodus.13.p1.b1": {
    "text": "「イスラエルの人々のうちで、すべてのういご、すなわちすべて初めに胎を開いたものを、人であれ、獣であれ、みな、わたしのために聖別しなければならない。それはわたしのものである」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 13:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.13.p1.b2": {
    "text": "あなたがたは、エジプトから、奴隷の家から出るこの日を覚えなさい。主が強い手をもって、あなたがたをここから導き出されるからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 13:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.13.p1.b3": {
    "text": "種を入れたパンを食べてはならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 13:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.13.p1.b4": {
    "text": "あなたがたはアビブの月のこの日に出るのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 13:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.13.p2.b5": {
    "text": "主があなたに与えると、あなたの先祖たちに誓われた…乳と蜜との流れる地に、導き入れられる時、あなたはこの月にこの儀式を守らなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 13:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.13.p2.b6": {
    "text": "七日のあいだ種入れぬパンを食べ、七日目には主に祭をしなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 13:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.13.p2.b7": {
    "text": "これはわたしがエジプトから出るときに、主がわたしになされたことのためである",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 13:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.13.p2.b8": {
    "text": "そして、これを、手につけて、しるしとし、目の間に置いて記念とし、主の律法をあなたの口に置かなければならない…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 13:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.13.p3.b9": {
    "text": "ろばの、初めて胎を開いたものは、小羊をもって、あがなわなければならない。…あなたの子らのうち、すべて、男のういごは、あがなわなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 13:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.13.p3.b10": {
    "text": "これはどんな意味ですか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 13:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.13.p3.b11": {
    "text": "主が強い手をもって、われわれをエジプトから、奴隷の家から導き出された。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 13:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.13.p3.b12": {
    "text": "…わたしの子供のうちのういごは、すべてあがなうのである",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 13:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.13.p4.b13": {
    "text": "ペリシテびとの国の道は近かったが、神は彼らをそれに導かれなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 13:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.13.p4.b14": {
    "text": "民が戦いを見れば悔いてエジプトに帰るであろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 13:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.13.p4.b15": {
    "text": "モーセはヨセフの遺骸を携えていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 13:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.13.p4.b16": {
    "text": "神は必ずあなたがたを顧みられるであろう。そのとき、あなたがたは、わたしの遺骸を携えて、ここから上って行かなければならない",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 13:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.13.p5.b17": {
    "text": "主は彼らの前に行かれ、昼は雲の柱をもって彼らを導き、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 13:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.13.p5.b18": {
    "text": "夜は火の柱をもって彼らを照し、昼も夜も彼らを進み行かせられた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 13:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.13.p5.b19": {
    "text": "昼は雲の柱、夜は火の柱が、民の前から離れなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 13:22"
    },
    "adapted": false,
    "status": "approved"
  }
}
