{
  "exodus.11.p1.b1": {
    "text": "わたしは、なお一つの災を、パロとエジプトの上にくだし、その後、彼はあなたがたをここから去らせるであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 11:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.11.p1.b2": {
    "text": "あなたは民の耳に語って、男は隣の男から、女は隣の女から、それぞれ銀の飾り、金の飾りを請い求めさせなさい」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 11:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.11.p1.b3": {
    "text": "主は民にエジプトびとの好意を得させられた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 11:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.11.p1.b4": {
    "text": "またモーセその人は、エジプトの国で、パロの家来たちの目と民の目とに、はなはだ大いなるものと見えた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 11:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.11.p2.b5": {
    "text": "主はこう仰せられる、『真夜中ごろ、わたしはエジプトの中へ出て行くであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 11:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.11.p2.b6": {
    "text": "そしてエジプト全国に大いなる叫びが起るであろう。このようなことはかつてなく、また、ふたたびないであろう』と。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 11:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.11.p2.b7": {
    "text": "位に座するパロのういごをはじめ …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 11:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.11.p2.b8": {
    "text": "… ひきうすの後にいる、はしためのういごに至るまで",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 11:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.11.p3.b9": {
    "text": "しかし、すべて、イスラエルの人々にむかっては、人にむかっても、獣にむかっても、犬さえその舌を鳴らさないであろう。これによって主がエジプトびととイスラエルびととの間の区別をされるのを、あなたがたは知るであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 11:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.11.p3.b10": {
    "text": "これらのあなたの家来たちは、みな、わたしのもとに下ってきて、ひれ伏して言うであろう、『あなたもあなたに従う民もみな出て行ってください』と。その後、わたしは出て行きます」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 11:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.11.p3.b11": {
    "text": "彼は激しく怒ってパロのもとから出て行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 11:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.11.p3.b12": {
    "text": "パロはあなたがたの言うことを聞かないであろう。それゆえ、わたしはエジプトの国に不思議を増し加えるであろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 11:9"
    },
    "adapted": false,
    "status": "approved"
  }
}
