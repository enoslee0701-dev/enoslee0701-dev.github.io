{
  "samuel2.6.p1.b1": {
    "text": "ダビデは再びイスラエルのえり抜きの者三万人をことごとく集めた。 … バアレ・ユダへ行って、神の箱をそこからかき上ろうとした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 6:1-2"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.6.p1.b2": {
    "text": "彼らは神の箱を新しい車に載せて、山の上にあるアビナダブの家から運び出した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 6:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.6.p1.b3": {
    "text": "ダビデとイスラエルの全家は琴と立琴と手鼓と鈴とシンバルとをもって歌をうたい、力をきわめて、主の前に踊った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 6:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.6.p2.b1": {
    "text": "彼らがナコンの打ち場にきた時、ウザは神の箱に手を伸べて、それを押えた。牛がつまずいたからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 6:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.6.p2.b2": {
    "text": "すると主はウザに向かって怒りを発し、彼が手を箱に伸べたので、彼をその場で撃たれた。彼は神の箱のかたわらで死んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 6:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.6.p2.b3": {
    "text": "主がウザを撃たれたので、ダビデは怒った。その所は今日までペレヅ・ウザと呼ばれている。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 6:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.6.p3.b1": {
    "text": "どうして主の箱がわたしの所に来ることができようか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 6:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.6.p3.b2": {
    "text": "ダビデは主の箱をダビデの町に入れることを好まず、これを移してガテびとオベデエドムの家に運ばせた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 6:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.6.p3.b3": {
    "text": "神の箱はガテびとオベデエドムの家に三か月とどまった。主はオベデエドムとその全家を祝福された。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 6:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.6.p4.b1": {
    "text": "主が神の箱のゆえに、オベデエドムの家とそのすべての所有を祝福されている",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 6:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.6.p4.b2": {
    "text": "ダビデは行って、喜びをもって、神の箱をオベデエドムの家からダビデの町にかき上った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 6:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.6.p4.b3": {
    "text": "主の箱をかく者が六歩進んだ時、ダビデは牛と肥えた物を犠牲としてささげた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 6:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.6.p5.b1": {
    "text": "そしてダビデは力をきわめて、主の箱の前で踊った。その時ダビデは亜麻布のエポデをつけていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 6:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.6.p5.b2": {
    "text": "… 喜びの叫びと角笛の音をもって、神の箱をかき上った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 6:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.6.p6.b1": {
    "text": "主の箱がダビデの町にはいった時、サウルの娘ミカルは窓からながめ、ダビデ王が主の前に舞い踊るのを見て、心のうちにダビデをさげすんだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 6:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.6.p6.b2": {
    "text": "人々は主の箱をかき入れて、ダビデがそのために張った天幕の中のその場所に置いた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 6:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.6.p7.b1": {
    "text": "ダビデは燔祭と酬恩祭をささげ終った時、万軍の主の名によって民を祝福した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 6:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.6.p7.b2": {
    "text": "イスラエルの全民衆に、男にも女にも、おのおのパンの菓子一個、肉一きれ、ほしぶどう一かたまりを分け与えた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 6:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.6.p7.b3": {
    "text": "こうして民はみなおのおのその家に帰った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 6:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.6.p8.b1": {
    "text": "きょうイスラエルの王はなんと威厳のあったことでしょう。 … きょう家来たちのはしためらの前に自分の身を現されました",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 6:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.6.p8.b2": {
    "text": "… 主の前に踊ったのだ。わたしはまた主の前に踊るであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 6:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.6.p8.b3": {
    "text": "わたしはこれよりももっと軽んじられるようにしよう。そしてあなたの目には卑しめられるであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 6:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.6.p8.b4": {
    "text": "こうしてサウルの娘ミカルは死ぬ日まで子供がなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Samuel 6:23"
    },
    "adapted": false,
    "status": "approved"
  }
}
