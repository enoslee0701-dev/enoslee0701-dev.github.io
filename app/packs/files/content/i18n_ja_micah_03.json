{
  "micah.3.p1.b1": {
    "text": "ヤコブのかしらたちよ、イスラエルの家のつかさたちよ、聞け、公義はあなたがたの知っておるべきことではないか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 3:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.3.p1.b2": {
    "text": "またわが民の肉を食らい、その皮をはぎ……これを切りきざんで、なべに入れる食物のようにし、大なべに入れる肉のようにする。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 3:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.3.p1.b3": {
    "text": "平安",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 3:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.3.p1.b4": {
    "text": "太陽はその預言者たちに没し、昼も彼らの上に暗くなる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 3:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.3.p1.b5": {
    "text": "しかしわたしは主のみたまによって力に満ち、公義と勇気とに満たされ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 3:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.3.p1.b6": {
    "text": "そのかしらたちは、まいないをとってさばき、その祭司たちは価をとって教え、その預言者たちは金をとって占う。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 3:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.3.p1.b7": {
    "text": "主はわれわれの中におられるではないか、だから災はわれわれに臨むことがない",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 3:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.3.p1.b8": {
    "text": "それゆえ、シオンはあなたがたのゆえに田畑となって耕され、エルサレムは石塚となり、宮の山は木のおい茂る高い所となる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 3:12"
    },
    "adapted": false,
    "status": "approved"
  }
}
