{
  "hebrews.8.p1.b1": {
    "text": "以上述べたことの要点は、このような大祭司がわたしたちのためにおられ、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 8:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.8.p1.b2": {
    "text": "天にあって大能者の御座の右に座し、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 8:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.8.p1.b3": {
    "text": "…真の幕屋なる聖所で仕えておられる、ということである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 8:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.8.p1.b4": {
    "text": "人間によらず主によって設けられた…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 8:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.8.p2.b5": {
    "text": "おおよそ、大祭司が立てられるのは、供え物やいけにえをささげるためにほかならない。したがって、この大祭司もまた、何かささぐべき物を持っておられねばならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 8:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.8.p2.b6": {
    "text": "彼らは、天にある聖所のひな型と影とに仕えている者にすぎない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 8:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.8.p2.b7": {
    "text": "「山で示された型どおりに、注意してそのいっさいを作りなさい」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 8:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.8.p2.b8": {
    "text": "ところがキリストは、はるかにすぐれた務を得られたのである。…さらにまさった契約の仲保者となられたことによる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 8:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.8.p3.b9": {
    "text": "もし初めの契約に欠けたところがなかったなら、あとのものが立てられる余地はなかったであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 8:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.8.p3.b10": {
    "text": "見よ、わたしがイスラエルの家およびユダの家と、新しい契約を結ぶ日が来る。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 8:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.8.p3.b11": {
    "text": "それは、わたしが彼らの先祖たちの手をとって、エジプトの地から導き出した日に、彼らと結んだ契約のようなものではない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 8:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.8.p3.b12": {
    "text": "わたしの律法を彼らの思いの中に入れ、彼らの心に書きつけよう。こうして、わたしは彼らの神となり、彼らはわたしの民となるであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 8:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.8.p4.b13": {
    "text": "…大なる者から小なる者に至るまで、彼らはことごとく、わたしを知るようになるからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 8:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.8.p4.b14": {
    "text": "わたしは、彼らの不義をあわれみ、もはや、彼らの罪を思い出すことはしない」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 8:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.8.p4.b15": {
    "text": "神は、「新しい」と言われたことによって、初めの契約を古いとされたのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 8:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "hebrews.8.p4.b16": {
    "text": "年を経て古びたものは、やがて消えていく。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Hebrews 8:13"
    },
    "adapted": false,
    "status": "approved"
  }
}
