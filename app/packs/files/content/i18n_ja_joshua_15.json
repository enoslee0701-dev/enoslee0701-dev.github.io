{
  "joshua.15.p1.b1": {
    "text": "ユダの人々の部族が、その家族にしたがって、くじで獲た地は、南の方では、エドムの境に達し、南のはてにあるチンの荒野に及んでいた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 15:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.15.p1.b2": {
    "text": "その南の境は、塩の海の南の端の、入海から起り、アクラビムの坂の南に出て …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 15:2-3"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.15.p1.b3": {
    "text": "またその境はベンヒンノムの谷に沿って、エブスびとの地、すなわちエルサレムの南のわきに上り …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 15:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.15.p1.b4": {
    "text": "また西の境は大海であって、海岸を境とした。これがユダの人々の、その家族にしたがって獲た地の四方の境である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 15:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.15.p2.b1": {
    "text": "カレブはその所から、アナクの子三人を追い払った。すなわち、セシャイ、アヒマン、およびタルマイであって、アナクから出たものである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 15:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.15.p2.b2": {
    "text": "キリアテ・セペルを撃って、これを取る者には、わたしの娘アクサを妻として与えるであろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 15:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.15.p2.b3": {
    "text": "ケナズの子で、カレブの弟オテニエルがそれを取ったので、カレブは娘アクサを、妻として彼に与えた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 15:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.15.p3.b1": {
    "text": "彼女がとつぐ時、畑を父に求めるようにと、オテニエルに勧められた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 15:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.15.p3.b2": {
    "text": "何を望むのか …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 15:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.15.p3.b3": {
    "text": "わたしに贈り物をください。あなたはネゲブの地に、わたしをやられるのですから、泉をもください",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 15:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.15.p3.b4": {
    "text": "カレブは彼女に上の泉と下の泉とを与えた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 15:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.15.p4.b1": {
    "text": "ユダの人々の部族が、その家族にしたがって獲た嗣業は、次のとおりである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 15:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.15.p4.b2": {
    "text": "荒野では、ベテアラバ、ミデン、セカカ、 ニブシャン、塩の町、エンゲデ。すなわち六つの町々と、それに属する村々。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 15:61-62"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.15.p4.b3": {
    "text": "… キリアテ・アルバすなわちヘブロン、ヂオル。すなわち九つの町々と、それに属する村々。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 15:54"
    },
    "adapted": false,
    "status": "approved"
  },
  "joshua.15.p4.b4": {
    "text": "しかし、ユダの人々は、エルサレムの住民エブスびとを追い払うことができなかった。それでエブスびとは今日まで、ユダの人々と共にエルサレムに住んでいる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Joshua 15:63"
    },
    "adapted": false,
    "status": "approved"
  }
}
