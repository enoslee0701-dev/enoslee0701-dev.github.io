{
  "matthew.28.p1.b1": {
    "text": "안식일이 다하여가고 안식후 첫날이 되려는 미명에",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p1.b2": {
    "text": "막달라 마리아와 다른 마리아가 무덤을 보려고 왔더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p1.b3": {
    "text": "큰 지진이 나며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p1.b4": {
    "text": "주의 천사가 하늘로서 내려와 돌을 굴려 내고 그위에 앉았는데",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p2.b1": {
    "text": "그 형상이 번개 같고 그 옷은 눈 같이 희거늘",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p2.b2": {
    "text": "수직하던 자들이 저를 무서워하여 떨며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p2.b3": {
    "text": "죽은 사람과 같이 되었더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p3.b1": {
    "text": "너희는 무서워 말라 십자가에 못박히신 예수를 너희가 찾는 줄을 내가 아노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p3.b2": {
    "text": "그가 여기 계시지 않고 그의 말씀하시던대로 살아나셨느니라 와서 그의 누우셨던 곳을 보라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p3.b3": {
    "text": "또 빨리 가서 그의 제자들에게 이르되 그가 죽은 자 가운데서 살아나셨고 너희보다 먼저 갈릴리로 가시나니 거기서 너희가 뵈오리라 하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p3.b4": {
    "text": "보라 내가 너희에게 일렀느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p4.b1": {
    "text": "그 여자들이 무서움과 큰 기쁨으로 무덤을 빨리 떠나 제자들에게 알게 하려고 달음질할새",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p4.b2": {
    "text": "예수께서 저희를 만나 가라사대",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p4.b3": {
    "text": "평안하뇨",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p4.b4": {
    "text": "여자들이 나아가 그 발을 붙잡고 경배하니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p5.b1": {
    "text": "무서워 말라 가서 내 형제들에게",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p5.b2": {
    "text": "갈릴리로 가라 하라 거기서 나를 보리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p5.b3": {
    "text": "여자들이 갈제 파숫군 중 몇이 성에 들어가",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p5.b4": {
    "text": "모든 된 일을 대제사장들에게 고하니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p6.b1": {
    "text": "그들이 장로들과 함께 모여 의논하고 군병들에게 돈을 많이 주며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p6.b2": {
    "text": "가로되 너희는 말하기를 그의 제자들이 밤에 와서 우리가 잘 때에 그를 도적질하여 갔다 하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p6.b3": {
    "text": "만일 이 말이 총독에게 들리면 우리가 권하여 너희로 근심되지 않게 하리라 하니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p6.b4": {
    "text": "이 말이 오늘날까지 유대인 가운데 두루 퍼지니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p7.b1": {
    "text": "열 한 제자가 갈릴리에 가서 예수의 명하시던 산에 이르러",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p7.b2": {
    "text": "예수를 뵈옵고 경배하나",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p7.b3": {
    "text": "오히려 의심하는 자도 있더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p8.b1": {
    "text": "예수께서 나아와 일러 가라사대",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p8.b2": {
    "text": "하늘과 땅의 모든 권세를 내게 주셨으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p8.b3": {
    "text": "그러므로 너희는 가서 모든 족속으로 제자를 삼아",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p8.b4": {
    "text": "아버지와 아들과 성령의 이름으로 세례를 주고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p9.b1": {
    "text": "내가 너희에게 분부한 모든 것을 가르쳐 지키게 하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p9.b2": {
    "text": "볼지어다 내가 … 너희와 항상 함께 있으리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.28.p9.b3": {
    "text": "세상 끝날까지",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 28:20"
    },
    "adapted": false,
    "status": "approved"
  }
}
