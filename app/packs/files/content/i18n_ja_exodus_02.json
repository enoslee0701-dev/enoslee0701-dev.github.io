{
  "exodus.2.p1.b1": {
    "text": "女はみごもって、男の子を産んだが、その麗しいのを見て、三月のあいだ隠していた。 しかし、もう隠しきれなくなったので、パピルスで編んだかごを取り、それにアスファルトと樹脂とを塗って、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 2:1-3"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.2.p1.b2": {
    "text": "子をその中に入れ、これをナイル川の岸の葦の中においた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 2:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.2.p1.b3": {
    "text": "その姉は、彼がどうされるかを知ろうと、遠く離れて立っていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 2:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.2.p2.b1": {
    "text": "ときにパロの娘が身を洗おうと、川に降りてきた。侍女たちは川べを歩いていたが、彼女は、葦の中にかごのあるのを見て、つかえめをやり、それを取ってこさせ、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 2:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.2.p2.b2": {
    "text": "あけて見ると子供がいた。見よ、幼な子は泣いていた。彼女はかわいそうに思って",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 2:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.2.p2.b3": {
    "text": "これはヘブルびとの子供です",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 2:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.2.p3.b1": {
    "text": "わたしが行ってヘブルの女のうちから、あなたのために、この子に乳を飲ませるうばを呼んでまいりましょうか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 2:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.2.p3.b2": {
    "text": "行ってきてください",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 2:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.2.p3.b3": {
    "text": "この子を連れて行って、わたしに代り、乳を飲ませてください。わたしはその報酬をさしあげます",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 2:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.2.p3.b4": {
    "text": "その子が成長したので、彼女はこれをパロの娘のところに連れて行った。そして彼はその子となった。彼女はその名をモーセと名づけて",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 2:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.2.p3.b5": {
    "text": "水の中からわたしが引き出したからです",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 2:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.2.p4.b1": {
    "text": "モーセが成長して後、ある日のこと、同胞の所に出て行って、そのはげしい労役を見た。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 2:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.2.p4.b2": {
    "text": "彼はひとりのエジプトびとが、同胞のひとりであるヘブルびとを打つのを見た",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 2:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.2.p4.b3": {
    "text": "左右を見まわし、人のいないのを見て、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 2:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.2.p4.b4": {
    "text": "そのエジプトびとを打ち殺し、これを砂の中に隠した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 2:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.2.p5.b1": {
    "text": "あなたはなぜ、あなたの友を打つのですか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 2:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.2.p5.b2": {
    "text": "だれがあなたを立てて、われわれのつかさ、また裁判人としたのですか。エジプトびとを殺したように、あなたはわたしを殺そうと思うのですか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 2:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.2.p5.b3": {
    "text": "あの事がきっと知れたのだ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 2:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.2.p5.b4": {
    "text": "パロはこの事を聞いて、モーセを殺そうとした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 2:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.2.p5.b5": {
    "text": "しかしモーセはパロの前をのがれて、ミデヤンの地に行き、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 2:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.2.p6.b1": {
    "text": "さて、ミデヤンの祭司に七人の娘があった。彼女たちはきて水をくみ、水槽にみたして父の羊の群れに飲ませようとしたが、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 2:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.2.p6.b2": {
    "text": "羊飼たちがきて彼女らを追い払ったので、モーセは立ち上がって彼女たちを助け、その羊の群れに水を飲ませた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 2:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.2.p6.b3": {
    "text": "ひとりのエジプトびとが、わたしたちを羊飼たちの手から助け出し、そのうえ、水をたくさんくんで、羊の群れに飲ませてくれたのです",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 2:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.2.p6.b4": {
    "text": "そのかたはどこにおられるか。なぜ、そのかたをおいてきたのか。呼んできて、食事をさしあげなさい",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 2:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.2.p7.b1": {
    "text": "モーセがこの人と共におることを好んだので、彼は娘のチッポラを妻としてモーセに与えた。 彼女が男の子を産んだので、モーセはその名をゲルショムと名づけた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 2:21-22"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.2.p7.b2": {
    "text": "わたしは外国に寄留者となっている",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 2:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.2.p7.b3": {
    "text": "多くの日を経て、エジプトの王は死んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 2:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.2.p7.b4": {
    "text": "イスラエルの人々は、その苦役の務のゆえにうめき、また叫んだが、その苦役のゆえの叫びは神に届いた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 2:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.2.p7.b5": {
    "text": "神は彼らのうめきを聞き、神はアブラハム、イサク、ヤコブとの契約を覚え、 神はイスラエルの人々を顧み、神は彼らをしろしめされた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 2:24-25"
    },
    "adapted": false,
    "status": "approved"
  }
}
