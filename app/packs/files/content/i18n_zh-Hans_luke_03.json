{
  "luke.3.p1.b1": {
    "text": "凯撒提庇留在位第十五年，本丢·彼拉多作犹太巡抚，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "凯撒提庇留⁠在位第⁠十五⁠年，本丢·彼⁠拉⁠多作犹⁠太巡⁠抚，"
  },
  "luke.3.p1.b2": {
    "text": "希律作加利利分封的王，……",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "希⁠律作加⁠利⁠利分⁠封的王，……"
  },
  "luke.3.p1.b3": {
    "text": "亚那和该亚法作大祭司。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "亚那和该亚法作大⁠祭⁠司。"
  },
  "luke.3.p1.b4": {
    "text": "那时，撒迦利亚的儿子约翰在旷野里，　神的话临到他。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "那⁠时，撒迦利⁠亚的儿⁠子约⁠翰在旷⁠野里，　神的⁠话临⁠到他。"
  },
  "luke.3.p2.b1": {
    "text": "他就来到约旦河一带地方，宣讲悔改的洗礼，使罪得赦。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:3"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他就来⁠到约⁠旦⁠河一⁠带地⁠方，宣⁠讲悔⁠改的洗⁠礼，使罪得赦。"
  },
  "luke.3.p2.b2": {
    "text": "在旷野有人声喊着说：预备主的道，修直他的路！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:4"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "在旷⁠野有⁠人声喊着说：预⁠备主的道，修直他⁠的路！"
  },
  "luke.3.p2.b3": {
    "text": "一切山洼都要填满；大小山冈都要削平！……",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:5"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "一⁠切山洼都⁠要填⁠满；大⁠小山⁠冈都⁠要削⁠平！……"
  },
  "luke.3.p2.b4": {
    "text": "凡有血气的，都要见　神的救恩！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:6"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "凡⁠有血气的，都⁠要见　神的救恩！"
  },
  "luke.3.p3.b1": {
    "text": "毒蛇的种类！谁指示你们逃避将来的忿怒呢？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "毒⁠蛇的种⁠类！谁指⁠示你⁠们逃⁠避将⁠来的忿⁠怒呢？"
  },
  "luke.3.p3.b2": {
    "text": "我告诉你们，　神能从这些石头中，给亚伯拉罕兴起子孙来。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我告⁠诉你⁠们，　神能从这⁠些石⁠头中，给亚⁠伯拉⁠罕兴⁠起子⁠孙来。"
  },
  "luke.3.p3.b3": {
    "text": "现在斧子已经放在树根上，凡不结好果子的树就砍下来，丢在火里。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:9"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "现⁠在斧⁠子已⁠经放⁠在树⁠根上，凡不结好果⁠子的树就砍⁠下⁠来，丢在火里。"
  },
  "luke.3.p4.b1": {
    "text": "这样，我们当做什么呢？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:10"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "这⁠样，我⁠们当⁠做什⁠么呢？"
  },
  "luke.3.p4.b2": {
    "text": "有两件衣裳的，就分给那没有的；有食物的，也当这样行。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:11"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有两件衣⁠裳的，就分给那没⁠有的；有食⁠物的，也当这⁠样行。"
  },
  "luke.3.p4.b3": {
    "text": "除了例定的数目，不要多取。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "除⁠了例定的数⁠目，不⁠要多取。"
  },
  "luke.3.p4.b4": {
    "text": "不要以强暴待人，也不要讹诈人，自己有钱粮就当知足。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:14"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "不⁠要以强⁠暴待⁠人，也不⁠要讹⁠诈人，自⁠己有钱粮就当知⁠足。"
  },
  "luke.3.p5.b1": {
    "text": "百姓指望基督来的时候，人都心里猜疑，或者约翰是基督。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:15"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "百⁠姓指⁠望基⁠督来的时⁠候，人都心⁠里猜⁠疑，或⁠者约⁠翰是基⁠督。"
  },
  "luke.3.p5.b2": {
    "text": "有一位能力比我更大的要来，我就是给他解鞋带也不配。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:16"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有一⁠位能⁠力比我更⁠大的要来，我就⁠是给他解鞋⁠带也⁠不配。"
  },
  "luke.3.p5.b3": {
    "text": "他要用圣灵与火给你们施洗。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:16"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他要⁠用圣⁠灵与火给你⁠们施⁠洗。"
  },
  "luke.3.p5.b4": {
    "text": "要扬净他的场，把麦子收在仓里，把糠用不灭的火烧尽了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:17"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "要扬净他⁠的场，把麦⁠子收在仓里，把糠用不⁠灭的火⁠烧尽了。"
  },
  "luke.3.p6.b1": {
    "text": "约翰又用许多别的话劝百姓，向他们传福音。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:18"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "约⁠翰又用许⁠多别的⁠话劝百⁠姓，向他⁠们传福⁠音。"
  },
  "luke.3.p6.b2": {
    "text": "只是分封的王希律，因他兄弟之妻希罗底的缘故，并因他所行的一切恶事，受了约翰的责备；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:19"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "只⁠是分⁠封的王希⁠律，因他兄⁠弟之妻希⁠罗⁠底的缘⁠故，并因他⁠所行的一⁠切恶事，受了约⁠翰的责⁠备；"
  },
  "luke.3.p6.b3": {
    "text": "又另外添了一件，就是把约翰收在监里。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:20"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "又另⁠外添⁠了一⁠件，就⁠是把约⁠翰收在监里。"
  },
  "luke.3.p7.b1": {
    "text": "众百姓都受了洗，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:21"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "众百⁠姓都⁠受⁠了洗，"
  },
  "luke.3.p7.b2": {
    "text": "耶稣也受了洗。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:21"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣也受了洗。"
  },
  "luke.3.p7.b3": {
    "text": "正祷告的时候，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:21"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "正祷⁠告的时⁠候，"
  },
  "luke.3.p8.b1": {
    "text": "天就开了，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "luke.3.p8.b2": {
    "text": "圣灵降临在他身上，形状仿佛鸽子；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:22"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "圣⁠灵降⁠临在他身⁠上，形⁠状仿⁠佛鸽⁠子；"
  },
  "luke.3.p8.b3": {
    "text": "你是我的爱子，我喜悦你。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:22"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠是我⁠的爱子，我喜⁠悦你。"
  },
  "luke.3.p9.b1": {
    "text": "耶稣开头传道，年纪约有三十岁。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:23"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣开⁠头传⁠道，年⁠纪约有⁠三十⁠岁。"
  },
  "luke.3.p9.b2": {
    "text": "依人看来，他是约瑟的儿子；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:23"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "依人看⁠来，他⁠是约⁠瑟的儿⁠子；"
  },
  "luke.3.p9.b3": {
    "text": "约瑟是希里的儿子；……",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:23"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "约⁠瑟是希里的儿⁠子；……"
  },
  "luke.3.p9.b4": {
    "text": "所罗巴伯是撒拉铁的儿子；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:27"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "所罗巴伯是撒拉铁的儿⁠子；"
  },
  "luke.3.p10.b1": {
    "text": "拿单是大卫的儿子；大卫是耶西的儿子；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:31-32"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "拿单⁠是大⁠卫的儿⁠子；大⁠卫是耶西的儿⁠子；"
  },
  "luke.3.p10.b2": {
    "text": "俄备得是波阿斯的儿子；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:32"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "俄备得是波阿斯的儿⁠子；"
  },
  "luke.3.p10.b3": {
    "text": "以撒是亚伯拉罕的儿子；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:34"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "以⁠撒是亚⁠伯拉⁠罕的儿⁠子；"
  },
  "luke.3.p11.b1": {
    "text": "闪是挪亚的儿子；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:36"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "闪是挪亚的儿⁠子；"
  },
  "luke.3.p11.b2": {
    "text": "塞特是亚当的儿子；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:38"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "塞特是亚⁠当的儿⁠子；"
  },
  "luke.3.p11.b3": {
    "text": "亚当是　神的儿子。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Luke 3:38"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "亚⁠当是　神的儿⁠子。"
  }
}
