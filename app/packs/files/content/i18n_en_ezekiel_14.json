    "source": {
      "version": "engbsb",
      "ref": "Ezekiel 14:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.14.p1.b10": {
    "text": "Yet, behold, some survivors will be left in it—sons and daughters who will be brought out. They will come out to you …",
    "kind": "scripture",
