{
  "ezekiel.14.p1.b1": {
    "text": "Then some of the elders of Israel came and sat down before me.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "Ezekiel 14:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.14.p1.b2": {
    "text": "Son of man, these men have set up idols in their hearts and put wicked stumbling blocks before their faces …",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "Ezekiel 14:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.14.p1.b3": {
    "text": "I will set My face against that man and make him a sign and a proverb …",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "Ezekiel 14:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.14.p1.b4": {
    "text": "Repent and turn away from your idols; turn your faces away from all your abominations.",
