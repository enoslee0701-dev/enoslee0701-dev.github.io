{
  "zechariah.6.p1.b1": {
    "text": "わたしがまた目をあげて見ていると、四両の戦車が二つの山の間から出てきた。その山は青銅の山であった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 6:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.6.p1.b2": {
    "text": "第一の戦車には赤馬を着け、第二の戦車には黒馬を着け、 第三の戦車には白馬を着け、第四の戦車には、まだらのねずみ色の馬を着けていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 6:2-3"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.6.p1.b3": {
    "text": "わが主よ、これらはなんですか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 6:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.6.p1.b4": {
    "text": "これらは全地の主の前に現れて後、天の四方に出て行くものです",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 6:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.6.p1.b5": {
    "text": "行って、地をあまねくめぐれ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 6:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.6.p1.b6": {
    "text": "北の国をさして行く者どもは、北の国でわたしの心を静まらせてくれた",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 6:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.6.p2.b1": {
    "text": "バビロンから帰ってきたかの捕囚の中から、ヘルダイ、トビヤおよびエダヤを連れて",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 6:9-10"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.6.p2.b2": {
    "text": "彼らから金銀を受け取って、一つの冠を造り、それをヨザダクの子である大祭司ヨシュアの頭にかぶらせて、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 6:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.6.p2.b3": {
    "text": "見よ、その名を枝という人がある。彼は自分の場所で成長して、主の宮を建てる",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 6:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.6.p2.b4": {
    "text": "……その位に座して治める。その位のかたわらに、ひとりの祭司がいて、このふたりの間に平和の一致がある",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 6:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "zechariah.6.p2.b5": {
    "text": "また遠い所の者どもが来て、主の宮を建てることを助ける。そしてあなたがたは万軍の主が、わたしをつかわされたことを知るようになる",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zechariah 6:15"
    },
    "adapted": false,
    "status": "approved"
  }
}
