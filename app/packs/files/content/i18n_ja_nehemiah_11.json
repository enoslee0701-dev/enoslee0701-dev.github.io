{
  "nehemiah.11.p1.b1": {
    "text": "民のつかさたちはエルサレムに住み、その他の民はくじを引いて……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 11:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.11.p1.b2": {
    "text": "……十人のうちからひとりずつを、聖都エルサレムに来て住ませ、九人を他の町々に住ませた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 11:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.11.p1.b3": {
    "text": "またすべてみずから進みでてエルサレムに住むことを申し出た人々は、民はこれを祝福した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 11:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.11.p2.b1": {
    "text": "……さてエルサレムに住んだこの州の長たちは次のとおりである。……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 11:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.11.p2.b2": {
    "text": "ペレヅの子孫でエルサレムに住んだ者は合わせて四百六十八人で、みな勇敢な人々である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 11:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.11.p2.b3": {
    "text": "……マッタニヤは祈の時に感謝の言葉を唱え始める者である。……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 11:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.11.p2.b4": {
    "text": "彼らについては王からの命令があって、歌うたう者に日々の定まった分を与えさせた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 11:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.11.p3.b1": {
    "text": "……こうして彼らはベエルシバからヒンノムの谷にまで宿営した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 11:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.11.p3.b2": {
    "text": "また村々とその田畑については、ユダの子孫の者はキリアテ・アルバとその村々、デボンとその村々、エカブジエルとその村々に住み……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 11:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "nehemiah.11.p3.b3": {
    "text": "ベニヤミンの子孫はまたゲバからミクマシ、アヤおよびベテルとその村々に住み……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Nehemiah 11:31"
    },
    "adapted": false,
    "status": "approved"
  }
}
