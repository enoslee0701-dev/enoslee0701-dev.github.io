{
  "john.13.p1.b1": {
    "text": "過越の祭の前に、イエスは、この世を去って父のみもとに行くべき自分の時がきたことを知り、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p1.b2": {
    "text": "世にいる自分の者たちを愛して、彼らを最後まで愛し通された。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p1.b3": {
    "text": "夕食のとき、悪魔はすでにシモンの子イスカリオテのユダの心に、イエスを裏切ろうとする思いを入れていたが、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p1.b4": {
    "text": "夕食の席から立ち上がって、上着を脱ぎ、手ぬぐいをとって腰に巻き、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p2.b1": {
    "text": "それから水をたらいに入れて、弟子たちの足を洗い、腰に巻いた手ぬぐいでふき始められた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p2.b2": {
    "text": "主よ、あなたがわたしの足をお洗いになるのですか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p2.b3": {
    "text": "わたしのしていることは今あなたにはわからないが、あとでわかるようになるだろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p3.b1": {
    "text": "わたしの足を決して洗わないで下さい",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p3.b2": {
    "text": "もしわたしがあなたの足を洗わないなら、あなたはわたしとなんの係わりもなくなる",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p3.b3": {
    "text": "主よ、では、足だけではなく、どうぞ、手も頭も",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p4.b1": {
    "text": "すでにからだを洗った者は、足のほかは洗う必要がない。全身がきれいなのだから。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p4.b2": {
    "text": "あなたがたはきれいなのだ。しかし、みんながそうなのではない",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p4.b3": {
    "text": "イエスは自分を裏切る者を知っておられた。それで、「みんながきれいなのではない」と言われたのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p5.b1": {
    "text": "こうして彼らの足を洗ってから、上着をつけ、ふたたび席にもどって、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p5.b2": {
    "text": "わたしがあなたがたにしたことがわかるか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p5.b3": {
    "text": "しかし、主であり、また教師であるわたしが、あなたがたの足を洗ったからには、あなたがたもまた、互に足を洗い合うべきである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p6.b1": {
    "text": "… 僕はその主人にまさるものではなく、つかわされた者はつかわした者にまさるものではない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p6.b2": {
    "text": "もしこれらのことがわかっていて、それを行うなら、あなたがたはさいわいである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p6.b3": {
    "text": "わたしは自分が選んだ人たちを知っている。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p6.b4": {
    "text": "しかし、『わたしのパンを食べている者が、わたしにむかってそのかかとをあげた』とある聖書は成就されなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p7.b1": {
    "text": "イエスがこれらのことを言われた後、その心が騒ぎ、おごそかに言われた、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p7.b2": {
    "text": "よくよくあなたがたに言っておく。あなたがたのうちのひとりが、わたしを裏切ろうとしている",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p7.b3": {
    "text": "弟子たちはだれのことを言われたのか察しかねて、互に顔を見合わせた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p8.b1": {
    "text": "弟子たちのひとりで、イエスの愛しておられた者が、み胸に近く席についていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p8.b2": {
    "text": "だれのことをおっしゃったのか、知らせてくれ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p8.b3": {
    "text": "主よ、だれのことですか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p9.b1": {
    "text": "わたしが一きれの食物をひたして与える者が、それである",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p9.b2": {
    "text": "そして、一きれの食物をひたしてとり上げ、シモンの子イスカリオテのユダにお与えになった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p9.b3": {
    "text": "この一きれの食物を受けるやいなや、サタンがユダにはいった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p9.b4": {
    "text": "しようとしていることを、今すぐするがよい",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p10.b1": {
    "text": "席を共にしていた者のうち、なぜユダにこう言われたのか、わかっていた者はひとりもなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p10.b2": {
    "text": "ある人々は、ユダが金入れをあずかっていたので、イエスが彼に、「祭のために必要なものを買え」と言われたか、あるいは、貧しい者に何か施させようとされたのだと思っていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p10.b3": {
    "text": "ユダは一きれの食物を受けると、すぐに出て行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p10.b4": {
    "text": "時は夜であった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p11.b1": {
    "text": "今や人の子は栄光を受けた。神もまた彼によって栄光をお受けになった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p11.b2": {
    "text": "子たちよ、わたしはまだしばらく、あなたがたと一緒にいる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p11.b3": {
    "text": "あなたがたはわたしを捜すだろうが、……『あなたがたはわたしの行く所に来ることはできない』。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p12.b1": {
    "text": "わたしは、新しいいましめをあなたがたに与える、互に愛し合いなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p12.b2": {
    "text": "わたしがあなたがたを愛したように、あなたがたも互に愛し合いなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p12.b3": {
    "text": "互に愛し合うならば、それによって、あなたがたがわたしの弟子であることを、すべての者が認めるであろう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p13.b1": {
    "text": "主よ、どこへおいでになるのですか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:36"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p13.b2": {
    "text": "あなたはわたしの行くところに、今はついて来ることはできない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:36"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p13.b3": {
    "text": "しかし、あとになってから、ついて来ることになろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:36"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p14.b1": {
    "text": "主よ、なぜ、今あなたについて行くことができないのですか。あなたのためには、命も捨てます",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:37"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p14.b2": {
    "text": "わたしのために命を捨てると言うのか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p14.b3": {
    "text": "よくよくあなたに言っておく。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.13.p14.b4": {
    "text": "鶏が鳴く前に、あなたはわたしを三度知らないと言うであろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "John 13:38"
    },
    "adapted": false,
    "status": "approved"
  }
}
