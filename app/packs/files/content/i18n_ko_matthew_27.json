{
  "matthew.27.p1.b1": {
    "text": "새벽에 모든 대제사장과 백성의 장로들이 예수를 죽이려고 함께 의논하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p1.b2": {
    "text": "결박하여 끌고 가서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p1.b3": {
    "text": "총독 빌라도에게 넘겨주니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p2.b1": {
    "text": "때에 예수를 판 유다가 그의 정죄됨을 보고 스스로 뉘우쳐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p2.b2": {
    "text": "그 은 삼십을 대제사장들과 장로들에게 도로 갖다 주며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p2.b3": {
    "text": "내가 무죄한 피를 팔고 죄를 범하였도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p2.b4": {
    "text": "그것이 우리에게 무슨 상관이 있느냐 네가 당하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p3.b1": {
    "text": "유다가 은을 성소에 던져 넣고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p3.b2": {
    "text": "물러가서 스스로 목매어 죽은지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p3.b3": {
    "text": "이것은 피 값이라 성전고에 넣어 둠이 옳지 않다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p4.b1": {
    "text": "의논한 후 이것으로 토기장이의 밭을 사서 나그네의 묘지를 삼았으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p4.b2": {
    "text": "그러므로 오늘날까지 그 밭을 피밭이라 일컫느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p4.b3": {
    "text": "이에 선지자 예레미야로 하신 말씀이 이루었나니 일렀으되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p4.b4": {
    "text": "저희가 그 정가된 자 곧 이스라엘 자손 중에서 정가한 자의 가격 곧 은 삼십을 가지고 토기장이의 밭 값으로 주었으니 이는 주께서 내게 명하신 바와 같으니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:9-10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p5.b1": {
    "text": "예수께서 총독 앞에 섰으매 총독이 물어 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p5.b2": {
    "text": "네가 유대인의 왕이냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p5.b3": {
    "text": "네 말이 옳도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p5.b4": {
    "text": "저희가 너를 쳐서 얼마나 많은 것으로 증거하는지 듣지 못하느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p6.b1": {
    "text": "명절을 당하면 총독이 무리의 소원대로 죄수 하나를 놓아 주는 전례가 있더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p6.b2": {
    "text": "그 때에 바라바라 하는 유명한 죄수가 있는데",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p6.b3": {
    "text": "너희는 내가 누구를 너희에게 놓아 주기를 원하느냐 바라바냐 그리스도라 하는 예수냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p6.b4": {
    "text": "이는 저가 그들의 시기로 예수를 넘겨준 줄 앎이러라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p7.b1": {
    "text": "총독이 재판 자리에 앉았을 때에 그 아내가 사람을 보내어 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p7.b2": {
    "text": "저 옳은 사람에게 아무 상관도 하지 마옵소서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p7.b3": {
    "text": "오늘 꿈에 내가 그 사람을 인하여 애를 많이 썼나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p8.b1": {
    "text": "대제사장들과 장로들이 무리를 권하여 바라바를 달라 하게 하고 예수를 멸하자 하게 하였더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p8.b2": {
    "text": "둘 중에 누구를 너희에게 놓아 주기를 원하느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p8.b3": {
    "text": "바라바로소이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p8.b4": {
    "text": "그러면 그리스도라 하는 예수를 내가 어떻게 하랴",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p8.b5": {
    "text": "어찜이뇨 무슨 악한 일을 하였느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p8.b6": {
    "text": "십자가에 못박혀야 하겠나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p9.b1": {
    "text": "빌라도가 아무 효험도 없이 도리어 민란이 나려는 것을 보고 물을 가져다가 무리 앞에서 손을 씻으며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p9.b2": {
    "text": "이 옳은 사람의 피에 대하여 나는 무죄하니 너희가 당하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p9.b3": {
    "text": "그 피를 우리와 우리 자손에게 돌릴지어다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p10.b1": {
    "text": "이에 바라바는 저희에게 놓아주고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p10.b2": {
    "text": "예수는 채찍질하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p10.b3": {
    "text": "십자가에 못박히게 넘겨주니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p11.b1": {
    "text": "이에 총독의 군병들이 예수를 데리고 관정 안으로 들어가서 온 군대를 그에게로 모으고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p11.b2": {
    "text": "그의 옷을 벗기고 홍포를 입히며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p11.b3": {
    "text": "유대인의 왕이여 평안할지어다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p11.b4": {
    "text": "그에게 침 뱉고 갈대를 빼앗아 그의 머리를 치더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p12.b1": {
    "text": "희롱을 다한 후 … 도로 그의 옷을 입혀 십자가에 못 박으려고 끌고 나가니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p12.b2": {
    "text": "나가다가 시몬이란 구레네 사람을 만나매 그를 억지로 같이 가게 하여 예수의 십자가를 지웠더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p12.b3": {
    "text": "골고다 즉 해골의 곳이라는 곳에 이르러",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p12.b4": {
    "text": "쓸개탄 포도주를 예수께 주어 마시게 하려 하였더니 예수께서 맛보시고 마시고자 아니하시더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p13.b1": {
    "text": "저희가 예수를 십자가에 못 박은 후에 그 옷을 제비 뽑아 나누고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p13.b2": {
    "text": "거기 앉아 지키더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:36"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p13.b3": {
    "text": "그 머리 위에 이는 유대인의 왕 예수라 쓴 죄패를 붙였더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:37"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p13.b4": {
    "text": "이 때에 예수와 함께 강도 둘이 십자가에 못 박히니 하나는 우편에, 하나는 좌편에 있더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p14.b1": {
    "text": "지나가는 자들은 자기 머리를 흔들며 예수를 모욕하여",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p14.b2": {
    "text": "성전을 헐고 사흘에 짓는 자여 … 자기를 구원하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p14.b3": {
    "text": "네가 만일 하나님의 아들이어든 … 십자가에서 내려오라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p15.b1": {
    "text": "저가 남은 구원하였으되 자기는 구원할 수 없도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:42"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p15.b2": {
    "text": "저가 이스라엘의 왕이로다 지금 십자가에서 내려올지어다 그러면 우리가 믿겠노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:42"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p15.b3": {
    "text": "저가 하나님을 신뢰하니 하나님이 저를 기뻐하시면 이제 구원하실지라 제 말이 나는 하나님의 아들이라 하였도다 하며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:43"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p15.b4": {
    "text": "함께 십자가에 못박힌 강도들도 이와 같이 욕하더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:44"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p16.b1": {
    "text": "제 육시로부터 온 땅에 어두움이 임하여 제 구시까지 계속하더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:45"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p16.b2": {
    "text": "엘리 엘리 라마 사박다니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:46"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p16.b3": {
    "text": "이는 곧 나의 하나님, 나의 하나님, 어찌하여 나를 버리셨나이까 하는 뜻이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:46"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p16.b4": {
    "text": "이 사람이 엘리야를 부른다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:47"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p17.b1": {
    "text": "그 중에 한 사람이 곧 달려가서 해융을 가지고 신 포도주를 머금게 하여 갈대에 꿰어 마시우거늘",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:48"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p17.b2": {
    "text": "가만 두어라 엘리야가 와서 저를 구원하나 보자",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:49"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p17.b3": {
    "text": "예수께서 다시 크게 소리 지르시고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:50"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p17.b4": {
    "text": "영혼이 떠나시다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:50"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p18.b1": {
    "text": "이에 성소 휘장이 위로부터 아래까지 찢어져 둘이 되고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:51"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p18.b2": {
    "text": "땅이 진동하며 바위가 터지고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:51"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p18.b3": {
    "text": "무덤들이 열리며 자던 성도의 몸이 많이 일어나되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:52"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p18.b4": {
    "text": "예수의 부활 후에 저희가 무덤에서 나와서 거룩한 성에 들어가 많은 사람에게 보이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:53"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p19.b1": {
    "text": "백부장과 및 함께 예수를 지키던 자들이 지진과 그 되는 일들을 보고 심히 두려워하여 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:54"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p19.b2": {
    "text": "이는 진실로 하나님의 아들이었도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:54"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p19.b3": {
    "text": "예수를 섬기며 갈릴리에서부터 좇아 온 많은 여자가 거기 있어 멀리서 바라보고 있으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:55"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p19.b4": {
    "text": "그 중에 막달라 마리아와 또 야고보와 요셉의 어머니 마리아와 또 세베대의 아들들의 어머니도 있더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:56"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p20.b1": {
    "text": "저물었을 때에 아리마대 부자 요셉이라 하는 사람이 왔으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:57"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p20.b2": {
    "text": "그도 예수의 제자라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:57"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p20.b3": {
    "text": "빌라도에게 가서 예수의 시체를 달라 하니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:58"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p20.b4": {
    "text": "이에 빌라도가 내어주라 분부하거늘",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:58"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p21.b1": {
    "text": "요셉이 시체를 가져다가 정한 세마포로 싸서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:59"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p21.b2": {
    "text": "바위 속에 판 자기 새무덤에 넣어두고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:60"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p21.b3": {
    "text": "큰 돌을 굴려 무덤 문에 놓고 가니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:60"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p22.b1": {
    "text": "거기 막달라 마리아와 다른 마리아가",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:61"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p22.b2": {
    "text": "무덤을 향하여 앉았더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:61"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p23.b1": {
    "text": "그 이튿날은 예비일 다음 날이라 대제사장들과 바리새인들이 함께 빌라도에게 모여 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:62"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p23.b2": {
    "text": "주여 저 유혹하던 자가 살았을 때에 말하되 내가 사흘 후에 다시 살아나리라 한 것을 우리가 기억하노니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:63"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p23.b3": {
    "text": "그러므로 분부하여 그 무덤을 사흘까지 굳게 지키게 하소서 그의 제자들이 와서 시체를 도적질하여 가고 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:64"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p23.b4": {
    "text": "후의 유혹이 전보다 더 될까 하나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:64"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p24.b1": {
    "text": "너희에게 파숫군이 있으니 가서 힘대로 굳게 하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:65"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p24.b2": {
    "text": "저희가 파숫군과 함께 가서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:66"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p24.b3": {
    "text": "돌을 인봉하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:66"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.27.p24.b4": {
    "text": "무덤을 굳게 하니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 27:66"
    },
    "adapted": false,
    "status": "approved"
  }
}
