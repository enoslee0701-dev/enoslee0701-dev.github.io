{
  "genesis.33.p1.b1": {
    "text": "さてヤコブは目をあげ、エサウが四百人を率いて来るのを見た。 …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 33:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.33.p1.b2": {
    "text": "つかえめとその子供たちをまっ先に置き、レアとその子供たちを次に置き、ラケルとヨセフを最後に置いて、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 33:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.33.p1.b3": {
    "text": "みずから彼らの前に進み、七たび身を地にかがめて、兄に近づいた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 33:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.33.p2.b1": {
    "text": "するとエサウは走ってきて迎え、 …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 33:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.33.p2.b2": {
    "text": "… 彼を抱き、そのくびをかかえて口づけし、 …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 33:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.33.p2.b3": {
    "text": "… 共に泣いた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 33:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.33.p3.b1": {
    "text": "「あなたと一緒にいるこれらの者はだれですか」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 33:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.33.p3.b2": {
    "text": "「神がしもべに授けられた子供たちです」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 33:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.33.p3.b3": {
    "text": "そこでつかえめたちはその子供たちと共に近寄ってお辞儀した。 レアもまたその子供たちと共に近寄ってお辞儀し、 …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 33:6-7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.33.p3.b4": {
    "text": "… それからヨセフとラケルが近寄ってお辞儀した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 33:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.33.p4.b1": {
    "text": "「わたしが出会ったあのすべての群れはどうしたのですか」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 33:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.33.p4.b2": {
    "text": "「弟よ、わたしはじゅうぶんもっている。あなたの物はあなたのものにしなさい」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 33:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.33.p4.b3": {
    "text": "… あなたが喜んでわたしを迎えてくださるので、あなたの顔を見て、神の顔を見るように思います。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 33:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.33.p4.b4": {
    "text": "… こうして彼がしいたので、彼は受け取った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 33:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.33.p5.b1": {
    "text": "「さあ、立って行こう。わたしが先に行く」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 33:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.33.p5.b2": {
    "text": "「ごぞんじのように、子供たちは、かよわく、また乳を飲ませている羊や牛をわたしが世話をしています。 …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 33:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.33.p5.b3": {
    "text": "「いいえ、それには及びません。わが主の前に恵みを得させてください」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 33:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.33.p5.b4": {
    "text": "その日エサウはセイルへの帰途についた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 33:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.33.p6.b1": {
    "text": "ヤコブは立ってスコテに行き、自分のために家を建て、また家畜のために小屋を造った。 …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 33:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.33.p6.b2": {
    "text": "… 無事カナンの地のシケムの町に着き、町の前に宿営した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 33:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.33.p6.b3": {
    "text": "彼は天幕を張った野の一部をシケムの父ハモルの子らの手から百ケシタで買い取り、 そこに祭壇を建てて、これをエル・エロヘ・イスラエルと名づけた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 33:19-20"
    },
    "adapted": false,
    "status": "approved"
  }
}
