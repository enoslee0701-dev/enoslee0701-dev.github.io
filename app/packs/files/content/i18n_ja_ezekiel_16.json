{
  "ezekiel.16.p1.b1": {
    "text": "ひとりもあなたをあわれみ見る者なく、情をもってこれらのことの一つをも、あなたにしてやる者もなく、あなたの生れた日に、あなたはきらわれて、野原に捨てられた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 16:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.16.p1.b2": {
    "text": "わたしはあなたのかたわらを通り、…わたしは血の中にいるあなたに言った、『生きよ、野の木のように育て』と。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 16:6-7"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.16.p1.b3": {
    "text": "そしてあなたに誓い、あなたと契約を結んだ。そしてあなたはわたしのものとなった",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 16:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.16.p1.b4": {
    "text": "あなたの美しさのために、あなたの名声は国々に広まった。これはわたしが、あなたに施した飾りによって全うされたからであると、主なる神は言われる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 16:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.16.p2.b1": {
    "text": "ところが、あなたは自分の美しさをたのみ、自分の名声によって姦淫を行い",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 16:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.16.p2.b2": {
    "text": "あなたはわたしが与えた金銀の美しい飾りの品をとり、自分のために男の像を造って、これと姦淫を行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 16:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.16.p2.b3": {
    "text": "また縫い取りのある自分の衣をとって彼らに着せ、わたしの油と香とをその前に供え",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 16:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.16.p2.b4": {
    "text": "あなたはわたしの子どもを殺し、火の中を通らせて彼らにささげた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 16:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.16.p2.b5": {
    "text": "あなたはかえって価を払い、相手はあなたに払わない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 16:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.16.p2.b6": {
    "text": "彼らはあなたの高楼を倒し、台をこわし、あなたの衣をはぎ取り、あなたの美しい飾りの品を奪い",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 16:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.16.p3.b1": {
    "text": "あなたの姉はサマリヤ、サマリヤはその娘たちと共に、あなたの北に住み、あなたの妹はソドムで、その娘たちと共に、あなたの南に住んでいる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 16:46"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.16.p3.b2": {
    "text": "見よ、あなたの妹ソドムの罪はこれである。すなわち彼女と、その娘たちは高ぶり、食物に飽き、安泰に暮していたが、彼らは、乏しい者と貧しい者を助けなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 16:49"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.16.p3.b3": {
    "text": "それであなたも恥を受け、はずかしめを負わなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 16:52"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.16.p3.b4": {
    "text": "しかしわたしはあなたの若き日に、あなたと結んだ契約を覚え、永遠の契約をあなたと立てる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 16:60"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.16.p3.b5": {
    "text": "こうしてすべてあなたの行ったことにつき、わたしがあなたをゆるす時、あなたはそれを思い出して恥じ、その恥のゆえに重ねて口を開くことがない",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 16:63"
    },
    "adapted": false,
    "status": "approved"
  }
}
