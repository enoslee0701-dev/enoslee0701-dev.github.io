{
  "exodus.26.p1.b1": {
    "text": "あなたはまた十枚の幕をもって幕屋を造らなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 26:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.26.p1.b2": {
    "text": "すなわち亜麻の撚糸、青糸、紫糸、緋糸で幕を作り、巧みなわざをもって、それにケルビムを織り出さなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 26:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.26.p1.b3": {
    "text": "あなたはまた金の輪五十を作り、その輪で幕を互に連ね合わせて一つの幕屋にしなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 26:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.26.p2.b4": {
    "text": "また幕屋をおおう天幕のためにやぎの毛糸で幕を作らなければならない。すなわち幕十一枚を作り、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 26:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.26.p2.b5": {
    "text": "…その六枚目の幕を天幕の前で折り重ねなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 26:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.26.p2.b6": {
    "text": "また、あかね染めの雄羊の皮で天幕のおおいと、じゅごんの皮でその上にかけるおおいとを造らなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 26:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.26.p3.b7": {
    "text": "あなたは幕屋のために、アカシヤ材で立枠を造らなければならない。 枠の長さを十キュビト、枠の幅を一キュビト半とし、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 26:15-16"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.26.p3.b8": {
    "text": "その二十の枠の下に銀の座四十を造って…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 26:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.26.p3.b9": {
    "text": "枠のまん中にある中央の横木は端から端まで通るようにしなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 26:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.26.p3.b10": {
    "text": "こうしてあなたは山で示された様式に従って幕屋を建てなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 26:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.26.p4.b11": {
    "text": "また青糸、紫糸、緋糸、亜麻の撚糸で垂幕を作り、巧みなわざをもって、それにケルビムを織り出さなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 26:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.26.p4.b12": {
    "text": "…その垂幕の内にあかしの箱を納めなさい。その垂幕はあなたがたのために聖所と至聖所とを隔て分けるであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 26:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.26.p4.b13": {
    "text": "そしてその垂幕の外に机を置き、幕屋の南側に、机に向かい合わせて燭台を置かなければならない。ただし机は北側に置かなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 26:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.26.p4.b14": {
    "text": "あなたはまた天幕の入口のために青糸、紫糸、緋糸、亜麻の撚糸で、色とりどりに織ったとばりを作らなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 26:36"
    },
    "adapted": false,
    "status": "approved"
  }
}
