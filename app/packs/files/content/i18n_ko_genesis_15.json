{
  "genesis.15.p1.b1": {
    "text": "아브람아 두려워 말라 나는 너의 방패요 너의 지극히 큰 상급이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 15:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p1.b2": {
    "text": "주 여호와여 무엇을 내게 주시려나이까 나는 무자하오니 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 15:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p1.b3": {
    "text": "주께서 내게 씨를 아니주셨으니 내 집에서 길리운 자가 나의 후사가 될 것이니이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 15:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p2.b4": {
    "text": "그 사람은 너의 후사가 아니라 네 몸에서 날 자가 네 후사가 되리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 15:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p2.b5": {
    "text": "하늘을 우러러 뭇별을 셀 수 있나 보라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 15:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p2.b6": {
    "text": "네 자손이 이와 같으리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 15:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p2.b7": {
    "text": "아브람이 여호와를 믿으니 여호와께서 이를 그의 의로 여기시고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 15:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p3.b8": {
    "text": "나는 이땅을 네게 주어 업을 삼게 하려고 너를 갈대아 우르에서 이끌어 낸 여호와로라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 15:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p3.b9": {
    "text": "주 여호와여 내가 이 땅으로 업을 삼을 줄을 무엇으로 알리이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 15:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p3.b10": {
    "text": "나를 위하여 삼년 된 암소와 삼년 된 암염소와 삼년된 수양과 산비둘기와 집비둘기 새끼를 취할지니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 15:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p3.b11": {
    "text": "솔개가 그 사체 위에 내릴 때에는 아브람이 쫓았더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 15:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p4.b12": {
    "text": "해질 때에 아브람이 깊이 잠든 중에 캄캄함이 임하므로 심히 두려워하더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 15:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p4.b13": {
    "text": "너는 정녕히 알라 네 자손이 이방에서 객이 되어 그들을 섬기겠고 그들은 사백년 동안 네 자손을 괴롭게 하리니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 15:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p4.b14": {
    "text": "… 그 후에 네 자손이 큰 재물을 이끌고 나오리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 15:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p4.b15": {
    "text": "너는 장수하다가 평안히 조상에게로 돌아가 … 네 자손은 사대만에 이 땅으로 돌아 오리니 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 15:15-16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p5.b16": {
    "text": "해가 져서 어둘 때에",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 15:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p5.b17": {
    "text": "연기 나는 풀무가 보이며 타는 횃불이 쪼갠 고기 사이로 지나더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 15:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p6.b18": {
    "text": "그 날에 여호와께서 아브람으로 더불어 언약을 세워 가라사대",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 15:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p6.b19": {
    "text": "내가 이 땅을 애굽강에서부터 그 큰 강 유브라데까지 네 자손에게 주노니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 15:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.15.p6.b20": {
    "text": "곧 겐 족속과 그니스 족속과 갓몬 족속과 헷 족속과 브리스 족속과 르바 족속과 아모리 족속과 가나안 족속과 기르가스 족속과 여부스 족속의 땅이니라 하셨더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 15:19-21"
    },
    "adapted": false,
    "status": "approved"
  }
}
