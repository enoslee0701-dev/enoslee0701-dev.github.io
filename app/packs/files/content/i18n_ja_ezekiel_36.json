{
  "ezekiel.36.p1.b1": {
    "text": "ああ、昔の高き所が、われわれのものとなった",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 36:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.36.p1.b2": {
    "text": "山と、丘と、くぼ地と、谷と、滅びた荒れ跡と、人の捨てた町々、すなわちその周囲にある諸国民の残った者にかすめられ、あざけられるようになったもの……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 36:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.36.p1.b3": {
    "text": "イスラエルの山々よ、主の言葉を聞け。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 36:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.36.p1.b4": {
    "text": "しかしイスラエルの山々よ、あなたがたは枝を出し、わが民イスラエルのために実を結ぶ。この事の成るのは近い。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 36:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.36.p1.b5": {
    "text": "見よ、わたしはあなたがたに臨み、あなたがたを顧みる。あなたがたは耕され、種をまかれる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 36:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.36.p1.b6": {
    "text": "町々には人が住み、荒れ跡は建て直される。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 36:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.36.p2.b1": {
    "text": "これは主の民であるが、その国から出た者である",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 36:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.36.p2.b2": {
    "text": "わたしはあなたがたを諸国民の中から導き出し、万国から集めて、あなたがたの国に行かせる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 36:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.36.p2.b3": {
    "text": "わたしは清い水をあなたがたに注いで、すべての汚れから清め……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 36:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.36.p2.b4": {
    "text": "わたしは新しい心をあなたがたに与え、新しい霊をあなたがたの内に授け……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 36:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.36.p2.b5": {
    "text": "あなたがたの肉から、石の心を除いて、肉の心を与える。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 36:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.36.p3.b1": {
    "text": "荒れた地は、行き来の人々の目に荒れ地と見えたのに引きかえて耕される。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 36:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.36.p3.b2": {
    "text": "この荒れた地は、エデンの園のようになった。荒れ、滅び、くずれた町々は、堅固になり、人の住む所となった",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 36:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.36.p3.b3": {
    "text": "犠牲のための群れのように、エルサレムの祝い日の群れのようにすることである。こうして荒れた町々は人の群れで満ちる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 36:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.36.p3.b4": {
    "text": "主なるわたしがこれを言い、これをなすのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 36:36"
    },
    "adapted": false,
    "status": "approved"
  }
}
