{
  "zephaniah.1.p1.b1": {
    "text": "ユダの王アモンの子ヨシヤの世に、ゼパニヤに臨んだ主の言葉。ゼパニヤはクシの子、クシはゲダリヤの子、ゲダリヤはアマリヤの子、アマリヤはヒゼキヤの子である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 1:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.1.p1.b2": {
    "text": "わたしは地のおもてからすべてのものを一掃する",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 1:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.1.p1.b3": {
    "text": "わたしは人も獣も一掃し、空の鳥、海の魚をも一掃する……わたしは地のおもてから人を絶ち滅ぼす",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 1:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.1.p1.b4": {
    "text": "「わたしはユダとエルサレムのすべての住民との上に手を伸べる。わたしはこの所からバアルの残党と、偶像の祭司の名とを断つ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 1:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.1.p1.b5": {
    "text": "また屋上で天の万象を拝む者、主に誓いを立てて拝みながら、またミルコムをさして誓う者、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 1:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.1.p1.b6": {
    "text": "主なる神の前に沈黙せよ。主の日は近づき……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 1:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.1.p1.b7": {
    "text": "主の犠牲をささげる日に、「わたしはつかさたちと王の子たち、およびすべて異邦の衣服を着る者を罰する。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 1:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.1.p1.b8": {
    "text": "その日にわたしはまた、すべて敷居をとび越え、暴虐と欺きとを自分の主君の家に満たす者を罰する」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 1:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.1.p2.b1": {
    "text": "その日には魚の門から叫び声がおこり、第二の町からうめき声がおこり、もろもろの丘からすさまじい響きがおこる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 1:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.1.p2.b2": {
    "text": "しっくいの家の住民よ、泣き叫べ。あきないする民は皆滅ぼされ、銀を量る者は皆断たれるからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 1:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.1.p2.b3": {
    "text": "その時、わたしはともしびをもって、エルサレムを尋ねる。そして滓の上に凝り固まり……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 1:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.1.p2.b4": {
    "text": "その心の中で『主は良いことも、悪いこともしない』",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 1:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.1.p2.b5": {
    "text": "彼らは家を建てても、それに住むことができない、ぶどう畑を作っても、そのぶどう酒を飲むことができない",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 1:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.1.p2.b6": {
    "text": "主の大いなる日は近い、近づいて、すみやかに来る。主の日の声は耳にいたい。そこに、勇士もいたく叫ぶ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 1:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.1.p2.b7": {
    "text": "その日は怒りの日……暗く、薄暗い日、雲と黒雲の日",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 1:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.1.p2.b8": {
    "text": "ラッパとときの声の日、堅固な町と高いやぐらを攻める日である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 1:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.1.p2.b9": {
    "text": "彼らの銀も金も、主の怒りの日には彼らを救うことができない。全地は主のねたみの火にのまれる……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 1:18"
    },
    "adapted": false,
    "status": "approved"
  }
}
