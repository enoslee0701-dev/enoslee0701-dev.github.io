{
  "jonah.2.p1.b1": {
    "text": "요나가 물고기 뱃속에서 그 하나님 여호와께 기도하여",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Jonah 2:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.2.p1.b2": {
    "text": "내가 받는 고난을 인하여 여호와께 불러 아뢰었삽더니 주께서 내게 대답하셨고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Jonah 2:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.2.p1.b3": {
    "text": "내가 스올의 뱃속에서 부르짖었삽더니 주께서 나의 음성을 들으셨나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Jonah 2:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.2.p1.b4": {
    "text": "주께서 나를 깊음 속 바다 가운데 던지셨으므로 … 주의 파도와 큰 물결이 다 내 위에 넘쳤나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Jonah 2:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.2.p2.b1": {
    "text": "내가 말하기를 내가 주의 목전에서 쫓겨났을지라도 다시 주의 성전을 바라보겠다 하였나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Jonah 2:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.2.p2.b2": {
    "text": "물이 나를 둘렀으되 영혼까지 하였사오며 … 바다 풀이 내 머리를 쌌나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Jonah 2:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.2.p2.b3": {
    "text": "내가 산의 뿌리까지 내려갔사오며 땅이 그 빗장으로 나를 오래도록 막았사오나",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Jonah 2:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.2.p3.b1": {
    "text": "나의 하나님 여호와여 주께서 내 생명을 구덩이에서 건지셨나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Jonah 2:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.2.p3.b2": {
    "text": "내 영혼이 내 속에서 피곤할 때에 내가 여호와를 생각하였삽더니 내 기도가 주께 이르렀사오며 주의 성전에 미쳤나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Jonah 2:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.2.p3.b3": {
    "text": "무릇 거짓되고 헛된 것을 숭상하는 자는 자기에게 베푸신 은혜를 버렸사오나",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Jonah 2:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.2.p3.b4": {
    "text": "나는 감사하는 목소리로 주께 제사를 드리며 나의 서원을 주께 갚겠나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Jonah 2:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.2.p4.b1": {
    "text": "구원은 여호와께로서 말미암나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Jonah 2:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.2.p4.b2": {
    "text": "여호와께서 물고기에게 명하시매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Jonah 2:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.2.p4.b3": {
    "text": "요나를 육지에 토하니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Jonah 2:10"
    },
    "adapted": false,
    "status": "approved"
  }
}
