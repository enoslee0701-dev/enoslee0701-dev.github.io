{
  "kings2.1.p1.b1": {
    "text": "アハブが死んだ後、モアブはイスラエルにそむいた。 さてアハジヤはサマリヤにある高殿のらんかんから落ちて病気になったので、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 1:1-2"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.1.p1.b2": {
    "text": "行ってエクロンの神バアル・ゼブブに、この病気がなおるかどうかを尋ねよ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 1:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.1.p1.b3": {
    "text": "立って、上って行き、サマリヤの王の使者に会って言いなさい、『あなたがたがエクロンの神バアル・ゼブブに尋ねようとして行くのは、イスラエルに神がないためか』",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 1:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.1.p2.b1": {
    "text": "彼らは言った、「ひとりの人が上ってきて、われわれに会って言いました、『… それゆえあなたは、登った寝台から降りることなく、必ず死ぬであろう』」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 1:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.1.p2.b2": {
    "text": "上ってきて、あなたがたに会って、これらの事を告げた人はどんな人であったか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 1:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.1.p2.b3": {
    "text": "その人は毛ごろもを着て、腰に皮の帯を締めていました",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 1:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.1.p2.b4": {
    "text": "その人はテシべびとエリヤだ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 1:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.1.p3.b1": {
    "text": "そこで王は五十人の長を、部下の五十人と共にエリヤの所へつかわした。… エリヤは山の頂にすわっていた …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 1:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.1.p3.b2": {
    "text": "神の人よ、王があなたに、下って来るようにと言われます",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 1:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.1.p3.b3": {
    "text": "わたしがもし神の人であるならば、火が天から下って、あなたと部下の五十人とを焼き尽すでしょう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 1:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.1.p3.b4": {
    "text": "そのように火が天から下って、彼と部下の五十人とを焼き尽した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 1:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.1.p4.b1": {
    "text": "神の人よ、王がこう命じられます、『すみやかに下ってきなさい』",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 1:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.1.p4.b2": {
    "text": "そのように神の火が天から下って、彼と部下の五十人とを焼き尽した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 1:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.1.p4.b3": {
    "text": "神の人よ、どうぞ、わたしの命と、あなたのしもべであるこの五十人の命をあなたの目に尊いものとみなしてください。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 1:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.1.p5.b1": {
    "text": "彼と共に下りなさい。彼を恐れてはならない",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 1:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.1.p5.b2": {
    "text": "主はこう仰せられます、『… それはイスラエルに、その言葉を求むべき神がないためであるか。それゆえあなたは、登った寝台から降りることなく、必ず死ぬであろう』",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 1:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "kings2.1.p5.b3": {
    "text": "彼はエリヤが言った主の言葉のとおりに死んだが、彼に子がなかったので、その兄弟ヨラムが彼に代って王となった。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Kings 1:17"
    },
    "adapted": false,
    "status": "approved"
  }
}
