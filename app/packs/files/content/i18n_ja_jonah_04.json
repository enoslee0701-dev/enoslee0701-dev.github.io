{
  "jonah.4.p1.b1": {
    "text": "ところがヨナはこれを非常に不快として、激しく怒り、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Jonah 4:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.4.p1.b2": {
    "text": "「主よ……わたしはあなたが恵み深い神、あわれみあり、怒ることおそく、いつくしみ豊かで、災を思いかえされることを、知っていたからです。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Jonah 4:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.4.p1.b3": {
    "text": "それでこそわたしは、急いでタルシシにのがれようとしたのです。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Jonah 4:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.4.p1.b4": {
    "text": "それで主よ、どうぞ今わたしの命をとってください。わたしにとっては、生きるよりも死ぬ方がましだからです」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Jonah 4:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.4.p2.b1": {
    "text": "「あなたの怒るのは、よいことであろうか」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Jonah 4:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.4.p2.b2": {
    "text": "そこでヨナは町から出て、町の東の方に座し",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Jonah 4:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.4.p2.b3": {
    "text": "そこに自分のために一つの小屋を造り、町のなりゆきを見きわめようと、その下の日陰にすわっていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Jonah 4:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.4.p3.b1": {
    "text": "時に主なる神は、ヨナを暑さの苦痛から救うために、とうごまを備えて、それを育て、ヨナの頭の上に日陰を設けた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Jonah 4:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.4.p3.b2": {
    "text": "ヨナはこのとうごまを非常に喜んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Jonah 4:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.4.p4.b1": {
    "text": "ところが神は翌日の夜明けに虫を備えて、そのとうごまをかませられたので、それは枯れた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Jonah 4:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.4.p4.b2": {
    "text": "やがて太陽が出たとき、神が暑い東風を備え、また太陽がヨナの頭を照したので、ヨナは弱りはて",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Jonah 4:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.4.p4.b3": {
    "text": "死ぬことを願って言った、「生きるよりも死ぬ方がわたしにはましだ」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Jonah 4:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.4.p4.b4": {
    "text": "「とうごまのためにあなたの怒るのはよくない」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Jonah 4:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.4.p4.b5": {
    "text": "「わたしは怒りのあまり狂い死にそうです」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Jonah 4:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.4.p5.b1": {
    "text": "「あなたは労せず、育てず、一夜に生じて、一夜に滅びたこのとうごまをさえ、惜しんでいる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Jonah 4:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.4.p5.b2": {
    "text": "ましてわたしは十二万あまりの、右左をわきまえない人々と",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Jonah 4:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "jonah.4.p5.b3": {
    "text": "あまたの家畜とのいるこの大きな町ニネベを、惜しまないでいられようか」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Jonah 4:11"
    },
    "adapted": false,
    "status": "approved"
  }
}
