{
  "romans.12.p1.b1": {
    "text": "兄弟たちよ。そういうわけで、神のあわれみによってあなたがたに勧める。あなたがたのからだを、神に喜ばれる、生きた、聖なる供え物としてささげなさい。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 12:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.12.p1.b2": {
    "text": "あなたがたは、この世と妥協してはならない。むしろ、心を新たにすることによって、造りかえられ …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 12:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.12.p1.b3": {
    "text": "… 何が神の御旨であるか、何が善であって、神に喜ばれ、かつ全きことであるかを、わきまえ知るべきである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 12:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.12.p2.b1": {
    "text": "… 思うべき限度を越えて思いあがることなく …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 12:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.12.p2.b2": {
    "text": "… 一つのからだにたくさんの肢体があるが …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 12:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.12.p2.b3": {
    "text": "わたしたちも数は多いが、キリストにあって一つのからだであり、また各自は互に肢体だからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 12:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.12.p3.b1": {
    "text": "… わたしたちは与えられた恵みによって、それぞれ異なった賜物を持っている …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 12:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.12.p3.b2": {
    "text": "奉仕であれば奉仕をし …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 12:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.12.p3.b3": {
    "text": "… また教える者であれば教え",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 12:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.12.p3.b4": {
    "text": "… 寄附する者は惜しみなく寄附し、指導する者は熱心に指導し、慈善をする者は快く慈善をすべきである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 12:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.12.p4.b1": {
    "text": "愛には偽りがあってはならない。悪は憎み退け、善には親しみ結び、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 12:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.12.p4.b2": {
    "text": "兄弟の愛をもって互にいつくしみ、進んで互に尊敬し合いなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 12:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.12.p4.b3": {
    "text": "望みをいだいて喜び、患難に耐え、常に祈りなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 12:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.12.p4.b4": {
    "text": "貧しい聖徒を助け、努めて旅人をもてなしなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 12:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.12.p5.b1": {
    "text": "あなたがたを迫害する者を祝福しなさい。祝福して、のろってはならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 12:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.12.p5.b2": {
    "text": "喜ぶ者と共に喜び …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 12:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.12.p5.b3": {
    "text": "… 泣く者と共に泣きなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 12:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.12.p5.b4": {
    "text": "互に思うことをひとつにし、高ぶった思いをいだかず、かえって低い者たちと交わるがよい。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 12:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.12.p6.b1": {
    "text": "だれに対しても悪をもって悪に報いず、すべての人に対して善を図りなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 12:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.12.p6.b2": {
    "text": "「主が言われる。復讐はわたしのすることである。わたし自身が報復する」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 12:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.12.p6.b3": {
    "text": "「もしあなたの敵が飢えるなら、彼に食わせ、かわくなら、彼に飲ませなさい …」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 12:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "romans.12.p6.b4": {
    "text": "悪に負けてはいけない。かえって、善をもって悪に勝ちなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Romans 12:21"
    },
    "adapted": false,
    "status": "approved"
  }
}
