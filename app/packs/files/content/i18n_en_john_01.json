{
  "john.1.p1.b1": {
    "text": "In the beginning was the Word,",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p1.b2": {
    "text": "and the Word was with God, and the Word was God.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p1.b3": {
    "text": "He was with God in the beginning.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p2.b1": {
    "text": "Through Him all things were made, and without Him nothing was made that has been made.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p2.b2": {
    "text": "In Him was life, and that life was the light of men.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p2.b3": {
    "text": "The Light shines in the darkness, and the darkness has not overcome it.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p3.b1": {
    "text": "There came a man who was sent from God. His name was John.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p3.b2": {
    "text": "He came as a witness to testify about the Light, so that through him everyone might believe.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p3.b3": {
    "text": "He himself was not the Light, but he came to testify about the Light.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p4.b1": {
    "text": "The true Light who gives light to every man was coming into the world.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p4.b2": {
    "text": "He was in the world, and though the world was made through Him, the world did not recognize Him.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p4.b3": {
    "text": "He came to His own, and His own did not receive Him.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p5.b1": {
    "text": "But to all who did receive Him, to those who believed in His name,",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p5.b2": {
    "text": "He gave the right to become children of God—",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p5.b3": {
    "text": "children born not of blood, nor of the desire or will of man, but born of God.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p6.b1": {
    "text": "The Word became flesh and made His dwelling among us.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p6.b2": {
    "text": "… full of grace and truth.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p6.b3": {
    "text": "We have seen His glory, the glory of the one and only Son from the Father,",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p7.b1": {
    "text": "“This is He of whom I said, ‘He who comes after me has surpassed me because He was before me.’”",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p7.b2": {
    "text": "From His fullness we have all received grace upon grace.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p7.b3": {
    "text": "For the law was given through Moses; grace and truth came through Jesus Christ.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p7.b4": {
    "text": "No one has ever seen God, but the one and only Son, who is Himself God and is at the Father’s side, has made Him known.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p8.b1": {
    "text": "… the Jews of Jerusalem sent priests and Levites to ask him,",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p8.b2": {
    "text": "“Who are you?”",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p8.b3": {
    "text": "“I am not the Christ.”",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p8.b4": {
    "text": "“Who are you? We need an answer for those who sent us. What do you say about yourself?”",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p9.b1": {
    "text": "“I am a voice of one calling in the wilderness, ‘Make straight the way for the Lord.’”",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p9.b2": {
    "text": "“Why then do you baptize, if you are not the Christ, nor Elijah, nor the Prophet?”",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p9.b3": {
    "text": "“I baptize with water,” … “but among you stands One you do not know.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p9.b4": {
    "text": "He is the One who comes after me, the straps of whose sandals I am not worthy to untie.”",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p10.b1": {
    "text": "The next day John saw Jesus coming toward him and said,",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p10.b2": {
    "text": "“Look, the Lamb of God, who takes away the sin of the world!",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p10.b3": {
    "text": "This is He of whom I said, ‘A man who comes after me has surpassed me because He was before me.’",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p10.b4": {
    "text": "I myself did not know Him, but the reason I came baptizing with water was that He might be revealed to Israel.”",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p11.b1": {
    "text": "“I saw the Spirit descending from heaven like a dove and resting on Him.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p11.b2": {
    "text": "… the One who sent me to baptize with water told me, ‘The man on whom you see the Spirit descend and rest is He who will baptize with the Holy Spirit.’",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p11.b3": {
    "text": "I have seen and testified that this is the Son of God.”",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p12.b1": {
    "text": "The next day John was there again with two of his disciples.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p12.b2": {
    "text": "When he saw Jesus walking by, he said,",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:36"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p12.b3": {
    "text": "“Look, the Lamb of God!”",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:36"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p12.b4": {
    "text": "And when the two disciples heard him say this, they followed Jesus.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:37"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p13.b1": {
    "text": "“What do you want?”",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p13.b2": {
    "text": "“Rabbi” … “where are You staying?”",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p13.b3": {
    "text": "“Come and see,”",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p13.b4": {
    "text": "… and spent that day with Him. It was about the tenth hour.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p14.b1": {
    "text": "Andrew, Simon Peter’s brother, was one of the two who heard John’s testimony and followed Jesus.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p14.b2": {
    "text": "“We have found the Messiah”",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p14.b3": {
    "text": "Andrew brought him to Jesus,",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:42"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p14.b4": {
    "text": "“You are Simon son of John. You will be called Cephas”",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:42"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p15.b1": {
    "text": "“Follow Me.”",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:43"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p15.b2": {
    "text": "“We have found the One Moses wrote about in the Law, the One the prophets foretold—Jesus of Nazareth, the son of Joseph.”",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:45"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p15.b3": {
    "text": "“Can anything good come from Nazareth?”",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:46"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p15.b4": {
    "text": "“Come and see,”",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:46"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p16.b1": {
    "text": "“Here is a true Israelite, in whom there is no deceit.”",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:47"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p16.b2": {
    "text": "“How do You know me?”",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:48"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p16.b3": {
    "text": "“Before Philip called you, I saw you under the fig tree.”",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:48"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p16.b4": {
    "text": "“Rabbi,” … “You are the Son of God! You are the King of Israel!”",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:49"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p17.b1": {
    "text": "“Do you believe just because I told you I saw you under the fig tree? You will see greater things than these.”",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:50"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p17.b2": {
    "text": "“Truly, truly, I tell you,",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:51"
    },
    "adapted": false,
    "status": "approved"
  },
  "john.1.p17.b3": {
    "text": "you will all see heaven open and the angels of God ascending and descending on the Son of Man.”",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "John 1:51"
    },
    "adapted": false,
    "status": "approved"
  }
}
