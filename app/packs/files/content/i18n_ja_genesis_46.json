{
  "genesis.46.p1.b1": {
    "text": "イスラエルはその持ち物をことごとく携えて旅立ち、ベエルシバに行って、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 46:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p1.b2": {
    "text": "父イサクの神に犠牲をささげた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 46:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p1.b3": {
    "text": "「ヤコブよ、ヤコブよ」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 46:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p1.b4": {
    "text": "「ここにいます」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 46:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p1.b5": {
    "text": "エジプトに下るのを恐れてはならない。… わたしはあなたと一緒にエジプトに下り、また必ずあなたを導き上るであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 46:3-4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p2.b1": {
    "text": "そしてヤコブはベエルシバを立った。イスラエルの子らはヤコブを乗せるためにパロの送った車に、父ヤコブと幼な子たちと妻たちを乗せ、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 46:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p2.b2": {
    "text": "またその家畜とカナンの地で得た財産を携え、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 46:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p2.b3": {
    "text": "ヤコブとその子孫は皆ともにエジプトへ行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 46:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p3.b1": {
    "text": "イスラエルの子らでエジプトへ行った者の名は次のとおりである。… ヤコブの長子はルベン。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 46:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p3.b2": {
    "text": "ユダの子らはエル、オナン、シラ、ペレヅ、ゼラ。エルとオナンはカナンの地で死んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 46:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p3.b3": {
    "text": "これらと娘デナとはレアがパダンアラムでヤコブに産んだ子らである。その子らと娘らは合わせて三十三人。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 46:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p4.b1": {
    "text": "これらは … ジルパの子らである。彼女はこれらをヤコブに産んだ。合わせて十六人。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 46:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p4.b2": {
    "text": "ヤコブの妻ラケルの子らはヨセフとベニヤミンとである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 46:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p4.b3": {
    "text": "エジプトの国でヨセフにマナセとエフライムとが生れた。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 46:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p4.b4": {
    "text": "エジプトへ行ったヤコブの家の者は合わせて七十人であった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 46:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p5.b1": {
    "text": "さてヤコブはユダをさきにヨセフにつかわして、ゴセンで会おうと言わせた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 46:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p5.b2": {
    "text": "ヨセフは車を整えて、父イスラエルを迎えるためにゴセンに上り、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 46:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p5.b3": {
    "text": "父に会い、そのくびを抱き、くびをかかえて久しく泣いた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 46:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p5.b4": {
    "text": "「あなたがなお生きていて、わたしはあなたの顔を見たので今は死んでもよい」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 46:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p6.b1": {
    "text": "「わたしは上ってパロに言おう、『カナンの地にいたわたしの兄弟たちと父の家族とがわたしの所へきました。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 46:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p6.b2": {
    "text": "もしパロがあなたがたを召して、『あなたがたの職業は何か』と言われたら、『しもべらは幼い時から、ずっと家畜の牧者です。…』と言いなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 46:33-34"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.46.p6.b3": {
    "text": "そうすればあなたがたはゴセンの地に住むことができましょう。羊飼はすべて、エジプトびとの忌む者だからです」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 46:34"
    },
    "adapted": false,
    "status": "approved"
  }
}
