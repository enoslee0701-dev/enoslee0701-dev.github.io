{
  "genesis.8.p1.b1": {
    "text": "神はノアと、箱舟の中にいたすべての生き物と、すべての家畜とを心にとめられた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 8:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p1.b2": {
    "text": "神が風を地の上に吹かせられたので、水は退いた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 8:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p1.b3": {
    "text": "また淵の源と、天の窓とは閉ざされて、天から雨が降らなくなった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 8:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p2.b4": {
    "text": "箱舟は七月十七日にアララテの山にとどまった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 8:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p2.b5": {
    "text": "水はしだいに減って、十月になり、十月一日に山々の頂が現れた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 8:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p3.b6": {
    "text": "四十日たって、ノアはその造った箱舟の窓を開いて、からすを放った …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 8:6-7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p3.b7": {
    "text": "はとは足の裏をとどめる所が見つからなかったので …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 8:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p3.b8": {
    "text": "箱舟のノアのもとに帰ってきた。… 彼は手を伸べて、これを捕え、箱舟の中の彼のもとに引き入れた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 8:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p4.b9": {
    "text": "はとは夕方になって彼のもとに帰ってきた。見ると、そのくちばしには、オリブの若葉があった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 8:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p4.b10": {
    "text": "ノアは地から水がひいたのを知った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 8:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p4.b11": {
    "text": "さらに七日待ってまた、はとを放ったところ、もはや彼のもとには帰ってこなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 8:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p5.b12": {
    "text": "六百一歳の一月一日になって、地の上の水はかれた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 8:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p5.b13": {
    "text": "ノアが箱舟のおおいを取り除いて見ると、土のおもては、かわいていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 8:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p5.b14": {
    "text": "二月二十七日になって、地は全くかわいた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 8:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p6.b15": {
    "text": "「あなたは妻と、子らと、子らの妻たちと共に箱舟を出なさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 8:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p6.b16": {
    "text": "… これらのものが地に群がり、地の上にふえ広がるようにしなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 8:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p6.b17": {
    "text": "ノアは共にいた子らと、妻と、子らの妻たちとを連れて出た。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 8:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p6.b18": {
    "text": "またすべての獣、すべての這うもの、すべての鳥、すべて地の上に動くものは皆、種類にしたがって箱舟を出た。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 8:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p7.b19": {
    "text": "ノアは主に祭壇を築いて、すべての清い獣と、すべての清い鳥とのうちから取って、燔祭を祭壇の上にささげた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 8:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p7.b20": {
    "text": "わたしはもはや二度と人のゆえに地をのろわない。… わたしは、このたびしたように、もう二度と、すべての生きたものを滅ぼさない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 8:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.8.p7.b21": {
    "text": "地のある限り、種まきの時も、刈入れの時も、暑さ寒さも、夏冬も、昼も夜もやむことはないであろう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 8:22"
    },
    "adapted": false,
    "status": "approved"
  }
}
