{
  "mark.6.p1.b1": {
    "text": "예수께서 거기를 떠나사 고향으로 가시니 제자들도 좇으니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p1.b2": {
    "text": "이 사람이 어디서 이런 것을 얻었느뇨",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p1.b3": {
    "text": "이 사람의 받은 지혜와",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p1.b4": {
    "text": "그 손으로 이루어지는 이런 권능이 어찌 됨이뇨",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p2.b1": {
    "text": "이 사람이 마리아의 아들 목수가 아니냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p2.b2": {
    "text": "야고보와 요셉과 유다와 시몬의 형제가 아니냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p2.b3": {
    "text": "그 누이들이 우리와 함께 여기 있지 아니하냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p2.b4": {
    "text": "예수를 배척한지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p3.b1": {
    "text": "선지자가 자기 고향과 자기 친척과 자기 집 외에서는 존경을 받지 않음이 없느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p3.b2": {
    "text": "거기서는 아무 권능도 행하실 수 없어 다만 소수의 병인에게 안수하여 고치실 뿐이었고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p3.b3": {
    "text": "저희의 믿지 않음을 이상히 여기셨더라 이에 모든 촌에 두루 다니시며 가르치시더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p4.b1": {
    "text": "열 두 제자를 부르사 둘씩 둘씩 보내시며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p4.b2": {
    "text": "더러운 귀신을 제어하는 권세를 주시고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p4.b3": {
    "text": "명하시되 여행을 위하여 지팡이 외에는",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p4.b4": {
    "text": "양식이나 주머니나 전대의 돈이나 아무 것도 가지지 말며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p5.b1": {
    "text": "어디서든지 뉘 집에 들어가거든",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p5.b2": {
    "text": "그곳을 떠나기까지 거기 유하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p5.b3": {
    "text": "어느 곳에서든지 너희를 영접지 아니하고 너희 말을 듣지도 아니하거든",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p5.b4": {
    "text": "거기서 나갈 때에 발 아래 먼지를 떨어버려 저희에게 증거를 삼으라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p6.b1": {
    "text": "제자들이 나가서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p6.b2": {
    "text": "회개하라 전파하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p6.b3": {
    "text": "많은 귀신을 쫓아내며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p6.b4": {
    "text": "많은 병인에게 기름을 발라 고치더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p7.b1": {
    "text": "이는 세례 요한이 죽은 자 가운데서 살아났도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p7.b2": {
    "text": "이가 엘리야라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p7.b3": {
    "text": "이가 선지자니 옛 선지자 중의 하나와 같다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p7.b4": {
    "text": "내가 목 베인 요한 그가 살아났다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p8.b1": {
    "text": "전에 헤롯이 자기가 동생 빌립의 아내 헤로디아에게 장가 든고로",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p8.b2": {
    "text": "동생의 아내를 취한 것이 옳지 않다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p8.b3": {
    "text": "헤로디아가 요한을 원수로 여겨 죽이고자 하였으되 하지 못한 것은",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p8.b4": {
    "text": "헤롯이 요한을 의롭고 거룩한 사람으로 알고 두려워하여 보호하며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p9.b1": {
    "text": "마침 기회 좋은 날이 왔으니 곧 헤롯이 자기 생일에…잔치할새",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p9.b2": {
    "text": "헤로디아의 딸이 친히 들어와 춤을 추어 헤롯과 및 함께 앉은 자들을 기쁘게 한지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p9.b3": {
    "text": "무엇이든지 너 원하는 것을 내게 구하라 내가 주리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p9.b4": {
    "text": "내 나라의 절반까지라도 주리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p10.b1": {
    "text": "내가 무엇을 구하리이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p10.b2": {
    "text": "세례 요한의 머리를 구하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p10.b3": {
    "text": "세례 요한의 머리를 소반에 담아 곧 내게 주기를 원하옵나이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p11.b1": {
    "text": "왕이 심히 근심하나 자기의 멩세한 것과 그 앉은 자들을 인하여 저를 거절할 수 없는지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p11.b2": {
    "text": "왕이 곧 시위병 하나를 보내어 요한의 머리를 가져오라 명하니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p11.b3": {
    "text": "그 사람이 나가 옥에서 요한을 목 베어",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p11.b4": {
    "text": "여아가 이것을 그 어미에게 주니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p12.b1": {
    "text": "요한의 제자들이 듣고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p12.b2": {
    "text": "와서 시체를 가져다가",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p12.b3": {
    "text": "장사하니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p13.b1": {
    "text": "사도들이 예수께 모여 자기들의 행한 것과 가르친 것을 낱낱이 고하니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p13.b2": {
    "text": "너희는 따로 한적한 곳에 와서 잠간 쉬어라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p13.b3": {
    "text": "이는 오고 가는 사람이 많아 음식 먹을 겨를도 없음이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p13.b4": {
    "text": "이에 배를 타고 따로 한적한 곳에 갈새",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p14.b1": {
    "text": "모든 고을로부터 도보로 그 곳에 달려와 저희보다 먼저 갔더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p14.b2": {
    "text": "예수께서 나오사 큰 무리를 보시고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p14.b3": {
    "text": "그 목자 없는 양 같음을 인하여 불쌍히 여기사",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p14.b4": {
    "text": "이에 여러 가지로 가르치시더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p15.b1": {
    "text": "이곳은 빈 들이요 때도 저물어가니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p15.b2": {
    "text": "무리를 보내어 두루 촌과 마을로 가서 무엇을 사 먹게 하옵소서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:36"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p15.b3": {
    "text": "너희가 먹을 것을 주라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:37"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p15.b4": {
    "text": "우리가 가서 이백 데나리온의 떡을 사다 먹이리이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:37"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p16.b1": {
    "text": "너희에게 떡 몇 개나 있느냐 가서 보라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p16.b2": {
    "text": "떡 다섯 개와 물고기 두 마리가 있더이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p16.b3": {
    "text": "제자들을 명하사 그 모든 사람으로 떼를 지어 푸른 잔디 위에 앉게 하시니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p16.b4": {
    "text": "떼로 혹 백씩, 혹 오십씩 앉은지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p17.b1": {
    "text": "예수께서 떡 다섯개와 물고기 두 마리를 가지사 하늘을 우러러 축사하시고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p17.b2": {
    "text": "떡을 떼어 제자들에게 주어",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p17.b3": {
    "text": "사람들 앞에 놓게 하시고 또 물고기 두 마리도 모든 사람에게 나누어 주시매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p18.b1": {
    "text": "다 배불리 먹고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:42"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p18.b2": {
    "text": "남은 떡 조각과 물고기를 열 두 바구니에 차게 거두었으며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:43"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p18.b3": {
    "text": "떡을 먹은 남자가 오천명이었더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:44"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p19.b1": {
    "text": "예수께서 즉시 제자들을 재촉하사 자기가 무리를 보내는 동안에 배 타고 앞서 건너편 벳새다로 가게 하시고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:45"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p19.b2": {
    "text": "무리를 작별하신 후에 기도하러 산으로 가시다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:46"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p19.b3": {
    "text": "저물매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:47"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p19.b4": {
    "text": "배는 바다 가운데 있고 예수는 홀로 뭍에 계시다가",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:47"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p20.b1": {
    "text": "바람이 거스리므로 제자들의 괴로이 노 젓는 것을 보시고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:48"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p20.b2": {
    "text": "밤 사경 즈음에",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:48"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p20.b3": {
    "text": "바다 위로 걸어서 저희에게 오사",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:48"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p20.b4": {
    "text": "지나가려고 하시매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:48"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p21.b1": {
    "text": "제자들이 그의 바다 위로 걸어 오심을 보고 유령인가 하여",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:49"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p21.b2": {
    "text": "소리 지르니 저희가 다 예수를 보고 놀람이라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:49-50"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p21.b3": {
    "text": "안심하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:50"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p21.b4": {
    "text": "내니 두려워 말라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:50"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p22.b1": {
    "text": "바람이 그치는지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:51"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p22.b2": {
    "text": "제자들이 마음에 심히 놀라니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:51"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p22.b3": {
    "text": "이는 저희가 그 떡 떼시던 일을 깨닫지 못하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:52"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p22.b4": {
    "text": "도리어 그 마음이 둔하여 졌음이러라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:52"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p23.b1": {
    "text": "건너가 게네사렛 땅에 이르러 대고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:53"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p23.b2": {
    "text": "배에서 내리니 사람들이 곧 예수신 줄을 알고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:54"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p23.b3": {
    "text": "그 온 지방으로 달려 돌아 다니며 예수께서 어디 계시단 말을 듣는대로",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:55"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p23.b4": {
    "text": "병든 자를 침상채로 메고 나아오니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:55"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p24.b1": {
    "text": "아무데나 예수께서 들어가시는 마을이나 도시나 촌에서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:56"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p24.b2": {
    "text": "병자를 시장에 두고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:56"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p24.b3": {
    "text": "예수의 옷가에라도 손을 대게 하시기를 간구하니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:56"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.6.p24.b4": {
    "text": "손을 대는 자는 다 성함을 얻으니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Mark 6:56"
    },
    "adapted": false,
    "status": "approved"
  }
}
