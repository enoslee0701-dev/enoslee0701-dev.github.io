{
  "genesis.37.p1.b1": {
    "text": "야곱이 가나안 땅 곧 그 아비의 우거하던 땅에 거하였으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p1.b2": {
    "text": "요셉이 십칠세의 소년으로서 그 형제와 함께 양을 칠 때에 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p1.b3": {
    "text": "… 이스라엘이 여러 아들보다 그를 깊이 사랑하여 위하여 채색옷을 지었더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p1.b4": {
    "text": "그 형들이 아비가 형제들보다 그를 사랑함을 보고 그를 미워하여 그에게 언사가 불평하였더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p2.b1": {
    "text": "청컨대 나의 꾼 꿈을 들으시오",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p2.b2": {
    "text": "우리가 밭에서 곡식을 묶더니 내 단은 일어서고 당신들의 단은 내 단을 둘러서서 절하더이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p2.b3": {
    "text": "네가 참으로 우리의 왕이 되겠느냐 참으로 우리를 다스리게 되겠느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p2.b4": {
    "text": "그 꿈과 그 말을 인하여 그를 더욱 미워하더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p3.b1": {
    "text": "내가 또 꿈을 꾼즉 해와 달과 열한 별이 내게 절하더이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p3.b2": {
    "text": "너의 꾼 꿈이 무엇이냐 나와 네 모와 네 형제들이 참으로 가서 땅에 엎드려 네게 절하겠느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p3.b3": {
    "text": "그 형들은 시기하되 그 아비는 그 말을 마음에 두었더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p4.b1": {
    "text": "가서 네 형들과 양떼가 다 잘 있는 여부를 보고 돌아와 내게 고하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p4.b2": {
    "text": "이에 세겜으로 가니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p4.b3": {
    "text": "네가 무엇을 찾느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p4.b4": {
    "text": "내가 나의 형들을 찾으오니 청컨대 그들의 양치는 곳을 내게 가르치소서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p4.b5": {
    "text": "그들이 여기서 떠났느니라 내가 그들의 말을 들으니 도단으로 가자 하더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p5.b1": {
    "text": "요셉이 그들에게 가까이 오기 전에 그들이 요셉을 멀리서 보고 죽이기를 꾀하여",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p5.b2": {
    "text": "꿈 꾸는 자가 오는도다 … 그 꿈이 어떻게 되는 것을 우리가 볼 것이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:19-20"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p5.b3": {
    "text": "피를 흘리지 말라 그를 광야 그 구덩이에 던지고 손을 그에게 대지 말라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p5.b4": {
    "text": "이는 그가 요셉을 그들의 손에서 구원하여 그 아비에게로 돌리려 함이었더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p6.b1": {
    "text": "요셉이 형들에게 이르매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p6.b2": {
    "text": "그 형들이 요셉의 옷 곧 그 입은 채색 옷을 벗기고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p6.b3": {
    "text": "그를 잡아 구덩이에 던지니 그 구덩이는 빈 것이라 그 속에 물이 없었더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p7.b1": {
    "text": "그들이 앉아 음식을 먹다가 눈을 들어 본즉 … 그 약대들에 향품과 유향과 몰약을 싣고 애굽으로 내려가는지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p7.b2": {
    "text": "우리가 우리 동생을 죽이고 그의 피를 은익한들 무엇이 유익할까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p7.b3": {
    "text": "자, 그를 이스마엘 사람에게 팔고 우리 손을 그에게 대지 말자 그는 우리의 동생이요 우리의 골육이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p7.b4": {
    "text": "형제들이 청종하였더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p8.b1": {
    "text": "때에 미디안 사람 상고들이 지나는지라 그들이 요셉을 구덩이에서 끌어 올리고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p8.b2": {
    "text": "은 이십개에 그를 이스마엘 사람들에게 팔매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p8.b3": {
    "text": "그 상고들이 요셉을 데리고 애굽으로 갔더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p9.b1": {
    "text": "르우벤이 돌아와서 구덩이에 이르러 본즉 거기 요셉이 없는지라 옷을 찢고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p9.b2": {
    "text": "아이가 없도다 나는 나는 어디로 갈까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p9.b3": {
    "text": "… 수염소를 죽여 그 옷을 피에 적시고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p9.b4": {
    "text": "우리가 이것을 얻었으니 아버지의 아들의 옷인가 아닌가 보소서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p10.b1": {
    "text": "내 아들의 옷이라 … 요셉이 정녕 찢겼도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p10.b2": {
    "text": "자기 옷을 찢고 굵은 베로 허리를 묶고 오래도록 그 아들을 위하여 애통하니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p10.b3": {
    "text": "내가 슬퍼하며 음부에 내려 아들에게로 가리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.37.p10.b4": {
    "text": "미디안 사람이 애굽에서 바로의 신하 시위대장 보디발에게 요셉을 팔았더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Genesis 37:36"
    },
    "adapted": false,
    "status": "approved"
  }
}
