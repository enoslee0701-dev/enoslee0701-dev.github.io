{
  "ezekiel.31.p1.b1": {
    "text": "人の子よ、エジプトの王パロと、その民衆とに言え、あなたはその大いなること、だれに似ているか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 31:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.31.p1.b2": {
    "text": "見よ、わたしはあなたをレバノンの香柏のようにする。麗しき枝と森の陰があり、たけが高く、その頂は雲の中にある。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 31:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.31.p1.b3": {
    "text": "その枝葉に空のすべての鳥が、巣をつくり、…その陰にもろもろの国民は住む。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 31:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.31.p1.b4": {
    "text": "もろもろの国民の最も恐れている異邦人はこれを切り倒して捨てる。…地のすべての民は、その陰を離れて、これを捨てる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 31:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.31.p1.b5": {
    "text": "その倒れた所に、空のもろもろの鳥は住み",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 31:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.31.p1.b6": {
    "text": "わたしがこれを穴に下る者と共に陰府に落す時、もろもろの国民をその落ちる響きのために、打ち震えさせる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 31:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.31.p1.b7": {
    "text": "これがパロとその民衆であると、主なる神は言われる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 31:18"
    },
    "adapted": false,
    "status": "approved"
  }
}
