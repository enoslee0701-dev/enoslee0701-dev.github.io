{
  "matthew.1.p1.b1": {
    "text": "アブラハムの子であるダビデの子、イエス・キリストの系図。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 1:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p1.b2": {
    "text": "アブラハムはイサクの父であり、イサクはヤコブの父、ヤコブはユダとその兄弟たちとの父、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 1:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p1.b3": {
    "text": "サルモンはラハブによるボアズの父、ボアズはルツによるオベデの父、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 1:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p1.b4": {
    "text": "エッサイはダビデ王の父であった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 1:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p2.b1": {
    "text": "ダビデはウリヤの妻によるソロモンの父であり、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 1:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p2.b2": {
    "text": "ソロモンはレハベアムの父、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 1:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p2.b3": {
    "text": "ヨシヤはバビロンへ移されたころ、エコニヤとその兄弟たちとの父となった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 1:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p3.b1": {
    "text": "バビロンへ移されたのち、エコニヤはサラテルの父となった。サラテルはゾロバベルの父、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 1:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p3.b2": {
    "text": "ヤコブはマリヤの夫ヨセフの父であった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 1:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p3.b3": {
    "text": "このマリヤからキリストといわれるイエスがお生れになった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 1:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p3.b4": {
    "text": "だから、アブラハムからダビデまでの代は合わせて十四代、…バビロンへ移されてからキリストまでは十四代である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 1:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p4.b1": {
    "text": "イエス・キリストの誕生の次第はこうであった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 1:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p4.b2": {
    "text": "母マリヤはヨセフと婚約していたが、まだ一緒にならない前に、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 1:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p4.b3": {
    "text": "聖霊によって身重になった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 1:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p5.b1": {
    "text": "夫ヨセフは正しい人であったので、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 1:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p5.b2": {
    "text": "彼女のことが公けになることを好まず、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 1:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p5.b3": {
    "text": "ひそかに離縁しようと決心した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 1:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p6.b1": {
    "text": "彼がこのことを思いめぐらしていたとき、主の使が夢に現れて言った、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 1:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p6.b2": {
    "text": "ダビデの子ヨセフよ、心配しないで",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 1:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p6.b3": {
    "text": "マリヤを妻として迎えるがよい。その胎内に宿っているものは聖霊によるのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 1:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p6.b4": {
    "text": "彼女は男の子を産むであろう。その名をイエスと名づけなさい。彼は、おのれの民をそのもろもろの罪から救う者となるからである」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 1:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p7.b1": {
    "text": "すべてこれらのことが起ったのは、主が預言者によって言われたことの成就するためである。すなわち、「見よ、おとめがみごもって男の子を産むであろう。その名はインマヌエルと呼ばれるであろう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 1:22-23"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p7.b2": {
    "text": "これは、「神われらと共にいます」という意味である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 1:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p7.b3": {
    "text": "ヨセフは眠りからさめた後に、主の使が命じたとおりに、マリヤを妻に迎えた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 1:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p8.b1": {
    "text": "しかし、子が生れるまでは、彼女を知ることはなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 1:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.1.p8.b2": {
    "text": "そして、その子をイエスと名づけた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 1:25"
    },
    "adapted": false,
    "status": "approved"
  }
}
