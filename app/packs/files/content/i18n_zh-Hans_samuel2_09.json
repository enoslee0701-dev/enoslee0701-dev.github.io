{
  "samuel2.9.p1.b1": {
    "text": "「扫罗家还有剩下的人没有？我要因约拿单的缘故向他施恩。」",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Samuel 9:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "「扫罗家还⁠有剩⁠下的人没⁠有？我要⁠因约拿单的缘⁠故向他施⁠恩。」"
  },
  "samuel2.9.p1.b2": {
    "text": "「仆人是。」",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Samuel 9:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "「仆⁠人是。」"
  },
  "samuel2.9.p1.b3": {
    "text": "「还有约拿单的一个儿子，是瘸腿的。」",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Samuel 9:3"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "「还⁠有约拿单的一⁠个儿⁠子，是瘸⁠腿的。」"
  },
  "samuel2.9.p1.b4": {
    "text": "「他在哪里？」",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Samuel 9:4"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "「他⁠在哪⁠里？」"
  },
  "samuel2.9.p2.b1": {
    "text": "「他在罗·底巴，亚米利的儿子玛吉家里。」",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Samuel 9:4"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "「他⁠在罗·底巴，亚米利的儿⁠子玛吉家⁠里。」"
  },
  "samuel2.9.p2.b2": {
    "text": "于是大卫王打发人去，从罗·底巴、亚米利的儿子玛吉家里召了他来。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Samuel 9:5"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "于⁠是大⁠卫王打⁠发人⁠去，从罗·底巴、亚米利的儿⁠子玛吉家⁠里召了他来。"
  },
  "samuel2.9.p2.b3": {
    "text": "「米非波设！」",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Samuel 9:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel2.9.p2.b4": {
    "text": "「仆人在此。」",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Samuel 9:6"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "「仆⁠人在⁠此。」"
  },
  "samuel2.9.p3.b1": {
    "text": "「你不要惧怕，我必因你父亲约拿单的缘故施恩与你，」",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Samuel 9:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "「你不⁠要惧⁠怕，我必因你父⁠亲约拿单的缘⁠故施⁠恩与你，」"
  },
  "samuel2.9.p3.b2": {
    "text": "「将你祖父扫罗的一切田地都归还你；」",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Samuel 9:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "「将你祖⁠父扫罗的一⁠切田⁠地都归⁠还你；」"
  },
  "samuel2.9.p3.b3": {
    "text": "「你也可以常与我同席吃饭。」",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Samuel 9:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "「你也⁠可⁠以常与我同⁠席吃⁠饭。」"
  },
  "samuel2.9.p3.b4": {
    "text": "「仆人算什么，不过如死狗一般，竟蒙王这样眷顾！」",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Samuel 9:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "「仆⁠人算什⁠么，不⁠过如死狗一⁠般，竟蒙王这⁠样眷⁠顾！」"
  },
  "samuel2.9.p4.b1": {
    "text": "「我已将属扫罗和他的一切家产都赐给你主人的儿子了。」",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Samuel 9:9"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "「我已将属扫罗和他⁠的一⁠切家⁠产都赐⁠给你主⁠人的儿⁠子了。」"
  },
  "samuel2.9.p4.b2": {
    "text": "洗巴有十五个儿子，二十个仆人。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Samuel 9:10"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "洗巴有十⁠五个儿⁠子，二⁠十个仆⁠人。"
  },
  "samuel2.9.p4.b3": {
    "text": "「凡我主我王吩咐仆人的，仆人都必遵行。」",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Samuel 9:11"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "「凡我主我王吩⁠咐仆⁠人的，仆⁠人都必遵⁠行。」"
  },
  "samuel2.9.p4.b4": {
    "text": "「米非波设必与我同席吃饭，如王的儿子一样。」",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Samuel 9:11"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "「米非波设必与我同⁠席吃⁠饭，如王的儿⁠子一⁠样。」"
  },
  "samuel2.9.p5.b1": {
    "text": "于是米非波设住在耶路撒冷，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Samuel 9:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "于⁠是米非波设住⁠在耶⁠路撒⁠冷，"
  },
  "samuel2.9.p5.b2": {
    "text": "常与王同席吃饭。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Samuel 9:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "常与王同⁠席吃⁠饭。"
  },
  "samuel2.9.p5.b3": {
    "text": "他两腿都是瘸的。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "2 Samuel 9:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他两腿都⁠是瘸的。"
  }
}
