{
  "exodus.24.p1.b1": {
    "text": "あなたはアロン、ナダブ、アビウおよびイスラエルの七十人の長老たちと共に、主のもとにのぼってきなさい。そしてあなたがたは遠く離れて礼拝しなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 24:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p1.b2": {
    "text": "ただモーセひとりが主に近づき、他の者は近づいてはならない。また、民も彼と共にのぼってはならない」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 24:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p1.b3": {
    "text": "モーセはきて、主のすべての言葉と、すべてのおきてとを民に告げた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 24:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p1.b4": {
    "text": "わたしたちは主の仰せられた言葉を皆、行います",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 24:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p2.b5": {
    "text": "そしてモーセは主の言葉を、ことごとく書きしるし、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 24:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p2.b6": {
    "text": "朝はやく起きて山のふもとに祭壇を築き、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 24:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p2.b7": {
    "text": "……イスラエルの十二部族に従って十二の柱を建て、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 24:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p2.b8": {
    "text": "イスラエルの人々のうちの若者たちをつかわして、主に燔祭をささげさせ、また酬恩祭として雄牛をささげさせた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 24:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p3.b9": {
    "text": "その時モーセはその血の半ばを取って、鉢に入れ、また、その血の半ばを祭壇に注ぎかけた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 24:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p3.b10": {
    "text": "そして契約の書を取って、これを民に読み聞かせた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 24:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p3.b11": {
    "text": "わたしたちは主が仰せられたことを皆、従順に行います",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 24:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p3.b12": {
    "text": "見よ、これは主がこれらのすべての言葉に基いて、あなたがたと結ばれる契約の血である",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 24:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p4.b13": {
    "text": "こうしてモーセはアロン、ナダブ、アビウおよびイスラエルの七十人の長老たちと共にのぼって行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 24:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p4.b14": {
    "text": "そして、彼らがイスラエルの神を見ると、その足の下にはサファイアの敷石のごとき物があり、澄み渡るおおぞらのようであった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 24:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p4.b15": {
    "text": "神はイスラエルの人々の指導者たちを手にかけられなかったので、彼らは神を見て、飲み食いした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 24:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p5.b16": {
    "text": "山に登り、わたしの所にきて、そこにいなさい。彼らを教えるために、わたしが律法と戒めとを書きしるした石の板をあなたに授けるであろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 24:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p5.b17": {
    "text": "そこでモーセは従者ヨシュアと共に立ちあがり、モーセは神の山に登った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 24:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p5.b18": {
    "text": "わたしたちがあなたがたの所に帰って来るまで、ここで待っていなさい。見よ、アロンとホルとが、あなたがたと共にいるから、……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 24:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p6.b19": {
    "text": "主の栄光は山の頂で、燃える火のようにイスラエルの人々の目に見えたが、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 24:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p6.b20": {
    "text": "雲は六日のあいだ、山をおおっていたが、七日目に主は雲の中からモーセを呼ばれた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 24:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p6.b21": {
    "text": "モーセは雲の中にはいって、山に登った。そしてモーセは四十日四十夜、山にいた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 24:18"
    },
    "adapted": false,
    "status": "approved"
  }
}
