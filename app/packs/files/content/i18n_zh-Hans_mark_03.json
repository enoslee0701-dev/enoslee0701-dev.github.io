{
  "mark.3.p1.b1": {
    "text": "耶稣又进了会堂，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣又⁠进了会⁠堂，"
  },
  "mark.3.p1.b2": {
    "text": "在那里有一个人枯干了一只手。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "在那⁠里有⁠一个⁠人枯⁠干了一⁠只手。"
  },
  "mark.3.p1.b3": {
    "text": "众人窥探耶稣，在安息日医治不医治，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "众⁠人窥⁠探耶⁠稣，在安⁠息⁠日医⁠治不医⁠治，"
  },
  "mark.3.p1.b4": {
    "text": "意思是要控告耶稣。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "意⁠思是要控⁠告耶⁠稣。"
  },
  "mark.3.p2.b1": {
    "text": "耶稣对那枯干一只手的人说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:3"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣对那枯⁠干一⁠只手的人说："
  },
  "mark.3.p2.b2": {
    "text": "起来，站在当中。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:3"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "起⁠来，站⁠在当⁠中。"
  },
  "mark.3.p2.b3": {
    "text": "又问众人说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:4"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "又问众⁠人说："
  },
  "mark.3.p2.b4": {
    "text": "在安息日行善行恶，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:4"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "在安⁠息⁠日行善⁠行恶，"
  },
  "mark.3.p2.b5": {
    "text": "救命害命，哪样是可以的呢？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:4"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "救⁠命害⁠命，哪样是可⁠以的呢？"
  },
  "mark.3.p2.b6": {
    "text": "他们都不作声。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:4"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠们都⁠不作声。"
  },
  "mark.3.p3.b1": {
    "text": "耶稣怒目周围看他们，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:5"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣怒⁠目周⁠围看他⁠们，"
  },
  "mark.3.p3.b2": {
    "text": "忧愁他们的心刚硬，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:5"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "忧⁠愁他⁠们的心刚⁠硬，"
  },
  "mark.3.p3.b3": {
    "text": "就对那人说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.3.p3.b4": {
    "text": "伸出手来！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:5"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "伸⁠出手来！"
  },
  "mark.3.p3.b5": {
    "text": "他把手一伸，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:5"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他把⁠手一⁠伸，"
  },
  "mark.3.p3.b6": {
    "text": "手就复了原。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.3.p4.b1": {
    "text": "法利赛人出去，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:6"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "法⁠利⁠赛人出⁠去，"
  },
  "mark.3.p4.b2": {
    "text": "同希律一党的人商议",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:6"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "同希⁠律一⁠党的人商⁠议"
  },
  "mark.3.p4.b3": {
    "text": "怎样可以除灭耶稣。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:6"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "怎⁠样可⁠以除灭耶⁠稣。"
  },
  "mark.3.p5.b1": {
    "text": "耶稣和门徒退到海边去，有许多人从加利利跟随他。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣和门⁠徒退⁠到海⁠边去，有许⁠多人从加⁠利⁠利跟⁠随他。"
  },
  "mark.3.p5.b2": {
    "text": "还有许多人听见他所做的大事，就从犹太、耶路撒冷、以土买、",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "还⁠有许⁠多人听⁠见他⁠所做⁠的大⁠事，就从犹⁠太、耶⁠路撒⁠冷、以⁠土⁠买、"
  },
  "mark.3.p5.b3": {
    "text": "约旦河外，并泰尔、西顿的四方",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "约⁠旦⁠河外，并泰尔、西⁠顿的四⁠方"
  },
  "mark.3.p5.b4": {
    "text": "来到他那里。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "来⁠到他那⁠里。"
  },
  "mark.3.p6.b1": {
    "text": "他因为人多，就吩咐门徒叫一只小船伺候着，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:9"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他因⁠为人多，就吩⁠咐门⁠徒叫一⁠只小⁠船伺⁠候着，"
  },
  "mark.3.p6.b2": {
    "text": "他治好了许多人，所以凡有灾病的，都挤进来要摸他。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:10"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他治⁠好了许⁠多人，所⁠以凡⁠有灾病⁠的，都挤⁠进⁠来要摸他。"
  },
  "mark.3.p7.b1": {
    "text": "污鬼无论何时看见他，就俯伏在他面前，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:11"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "污⁠鬼无⁠论何⁠时看⁠见他，就俯⁠伏在他面⁠前，"
  },
  "mark.3.p7.b2": {
    "text": "喊着说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.3.p7.b3": {
    "text": "你是神的儿子。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:11"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠是神的儿⁠子。"
  },
  "mark.3.p7.b4": {
    "text": "耶稣再三地嘱咐他们，不要把他显露出来。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:12"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣再⁠三地嘱⁠咐他⁠们，不⁠要把他显⁠露出⁠来。"
  },
  "mark.3.p8.b1": {
    "text": "耶稣上了山，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣上⁠了山，"
  },
  "mark.3.p8.b2": {
    "text": "随自己的意思叫人来；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "随自⁠己的意⁠思叫人来；"
  },
  "mark.3.p8.b3": {
    "text": "他们便来到他那里。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠们便来⁠到他那⁠里。"
  },
  "mark.3.p9.b1": {
    "text": "他就设立十二个人，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:14"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他就设⁠立十⁠二个⁠人，"
  },
  "mark.3.p9.b2": {
    "text": "要他们常和自己同在，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:14"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "要他⁠们常和自⁠己同在，"
  },
  "mark.3.p9.b3": {
    "text": "也要差他们去传道，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:14"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "也⁠要差他⁠们去传⁠道，"
  },
  "mark.3.p9.b4": {
    "text": "并给他们权柄赶鬼。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:15"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "并给他⁠们权⁠柄赶鬼。"
  },
  "mark.3.p10.b1": {
    "text": "这十二个人有西门（耶稣又给他起名叫彼得），",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:16"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "这十⁠二个⁠人有西⁠门（耶⁠稣又给他起名⁠叫彼⁠得），"
  },
  "mark.3.p10.b2": {
    "text": "还有西庇太的儿子雅各和雅各的兄弟约翰",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:17"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "还⁠有西⁠庇⁠太的儿⁠子雅⁠各和雅⁠各的兄⁠弟约⁠翰"
  },
  "mark.3.p10.b3": {
    "text": "（又给这两个人起名叫半尼其，就是雷子的意思），",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:17"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "（又给这两个⁠人起名⁠叫半尼其，就⁠是雷子的意⁠思），"
  },
  "mark.3.p11.b1": {
    "text": "又有安得烈、",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:18"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "又⁠有安⁠得⁠烈、"
  },
  "mark.3.p11.b2": {
    "text": "腓力、巴多罗买、",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:18"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "腓⁠力、巴⁠多罗⁠买、"
  },
  "mark.3.p11.b3": {
    "text": "马太、",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:18"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "马⁠太、"
  },
  "mark.3.p11.b4": {
    "text": "多马、亚勒腓的儿子雅各，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:18"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "多⁠马、亚⁠勒⁠腓的儿⁠子雅⁠各，"
  },
  "mark.3.p11.b5": {
    "text": "和达太，并奋锐党的西门，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:18"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "和达⁠太，并奋⁠锐党的西⁠门，"
  },
  "mark.3.p11.b6": {
    "text": "还有卖耶稣的加略人犹大。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:19"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "还⁠有卖耶⁠稣的加⁠略人犹⁠大。"
  },
  "mark.3.p12.b1": {
    "text": "耶稣进了一个屋子，众人又聚集，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:20"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣进了一⁠个屋⁠子，众⁠人又聚⁠集，"
  },
  "mark.3.p12.b2": {
    "text": "甚至他连饭也顾不得吃。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:20"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "甚⁠至他连饭也顾⁠不⁠得吃。"
  },
  "mark.3.p12.b3": {
    "text": "耶稣的亲属听见，就出来要拉住他，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:21"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣的亲⁠属听⁠见，就出⁠来要拉⁠住他，"
  },
  "mark.3.p12.b4": {
    "text": "因为他们说他癫狂了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:21"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "因⁠为他⁠们说他癫狂了。"
  },
  "mark.3.p13.b1": {
    "text": "从耶路撒冷下来的文士说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:22"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "从耶⁠路撒⁠冷下⁠来的文⁠士说："
  },
  "mark.3.p13.b2": {
    "text": "他是被别西卜附着",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:22"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠是被别⁠西⁠卜附⁠着"
  },
  "mark.3.p13.b3": {
    "text": "又说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.3.p13.b4": {
    "text": "他是靠着鬼王赶鬼。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:22"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠是靠着鬼⁠王赶鬼。"
  },
  "mark.3.p14.b1": {
    "text": "耶稣叫他们来，用比喻对他们说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:23"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣叫他⁠们来，用比⁠喻对他⁠们说："
  },
  "mark.3.p14.b2": {
    "text": "撒但怎能赶出撒但呢？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:23"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "撒⁠但怎⁠能赶⁠出撒⁠但呢？"
  },
  "mark.3.p14.b3": {
    "text": "若一国自相纷争，那国就站立不住；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:24"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "若一⁠国自相纷⁠争，那国就站⁠立不⁠住；"
  },
  "mark.3.p14.b4": {
    "text": "若一家自相纷争，那家就站立不住。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:25"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "若一⁠家自相纷⁠争，那家就站⁠立不⁠住。"
  },
  "mark.3.p15.b1": {
    "text": "若撒但自相攻打纷争，他就站立不住，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:26"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "若撒⁠但自相攻⁠打纷⁠争，他就站⁠立不⁠住，"
  },
  "mark.3.p15.b2": {
    "text": "必要灭亡。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:26"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "必⁠要灭⁠亡。"
  },
  "mark.3.p15.b3": {
    "text": "没有人能进壮士家里，抢夺他的家具；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:27"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "没⁠有人能⁠进壮⁠士家⁠里，抢⁠夺他⁠的家⁠具；"
  },
  "mark.3.p15.b4": {
    "text": "必先捆住那壮士，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:27"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "必⁠先捆⁠住那壮⁠士，"
  },
  "mark.3.p15.b5": {
    "text": "才可以抢夺他的家。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:27"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "才⁠可⁠以抢⁠夺他⁠的家。"
  },
  "mark.3.p16.b1": {
    "text": "我实在告诉你们，世人一切的罪和一切亵渎的话都可得赦免；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:28"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我实⁠在告⁠诉你⁠们，世⁠人一⁠切的罪和一⁠切亵⁠渎的⁠话都可⁠得赦⁠免；"
  },
  "mark.3.p16.b2": {
    "text": "凡亵渎圣灵的，却永不得赦免，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:29"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "凡亵⁠渎圣⁠灵的，却永不⁠得赦⁠免，"
  },
  "mark.3.p16.b3": {
    "text": "乃要担当永远的罪。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:29"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "乃要担⁠当永⁠远的罪。"
  },
  "mark.3.p16.b4": {
    "text": "这话是因为他们说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:30"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "这话是因⁠为他⁠们说："
  },
  "mark.3.p16.b5": {
    "text": "他是被污鬼附着的。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:30"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠是被污⁠鬼附⁠着的。"
  },
  "mark.3.p17.b1": {
    "text": "当下，耶稣的母亲和弟兄来，站在外边，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:31"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "当⁠下，耶⁠稣的母⁠亲和弟⁠兄来，站⁠在外⁠边，"
  },
  "mark.3.p17.b2": {
    "text": "打发人去叫他。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:31"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "打⁠发人⁠去叫他。"
  },
  "mark.3.p17.b3": {
    "text": "有许多人在耶稣周围坐着，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:32"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有许⁠多人在耶⁠稣周围⁠坐⁠着，"
  },
  "mark.3.p17.b4": {
    "text": "他们就告诉他说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:32"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠们就告⁠诉他说："
  },
  "mark.3.p17.b5": {
    "text": "看哪，你母亲和你弟兄在外边找你。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:32"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "看哪，你母⁠亲和你弟⁠兄在外⁠边找你。"
  },
  "mark.3.p18.b1": {
    "text": "耶稣回答说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:33"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣回⁠答⁠说："
  },
  "mark.3.p18.b2": {
    "text": "谁是我的母亲？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:33"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "谁⁠是我⁠的母⁠亲？"
  },
  "mark.3.p18.b3": {
    "text": "谁是我的弟兄？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:33"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "谁⁠是我⁠的弟⁠兄？"
  },
  "mark.3.p18.b4": {
    "text": "就四面观看那周围坐着的人，说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:34"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "就四⁠面观⁠看那周围⁠坐⁠着的人，说："
  },
  "mark.3.p18.b5": {
    "text": "看哪，我的母亲，我的弟兄。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:34"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "看哪，我⁠的母⁠亲，我⁠的弟⁠兄。"
  },
  "mark.3.p18.b6": {
    "text": "凡遵行神旨意的人",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:35"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "凡遵⁠行神旨⁠意的人"
  },
  "mark.3.p18.b7": {
    "text": "就是我的弟兄姊妹和母亲了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 3:35"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "就⁠是我⁠的弟⁠兄姊⁠妹和母⁠亲了。"
  }
}
