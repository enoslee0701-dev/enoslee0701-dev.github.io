{
  "micah.5.p1.b1": {
    "text": "今あなたは壁でとりまかれている。敵はわれわれを攻め囲み、つえをもってイスラエルのつかさのほおを撃つ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 5:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.5.p1.b2": {
    "text": "しかしベツレヘム・エフラタよ、あなたはユダの氏族のうちで小さい者だが、イスラエルを治める者があなたのうちからわたしのために出る。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 5:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.5.p1.b3": {
    "text": "その出るのは昔から、いにしえの日からである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 5:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.5.p1.b4": {
    "text": "彼は主の力により、その神、主の名の威光により、立ってその群れを養い",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 5:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.5.p1.b5": {
    "text": "これは平和である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 5:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.5.p2.b1": {
    "text": "その時ヤコブの残れる者は多くの民の中にあること……主からくだる露のごとく、青草の上に降る夕立ちのようである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 5:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.5.p2.b2": {
    "text": "またヤコブの残れる者が国々の中におり、多くの民の中にいること……羊の群れの中の若いししのようである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 5:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.5.p2.b3": {
    "text": "主は言われる、その日には、わたしはあなたのうちから馬を絶やし、戦車をこわし、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 5:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.5.p2.b4": {
    "text": "またあなたのうちから彫像および石の柱を絶やす。あなたは重ねて手で作った物を拝むことはない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 5:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.5.p2.b5": {
    "text": "そしてわたしは怒りと憤りとをもってその聞き従わないもろもろの国民に復讐する。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 5:15"
    },
    "adapted": false,
    "status": "approved"
  }
}
