{
  "matthew.13.p1.b1": {
    "text": "그 날에 예수께서 집에서 나가사",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p1.b2": {
    "text": "바닷가에 앉으시매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p1.b3": {
    "text": "큰 무리가 그에게로 모여 들거늘",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p1.b4": {
    "text": "예수께서 배에 올라가 앉으시고 온 무리는 해변에 섰더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p2.b1": {
    "text": "예수께서 비유로 여러가지를 저희에게 말씀하여 가라사대",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p2.b2": {
    "text": "씨를 뿌리는 자가 뿌리러 나가서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p2.b3": {
    "text": "뿌릴쌔 더러는 길 가에 떨어지매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p2.b4": {
    "text": "새들이 와서 먹어 버렸고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p3.b1": {
    "text": "더러는 흙이 얇은 돌밭에 떨어지매 흙이 깊지 아니하므로 곧 싹이 나오나",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p3.b2": {
    "text": "해가 돋은 후에 타져서 뿌리가 없으므로 말랐고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p3.b3": {
    "text": "더러는 가시떨기 위에 떨어지매 가시가 자라서 기운을 막았고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p4.b1": {
    "text": "더러는 좋은 땅에 떨어지매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p4.b2": {
    "text": "혹 백배",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p4.b3": {
    "text": "혹 육십배, 혹 삼십배의 결실을 하였느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p4.b4": {
    "text": "귀 있는 자는 들으라 하시니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p5.b1": {
    "text": "어찌하여 저희에게 비유로 말씀하시나이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p5.b2": {
    "text": "천국의 비밀을 아는 것이 너희에게는 허락되었으나 저희에게는 아니 되었나니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p5.b3": {
    "text": "무릇 있는 자는 받아 넉넉하게 되되 무릇 없는 자는 그 있는 것도 빼앗기리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p5.b4": {
    "text": "그러므로 내가 저희에게 비유로 말하기는 저희가 보아도 보지 못하며 들어도 듣지 못하며 깨닫지 못함이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p6.b1": {
    "text": "이사야의 예언이 저희에게 이루었으니 일렀으되 너희가 듣기는 들어도 깨닫지 못할 것이요 보기는 보아도 알지 못하리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p6.b2": {
    "text": "이 백성들의 마음이 완악하여져서 그 귀는 듣기에 둔하고 눈은 감았으니…",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p6.b3": {
    "text": "그러나 너희 눈은 봄으로 너희 귀는 들음으로 복이 있도다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p6.b4": {
    "text": "…많은 선지자와 의인이 너희 보는 것들을 보고자 하여도 보지 못하였고…",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p7.b1": {
    "text": "그런즉 씨 뿌리는 비유를 들으라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p7.b2": {
    "text": "아무나 천국 말씀을 듣고 깨닫지 못할 때는 악한 자가 와서 그 마음에 뿌리운 것을 빼앗나니…",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p7.b3": {
    "text": "돌밭에 뿌리웠다는 것은 말씀을 듣고 즉시 기쁨으로 받되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p7.b4": {
    "text": "…말씀을 인하여 환난이나 핍박이 일어나는 때에는 곧 넘어지는 자요",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p8.b1": {
    "text": "가시떨기에 뿌리웠다는 것은 말씀을 들으나 세상의 염려와 재리의 유혹에 말씀이 막혀 결실치 못하는 자요",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p8.b2": {
    "text": "좋은 땅에 뿌리웠다는 것은 말씀을 듣고 깨닫는 자니 결실하여",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p8.b3": {
    "text": "혹 백배, 혹 육십배, 혹 삼십배가 되느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p9.b1": {
    "text": "천국은 좋은 씨를 제 밭에 뿌린 사람과 같으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p9.b2": {
    "text": "사람들이 잘 때에 그 원수가 와서 곡식 가운데 가라지를 덧뿌리고 갔더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p9.b3": {
    "text": "싹이 나고 결실할 때에 가라지도 보이거늘",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p9.b4": {
    "text": "주여 밭에 좋은 씨를 심지 아니하였나이까 그러면 가라지가 어디서 생겼나이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p10.b1": {
    "text": "…원수가 이렇게 하였구나 종들이 말하되 그러면 우리가 가서 이것을 뽑기를 원하시나이까",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p10.b2": {
    "text": "가만 두어라 가라지를 뽑다가 곡식까지 뽑을까 염려하노라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p10.b3": {
    "text": "둘 다 추수 때까지 함께 자라게 두어라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p10.b4": {
    "text": "…가라지는 먼저 거두어 불사르게 단으로 묶고 곡식은 모아 내 곳간에 넣으라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p11.b1": {
    "text": "천국은 마치 사람이 자기 밭에 갖다 심은 겨자씨 한 알 같으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p11.b2": {
    "text": "…자란 후에는 나물보다 커서 나무가 되매 공중의 새들이 와서 그 가지에 깃들이느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p11.b3": {
    "text": "천국은 마치 여자가 가루 서말 속에 갖다 넣어",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p11.b4": {
    "text": "전부 부풀게 한 누룩과 같으니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p12.b1": {
    "text": "예수께서 이 모든 것을 무리에게 비유로 말씀하시고 비유가 아니면 아무 것도 말씀하지 아니하셨으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p12.b2": {
    "text": "이는 선지자로 말씀하신바 내가 입을 열어 비유로 말하고 창세부터 감추인 것들을 드러내리라 함을 이루려 하심이니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p13.b1": {
    "text": "이에 예수께서 무리를 떠나사 집에 들어가시니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:36"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p13.b2": {
    "text": "밭의 가라지의 비유를 우리에게 설명하여 주소서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:36"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p13.b3": {
    "text": "좋은 씨를 뿌리는 이는 인자요 밭은 세상이요",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:37-38"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p13.b4": {
    "text": "…추수때는 세상 끝이요 추숫군은 천사들이니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p14.b1": {
    "text": "그런즉 가라지를 거두어 불에 사르는 것같이 세상끝에도 그러하리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p14.b2": {
    "text": "풀무불에 던져 넣으리니 거기서 울며 이를 갊이 있으리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:42"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p14.b3": {
    "text": "그 때에 의인들은 자기 아버지 나라에서 해와 같이 빛나리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:43"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p14.b4": {
    "text": "귀 있는 자는 들으라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:43"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p15.b1": {
    "text": "천국은 마치 밭에 감추인 보화와 같으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:44"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p15.b2": {
    "text": "사람이 이를 발견한 후 숨겨 두고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:44"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p15.b3": {
    "text": "기뻐하여 돌아가서 자기의 소유를 다 팔아 그 밭을 샀느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:44"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p16.b1": {
    "text": "또 천국은 마치 좋은 진주를 구하는 장사와 같으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:45"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p16.b2": {
    "text": "극히 값진 진주 하나를 만나매",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:46"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p16.b3": {
    "text": "가서 자기의 소유를 다 팔아",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:46"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p16.b4": {
    "text": "그 진주를 샀느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:46"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p17.b1": {
    "text": "또 천국은 마치 바다에 치고 각종 물고기를 모는 그물과 같으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:47"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p17.b2": {
    "text": "그물에 가득하매 물 가로 끌어 내고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:48"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p17.b3": {
    "text": "앉아서 좋은 것은 그릇에 담고 못된 것은 내어 버리느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:48"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p17.b4": {
    "text": "세상 끝에도 이러하리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:49"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p18.b1": {
    "text": "이 모든 것을 깨달았느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:51"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p18.b2": {
    "text": "그러하오이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:51"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p18.b3": {
    "text": "그러므로 천국의 제자된 서기관마다 마치 새것과 옛것을 그 곳간에서 내어오는 집 주인과 같으니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:52"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p19.b1": {
    "text": "예수께서 이 모든 비유를 마치신 후에 거기를 떠나서 고향으로 돌아가사",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:53-54"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p19.b2": {
    "text": "이 사람의 이 지혜와 이런 능력이 어디서 났느뇨",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:54"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p19.b3": {
    "text": "이는 그 목수의 아들이 아니냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:55"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p19.b4": {
    "text": "그 누이들은 다 우리와 함께 있지 아니하냐 그런즉 이 사람의 이 모든 것이 어디서 났느뇨 하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:56"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p20.b1": {
    "text": "예수를 배척한지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:57"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p20.b2": {
    "text": "선지자가 자기 고향과 자기 집 외에서는 존경을 받지 않음이 없느니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:57"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.13.p20.b3": {
    "text": "저희의 믿지 않음을 인하여 거기서 많은 능력을 행치 아니하시니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Matthew 13:58"
    },
    "adapted": false,
    "status": "approved"
  }
}
