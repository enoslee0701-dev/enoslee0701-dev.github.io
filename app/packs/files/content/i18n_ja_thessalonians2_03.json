{
  "thessalonians2.3.p1.b1": {
    "text": "最後に、兄弟たちよ。わたしたちのために祈ってほしい。どうか主の言葉が、あなたがたの所と同じように、ここでも早く広まり…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Thessalonians 3:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "thessalonians2.3.p1.b2": {
    "text": "また、どうか、わたしたちが不都合な悪人から救われるように。事実、すべての人が信仰を持っているわけではない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Thessalonians 3:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "thessalonians2.3.p1.b3": {
    "text": "しかし、主は真実なかたであるから、あなたがたを強め、悪しき者から守って下さるであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Thessalonians 3:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "thessalonians2.3.p1.b4": {
    "text": "どうか、主があなたがたの心を導いて、神の愛とキリストの忍耐とを持たせて下さるように。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Thessalonians 3:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "thessalonians2.3.p2.b1": {
    "text": "兄弟たちよ。主イエス・キリストの名によってあなたがたに命じる。怠惰な生活をして、…すべての兄弟たちから、遠ざかりなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Thessalonians 3:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "thessalonians2.3.p2.b2": {
    "text": "…あなたがたのだれにも負担をかけまいと、日夜、労苦し努力して働き続けた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Thessalonians 3:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "thessalonians2.3.p2.b3": {
    "text": "…ただわたしたちにあなたがたが見習うように、身をもって模範を示したのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Thessalonians 3:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "thessalonians2.3.p2.b4": {
    "text": "…「働こうとしない者は、食べることもしてはならない」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Thessalonians 3:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "thessalonians2.3.p3.b1": {
    "text": "ところが、聞くところによると、あなたがたのうちのある者は怠惰な生活を送り、働かないで、ただいたずらに動きまわっているとのことである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Thessalonians 3:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "thessalonians2.3.p3.b2": {
    "text": "…そのような人には注意をして、交際しないがよい。彼が自ら恥じるようになるためである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Thessalonians 3:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "thessalonians2.3.p3.b3": {
    "text": "しかし、彼を敵のように思わないで、兄弟として訓戒しなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Thessalonians 3:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "thessalonians2.3.p3.b4": {
    "text": "兄弟たちよ。あなたがたは、たゆまずに良い働きをしなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Thessalonians 3:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "thessalonians2.3.p4.b1": {
    "text": "どうか、平和の主ご自身が、いついかなる場合にも、あなたがたに平和を与えて下さるように。主があなたがた一同と共におられるように。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Thessalonians 3:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "thessalonians2.3.p4.b2": {
    "text": "ここでパウロ自身が、手ずからあいさつを書く。これは、わたしのどの手紙にも書く印である。わたしは、このように書く。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Thessalonians 3:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "thessalonians2.3.p4.b3": {
    "text": "どうか、わたしたちの主イエス・キリストの恵みが、あなたがた一同と共にあるように。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "2 Thessalonians 3:18"
    },
    "adapted": false,
    "status": "approved"
  }
}
