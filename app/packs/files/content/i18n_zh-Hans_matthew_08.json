{
  "matthew.8.p1.b1": {
    "text": "耶稣下了山，有许多人跟着他。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣下⁠了山，有许⁠多人跟⁠着他。"
  },
  "matthew.8.p1.b2": {
    "text": "有一个长大麻风的来拜他，说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有一⁠个长大⁠麻⁠风的来拜他，说："
  },
  "matthew.8.p1.b3": {
    "text": "主若肯，必能叫我洁净了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "主若肯，必能叫我洁⁠净了。"
  },
  "matthew.8.p2.b1": {
    "text": "耶稣伸手摸他，说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:3"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣伸⁠手摸他，说："
  },
  "matthew.8.p2.b2": {
    "text": "我肯，你洁净了吧！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:3"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我肯，你洁⁠净了吧！"
  },
  "matthew.8.p2.b3": {
    "text": "他的大麻风立刻就洁净了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:3"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠的大⁠麻⁠风立⁠刻就洁⁠净了。"
  },
  "matthew.8.p2.b4": {
    "text": "你切不可告诉人，只要去把身体给祭司察看，献上摩西所吩咐的礼物，对众人作证据。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:4"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你切不⁠可告⁠诉人，只⁠要去把身⁠体给祭⁠司察⁠看，献⁠上摩⁠西所吩⁠咐的礼⁠物，对众⁠人作证⁠据。"
  },
  "matthew.8.p3.b1": {
    "text": "耶稣进了迦百农，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:5"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣进了迦⁠百⁠农，"
  },
  "matthew.8.p3.b2": {
    "text": "有一个百夫长进前来，求他说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:5"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有一⁠个百⁠夫⁠长进前来，求他说："
  },
  "matthew.8.p3.b3": {
    "text": "主啊，我的仆人害瘫痪病，躺在家里，甚是疼苦。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:6"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "主啊，我⁠的仆⁠人害瘫⁠痪病，躺⁠在家⁠里，甚⁠是疼苦。"
  },
  "matthew.8.p3.b4": {
    "text": "我去医治他。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我⁠去医⁠治他。"
  },
  "matthew.8.p4.b1": {
    "text": "主啊，你到我舍下，我不敢当；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "主啊，你到我舍⁠下，我不⁠敢当；"
  },
  "matthew.8.p4.b2": {
    "text": "只要你说一句话，我的仆人就必好了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "只⁠要你说一⁠句话，我⁠的仆⁠人就必好⁠了。"
  },
  "matthew.8.p4.b3": {
    "text": "因为我在人的权下，也有兵在我以下；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:9"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "因⁠为我⁠在人⁠的权下，也⁠有兵在我以⁠下；"
  },
  "matthew.8.p4.b4": {
    "text": "对这个说『去！』他就去；对那个说『来！』他就来；对我的仆人说：『你做这事！』他就去做。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:9"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "对这⁠个说『去！』他就⁠去；对那⁠个说『来！』他就来；对我⁠的仆⁠人说：『你做这事！』他就⁠去做。"
  },
  "matthew.8.p5.b1": {
    "text": "耶稣听见就希奇，对跟从的人说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:10"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣听⁠见就希⁠奇，对跟从的人说："
  },
  "matthew.8.p5.b2": {
    "text": "我实在告诉你们，这么大的信心，就是在以色列中，我也没有遇见过。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:10"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我实⁠在告⁠诉你⁠们，这⁠么大的信⁠心，就⁠是在以⁠色⁠列中，我也⁠没⁠有遇⁠见过。"
  },
  "matthew.8.p5.b3": {
    "text": "我又告诉你们，从东从西，将有许多人来，在天国里与亚伯拉罕、以撒、雅各一同坐席；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:11"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我⁠又告⁠诉你⁠们，从东从西，将有许⁠多人来，在天⁠国里与亚⁠伯拉⁠罕、以⁠撒、雅⁠各一⁠同坐⁠席；"
  },
  "matthew.8.p5.b4": {
    "text": "惟有本国的子民竟被赶到外边黑暗里去，在那里必要哀哭切齿了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:12"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "惟⁠有本⁠国的子⁠民竟⁠被赶到外⁠边黑⁠暗里去，在那⁠里必⁠要哀哭切⁠齿了。"
  },
  "matthew.8.p6.b1": {
    "text": "耶稣对百夫长说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣对百⁠夫⁠长说："
  },
  "matthew.8.p6.b2": {
    "text": "你回去吧！照你的信心，给你成全了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你回⁠去吧！照你⁠的信⁠心，给你成⁠全了。"
  },
  "matthew.8.p6.b3": {
    "text": "那时，他的仆人就好了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "那⁠时，他⁠的仆⁠人就⁠好了。"
  },
  "matthew.8.p7.b1": {
    "text": "耶稣到了彼得家里，见彼得的岳母害热病躺着。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:14"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣到⁠了彼⁠得家⁠里，见彼⁠得的岳⁠母害热⁠病躺着。"
  },
  "matthew.8.p7.b2": {
    "text": "耶稣把她的手一摸，热就退了；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:15"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣把她⁠的手一⁠摸，热就退了；"
  },
  "matthew.8.p7.b3": {
    "text": "她就起来服事耶稣。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:15"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "她就起⁠来服事耶⁠稣。"
  },
  "matthew.8.p8.b1": {
    "text": "到了晚上，有人带着许多被鬼附的来到耶稣跟前，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:16"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "到⁠了晚⁠上，有⁠人带着许⁠多被鬼附的来⁠到耶⁠稣跟⁠前，"
  },
  "matthew.8.p8.b2": {
    "text": "他只用一句话就把鬼都赶出去，并且治好了一切有病的人。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:16"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他只⁠用一⁠句话就⁠把鬼都赶⁠出⁠去，并⁠且治⁠好了一⁠切有⁠病的人。"
  },
  "matthew.8.p8.b3": {
    "text": "这是要应验先知以赛亚的话，说：他代替我们的软弱，担当我们的疾病。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:17"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "这是要应验先⁠知以⁠赛⁠亚的⁠话，说：他代⁠替我⁠们的软⁠弱，担⁠当我⁠们的疾⁠病。"
  },
  "matthew.8.p9.b1": {
    "text": "夫子，你无论往哪里去，我要跟从你。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:19"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "夫⁠子，你无⁠论往哪⁠里去，我⁠要跟从你。"
  },
  "matthew.8.p9.b2": {
    "text": "狐狸有洞，天空的飞鸟有窝，人子却没有枕头的地方。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:20"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "狐⁠狸有⁠洞，天⁠空的飞⁠鸟有窝，人⁠子却⁠没⁠有枕⁠头的地⁠方。"
  },
  "matthew.8.p9.b3": {
    "text": "主啊，容我先回去埋葬我的父亲。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:21"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "主啊，容我先⁠回⁠去埋⁠葬我⁠的父⁠亲。"
  },
  "matthew.8.p9.b4": {
    "text": "任凭死人埋葬他们的死人；你跟从我吧！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:22"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "任⁠凭死⁠人埋⁠葬他⁠们的死⁠人；你跟从我吧！"
  },
  "matthew.8.p10.b1": {
    "text": "耶稣上了船，门徒跟着他。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:23"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣上⁠了船，门⁠徒跟⁠着他。"
  },
  "matthew.8.p10.b2": {
    "text": "海里忽然起了暴风，甚至船被波浪掩盖；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:24"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "海⁠里忽⁠然起⁠了暴⁠风，甚⁠至船被波⁠浪掩⁠盖；"
  },
  "matthew.8.p10.b3": {
    "text": "耶稣却睡着了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:24"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣却睡⁠着⁠了。"
  },
  "matthew.8.p10.b4": {
    "text": "主啊，救我们，我们丧命啦！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:25"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "主啊，救我⁠们，我⁠们丧命啦！"
  },
  "matthew.8.p11.b1": {
    "text": "你们这小信的人哪，为什么胆怯呢？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:26"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们这小信的人哪，为⁠什⁠么胆⁠怯呢？"
  },
  "matthew.8.p11.b2": {
    "text": "于是起来，斥责风和海，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:26"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "于⁠是起⁠来，斥⁠责风和海，"
  },
  "matthew.8.p11.b3": {
    "text": "风和海就大大地平静了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:26"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "风和海就大大⁠地平⁠静了。"
  },
  "matthew.8.p11.b4": {
    "text": "这是怎样的人？连风和海也听从他了！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:27"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "这是怎⁠样的人？连风和海也听⁠从他了！"
  },
  "matthew.8.p12.b1": {
    "text": "耶稣既渡到那边去，来到加大拉人的地方，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:28"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣既渡到那⁠边去，来⁠到加⁠大拉人⁠的地⁠方，"
  },
  "matthew.8.p12.b2": {
    "text": "就有两个被鬼附的人从坟茔里出来迎着他，极其凶猛，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:28"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "就⁠有两个被鬼附的人从坟⁠茔里出⁠来迎着他，极⁠其凶⁠猛，"
  },
  "matthew.8.p12.b3": {
    "text": "甚至没有人能从那条路上经过。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:28"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "甚⁠至没⁠有人能从那条路⁠上经⁠过。"
  },
  "matthew.8.p12.b4": {
    "text": "神的儿子，我们与你有什么相干？时候还没有到，你就上这里来叫我们受苦吗？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:29"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "神的儿⁠子，我⁠们与你⁠有什⁠么相⁠干？时⁠候还没⁠有到，你就上这⁠里来叫我⁠们受⁠苦吗？"
  },
  "matthew.8.p13.b1": {
    "text": "离他们很远，有一大群猪吃食。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:30"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "离他⁠们很远，有⁠一大⁠群猪吃⁠食。"
  },
  "matthew.8.p13.b2": {
    "text": "若把我们赶出去，就打发我们进入猪群吧！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:31"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "若把我⁠们赶⁠出⁠去，就打⁠发我⁠们进⁠入猪群吧！"
  },
  "matthew.8.p13.b3": {
    "text": "去吧！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.8.p13.b4": {
    "text": "鬼就出来，进入猪群。全群忽然闯下山崖，投在海里淹死了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:32"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "鬼就出⁠来，进⁠入猪群。全群忽⁠然闯⁠下山⁠崖，投在海⁠里淹⁠死了。"
  },
  "matthew.8.p14.b1": {
    "text": "放猪的就逃跑进城，将这一切事和被鬼附的人所遭遇的都告诉人。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:33"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "放猪的就逃⁠跑进城，将这一⁠切事和被鬼附的人所遭⁠遇的都告⁠诉人。"
  },
  "matthew.8.p14.b2": {
    "text": "合城的人都出来迎见耶稣，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:34"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "合城的人都出⁠来迎见耶⁠稣，"
  },
  "matthew.8.p14.b3": {
    "text": "既见了就央求他离开他们的境界。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 8:34"
    },
    "adapted": false,
    "status": "approved",
