{
  "acts.5.p1.b1": {
    "text": "아나니아라 하는 사람이 그 아내 삽비라로 더불어 소유를 팔아",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p1.b2": {
    "text": "그 값에서 얼마를 감추매 그 아내도 알더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p1.b3": {
    "text": "얼마를 가져다가 사도들의 발 앞에 두니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p2.b1": {
    "text": "아나니아야",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p2.b2": {
    "text": "어찌하여 사단이 네 마음에 가득하여 네가 성령을 속이고 땅 값 얼마를 감추었느냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p2.b3": {
    "text": "땅이 그대로 있을 때에는 네 땅이 아니며 판 후에도 네 임의로 할 수가 없더냐",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p2.b4": {
    "text": "… 사람에게 거짓말 한것이 아니요 하나님께로다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p3.b1": {
    "text": "아나니아가 이 말을 듣고 엎드러져 혼이 떠나니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p3.b2": {
    "text": "이 일을 듣는 사람이 다 크게 두려워하더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p3.b3": {
    "text": "젊은 사람들이 일어나 시신을 싸서 메고 나가 장사하니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p4.b1": {
    "text": "세 시간쯤 지나 그 아내가 그 생긴 일을 알지 못하고 들어 오니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p4.b2": {
    "text": "그 땅 판 값이 이것 뿐이냐 내게 말하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p4.b3": {
    "text": "예 이뿐이로라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p4.b4": {
    "text": "… 보라 네 남편을 장사하고 오는 사람들의 발이 문앞에 이르렀으니 또 너를 메어 내가리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p5.b1": {
    "text": "곧 베드로의 발 앞에 엎드러져 혼이 떠나는지라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p5.b2": {
    "text": "젊은 사람들이 들어와 죽은 것을 보고 메어다가",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p5.b3": {
    "text": "… 그 남편곁에 장사하니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p5.b4": {
    "text": "온 교회와 이 일을 듣는 사람들이 다 크게 두려워하니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p6.b1": {
    "text": "사도들의 손으로 민간에 표적과 기사가 많이 되매 믿는 사람이 다 마음을 같이하여 솔로몬 행각에 모이고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p6.b2": {
    "text": "그 나머지는 감히 그들과 상종하는 사람이 없으나 백성이 칭송하더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p6.b3": {
    "text": "믿고 주께로 나오는 자가 더 많으니 남녀의 큰 무리더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p7.b1": {
    "text": "심지어 병든 사람을 메고 거리에 나가 침대와 요 위에 뉘우고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p7.b2": {
    "text": "베드로가 지날 때에 혹 그 그림자라도 뉘게 덮일까 바라고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p7.b3": {
    "text": "예루살렘 근읍 허다한 사람들도 모여 병든 사람과 더러운 귀신에게 괴로움 받는 사람을 데리고 와서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p7.b4": {
    "text": "다 나음을 얻으니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p8.b1": {
    "text": "대제사장과 그와 함께 있는 사람 즉 사두개인의 당파가 다 마음에 시기가 가득하여 일어나서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p8.b2": {
    "text": "사도들을 잡아다가 옥에 가두었더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p8.b3": {
    "text": "주의 사자가 밤에 옥문을 열고 끌어내어 가로되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p8.b4": {
    "text": "가서 성전에 서서 이 생명의 말씀을 다 백성에게 말하라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p9.b1": {
    "text": "저희가 듣고 새벽에 성전에 들어가서 가르치더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p9.b2": {
    "text": "대제사장과 그와 함께 있는 사람들이 와서 공회와 이스라엘 족속의 원로들을 다 모으고 사람을 옥에 보내어 사도들을 잡아오라 하니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p9.b3": {
    "text": "우리가 보니 옥은 든든하게 잠기고 지킨 사람들이 문에 섰으되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p9.b4": {
    "text": "문을 열고 본즉 그 안에는 한 사람도 없더이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p10.b1": {
    "text": "성전 맡은 자와 제사장들이 이 말을 듣고 의혹하여 이 일이 어찌 될까 하더니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p10.b2": {
    "text": "보소서 옥에 가두었던 사람들이 성전에 서서 백성을 가르치더이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p10.b3": {
    "text": "성전 맡은 자가 관속들과 같이 가서 저희를 잡아 왔으나 강제로 못함은 백성들이 돌로 칠까 두려워함이러라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p11.b1": {
    "text": "저희를 끌어다가 공회 앞에 세우니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p11.b2": {
    "text": "우리가 이 이름으로 사람을 가르치지 말라고 엄금하였으되",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p11.b3": {
    "text": "… 이 사람의 피를 우리에게로 돌리고자 함이로다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p11.b4": {
    "text": "사람보다 하나님을 순종하는것이 마땅하니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p12.b1": {
    "text": "너희가 나무에 달아 죽인 예수를 우리 조상의 하나님이 살리시고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p12.b2": {
    "text": "우리는 이 일에 증인이요 하나님이 자기를 순종하는 사람들에게 주신 성령도 그러하니라 하더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p12.b3": {
    "text": "저희가 듣고 크게 노하여 사도들을 없이하고자 할새",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p13.b1": {
    "text": "바리새인 가말리엘은 교법사로 모든 백성에게 존경을 받는 자라 공회 중에 일어나",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p13.b2": {
    "text": "… 명하사 사도들을 잠간 밖에 나가게 하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p13.b3": {
    "text": "이제 내가 너희에게 말하노니 이 사람들을 상관 말고 버려두라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p13.b4": {
    "text": "만일 하나님께로서 났으면 너희가 저희를 무너뜨릴 수 없겠고 도리어 하나님을 대적하는 자가 될까 하노라 하니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p14.b1": {
    "text": "… 사도들을 불러들여 채찍질하며 예수의 이름으로 말하는 것을 금하고 놓으니",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p14.b2": {
    "text": "사도들은 그 이름을 위하여 능욕 받는 일에 합당한 자로 여기심을 기뻐하면서 공회 앞을 떠나니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.5.p14.b3": {
    "text": "저희가 날마다 성전에 있든지 집에 있든지 예수는 그리스도라 가르치기와 전도하기를 쉬지 아니하니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Acts 5:42"
    },
    "adapted": false,
    "status": "approved"
  }
}
