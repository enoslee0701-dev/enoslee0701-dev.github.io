{
  "samuel1.16.p1.b1": {
    "text": "あなたはいつまで彼のために悲しむのか。角に油を満たし、それをもって行きなさい。あなたをベツレヘムびとエッサイのもとにつかわします。わたしはその子たちのうちにひとりの王を捜し得たからである",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 16:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.16.p1.b2": {
    "text": "どうしてわたしは行くことができましょう。サウルがそれを聞けば、わたしを殺すでしょう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 16:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.16.p1.b3": {
    "text": "一頭の子牛を引いていって、『主に犠牲をささげるためにきました』と言いなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 16:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.16.p2.b1": {
    "text": "サムエルは主が命じられたようにして、ベツレヘムへ行った。町の長老たちは、恐れながら出て、彼を迎え、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 16:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.16.p2.b2": {
    "text": "穏やかな事のためにこられたのですか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 16:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.16.p2.b3": {
    "text": "穏やかな事のためです。わたしは主に犠牲をささげるためにきました。身をきよめて、犠牲の場所にわたしと共にきてください",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 16:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.16.p2.b4": {
    "text": "そしてサムエルはエッサイとその子たちをきよめて犠牲の場に招いた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 16:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.16.p3.b1": {
    "text": "自分の前にいるこの人こそ、主が油をそそがれる人だ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 16:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.16.p3.b2": {
    "text": "顔かたちや身のたけを見てはならない。わたしはすでにその人を捨てた。わたしが見るところは人とは異なる。人は外の顔かたちを見、主は心を見る",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 16:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.16.p4.b1": {
    "text": "主が選ばれたのはこの人でもない",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 16:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.16.p4.b2": {
    "text": "主が選ばれたのはこの人でもない",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 16:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.16.p4.b3": {
    "text": "エッサイは七人の子にサムエルの前を通らせたが、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 16:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.16.p4.b4": {
    "text": "主が選ばれたのはこの人たちではない",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 16:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.16.p5.b1": {
    "text": "あなたのむすこたちは皆ここにいますか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 16:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.16.p5.b2": {
    "text": "まだ末の子が残っていますが羊を飼っています",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 16:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.16.p5.b3": {
    "text": "人をやって彼を連れてきなさい。彼がここに来るまで、われわれは食卓につきません",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 16:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.16.p5.b4": {
    "text": "立ってこれに油をそそげ。これがその人である",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 16:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.16.p6.b1": {
    "text": "サムエルは油の角をとって、その兄弟たちの中で、彼に油をそそいだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 16:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.16.p6.b2": {
    "text": "この日からのち、主の霊は、はげしくダビデの上に臨んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 16:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.16.p6.b3": {
    "text": "そしてサムエルは立ってラマへ行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 16:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.16.p7.b1": {
    "text": "さて主の霊はサウルを離れ、主から来る悪霊が彼を悩ました。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 16:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.16.p7.b2": {
    "text": "…じょうずに琴をひく者ひとりを捜させてください。…彼が手で琴をひくならば、あなたは良くなられるでしょう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 16:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.16.p7.b3": {
    "text": "わたしはベツレヘムびとエッサイの子を見ましたが、琴がじょうずで、勇気もあり、いくさびとで、弁舌にひいで、姿の美しい人です。また主が彼と共におられます",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 16:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.16.p8.b1": {
    "text": "エッサイは、ろばにパンを負わせ、皮袋にいれたぶどう酒一袋と、やぎの子とを取って、その子ダビデの手によってサウルに送った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 16:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.16.p8.b2": {
    "text": "サウルはひじょうにこれを愛して、その武器を執る者とした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 16:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.16.p8.b3": {
    "text": "…ダビデは琴をとり、手でそれをひくと、サウルは気が静まり、良くなって、悪霊は彼を離れた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 16:23"
    },
    "adapted": false,
    "status": "approved"
  }
}
