{
  "exodus.25.p1.b1": {
    "text": "「イスラエルの人々に告げて、わたしのためにささげ物を携えてこさせなさい。すべて、心から喜んでする者から、わたしにささげる物を受け取りなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 25:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.25.p1.b2": {
    "text": "あなたがたが彼らから受け取るべきささげ物はこれである。すなわち金、銀、青銅、 青糸、紫糸、緋糸、……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 25:3-4"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.25.p1.b3": {
    "text": "また、彼らにわたしのために聖所を造らせなさい。わたしが彼らのうちに住むためである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 25:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.25.p2.b4": {
    "text": "彼らはアカシヤ材で箱を造らなければならない。長さは二キュビト半、幅は一キュビト半、高さは一キュビト半。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 25:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.25.p2.b5": {
    "text": "あなたは純金でこれをおおわなければならない。すなわち内外ともにこれをおおい、その上の周囲に金の飾り縁を造らなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 25:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.25.p2.b6": {
    "text": "さおは箱の環に差して置き、それを抜き放してはならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 25:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.25.p2.b7": {
    "text": "そしてその箱に、わたしがあなたに与えるあかしの板を納めなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 25:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.25.p3.b8": {
    "text": "また二つの金のケルビムを造らなければならない。これを打物造りとし、贖罪所の両端に置かなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 25:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.25.p3.b9": {
    "text": "ケルビムは翼を高く伸べ、その翼をもって贖罪所をおおい、顔は互にむかい合い、ケルビムの顔は贖罪所にむかわなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 25:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.25.p3.b10": {
    "text": "その所でわたしはあなたに会い、贖罪所の上から、あかしの箱の上にある二つのケルビムの間から、……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 25:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.25.p4.b11": {
    "text": "あなたはまたアカシヤ材の机を造らなければならない。長さは二キュビト、幅は一キュビト、高さは一キュビト半。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 25:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.25.p4.b12": {
    "text": "また、その皿、乳香を盛る杯および灌祭を注ぐための瓶と鉢を造り、これらは純金で造らなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 25:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.25.p4.b13": {
    "text": "そして机の上には供えのパンを置いて、常にわたしの前にあるようにしなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 25:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.25.p5.b14": {
    "text": "また純金の燭台を造らなければならない。燭台は打物造りとし、その台、幹、萼、節、花を一つに連ならせなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 25:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.25.p5.b15": {
    "text": "また、それのともしび皿を七つ造り、そのともしび皿に火をともして、その前方を照させなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 25:37"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.25.p5.b16": {
    "text": "そしてあなたが山で示された型に従い、注意してこれを造らなければならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 25:40"
    },
    "adapted": false,
    "status": "approved"
  }
}
