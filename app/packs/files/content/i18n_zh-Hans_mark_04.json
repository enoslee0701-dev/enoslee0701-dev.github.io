{
  "mark.4.p1.b1": {
    "text": "耶稣又在海边教训人。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣又⁠在海⁠边教⁠训人。"
  },
  "mark.4.p1.b2": {
    "text": "有许多人到他那里聚集，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有许⁠多人到他那⁠里聚⁠集，"
  },
  "mark.4.p1.b3": {
    "text": "他只得上船坐下。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他只⁠得上⁠船坐⁠下。"
  },
  "mark.4.p1.b4": {
    "text": "船在海里，众人都靠近海，站在岸上。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "船在海⁠里，众⁠人都靠⁠近海，站⁠在岸⁠上。"
  },
  "mark.4.p1.b5": {
    "text": "耶稣就用比喻教训他们许多道理。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣就⁠用比⁠喻教⁠训他⁠们许⁠多道⁠理。"
  },
  "mark.4.p1.b6": {
    "text": "在教训之间，对他们说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "在教⁠训之⁠间，对他⁠们说："
  },
  "mark.4.p2.b1": {
    "text": "你们听啊！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:3"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们听啊！"
  },
  "mark.4.p2.b2": {
    "text": "有一个撒种的出去撒种。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:3"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有一⁠个撒⁠种的出⁠去撒⁠种。"
  },
  "mark.4.p2.b3": {
    "text": "撒的时候，有落在路旁的，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:4"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "撒的时⁠候，有落⁠在路旁的，"
  },
  "mark.4.p2.b4": {
    "text": "飞鸟来吃尽了；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:4"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "飞⁠鸟来吃尽了；"
  },
  "mark.4.p3.b1": {
    "text": "有落在土浅石头地上的，土既不深，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:5"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有落⁠在土浅石⁠头地⁠上的，土既⁠不深，"
  },
  "mark.4.p3.b2": {
    "text": "发苗最快，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:5"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "发苗最⁠快，"
  },
  "mark.4.p3.b3": {
    "text": "日头出来一晒，因为没有根，就枯干了；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:6"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "日头出⁠来一晒，因⁠为没⁠有根，就枯⁠干了；"
  },
  "mark.4.p3.b4": {
    "text": "有落在荆棘里的，荆棘长起来，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有落⁠在荆⁠棘里的，荆⁠棘长起⁠来，"
  },
  "mark.4.p3.b5": {
    "text": "把它挤住了，就不结实；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "把它挤住了，就⁠不结⁠实；"
  },
  "mark.4.p4.b1": {
    "text": "又有落在好土里的，就发生长大，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "又⁠有落⁠在好土里的，就发⁠生长⁠大，"
  },
  "mark.4.p4.b2": {
    "text": "结实有三十倍的，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "结⁠实有⁠三十⁠倍的，"
  },
  "mark.4.p4.b3": {
    "text": "有六十倍的，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有六⁠十倍的，"
  },
  "mark.4.p4.b4": {
    "text": "有一百倍的；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有⁠一百⁠倍的；"
  },
  "mark.4.p4.b5": {
    "text": "又说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p4.b6": {
    "text": "有耳可听的，就应当听！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:9"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有耳可⁠听的，就应⁠当听！"
  },
  "mark.4.p5.b1": {
    "text": "无人的时候，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:10"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "无⁠人的时⁠候，"
  },
  "mark.4.p5.b2": {
    "text": "跟随耶稣的人和十二个门徒问他这比喻的意思。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:10"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "跟⁠随耶⁠稣的人和十⁠二⁠个门⁠徒问他这比⁠喻的意⁠思。"
  },
  "mark.4.p5.b3": {
    "text": "耶稣对他们说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:11"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣对他⁠们说："
  },
  "mark.4.p5.b4": {
    "text": "神国的奥秘只叫你们知道，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:11"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "神⁠国的奥⁠秘只叫你⁠们知⁠道，"
  },
  "mark.4.p5.b5": {
    "text": "若是对外人讲，凡事就用比喻，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:11"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "若⁠是对⁠外人讲，凡⁠事就⁠用比⁠喻，"
  },
  "mark.4.p5.b6": {
    "text": "叫他们看是看见，却不晓得；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:12"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "叫他⁠们看是看⁠见，却不⁠晓⁠得；"
  },
  "mark.4.p5.b7": {
    "text": "听是听见，却不明白；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:12"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "听是听⁠见，却不明⁠白；"
  },
  "mark.4.p5.b8": {
    "text": "恐怕他们回转过来，就得赦免。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:12"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "恐⁠怕他⁠们回转⁠过⁠来，就⁠得赦⁠免。"
  },
  "mark.4.p6.b1": {
    "text": "又对他们说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "又对他⁠们说："
  },
  "mark.4.p6.b2": {
    "text": "你们不明白这比喻吗？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们不明⁠白这比⁠喻吗？"
  },
  "mark.4.p6.b3": {
    "text": "这样怎能明白一切的比喻呢？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "这⁠样怎⁠能明⁠白一⁠切的比⁠喻呢？"
  },
  "mark.4.p6.b4": {
    "text": "撒种之人所撒的就是道。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:14"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "撒⁠种之人所撒的就⁠是道。"
  },
  "mark.4.p6.b5": {
    "text": "那撒在路旁的，就是人听了道，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:15"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "那撒在路旁的，就⁠是人听了道，"
  },
  "mark.4.p6.b6": {
    "text": "撒但立刻来，把撒在他心里的道夺了去。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:15"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "撒⁠但立⁠刻来，把撒在他心⁠里的道夺了去。"
  },
  "mark.4.p7.b1": {
    "text": "那撒在石头地上的，就是人听了道，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:16"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "那撒在石⁠头地⁠上的，就⁠是人听了道，"
  },
  "mark.4.p7.b2": {
    "text": "立刻欢喜领受，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:16"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "立⁠刻欢⁠喜领⁠受，"
  },
  "mark.4.p7.b3": {
    "text": "但他心里没有根，不过是暂时的，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:17"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "但他心⁠里没⁠有根，不⁠过是暂⁠时的，"
  },
  "mark.4.p7.b4": {
    "text": "及至为道遭了患难，或是受了逼迫，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:17"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "及⁠至为道遭了患⁠难，或⁠是受了逼⁠迫，"
  },
  "mark.4.p7.b5": {
    "text": "立刻就跌倒了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:17"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "立⁠刻就跌⁠倒了。"
  },
  "mark.4.p8.b1": {
    "text": "还有那撒在荆棘里的，就是人听了道，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:18"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "还⁠有那撒在荆⁠棘里的，就⁠是人听了道，"
  },
  "mark.4.p8.b2": {
    "text": "后来有世上的思虑、钱财的迷惑，和别样的私欲进来，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:19"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "后⁠来有世⁠上的思虑、钱⁠财的迷⁠惑，和别样的私⁠欲进⁠来，"
  },
  "mark.4.p8.b3": {
    "text": "把道挤住了，就不能结实。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:19"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "把道挤住了，就⁠不⁠能结⁠实。"
  },
  "mark.4.p8.b4": {
    "text": "那撒在好地上的，就是人听道，又领受，并且结实，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:20"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "那撒在好地⁠上的，就⁠是人听道，又领⁠受，并⁠且结⁠实，"
  },
  "mark.4.p8.b5": {
    "text": "有三十倍的，有六十倍的，有一百倍的。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:20"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有⁠三十⁠倍的，有六⁠十倍的，有⁠一百⁠倍的。"
  },
  "mark.4.p9.b1": {
    "text": "耶稣又对他们说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:21"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣又对他⁠们说："
  },
  "mark.4.p9.b2": {
    "text": "人拿灯来，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p9.b3": {
    "text": "岂是要放在斗底下，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:21"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "岂是要放⁠在斗底⁠下，"
  },
  "mark.4.p9.b4": {
    "text": "床底下，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:21"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "床底⁠下，"
  },
  "mark.4.p9.b5": {
    "text": "不放在灯台上吗？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:21"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "不放⁠在灯⁠台上吗？"
  },
  "mark.4.p9.b6": {
    "text": "因为掩藏的事，没有不显出来的；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:22"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "因⁠为掩⁠藏的事，没⁠有不显出⁠来的；"
  },
  "mark.4.p9.b7": {
    "text": "隐瞒的事，没有不露出来的。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:22"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "隐⁠瞒的事，没⁠有不露⁠出来的。"
  },
  "mark.4.p9.b8": {
    "text": "有耳可听的，就应当听！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:23"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有耳可⁠听的，就应⁠当听！"
  },
  "mark.4.p10.b1": {
    "text": "又说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p10.b2": {
    "text": "你们所听的要留心。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:24"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们所听的要留⁠心。"
  },
  "mark.4.p10.b3": {
    "text": "你们用什么量器量给人，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:24"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们用什⁠么量器⁠量给⁠人，"
  },
  "mark.4.p10.b4": {
    "text": "也必用什么量器量给你们，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:24"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "也必⁠用什⁠么量器⁠量给你⁠们，"
  },
  "mark.4.p10.b5": {
    "text": "并且要多给你们。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:24"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "并⁠且要多给你⁠们。"
  },
  "mark.4.p10.b6": {
    "text": "因为有的，还要给他；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:25"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "因⁠为有的，还要给他；"
  },
  "mark.4.p10.b7": {
    "text": "没有的，连他所有的也要夺去。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:25"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "没⁠有的，连他所⁠有的也⁠要夺去。"
  },
  "mark.4.p11.b1": {
    "text": "又说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p11.b2": {
    "text": "神的国如同人把种撒在地上。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:26"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "神⁠的国如⁠同人把种撒在地⁠上。"
  },
  "mark.4.p11.b3": {
    "text": "黑夜睡觉，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:27"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "黑⁠夜睡⁠觉，"
  },
  "mark.4.p11.b4": {
    "text": "白日起来，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:27"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "白日起⁠来，"
  },
  "mark.4.p11.b5": {
    "text": "这种就发芽渐长，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:27"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "这⁠种就发⁠芽渐长，"
  },
  "mark.4.p11.b6": {
    "text": "那人却不晓得如何这样。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:27"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "那人却不⁠晓⁠得如⁠何这⁠样。"
  },
  "mark.4.p11.b7": {
    "text": "地生五谷是出于自然的：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:28"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "地生五⁠谷是出⁠于自⁠然的："
  },
  "mark.4.p11.b8": {
    "text": "先发苗，后长穗，再后穗上结成饱满的子粒；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:28"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "先发苗，后长穗，再后穗上结⁠成饱⁠满的子粒；"
  },
  "mark.4.p11.b9": {
    "text": "谷既熟了，就用镰刀去割，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:29"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "谷既熟⁠了，就⁠用镰⁠刀去割，"
  },
  "mark.4.p11.b10": {
    "text": "因为收成的时候到了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:29"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "因⁠为收⁠成的时⁠候到⁠了。"
  },
  "mark.4.p12.b1": {
    "text": "又说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p12.b2": {
    "text": "神的国，我们可用什么比较呢？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:30"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "神⁠的国，我⁠们可⁠用什⁠么比⁠较呢？"
  },
  "mark.4.p12.b3": {
    "text": "可用什么比喻表明呢？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:30"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "可⁠用什⁠么比⁠喻表⁠明呢？"
  },
  "mark.4.p12.b4": {
    "text": "好像一粒芥菜种，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:31"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "好⁠像一⁠粒芥⁠菜⁠种，"
  },
  "mark.4.p12.b5": {
    "text": "种在地里的时候，虽比地上的百种都小，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:31"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "种在地里的时⁠候，虽比地⁠上的百种都小，"
  },
  "mark.4.p12.b6": {
    "text": "但种上以后，就长起来，比各样的菜都大，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:32"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "但种上以⁠后，就长起⁠来，比各⁠样的菜都大，"
  },
  "mark.4.p12.b7": {
    "text": "又长出大枝来，甚至天上的飞鸟可以宿在它的荫下。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:32"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "又长⁠出大⁠枝来，甚⁠至天⁠上的飞⁠鸟可⁠以宿在它⁠的荫下。"
  },
  "mark.4.p13.b1": {
    "text": "耶稣用许多这样的比喻，照他们所能听的，对他们讲道。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:33"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣用许⁠多这⁠样的比⁠喻，照他⁠们所⁠能听的，对他⁠们讲⁠道。"
  },
  "mark.4.p13.b2": {
    "text": "若不用比喻，就不对他们讲；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:34"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "若不⁠用比⁠喻，就⁠不对他⁠们讲；"
  },
  "mark.4.p13.b3": {
    "text": "没有人的时候，就把一切的道讲给门徒听。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:34"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "没⁠有人⁠的时⁠候，就⁠把一⁠切的道讲⁠给门⁠徒听。"
  },
  "mark.4.p13.b4": {
    "text": "当那天晚上，耶稣对门徒说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:35"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "当那⁠天晚⁠上，耶⁠稣对门⁠徒说："
  },
  "mark.4.p13.b5": {
    "text": "我们渡到那边去吧。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:35"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我⁠们渡到那⁠边去吧。"
  },
  "mark.4.p14.b1": {
    "text": "门徒离开众人，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:36"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "门⁠徒离⁠开众⁠人，"
  },
  "mark.4.p14.b2": {
    "text": "耶稣仍在船上，他们就把他一同带去；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:36"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣仍⁠在船⁠上，他⁠们就⁠把他一⁠同带⁠去；"
  },
  "mark.4.p14.b3": {
    "text": "也有别的船和他同行。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:36"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "也⁠有别⁠的船和他同⁠行。"
  },
  "mark.4.p14.b4": {
    "text": "忽然起了暴风，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:37"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "忽⁠然起⁠了暴⁠风，"
  },
  "mark.4.p14.b5": {
    "text": "波浪打入船内，甚至船要满了水。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:37"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "波⁠浪打⁠入船⁠内，甚⁠至船要满⁠了水。"
  },
  "mark.4.p15.b1": {
    "text": "耶稣在船尾上，枕着枕头睡觉。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:38"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣在船⁠尾上，枕⁠着枕⁠头睡⁠觉。"
  },
  "mark.4.p15.b2": {
    "text": "门徒叫醒了他，说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:38"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "门⁠徒叫⁠醒了他，说："
  },
  "mark.4.p15.b3": {
    "text": "夫子！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:38"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "夫⁠子！"
  },
  "mark.4.p15.b4": {
    "text": "我们丧命，你不顾吗？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:38"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我⁠们丧命，你不⁠顾吗？"
  },
  "mark.4.p16.b1": {
    "text": "耶稣醒了，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:39"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣醒了，"
  },
  "mark.4.p16.b2": {
    "text": "斥责风，向海说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:39"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "斥⁠责风，向海说："
  },
  "mark.4.p16.b3": {
    "text": "住了吧！静了吧！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "mark.4.p16.b4": {
    "text": "风就止住，大大地平静了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:39"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "风就止⁠住，大大⁠地平⁠静了。"
  },
  "mark.4.p17.b1": {
    "text": "耶稣对他们说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:40"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣对他⁠们说："
  },
  "mark.4.p17.b2": {
    "text": "为什么胆怯？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:40"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "为⁠什⁠么胆⁠怯？"
  },
  "mark.4.p17.b3": {
    "text": "你们还没有信心吗？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:40"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们还没⁠有信⁠心吗？"
  },
  "mark.4.p17.b4": {
    "text": "他们就大大地惧怕，彼此说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:41"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠们就大大⁠地惧⁠怕，彼⁠此说："
  },
  "mark.4.p17.b5": {
    "text": "这到底是谁，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:41"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "这到⁠底⁠是谁，"
  },
  "mark.4.p17.b6": {
    "text": "连风和海也听从他了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 4:41"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "连风和海也听⁠从他了。"
  }
}
