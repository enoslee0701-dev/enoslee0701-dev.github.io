{
  "matthew.9.p1.b1": {
    "text": "耶稣上了船，渡过海，来到自己的城里。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣上⁠了船，渡⁠过海，来⁠到自⁠己的城里。"
  },
  "matthew.9.p1.b2": {
    "text": "有人用褥子抬着一个瘫子到耶稣跟前来。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有⁠人用褥⁠子抬着一⁠个瘫⁠子到耶⁠稣跟⁠前来。"
  },
  "matthew.9.p1.b3": {
    "text": "耶稣见他们的信心，就对瘫子说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣见他⁠们的信⁠心，就对瘫⁠子说："
  },
  "matthew.9.p1.b4": {
    "text": "小子，放心吧！你的罪赦了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "小⁠子，放⁠心吧！你⁠的罪赦了。"
  },
  "matthew.9.p2.b1": {
    "text": "有几个文士心里说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:3"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有几⁠个文⁠士心⁠里说："
  },
  "matthew.9.p2.b2": {
    "text": "这个人说僭妄的话了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:3"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "这⁠个人说僭妄的⁠话了。"
  },
  "matthew.9.p2.b3": {
    "text": "你们为什么心里怀着恶念呢？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:4"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们为⁠什⁠么心⁠里怀着恶⁠念呢？"
  },
  "matthew.9.p2.b4": {
    "text": "或说『你的罪赦了』，或说『你起来行走』，哪一样容易呢？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:5"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "或说『你⁠的罪赦了』，或说『你起⁠来行⁠走』，哪一⁠样容⁠易呢？"
  },
  "matthew.9.p3.b1": {
    "text": "但要叫你们知道，人子在地上有赦罪的权柄",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:6"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "但要叫你⁠们知⁠道，人⁠子在地⁠上有赦⁠罪的权⁠柄"
  },
  "matthew.9.p3.b2": {
    "text": "起来！拿你的褥子回家去吧。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:6"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "起⁠来！拿你⁠的褥⁠子回⁠家去吧。"
  },
  "matthew.9.p3.b3": {
    "text": "那人就起来，回家去了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "那人就起⁠来，回⁠家去⁠了。"
  },
  "matthew.9.p3.b4": {
    "text": "众人看见都惊奇，就归荣耀与　神，因为他将这样的权柄赐给人。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "众⁠人看⁠见都惊⁠奇，就归荣⁠耀与　神，因⁠为他将这⁠样的权⁠柄赐⁠给人。"
  },
  "matthew.9.p4.b1": {
    "text": "耶稣从那里往前走，看见一个人名叫马太，坐在税关上，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:9"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣从那⁠里往⁠前⁠走，看⁠见一⁠个人名⁠叫马⁠太，坐⁠在税关上，"
  },
  "matthew.9.p4.b2": {
    "text": "你跟从我来。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:9"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你跟从我⁠来。"
  },
  "matthew.9.p4.b3": {
    "text": "他就起来跟从了耶稣。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:9"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他就起⁠来跟从了耶⁠稣。"
  },
  "matthew.9.p5.b1": {
    "text": "耶稣在屋里坐席的时候，有好些税吏和罪人来，与耶稣和他的门徒一同坐席。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:10"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣在屋里坐⁠席的时⁠候，有好⁠些税⁠吏和罪⁠人来，与耶⁠稣和他⁠的门⁠徒一⁠同坐⁠席。"
  },
  "matthew.9.p5.b2": {
    "text": "法利赛人看见，就对耶稣的门徒说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:11"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "法⁠利⁠赛人看⁠见，就对耶⁠稣的门⁠徒说："
  },
  "matthew.9.p5.b3": {
    "text": "你们的先生为什么和税吏并罪人一同吃饭呢？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:11"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们的先⁠生为⁠什⁠么和税⁠吏并罪⁠人一⁠同吃⁠饭呢？"
  },
  "matthew.9.p6.b1": {
    "text": "康健的人用不着医生，有病的人才用得着。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:12"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "康⁠健的人用⁠不⁠着医⁠生，有⁠病的人⁠才用得着。"
  },
  "matthew.9.p6.b2": {
    "text": "经上说：『我喜爱怜恤，不喜爱祭祀。』",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "经上说：『我喜⁠爱怜恤，不喜⁠爱祭⁠祀。』"
  },
  "matthew.9.p6.b3": {
    "text": "我来本不是召义人，乃是召罪人。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我⁠来本不⁠是召义人，乃⁠是召罪⁠人。"
  },
  "matthew.9.p7.b1": {
    "text": "那时，约翰的门徒来见耶稣，说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:14"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "那⁠时，约⁠翰的门⁠徒来⁠见耶⁠稣，说："
  },
  "matthew.9.p7.b2": {
    "text": "我们和法利赛人常常禁食，你的门徒倒不禁食，这是为什么呢？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:14"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我⁠们和法⁠利⁠赛人常⁠常禁⁠食，你⁠的门⁠徒倒不⁠禁食，这是为⁠什⁠么呢？"
  },
  "matthew.9.p7.b3": {
    "text": "新郎和陪伴之人同在的时候，陪伴之人岂能哀恸呢？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:15"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "新⁠郎和陪⁠伴之人同在的时⁠候，陪⁠伴之人岂能哀⁠恸呢？"
  },
  "matthew.9.p7.b4": {
    "text": "但日子将到，新郎要离开他们，那时候他们就要禁食。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:15"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "但日⁠子将到，新⁠郎要离⁠开他⁠们，那时⁠候他⁠们就⁠要禁⁠食。"
  },
  "matthew.9.p8.b1": {
    "text": "没有人把新布补在旧衣服上；……破的就更大了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:16"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "没⁠有人把新布补在旧衣⁠服上；……破的就更⁠大了。"
  },
  "matthew.9.p8.b2": {
    "text": "也没有人把新酒装在旧皮袋里；若是这样，皮袋就裂开，酒漏出来，连皮袋也坏了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:17"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "也⁠没⁠有人把新⁠酒装在旧皮⁠袋里；若⁠是这⁠样，皮⁠袋就裂开，酒漏出⁠来，连皮⁠袋也坏了。"
  },
  "matthew.9.p8.b3": {
    "text": "惟独把新酒装在新皮袋里，两样就都保全了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:17"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "惟⁠独把新⁠酒装在新皮⁠袋里，两样就都保⁠全了。"
  },
  "matthew.9.p9.b1": {
    "text": "耶稣说这话的时候，有一个管会堂的来拜他，说：",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:18"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣说这话的时⁠候，有一⁠个管会⁠堂的来拜他，说："
  },
  "matthew.9.p9.b2": {
    "text": "我女儿刚才死了，求你去按手在她身上，她就必活了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:18"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我女⁠儿刚⁠才死⁠了，求你去按手在她身⁠上，她就必活⁠了。"
  },
  "matthew.9.p9.b3": {
    "text": "耶稣便起来跟着他去；门徒也跟了去。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:19"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣便起⁠来跟⁠着他去；门⁠徒也跟了去。"
  },
  "matthew.9.p10.b1": {
    "text": "有一个女人，患了十二年的血漏，来到耶稣背后，摸他的衣裳繸子；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:20"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有一⁠个女⁠人，患了十⁠二年的血漏，来⁠到耶⁠稣背⁠后，摸他⁠的衣⁠裳繸子；"
  },
  "matthew.9.p10.b2": {
    "text": "我只摸他的衣裳，就必痊愈。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:21"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我⁠只摸他⁠的衣⁠裳，就必痊愈。"
  },
  "matthew.9.p10.b3": {
    "text": "女儿，放心！你的信救了你。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:22"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "女⁠儿，放⁠心！你⁠的信救了你。"
  },
  "matthew.9.p10.b4": {
    "text": "从那时候，女人就痊愈了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:22"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "从那时⁠候，女⁠人就痊愈了。"
  },
  "matthew.9.p11.b1": {
    "text": "耶稣到了管会堂的家里，看见有吹手，又有许多人乱嚷，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:23"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣到⁠了管会⁠堂的家⁠里，看⁠见有吹手，又⁠有许⁠多人乱嚷，"
  },
  "matthew.9.p11.b2": {
    "text": "退去吧！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:24"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "退⁠去吧！"
  },
  "matthew.9.p11.b3": {
    "text": "这闺女不是死了，是睡着了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:24"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "这闺⁠女不⁠是死⁠了，是睡⁠着⁠了。"
  },
  "matthew.9.p11.b4": {
    "text": "他们就嗤笑他。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:24"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠们就嗤⁠笑他。"
  },
  "matthew.9.p12.b1": {
    "text": "众人既被撵出，耶稣就进去，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:25"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "众⁠人既被撵⁠出，耶⁠稣就进⁠去，"
  },
  "matthew.9.p12.b2": {
    "text": "拉着闺女的手，闺女便起来了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:25"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "拉着闺⁠女的手，闺⁠女便起⁠来了。"
  },
  "matthew.9.p12.b3": {
    "text": "于是这风声传遍了那地方。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:26"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "于⁠是这风声传⁠遍了那地⁠方。"
  },
  "matthew.9.p13.b1": {
    "text": "大卫的子孙，可怜我们吧！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:27"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "大⁠卫的子⁠孙，可⁠怜我⁠们吧！"
  },
  "matthew.9.p13.b2": {
    "text": "你们信我能做这事吗？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:28"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们信我⁠能做这事吗？"
  },
  "matthew.9.p13.b3": {
    "text": "主啊，我们信。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:28"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "主啊，我⁠们信。"
  },
  "matthew.9.p13.b4": {
    "text": "照着你们的信给你们成全了吧。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:29"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "照着你⁠们的信给你⁠们成⁠全了吧。"
  },
  "matthew.9.p14.b1": {
    "text": "他们出去的时候，有人将鬼所附的一个哑巴带到耶稣跟前来。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:32"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠们出⁠去的时⁠候，有⁠人将鬼所附的一⁠个哑⁠巴带⁠到耶⁠稣跟⁠前来。"
  },
  "matthew.9.p14.b2": {
    "text": "鬼被赶出去，哑巴就说出话来。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:33"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "鬼被赶⁠出⁠去，哑⁠巴就说⁠出话⁠来。"
  },
  "matthew.9.p14.b3": {
    "text": "在以色列中，从来没有见过这样的事。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:33"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "在以⁠色⁠列中，从⁠来没⁠有见⁠过这⁠样的事。"
  },
  "matthew.9.p14.b4": {
    "text": "他是靠着鬼王赶鬼。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:34"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠是靠着鬼⁠王赶鬼。"
  },
  "matthew.9.p15.b1": {
    "text": "耶稣走遍各城各乡，在会堂里教训人，宣讲天国的福音，又医治各样的病症。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:35"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣走⁠遍各城各乡，在会⁠堂里教⁠训人，宣⁠讲天⁠国的福⁠音，又医⁠治各⁠样的病⁠症。"
  },
  "matthew.9.p15.b2": {
    "text": "他看见许多的人，就怜悯他们；因为他们困苦流离，如同羊没有牧人一般。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:36"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他看⁠见许⁠多的人，就怜⁠悯他⁠们；因⁠为他⁠们困⁠苦流⁠离，如⁠同羊没⁠有牧⁠人一⁠般。"
  },
  "matthew.9.p15.b3": {
    "text": "要收的庄稼多，做工的人少。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:37"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "要收的庄⁠稼多，做⁠工的人少。"
  },
  "matthew.9.p15.b4": {
    "text": "所以，你们当求庄稼的主打发工人出去收他的庄稼。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Matthew 9:38"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "所⁠以，你⁠们当求庄⁠稼的主打⁠发工⁠人出⁠去收他⁠的庄⁠稼。"
  }
}
