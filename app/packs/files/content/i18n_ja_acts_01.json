{
  "acts.1.p1.b1": {
    "text": "テオピロよ、わたしは先に第一巻を著わして、イエスが行い、また教えはじめてから、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 1:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.1.p1.b2": {
    "text": "イエスは苦難を受けたのち、自分の生きていることを数々の確かな証拠によって示し、四十日にわたってたびたび彼らに現れて、神の国のことを語られた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 1:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.1.p2.b1": {
    "text": "そして食事を共にしているとき、彼らにお命じになった、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 1:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.1.p2.b2": {
    "text": "「エルサレムから離れないで、かねてわたしから聞いていた父の約束を待っているがよい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 1:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.1.p2.b3": {
    "text": "「主よ、イスラエルのために国を復興なさるのは、この時なのですか」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 1:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.1.p2.b4": {
    "text": "「時期や場合は、父がご自分の権威によって定めておられるのであって、あなたがたの知る限りではない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 1:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.1.p3.b1": {
    "text": "ただ、聖霊があなたがたにくだる時、あなたがたは力を受けて、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 1:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.1.p3.b2": {
    "text": "… エルサレム、ユダヤとサマリヤの全土、さらに地のはてまで、わたしの証人となるであろう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 1:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.1.p4.b1": {
    "text": "こう言い終ると、イエスは彼らの見ている前で天に上げられ、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 1:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.1.p4.b2": {
    "text": "… 雲に迎えられて、その姿が見えなくなった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 1:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.1.p5.b1": {
    "text": "イエスの上って行かれるとき、彼らが天を見つめていると、見よ、白い衣を着たふたりの人が、彼らのそばに立っていて",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 1:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.1.p5.b2": {
    "text": "「ガリラヤの人たちよ、なぜ天を仰いで立っているのか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 1:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.1.p5.b3": {
    "text": "… 天に上って行かれるのをあなたがたが見たのと同じ有様で、またおいでになるであろう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 1:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.1.p6.b1": {
    "text": "それから彼らは、オリブという山を下ってエルサレムに帰った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 1:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.1.p6.b2": {
    "text": "彼らは、市内に行って、その泊まっていた屋上の間にあがった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 1:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.1.p7.b1": {
    "text": "彼らはみな、婦人たち、特にイエスの母マリヤ、およびイエスの兄弟たちと共に、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 1:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.1.p7.b2": {
    "text": "… 心を合わせて、ひたすら祈をしていた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 1:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.1.p8.b1": {
    "text": "そのころ、百二十名ばかりの人々が、一団となって集まっていたが、ペテロはこれらの兄弟たちの中に立って言った、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 1:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.1.p8.b2": {
    "text": "「兄弟たちよ、イエスを捕えた者たちの手びきになったユダについては、聖霊がダビデの口をとおして預言したその言葉は、成就しなければならなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 1:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.1.p8.b3": {
    "text": "… 『その屋敷は荒れ果てよ、そこにはひとりも住む者がいなくなれ』 …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 1:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.1.p8.b4": {
    "text": "『その職は、ほかの者に取らせよ』",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 1:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.1.p9.b1": {
    "text": "… 始終わたしたちと行動を共にした人たちのうち、だれかひとりが、わたしたちに加わって主の復活の証人にならねばならない」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 1:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.1.p9.b2": {
    "text": "そこで一同は、バルサバと呼ばれ、またの名をユストというヨセフと、マッテヤとのふたりを立て、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 1:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.1.p10.b1": {
    "text": "「すべての人の心をご存じである主よ。このふたりのうちのどちらを選んで、 …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 1:24-25"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.1.p10.b2": {
    "text": "それから、ふたりのためにくじを引いたところ、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 1:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.1.p10.b3": {
    "text": "… マッテヤに当ったので、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 1:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "acts.1.p10.b4": {
    "text": "… この人が十一人の使徒たちに加えられることになった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Acts 1:26"
    },
    "adapted": false,
    "status": "approved"
  }
}
