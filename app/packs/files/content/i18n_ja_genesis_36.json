{
  "genesis.36.p1.b1": {
    "text": "エサウ、すなわちエドムの系図は次のとおりである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 36:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.36.p1.b2": {
    "text": "アダはエリパズをエサウに産み、バスマテはリウエルを産み、アホリバマはエウシ、ヤラム、コラを産んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 36:4-5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.36.p1.b3": {
    "text": "彼らの財産が多くて、一緒にいることができなかったからである。すなわち彼らが寄留した地は彼らの家畜のゆえに、彼らをささえることができなかったのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 36:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.36.p1.b4": {
    "text": "こうしてエサウはセイルの山地に住んだ。エサウはすなわちエドムである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 36:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.36.p2.b5": {
    "text": "エサウの子らの中で、族長たる者は次のとおりである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 36:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.36.p2.b6": {
    "text": "…このアナは父ヂベオンのろばを飼っていた時、荒野で温泉を発見した者である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 36:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.36.p2.b7": {
    "text": "この地の住民ホリびとセイルの子らは次のとおりである。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 36:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.36.p2.b8": {
    "text": "アナの子らは次のとおりである。すなわちデションとアホリバマ。アホリバマはアナの娘である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 36:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.36.p3.b9": {
    "text": "イスラエルの人々を治める王がまだなかった時、エドムの地を治めた王たちは次のとおりである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 36:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.36.p3.b10": {
    "text": "ベラが死んで、ボズラのゼラの子ヨバブがこれに代って王となった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 36:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.36.p3.b11": {
    "text": "…彼はモアブの野でミデアンを撃った者である。…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 36:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.36.p3.b12": {
    "text": "エドムびとの先祖はエサウである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 36:43"
    },
    "adapted": false,
    "status": "approved"
  }
}
