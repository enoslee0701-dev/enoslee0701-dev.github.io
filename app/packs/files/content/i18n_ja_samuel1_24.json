{
  "samuel1.24.p1.b1": {
    "text": "そこでサウルは、全イスラエルから選んだ三千の人を率い、ダビデとその従者たちとを捜すため、「やぎの岩」の前へ出かけた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 24:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p1.b2": {
    "text": "ダビデはエンゲデの野にいます",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 24:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p2.b1": {
    "text": "途中、羊のおりの所にきたが、そこに、ほら穴があり……その時、ダビデとその従者たちは、ほら穴の奥にいた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 24:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p2.b2": {
    "text": "主があなたに告げて、『わたしはあなたの敵をあなたの手に渡す。あなたは自分の良いと思うことを彼にすることができる』と言われた日がきたのです",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 24:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p2.b3": {
    "text": "そこでダビデは立って、ひそかに、サウルの上着のすそを切った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 24:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p3.b1": {
    "text": "しかし後になって、ダビデはサウルの上着のすそを切ったことに、心の責めを感じた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 24:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p3.b2": {
    "text": "主が油を注がれたわが君に、わたしがこの事をするのを主は禁じられる……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 24:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p3.b3": {
    "text": "サウルは立って、ほら穴を去り、道を進んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 24:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p4.b1": {
    "text": "わが君、王よ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 24:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p4.b2": {
    "text": "どうして、あなたは『ダビデがあなたを害しようとしている』という人々の言葉を聞かれるのですか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 24:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p4.b3": {
    "text": "あなたは、この日、自分の目で、主があなたをきょう、ほら穴の中でわたしの手に渡されたのをごらんになりました……わたしは殺しませんでした……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 24:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p5.b1": {
    "text": "わが父よ、ごらんなさい。あなたの上着のすそは、わたしの手にあります。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 24:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p5.b2": {
    "text": "どうぞ主がわたしとあなたの間をさばかれますように。また主がわたしのために、あなたに報いられますように。しかし、わたしはあなたに手をくだすことをしないでしょう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 24:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p5.b3": {
    "text": "イスラエルの王は、だれを追って出てこられたのですか。あなたは、だれを追っておられるのですか。死んだ犬を追っておられるのです。一匹の蚤を追っておられるのです。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 24:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p6.b1": {
    "text": "わが子ダビデよ、これは、あなたの声であるか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 24:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p6.b2": {
    "text": "そしてサウルは声をあげて泣いた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 24:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p6.b3": {
    "text": "あなたはわたしよりも正しい。わたしがあなたに悪を報いたのに、あなたはわたしに善を報いる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 24:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p6.b4": {
    "text": "あなたが、きょう、わたしにした事のゆえに、どうぞ主があなたに良い報いを与えられるように。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 24:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p7.b1": {
    "text": "今わたしは、あなたがかならず王となることを知りました。またイスラエルの王国が、あなたの手によって堅く立つことを知りました。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 24:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p7.b2": {
    "text": "それゆえ、あなたはわたしのあとに、わたしの子孫を断たず……いま主をさして、わたしに誓ってください",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 24:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p7.b3": {
    "text": "そこでダビデはサウルに、そのように誓った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 24:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "samuel1.24.p7.b4": {
    "text": "そしてサウルは家に帰り、ダビデとその従者たちは要害にのぼって行った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "1 Samuel 24:22"
    },
    "adapted": false,
    "status": "approved"
  }
}
