{
  "matthew.21.p1.b1": {
    "text": "さて、彼らがエルサレムに近づき、オリブ山沿いのベテパゲに着いたとき、イエスはふたりの弟子をつかわして言われた、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p1.b2": {
    "text": "ろばがつながれていて、子ろばがそばにいるのを見るであろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p1.b3": {
    "text": "それを解いてわたしのところに引いてきなさい",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p1.b4": {
    "text": "もしだれかが、あなたがたに何か言ったなら、主がお入り用なのです、と言いなさい",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p2.b1": {
    "text": "こうしたのは、預言者によって言われたことが、成就するためである。…シオンの娘に告げよ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:4-5"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p2.b2": {
    "text": "見よ、あなたの王がおいでになる、柔和なおかたで、ろばに乗って、くびきを負うろばの子に乗って",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p2.b3": {
    "text": "弟子たちは出て行って、イエスがお命じになったとおりにし、 ろばと子ろばとを引いてきた。そしてその上に自分たちの上着をかけると、イエスはそれにお乗りになった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:6-7"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p3.b1": {
    "text": "群衆のうち多くの者は自分たちの上着を道に敷き、また、ほかの者たちは木の枝を切ってきて道に敷いた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p3.b2": {
    "text": "ダビデの子に、ホサナ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p3.b3": {
    "text": "主の御名によってきたる者に、祝福あれ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p3.b4": {
    "text": "いと高き所に、ホサナ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p4.b1": {
    "text": "イエスがエルサレムにはいって行かれたとき、町中がこぞって騒ぎ立ち",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p4.b2": {
    "text": "これは、いったい、どなただろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p4.b3": {
    "text": "この人はガリラヤのナザレから出た預言者イエスである",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p5.b1": {
    "text": "イエスは宮にはいられた。そして、宮の庭で売り買いしていた人々をみな追い出し",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p5.b2": {
    "text": "両替人の台や、はとを売る者の腰掛をくつがえされた",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p5.b3": {
    "text": "わたしの家は、祈の家ととなえらるべきである",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p5.b4": {
    "text": "あなたがたはそれを強盗の巣にしている",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p6.b1": {
    "text": "宮の庭で、盲人や足なえがみもとにきた",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p6.b2": {
    "text": "彼らをおいやしになった",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p7.b1": {
    "text": "祭司長、律法学者たちは、イエスがなされた不思議なわざを見、また宮の庭で…叫んでいる子供たちを見て",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p7.b2": {
    "text": "ダビデの子に、ホサナ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p7.b3": {
    "text": "あの子たちが何を言っているのか、お聞きですか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p7.b4": {
    "text": "そうだ、聞いている。あなたがたは『幼な子、乳のみ子たちの口にさんびを備えられた』とあるのを読んだことがないのか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p8.b1": {
    "text": "それから、イエスは彼らをあとに残し、都を出てベタニヤに行き、そこで夜を過ごされた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p8.b2": {
    "text": "朝はやく都に帰るとき、イエスは空腹をおぼえられた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p8.b3": {
    "text": "今から後いつまでも、おまえには実がならないように",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p8.b4": {
    "text": "いちじくの木はたちまち枯れた",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p9.b1": {
    "text": "いちじくがどうして、こうすぐに枯れたのでしょう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p9.b2": {
    "text": "よく聞いておくがよい。もしあなたがたが信じて疑わないならば",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p9.b3": {
    "text": "この山にむかって、動き出して海の中にはいれと言っても、そのとおりになるであろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p9.b4": {
    "text": "また、祈のとき、信じて求めるものは、みな与えられるであろう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p10.b1": {
    "text": "イエスが宮にはいられたとき、祭司長たちや民の長老たちが、その教えておられる所にきて言った",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p10.b2": {
    "text": "何の権威によって、これらの事をするのですか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p10.b3": {
    "text": "だれが、そうする権威を授けたのですか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p10.b4": {
    "text": "わたしも一つだけ尋ねよう。あなたがたがそれに答えてくれたなら、わたしも、何の権威によってこれらの事をするのか、あなたがたに言おう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p11.b1": {
    "text": "ヨハネのバプテスマはどこからきたのであったか。天からであったか、人からであったか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p11.b2": {
    "text": "もし天からだと言えば、では、なぜ彼を信じなかったのか、とイエスは言うだろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p11.b3": {
    "text": "しかし、もし人からだと言えば、群衆が恐ろしい。人々がみなヨハネを預言者と思っているのだから」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p11.b4": {
    "text": "わたしたちにはわかりません",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p11.b5": {
    "text": "わたしも何の権威によってこれらの事をするのか、あなたがたに言うまい",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p12.b1": {
    "text": "子よ、きょう、ぶどう園へ行って働いてくれ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p12.b2": {
    "text": "いやです",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p12.b3": {
    "text": "おとうさん、参ります",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p12.b4": {
    "text": "あとから心を変えて、出かけた",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p12.b5": {
    "text": "行かなかった",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p13.b1": {
    "text": "このふたりのうち、どちらが父の望みどおりにしたのか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p13.b2": {
    "text": "あとの者です",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p13.b3": {
    "text": "よく聞きなさい。取税人や遊女は、あなたがたより先に神の国にはいる",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p13.b4": {
    "text": "取税人や遊女は彼を信じた。あなたがたはそれを見たのに、あとになっても、心をいれ変えて彼を信じようとしなかった",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p14.b1": {
    "text": "もう一つの譬を聞きなさい",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p14.b2": {
    "text": "ある所に、ひとりの家の主人がいたが、ぶどう園を造り、かきをめぐらし、その中に酒ぶねの穴を掘り、やぐらを立て",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p14.b3": {
    "text": "それを農夫たちに貸して、旅に出かけた",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p14.b4": {
    "text": "収穫の季節がきたので、その分け前を受け取ろうとして、僕たちを農夫のところへ送った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p15.b1": {
    "text": "すると、農夫たちは、その僕たちをつかまえて、ひとりを袋だたきにし、ひとりを殺し、もうひとりを石で打ち殺した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p15.b2": {
    "text": "また別に、前よりも多くの僕たちを送ったが、彼らをも同じようにあしらった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:36"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p15.b3": {
    "text": "わたしの子は敬ってくれるだろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:37"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p16.b1": {
    "text": "あれはあと取りだ。さあ、これを殺して、その財産を手に入れよう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p16.b2": {
    "text": "そして彼をつかまえて、ぶどう園の外に引き出して殺した。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p16.b3": {
    "text": "このぶどう園の主人が帰ってきたら、この農夫たちをどうするだろうか」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p16.b4": {
    "text": "悪人どもを、皆殺しにして、季節ごとに収穫を納めるほかの農夫たちに、そのぶどう園を貸し与えるでしょう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p17.b1": {
    "text": "あなたがたは、聖書でまだ読んだことがないのか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:42"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p17.b2": {
    "text": "家造りらの捨てた石が隅のかしら石になった。これは主がなされたことで、わたしたちの目には不思議に見える",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:42"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p17.b3": {
    "text": "それだから、あなたがたに言うが、神の国はあなたがたから取り上げられて、御国にふさわしい実を結ぶような異邦人に与えられるであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:43"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.21.p17.b4": {
    "text": "イエスを捕えようとしたが、群衆を恐れた。群衆はイエスを預言者だと思っていたからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 21:46"
    },
    "adapted": false,
    "status": "approved"
  }
}
