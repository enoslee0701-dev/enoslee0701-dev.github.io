{
  "ezekiel.39.p1.b1": {
    "text": "あなたの左の手から弓を打ち落し、右の手から矢を落させる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 39:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.39.p1.b2": {
    "text": "イスラエルの町々に住む者は出て来て、武器すなわち大盾、小盾、弓、矢、手やり、およびやりなどを燃やし、焼き、七年の間これを火に燃やす。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 39:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.39.p1.b3": {
    "text": "……自分をかすめた者をかすめ、自分の物を奪った者を奪う",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 39:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.39.p1.b4": {
    "text": "イスラエルの家はこれを埋めて、地を清めるために七か月を費す。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 39:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.39.p1.b5": {
    "text": "……人の骨を見る時、死人を埋める者が、これをハモン・ゴグの谷に埋めるまで、そのかたわらに、標を建てて置く。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 39:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.39.p2.b1": {
    "text": "……人の子よ、諸種の鳥と野の獣とに言え、みな集まってこい",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 39:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.39.p2.b2": {
    "text": "……彼らがわたしにそむいたので、わたしはわが顔を彼らに隠し、彼らをその敵の手に渡した",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 39:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.39.p2.b3": {
    "text": "……いまわたしはヤコブの幸福をもとに返し、イスラエルの全家をあわれみ……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 39:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.39.p2.b4": {
    "text": "わたしは、わが霊をイスラエルの家に注ぐ時、重ねてわが顔を彼らに隠さない",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 39:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.39.p2.b5": {
    "text": "彼らは、わたしが彼らの神、主であることを悟る……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 39:28"
    },
    "adapted": false,
    "status": "approved"
  }
}
