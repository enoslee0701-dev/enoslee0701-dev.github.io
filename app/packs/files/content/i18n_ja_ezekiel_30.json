{
  "ezekiel.30.p1.b1": {
    "text": "その日は近い、主の日は近い。これは雲の日、異邦人の滅びの時である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 30:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.30.p1.b2": {
    "text": "わたしはナイル川をからし",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 30:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.30.p1.b3": {
    "text": "わたしは偶像をこわし、メンピスで偶像を滅ぼす。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 30:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.30.p1.b4": {
    "text": "テパネスでは日は暗くなり、…雲はこれをおおい",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 30:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.30.p1.b5": {
    "text": "人の子よ、わたしはエジプトの王パロの腕を折った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 30:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.30.p1.b6": {
    "text": "わたしはバビロンの王の腕を強くし、わたしのつるぎを、その手に与える。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 30:24"
    },
    "adapted": false,
    "status": "approved"
  }
}
