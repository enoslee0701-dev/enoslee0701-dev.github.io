{
  "ezekiel.32.p1.b1": {
    "text": "第十二年の十二月一日に",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 32:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.32.p1.b2": {
    "text": "人の子よ、エジプトの王パロのために、悲しみの歌をのべて",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 32:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.32.p1.b3": {
    "text": "あなたは自分をもろもろの国民のうちのししであると考えているが、あなたは海の中の龍のような者である。あなたは川の中に、はね起き、足で水をかきまぜ、川を濁す。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 32:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.32.p1.b4": {
    "text": "わたしは多くの民の集団をもって、わたしの網をあなたに投げかけ、あなたを網で引きあげる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 32:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.32.p1.b5": {
    "text": "空をおおい、星を暗くし、雲で日をおおい、月に光を放たせない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 32:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.32.p1.b6": {
    "text": "その時わたしはその水を清くし、その川々を油のように流れさせる",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 32:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.32.p2.b1": {
    "text": "人の子よ、エジプトの民衆のために嘆き",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 32:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.32.p2.b2": {
    "text": "アッスリヤとその仲間とはその所におり",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 32:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.32.p2.b3": {
    "text": "彼らの墓は穴の奥に設けられ … 生ける者の地に恐れを起した者である。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 32:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.32.p2.b4": {
    "text": "これらの勇士は、武具を持って陰府に下り、つるぎをまくらとし",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 32:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.32.p2.b5": {
    "text": "あなたは割礼を受けない者のうちに、つるぎで殺された者と共に横たわる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 32:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.32.p2.b6": {
    "text": "パロとすべての民衆とは、割礼を受けない者のうちにあって、つるぎで殺された者と共に伏すと、主なる神は言われる",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 32:32"
    },
    "adapted": false,
    "status": "approved"
  }
}
