{
  "genesis.11.p1.b1": {
    "text": "全地は同じ発音、同じ言葉であった。 時に人々は東に移り、シナルの地に平野を得て、そこに住んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 11:1-2"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.11.p1.b2": {
    "text": "「さあ、れんがを造って、よく焼こう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 11:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.11.p1.b3": {
    "text": "こうして彼らは石の代りに、れんがを得、しっくいの代りに、アスファルトを得た。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 11:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.11.p2.b4": {
    "text": "「さあ、町と塔とを建てて、その頂を天に届かせよう。そしてわれわれは名を上げて、全地のおもてに散るのを免れよう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 11:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.11.p3.b5": {
    "text": "時に主は下って、人の子たちの建てる町と塔とを見て、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 11:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.11.p3.b6": {
    "text": "民は一つで、みな同じ言葉である。彼らはすでにこの事をしはじめた。彼らがしようとする事は、もはや何事もとどめ得ないであろう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 11:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.11.p3.b7": {
    "text": "さあ、われわれは下って行って、そこで彼らの言葉を乱し、互に言葉が通じないようにしよう」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 11:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.11.p4.b8": {
    "text": "… 彼らは町を建てるのをやめた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 11:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.11.p4.b9": {
    "text": "これによってその町の名はバベルと呼ばれた。主がそこで全地の言葉を乱されたからである。主はそこから彼らを全地のおもてに散らされた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 11:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.11.p5.b10": {
    "text": "セムの系図は次のとおりである。セムは百歳になって洪水の二年の後にアルパクサデを生んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 11:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.11.p5.b11": {
    "text": "ナホルは二十九歳になってテラを生んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 11:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.11.p5.b12": {
    "text": "テラは七十歳になってアブラム、ナホルおよびハランを生んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 11:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.11.p6.b13": {
    "text": "ハランはロトを生んだ。 ハランは父テラにさきだって、その生れた地、カルデヤのウルで死んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 11:27-28"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.11.p6.b14": {
    "text": "サライはうまずめで、子がなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 11:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.11.p6.b15": {
    "text": "テラはその子アブラムと、ハランの子である孫ロトと、子アブラムの妻である嫁サライとを連れて、カナンの地へ行こうとカルデヤのウルを出たが …",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 11:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "genesis.11.p6.b16": {
    "text": "ハランに着いてそこに住んだ。 テラの年は二百五歳であった。テラはハランで死んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Genesis 11:31-32"
    },
    "adapted": false,
    "status": "approved"
  }
}
