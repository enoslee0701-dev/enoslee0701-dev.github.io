{
  "exodus.17.p1.b1": {
    "text": "イスラエルの人々の全会衆は、主の命に従って、シンの荒野を出発し、旅路を重ねて、レピデムに宿営したが、そこには民の飲む水がなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 17:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.17.p1.b2": {
    "text": "わたしたちに飲む水をください",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 17:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.17.p1.b3": {
    "text": "あなたはなぜわたしたちをエジプトから導き出して、わたしたちを、子供や家畜と一緒に、かわきによって死なせようとするのですか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 17:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.17.p1.b4": {
    "text": "わたしはこの民をどうすればよいのでしょう。彼らは、今にも、わたしを石で打ち殺そうとしています",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 17:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.17.p2.b5": {
    "text": "あなたは民の前に進み行き、イスラエルの長老たちを伴い、あなたがナイル川を打った、つえを手に取って行きなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 17:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.17.p2.b6": {
    "text": "あなたは岩を打ちなさい。水がそれから出て、民はそれを飲むことができる",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 17:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.17.p2.b7": {
    "text": "そして彼はその所の名をマッサ、またメリバと呼んだ。これはイスラエルの人々が争ったゆえ、また彼らが「主はわたしたちのうちにおられるかどうか」と言って主を試みたからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 17:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.17.p3.b8": {
    "text": "ときにアマレクがきて、イスラエルとレピデムで戦った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 17:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.17.p3.b9": {
    "text": "われわれのために人を選び、出てアマレクと戦いなさい。わたしはあす神のつえを手に取って、丘の頂に立つであろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 17:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.17.p3.b10": {
    "text": "ヨシュアはモーセが彼に言ったようにし、アマレクと戦った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 17:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.17.p3.b11": {
    "text": "モーセとアロンおよびホルは丘の頂に登った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 17:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.17.p4.b12": {
    "text": "モーセが手を上げているとイスラエルは勝ち、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 17:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.17.p4.b13": {
    "text": "手を下げるとアマレクが勝った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 17:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.17.p4.b14": {
    "text": "アロンとホルが…ひとりはこちらに、ひとりはあちらにいて、モーセの手をささえたので、彼の手は日没までさがらなかった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 17:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.17.p5.b15": {
    "text": "これを書物にしるして記念とし、それをヨシュアの耳に入れなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 17:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.17.p5.b16": {
    "text": "モーセは一つの祭壇を築いてその名を「主はわが旗」と呼んだ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 17:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.17.p5.b17": {
    "text": "主は世々アマレクと戦われる",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Exodus 17:16"
    },
    "adapted": false,
    "status": "approved"
  }
}
