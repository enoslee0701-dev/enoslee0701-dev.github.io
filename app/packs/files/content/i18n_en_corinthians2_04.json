{
  "corinthians2.4.p1.b1": {
    "text": "Therefore, since God in His mercy has given us this ministry, we do not lose heart.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Corinthians 4:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "corinthians2.4.p1.b2": {
    "text": "For we do not proclaim ourselves, but Jesus Christ as Lord, and ourselves as your servants for Jesus’ sake.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Corinthians 4:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "corinthians2.4.p1.b3": {
    "text": "For God, who said, “Let light shine out of darkness,” made His light shine in our hearts",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Corinthians 4:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "corinthians2.4.p2.b1": {
    "text": "Now we have this treasure in jars of clay",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Corinthians 4:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "corinthians2.4.p2.b2": {
    "text": "to show that this surpassingly great power is from God and not from us.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Corinthians 4:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "corinthians2.4.p3.b1": {
    "text": "We are hard pressed on all sides, but not crushed;",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Corinthians 4:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "corinthians2.4.p3.b2": {
    "text": "perplexed, but not in despair;",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Corinthians 4:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "corinthians2.4.p3.b3": {
    "text": "persecuted, but not forsaken;",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Corinthians 4:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "corinthians2.4.p3.b4": {
    "text": "struck down, but not destroyed.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Corinthians 4:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "corinthians2.4.p4.b1": {
    "text": "… we who have the same spirit of faith also believe and therefore speak,",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Corinthians 4:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "corinthians2.4.p4.b2": {
    "text": "… and present us with you in His presence.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Corinthians 4:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "corinthians2.4.p4.b3": {
    "text": "… so that the grace that is extending to more and more people may overflow in thanksgiving, to the glory of God.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Corinthians 4:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "corinthians2.4.p5.b1": {
    "text": "Therefore we do not lose heart.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Corinthians 4:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "corinthians2.4.p5.b2": {
    "text": "Though our outer self is wasting away, yet our inner self is being renewed day by day.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Corinthians 4:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "corinthians2.4.p5.b3": {
    "text": "For what is seen is temporary, but what is unseen is eternal.",
    "kind": "scripture",
    "source": {
      "version": "engbsb",
      "ref": "2 Corinthians 4:18"
    },
    "adapted": false,
    "status": "approved"
  }
}
