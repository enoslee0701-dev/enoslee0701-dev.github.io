{
  "micah.2.p1.b1": {
    "text": "その床の上で不義を計り、悪を行う者はわざわいである。彼らはその手に力あるゆえ、夜が明けるとこれを行う。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 2:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.2.p1.b2": {
    "text": "彼らは田畑をむさぼってこれを奪い、家をむさぼってこれを取る。彼らは人をしえたげてその家を奪い、人をしえたげてその嗣業を奪う。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 2:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.2.p1.b3": {
    "text": "見よ、わたしはこのやからにむかって災を下そうと計る。あなたがたはその首をこれから、はずすことはできない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 2:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.2.p1.b4": {
    "text": "彼らは言う、「あなたがたは説教してはならない。」",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 2:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.2.p1.b5": {
    "text": "わたしはぶどう酒と濃き酒とについて、あなたに説教しよう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 2:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.2.p1.b6": {
    "text": "わが民の女たちをその楽しい家から追い出し、その子どもから、わが栄えをとこしえに奪う。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 2:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.2.p1.b7": {
    "text": "ヤコブよ、わたしは必ずあなたをことごとく集め、イスラエルの残れる者を集める。……わたしはこれをおりの羊のように",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 2:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "micah.2.p1.b8": {
    "text": "打ち破る者は彼らに先だって登りゆき……彼らの王はその前に進み、主はその先頭に立たれる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Micah 2:13"
    },
    "adapted": false,
    "status": "approved"
  }
}
