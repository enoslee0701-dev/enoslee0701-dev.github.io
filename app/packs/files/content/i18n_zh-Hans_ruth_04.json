{
  "ruth.4.p1.b1": {
    "text": "波阿斯到了城门，坐在那里，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ruth 4:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "波阿斯到⁠了城⁠门，坐⁠在那⁠里，"
  },
  "ruth.4.p1.b2": {
    "text": "恰巧波阿斯所说的那至近的亲属经过。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ruth 4:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "恰⁠巧波阿斯所说⁠的那至⁠近的亲⁠属经⁠过。"
  },
  "ruth.4.p1.b3": {
    "text": "某人哪，你来坐在这里。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ruth 4:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "某⁠人哪，你⁠来坐⁠在这⁠里。"
  },
  "ruth.4.p1.b4": {
    "text": "请你们坐在这里。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ruth 4:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "请你⁠们坐⁠在这⁠里。"
  },
  "ruth.4.p2.b1": {
    "text": "从摩押地回来的拿俄米，现在要卖我们族兄以利米勒的那块地；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ruth 4:3"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "从摩押地回⁠来的拿俄米，现⁠在要卖我⁠们族⁠兄以利米⁠勒的那块地；"
  },
  "ruth.4.p2.b2": {
    "text": "我肯赎。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ruth 4:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "ruth.4.p2.b3": {
    "text": "你从拿俄米手中买这地的时候，也当娶死人的妻摩押女子路得，使死人在产业上存留他的名。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ruth 4:5"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你从拿俄米手⁠中买这地的时⁠候，也当娶死⁠人的妻摩押女⁠子路得，使死⁠人在产⁠业上存⁠留他⁠的名。"
  },
  "ruth.4.p2.b4": {
    "text": "这样我就不能赎了，恐怕于我的产业有碍。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ruth 4:6"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "这⁠样我就⁠不⁠能赎了，恐⁠怕于我⁠的产⁠业有碍。"
  },
  "ruth.4.p3.b1": {
    "text": "从前，在以色列中要定夺什么事，或赎回，或交易，这人就脱鞋给那人。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ruth 4:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "从⁠前，在以⁠色⁠列中要定夺什⁠么事，或赎⁠回，或交⁠易，这人就脱鞋给那人。"
  },
  "ruth.4.p3.b2": {
    "text": "你自己买吧！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ruth 4:8"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你自⁠己买吧！"
  },
  "ruth.4.p3.b3": {
    "text": "你们今日作见证，凡属以利米勒和基连、玛伦的，我都从拿俄米手中置买了；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ruth 4:9"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们今⁠日作见⁠证，凡属以利米⁠勒和基连、玛伦的，我都从拿俄米手⁠中置买了；"
  },
  "ruth.4.p3.b4": {
    "text": "又娶了玛伦的妻摩押女子路得为妻……你们今日可以作见证。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ruth 4:10"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "又娶⁠了玛伦的妻摩押女⁠子路得为妻……你⁠们今⁠日可⁠以作见⁠证。"
  },
  "ruth.4.p4.b1": {
    "text": "我们作见证。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ruth 4:11"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我⁠们作见⁠证。"
  },
  "ruth.4.p4.b2": {
    "text": "愿耶和华使进你家的这女子，像建立以色列家的拉结、利亚二人一样。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ruth 4:11"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "愿耶⁠和⁠华使进你家的这女⁠子，像建⁠立以⁠色⁠列家的拉结、利⁠亚二⁠人一⁠样。"
  },
  "ruth.4.p4.b3": {
    "text": "愿耶和华从这少年女子赐你后裔，使你的家像她玛从犹大所生法勒斯的家一般。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ruth 4:12"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "愿耶⁠和⁠华从这少⁠年女⁠子赐你后⁠裔，使你⁠的家像她玛从犹⁠大所⁠生法勒斯的家一⁠般。"
  },
  "ruth.4.p5.b1": {
    "text": "于是，波阿斯娶了路得为妻……",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ruth 4:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "于⁠是，波阿斯娶⁠了路得为妻……"
  },
  "ruth.4.p5.b2": {
    "text": "耶和华使她怀孕生了一个儿子。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ruth 4:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠和⁠华使她怀⁠孕生了一⁠个儿⁠子。"
  },
  "ruth.4.p6.b1": {
    "text": "耶和华是应当称颂的！因为今日没有撇下你，使你无至近的亲属。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ruth 4:14"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠和⁠华是应⁠当称⁠颂的！因⁠为今⁠日没⁠有撇⁠下你，使你无至⁠近的亲⁠属。"
  },
  "ruth.4.p6.b2": {
    "text": "……有这儿妇比有七个儿子还好！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ruth 4:15"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "……有这⁠儿妇比有七⁠个儿⁠子还⁠好！"
  },
  "ruth.4.p6.b3": {
    "text": "拿俄米就把孩子抱在怀中，作他的养母。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ruth 4:16"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "拿俄米就⁠把孩⁠子抱⁠在怀中，作他⁠的养⁠母。"
  },
  "ruth.4.p7.b1": {
    "text": "拿俄米得孩子了！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ruth 4:17"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "拿俄米得孩⁠子了！"
  },
  "ruth.4.p7.b2": {
    "text": "就给孩子起名叫俄备得。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ruth 4:17"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "就给孩⁠子起名⁠叫俄备得。"
  },
  "ruth.4.p7.b3": {
    "text": "这俄备得是耶西的父，耶西是大卫的父。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ruth 4:17"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "这俄备得是耶西的父，耶西是大⁠卫的父。"
  },
  "ruth.4.p8.b1": {
    "text": "法勒斯的后代记在下面：法勒斯生希斯仑；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ruth 4:18"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "法勒斯的后⁠代记在下⁠面：法勒斯生希斯仑；"
  },
  "ruth.4.p8.b2": {
    "text": "……波阿斯生俄备得；俄备得生耶西；耶西生大卫。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Ruth 4:21-22"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "……波阿斯生俄备得；俄备得生耶西；耶西生大⁠卫。"
  }
}
