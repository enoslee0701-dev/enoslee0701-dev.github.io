{
  "ezekiel.29.p1.b1": {
    "text": "人の子よ、あなたの顔をエジプトの王パロに向け、彼とエジプト全国に対して預言し",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 29:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.29.p1.b2": {
    "text": "エジプトの王パロよ、見よ、わたしはあなたの敵となる。あなたはその川の中に伏す大いなる龍で、『ナイル川はわたしのもの、わたしがこれを造った』と言う。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 29:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.29.p1.b3": {
    "text": "わたしは、かぎをあなたのあごにかけ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 29:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.29.p1.b4": {
    "text": "あなたとあなたの川のもろもろの魚を、荒野に投げ捨てる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 29:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.29.p1.b5": {
    "text": "彼らがまたあなたに寄りかかる時、あなたは破れ、彼らの腰をことごとく震えさせる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 29:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.29.p1.b6": {
    "text": "人の足はこれを渡らず、獣の足もこれを渡らない。四十年の間、ここに住む者はない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 29:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.29.p2.b1": {
    "text": "これはもろもろの国よりも卑しくなり、再びもろもろの国民の上に出ることができない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 29:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.29.p2.b2": {
    "text": "バビロンの王ネブカデレザルは、その軍勢をツロに対して大いに働かせた。頭は皆はげ、肩はみな破れた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 29:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.29.p2.b3": {
    "text": "彼の働いた報酬として、わたしはエジプトの地を彼に与える。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 29:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "ezekiel.29.p2.b4": {
    "text": "その日、わたしはイスラエルの家に、一つの角を生じさせ、あなたの口を彼らのうちに開かせる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Ezekiel 29:21"
    },
    "adapted": false,
    "status": "approved"
  }
}
