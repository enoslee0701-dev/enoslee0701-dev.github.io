{
  "matthew.22.p1.b1": {
    "text": "イエスはまた、譬で彼らに語って言われた、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p1.b2": {
    "text": "「天国は、ひとりの王がその王子のために、婚宴を催すようなものである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p1.b3": {
    "text": "その僕たちをつかわして、この婚宴に招かれていた人たちを呼ばせた",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p1.b4": {
    "text": "その人たちはこようとはしなかった",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p2.b1": {
    "text": "招かれた人たちに言いなさい。食事の用意ができました。牛も肥えた獣もほふられて、すべての用意ができました。さあ、婚宴においでください",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p2.b2": {
    "text": "しかし、彼らは知らぬ顔をして、ひとりは自分の畑に、ひとりは自分の商売に出て行き、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p3.b1": {
    "text": "またほかの人々は、この僕たちをつかまえて侮辱を加えた上、殺してしまった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p3.b2": {
    "text": "王は立腹し",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p3.b3": {
    "text": "軍隊を送ってそれらの人殺しどもを滅ぼし、その町を焼き払った",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p4.b1": {
    "text": "婚宴の用意はできているが、招かれていたのは、ふさわしくない人々であった",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p4.b2": {
    "text": "だから、町の大通りに出て行って、出会った人はだれでも婚宴に連れてきなさい』。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p4.b3": {
    "text": "僕たちは道に出て行って、出会う人は、悪人でも善人でもみな集めてきた",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p4.b4": {
    "text": "婚宴の席は客でいっぱいになった",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p5.b1": {
    "text": "王は客を迎えようとしてはいってきた",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p5.b2": {
    "text": "そこに礼服をつけていないひとりの人を見て",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p5.b3": {
    "text": "友よ、どうしてあなたは礼服をつけないで、ここにはいってきたのですか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p5.b4": {
    "text": "彼は黙っていた",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p6.b1": {
    "text": "この者の手足をしばって、外の暗やみにほうり出せ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p6.b2": {
    "text": "そこで泣き叫んだり、歯がみをしたりするであろう",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p6.b3": {
    "text": "招かれる者は多いが、選ばれる者は少ない」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p7.b1": {
    "text": "そのときパリサイ人たちがきて、どうかしてイエスを言葉のわなにかけようと、相談をした。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p7.b2": {
    "text": "彼らの弟子を、ヘロデ党の者たちと共に、イエスのもとにつかわして",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p7.b3": {
    "text": "先生、わたしたちはあなたが真実なかたであって、真理に基いて神の道を教え",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p7.b4": {
    "text": "それで、あなたはどう思われますか、答えてください。カイザルに税金を納めてよいでしょうか、いけないでしょうか」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p8.b1": {
    "text": "偽善者たちよ、なぜわたしをためそうとするのか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p8.b2": {
    "text": "税に納める貨幣を見せなさい",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p8.b3": {
    "text": "彼らはデナリ一つを持ってきた",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p8.b4": {
    "text": "これは、だれの肖像、だれの記号か",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p9.b1": {
    "text": "カイザルのです",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p9.b2": {
    "text": "するとイエスは言われた",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p9.b3": {
    "text": "カイザルのものはカイザルに、神のものは神に返しなさい",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:21"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p9.b4": {
    "text": "彼らはこれを聞いて驚嘆し、イエスを残して立ち去った。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p10.b1": {
    "text": "復活ということはないと主張していたサドカイ人たちが、その日、イエスのもとにきて質問した、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:23"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p10.b2": {
    "text": "先生、モーセはこう言っています、『もし、ある人が子がなくて死んだなら、その弟は兄の妻をめとって、兄のために子をもうけねばならない』",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p10.b3": {
    "text": "わたしたちのところに七人の兄弟がありました。…次男も三男も、ついに七人とも同じことになりました",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:25-26"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p10.b4": {
    "text": "この女は、七人のうちだれの妻なのでしょうか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p11.b1": {
    "text": "あなたがたは聖書も神の力も知らないから、思い違いをしている",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p11.b2": {
    "text": "復活の時には、彼らはめとったり、とついだりすることはない。彼らは天にいる御使のようなものである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:30"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p12.b1": {
    "text": "また、死人の復活については、神があなたがたに言われた言葉を読んだことがないのか。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:31"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p12.b2": {
    "text": "わたしはアブラハムの神、イサクの神、ヤコブの神である",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p12.b3": {
    "text": "神は死んだ者の神ではなく、生きている者の神である",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:32"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p12.b4": {
    "text": "群衆はこれを聞いて、イエスの教に驚いた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:33"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p13.b1": {
    "text": "さて、パリサイ人たちは、イエスがサドカイ人たちを言いこめられたと聞いて、一緒に集まった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:34"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p13.b2": {
    "text": "そして彼らの中のひとりの律法学者が、イエスをためそうとして質問した、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:35"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p13.b3": {
    "text": "「先生、律法の中で、どのいましめがいちばん大切なのですか」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:36"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p14.b1": {
    "text": "心をつくし、精神をつくし、思いをつくして、主なるあなたの神を愛せよ",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:37"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p14.b2": {
    "text": "これがいちばん大切な、第一のいましめである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:38"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p14.b3": {
    "text": "第二もこれと同様である、『自分を愛するようにあなたの隣り人を愛せよ』。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:39"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p14.b4": {
    "text": "これらの二つのいましめに、律法全体と預言者とが、かかっている」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:40"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p15.b1": {
    "text": "パリサイ人たちが集まっていたとき、イエスは彼らにお尋ねになった、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:41"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p15.b2": {
    "text": "あなたがたはキリストをどう思うか。だれの子なのか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:42"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p15.b3": {
    "text": "ダビデの子です",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:42"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p16.b1": {
    "text": "それではどうして、ダビデが御霊に感じてキリストを主と呼んでいるのか",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:43"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p16.b2": {
    "text": "すなわち『主はわが主に仰せになった、あなたの敵をあなたの足もとに置くときまでは、わたしの右に座していなさい』。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:44"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p16.b3": {
    "text": "このように、ダビデ自身がキリストを主と呼んでいるなら、キリストはどうしてダビデの子であろうか」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:45"
    },
    "adapted": false,
    "status": "approved"
  },
  "matthew.22.p16.b4": {
    "text": "イエスにひと言でも答えうる者は、なかったし、その日からもはや、進んでイエスに質問する者も、いなくなった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Matthew 22:46"
    },
    "adapted": false,
    "status": "approved"
  }
}
