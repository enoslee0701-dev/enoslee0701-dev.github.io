{
  "mark.10.p1.b1": {
    "text": "耶稣从那里起身，来到犹太的境界并约旦河外。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣从那⁠里起⁠身，来⁠到犹⁠太的境⁠界并约⁠旦⁠河外。"
  },
  "mark.10.p1.b2": {
    "text": "众人又聚集到他那里，他又照常教训他们。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:1"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "众⁠人又聚⁠集到他那⁠里，他又照⁠常教⁠训他⁠们。"
  },
  "mark.10.p1.b3": {
    "text": "人休妻可以不可以？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "人休妻可⁠以不可⁠以？"
  },
  "mark.10.p1.b4": {
    "text": "意思要试探他。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:2"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "意⁠思要试⁠探他。"
  },
  "mark.10.p2.b1": {
    "text": "摩西吩咐你们的是什么？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:3"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "摩⁠西吩⁠咐你⁠们的⁠是什⁠么？"
  },
  "mark.10.p2.b2": {
    "text": "摩西许人写了休书便可以休妻。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:4"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "摩⁠西许人写了休书便可⁠以休妻。"
  },
  "mark.10.p2.b3": {
    "text": "摩西因为你们的心硬，所以写这条例给你们；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:5"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "摩⁠西因⁠为你⁠们的心硬，所⁠以写这条⁠例给你⁠们；"
  },
  "mark.10.p3.b1": {
    "text": "但从起初创造的时候，神造人是造男造女。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:6"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "但⁠从起⁠初创⁠造的时⁠候，神造人是造男造女。"
  },
  "mark.10.p3.b2": {
    "text": "因此，人要离开父母，与妻子连合，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "因⁠此，人要离⁠开父⁠母，与妻⁠子连合，"
  },
  "mark.10.p3.b3": {
    "text": "二人成为一体。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:7"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "二⁠人成⁠为一⁠体。"
  },
  "mark.10.p3.b4": {
    "text": "所以，神配合的，人不可分开。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:9"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "所⁠以，神配⁠合的，人不⁠可分⁠开。"
  },
  "mark.10.p4.b1": {
    "text": "到了屋里，门徒就问他这事。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:10"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "到⁠了屋里，门⁠徒就⁠问他这事。"
  },
  "mark.10.p4.b2": {
    "text": "凡休妻另娶的，就是犯奸淫，辜负他的妻子；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:11"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "凡休妻另娶的，就⁠是犯奸⁠淫，辜⁠负他⁠的妻⁠子；"
  },
  "mark.10.p4.b3": {
    "text": "妻子若离弃丈夫另嫁，也是犯奸淫了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:12"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "妻⁠子若离⁠弃丈⁠夫另嫁，也⁠是犯奸⁠淫了。"
  },
  "mark.10.p5.b1": {
    "text": "有人带着小孩子来见耶稣，要耶稣摸他们，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有⁠人带着小⁠孩⁠子来⁠见耶⁠稣，要耶⁠稣摸他⁠们，"
  },
  "mark.10.p5.b2": {
    "text": "门徒便责备那些人。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:13"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "门⁠徒便责⁠备那⁠些人。"
  },
  "mark.10.p5.b3": {
    "text": "让小孩子到我这里来，不要禁止他们；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:14"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "让小⁠孩⁠子到我这⁠里来，不⁠要禁⁠止他⁠们；"
  },
  "mark.10.p5.b4": {
    "text": "因为在神国的，正是这样的人。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:14"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "因⁠为在神⁠国的，正⁠是这⁠样的人。"
  },
  "mark.10.p6.b1": {
    "text": "我实在告诉你们，凡要承受神国的，若不像小孩子，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:15"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我实⁠在告⁠诉你⁠们，凡要承⁠受神⁠国的，若不⁠像小⁠孩⁠子，"
  },
  "mark.10.p6.b2": {
    "text": "断不能进去。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:15"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "断不⁠能进⁠去。"
  },
  "mark.10.p6.b3": {
    "text": "于是抱着小孩子，给他们按手，为他们祝福。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:16"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "于⁠是抱着小⁠孩⁠子，给他⁠们按手，为他⁠们祝⁠福。"
  },
  "mark.10.p7.b1": {
    "text": "耶稣出来行路的时候，有一个人跑来，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:17"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣出⁠来行⁠路的时⁠候，有⁠一个⁠人跑来，"
  },
  "mark.10.p7.b2": {
    "text": "良善的夫子，我当做什么事才可以承受永生？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:17"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "良⁠善的夫⁠子，我当⁠做什⁠么事才⁠可⁠以承⁠受永⁠生？"
  },
  "mark.10.p7.b3": {
    "text": "你为什么称我是良善的？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:18"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你为⁠什⁠么称我⁠是良⁠善的？"
  },
  "mark.10.p7.b4": {
    "text": "除了神一位之外，再没有良善的。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:18"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "除⁠了神一⁠位之⁠外，再没⁠有良⁠善的。"
  },
  "mark.10.p8.b1": {
    "text": "诫命你是晓得的：不可杀人；不可奸淫；不可偷盗；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:19"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "诫命你⁠是晓⁠得的：不⁠可杀⁠人；不⁠可奸⁠淫；不⁠可偷⁠盗；"
  },
  "mark.10.p8.b2": {
    "text": "不可作假见证；不可亏负人；当孝敬父母。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:19"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "不⁠可作⁠假见⁠证；不⁠可亏⁠负人；当孝⁠敬父⁠母。"
  },
  "mark.10.p8.b3": {
    "text": "夫子，这一切我从小都遵守了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:20"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "夫⁠子，这一⁠切我从⁠小都遵⁠守了。"
  },
  "mark.10.p9.b1": {
    "text": "耶稣看着他，就爱他，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:21"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣看着他，就⁠爱他，"
  },
  "mark.10.p9.b2": {
    "text": "你还缺少一件：去变卖你所有的，分给穷人，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:21"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你还缺⁠少一⁠件：去变⁠卖你所⁠有的，分给穷⁠人，"
  },
  "mark.10.p9.b3": {
    "text": "就必有财宝在天上；你还要来跟从我。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:21"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "就必⁠有财⁠宝在天⁠上；你还要来跟从我。"
  },
  "mark.10.p9.b4": {
    "text": "忧忧愁愁地走了，因为他的产业很多。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:22"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "忧忧⁠愁愁地走⁠了，因⁠为他⁠的产⁠业很⁠多。"
  },
  "mark.10.p10.b1": {
    "text": "有钱财的人进神的国是何等地难哪！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:23"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有钱⁠财的人进神⁠的国是何等⁠地难哪！"
  },
  "mark.10.p10.b2": {
    "text": "门徒希奇他的话。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:24"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "门⁠徒希⁠奇他的⁠话。"
  },
  "mark.10.p10.b3": {
    "text": "小子，倚靠钱财的人进神的国是何等地难哪！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:24"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "小⁠子，倚⁠靠钱⁠财的人进神⁠的国是何等⁠地难哪！"
  },
  "mark.10.p10.b4": {
    "text": "骆驼穿过针的眼，比财主进神的国还容易呢。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:25"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "骆⁠驼穿⁠过针的眼，比财⁠主进神⁠的国还容⁠易呢。"
  },
  "mark.10.p11.b1": {
    "text": "门徒就分外希奇，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:26"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "门⁠徒就分⁠外希⁠奇，"
  },
  "mark.10.p11.b2": {
    "text": "这样谁能得救呢？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:26"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "这⁠样谁⁠能得⁠救呢？"
  },
  "mark.10.p11.b3": {
    "text": "在人是不能，在神却不然，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:27"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "在人是不⁠能，在神却不⁠然，"
  },
  "mark.10.p11.b4": {
    "text": "因为神凡事都能。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:27"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "因⁠为神凡⁠事都⁠能。"
  },
  "mark.10.p12.b1": {
    "text": "看哪，我们已经撇下所有的跟从你了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:28"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "看哪，我⁠们已⁠经撇⁠下所⁠有的跟从你了。"
  },
  "mark.10.p12.b2": {
    "text": "我实在告诉你们，人为我和福音撇下房屋，或是弟兄、姊妹、父母、儿女、田地，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:29"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我实⁠在告⁠诉你⁠们，人为⁠我和福⁠音撇⁠下房⁠屋，或⁠是弟⁠兄、姊⁠妹、父⁠母、儿⁠女、田⁠地，"
  },
  "mark.10.p12.b3": {
    "text": "没有不在今世得百倍的，……并且要受逼迫，在来世必得永生。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:30"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "没⁠有不⁠在今⁠世得百⁠倍的，……并⁠且要受逼⁠迫，在来⁠世必⁠得永⁠生。"
  },
  "mark.10.p12.b4": {
    "text": "然而，有许多在前的，将要在后，在后的，将要在前。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:31"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "然⁠而，有许⁠多在前的，将⁠要在后，在后的，将⁠要在前。"
  },
  "mark.10.p13.b1": {
    "text": "他们行路上耶路撒冷去。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:32"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠们行路⁠上耶⁠路撒⁠冷去。"
  },
  "mark.10.p13.b2": {
    "text": "耶稣在前头走，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:32"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "耶⁠稣在前⁠头走，"
  },
  "mark.10.p13.b3": {
    "text": "门徒就希奇，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:32"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "门⁠徒就希⁠奇，"
  },
  "mark.10.p13.b4": {
    "text": "跟从的人也害怕。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:32"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "跟从的人也害⁠怕。"
  },
  "mark.10.p14.b1": {
    "text": "看哪，我们上耶路撒冷去，人子将要被交给祭司长和文士，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:33"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "看哪，我⁠们上耶⁠路撒⁠冷去，人⁠子将⁠要被交⁠给祭⁠司⁠长和文⁠士，"
  },
  "mark.10.p14.b2": {
    "text": "他们要定他死罪，交给外邦人。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:33"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠们要定他死⁠罪，交⁠给外⁠邦⁠人。"
  },
  "mark.10.p14.b3": {
    "text": "他们要戏弄他，吐唾沫在他脸上，鞭打他，杀害他。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:34"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "他⁠们要戏⁠弄他，吐⁠唾⁠沫在他脸上，鞭⁠打他，杀⁠害他。"
  },
  "mark.10.p14.b4": {
    "text": "过了三天，他要复活。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:34"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "过了三⁠天，他⁠要复⁠活。"
  },
  "mark.10.p15.b1": {
    "text": "夫子，我们无论求你什么，愿你给我们做。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:35"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "夫⁠子，我⁠们无⁠论求你什⁠么，愿你给我⁠们做。"
  },
  "mark.10.p15.b2": {
    "text": "要我给你们做什么？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:36"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "要我给你⁠们做什⁠么？"
  },
  "mark.10.p15.b3": {
    "text": "赐我们在你的荣耀里，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:37"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "赐我⁠们在你⁠的荣⁠耀里，"
  },
  "mark.10.p15.b4": {
    "text": "一个坐在你右边，一个坐在你左边。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:37"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "一⁠个坐⁠在你右⁠边，一⁠个坐⁠在你左⁠边。"
  },
  "mark.10.p16.b1": {
    "text": "你们不知道所求的是什么。我所喝的杯，你们能喝吗？我所受的洗，你们能受吗？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:38"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们不⁠知⁠道所求的⁠是什⁠么。我所喝的杯，你⁠们能喝吗？我所受的洗，你⁠们能受吗？"
  },
  "mark.10.p16.b2": {
    "text": "我们能。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:39"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我⁠们能。"
  },
  "mark.10.p16.b3": {
    "text": "我所喝的杯，你们也要喝；我所受的洗，你们也要受；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:39"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "我所喝的杯，你⁠们也⁠要喝；我所受的洗，你⁠们也⁠要受；"
  },
  "mark.10.p16.b4": {
    "text": "只是坐在我的左右，不是我可以赐的，乃是为谁预备的，就赐给谁。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:40"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "只⁠是坐⁠在我⁠的左⁠右，不⁠是我可⁠以赐的，乃⁠是为谁预⁠备的，就赐⁠给谁。"
  },
  "mark.10.p17.b1": {
    "text": "那十个门徒听见，就恼怒雅各、约翰。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:41"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "那十个门⁠徒听⁠见，就恼⁠怒雅⁠各、约⁠翰。"
  },
  "mark.10.p17.b2": {
    "text": "你们知道，外邦人有尊为君王的，治理他们，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:42"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们知⁠道，外⁠邦⁠人有尊⁠为君⁠王的，治⁠理他⁠们，"
  },
  "mark.10.p17.b3": {
    "text": "有大臣操权管束他们。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:42"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有大⁠臣操权管⁠束他⁠们。"
  },
  "mark.10.p18.b1": {
    "text": "只是在你们中间，不是这样。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:43"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "只⁠是在你⁠们中⁠间，不⁠是这⁠样。"
  },
  "mark.10.p18.b2": {
    "text": "你们中间，谁愿为大，就必作你们的用人；",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:43"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你⁠们中⁠间，谁愿为大，就必作你⁠们的用⁠人；"
  },
  "mark.10.p18.b3": {
    "text": "因为人子来，并不是要受人的服事，乃是要服事人，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:45"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "因⁠为人⁠子来，并⁠不是要受人⁠的服事，乃⁠是要服事人，"
  },
  "mark.10.p18.b4": {
    "text": "并且要舍命作多人的赎价。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:45"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "并⁠且要舍⁠命作多人⁠的赎价。"
  },
  "mark.10.p19.b1": {
    "text": "到了耶利哥；耶稣同门徒并许多人出耶利哥的时候，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:46"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "到⁠了耶⁠利⁠哥；耶⁠稣同门⁠徒并许⁠多人出耶⁠利⁠哥的时⁠候，"
  },
  "mark.10.p19.b2": {
    "text": "有一个讨饭的瞎子，是底买的儿子巴底买，坐在路旁。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:46"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有一⁠个讨⁠饭的瞎⁠子，是底⁠买的儿⁠子巴⁠底⁠买，坐⁠在路旁。"
  },
  "mark.10.p19.b3": {
    "text": "大卫的子孙耶稣啊！可怜我吧！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:47"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "大⁠卫的子⁠孙耶⁠稣啊！可⁠怜我吧！"
  },
  "mark.10.p20.b1": {
    "text": "有许多人责备他，不许他作声。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:48"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "有许⁠多人责⁠备他，不⁠许他作声。"
  },
  "mark.10.p20.b2": {
    "text": "大卫的子孙哪，可怜我吧！",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:48"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "大⁠卫的子⁠孙哪，可⁠怜我吧！"
  },
  "mark.10.p20.b3": {
    "text": "叫过他来。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:49"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "叫⁠过他来。"
  },
  "mark.10.p20.b4": {
    "text": "放心，起来！他叫你啦。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:49"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "放⁠心，起⁠来！他叫你啦。"
  },
  "mark.10.p21.b1": {
    "text": "瞎子就丢下衣服，跳起来，走到耶稣那里。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:50"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "瞎⁠子就丢⁠下衣⁠服，跳⁠起⁠来，走⁠到耶⁠稣那⁠里。"
  },
  "mark.10.p21.b2": {
    "text": "要我为你做什么？",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:51"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "要我为你做什⁠么？"
  },
  "mark.10.p21.b3": {
    "text": "拉波尼，我要能看见。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:51"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "拉⁠波⁠尼，我⁠要能看⁠见。"
  },
  "mark.10.p22.b1": {
    "text": "你去吧！你的信救了你了。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:52"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "你去吧！你⁠的信救了你了。"
  },
  "mark.10.p22.b2": {
    "text": "瞎子立刻看见了，",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:52"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "瞎⁠子立⁠刻看⁠见了，"
  },
  "mark.10.p22.b3": {
    "text": "就在路上跟随耶稣。",
    "kind": "scripture",
    "source": {
      "version": "cmn-cu89s",
      "ref": "Mark 10:52"
    },
    "adapted": false,
    "status": "approved",
    "wrap": "就⁠在路⁠上跟⁠随耶⁠稣。"
  }
}
