{
  "philippians.2.p1.b1": {
    "text": "そこで、あなたがたに、キリストによる勧め、愛の励まし、御霊の交わり、熱愛とあわれみとが、いくらかでもあるなら、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 2:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.2.p1.b2": {
    "text": "どうか同じ思いとなり、同じ愛の心を持ち、心を合わせ、一つ思いになって、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 2:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.2.p1.b3": {
    "text": "… わたしの喜びを満たしてほしい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 2:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.2.p2.b1": {
    "text": "何事も党派心や虚栄からするのでなく、へりくだった心をもって互に人を自分よりすぐれた者としなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 2:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.2.p2.b2": {
    "text": "おのおの、自分のことばかりでなく、他人のことも考えなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 2:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.2.p3.b1": {
    "text": "キリスト・イエスにあっていだいているのと同じ思いを、あなたがたの間でも互に生かしなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 2:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.2.p3.b2": {
    "text": "キリストは、神のかたちであられたが、神と等しくあることを固守すべき事とは思わず、 かえって、おのれをむなしうして僕のかたちをとり、人間の姿になられた。その有様は人と異ならず、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 2:6-7"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.2.p3.b3": {
    "text": "おのれを低くして、死に至るまで、しかも十字架の死に至るまで従順であられた。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 2:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.2.p4.b1": {
    "text": "それゆえに、神は彼を高く引き上げ、すべての名にまさる名を彼に賜わった。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 2:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.2.p4.b2": {
    "text": "それは、イエスの御名によって、天上のもの、地上のもの、地下のものなど、あらゆるものがひざをかがめ、",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 2:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.2.p4.b3": {
    "text": "また、あらゆる舌が、「イエス・キリストは主である」と告白して、栄光を父なる神に帰するためである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 2:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.2.p5.b1": {
    "text": "… 恐れおののいて自分の救の達成に努めなさい。 あなたがたのうちに働きかけて、その願いを起させ、かつ実現に至らせるのは神であって、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 2:12-13"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.2.p5.b2": {
    "text": "すべてのことを、つぶやかず疑わないでしなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 2:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.2.p5.b3": {
    "text": "… 彼らの間で星のようにこの世に輝いている。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 2:15"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.2.p6.b1": {
    "text": "そして、たとい、あなたがたの信仰の供え物をささげる祭壇に、わたしの血をそそぐことがあっても、わたしは喜ぼう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 2:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.2.p6.b2": {
    "text": "… あなたがた一同と共に喜ぼう。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 2:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.2.p6.b3": {
    "text": "同じように、あなたがたも喜びなさい。わたしと共に喜びなさい。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 2:18"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.2.p7.b1": {
    "text": "さて、わたしは、まもなくテモテをあなたがたのところに送りたいと、主イエスにあって願っている。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 2:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.2.p7.b2": {
    "text": "テモテのような心で、親身になってあなたがたのことを心配している者は、ほかにひとりもない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 2:20"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.2.p7.b3": {
    "text": "… 子が父に対するようにして、わたしと一緒に福音に仕えてきたのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 2:22"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.2.p7.b4": {
    "text": "わたし自身もまもなく行けるものと、主にあって確信している。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 2:24"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.2.p8.b1": {
    "text": "しかし、さしあたり、わたしの同労者で戦友である兄弟、… エパフロデトを、あなたがたのもとに送り返すことが必要だと思っている。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 2:25"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.2.p8.b2": {
    "text": "彼は、あなたがた一同にしきりに会いたがっているからである。その上、自分の病気のことがあなたがたに聞えたので、彼は心苦しく思っている。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 2:26"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.2.p8.b3": {
    "text": "彼は実に、ひん死の病気にかかったが、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 2:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.2.p8.b4": {
    "text": "… 神は彼をあわれんで下さった。彼ばかりではなく、わたしをもあわれんで下さったので、わたしは悲しみに悲しみを重ねないですんだのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 2:27"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.2.p9.b1": {
    "text": "そこで、大急ぎで彼を送り返す。これで、あなたがたは彼と再び会って喜び、…",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 2:28"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.2.p9.b2": {
    "text": "こういうわけだから、大いに喜んで、主にあって彼を迎えてほしい。また、こうした人々は尊重せねばならない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 2:29"
    },
    "adapted": false,
    "status": "approved"
  },
  "philippians.2.p9.b3": {
    "text": "… キリストのわざのために命をかけ、死ぬばかりになったのである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Philippians 2:30"
    },
    "adapted": false,
    "status": "approved"
  }
}
