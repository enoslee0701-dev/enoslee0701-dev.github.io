{
  "zephaniah.3.p1.b1": {
    "text": "わざわいなるかな、このそむき汚れた暴虐の町。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 3:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.3.p1.b2": {
    "text": "これはだれの声にも耳を傾けず、懲しめを受けいれず、主に寄り頼まず、おのれの神に近よらない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 3:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.3.p1.b3": {
    "text": "その中にいるつかさたちは、ほえるしし、そのさばきびとたちは、夜のおおかみで、彼らは朝まで何一つ残さない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 3:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.3.p1.b4": {
    "text": "その預言者たちは、放縦で偽りびと、その祭司たちは聖なる物を汚し、律法を破る。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 3:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.3.p1.b5": {
    "text": "その中にいます主は義であって、不義を行われない。朝ごとにその公義を現して、誤ることがない",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 3:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.3.p1.b6": {
    "text": "しかし不義な者は恥を知らない。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 3:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.3.p1.b7": {
    "text": "わたしは諸国民を滅ぼした。そのやぐらは荒れはてた。わたしはそのちまたを荒したので、ちまたを行き来する者もない",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 3:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.3.p1.b8": {
    "text": "わたしは言った、『これは必ずわたしを恐れ、懲しめを受ける。これはわたしが命じたすべての事を見失わない』と……しかし彼らはしきりに自分の行状を乱した",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 3:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.3.p1.b9": {
    "text": "それゆえ、あなたがたは、わたしが立って、証言する日を待て",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 3:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.3.p1.b10": {
    "text": "……全地は、ねたむわたしの怒りの火に焼き滅ぼされるからである。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 3:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.3.p2.b1": {
    "text": "その時わたしはもろもろの民に清きくちびるを与え、すべて彼らに主の名を呼ばせ、心を一つにして主に仕えさせる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 3:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.3.p2.b2": {
    "text": "わたしを拝む者、わたしが散らした者の娘はエチオピヤの川々の向こうから来て、わたしに供え物をささげる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 3:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.3.p2.b3": {
    "text": "わたしは柔和にしてへりくだる民を、あなたのうちに残す。彼らは主の名を避け所とする。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 3:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.3.p2.b4": {
    "text": "……それゆえ、彼らは食を得て伏し、彼らをおびやかす者はいない",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 3:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.3.p2.b5": {
    "text": "シオンの娘よ、喜び歌え。イスラエルよ、喜び呼ばわれ。エルサレムの娘よ、心のかぎり喜び楽しめ。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 3:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.3.p2.b6": {
    "text": "あなたの神、主はあなたのうちにいまし、勇士であって、勝利を与えられる。彼はあなたのために喜び楽しみ、その愛によってあなたを新にし、祭の日のようにあなたのために喜び呼ばわられる」。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 3:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.3.p2.b7": {
    "text": "その時あなたをしえたげる者をわたしはことごとく処分し、足なえを救い、追いやられた者を集め……",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 3:19"
    },
    "adapted": false,
    "status": "approved"
  },
  "zephaniah.3.p2.b8": {
    "text": "その時、わたしはあなたがたを連れかえる。わたしがあなたがたを集める……と主は言われる。",
    "kind": "scripture",
    "source": {
      "version": "jpnkougo",
      "ref": "Zephaniah 3:20"
    },
    "adapted": false,
    "status": "approved"
  }
}
