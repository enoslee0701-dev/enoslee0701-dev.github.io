{
  "exodus.24.p1.b1": {
    "text": "너는 아론과 나답과 아비후와 이스라엘 장로 칠십인과 함께 여호와에게로 올라와 멀리서 경배하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 24:1"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p1.b2": {
    "text": "너 모세만 여호와에게 가까이 나아오고 그들은 가까이 나아오지 말며 백성은 너와 함께 올라오지 말지니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 24:2"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p1.b3": {
    "text": "모세가 와서 여호와의 모든 말씀과 그 모든 율례를 백성에게 고하매 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 24:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p1.b4": {
    "text": "여호와의 명하신 모든 말씀을 우리가 준행하리이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 24:3"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p2.b5": {
    "text": "모세가 여호와의 모든 말씀을 기록하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 24:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p2.b6": {
    "text": "이른 아침에 일어나 산 아래 단을 쌓고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 24:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p2.b7": {
    "text": "… 이스라엘 십이 지파대로 열두 기둥을 세우고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 24:4"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p2.b8": {
    "text": "이스라엘 자손의 청년들을 보내어 번제와 소로 화목제를 여호와께 드리게 하고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 24:5"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p3.b9": {
    "text": "모세가 피를 취하여 반은 여러 양푼에 담고 반은 단에 뿌리고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 24:6"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p3.b10": {
    "text": "언약서를 가져 백성에게 낭독하여 들리매 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 24:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p3.b11": {
    "text": "여호와의 모든 말씀을 우리가 준행하리이다",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 24:7"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p3.b12": {
    "text": "이는 여호와께서 이 모든 말씀에 대하여 너희와 세우신 언약의 피니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 24:8"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p4.b13": {
    "text": "모세와 아론과 나답과 아비후와 이스라엘 장로 칠십인이 올라가서",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 24:9"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p4.b14": {
    "text": "이스라엘 하나님을 보니 그 발 아래에는 청옥을 편듯하고 하늘 같이 청명하더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 24:10"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p4.b15": {
    "text": "하나님이 이스라엘의 존귀한 자들에게 손을 대지 아니하셨고 그들은 하나님을 보고 먹고 마셨더라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 24:11"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p5.b16": {
    "text": "너는 산에 올라 내게로 와서 거기있으라 너로 그들을 가르치려고 내가 율법과 계명을 친히 기록한 돌판을 네게 주리라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 24:12"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p5.b17": {
    "text": "모세가 그 종자 여호수아와 함께 일어나 하나님의 산으로 올라가며",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 24:13"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p5.b18": {
    "text": "너희는 여기서 우리가 너희에게로 돌아오기까지 기다리라 아론과 훌이 너희와 함께하리니 …",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 24:14"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p6.b19": {
    "text": "산 위의 여호와의 영광이 이스라엘 자손의 눈에 맹렬한 불 같이 보였고",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 24:17"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p6.b20": {
    "text": "구름이 육일 동안 산을 가리더니 제 칠일에 여호와께서 구름 가운데 모세를 부르시니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 24:16"
    },
    "adapted": false,
    "status": "approved"
  },
  "exodus.24.p6.b21": {
    "text": "모세는 구름 속으로 들어가서 산 위에 올랐으며 사십일 사십야를 산에 있으니라",
    "kind": "scripture",
    "source": {
      "version": "korkrv",
      "ref": "Exodus 24:18"
    },
    "adapted": false,
    "status": "approved"
  }
}
